@@ -0,0 +1,59 @@
+package server
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+type sinnixUnreadableBody struct{}
+
+func (sinnixUnreadableBody) Read([]byte) (int, error) { panic("refused body was read") }
+
+func TestSinnixBrowserContext(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cases := []struct {
+		name string
+		method string
+		headers http.Header
+		blocked bool
+	}{
+		{"native", "POST", http.Header{}, false},
+		{"same-origin", "POST", http.Header{"Sec-Fetch-Site": {"same-origin"}}, false},
+		{"explicit-native-origin", "POST", http.Header{"Origin": {"app://fixture"}, "Sec-Fetch-Site": {"cross-site"}}, false},
+		{"cross-site-post", "POST", http.Header{"Sec-Fetch-Site": {"cross-site"}}, true},
+		{"cross-site-get", "GET", http.Header{"Sec-Fetch-Site": {"cross-site"}}, true},
+		{"missing-site", "POST", http.Header{"Sec-Fetch-Mode": {"cors"}}, true},
+		{"empty-site", "POST", http.Header{"Sec-Fetch-Site": {""}}, true},
+		{"duplicate-site", "POST", http.Header{"Sec-Fetch-Site": {"same-origin", "cross-site"}}, true},
+		{"duplicate-origin", "POST", http.Header{"Origin": {"app://fixture", "https://foreign.example"}}, true},
+		{"navigation", "GET", http.Header{"Sec-Fetch-Site": {"cross-site"}, "Sec-Fetch-Mode": {"navigate"}, "Sec-Fetch-Dest": {"document"}, "Sec-Fetch-User": {"?1"}}, false},
+		{"navigation-post", "POST", http.Header{"Sec-Fetch-Site": {"cross-site"}, "Sec-Fetch-Mode": {"navigate"}, "Sec-Fetch-Dest": {"document"}, "Sec-Fetch-User": {"?1"}}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			called := false
+			router := gin.New()
+			router.Use(sinnixBrowserContextMiddleware())
+			router.Any("/", func(c *gin.Context) {
+				called = true
+				body, err := io.ReadAll(c.Request.Body)
+				if err != nil || string(body) != "neutral" { t.Fatal("native request body changed") }
+				c.Status(http.StatusNoContent)
+			})
+			var body io.Reader = strings.NewReader("neutral")
+			if tc.blocked { body = sinnixUnreadableBody{} }
+			request := httptest.NewRequest(tc.method, "http://127.0.0.1:8123/", body)
+			request.Header = tc.headers
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			expected := http.StatusNoContent
+			if tc.blocked { expected = http.StatusForbidden }
+			if response.Code != expected || called == tc.blocked { t.Fatalf("status=%d owner=%v", response.Code, called) }
+		})
+	}
+}
