@@ -0,0 +1,36 @@
+package server
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+// CORS validates explicit origins. Fetch Metadata covers browser requests
+// without Origin, while configured native-app origins still pass through CORS.
+func sinnixBrowserContextMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		browser := false
+		for _, name := range []string{"Origin", "Sec-Fetch-Site", "Sec-Fetch-Mode", "Sec-Fetch-Dest", "Sec-Fetch-User"} {
+			values := c.Request.Header.Values(name)
+			if len(values) > 1 {
+				c.AbortWithStatus(http.StatusForbidden)
+				return
+			}
+			if name != "Origin" && len(values) != 0 {
+				browser = true
+			}
+		}
+		if browser && c.GetHeader("Origin") == "" {
+			site := c.GetHeader("Sec-Fetch-Site")
+			navigation := (c.Request.Method == http.MethodGet || c.Request.Method == http.MethodHead) &&
+				c.GetHeader("Sec-Fetch-Mode") == "navigate" && c.GetHeader("Sec-Fetch-Dest") == "document" &&
+				c.GetHeader("Sec-Fetch-User") == "?1"
+			if site != "same-origin" && site != "none" && !navigation {
+				c.AbortWithStatus(http.StatusForbidden)
+				return
+			}
+		}
+		c.Next()
+	}
+}
