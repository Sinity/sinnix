+int PipeWireService::reconnectTimeoutMs() const noexcept {
+  if (m_connected) {
+    return -1;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (m_nextReconnect <= now) {
+    return 0;
+  }
+  return static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(m_nextReconnect - now).count());
+}
+
+void PipeWireService::scheduleReconnect() {
+  m_connected = false;
+  m_reconnectPending = false;
+  m_nextReconnect = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+}
+
+void PipeWireService::onCoreError(std::uint32_t id, int result, const char* message) {
+  if (id != PW_ID_CORE || result >= 0) {
+    kLog.warn("PipeWire object error (id {}, {}): {}", id, result, message != nullptr ? message : "unknown error");
+    return;
+  }
+  kLog.warn("PipeWire connection lost ({}): {}; rebuilding audio state when it returns", result,
+            message != nullptr ? message : "unknown error");
+  m_reconnectPending = true;
+}
