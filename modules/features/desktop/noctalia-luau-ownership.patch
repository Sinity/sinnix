diff --git a/src/scripting/runtime_memory.h b/src/scripting/runtime_memory.h
new file mode 100644
index 0000000..7ba2749
--- /dev/null
+++ b/src/scripting/runtime_memory.h
@@ -0,0 +1,153 @@
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+#include <nlohmann/json.hpp>
+
+namespace scripting::diagnostics {
+
+  struct MemoryStamp {
+    std::int64_t unixMs;
+    std::chrono::steady_clock::time_point monotonic;
+
+    static MemoryStamp now() {
+      return {
+          std::chrono::duration_cast<std::chrono::milliseconds>(
+              std::chrono::system_clock::now().time_since_epoch()
+          ).count(),
+          std::chrono::steady_clock::now(),
+      };
+    }
+  };
+
+  // Values only: this registry never owns or calls a runtime, VM or worker.
+  // Workers publish after serialized events; status copies at most 32 records.
+  class RuntimeMemoryRegistry {
+  public:
+    static constexpr std::size_t kMaxReported = 32;
+    static constexpr std::size_t kMaxIdBytes = 128;
+
+    static RuntimeMemoryRegistry& instance() {
+      // DeferredCall's static queue can release a State after ordinary static
+      // destruction. Keep this one registry alive until process exit; individual
+      // runtime records are still erased by State destruction.
+      static auto* const registry = new RuntimeMemoryRegistry;
+      return *registry;
+    }
+
+    void add(std::uint64_t token, std::string_view runtimeId) {
+      Entry entry;
+      if (runtimeId.size() > kMaxIdBytes) {
+        entry.identityError = "runtime_id_too_long";
+      } else if (!std::all_of(runtimeId.begin(), runtimeId.end(), [](unsigned char c) {
+                   return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                          c == '/' || c == ':' || c == '.' || c == '_' || c == '-';
+                 }) || runtimeId.empty()) {
+        entry.identityError = "runtime_id_invalid";
+      } else {
+        entry.runtimeId = runtimeId;
+      }
+      std::scoped_lock lock(m_mutex);
+      m_entries.emplace(token, std::move(entry));
+    }
+
+    void erase(std::uint64_t token) {
+      std::scoped_lock lock(m_mutex);
+      m_entries.erase(token);
+    }
+
+    void begin(std::uint64_t token) {
+      std::scoped_lock lock(m_mutex);
+      if (auto it = m_entries.find(token); it != m_entries.end()) {
+        it->second.inFlight = true;
+      }
+    }
+
+    void publish(
+        std::uint64_t token, std::uint64_t hostGeneration, std::optional<std::size_t> bytes,
+        MemoryStamp stamp = MemoryStamp::now()
+    ) {
+      std::scoped_lock lock(m_mutex);
+      if (auto it = m_entries.find(token); it != m_entries.end()) {
+        auto& entry = it->second;
+        entry.hostGeneration = hostGeneration != 0 ? std::optional(hostGeneration) : std::nullopt;
+        entry.bytes = bytes;
+        entry.stamp = bytes.has_value() ? std::optional(stamp) : std::nullopt;
+        entry.observed = true;
+        entry.inFlight = false;
+      }
+    }
+
+    nlohmann::json snapshot(int pid, MemoryStamp stamp = MemoryStamp::now()) const {
+      std::vector<std::pair<std::uint64_t, Entry>> copied;
+      std::size_t total;
+      {
+        std::scoped_lock lock(m_mutex);
+        total = m_entries.size();
+        copied.reserve(std::min(total, kMaxReported));
+        for (const auto& value : m_entries) {
+          if (copied.size() == kMaxReported) break;
+          copied.push_back(value);
+        }
+      }
+      nlohmann::json result{
+          {"schema_version", 1}, {"provider", "luau"}, {"status", "available"},
+          {"pid", pid}, {"observed_at_unix_ms", stamp.unixMs}, {"units", "bytes"},
+          {"runtime_count", total}, {"reported_runtime_count", copied.size()},
+          {"truncated_count", total - copied.size()}, {"runtimes", nlohmann::json::array()},
+      };
+      std::size_t available = 0;
+      std::size_t observed = 0;
+      for (const auto& [token, entry] : copied) {
+        nlohmann::json row{
+            {"state_token", token}, {"runtime_id", nullptr}, {"host_generation", nullptr},
+            {"status", "unavailable"}, {"bytes", nullptr}, {"sampled_at_unix_ms", nullptr},
+            {"age_ms", nullptr}, {"reason", nullptr},
+        };
+        if (entry.runtimeId.has_value()) row["runtime_id"] = *entry.runtimeId;
+        if (entry.hostGeneration.has_value()) row["host_generation"] = *entry.hostGeneration;
+        if (!entry.identityError.empty()) {
+          row["reason"] = entry.identityError;
+        } else if (!entry.bytes.has_value() || !entry.stamp.has_value()) {
+          row["reason"] = entry.observed ? "host_absent" : "not_observed";
+        } else {
+          row["status"] = entry.inFlight ? "stale" : "available";
+          row["bytes"] = *entry.bytes;
+          row["sampled_at_unix_ms"] = entry.stamp->unixMs;
+          row["age_ms"] = std::max<std::int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(
+              stamp.monotonic - entry.stamp->monotonic
+          ).count());
+          if (entry.inFlight) row["reason"] = "worker_in_flight";
+          else ++available;
+          ++observed;
+        }
+        result["runtimes"].push_back(std::move(row));
+      }
+      if (total > copied.size()) result["status"] = "partial";
+      else if (total != 0 && observed == 0) result["status"] = "unavailable";
+      else if (available != total) result["status"] = "partial";
+      return result;
+    }
+
+  private:
+    struct Entry {
+      std::optional<std::string> runtimeId;
+      std::string identityError;
+      std::optional<std::uint64_t> hostGeneration;
+      std::optional<std::size_t> bytes;
+      std::optional<MemoryStamp> stamp;
+      bool observed = false;
+      bool inFlight = false;
+    };
+    mutable std::mutex m_mutex;
+    std::map<std::uint64_t, Entry> m_entries;
+  };
+
+} // namespace scripting::diagnostics
