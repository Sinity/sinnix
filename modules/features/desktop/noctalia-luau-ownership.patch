diff --git a/tests/runtime_memory_test.cpp b/tests/runtime_memory_test.cpp
new file mode 100644
index 0000000..52d435c
--- /dev/null
+++ b/tests/runtime_memory_test.cpp
@@ -0,0 +1,184 @@
+#include "scripting/runtime_memory.h"
+
+#include <atomic>
+#include <cassert>
+#include <future>
+#include <memory>
+#include <cstring>
+#include <vector>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <limits>
+#include <iostream>
+#include <thread>
+
+using scripting::diagnostics::MemoryStamp;
+using scripting::diagnostics::RuntimeMemoryRegistry;
+using namespace std::chrono_literals;
+
+namespace {
+  MemoryStamp stamp(std::int64_t ms) {
+    return {ms, std::chrono::steady_clock::time_point(std::chrono::milliseconds(ms))};
+  }
+}
+
+namespace {
+  struct LateState {
+    ~LateState() { RuntimeMemoryRegistry::instance().erase(999); }
+  };
+
+  std::vector<std::unique_ptr<LateState>>& deferredStates() {
+    static std::vector<std::unique_ptr<LateState>> states;
+    return states;
+  }
+}
+
+int main(int argc, char** argv) {
+  if (argc == 2 && std::strcmp(argv[1], "--late-state") == 0) {
+    // Construct the deferred owner first so it destroys State after the registry
+    // would have been destroyed. This models upstream DeferredCall's queue.
+    auto& deferred = deferredStates();
+    RuntimeMemoryRegistry::instance().add(999, "example/plugin:late");
+    deferred.push_back(std::make_unique<LateState>());
+    return 0;
+  }
+  const pid_t child = ::fork();
+  assert(child >= 0);
+  if (child == 0) {
+    ::execl(argv[0], argv[0], "--late-state", static_cast<char*>(nullptr));
+    ::_exit(127);
+  }
+  int childStatus = 0;
+  assert(::waitpid(child, &childStatus, 0) == child);
+  assert(WIFEXITED(childStatus) && WEXITSTATUS(childStatus) == 0);
+
+  RuntimeMemoryRegistry registry;
+  assert(registry.snapshot(123, stamp(1000))["runtime_count"] == 0);
+  registry.add(7, "example/plugin:service");
+  auto data = registry.snapshot(123, stamp(1000));
+  assert(data["schema_version"] == 1 && data["provider"] == "luau");
+  assert(data["pid"] == 123 && data["units"] == "bytes");
+  assert(data["status"] == "unavailable");
+  assert(data["runtimes"][0]["bytes"].is_null());
+  assert(data["runtimes"][0]["host_generation"].is_null());
+  assert(data["runtimes"][0]["reason"] == "not_observed");
+
+  registry.begin(7);
+  registry.publish(7, 1, 0, stamp(1100));
+  data = registry.snapshot(123, stamp(1200));
+  assert(data["status"] == "available" && data["runtimes"][0]["bytes"] == 0);
+  assert(data["runtimes"][0]["host_generation"] == 1);
+  assert(data["runtimes"][0]["sampled_at_unix_ms"] == 1100);
+  assert(data["runtimes"][0]["age_ms"] == 100);
+#ifdef NOCTALIA_OWNERSHIP_FIXTURE
+  std::cout << data.dump() << '\n';
+#endif
+
+  registry.begin(7);
+  data = registry.snapshot(123, stamp(1300));
+  assert(data["status"] == "partial");
+  assert(data["runtimes"][0]["status"] == "stale");
+  assert(data["runtimes"][0]["reason"] == "worker_in_flight");
+  assert(data["runtimes"][0]["bytes"] == 0); // last observation, not a new read
+  registry.publish(7, 2, 8192, stamp(1400)); // actual host replacement
+  data = registry.snapshot(123, stamp(1500));
+  assert(data["runtimes"][0]["host_generation"] == 2);
+  assert(data["runtimes"][0]["bytes"] == 8192);
+  registry.publish(7, 2, std::nullopt, stamp(1600)); // worker teardown
+  data = registry.snapshot(123, stamp(1700));
+  assert(data["status"] == "unavailable");
+  assert(data["runtimes"][0]["reason"] == "host_absent");
+  assert(data["runtimes"][0]["host_generation"] == 2);
+  assert(data["runtimes"][0]["bytes"].is_null());
+  assert(data["runtimes"][0]["sampled_at_unix_ms"].is_null());
+  assert(data["runtimes"][0]["age_ms"].is_null());
+  registry.erase(7);
+  registry.publish(7, 3, 999, stamp(1800)); // late publication cannot revive a retired runtime
+  assert(registry.snapshot(123, stamp(1900))["runtime_count"] == 0);
+
+  // Repeated retirement bounds history, not only the reported output.
+  for (std::uint64_t token = 1; token <= 1000; ++token) {
+    registry.add(token, "example/plugin:service");
+    registry.publish(token, 1, token, stamp(2000));
+    registry.erase(token);
+  }
+  assert(registry.snapshot(123, stamp(2000))["runtime_count"] == 0);
+
+  // The main-thread snapshot never waits for the worker's execution boundary.
+  registry.add(1, "example/plugin:worker");
+  registry.publish(1, 1, 64, stamp(2000));
+  std::promise<void> started;
+  std::promise<void> release;
+  auto released = release.get_future();
+  std::thread blocked([&] {
+    registry.begin(1);
+    started.set_value();
+    released.wait();
+    registry.publish(1, 1, 128, stamp(2100));
+  });
+  started.get_future().wait();
+  auto read = std::async(std::launch::async, [&] { return registry.snapshot(123, stamp(2050)); });
+  assert(read.wait_for(1s) == std::future_status::ready);
+  assert(read.get()["runtimes"][0]["bytes"] == 64);
+  release.set_value();
+  blocked.join();
+  assert(registry.snapshot(123, stamp(2200))["runtimes"][0]["bytes"] == 128);
+  registry.erase(1);
+
+  // Published generation, timestamp and bytes are copied atomically as one record.
+  registry.add(1, "example/plugin:worker");
+  registry.publish(1, 1, 2, stamp(1));
+  std::atomic<bool> done = false;
+  std::thread writer([&] {
+    for (std::uint64_t n = 2; n < 3000; ++n) {
+      registry.begin(1);
+      registry.publish(1, n, n * 2, stamp(n));
+    }
+    done = true;
+  });
+  do {
+    auto row = registry.snapshot(123, stamp(5000))["runtimes"][0];
+    const auto generation = row["host_generation"].get<std::uint64_t>();
+    assert(row["bytes"] == generation * 2);
+    assert(row["sampled_at_unix_ms"] == generation);
+  } while (!done.load());
+  writer.join();
+  registry.erase(1);
+
+  // Worst-width numeric fields and labels fit the existing 16KiB IPC budget,
+  // leaving room for the six allocator counters and original status fields.
+  auto wideStamp = stamp(1000);
+  wideStamp.unixMs = 9000000000000000000LL;
+  for (std::uint64_t token = 1; token <= 40; ++token) {
+    registry.add(token, std::string(128, 'a'));
+    registry.publish(token, std::numeric_limits<std::uint64_t>::max(),
+                     std::numeric_limits<std::size_t>::max(), wideStamp);
+  }
+  data = registry.snapshot(123, wideStamp);
+  assert(data["status"] == "partial");
+  assert(data["runtime_count"] == 40 && data["reported_runtime_count"] == 32 && data["truncated_count"] == 8);
+  assert(data["runtimes"][0]["state_token"] == 1 && data["runtimes"][31]["state_token"] == 32);
+  nlohmann::json allocator{
+      {"schema_version", 1}, {"backend", "jemalloc"}, {"status", "available"},
+      {"pid", 123}, {"observed_at_unix_ms", wideStamp.unixMs}, {"units", "bytes"},
+      {"errors", nlohmann::json::array()},
+  };
+  for (const char* key : {"allocated_bytes", "active_bytes", "resident_bytes", "mapped_bytes", "retained_bytes", "metadata_bytes"}) {
+    allocator[key] = std::numeric_limits<std::size_t>::max();
+  }
+  const nlohmann::json envelope{
+      {"barVisible", true}, {"panelOpen", false}, {"activePanelId", nullptr}, {"locked", false},
+      {"allocator", allocator}, {"ownership", data},
+  };
+  assert(data.dump().size() < 14 * 1024);
+  assert(envelope.dump().size() < 16 * 1024);
+  for (std::uint64_t token = 1; token <= 40; ++token) registry.erase(token);
+  registry.add(1, std::string(129, 'a'));
+  registry.add(2, "bad\nname");
+  data = registry.snapshot(123, stamp(1000));
+  assert(data["runtimes"][0]["runtime_id"].is_null());
+  assert(data["runtimes"][0]["reason"] == "runtime_id_too_long");
+  assert(data["runtimes"][1]["runtime_id"].is_null());
+  assert(data["runtimes"][1]["reason"] == "runtime_id_invalid");
+  return 0;
+}
