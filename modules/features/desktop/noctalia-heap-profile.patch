+#endif
+
+using noctalia::diagnostics::HeapProfiler;
+using namespace std::chrono_literals;
+namespace fs = std::filesystem;
+
+namespace {
+  struct Temporary {
+    fs::path path;
+    Temporary() {
+      std::string value = (fs::temp_directory_path() / "heap-profile-XXXXXX").string();
+      assert(::mkdtemp(value.data()) != nullptr); path = value;
+    }
+    ~Temporary() { fs::remove_all(path); }
+  };
+  nlohmann::json waitFor(HeapProfiler& profiler, const std::function<bool(const nlohmann::json&)>& predicate) {
+    const auto until = std::chrono::steady_clock::now() + 5s;
+    do {
+      auto value = profiler.status();
+      if (predicate(value)) return value;
+      std::this_thread::sleep_for(2ms);
+    } while (std::chrono::steady_clock::now() < until);
+    assert(false && "profile state did not reach expected boundary");
+    return {};
+  }
+  nlohmann::json phase(HeapProfiler& profiler, const char* value) {
+    return waitFor(profiler, [value](const auto& j) { return j["state"] == value; });
+  }
+#ifndef NOCTALIA_REAL_PROFILE_TEST
+  struct Fake {
+    std::atomic<bool> active = false;
+    bool enabled = true;
+    std::atomic<bool> failActivate = false;
+    std::atomic<bool> failReset = false;
+    std::atomic<bool> failDump = false;
+    std::atomic<bool> failStopOnce = false;
+    std::atomic<bool> failStopAlways = false;
+    std::atomic<bool> failReadAfterStop = false;
+    std::atomic<bool> blockDump = false;
+    std::atomic<bool> blockRead = false;
+    std::atomic<unsigned> offWrites = 0;
+    std::atomic<unsigned> mainCalls = 0;
+    std::thread::id main = std::this_thread::get_id();
+    std::atomic<bool> forbidMain = false;
+    std::mutex mutex;
+    std::condition_variable changed;
+  };
+  Fake* fake;
+  int query(const char* name, void* old, std::size_t* width, void* input, std::size_t inputSize) {
+    if (fake->forbidMain && std::this_thread::get_id() == fake->main) ++fake->mainCalls;
+    if (std::strcmp(name, "config.prof") == 0) {
+      if (fake->blockRead && std::this_thread::get_id() != fake->main) {
+        std::unique_lock lock(fake->mutex); fake->changed.wait(lock, [] { return !fake->blockRead.load(); });
+      }
+      assert(*width == sizeof(bool)); *static_cast<bool*>(old) = true; return 0;
+    }
+    if (std::strcmp(name, "opt.prof") == 0) { assert(*width == sizeof(bool)); *static_cast<bool*>(old) = fake->enabled; return 0; }
+    if (std::strcmp(name, "opt.lg_prof_sample") == 0) { assert(*width == sizeof(std::size_t)); *static_cast<std::size_t*>(old) = 16; return 0; }
+    if (std::strcmp(name, "prof.active") == 0) {
+      if (input != nullptr) {
+        assert(inputSize == sizeof(bool)); const bool value = *static_cast<bool*>(input);
+        if (value && fake->failActivate.exchange(false)) return EIO;
+        if (!value) { ++fake->offWrites; if (fake->failStopOnce.exchange(false) || fake->failStopAlways) return EIO; }
+        fake->active = value;
+      }
+      if (old != nullptr && fake->failReadAfterStop && fake->offWrites > 0) return EIO;
+      if (old != nullptr) { assert(*width == sizeof(bool)); *static_cast<bool*>(old) = fake->active; }
+      return 0;
+    }
+    if (std::strcmp(name, "prof.reset") == 0) {
+      assert(!fake->active && inputSize == sizeof(std::size_t));
+      assert(*static_cast<std::size_t*>(input) == 16); return fake->failReset.exchange(false) ? EIO : 0;
+    }
+    if (std::strcmp(name, "prof.dump") == 0) {
+      assert(!fake->active && inputSize == sizeof(const char*));
+      if (fake->blockDump) { std::unique_lock lock(fake->mutex); fake->changed.wait(lock, [] { return !fake->blockDump.load(); }); }
+      if (fake->failDump.exchange(false)) return EIO;
+      const char* filename = *static_cast<const char**>(input);
+      assert(std::string_view(filename).starts_with("/proc/self/fd/"));
+      std::ofstream file(filename); file << "heap_v2/65536\nt*: 0: 0 [0: 0]\n"; return file.good() ? 0 : EIO;
+    }
+    return ENOENT;
+  }
+#endif
+}
+
+int main(int argc, char** argv) {
+#ifdef NOCTALIA_REAL_PROFILE_TEST
+  Temporary root;
+  HeapProfiler profiler(&mallctl, root.path.string());
+  if (argc == 2 && std::string_view(argv[1]) == "--disabled") {
+    const auto before = profiler.status(); assert(before["enabled_at_startup"] == false);
+    assert(before["last_observed_active"] == false);
+    assert(profiler.start(1)["request_error"] == "startup_disabled");
+    assert(fs::is_empty(root.path)); return 0;
+  }
+  assert(profiler.status()["enabled_at_startup"] == true);
+  assert(profiler.status()["last_observed_active"] == false);
+  auto first = profiler.start(5); const auto firstId = first["session"].get<std::string>(); phase(profiler, "active");
+  std::vector<void*> blocks;
+  for (int i = 0; i < 8; ++i) { auto* p = ::mallocx(1024 * 1024, 0); assert(p); std::memset(p, 23, 1024 * 1024); blocks.push_back(p); }
+  profiler.stop(firstId); const auto firstDone = phase(profiler, "complete"); assert(firstDone["last_observed_active"] == false);
+  const auto firstPath = root.path / firstId / "final.heap";
+  std::ifstream in(firstPath); std::string firstProfile((std::istreambuf_iterator<char>(in)), {});
+  assert(firstProfile.starts_with("heap_v2/65536")); assert(firstProfile.find("MAPPED_LIBRARIES:") != std::string::npos);
+  // Holding the first window's allocations across reset must not count them as
+  // new retained objects in the second window.
+  auto second = profiler.start(5); const auto secondId = second["session"].get<std::string>(); phase(profiler, "active");
+  profiler.stop(secondId); phase(profiler, "complete");
+  std::ifstream next(root.path / secondId / "final.heap"); std::string secondProfile((std::istreambuf_iterator<char>(next)), {});
+  const auto total = [](const std::string& text) {
+    const auto pos = text.find("t*:"); assert(pos != std::string::npos);
+    std::istringstream fields(text.substr(pos + 3)); std::uint64_t count, bytes; char colon;
+    fields >> count >> colon >> bytes; assert(colon == ':'); return bytes;
+  };
+  assert(total(firstProfile) >= 4 * 1024 * 1024);
+  assert(total(secondProfile) < total(firstProfile) / 2);
+  for (auto* p : blocks) ::dallocx(p, 0);
+  std::cout << nlohmann::json{{"first_live_bytes", total(firstProfile)}, {"after_reset_live_bytes", total(secondProfile)}, {"sample_interval_bytes", 65536}, {"active_after", profiler.status()["last_observed_active"]}}.dump() << '\n';
+#else
+  if (argc == 2 && (std::string_view(argv[1]) == "--persistent-stop-failure" || std::string_view(argv[1]) == "--persistent-readback-failure")) {
+    Fake f; fake = &f;
+    f.failStopAlways = std::string_view(argv[1]) == "--persistent-stop-failure";
+    f.failReadAfterStop = !f.failStopAlways.load();
+    Temporary root; HeapProfiler profiler(query, root.path.string());
+    const auto id = profiler.start(1)["session"].get<std::string>(); phase(profiler, "active");
+    profiler.stop(id); std::this_thread::sleep_for(2s);
+    return 99; // must have exited non-core rather than leaving profiling active/unknown
+  }
+  for (const char* mode : {"--persistent-stop-failure", "--persistent-readback-failure"}) {
+    const pid_t child = ::fork(); assert(child >= 0);
+    if (child == 0) { ::execl(argv[0], argv[0], mode, static_cast<char*>(nullptr)); ::_exit(127); }
+    int status = 0; assert(::waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == HeapProfiler::kFailClosedExit);
+  }
+  {
+    Fake f; fake = &f; f.enabled = false; Temporary root; HeapProfiler profiler(query, root.path.string()); f.forbidMain = true;
+    for (int i = 0; i < 50; ++i) assert(profiler.status()["last_observed_active"] == false);
+    assert(profiler.start(1)["request_error"] == "startup_disabled"); assert(fs::is_empty(root.path)); assert(f.mainCalls == 0);
+  }
+  {
+    Fake f; fake = &f; Temporary root; HeapProfiler profiler(query, root.path.string()); f.forbidMain = true;
+    assert(profiler.start(0)["request_error"] == "invalid_duration"); assert(profiler.start(301)["request_error"] == "invalid_duration");
+    auto begun = profiler.start(1); const auto id = begun["session"].get<std::string>(); phase(profiler, "active");
+    assert(profiler.stop("wrong-session")["request_error"] == "session_mismatch"); assert(f.active);
+    // Deliberately leave the IPC/main thread idle across the deadline.
+    std::this_thread::sleep_for(1250ms); assert(!f.active);
+    auto done = phase(profiler, "complete"); assert(done["reason"] == "deadline"); assert(done["dump_available"] == true);
+    assert(done.dump().find(root.path.string()) == std::string::npos); assert(f.mainCalls == 0);
+    struct stat st{}; assert(::stat((root.path/id).c_str(), &st) == 0 && (st.st_mode & 0777) == 0700);
+    assert(::stat((root.path/id/"final.heap").c_str(), &st) == 0 && (st.st_mode & 0777) == 0600);
+  }
+  for (int failure = 0; failure < 4; ++failure) {
+    Fake f; fake = &f; Temporary root;
+    if (failure == 0) f.failActivate = true; if (failure == 1) f.failReset = true;
+    if (failure == 2) f.failDump = true; if (failure == 3) f.failStopOnce = true;
+    HeapProfiler profiler(query, root.path.string()); auto begun = profiler.start(1); const auto id = begun["session"].get<std::string>();
+    if (failure >= 2) { phase(profiler, "active"); profiler.stop(id); }
+    if (failure == 3) {
+      const auto done = phase(profiler, "complete");
+      assert(done["deactivation_attempts"] == 2 && done["dump_available"] == true);
+    } else {
+      phase(profiler, "error"); assert(profiler.status()["dump_available"] == false);
+    }
+    assert(!f.active);
+    if (failure != 1) assert(f.offWrites > 0);
+  }
+  {
+    Fake f; fake = &f; f.blockDump = true; Temporary root; auto profiler = std::make_unique<HeapProfiler>(query, root.path.string()); f.forbidMain = true;
+    auto begun = profiler->start(5); const auto id = begun["session"].get<std::string>(); phase(*profiler, "active"); profiler->stop(id); phase(*profiler, "dumping");
+    const auto before = std::chrono::steady_clock::now();
+    assert(profiler->start(1)["request_error"] == "busy");
+    for (int i = 0; i < 50; ++i) assert(profiler->status()["state"] == "dumping");
+    assert(std::chrono::steady_clock::now() - before < 500ms); assert(!f.active && f.mainCalls == 0);
+    std::atomic<bool> destroyed = false;
+    std::thread destroy([&] { profiler.reset(); destroyed = true; });
+    std::this_thread::sleep_for(20ms); assert(!destroyed);
+    f.blockDump = false; f.changed.notify_all(); destroy.join(); assert(destroyed && !f.active);
+  }
+  {
+    Fake f; fake = &f; Temporary root; HeapProfiler profiler(query, root.path.string()); f.blockRead = true;
+    auto begun = profiler.start(1); const auto id = begun["session"].get<std::string>();
+    fs::create_directory(root.path/id); ::chmod((root.path/id).c_str(), 0700);
+    std::ofstream(root.path/id/"keeper") << "synthetic preexisting custody";
+    assert(profiler.status()["state"] == "starting");
+    f.blockRead = false; f.changed.notify_all(); phase(profiler, "error"); assert(!f.active); assert(fs::exists(root.path/id/"keeper"));
+  }
+  {
+    Fake f; fake = &f; Temporary root; fs::create_directory_symlink(root.path, root.path/"alias"); HeapProfiler profiler(query, (root.path/"alias").string());
+    profiler.start(1); phase(profiler, "error"); assert(!f.active);
+  }
+  {
+    Fake f; fake = &f; Temporary root; ::chmod(root.path.c_str(), 0755); HeapProfiler profiler(query, root.path.string());
+    profiler.start(1); phase(profiler, "error"); assert(!f.active); assert(fs::is_empty(root.path));
+  }
+#endif
+  return 0;
