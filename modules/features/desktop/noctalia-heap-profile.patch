+namespace noctalia::diagnostics {
+
+  // IPC is main-thread only. The worker owns every profiling write, deadline and
+  // filesystem operation. Its mailbox contains values, never Application/VM pointers.
+  class HeapProfiler {
+    using Clock = std::chrono::steady_clock;
+    struct Failure { const char* reason; int code; };
+    struct Fd {
+      int value = -1;
+      Fd() = default;
+      explicit Fd(int v) : value(v) {}
+      ~Fd() { if (value >= 0) ::close(value); }
+      Fd(Fd&& other) noexcept : value(std::exchange(other.value, -1)) {}
+      Fd& operator=(Fd&& other) noexcept {
+        if (value >= 0) ::close(value);
+        value = std::exchange(other.value, -1);
+        return *this;
+      }
+      Fd(const Fd&) = delete;
+      Fd& operator=(const Fd&) = delete;
+    };
+    struct Capabilities {
+      std::optional<bool> compiled;
+      std::optional<bool> enabled;
+      std::optional<bool> active;
+      std::optional<std::size_t> sampleLog2;
+      int error = 0;
+      std::int64_t observedAt = 0;
+    };
+    struct Request {
+      std::string id;
+      int seconds;
+      std::int64_t requestedAt;
+      Clock::time_point deadline;
+    };
+    struct Snapshot {
+      std::string phase = "idle";
+      std::string id;
+      std::string reason;
+      int error = 0;
+      Capabilities caps;
+      bool configured = false;
+      bool dumpAvailable = false;
+      std::optional<std::int64_t> requestedAt;
+      std::optional<std::int64_t> startedAt;
+      std::optional<std::int64_t> stoppedAt;
+      std::optional<std::int64_t> deadlineAt;
+      std::optional<std::uint64_t> dumpBytes;
+      std::optional<std::uint64_t> lateMs;
+      std::optional<unsigned> stopAttempts;
+    };
+    struct Mailbox {
+      std::mutex mutex;
+      std::condition_variable changed;
+      Snapshot snapshot;
+      std::optional<Request> pending;
+      bool stop = false;
+      bool shutdown = false;
+    };
+
+  public:
+    static constexpr int kMaximumSeconds = 300;
+    static constexpr std::size_t kSampleLog2 = 16;
+    static constexpr unsigned kMaximumSessions = 4;
+    static constexpr int kFailClosedExit = 70;
+
+    HeapProfiler(Mallctl query, std::string directory)
+        : m_query(query), m_directory(std::move(directory)), m_mailbox(std::make_shared<Mailbox>()) {
+      // Startup-only capability reads, before any worker/dump can exist.
+      m_mailbox->snapshot.caps = capabilities(query);
+      m_mailbox->snapshot.configured = !m_directory.empty();
+    }
+    ~HeapProfiler() {
+      {
+        std::scoped_lock lock(m_mailbox->mutex);
+        m_mailbox->shutdown = true;
+        m_mailbox->stop = true;
+      }
+      m_mailbox->changed.notify_all();
+      if (m_worker.joinable()) m_worker.join();
+    }
+    HeapProfiler(const HeapProfiler&) = delete;
+    HeapProfiler& operator=(const HeapProfiler&) = delete;
+
+    nlohmann::json status() const { return format(copy()); }
+
+    nlohmann::json start(int seconds) {
+      std::string rejection;
+      {
+        std::scoped_lock lock(m_mailbox->mutex);
+        auto& s = m_mailbox->snapshot;
+        if (seconds < 1 || seconds > kMaximumSeconds) rejection = "invalid_duration";
+        else if (!s.configured) rejection = "not_configured";
+        else if (s.caps.error != 0) rejection = "capabilities_unavailable";
+        else if (!s.caps.enabled.value_or(false)) rejection = "startup_disabled";
+        else if (m_mailbox->shutdown) rejection = "shutting_down";
+        else if (s.phase == "starting" || s.phase == "active" || s.phase == "stopping" || s.phase == "dumping") rejection = "busy";
+        else if (s.caps.active.value_or(true)) rejection = "active_or_unknown";
+        else if (m_sessions >= kMaximumSessions) rejection = "session_limit";
+        else {
+          ++m_sessions;
+          const auto now = unixMs();
+          const auto id = "p" + std::to_string(::getpid()) + "-" + std::to_string(now) + "-" + std::to_string(m_sessions);
+          const auto caps = s.caps;
+          s = Snapshot{};
+          s.caps = caps;
+          s.configured = true;
+          s.id = id;
+          s.phase = "starting";
+          s.requestedAt = now;
+          s.deadlineAt = now + seconds * 1000;
+          m_mailbox->stop = false;
+          m_mailbox->pending = Request{id, seconds, now, Clock::now() + std::chrono::seconds(seconds)};
+        }
+      }
+      if (!rejection.empty()) {
+        auto result = status();
+        result["request_error"] = rejection;
+        return result;
+      }
+      if (!m_worker.joinable()) {
+        try {
+          // No capture of this or any service/controller state.
+          m_worker = std::thread([mailbox = m_mailbox, query = m_query, directory = m_directory] {
+            run(std::move(mailbox), query, directory);
+          });
+        } catch (...) {
+          publish(m_mailbox, [](Snapshot& s) { s.phase = "error"; s.reason = "worker_start_failed"; s.error = EAGAIN; });
+          std::scoped_lock lock(m_mailbox->mutex);
+          m_mailbox->pending.reset();
+        }
+      }
+      m_mailbox->changed.notify_all();
+      return status();
+    }
+
+    nlohmann::json stop(std::string_view id) {
+      bool mismatch;
+      {
+        std::scoped_lock lock(m_mailbox->mutex);
+        mismatch = id != m_mailbox->snapshot.id || id.empty();
+        if (!mismatch) m_mailbox->stop = true;
+      }
+      if (!mismatch) m_mailbox->changed.notify_all();
+      auto result = status();
+      if (mismatch) result["request_error"] = "session_mismatch";
+      return result;
+    }
+
+  private:
+    static std::int64_t unixMs() {
+      return std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::system_clock::now().time_since_epoch()).count();
+    }
+    template<typename T> static std::optional<T> read(Mallctl q, const char* name, int& error) {
+      if (q == nullptr) { error = ENOTSUP; return std::nullopt; }
+      T value{};
+      std::size_t width = sizeof(value);
+      const int code = q(name, &value, &width, nullptr, 0);
+      if (code != 0 || width != sizeof(value)) { error = code != 0 ? code : EPROTO; return std::nullopt; }
+      return value;
+    }
+    static Capabilities capabilities(Mallctl query) {
+      Capabilities c;
+      c.compiled = read<bool>(query, "config.prof", c.error);
+      c.enabled = read<bool>(query, "opt.prof", c.error);
+      c.active = read<bool>(query, "prof.active", c.error);
+      c.sampleLog2 = read<std::size_t>(query, "opt.lg_prof_sample", c.error);
+      c.observedAt = unixMs();
+      return c;
+    }
+    static void setActive(Mallctl query, bool value) {
+      const int code = query("prof.active", nullptr, nullptr, &value, sizeof(value));
+      if (code != 0) throw Failure{"active_write_failed", code};
+      int error = 0;
+      const auto observed = read<bool>(query, "prof.active", error);
+      if (!observed.has_value() || *observed != value) throw Failure{"active_readback_failed", error != 0 ? error : EPROTO};
+    }
+    static unsigned confirmStopped(Mallctl query, const std::shared_ptr<Mailbox>& mailbox) {
+      int lastError = EIO;
+      for (unsigned attempt = 1; attempt <= 3; ++attempt) {
+        try { setActive(query, false); return attempt; }
+        catch (const Failure& failure) { lastError = failure.code; }
+        catch (...) { lastError = EIO; }
+      }
+      // A diagnostic window must not silently become indefinite. Do not wait
+      // for a blocked IPC loop or filesystem to report this terminal failure.
+      try {
+        std::unique_lock lock(mailbox->mutex, std::try_to_lock);
+        if (lock.owns_lock()) {
+          auto& s = mailbox->snapshot;
+          s.phase = "failed_closed"; s.reason = "cannot_confirm_inactive";
+          s.error = lastError; s.caps.active.reset(); s.stopAttempts = 3;
+        }
+      } catch (...) {}
+      ::_exit(kFailClosedExit); // no core; systemd restores startup-inactive state
+    }
+
+    template<typename F> static void publish(const std::shared_ptr<Mailbox>& mailbox, F update) {
+      std::scoped_lock lock(mailbox->mutex);
+      update(mailbox->snapshot);
+    }
+    Snapshot copy() const {
+      std::scoped_lock lock(m_mailbox->mutex);
+      return m_mailbox->snapshot;
+    }
+    static nlohmann::json format(const Snapshot& s) {
+      nlohmann::json j{{"schema_version", 1}, {"pid", ::getpid()}, {"state", s.phase},
+          {"configured", s.configured}, {"session", s.id.empty() ? nlohmann::json(nullptr) : nlohmann::json(s.id)},
+          {"dump_available", s.dumpAvailable}, {"maximum_seconds", kMaximumSeconds},
+          {"maximum_sessions", kMaximumSessions}, {"reason", s.reason.empty() ? nlohmann::json(nullptr) : nlohmann::json(s.reason)},
+          {"error_code", s.error == 0 ? nlohmann::json(nullptr) : nlohmann::json(s.error)}};
+      const auto optional = [&j](const char* key, const auto& value) { j[key] = value.has_value() ? nlohmann::json(*value) : nlohmann::json(nullptr); };
+      j["capabilities_observed_at_unix_ms"] = s.caps.observedAt;
+      optional("compiled", s.caps.compiled); optional("enabled_at_startup", s.caps.enabled);
+      optional("last_observed_active", s.caps.active); optional("sample_interval_log2", s.caps.sampleLog2);
+      j["sample_interval_bytes"] = s.caps.sampleLog2.has_value() && *s.caps.sampleLog2 < 64
+          ? nlohmann::json(std::uint64_t{1} << *s.caps.sampleLog2) : nlohmann::json(nullptr);
+      optional("requested_at_unix_ms", s.requestedAt); optional("started_at_unix_ms", s.startedAt);
+      optional("stopped_at_unix_ms", s.stoppedAt); optional("deadline_at_unix_ms", s.deadlineAt);
+      optional("deadline_late_ms", s.lateMs); optional("dump_bytes", s.dumpBytes);
+      optional("deactivation_attempts", s.stopAttempts);
+      j["capability_error_code"] = s.caps.error == 0 ? nlohmann::json(nullptr) : nlohmann::json(s.caps.error);
+      return j;
+    }
+    static Fd openRoot(const std::string& path) {
+      if (path.empty() || path.front() != '/') throw Failure{"invalid_directory", EINVAL};
+      Fd directory(::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+      if (directory.value < 0) throw Failure{"directory_open_failed", errno};
+      std::size_t begin = 1;
+      while (begin < path.size()) {
+        const auto end = path.find('/', begin);
+        const auto part = path.substr(begin, end == std::string::npos ? end : end - begin);
+        if (part.empty() || part == "." || part == "..") throw Failure{"invalid_directory", EINVAL};
+        Fd next(::openat(directory.value, part.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+        if (next.value < 0) throw Failure{"directory_open_failed", errno};
+        directory = std::move(next);
+        if (end == std::string::npos) break;
+        begin = end + 1;
+      }
+      struct stat st{};
+      if (::fstat(directory.value, &st) != 0) throw Failure{"directory_stat_failed", errno};
+      if (st.st_uid != ::geteuid() || (st.st_mode & 0777) != 0700) throw Failure{"directory_not_private", EACCES};
+      return directory;
+    }
+    static Fd createFile(int directory, const char* name) {
+      Fd file(::openat(directory, name, O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+      if (file.value < 0) throw Failure{"file_create_failed", errno};
+      if (::fchmod(file.value, 0600) != 0) throw Failure{"file_mode_failed", errno};
+      return file;
+    }
+    static void writeAll(int fd, const std::string& bytes) {
+      std::size_t at = 0;
+      while (at < bytes.size()) {
+        const auto n = ::write(fd, bytes.data() + at, bytes.size() - at);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) throw Failure{"metadata_write_failed", n < 0 ? errno : EIO};
+        at += static_cast<std::size_t>(n);
+      }
+    }
+    static std::pair<std::string, bool> maps() {
+      std::ifstream file("/proc/self/maps");
+      if (!file) throw Failure{"mapping_read_failed", EIO};
+      std::string bytes;
+      std::array<char, 4096> block;
+      while (file && bytes.size() <= 1024 * 1024) {
+        file.read(block.data(), block.size());
+        bytes.append(block.data(), static_cast<std::size_t>(file.gcount()));
+      }
+      const bool truncated = bytes.size() > 1024 * 1024;
+      if (truncated) bytes.resize(1024 * 1024);
+      return {std::move(bytes), truncated};
+    }
+    static void run(std::shared_ptr<Mailbox> mailbox, Mallctl query, const std::string& directory) {
+      bool mayBeActive = false;
+      for (;;) {
+        Request request;
+        {
+          std::unique_lock lock(mailbox->mutex);
+          mailbox->changed.wait(lock, [&] { return mailbox->shutdown || mailbox->pending.has_value() || (mailbox->stop && mayBeActive); });
+          if (mailbox->shutdown && !mayBeActive) return;
+          if (!mailbox->pending.has_value()) {
+            const bool shutdown = mailbox->shutdown;
+            lock.unlock();
+            if (mayBeActive) {
+              confirmStopped(query, mailbox); mayBeActive = false;
+            }
+            const auto caps = capabilities(query);
+            publish(mailbox, [&](Snapshot& s) { s.caps = caps; });
+            if (shutdown) return;
+            std::scoped_lock again(mailbox->mutex); mailbox->stop = false;
+            continue;
+          }
+          request = std::move(*mailbox->pending);
+          mailbox->pending.reset();
+        }
+        try {
+          auto caps = capabilities(query);
+          if (caps.error != 0 || !caps.compiled.value_or(false) || !caps.enabled.value_or(false)) throw Failure{"profiling_unavailable", caps.error != 0 ? caps.error : ENOTSUP};
+          if (caps.active.value_or(true)) throw Failure{"already_active", EBUSY};
+          if (caps.sampleLog2 != kSampleLog2) throw Failure{"sample_interval_mismatch", EINVAL};
+          Fd base = openRoot(directory);
+          if (::mkdirat(base.value, request.id.c_str(), 0700) != 0) throw Failure{"session_create_failed", errno};
+          Fd session(::openat(base.value, request.id.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+          if (session.value < 0) throw Failure{"session_open_failed", errno};
+          struct stat sessionStat{};
+          if (::fstat(session.value, &sessionStat) != 0 || sessionStat.st_uid != ::geteuid() || (sessionStat.st_mode & 0777) != 0700) throw Failure{"session_not_private", EACCES};
+          Fd output = createFile(session.value, "final.heap");
+          Fd metadata = createFile(session.value, "metadata.json");
+          {
+            std::scoped_lock lock(mailbox->mutex);
+            if (mailbox->shutdown || mailbox->stop || Clock::now() >= request.deadline) throw Failure{"cancelled_before_activation", ECANCELED};
+          }
+          std::size_t sample = kSampleLog2;
+          const int reset = query("prof.reset", nullptr, nullptr, &sample, sizeof(sample));
+          if (reset != 0) throw Failure{"reset_failed", reset};
+          mayBeActive = true; // even a failed write must take the finally-stop path
+          setActive(query, true);
+          const auto started = unixMs();
+          caps = capabilities(query);
+          publish(mailbox, [&](Snapshot& s) { s.phase = "active"; s.startedAt = started; s.caps = caps; });
+          std::string stopReason;
+          {
+            std::unique_lock lock(mailbox->mutex);
+            mailbox->changed.wait_until(lock, request.deadline, [&] { return mailbox->stop || mailbox->shutdown; });
+            stopReason = mailbox->shutdown ? "shutdown" : mailbox->stop ? "requested" : "deadline";
+            mailbox->snapshot.phase = "stopping";
+          }
+          const auto stopAttempts = confirmStopped(query, mailbox);
+          mayBeActive = false;
+          const auto stopped = unixMs();
+          const auto late = std::max<std::int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - request.deadline).count());
+          caps = capabilities(query);
+          publish(mailbox, [&](Snapshot& s) { s.phase = "dumping"; s.caps = caps; s.stoppedAt = stopped; s.lateMs = late; s.reason = stopReason; s.stopAttempts = stopAttempts; });
+          const std::string filename = "/proc/self/fd/" + std::to_string(output.value);
+          const char* name = filename.c_str();
+          const int dumped = query("prof.dump", nullptr, nullptr, &name, sizeof(name));
+          if (dumped != 0) throw Failure{"dump_failed", dumped};
+          std::array<char, 128> header{};
+          const auto readBytes = ::pread(output.value, header.data(), header.size() - 1, 0);
+          if (readBytes < 0 || std::string_view(header.data(), static_cast<std::size_t>(readBytes)).find("heap_v2/65536") != 0) throw Failure{"profile_interval_unverified", EPROTO};
+          struct stat outStat{};
+          if (::fstat(output.value, &outStat) != 0) throw Failure{"profile_stat_failed", errno};
+          std::array<char, 4096> executable{};
+          const auto length = ::readlink("/proc/self/exe", executable.data(), executable.size() - 1);
+          if (length < 0) throw Failure{"executable_read_failed", errno};
+          const auto [mapping, truncated] = maps();
+          std::ifstream statFile("/proc/self/stat");
+          std::string statLine; std::getline(statFile, statLine);
+          const auto close = statLine.rfind(')');
+          if (close == std::string::npos) throw Failure{"identity_read_failed", EPROTO};
+          std::istringstream fields(statLine.substr(close + 2));
+          std::string startTicks;
+          for (int i = 0; i <= 19; ++i) if (!(fields >> startTicks)) throw Failure{"identity_read_failed", EPROTO};
+          const nlohmann::json meta{{"schema_version", 1}, {"pid", ::getpid()}, {"process_start_ticks", std::stoull(startTicks)}, {"session", request.id},
+              {"requested_at_unix_ms", request.requestedAt}, {"started_at_unix_ms", started}, {"stopped_at_unix_ms", stopped},
+              {"stop_reason", stopReason}, {"sample_interval_log2", sample}, {"sample_interval_bytes", std::uint64_t{1} << sample},
+              {"executable", std::string(executable.data(), static_cast<std::size_t>(length))},
+              {"mappings", mapping}, {"mappings_truncated", truncated}, {"profiling_adds_bookkeeping", true}};
+          writeAll(metadata.value, meta.dump(2) + "\n");
+          // Completion is published only after all owned filesystem handles close.
+          metadata = Fd{}; output = Fd{}; session = Fd{}; base = Fd{};
+          publish(mailbox, [&](Snapshot& s) { s.phase = "complete"; s.dumpAvailable = true; s.dumpBytes = static_cast<std::uint64_t>(outStat.st_size); });
+        } catch (const Failure& failure) {
+          if (mayBeActive) {
+            confirmStopped(query, mailbox); mayBeActive = false;
+          }
+          const auto caps = capabilities(query);
+          publish(mailbox, [&](Snapshot& s) { s.phase = "error"; s.error = failure.code; s.reason = failure.reason; s.caps = caps; });
+        } catch (...) {
+          if (mayBeActive) {
+            confirmStopped(query, mailbox); mayBeActive = false;
+          }
+          const auto caps = capabilities(query);
+          publish(mailbox, [&](Snapshot& s) { s.phase = "error"; s.error = EIO; s.reason = "worker_failed"; s.caps = caps; });
+        }
+        {
+          std::scoped_lock lock(mailbox->mutex);
+          // Completion can race a newly queued start+stop. Never clear that
+          // next session's stop request while finishing the preceding session.
+          if (!mailbox->pending.has_value()) mailbox->stop = false;
+          if (mailbox->shutdown && !mayBeActive) return;
+        }
+      }
+    }
+
+    Mallctl m_query;
+    std::string m_directory;
+    std::shared_ptr<Mailbox> m_mailbox;
+    std::thread m_worker;
+    unsigned m_sessions = 0;
+  };
+
+} // namespace noctalia::diagnostics
diff --git a/tests/heap_profile_test.cpp b/tests/heap_profile_test.cpp
