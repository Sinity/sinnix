+#include "util/heap_profile.h"
+
+#include <atomic>
+#include <cassert>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <vector>
+#include <sys/wait.h>
+#ifdef NOCTALIA_REAL_PROFILE_TEST
