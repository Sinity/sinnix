diff --git a/tests/theme_defaults_migration_test.cpp b/tests/theme_defaults_migration_test.cpp
new file mode 100644
index 00000000..c2e4addd
--- /dev/null
+++ b/tests/theme_defaults_migration_test.cpp
@@ -0,0 +1,55 @@
+#include "config/config_service.h"
+#include "config/config_types.h"
+#include "tests/test_check.h"
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+int main() {
+  const auto root = std::filesystem::temp_directory_path() / ("noctalia-theme-defaults-" + std::to_string(::getpid()));
+  std::filesystem::remove_all(root);
+  std::filesystem::create_directories(root / "config" / "noctalia");
+  std::filesystem::create_directories(root / "state" / "noctalia");
+  std::filesystem::create_directories(root / "data");
+  ::setenv("NOCTALIA_CONFIG_HOME", (root / "config").c_str(), 1);
+  ::setenv("NOCTALIA_STATE_HOME", (root / "state").c_str(), 1);
+  ::setenv("NOCTALIA_DATA_HOME", (root / "data").c_str(), 1);
+
+  const auto settings = root / "state" / "noctalia" / "settings.toml";
+  {
+    std::ofstream out(settings, std::ios::trunc);
+    out << "[theme]\nmode = \"light\"\npure_black_dark = false\n\n[wallpaper.automation]\nenabled = false\n";
+  }
+  const std::vector<std::string> modePath{"theme", "mode"};
+  const std::vector<std::string> pureBlackPath{"theme", "pure_black_dark"};
+  const std::vector<std::string> automationPath{"wallpaper", "automation", "enabled"};
+
+  {
+    ConfigService config;
+    TEST_CHECK(!config.hasOverride(modePath));
+    TEST_CHECK(!config.hasOverride(pureBlackPath));
+    TEST_CHECK(config.hasOverride(automationPath));
+    TEST_CHECK(std::filesystem::exists(settings.string() + ".before-sinnix-theme-defaults.toml"));
+    TEST_CHECK(std::filesystem::exists(settings.string() + ".sinnix-theme-defaults-v1"));
+
+    // This is the subsequent private GUI choice that the next startup must preserve.
+    config.setThemeMode(ThemeMode::Light);
+    TEST_CHECK(config.hasOverride(modePath));
+  }
+  {
+    ConfigService restarted;
+    TEST_CHECK(restarted.hasOverride(modePath));
+    TEST_CHECK(restarted.config().theme.mode == ThemeMode::Light);
+    TEST_CHECK(restarted.hasOverride(automationPath));
+  }
+
+  ::unsetenv("NOCTALIA_CONFIG_HOME");
+  ::unsetenv("NOCTALIA_STATE_HOME");
+  ::unsetenv("NOCTALIA_DATA_HOME");
+  std::filesystem::remove_all(root);
+  return 0;
+}
