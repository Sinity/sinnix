+  // This intentionally owns only the automation toggle. Generic config IPC
+  // reloads configuration but does not provide a safe mutation surface; callers
+  // must never rewrite a managed config.toml symlink just to pin a wallpaper.
+  ipc.bind(
+      noctalia::cli::msg::wallpaperAutomationGet,
+      [this](const std::string& args) -> std::string {
+        if (m_config == nullptr) {
+          return "error: wallpaper service not initialized\n";
+        }
+        if (!StringUtils::trim(args).empty()) {
+          return "error: wallpaper-automation-get accepts no arguments\n";
+        }
+        return m_config->config().wallpaper.automation.enabled ? "true\n" : "false\n";
+      },
+      IpcService::HandlerOptions{.actionEditorVisibility = IpcService::ActionEditorVisibility::Hidden}
+  );
+  ipc.bind(
+      noctalia::cli::msg::wallpaperAutomationSet,
+      [this](const std::string& args) -> std::string {
+        if (m_config == nullptr) {
+          return "error: wallpaper service not initialized\n";
+        }
+        const std::string value = StringUtils::trim(args);
+        bool enabled = false;
+        if (value == "true") {
+          enabled = true;
+        } else if (value != "false") {
+          return "error: wallpaper-automation-set requires true or false\n";
+        }
+        bool changed = false;
+        if (!m_config->setOverride({"wallpaper", "automation", "enabled"}, enabled, &changed)) {
+          return "error: failed to persist wallpaper automation override\n";
+        }
+        resetAutomationState();
+        return changed ? "ok\n" : "unchanged\n";
+      },
+      IpcService::HandlerOptions{.actionEditorVisibility = IpcService::ActionEditorVisibility::Hidden}
+  );
