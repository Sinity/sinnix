+bool ConfigService::reconcileThemeDefaults() {
+  if (m_overridesPath.empty()) {
+    return false;
+  }
+
+  const std::filesystem::path settingsPath(m_overridesPath);
+  const std::filesystem::path markerPath = settingsPath.string() + ".sinnix-theme-defaults-v1";
+  const std::filesystem::path pendingPath = markerPath.string() + ".pending";
+  std::error_code ec;
+  if (std::filesystem::exists(markerPath, ec)) {
+    return !ec;
+  }
+  if (ec) {
+    kLog.warn("could not inspect theme-default migration marker {}: {}", markerPath.string(), ec.message());
+    return false;
+  }
+  if (std::filesystem::exists(pendingPath, ec)) {
+    // The mutation may have completed just before marker promotion failed.
+    // Conservatively never retry it: a later GUI choice must not be cleared.
+    return !ec;
+  }
+  if (ec) {
+    kLog.warn("could not inspect pending theme-default migration marker {}: {}", pendingPath.string(), ec.message());
+    return false;
+  }
+
+  // Keep the entire app-owned overlay recoverable before changing two stale
+  // policy keys. This preserves wallpaper history/favorites and every unrelated
+  // GUI setting exactly as Noctalia wrote them.
+  if (std::filesystem::exists(settingsPath, ec)) {
+    if (ec) {
+      kLog.warn("could not inspect {}: {}", settingsPath.string(), ec.message());
+      return false;
+    }
+    const std::filesystem::path backupPath = settingsPath.string() + ".before-sinnix-theme-defaults.toml";
+    if (!std::filesystem::exists(backupPath, ec)) {
+      std::filesystem::copy_file(settingsPath, backupPath, std::filesystem::copy_options::none, ec);
+      if (ec) {
+        kLog.warn("could not back up {}: {}", settingsPath.string(), ec.message());
+        return false;
+      }
+    } else if (ec) {
+      kLog.warn("could not inspect theme-default backup {}: {}", backupPath.string(), ec.message());
+      return false;
+    }
+  } else if (ec) {
+    kLog.warn("could not inspect {}: {}", settingsPath.string(), ec.message());
+    return false;
+  }
+
+  const std::string markerContents =
+      "Noctalia theme defaults reconciled by Sinnix; remove this marker only to explicitly rerun the migration.\n";
+  if (!writeTextFileAtomic(pendingPath, markerContents)) {
+    kLog.warn("could not write pending theme-default migration marker {}", pendingPath.string());
+    return false;
+  }
+
+  bool changed = false;
+  if (!clearOverrides({{"theme", "mode"}, {"theme", "pure_black_dark"}}, &changed)) {
+    kLog.warn("could not reconcile stale theme defaults: {}", lastMutationError());
+    // clearOverrides did not commit; allow a later clean start to retry.
+    std::filesystem::remove(pendingPath, ec);
+    if (ec) {
+      kLog.warn("could not remove pending theme-default migration marker {}: {}", pendingPath.string(), ec.message());
+    }
+    return false;
+  }
+  std::filesystem::rename(pendingPath, markerPath, ec);
+  if (ec) {
+    // Leave pending in place. Retrying could erase a later GUI choice.
+    kLog.warn("could not finalize theme-default migration marker {}: {}", markerPath.string(), ec.message());
+    return false;
+  }
+  return true;
+}
