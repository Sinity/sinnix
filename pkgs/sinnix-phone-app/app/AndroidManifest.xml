<?xml version="1.0" encoding="utf-8"?>
<!--
  targetSdkVersion is pinned to 33 deliberately, matching the device
  (Redmi Note 11, Android 13 / API 33). API 34 forbids starting a
  microphone foreground service from a BOOT_COMPLETED receiver
  (ForegroundServiceStartNotAllowedException) unless the app holds a
  special exemption; at 33 the boot-start path is legal. Raising the
  target without solving that would silently reintroduce the exact
  reboot-survival failure this app exists to fix.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sinnix.phone"
    android:versionCode="1"
    android:versionName="0.1.0">

  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!--
    Chunks must land in a directory a second app (Termux sshd, which the
    desktop drain rsyncs through) can read. Scoped storage closes every
    other option: the app-private external dir is unreadable by other
    apps since Android 11, and MediaStore-owned files are not addressable
    by a plain path. All-files access is the only grant that keeps
    /sdcard/sinnix-ambient working as the shared handoff point.
  -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

  <application
      android:label="Sinnix Capture"
      android:theme="@android:style/Theme.Material.NoActionBar"
      android:icon="@android:drawable/ic_btn_speak_now"
      android:allowBackup="false"
      android:hasFragileUserData="true">

    <activity
        android:name=".HomeActivity"
        android:exported="true"
        android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Both are internal destinations reached from Home. Not exported: they
      drive the recorder, and an exported activity is a control surface any
      app on the phone could invoke.
    -->
    <activity android:name=".CaptureActivity" android:exported="false" />
    <activity android:name=".GrantsActivity" android:exported="false" />
    <!-- Fullscreen: the whole surface is the response target, so anything
         the system draws over it is a target the operator might hit. -->
    <activity
        android:name=".PvtActivity"
        android:exported="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
    <activity android:name=".TalkActivity" android:exported="false" />
    <activity android:name=".BreathActivity" android:exported="false" />

    <!--
      foregroundServiceType="microphone" is the whole reason this app
      exists: it is the only supported way to keep AudioRecord/MediaRecorder
      delivering real samples once the app loses foreground or the screen
      turns off. Without it Android silently feeds silence and truncates.
    -->
    <service
        android:name=".AmbientService"
        android:exported="false"
        android:foregroundServiceType="microphone"
        android:stopWithTask="false" />

    <receiver
        android:name=".BootReceiver"
        android:exported="true"
        android:enabled="true">
      <intent-filter android:priority="999">
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <!-- Vendor variant emitted by several MIUI builds instead of the AOSP action. -->
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <!--
      Quick-settings tile: capture state without unlocking. Exported and
      permission-guarded is the required shape; only SystemUI may bind it.
      It reports state and opens the app; it deliberately cannot stop capture.
    -->
    <service
        android:name=".CaptureTileService"
        android:exported="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="Sinnix capture"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <receiver android:name=".WatchdogReceiver" android:exported="false" />

  </application>
</manifest>
