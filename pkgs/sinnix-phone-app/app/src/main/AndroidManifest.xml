<?xml version="1.0" encoding="utf-8"?>
<!--
  targetSdk is pinned to 33 in app/build.gradle.kts, deliberately. API 34
  forbids starting a microphone foreground service from a BOOT_COMPLETED
  receiver, and reboot-resume without the operator touching anything is a
  standing acceptance criterion. Raising the target needs a Direct Boot design
  first, not a version bump.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- Capture -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets TransportGuard restart Termux's sshd when MIUI has stopped it.
         Requires allow-external-apps=true in termux.properties on the device;
         without it the intent is refused and the guard reports rather than
         repairs. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

  <!-- The location lane: coarse only. Fine location would buy precision this
       lane has no use for — the question is which place, not which chair. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- Health Connect read grants, per record type, and deliberately the whole
       set rather than the three the lane first happened to use. Blood oxygen
       is the case that made the point: the band measures it continuously,
       Mi Fitness writes it, and nothing was asking for it. A granted-but-empty
       type costs one query an hour; a type nobody asked for costs every
       measurement taken before somebody noticed. Absent Health Connect is an
       ordinary outcome (it is a separate APK on Android 13) and the lane says
       so rather than failing. -->
  <uses-permission android:name="android.permission.health.READ_STEPS" />
  <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
  <uses-permission android:name="android.permission.health.READ_SLEEP" />
  <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
  <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
  <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
  <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
  <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
  <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
  <uses-permission android:name="android.permission.health.READ_DISTANCE" />
  <uses-permission android:name="android.permission.health.READ_SPEED" />
  <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
  <uses-permission android:name="android.permission.health.READ_EXERCISE" />
  <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
  <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
  <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
  <uses-permission android:name="android.permission.health.READ_WEIGHT" />
  <!-- Plural READ, singular WRITE is Health Connect's own naming asymmetry;
       this is the read side. Route POINTS still need a per-route foreground
       consent for sessions other apps wrote (background reads return
       ConsentRequired by design), so today this permission only makes the
       route's existence visible. The lane records that state honestly. -->
  <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />
  <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
  <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
  <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
  <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
  <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
  <uses-permission android:name="android.permission.health.READ_HEIGHT" />
  <uses-permission android:name="android.permission.health.READ_HYDRATION" />
  <!-- Live heart rate from the band over the standard BLE Heart Rate
       Service. Connect only, to an already-bonded device: no scan, no
       location entanglement. -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- The system's own app/screen/keyguard ledger, replacing the
       ActivityWatch watcher. Special appop, not a runtime grant:
       `appops set dev.sinnix.phone GET_USAGE_STATS allow`. -->
  <uses-permission
      android:name="android.permission.PACKAGE_USAGE_STATS"
      tools:ignore="ProtectedPermissions" />

  <!--
    The two that are not record types, and that decide whether the lane sees
    anything worth having.

    READ_HEALTH_DATA_HISTORY: without it Health Connect silently truncates every
    read to the last 30 days. That is not a policy we chose; it is the platform
    default for apps that have not asked. With it, the full retained history is
    readable, which for this device includes the Galaxy Watch 5 era still
    resident from Samsung Health.

    READ_HEALTH_DATA_IN_BACKGROUND: the lane runs from a watchdog broadcast
    receiver, so it is backgrounded by definition. It happens to work without
    this today, and would stop returning anything the moment the provider began
    enforcing it, which is the failure shape this estate keeps finding.
  -->
  <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
  <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

  <!--
    Chunks must land in a directory a second app (Termux sshd, which the
    desktop drain rsyncs through) can read. Scoped storage closes every other
    option: the app-private external dir is unreadable by other apps since
    Android 11, and MediaStore-owned files are not addressable by a plain path.
    All-files access is the only grant that keeps /sdcard/sinnix-ambient
    working as the shared handoff point.
  -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

  <!--
    The live plane. One HTTP client, tailnet only, against prime's hub. The
    file plane (outbox + drain) remains the always-correct path; this makes it
    immediate when the tailnet answers.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Instruments: finger-on-camera PPG, torch-driven CFF, alarm-anchored
       sleep-inertia probes. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.FLASHLIGHT" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

  <!--
    Package visibility for Health Connect. Android 11 filters which packages an
    app targeting SDK 30+ can even see, and without this the Health Connect
    client's provider lookup returns nothing, so getSdkStatus reports
    SDK_UNAVAILABLE_PROVIDER_UPDATE_REQUIRED for a provider that is installed,
    enabled, current, and exporting the very service being looked for.

    That symptom sent this chase a long way in the wrong direction: "update
    required" reads as a version problem, so the client was moved off a
    1.1.0-alpha to GA and compileSdk raised to 36 before anyone checked the
    numbers. The client's own DEFAULT_PROVIDER_MIN_VERSION_CODE is 68623 and
    the installed provider is versionCode 268669. The version test was never
    close to failing. It was visibility the whole time.
  -->
  <queries>
        <package android:name="com.termux" />
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <application
      android:label="@string/app_name"
      android:theme="@style/Theme.Sinnix"
      android:icon="@drawable/ic_launcher"
      android:allowBackup="false"
      android:hasFragileUserData="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="false">

    <!-- One Activity, Compose navigation inside it. Everything that is not a
         timing-critical or intent-entered surface lives here. -->
    <activity
        android:name=".ui.MainActivity"
        android:exported="true"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Instruments run in their own fullscreen Activity rather than as a route
      inside MainActivity. The whole surface is the response target, so system
      chrome drawn over it is a target the operator might hit, and a separate
      task lets a runner be launched straight from a notification or alarm.
    -->
    <activity
        android:name=".ui.instrument.InstrumentActivity"
        android:exported="false"
        android:launchMode="singleTop"
        android:theme="@style/Theme.Sinnix.Fullscreen"
        android:showWhenLocked="true"
        android:turnScreenOn="true" />

    <!-- Hold-to-talk. Its own Activity because the QS tile and the widget both
         launch it directly, and speed from pocket to recording is the feature. -->
    <activity
        android:name=".ui.talk.TalkActivity"
        android:exported="false"
        android:launchMode="singleTop"
        android:theme="@style/Theme.Sinnix" />

    <!-- Mark: one tap, a sheet over whatever was on screen, gone in seconds.
         Dialog-themed so it never reads as "the app opened". -->
    <activity
        android:name=".ui.mark.MarkActivity"
        android:exported="false"
        android:launchMode="singleTop"
        android:excludeFromRecents="true"
        android:theme="@style/Theme.Sinnix.Sheet" />

    <!--
      Share-sheet ingress: the phone's universal export verb into the estate,
      and the sanctioned workaround for Android's background-clipboard-read
      ban. Exported by necessity — that is what makes it a share target.
    -->
    <activity
        android:name=".ui.ingress.ShareIngressActivity"
        android:exported="true"
        android:excludeFromRecents="true"
        android:theme="@style/Theme.Sinnix.Sheet">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/pdf" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!--
      foregroundServiceType="microphone" is why this app exists at all: the
      only supported way to keep MediaRecorder delivering real samples once the
      app loses foreground or the screen turns off. Without it Android silently
      feeds silence and truncates.
    -->
    <service
        android:name=".capture.AmbientService"
        android:exported="false"
        android:foregroundServiceType="microphone"
        android:stopWithTask="false" />

    <!--
      The speech lane. A second microphone-typed service rather than a mode of
      the first: they answer different questions at different rates (archive
      grade against recogniser grade) and one of them is off by default, which
      a shared service would have made awkward to express.
    -->
    <service
        android:name=".capture.SpeechService"
        android:exported="false"
        android:foregroundServiceType="microphone"
        android:stopWithTask="false" />

    <!--
      Capture before first unlock. directBootAware is the whole point: this is
      the only component that exists at all between power-on and the operator
      typing their PIN, which is the window every reboot used to lose.
    -->
    <service
        android:name=".capture.DirectBootService"
        android:exported="false"
        android:directBootAware="true"
        android:foregroundServiceType="microphone"
        android:stopWithTask="false" />

    <receiver
        android:name=".capture.LockedBootReceiver"
        android:exported="true"
        android:directBootAware="true">
      <intent-filter android:priority="999">
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.USER_UNLOCKED" />
      </intent-filter>
    </receiver>

    <receiver
        android:name=".capture.BootReceiver"
        android:exported="true"
        android:enabled="true">
      <intent-filter android:priority="999">
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <!-- Vendor variant emitted by several MIUI builds instead of the AOSP action. -->
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <receiver android:name=".capture.WatchdogReceiver" android:exported="false" />

    <!-- Notification-borne verbs: EMA answered from the shade via RemoteInput,
         receipts acknowledged, a mark logged without opening anything. -->
    <receiver android:name=".sync.NotificationActionReceiver" android:exported="false" />

    <!-- Sleep inertia: setAlarmClock fires this, which launches the micro-PVT. -->
    <receiver android:name=".instruments.sleep.SleepAlarmReceiver" android:exported="false" />

    <!-- Quick-settings tiles. Exported and permission-guarded is the required
         shape; only SystemUI may bind them. -->
    <service
        android:name=".capture.CaptureTileService"
        android:exported="true"
        android:icon="@drawable/ic_capture"
        android:label="@string/tile_capture"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
        android:name=".ui.talk.TalkTileService"
        android:exported="true"
        android:icon="@drawable/ic_talk"
        android:label="@string/tile_talk"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
        android:name=".ui.mark.MarkTileService"
        android:exported="true"
        android:icon="@drawable/ic_mark"
        android:label="@string/tile_mark"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!--
      Notification-listener capture lane. MIUI may revoke this grant silently,
      which is why grant transitions are written as events: a gap in the lane
      then explains itself instead of being guessed at later.
    -->
    <service
        android:name=".ingress.PhoneNotificationListener"
        android:exported="true"
        android:label="@string/listener_label"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!--
      Health Connect's permissions rationale target.

      Not optional decoration: Health Connect refuses to LIST an app, and so
      refuses to hold permissions for it, unless the app answers this action.
      Without it the app declares android.permission.health.* in this file,
      Health Connect never shows it in "App permissions", and HealthLane can
      never be granted anything, which is exactly the state the Band 10
      arrived to on 2026-08-14. `pm grant` cannot substitute: on Android 13
      Health Connect is a separate APK holding its own permission state, so
      the platform grant call accepts these names and silently does nothing.

      The VIEW_PERMISSION_USAGE alias is the Android 14+ spelling of the same
      requirement, declared now so an OS upgrade does not silently re-dark the
      lane.
    -->
    <activity
        android:name=".ingress.HealthPermissionsRationaleActivity"
        android:exported="true"
        android:excludeFromRecents="true"
        android:label="@string/health_rationale_label">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
        android:name=".ingress.HealthPermissionsRationaleAlias"
        android:exported="true"
        android:targetActivity=".ingress.HealthPermissionsRationaleActivity"
        android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>

    <!-- Home-screen widget: the estate line, the capture ribbon, and the two
         verbs that must not cost a launch. -->
    <receiver
        android:name=".ui.widget.SinnixWidgetReceiver"
        android:exported="false"
        android:label="@string/widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/sinnix_widget_info" />
    </receiver>

  </application>
</manifest>
