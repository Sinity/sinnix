+package httpapi
+
+import (
+	"bytes"
+	"context"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed spec/openapi.v0.yaml
+var ownerSpec []byte
+
+// OwnerSchema publishes the same input contracts used by the HTTP handlers.
+func OwnerSchema() (map[string]any, error) {
+	var document map[string]any
+	err := yaml.Unmarshal(ownerSpec, &document)
+	if err != nil {
+		return nil, err
+	}
+	schemas := document["components"].(map[string]any)["schemas"].(map[string]any)
+	for schemaName, value := range schemas {
+		schema, _ := value.(map[string]any)
+		properties, _ := schema["properties"].(map[string]any)
+		for name, value := range properties {
+			revision, _ := value.(map[string]any)
+			if (name == "revision" || schemaName == "Problem" && (name == "expected_version" || name == "actual_version")) && ownerRowToken(revision) {
+				if name == "revision" || name == "actual_version" {
+					properties["bead_revision_domain"] = map[string]any{"type": "string", "enum": []any{"beads_row_revision"}, "description": "Administrative row equality token domain; not an acceptance-contract revision."}
+					properties["bead_revision_coverage"] = map[string]any{"type": "string", "enum": []any{"partial_update_coverage"}, "description": "Claim, close, unclaim and generic update rewrite the token; label-only changes, reopen, restore and compaction may not. Complete change detection also needs updated_at, status and labels."}
+				}
+				revision["type"] = "string"
+				delete(revision, "format")
+				revision["pattern"] = "^-?(0|[1-9][0-9]*)$"
+				originalDescription, _ := revision["description"].(string)
+				revision["description"] = "Opaque signed-64-bit row equality token serialized as an exact decimal string. Never coerce through a floating-point number. Coverage is partial: claim, close, unclaim and generic update rewrite it; label-only changes, reopen, restore and compaction may not. Complete change detection also needs updated_at, status and labels. This is an administrative row token, not an acceptance-contract revision."
+				if schemaName == "Problem" {
+					revision["description"] = revision["description"].(string) + "\n\n" + originalDescription
+				}
+			}
+		}
+	}
+	return document, nil
+}
+
+type OwnerCall struct {
+	Path  map[string]string `json:"path,omitempty"`
+	Query map[string]any    `json:"query,omitempty"`
+	Body  json.RawMessage   `json:"body,omitempty"`
+}
+
+type ownerResponse struct {
+	header http.Header
+	body   bytes.Buffer
+	status int
+}
+
+func (w *ownerResponse) Header() http.Header         { return w.header }
+func (w *ownerResponse) WriteHeader(status int)      { w.status = status }
+func (w *ownerResponse) Write(b []byte) (int, error) { return w.body.Write(b) }
+
+// InvokeOwner runs one published operation locally without opening a listener.
+// Body validation, transactional writes, and failure codes remain the HTTP
+// adapter's existing contract. The CLI owns process lifetime and authorization.
+func InvokeOwner(ctx context.Context, cfg Config, operation string, in OwnerCall) (json.RawMessage, int, error) {
+	if err := checkDatabaseSource(cfg); err != nil {
+		return nil, 0, err
+	}
+	if cfg.Stderr == nil {
+		cfg.Stderr = io.Discard
+	}
+	if cfg.Stdout == nil {
+		cfg.Stdout = os.Stdout
+	}
+	prefix, err := newIDPrefix()
+	if err != nil {
+		return nil, 0, err
+	}
+	s := &Server{
+		cfg:               cfg,
+		provider:          cfg.Provider,
+		issueReader:       cfg.Reader,
+		issueClaimer:      cfg.Claimer,
+		issueBatchCloser:  cfg.BatchCloser,
+		issueReadyClaimer: cfg.ReadyClaimer,
+		issueReleaser:     cfg.Releaser,
+		issueLifecycle:    cfg.Lifecycle,
+		settings:          cfg.Settings,
+		issueStats:        cfg.Stats,
+		issueCycles:       cfg.CycleDetector,
+		issueEdges:        cfg.EdgeReader,
+		issueEdgeCounter:  cfg.GraphCounter,
+		issueRelations:    cfg.Relations,
+		issueCommenter:    cfg.Commenter,
+		issueBlocking:     cfg.BlockingAnnotator,
+		issueTree:         cfg.TreeWalker,
+		issueReadyCounter: cfg.ReadyCounter,
+		issueCounter:      cfg.Counter,
+		issueQuerier:      cfg.Querier,
+		issueSweeper:      cfg.Sweeper,
+		issueDeleter:      cfg.Deleter,
+		issueBatchCreator: cfg.BatchCreator,
+		issueDependencies: cfg.DependencyEditor,
+		issueMetadataCAS:  cfg.MetadataCAS,
+		issueBatchApplier: cfg.BatchApplier,
+		workspaceMemories: cfg.Memories,
+		eventsJournal:     cfg.EventsJournal,
+
+		sem:        make(chan struct{}, maxInflight),
+		semTimeout: semAcquireTimeout,
+		semWarn:    saturationWarn,
+
+		closing:         make(chan struct{}),
+		maxWatchStreams: maxWatchStreams,
+
+		log:      log.New(cfg.Stderr, "bd serve: ", log.LstdFlags|log.LUTC),
+		stdout:   cfg.Stdout,
+		ctxBody:  contextResponse(cfg.Workspace, cfg.SchemaVersion, Capabilities()),
+		hosts:    newHostPolicy(nil, cfg.AllowedHosts),
+		auth:     cfg.Auth,
+		idPrefix: prefix,
+		maxConns: maxConns,
+	}
+
+	for _, rt := range routeTable {
+		if rt.op != operation {
+			continue
+		}
+		if rt.streaming {
+			return nil, 0, fmt.Errorf("streaming operation unavailable on one-shot CLI")
+		}
+		values := url.Values{}
+		for key, value := range in.Query {
+			if array, ok := value.([]any); ok {
+				for _, item := range array {
+					values.Add(key, fmt.Sprint(item))
+				}
+			} else {
+				values.Set(key, fmt.Sprint(value))
+			}
+		}
+		path := rt.specPath
+		for key, value := range in.Path {
+			path = strings.ReplaceAll(path, "{"+key+"}", url.PathEscape(value))
+		}
+		request, err := http.NewRequestWithContext(ctx, rt.method, "http://localhost"+path+"?"+values.Encode(), bytes.NewReader(in.Body))
+		if err != nil {
+			return nil, 0, err
+		}
+		request.Header.Set("Content-Type", "application/json")
+		for key, value := range in.Path {
+			request.SetPathValue(key, value)
+		}
+		out := &ownerResponse{header: make(http.Header), status: http.StatusOK}
+		s.route(rt).ServeHTTP(out, request)
+		body, err := ownerResponseTokens(operation, out.status, out.body.Bytes())
+		return body, out.status, err
+	}
+	return nil, 0, fmt.Errorf("unknown owner operation %q", operation)
+}
+
+// OwnerOperationWrites derives local readonly enforcement from the same route
+// methods the published HTTP contract uses.
+func OwnerOperationWrites(operation string) (bool, error) {
+	for _, rt := range routeTable {
+		if rt.op == operation {
+			return rt.method != "GET" && rt.method != "HEAD", nil
+		}
+	}
+	return false, fmt.Errorf("unknown owner operation %q", operation)
+}
+
+// ownerRowToken selects the native contract's row-version property. Authored
+// metadata and unrelated revision counters have no such schema declaration.
+func ownerRowToken(schema map[string]any) bool {
+	return schema["type"] == "integer" && schema["format"] == "int64"
+}
+
+// ownerResponseTokens projects native HTTP numbers before any lossy decoder.
+// The original HTTP schema supplies traversal; OwnerSchema publishes the same
+// positions as strings. Raw messages preserve all unselected JSON values.
+func ownerResponseTokens(operation string, status int, body json.RawMessage) (json.RawMessage, error) {
+	var document map[string]any
+	if err := yaml.Unmarshal(ownerSpec, &document); err != nil {
+		return nil, err
+	}
+	paths := document["paths"].(map[string]any)
+	for _, value := range paths {
+		path, _ := value.(map[string]any)
+		for _, value := range path {
+			method, _ := value.(map[string]any)
+			if method["operationId"] != operation {
+				continue
+			}
+			responses, _ := method["responses"].(map[string]any)
+			response, _ := responses[strconv.Itoa(status)].(map[string]any)
+			content, _ := response["content"].(map[string]any)
+			media, _ := content["application/json"].(map[string]any)
+			if media == nil {
+				media, _ = content["application/problem+json"].(map[string]any)
+			}
+			schema, _ := media["schema"].(map[string]any)
+			return ownerProjectTokens(document, schema, body)
+		}
+	}
+	return body, nil
+}
+
+func ownerProjectTokens(document, schema map[string]any, body json.RawMessage) (json.RawMessage, error) {
+	if ref, ok := schema["$ref"].(string); ok {
+		const prefix = "#/components/schemas/"
+		if !strings.HasPrefix(ref, prefix) {
+			return nil, fmt.Errorf("unsupported owner response schema %q", ref)
+		}
+		schemas := document["components"].(map[string]any)["schemas"].(map[string]any)
+		resolved, ok := schemas[strings.TrimPrefix(ref, prefix)].(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("missing owner response schema %q", ref)
+		}
+		return ownerProjectTokens(document, resolved, body)
+	}
+	if members, ok := schema["allOf"].([]any); ok {
+		for _, member := range members {
+			var err error
+			body, err = ownerProjectTokens(document, member.(map[string]any), body)
+			if err != nil {
+				return nil, err
+			}
+		}
+	}
+	if schema["type"] == "array" {
+		var items []json.RawMessage
+		if err := json.Unmarshal(body, &items); err != nil {
+			return nil, err
+		}
+		itemSchema, _ := schema["items"].(map[string]any)
+		for i := range items {
+			var err error
+			items[i], err = ownerProjectTokens(document, itemSchema, items[i])
+			if err != nil {
+				return nil, err
+			}
+		}
+		return json.Marshal(items)
+	}
+	properties, ok := schema["properties"].(map[string]any)
+	if !ok || bytes.Equal(bytes.TrimSpace(body), []byte("null")) {
+		return body, nil
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(body, &object); err != nil {
+		return nil, err
+	}
+	for name, value := range properties {
+		raw, exists := object[name]
+		if !exists {
+			continue
+		}
+		child, _ := value.(map[string]any)
+		if (name == "revision" || name == "expected_version" || name == "actual_version") && ownerRowToken(child) {
+			var token int64
+			if err := json.Unmarshal(raw, &token); err != nil {
+				return nil, fmt.Errorf("invalid owner row token: %w", err)
+			}
+			object[name], _ = json.Marshal(strconv.FormatInt(token, 10))
+			if name == "revision" || name == "actual_version" {
+				object["bead_revision_domain"] = json.RawMessage(`"beads_row_revision"`)
+				object["bead_revision_coverage"] = json.RawMessage(`"partial_update_coverage"`)
+			}
+		} else {
+			projected, err := ownerProjectTokens(document, child, raw)
+			if err != nil {
+				return nil, err
+			}
+			object[name] = projected
+		}
+	}
+	return json.Marshal(object)
+}
