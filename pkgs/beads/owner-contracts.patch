+package issueops
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+)
+
+func ownerCycles(items []map[string]any, edges []map[string]any) [][]string {
+	adjacency, reverse := map[string][]string{}, map[string][]string{}
+	for _, row := range items {
+		id := fmt.Sprint(row["id"])
+		adjacency[id] = []string{}
+		reverse[id] = []string{}
+	}
+	for _, edge := range edges {
+		from, to := fmt.Sprint(edge["issue_id"]), ownerEdgeTarget(edge)
+		_, fromOK := adjacency[from]
+		_, toOK := adjacency[to]
+		if fromOK && toOK {
+			adjacency[from] = append(adjacency[from], to)
+			reverse[to] = append(reverse[to], from)
+		}
+	}
+	visited := map[string]bool{}
+	finished := []string{}
+	keys := []string{}
+	for key := range adjacency {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	type frame struct {
+		id   string
+		next int
+	}
+	for _, id := range keys {
+		if visited[id] {
+			continue
+		}
+		visited[id] = true
+		stack := []frame{{id: id}}
+		for len(stack) > 0 {
+			top := &stack[len(stack)-1]
+			if top.next >= len(adjacency[top.id]) {
+				finished = append(finished, top.id)
+				stack = stack[:len(stack)-1]
+				continue
+			}
+			target := adjacency[top.id][top.next]
+			top.next++
+			if !visited[target] {
+				visited[target] = true
+				stack = append(stack, frame{id: target})
+			}
+		}
+	}
+	visited = map[string]bool{}
+	cycles := [][]string{}
+	for i := len(finished) - 1; i >= 0; i-- {
+		id := finished[i]
+		if visited[id] {
+			continue
+		}
+		visited[id] = true
+		component := []string{}
+		pending := []string{id}
+		for len(pending) > 0 {
+			node := pending[len(pending)-1]
+			pending = pending[:len(pending)-1]
+			component = append(component, node)
+			for _, target := range reverse[node] {
+				if !visited[target] {
+					visited[target] = true
+					pending = append(pending, target)
+				}
+			}
+		}
+		self := false
+		for _, target := range adjacency[id] {
+			if target == id {
+				self = true
+			}
+		}
+		if len(component) > 1 || self {
+			sort.Strings(component)
+			cycles = append(cycles, component)
+		}
+	}
+	sort.Slice(cycles, func(i, j int) bool { return strings.Join(cycles[i], "\x00") < strings.Join(cycles[j], "\x00") })
+	return cycles
+}
+
+func (p *ownerReadPlan) readiness(ctx context.Context, db DBTX, items []map[string]any, limit int) (map[string]any, error) {
+	result := map[string]any{}
+	for _, row := range items {
+		id := fmt.Sprint(row["id"])
+		blockers, err := ownerRows(ctx, db, "SELECT d.depends_on_issue_id AS id,b.status FROM "+p.table("dependencies")+" d LEFT JOIN "+p.table("issues")+" b ON b.id=d.depends_on_issue_id WHERE d.issue_id=? AND d.type='blocks' ORDER BY d.depends_on_issue_id LIMIT ?", id, limit+1)
+		if err != nil {
+			return nil, err
+		}
+		unknown := len(blockers) > limit
+		open := []string{}
+		for _, blocker := range blockers {
+			if blocker["status"] == nil {
+				unknown = true
+			} else if blocker["status"] != "closed" && blocker["status"] != "tombstone" {
+				open = append(open, fmt.Sprint(blocker["id"]))
+			}
+		}
+		deferred := false
+		if value := row["defer_until"]; value != nil && value != "" {
+			parsed, err := time.Parse(time.RFC3339Nano, fmt.Sprint(value))
+			if err != nil {
+				unknown = true
+			} else {
+				deferred = parsed.After(p.now)
+			}
+		}
+		state := "ready"
+		switch {
+		case row["status"] == "closed" || row["status"] == "tombstone":
+			state = "closed"
+		case unknown:
+			state = "unknown"
+		case len(open) > 0:
+			state = "blocked"
+		case deferred || row["status"] == "deferred":
+			state = "deferred"
+		case row["status"] != "open":
+			state = "not_open"
+		}
+		result[id] = map[string]any{"state": state, "open_blockers": open, "blockers": open, "blocker_coverage": map[bool]string{true: "partial", false: "complete"}[unknown]}
+	}
+	return result, nil
+}
