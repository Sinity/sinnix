+func ownerEdgeTarget(edge map[string]any) string {
+	for _, key := range []string{"depends_on_issue_id", "depends_on_external", "depends_on_wisp_id", "depends_on_id"} {
+		if value, ok := edge[key]; ok && value != nil && value != "" {
+			return fmt.Sprint(value)
+		}
+	}
+	return ""
+}
+func ownerClosure(roots []string, edges []map[string]any, direction string, relations []string, depth int) ([]string, []map[string]any, bool) {
+	seen := map[string]bool{}
+	frontier := append([]string{}, roots...)
+	for _, id := range roots {
+		seen[id] = true
+	}
+	allowed := map[string]bool{}
+	for _, relation := range relations {
+		allowed[strings.ReplaceAll(relation, "_", "-")] = true
+	}
+	picked := map[int]bool{}
+	truncated := false
+	for level := 0; len(frontier) > 0; level++ {
+		next := []string{}
+		current := map[string]bool{}
+		for _, id := range frontier {
+			current[id] = true
+		}
+		for index, edge := range edges {
+			if ownerProvenanceRelation(fmt.Sprint(edge["type"])) {
+				continue
+			}
+			if len(allowed) > 0 && !allowed[fmt.Sprint(edge["type"])] {
+				continue
+			}
+			from, to := fmt.Sprint(edge["issue_id"]), ownerEdgeTarget(edge)
+			targets := []string{}
+			if direction != "dependents" && current[from] {
+				targets = append(targets, to)
+			}
+			if direction != "dependencies" && current[to] {
+				targets = append(targets, from)
+			}
+			for _, target := range targets {
+				if level >= depth {
+					if !seen[target] {
+						truncated = true
+					}
+					continue
+				}
+				picked[index] = true
+				if target != "" && !seen[target] {
+					seen[target] = true
+					next = append(next, target)
+				}
+			}
+		}
+		if level >= depth {
+			break
+		}
+		frontier = next
+	}
+	ids := []string{}
+	for id := range seen {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	selected := []map[string]any{}
+	for index, edge := range edges {
+		if picked[index] {
+			selected = append(selected, edge)
+		}
+	}
+	return ids, selected, truncated
+}
+func (p *ownerReadPlan) includes(ctx context.Context, db DBTX, id string, names []string) (map[string]any, error) {
+	out := map[string]any{}
+	for _, name := range names {
+		var statement string
+		switch name {
+		case "comments":
+			statement = "SELECT * FROM " + p.table("comments") + " WHERE issue_id=? ORDER BY created_at,id"
+		case "dependencies", "dependents", "children", "blockers":
+			source, target := "issue_id", "depends_on_issue_id"
+			if name == "dependents" || name == "children" {
+				source, target = target, source
+			}
+			statement = "SELECT i.*,d.type AS dependency_type FROM " + p.table("dependencies") + " d LEFT JOIN " + p.table("issues") + " i ON i.id=d." + target + " WHERE d." + source + "=?"
+			if name == "children" {
+				statement += " AND d.type='parent-child'"
+			}
+			if name == "blockers" {
+				statement += " AND d.type='blocks' AND (i.id IS NULL OR i.status NOT IN ('closed','tombstone'))"
+			}
+			statement += " ORDER BY i.id"
+		case "history", "events":
+			out[name] = map[string]any{"state": "unavailable", "reason": "not exposed at an exact historical revision", "revision": p.revision}
+			continue
+		default:
+			return nil, fmt.Errorf("unsupported include %q", name)
+		}
+		rows, err := ownerRows(ctx, db, statement, id)
+		if err != nil {
+			return nil, err
+		}
+		out[name] = map[string]any{"state": "complete", "items": rows, "count": len(rows), "truncated": false, "revision": p.revision}
+	}
+	return out, nil
+}
+
+func ownerProvenanceRelation(kind string) bool {
+	return kind == "discovered-from" || kind == "split-from" || kind == "supersedes" || kind == "residual-of"
+}
+
+func ownerLikeLiteral(value string) string {
+	return strings.NewReplacer("!", "!!", "%", "!%", "_", "!_").Replace(value)
+}
