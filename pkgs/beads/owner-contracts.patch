+package httpapi
+
+import (
+	"bytes"
+	"context"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed spec/openapi.v0.yaml
+var ownerSpec []byte
+
+// OwnerSchema publishes the same input contracts used by the HTTP handlers.
+func OwnerSchema() (map[string]any, error) {
+	var document map[string]any
+	err := yaml.Unmarshal(ownerSpec, &document)
+	return document, err
+}
+
+type OwnerCall struct {
+	Path  map[string]string `json:"path,omitempty"`
+	Query map[string]any    `json:"query,omitempty"`
+	Body  json.RawMessage   `json:"body,omitempty"`
+}
+
+type ownerResponse struct {
+	header http.Header
+	body   bytes.Buffer
+	status int
+}
+
+func (w *ownerResponse) Header() http.Header         { return w.header }
+func (w *ownerResponse) WriteHeader(status int)      { w.status = status }
+func (w *ownerResponse) Write(b []byte) (int, error) { return w.body.Write(b) }
+
+// InvokeOwner runs one published operation locally without opening a listener.
+// Body validation, transactional writes, and failure codes remain the HTTP
+// adapter's existing contract. The CLI owns process lifetime and authorization.
+func InvokeOwner(ctx context.Context, cfg Config, operation string, in OwnerCall) (json.RawMessage, int, error) {
+	if err := checkDatabaseSource(cfg); err != nil {
+		return nil, 0, err
+	}
+	if cfg.Stderr == nil {
+		cfg.Stderr = io.Discard
+	}
+	if cfg.Stdout == nil {
+		cfg.Stdout = os.Stdout
+	}
+	prefix, err := newIDPrefix()
+	if err != nil {
+		return nil, 0, err
+	}
+	s := &Server{
+		cfg:               cfg,
+		provider:          cfg.Provider,
+		issueReader:       cfg.Reader,
+		issueClaimer:      cfg.Claimer,
+		issueBatchCloser:  cfg.BatchCloser,
+		issueReadyClaimer: cfg.ReadyClaimer,
+		issueReleaser:     cfg.Releaser,
+		issueLifecycle:    cfg.Lifecycle,
+		settings:          cfg.Settings,
+		issueStats:        cfg.Stats,
+		issueCycles:       cfg.CycleDetector,
+		issueEdges:        cfg.EdgeReader,
+		issueEdgeCounter:  cfg.GraphCounter,
+		issueRelations:    cfg.Relations,
+		issueCommenter:    cfg.Commenter,
+		issueBlocking:     cfg.BlockingAnnotator,
+		issueTree:         cfg.TreeWalker,
+		issueReadyCounter: cfg.ReadyCounter,
+		issueCounter:      cfg.Counter,
+		issueQuerier:      cfg.Querier,
+		issueSweeper:      cfg.Sweeper,
+		issueDeleter:      cfg.Deleter,
+		issueBatchCreator: cfg.BatchCreator,
+		issueDependencies: cfg.DependencyEditor,
+		issueMetadataCAS:  cfg.MetadataCAS,
+		issueBatchApplier: cfg.BatchApplier,
+		workspaceMemories: cfg.Memories,
+		eventsJournal:     cfg.EventsJournal,
+
+		sem:        make(chan struct{}, maxInflight),
+		semTimeout: semAcquireTimeout,
+		semWarn:    saturationWarn,
+
+		closing:         make(chan struct{}),
+		maxWatchStreams: maxWatchStreams,
+
+		log:      log.New(cfg.Stderr, "bd serve: ", log.LstdFlags|log.LUTC),
+		stdout:   cfg.Stdout,
+		ctxBody:  contextResponse(cfg.Workspace, cfg.SchemaVersion, Capabilities()),
+		hosts:    newHostPolicy(nil, cfg.AllowedHosts),
+		auth:     cfg.Auth,
+		idPrefix: prefix,
+		maxConns: maxConns,
+	}
+
+	for _, rt := range routeTable {
+		if rt.op != operation {
+			continue
+		}
+		if rt.streaming {
+			return nil, 0, fmt.Errorf("streaming operation unavailable on one-shot CLI")
+		}
+		values := url.Values{}
+		for key, value := range in.Query {
+			if array, ok := value.([]any); ok {
+				for _, item := range array {
+					values.Add(key, fmt.Sprint(item))
+				}
+			} else {
+				values.Set(key, fmt.Sprint(value))
+			}
+		}
+		path := rt.specPath
+		for key, value := range in.Path {
+			path = strings.ReplaceAll(path, "{"+key+"}", url.PathEscape(value))
+		}
+		request, err := http.NewRequestWithContext(ctx, rt.method, "http://localhost"+path+"?"+values.Encode(), bytes.NewReader(in.Body))
+		if err != nil {
+			return nil, 0, err
+		}
+		request.Header.Set("Content-Type", "application/json")
+		for key, value := range in.Path {
+			request.SetPathValue(key, value)
+		}
+		out := &ownerResponse{header: make(http.Header), status: http.StatusOK}
+		s.route(rt).ServeHTTP(out, request)
+		return json.RawMessage(out.body.Bytes()), out.status, nil
+	}
+	return nil, 0, fmt.Errorf("unknown owner operation %q", operation)
+}
+
+// OwnerOperationWrites derives local readonly enforcement from the same route
+// methods the published HTTP contract uses.
+func OwnerOperationWrites(operation string) (bool, error) {
+	for _, rt := range routeTable {
+		if rt.op == operation {
+			return rt.method != "GET" && rt.method != "HEAD", nil
+		}
+	}
+	return false, fmt.Errorf("unknown owner operation %q", operation)
+}
