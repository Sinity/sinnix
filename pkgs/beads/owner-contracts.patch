+
+func TestOwnerContractHistoricalReadAndWorkingState(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	t.Setenv("DOLT_ROOT_PATH", t.TempDir())
+	env := newTestEnv(t, "oread")
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	if err := env.store.SetConfig(ctx, "issue_prefix", "oread"); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{"oread-a", "oread-b"} {
+		if err := env.store.CreateIssue(ctx, &types.Issue{ID: id, Title: "Original", Status: types.StatusOpen, IssueType: types.TypeTask, Priority: 2}, "operator"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := env.store.AddDependency(ctx, &types.Dependency{IssueID: "oread-a", DependsOnID: "oread-b", Type: types.DepBlocks}, "operator"); err != nil {
+		t.Fatal(err)
+	}
+	if err := env.store.Commit(ctx, "seed owner read"); err != nil {
+		t.Fatal(err)
+	}
+	read := func(request storageops.OwnerReadRequest) (map[string]any, error) {
+		db, cleanup, err := embeddeddolt.OpenSQL(ctx, env.dataDir, env.database, "main")
+		if err != nil {
+			return nil, err
+		}
+		defer cleanup()
+		return storageops.ReadOwner(ctx, db, request)
+	}
+	initial, err := read(storageops.OwnerReadRequest{At: "HEAD", Roots: []string{"oread-a"}, Provenance: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if initial["total"] != 2 || initial["closure"].(map[string]any)["complete"] != true {
+		t.Fatalf("closure: %v", initial)
+	}
+	revision := initial["revision"].(string)
+	if err := env.store.UpdateIssue(ctx, "oread-a", map[string]any{"title": "Changed"}, "operator"); err != nil {
+		t.Fatal(err)
+	}
+	historic, err := read(storageops.OwnerReadRequest{At: revision, Filters: map[string]any{"id": "oread-a"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if historic["items"].([]map[string]any)[0]["title"] != "Original" {
+		t.Fatalf("history drifted: %v", historic)
+	}
+	working, err := read(storageops.OwnerReadRequest{Filters: map[string]any{"id": "oread-a"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if working["items"].([]map[string]any)[0]["title"] != "Changed" {
+		t.Fatalf("working update hidden: %v", working)
+	}
