@@ -0,0 +1,25 @@
+package main
+
+import (
+	"github.com/steveyegge/beads/internal/configfile"
+	"os"
+	"testing"
+)
+
+func TestOwnerContractForeignDatabaseIgnoresCallerRedirect(t *testing.T) {
+	t.Setenv("BEADS_DOLT_SERVER_DATABASE", "caller_project")
+	for _, database := range []string{"foreign_project", ""} {
+		metadata := &configfile.Config{DoltDatabase: database}
+		options := foreignReadOnlyOptions(metadata)
+		want := database
+		if want == "" {
+			want = configfile.DefaultDoltDatabase
+		}
+		if !options.ReadOnly || options.Database != want {
+			t.Fatalf("foreign open options = %+v, want read-only database %q", options, want)
+		}
+		if metadata.GetDoltDatabase() != "caller_project" || os.Getenv("BEADS_DOLT_SERVER_DATABASE") != "caller_project" {
+			t.Fatal("foreign read changed the caller's database selection")
+		}
+	}
+}
