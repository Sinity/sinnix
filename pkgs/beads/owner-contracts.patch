+		t.Fatal(err)
+	}
+	current, err := env.store.GetIssue(ctx, issue.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale := current.RowVersion ^ 1
+	err = env.store.UpdateIssueChecked(ctx, issue.ID, map[string]interface{}{"title": "Refused"}, "operator", storage.UpdateIssueOptions{ExpectedVersion: &stale})
+	var mismatch *publicops.VersionMismatchError
+	if !errors.Is(err, publicops.ErrVersionMismatch) || !errors.As(err, &mismatch) {
+		t.Fatalf("missing typed refusal: %v", err)
+	}
+	if mismatch.Expected != stale || mismatch.Actual != current.RowVersion {
+		t.Fatalf("observation=%+v", mismatch)
+	}
+	after, err := env.store.GetIssue(ctx, issue.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if after.Title != "Original" || after.RowVersion != current.RowVersion {
+		t.Fatal("refused update changed row")
+	}
+}
