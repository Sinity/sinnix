@@ -0,0 +1,17 @@
+package main
+
+import (
+	"github.com/steveyegge/beads/internal/configfile"
+	"github.com/steveyegge/beads/internal/storage/dolt"
+)
+
+// foreignReadOnlyOptions binds the foreign owner's database explicitly. The
+// caller may have preserved its own redirect identity in the process environment;
+// that override must not retarget reads of another project's capabilities.
+func foreignReadOnlyOptions(cfg *configfile.Config) *dolt.Config {
+	database := cfg.DoltDatabase
+	if database == "" {
+		database = configfile.DefaultDoltDatabase
+	}
+	return &dolt.Config{ReadOnly: true, Database: database}
+}
