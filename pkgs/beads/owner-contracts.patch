+func TestOwnerContractClosureDirectionProvenanceAndBounds(t *testing.T) {
+	edges := []map[string]any{
+		{"issue_id": "bd-a", "depends_on_issue_id": "bd-b", "type": "blocks"},
+		{"issue_id": "bd-b", "depends_on_issue_id": "bd-c", "type": "blocks"},
+		{"issue_id": "bd-a", "depends_on_issue_id": "bd-history", "type": "discovered-from"},
+	}
+	ids, selected, truncated := ownerClosure([]string{"bd-a"}, edges, "dependencies", nil, 1)
+	if !reflect.DeepEqual(ids, []string{"bd-a", "bd-b"}) || len(selected) != 1 || !truncated {
+		t.Fatalf("bounded closure %v %v %v", ids, selected, truncated)
+	}
+	ids, _, truncated = ownerClosure([]string{"bd-c"}, edges, "dependents", nil, 4)
+	if !reflect.DeepEqual(ids, []string{"bd-a", "bd-b", "bd-c"}) || truncated {
+		t.Fatalf("reverse closure %v truncated=%v", ids, truncated)
+	}
+}
+
+func TestOwnerContractFiltersBindCallerValues(t *testing.T) {
+	p := &ownerReadPlan{revision: "0123456789abcdefghijklmnopqrstuv", now: time.Now()}
+	hostile := "x' OR TRUE --"
+	statement, err := p.filters(map[string]any{"or": []any{map[string]any{"title": hostile}, map[string]any{"label": "urgent"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(statement, hostile) || !reflect.DeepEqual(p.args, []any{"%" + hostile + "%", "urgent"}) {
+		t.Fatalf("caller values escaped binding: %s %v", statement, p.args)
+	}
+	node, err := query.Parse("(status=open OR status=closed) AND priority<=2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.expression(node); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.filters(map[string]any{"nonexistent": 1}); err == nil {
+		t.Fatal("unknown field accepted")
+	}
+}
+
+func TestOwnerContractExactRevisionIncludesArePinned(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatal(err)
