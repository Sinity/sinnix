+package issueops
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/steveyegge/beads/internal/query"
+)
+
+type OwnerReadRequest struct {
+	At            string              `json:"at,omitempty"`
+	Expression    string              `json:"expression,omitempty"`
+	Filters       map[string]any      `json:"filters,omitempty"`
+	NativeFilters map[string]any      `json:"native_filters,omitempty"`
+	Projection    string              `json:"projection,omitempty"`
+	View          string              `json:"view,omitempty"`
+	Order         OwnerReadOrder      `json:"order,omitempty"`
+	Aggregate     *OwnerReadAggregate `json:"aggregate,omitempty"`
+	Include       []string            `json:"include,omitempty"`
+	Roots         []string            `json:"roots,omitempty"`
+	Direction     string              `json:"direction,omitempty"`
+	Relations     []string            `json:"relations,omitempty"`
+	Depth         *int                `json:"depth,omitempty"`
+	Limit         *int                `json:"limit,omitempty"`
+	Offset        int                 `json:"offset,omitempty"`
+	IncludeClosed bool                `json:"include_closed,omitempty"`
+	Provenance    bool                `json:"provenance,omitempty"`
+	MaxEdges      int                 `json:"max_edges,omitempty"`
+}
+type OwnerReadOrder struct {
+	Field   string `json:"field,omitempty"`
+	Reverse bool   `json:"reverse,omitempty"`
+}
+type OwnerReadAggregate struct {
+	GroupBy []string `json:"group_by,omitempty"`
+}
+
+// OwnerReadSchema is derived from the request type used by the decoder.
+func OwnerReadSchema() map[string]any { return ownerTypeSchema(reflect.TypeOf(OwnerReadRequest{})) }
+func ownerTypeSchema(t reflect.Type) map[string]any {
+	if t.Kind() == reflect.Pointer {
+		return ownerTypeSchema(t.Elem())
+	}
+	switch t.Kind() {
+	case reflect.Struct:
+		props := map[string]any{}
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			name := strings.Split(f.Tag.Get("json"), ",")[0]
+			props[name] = ownerTypeSchema(f.Type)
+		}
+		return map[string]any{"type": "object", "properties": props, "additionalProperties": false}
+	case reflect.Map:
+		return map[string]any{"type": "object", "additionalProperties": true}
+	case reflect.Slice:
+		return map[string]any{"type": "array", "items": ownerTypeSchema(t.Elem())}
+	case reflect.Bool:
+		return map[string]any{"type": "boolean"}
+	case reflect.Int:
+		return map[string]any{"type": "integer"}
+	default:
+		return map[string]any{"type": "string"}
+	}
+}
+
+type ownerReadPlan struct {
+	revision string
+	working  bool
+	now      time.Time
+	args     []any
+}
+
+var ownerColumns = map[string]string{
+	"id": "id", "title": "title", "status": "status", "priority": "priority", "type": "issue_type", "issue_type": "issue_type", "assignee": "assignee", "owner": "owner", "created": "created_at", "created_at": "created_at", "updated": "updated_at", "updated_at": "updated_at", "closed": "closed_at", "closed_at": "closed_at", "started": "started_at", "started_at": "started_at", "description": "description", "design": "design", "acceptance_criteria": "acceptance_criteria", "notes": "notes", "pinned": "pinned", "ephemeral": "ephemeral", "template": "is_template", "spec": "spec_id", "mol_type": "mol_type", "external_ref": "external_ref", "wisp_type": "wisp_type", "due_at": "due_at", "defer_until": "defer_until",
+}
+var ownerExactHash = regexp.MustCompile(`^[a-zA-Z0-9]{16,64}$`)
+var ownerDuration = regexp.MustCompile(`^(\d+)([hdw])$`)
+
+func (p *ownerReadPlan) table(name string) string {
+	if p.working {
+		return name
+	}
+	return name + " AS OF '" + p.revision + "'"
+}
+func (p *ownerReadPlan) bind(value any) string { p.args = append(p.args, value); return "?" }
+func (p *ownerReadPlan) atom(field, op string, value any) (string, error) {
+	switch value.(type) {
+	case nil, string, bool, float64, int, int64, json.Number:
+	default:
+		return "", fmt.Errorf("filter values must be scalar")
+	}
+
+	if op != "=" && op != "!=" && op != ">" && op != "<" && op != ">=" && op != "<=" {
+		return "", fmt.Errorf("unsupported comparison %q", op)
+	}
+	if field == "label" || field == "parent" {
+		if op != "=" && op != "!=" {
+			return "", fmt.Errorf("%s supports equality only", field)
+		}
+		negate := op == "!="
+		var predicate string
+		if field == "label" {
+			predicate = "EXISTS (SELECT 1 FROM " + p.table("labels") + " l WHERE l.issue_id=i.id"
+			if value == "none" {
+				negate = !negate
+			} else {
+				predicate += " AND l.label=" + p.bind(value)
+			}
+			predicate += ")"
+		} else {
+			predicate = "EXISTS (SELECT 1 FROM " + p.table("dependencies") + " d WHERE d.issue_id=i.id AND d.type='parent-child' AND d.depends_on_issue_id=" + p.bind(value) + ")"
+		}
+		if negate {
+			predicate = "NOT (" + predicate + ")"
+		}
+		return predicate, nil
+	}
+	column, ok := ownerColumns[field]
+	if !ok {
+		return "", fmt.Errorf("unsupported filter field %q", field)
+	}
+	column = "i." + column
+	if value == "none" && (field == "assignee" || field == "description") {
+		return "COALESCE(" + column + ",'') " + op + " ''", nil
+	}
+	if text, ok := value.(string); ok {
+		switch field {
+		case "created", "created_at", "updated", "updated_at", "closed", "closed_at", "started", "started_at", "due_at", "defer_until":
+			if duration := ownerDuration.FindStringSubmatch(text); duration != nil {
+				n, _ := strconv.Atoi(duration[1])
+				hours := map[string]int{"h": 1, "d": 24, "w": 168}[duration[2]]
+				value = p.now.Add(-time.Duration(n*hours) * time.Hour)
+			} else if strings.Contains(text, "T") {
+				parsed, err := time.Parse(time.RFC3339Nano, text)
+				if err != nil {
+					return "", err
+				}
+				value = parsed.UTC()
+			}
+		}
+		if field == "title" || field == "description" || field == "notes" {
+			if op == "=" || op == "!=" {
+				operator := "LIKE"
+				if op == "!=" {
+					operator = "NOT LIKE"
+				}
+				return column + " " + operator + " " + p.bind("%"+ownerLikeLiteral(text)+"%") + " ESCAPE '!'", nil
+			}
+		}
+		if (field == "id" || field == "spec") && strings.ContainsAny(text, "*?") {
+			operator := "LIKE"
+			if op == "!=" {
+				operator = "NOT LIKE"
+			}
+			return column + " " + operator + " " + p.bind(strings.NewReplacer("*", "%", "?", "_").Replace(ownerLikeLiteral(text))) + " ESCAPE '!'", nil
+		}
+	}
+	if value == nil {
+		if op == "=" {
+			return column + " IS NULL", nil
+		}
+		if op == "!=" {
+			return column + " IS NOT NULL", nil
+		}
+	}
+	return column + " " + op + " " + p.bind(value), nil
+}
+func (p *ownerReadPlan) expression(node query.Node) (string, error) {
+	switch n := node.(type) {
+	case *query.ComparisonNode:
+		value := any(n.Value)
+		if n.Value == "true" {
+			value = true
+		}
+		if n.Value == "false" {
+			value = false
+		}
+		return p.atom(n.Field, n.Op.String(), value)
+	case *query.NotNode:
+		value, err := p.expression(n.Operand)
+		return "NOT (" + value + ")", err
+	case *query.AndNode:
+		left, err := p.expression(n.Left)
+		if err != nil {
+			return "", err
+		}
+		right, err := p.expression(n.Right)
+		return "(" + left + " AND " + right + ")", err
+	case *query.OrNode:
+		left, err := p.expression(n.Left)
+		if err != nil {
+			return "", err
+		}
+		right, err := p.expression(n.Right)
+		return "(" + left + " OR " + right + ")", err
+	default:
+		return "", fmt.Errorf("unsupported query node")
+	}
+}
+func (p *ownerReadPlan) filters(node map[string]any) (string, error) {
+	if len(node) == 0 {
+		return "TRUE", nil
+	}
+	keys := make([]string, 0, len(node))
+	for key := range node {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	predicates := []string{}
+	for _, key := range keys {
+		value := node[key]
+		switch key {
+		case "and", "or":
+			children, ok := value.([]any)
+			if !ok || len(children) == 0 || len(node) != 1 {
+				return "", fmt.Errorf("boolean filter requires children")
+			}
+			parts := []string{}
+			for _, child := range children {
+				object, ok := child.(map[string]any)
+				if !ok {
+					return "", fmt.Errorf("filter child must be an object")
+				}
+				part, err := p.filters(object)
+				if err != nil {
+					return "", err
+				}
+				parts = append(parts, "("+part+")")
+			}
+			return strings.Join(parts, " "+strings.ToUpper(key)+" "), nil
+		case "not":
+			child, ok := value.(map[string]any)
+			if !ok || len(node) != 1 {
+				return "", fmt.Errorf("not requires one filter")
+			}
+			part, err := p.filters(child)
+			return "NOT (" + part + ")", err
+		default:
+			op := "="
+			if object, ok := value.(map[string]any); ok {
+				for k := range object {
+					if k != "op" && k != "value" {
+						return "", fmt.Errorf("unknown comparison member %q", k)
+					}
+				}
+				if object["op"] != nil {
+					op = fmt.Sprint(object["op"])
+				}
+				value = object["value"]
+			}
+			part, err := p.atom(key, op, value)
+			if err != nil {
+				return "", err
+			}
+			predicates = append(predicates, "("+part+")")
+		}
+	}
+	return strings.Join(predicates, " AND "), nil
+}
+func (p *ownerReadPlan) blockers() string {
+	return "EXISTS (SELECT 1 FROM " + p.table("dependencies") + " d LEFT JOIN " + p.table("issues") + " b ON b.id=d.depends_on_issue_id WHERE d.issue_id=i.id AND d.type='blocks' AND (b.id IS NULL OR b.status NOT IN ('closed','tombstone')))"
+}
+func ownerTrue(values map[string]any, key string) bool { return values[key] == true }
+func (p *ownerReadPlan) native(values map[string]any) ([]string, error) {
+	parts := []string{}
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	add := func(field, op string, value any) error {
+		part, err := p.atom(field, op, value)
+		if err == nil {
+			parts = append(parts, part)
+		}
+		return err
+	}
+	for _, key := range keys {
+		value := values[key]
+		if value == nil {
+			continue
+		}
+		if flag, ok := value.(bool); ok && !flag {
+			return nil, fmt.Errorf("native boolean filters must be true when supplied")
+		}
+		switch key {
+		case "all", "include_gates", "include_infra", "include_templates", "include_ephemeral", "include_deferred", "stale_days":
+			continue
+		case "label", "exclude_label", "label_any", "exclude_type":
+			array, ok := value.([]any)
+			if !ok {
+				return nil, fmt.Errorf("%s requires array", key)
+			}
+			sub := []string{}
+			for _, v := range array {
+				field, op := "label", "="
+				if key == "exclude_type" {
+					field = "type"
+				}
+				if strings.HasPrefix(key, "exclude") {
+					op = "!="
+				}
+				part, err := p.atom(field, op, v)
+				if err != nil {
+					return nil, err
+				}
+				sub = append(sub, part)
+			}
+			join := " AND "
+			if key == "label_any" {
+				join = " OR "
+			}
+			if len(sub) > 0 {
+				parts = append(parts, "("+strings.Join(sub, join)+")")
+			}
+		case "priority", "priority_min", "priority_max":
+			n, err := strconv.Atoi(strings.TrimPrefix(strings.ToUpper(fmt.Sprint(value)), "P"))
+			if err != nil {
+				return nil, err
+			}
+			op := map[string]string{"priority": "=", "priority_min": ">=", "priority_max": "<="}[key]
+			if err = add("priority", op, n); err != nil {
+				return nil, err
+			}
+		case "id", "status":
+			sub := []string{}
+			for _, v := range strings.Split(fmt.Sprint(value), ",") {
+				part, err := p.atom(key, "=", v)
+				if err != nil {
+					return nil, err
+				}
+				sub = append(sub, part)
+			}
+			parts = append(parts, "("+strings.Join(sub, " OR ")+")")
+		case "no_assignee", "unassigned", "no_labels", "empty_description":
+			field := map[string]string{"no_assignee": "assignee", "unassigned": "assignee", "no_labels": "label", "empty_description": "description"}[key]
+			if err := add(field, "=", "none"); err != nil {
+				return nil, err
+			}
+		case "title_contains", "desc_contains", "notes_contains":
+			field := map[string]string{"title_contains": "title", "desc_contains": "description", "notes_contains": "notes"}[key]
+			if err := add(field, "=", value); err != nil {
+				return nil, err
+			}
+		case "no_pinned":
+			parts = append(parts, "COALESCE(i.pinned,FALSE)=FALSE")
+		case "no_parent":
+			parts = append(parts, "NOT EXISTS (SELECT 1 FROM "+p.table("dependencies")+" d WHERE d.issue_id=i.id AND d.type='parent-child')")
+		case "deferred":
+			parts = append(parts, "i.defer_until IS NOT NULL")
+		case "overdue":
+			parts = append(parts, "i.due_at < "+p.bind(p.now)+" AND i.status <> 'closed'")
+		case "ready", "gated":
+			part := p.blockers()
+			if key == "ready" {
+				part = "NOT " + part
+			}
+			parts = append(parts, part)
+		case "spec":
+			parts = append(parts, "i.spec_id LIKE "+p.bind(ownerLikeLiteral(fmt.Sprint(value))+"%")+" ESCAPE '!'")
+		case "external_contains":
+			parts = append(parts, "i.external_ref LIKE "+p.bind("%"+ownerLikeLiteral(fmt.Sprint(value))+"%")+" ESCAPE '!'")
+		case "label_pattern", "label_regex":
+			operator, pattern := "LIKE", fmt.Sprint(value)
+			if key == "label_regex" {
+				operator = "REGEXP"
+			} else {
+				pattern = strings.NewReplacer("*", "%", "?", "_").Replace(ownerLikeLiteral(pattern))
+			}
+			suffix := ""
+			if key == "label_pattern" {
+				suffix = " ESCAPE '!'"
+			}
+			parts = append(parts, "EXISTS (SELECT 1 FROM "+p.table("labels")+" l WHERE l.issue_id=i.id AND l.label "+operator+" "+p.bind(pattern)+suffix+")")
+		case "has_metadata_key", "metadata_field":
+			array := []any{value}
+			if key == "metadata_field" {
+				var ok bool
+				array, ok = value.([]any)
+				if !ok {
+					return nil, fmt.Errorf("metadata_field requires array")
+				}
+			}
+			for _, v := range array {
+				k, expected, _ := strings.Cut(fmt.Sprint(v), "=")
+				encoded, _ := json.Marshal(k)
+				part := "JSON_EXTRACT(i.metadata," + p.bind("$."+string(encoded)) + ")"
+				if key == "has_metadata_key" {
+					part += " IS NOT NULL"
+				} else {
+					part = "JSON_UNQUOTE(" + part + ")=" + p.bind(expected)
+				}
+				parts = append(parts, part)
+			}
+		default:
+			field, op := key, "="
+			if strings.HasSuffix(key, "_before") || strings.HasSuffix(key, "_after") {
+				idx := strings.LastIndex(key, "_")
+				field = key[:idx]
+				op = ">"
+				if key[idx+1:] == "before" {
+					op = "<"
+				}
+				if field == "due" {
+					field = "due_at"
+				}
+				if field == "defer" {
+					field = "defer_until"
+				}
+			}
+			if err := add(field, op, value); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return parts, nil
+}
+func ownerRows(ctx context.Context, db DBTX, statement string, args ...any) ([]map[string]any, error) {
+	rows, err := db.QueryContext(ctx, statement, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	columns, err := rows.Columns()
+	if err != nil {
+		return nil, err
+	}
+	out := []map[string]any{}
+	for rows.Next() {
+		values := make([]any, len(columns))
+		pointers := make([]any, len(columns))
+		for i := range values {
+			pointers[i] = &values[i]
+		}
+		if err := rows.Scan(pointers...); err != nil {
+			return nil, err
+		}
+		row := map[string]any{}
+		for i, column := range columns {
+			value := values[i]
+			if b, ok := value.([]byte); ok {
+				value = string(b)
+			}
+			if t, ok := value.(time.Time); ok {
+				value = t.UTC().Format(time.RFC3339Nano)
+			}
+			if column == "metadata" {
+				if text, ok := value.(string); ok {
+					var decoded any
+					if json.Unmarshal([]byte(text), &decoded) == nil {
+						value = decoded
+					}
+				}
+			}
+			row[column] = value
+		}
+		if token, ok := row["row_lock"]; ok {
+			row["revision"] = token
+			row["bead_revision"] = fmt.Sprint(token)
+			row["bead_revision_domain"] = "beads_row_revision"
+			row["bead_revision_coverage"] = "partial_update_coverage"
+			delete(row, "row_lock")
+		}
+		out = append(out, row)
+	}
+	return out, rows.Err()
+}
+
+// ReadOwner pins all tables to one resolved commit, including auxiliary reads.
+// SQL interpolation is confined to validated table/column vocabularies and the
+// resolved hash; caller values are always bound parameters.
+func ReadOwner(ctx context.Context, db *sql.DB, in OwnerReadRequest) (map[string]any, error) {
+	limit := 1000
+	if in.Limit != nil {
+		limit = *in.Limit
+	}
+	if limit < 0 || limit > 100000 || in.Offset < 0 {
+		return nil, fmt.Errorf("invalid page bounds")
+	}
+	if limit == 0 {
+		limit = 100000
+	}
+	if in.MaxEdges == 0 {
+		in.MaxEdges = 100000
+	}
+	if in.MaxEdges < 1 || in.MaxEdges > 100000 {
+		return nil, fmt.Errorf("invalid edge bound")
+	}
+	if in.Direction == "" {
+		in.Direction = "dependencies"
+	}
+	if in.Direction != "dependencies" && in.Direction != "dependents" && in.Direction != "both" {
+		return nil, fmt.Errorf("invalid closure direction")
+	}
+	depth := 1000
+	if in.Depth != nil {
+		depth = *in.Depth
+	}
+	if depth < 0 || depth > 1000 {
+		return nil, fmt.Errorf("invalid closure depth")
+	}
+	p := &ownerReadPlan{now: time.Now().UTC()}
+	requested := in.At
+	p.working = requested == ""
+	semantics := "exact_revision"
+	var effective any
+	if p.working {
+		semantics = "working_snapshot"
+		if err := db.QueryRowContext(ctx, "SELECT DOLT_HASHOF_DB()").Scan(&p.revision); err != nil {
+			return nil, err
+		}
+	} else if parsed, err := time.Parse(time.RFC3339Nano, requested); err == nil {
+		p.now = parsed.UTC()
+		semantics = "latest_reachable_commit_at_or_before"
+		rows, err := ownerRows(ctx, db, "SELECT commit_hash, date AS committed_at FROM DOLT_LOG('HEAD') WHERE date <= ? ORDER BY date DESC, commit_order DESC LIMIT 1", p.now)
+		if err != nil {
+			return nil, err
+		}
+		if len(rows) == 0 {
+			return nil, fmt.Errorf("no reachable revision at or before requested time")
+		}
+		p.revision = fmt.Sprint(rows[0]["commit_hash"])
+		effective = rows[0]["committed_at"]
+	} else {
+		if err := db.QueryRowContext(ctx, "SELECT DOLT_HASHOF(?)", requested).Scan(&p.revision); err != nil {
+			return nil, err
+		}
+	}
+	if !ownerExactHash.MatchString(p.revision) {
+		return nil, fmt.Errorf("owner resolved invalid revision")
+	}
+	temporal := map[string]any{"requested": requested, "resolved_revision": p.revision, "effective_at": effective, "observed_at": time.Now().UTC().Format(time.RFC3339Nano), "semantics": semantics, "watermark": p.revision, "pinned": !p.working}
+	predicate, err := p.filters(in.Filters)
+	if err != nil {
+		return nil, err
+	}
+	parts := []string{predicate}
+	native, err := p.native(in.NativeFilters)
+	if err != nil {
+		return nil, err
+	}
+	parts = append(parts, native...)
+	if in.Expression != "" {
+		node, err := query.Parse(in.Expression)
+		if err != nil {
+			return nil, err
+		}
+		part, err := p.expression(node)
+		if err != nil {
+			return nil, err
+		}
+		parts = append(parts, part)
+	}
+	view := in.View
+	if view == "" {
+		view = "all"
+	}
+	switch view {
+	case "all", "query", "recent":
+	case "open":
+		parts = append(parts, "i.status='open'")
+	case "ready":
+		parts = append(parts, "i.status='open'", "NOT "+p.blockers())
+	case "blocked":
+		parts = append(parts, p.blockers())
+	case "overdue":
+		parts = append(parts, "i.due_at < "+p.bind(p.now)+" AND i.status <> 'closed'")
+	case "deferred":
+		parts = append(parts, "i.defer_until IS NOT NULL")
+	case "unassigned":
+		parts = append(parts, "COALESCE(i.assignee,'')=''")
+	case "epic_progress":
+		parts = append(parts, "i.issue_type='epic'")
+	case "stale_claims":
+		days := 30
+		if value, ok := in.NativeFilters["stale_days"]; ok {
+			n, err := strconv.Atoi(fmt.Sprint(value))
+			if err != nil {
+				return nil, err
+			}
+			days = n
+		}
+		parts = append(parts, "i.status='in_progress'", "i.updated_at < "+p.bind(p.now.Add(-time.Duration(days)*24*time.Hour)))
+	case "changed_since":
+		if in.NativeFilters["updated_after"] == nil {
+			return nil, fmt.Errorf("changed_since requires updated_after")
+		}
+	default:
+		return nil, fmt.Errorf("unsupported query view %q", view)
+	}
+	if view != "all" && view != "query" && !in.IncludeClosed && !ownerTrue(in.NativeFilters, "all") {
+		parts = append(parts, "i.status NOT IN ('closed','tombstone')")
+	}
+	if !ownerTrue(in.NativeFilters, "include_deferred") && view != "all" && view != "deferred" && !ownerTrue(in.NativeFilters, "deferred") {
+		parts = append(parts, "(i.defer_until IS NULL OR i.defer_until <= "+p.bind(p.now)+")")
+	}
+	// An explicit closure addresses durable members irrespective of display filters.
+	if len(in.Roots) == 0 {
+		for _, item := range []struct{ key, sql string }{{"include_gates", "i.issue_type <> 'gate'"}, {"include_infra", "i.issue_type NOT IN ('agent','role','message')"}, {"include_templates", "COALESCE(i.is_template,FALSE)=FALSE"}, {"include_ephemeral", "COALESCE(i.ephemeral,FALSE)=FALSE"}} {
+			if !ownerTrue(in.NativeFilters, item.key) && !(item.key == "include_gates" && in.NativeFilters["type"] == "gate") {
+				parts = append(parts, item.sql)
+			}
+		}
+	}
+	base := " FROM " + p.table("issues") + " i WHERE (" + strings.Join(parts, ") AND (") + ")"
+	closure := map[string]any{"complete": in.Offset == 0, "missing_ids": []string{}, "truncated": false}
+	edges := []map[string]any{}
+	if len(in.Roots) > 0 {
+		var err error
+		edges, err = ownerRows(ctx, db, "SELECT * FROM "+p.table("dependencies")+" ORDER BY issue_id, depends_on_issue_id, type LIMIT ?", in.MaxEdges+1)
+		if err != nil {
+			return nil, err
+		}
+		if len(edges) > in.MaxEdges {
+			edges = edges[:in.MaxEdges]
+			closure["complete"] = false
+			closure["truncated"] = true
+		}
+		ids, selected, cut := ownerClosure(in.Roots, edges, in.Direction, in.Relations, depth)
+		edges = selected
+		if cut {
+			closure["complete"] = false
+			closure["truncated"] = true
+		}
+		p.args = nil
+		placeholders := []string{}
+		for _, id := range ids {
+			placeholders = append(placeholders, p.bind(id))
+		}
+		base = " FROM " + p.table("issues") + " i WHERE i.id IN (" + strings.Join(placeholders, ",") + ")"
+		closure["requested_ids"] = ids
+	}
+	var total int
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*)"+base, p.args...).Scan(&total); err != nil {
+		return nil, err
+	}
+	selected := "i.*"
+	group := ""
+	if in.Aggregate != nil {
+		columns := []string{}
+		seen := map[string]bool{}
+		for _, field := range in.Aggregate.GroupBy {
+			if !strings.Contains("|status|type|priority|assignee|owner|", "|"+field+"|") || seen[field] {
+				return nil, fmt.Errorf("unsupported or duplicate grouping %q", field)
+			}
+			seen[field] = true
+			columns = append(columns, "i."+ownerColumns[field])
+		}
+		selected = strings.Join(append(columns, "COUNT(*) AS count"), ", ")
+		if len(columns) > 0 {
+			group = " GROUP BY " + strings.Join(columns, ", ") + " ORDER BY " + strings.Join(columns, ", ")
+		}
+	} else {
+		field := in.Order.Field
+		if field == "" {
+			field = "priority"
+			if view == "recent" {
+				field = "updated"
+			}
+		}
+		if !strings.Contains("|priority|created|updated|closed|status|id|title|type|assignee|", "|"+field+"|") {
+			return nil, fmt.Errorf("unsupported order")
+		}
+		descending := field == "created" || field == "updated" || field == "closed"
+		descending = descending != in.Order.Reverse
+		direction := " ASC"
+		if descending {
+			direction = " DESC"
+		}
+		group = " ORDER BY i." + ownerColumns[field] + direction + ", i.id ASC"
+	}
+	args := append(append([]any{}, p.args...), limit+1, in.Offset)
+	items, err := ownerRows(ctx, db, "SELECT "+selected+base+group+" LIMIT ? OFFSET ?", args...)
+	if err != nil {
+		return nil, err
+	}
+	more := len(items) > limit
+	if more {
+		items = items[:limit]
+		closure["complete"] = false
+		closure["truncated"] = true
+	}
+	if in.Aggregate == nil {
+		seen := map[string]bool{}
+		for _, row := range items {
+			id := fmt.Sprint(row["id"])
+			seen[id] = true
+			labels, err := ownerRows(ctx, db, "SELECT label FROM "+p.table("labels")+" WHERE issue_id=? ORDER BY label", id)
+			if err != nil {
+				return nil, err
+			}
+			values := []any{}
+			for _, label := range labels {
+				values = append(values, label["label"])
+			}
+			row["labels"] = values
+			includes, err := p.includes(ctx, db, id, in.Include)
+			if err != nil {
+				return nil, err
+			}
+			if len(includes) > 0 {
+				row["includes"] = includes
+			}
+		}
+		if ids, ok := closure["requested_ids"].([]string); ok {
+			missing := []string{}
+			if !more && in.Offset == 0 {
+				for _, id := range ids {
+					if !seen[id] {
+						missing = append(missing, id)
+					}
+				}
+			}
+			closure["missing_ids"] = missing
+			if len(missing) > 0 {
+				closure["complete"] = false
+			}
+		}
+	}
+	for _, edge := range edges {
+		edge["depends_on_id"] = ownerEdgeTarget(edge)
+	}
+	provenanceEdges := []map[string]any{}
+	provenanceCoverage := map[string]any{"state": "not_requested", "complete": false, "revision": p.revision}
+	if in.Provenance && in.Aggregate == nil {
+		provenanceEdges, provenanceCoverage, err = p.provenance(ctx, db, items, in.MaxEdges, closure["complete"] == true)
+		if err != nil {
+			return nil, err
+		}
+	}
+	leaves := []string{}
+	if len(in.Roots) > 0 {
+		outgoing := map[string]bool{}
+		for _, edge := range edges {
+			if in.Direction != "dependents" {
+				outgoing[fmt.Sprint(edge["issue_id"])] = true
+			}
+			if in.Direction != "dependencies" {
+				outgoing[ownerEdgeTarget(edge)] = true
+			}
+		}
+		for _, row := range items {
+			id := fmt.Sprint(row["id"])
+			if !outgoing[id] && closure["complete"] == true {
+				leaves = append(leaves, id)
+			}
+		}
+		sort.Strings(leaves)
+	}
+	closure["graph_leaves"] = leaves
+
+	readiness := map[string]any{}
+	cycles := [][]string{}
+	frontier := []map[string]any{}
+	if len(in.Roots) > 0 {
+		readiness, err = p.readiness(ctx, db, items, in.MaxEdges)
+		if err != nil {
+			return nil, err
+		}
+		cycles = ownerCycles(items, edges)
+		if closure["truncated"] == true {
+			frontier = append(frontier, map[string]any{"reason": "closure_bound"})
+		}
+		for _, id := range closure["missing_ids"].([]string) {
+			frontier = append(frontier, map[string]any{"id": id, "reason": "missing"})
+		}
+	}
+	statuses := map[string]int{}
+	for _, row := range items {
+		statuses[fmt.Sprint(row["status"])]++
+	}
+	readinessCounts := map[string]int{}
+	for _, value := range readiness {
+		readinessCounts[fmt.Sprint(value.(map[string]any)["state"])]++
+	}
+	counts := map[string]any{"nodes": len(items), "edges": len(edges), "provenance_edges": len(provenanceEdges), "cycles": len(cycles), "statuses": statuses, "readiness": readinessCounts}
+	coverage := map[string]any{"complete": closure["complete"], "state": map[bool]string{true: "complete", false: "partial"}[closure["complete"] == true]}
+	if in.Projection != "" && in.Projection != "full" && in.Projection != "summary" {
+		return nil, fmt.Errorf("unsupported projection")
+	}
+	if in.Projection == "summary" && in.Aggregate == nil {
+		keep := map[string]bool{}
+		for _, key := range []string{"id", "title", "status", "priority", "issue_type", "assignee", "owner", "created_at", "updated_at", "closed_at", "metadata", "defer_until", "due_at", "labels", "revision", "bead_revision", "bead_revision_domain", "bead_revision_coverage", "includes"} {
+			keep[key] = true
+		}
+		for _, row := range items {
+			for key := range row {
+				if !keep[key] {
+					delete(row, key)
+				}
+			}
+		}
+	}
+
+	if p.working {
+		var after string
+		if err := db.QueryRowContext(ctx, "SELECT DOLT_HASHOF_DB()").Scan(&after); err != nil {
+			return nil, err
+		}
+		if after != p.revision {
+			return nil, fmt.Errorf("source_changed: working snapshot changed during read")
+		}
+	}
+	return map[string]any{"revision": p.revision, "temporal": temporal, "items": items, "edges": edges, "total": total, "total_exact": true, "has_more": more, "closure": closure, "aggregate": in.Aggregate != nil, "provenance_edges": provenanceEdges, "provenance_coverage": provenanceCoverage, "graph_leaves": leaves, "readiness": readiness, "cycles": cycles, "frontier": frontier, "coverage": coverage, "counts": counts}, nil
+}
+func ownerEdgeTarget(edge map[string]any) string {
+	for _, key := range []string{"depends_on_issue_id", "depends_on_external", "depends_on_wisp_id", "depends_on_id"} {
+		if value, ok := edge[key]; ok && value != nil && value != "" {
+			return fmt.Sprint(value)
+		}
+	}
+	return ""
+}
+func ownerClosure(roots []string, edges []map[string]any, direction string, relations []string, depth int) ([]string, []map[string]any, bool) {
+	seen := map[string]bool{}
+	frontier := append([]string{}, roots...)
+	for _, id := range roots {
+		seen[id] = true
+	}
+	allowed := map[string]bool{}
+	for _, relation := range relations {
+		allowed[strings.ReplaceAll(relation, "_", "-")] = true
+	}
+	picked := map[int]bool{}
+	truncated := false
+	for level := 0; len(frontier) > 0; level++ {
+		next := []string{}
+		current := map[string]bool{}
+		for _, id := range frontier {
+			current[id] = true
+		}
+		for index, edge := range edges {
+			if ownerProvenanceRelation(fmt.Sprint(edge["type"])) {
+				continue
+			}
+			if len(allowed) > 0 && !allowed[fmt.Sprint(edge["type"])] {
+				continue
+			}
+			from, to := fmt.Sprint(edge["issue_id"]), ownerEdgeTarget(edge)
+			targets := []string{}
+			if direction != "dependents" && current[from] {
+				targets = append(targets, to)
+			}
+			if direction != "dependencies" && current[to] {
+				targets = append(targets, from)
+			}
+			for _, target := range targets {
+				if level >= depth {
+					if !seen[target] {
+						truncated = true
+					}
+					continue
+				}
+				picked[index] = true
+				if target != "" && !seen[target] {
+					seen[target] = true
+					next = append(next, target)
+				}
+			}
+		}
+		if level >= depth {
+			break
+		}
+		frontier = next
+	}
+	ids := []string{}
+	for id := range seen {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	selected := []map[string]any{}
+	for index, edge := range edges {
+		if picked[index] {
+			selected = append(selected, edge)
+		}
+	}
+	return ids, selected, truncated
+}
+func (p *ownerReadPlan) includes(ctx context.Context, db DBTX, id string, names []string) (map[string]any, error) {
+	out := map[string]any{}
+	for _, name := range names {
+		var statement string
+		switch name {
+		case "comments":
+			statement = "SELECT * FROM " + p.table("comments") + " WHERE issue_id=? ORDER BY created_at,id"
+		case "dependencies", "dependents", "children", "blockers":
+			source, target := "issue_id", "depends_on_issue_id"
+			if name == "dependents" || name == "children" {
+				source, target = target, source
+			}
+			statement = "SELECT i.*,d.type AS dependency_type FROM " + p.table("dependencies") + " d LEFT JOIN " + p.table("issues") + " i ON i.id=d." + target + " WHERE d." + source + "=?"
+			if name == "children" {
+				statement += " AND d.type='parent-child'"
+			}
+			if name == "blockers" {
+				statement += " AND d.type='blocks' AND (i.id IS NULL OR i.status NOT IN ('closed','tombstone'))"
+			}
+			statement += " ORDER BY i.id"
+		case "history", "events":
+			out[name] = map[string]any{"state": "unavailable", "reason": "not exposed at an exact historical revision", "revision": p.revision}
+			continue
+		default:
+			return nil, fmt.Errorf("unsupported include %q", name)
+		}
+		rows, err := ownerRows(ctx, db, statement, id)
+		if err != nil {
+			return nil, err
+		}
+		out[name] = map[string]any{"state": "complete", "items": rows, "count": len(rows), "truncated": false, "revision": p.revision}
+	}
+	return out, nil
+}
+
+func ownerProvenanceRelation(kind string) bool {
+	return kind == "discovered-from" || kind == "split-from" || kind == "supersedes" || kind == "residual-of"
+}
+
+func ownerLikeLiteral(value string) string {
+	return strings.NewReplacer("!", "!!", "%", "!%", "_", "!_").Replace(value)
+}
