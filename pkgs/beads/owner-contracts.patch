+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/steveyegge/beads/internal/eventsjournal"
+	"github.com/steveyegge/beads/internal/httpapi"
+	"github.com/steveyegge/beads/internal/storage"
+	"github.com/steveyegge/beads/internal/storage/contextinfo"
+	storageops "github.com/steveyegge/beads/internal/storage/issueops"
+)
+
+func ownerDecode(in any) error {
+	decoder := json.NewDecoder(io.LimitReader(os.Stdin, 4<<20))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(in); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return fmt.Errorf("expected one JSON request")
+	}
+	return nil
+}
+
+var ownerCmd = &cobra.Command{Use: "owner", Short: "Typed local issue operations and immutable analytical reads", GroupID: "maint"}
+var ownerSchemaCmd = &cobra.Command{Use: "schema", Short: "Print machine-readable owner contracts", Args: cobra.NoArgs, Annotations: map[string]string{skipStoreAnnotation: "1"}, RunE: func(cmd *cobra.Command, args []string) error {
+	schema, err := httpapi.OwnerSchema()
+	if err != nil {
+		return err
+	}
+	schema["x-beads-owner-read"] = storageops.OwnerReadSchema()
+	return outputJSON(schema)
+}}
+var ownerCallCmd = &cobra.Command{Use: "call operation", Short: "Invoke a published operation with a JSON request on stdin", Args: cobra.ExactArgs(1), RunE: func(cmd *cobra.Command, args []string) error {
+	var in httpapi.OwnerCall
+	if err := ownerDecode(&in); err != nil {
+		return err
+	}
+	if store == nil {
+		return fmt.Errorf("owner call requires a local store")
+	}
+	writes, err := httpapi.OwnerOperationWrites(args[0])
+	if err != nil {
+		return err
+	}
+	if writes {
+		CheckReadonly("owner call")
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		return err
+	}
+	info, err := contextinfo.NewContextProvider(cwd, Version).ContextUseCase().GetContextInfo(rootCtx)
+	if err != nil {
+		return err
+	}
+	journalEnabled := eventsjournal.EnabledFor(info.BeadsDir)
+	roles, err := serveIssueRoles(store, journalEnabled)
+	if err != nil {
+		return err
+	}
+	body, status, err := httpapi.InvokeOwner(rootCtx, httpapi.Config{
+		Reader:               roles.reader,
+		Workspace:            info,
+		SchemaVersion:        JSONSchemaVersion,
+		EventsJournal:        roles.eventsJournal,
+		EventsJournalEnabled: journalEnabled,
+		Claimer:              roles.claimer,
+		BatchCloser:          roles.batchCloser,
+		ReadyClaimer:         roles.readyClaimer,
+		Releaser:             roles.releaser,
+		Lifecycle:            roles.lifecycle,
+		Settings:             roles.settings,
+		Stats:                roles.stats,
+		CycleDetector:        roles.cycles,
+		EdgeReader:           roles.edges,
+		GraphCounter:         roles.edgeCounter,
+		Relations:            roles.relations,
+		Commenter:            roles.commenter,
+		BlockingAnnotator:    roles.blocking,
+		TreeWalker:           roles.tree,
+		ReadyCounter:         roles.readyCounter,
+		Counter:              roles.counter,
+		Querier:              roles.querier,
+		Sweeper:              roles.sweeper,
+		Deleter:              roles.deleter,
+		BatchCreator:         roles.batchCreator,
+		DependencyEditor:     roles.dependencyEditor,
+		MetadataCAS:          roles.metadataCAS,
+		BatchApplier:         roles.batchApplier,
+		Memories:             roles.memories,
+	}, args[0], in)
+	if err != nil {
+		return err
+	}
+	fmt.Println(string(body))
+	if status >= 400 {
+		return SilentExit()
+	}
+	return nil
+}}
+var ownerReadCmd = &cobra.Command{Use: "read", Short: "Read issues and dependency closure at one exact revision", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, args []string) error {
+	var in storageops.OwnerReadRequest
+	if err := ownerDecode(&in); err != nil {
+		return err
+	}
+	source := store
+	for {
+		wrapped, ok := source.(interface{ Unwrap() storage.DoltStorage })
+		if !ok {
+			break
+		}
+		source = wrapped.Unwrap()
+	}
+	db, ok := source.(storage.RawDBAccessor)
+	if !ok {
+		return fmt.Errorf("owner read requires SQL snapshot access")
+	}
+	result, err := storageops.ReadOwner(rootCtx, db.DB(), in)
+	if err != nil {
+		return err
+	}
+	return outputJSON(result)
+}}
+
+func init() {
+	readOnlyCommands["read"] = true
+
+	ownerCmd.AddCommand(ownerSchemaCmd, ownerCallCmd, ownerReadCmd)
+	rootCmd.AddCommand(ownerCmd)
+}
