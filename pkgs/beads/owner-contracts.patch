+func TestOwnerContractTextBatchCloseRollsBackOnBlocker(t *testing.T) {
+	t.Setenv("DOLT_ROOT_PATH", t.TempDir())
+	ctx := t.Context()
+	st, err := embeddeddolt.Open(ctx, filepath.Join(t.TempDir(), ".beads"), "owner", "main")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	if err := st.SetConfig(ctx, "issue_prefix", "owner"); err != nil {
+		t.Fatal(err)
+	}
+	seedBatchTestIssues(t, ctx, st, "owner-a", "owner-b")
+	if err := st.AddDependency(ctx, &types.Dependency{IssueID: "owner-a", DependsOnID: "owner-b", Type: types.DepBlocks}, "operator"); err != nil {
+		t.Fatal(err)
+	}
+	if err := runBatchScriptInTx(t, ctx, st, "update owner-b priority=0\nclose owner-a blocked\n"); err == nil {
+		t.Fatal("closed an issue with an open blocker")
+	}
+	row, err := st.GetIssue(ctx, "owner-b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if row.Priority != 2 {
+		t.Fatalf("earlier batch edit survived refusal: %d", row.Priority)
+	}
+	if err := runBatchScriptInTx(t, ctx, st, "close owner-b done\nclose owner-a done\n"); err != nil {
+		t.Fatal(err)
+	}
+	row, err = st.GetIssue(ctx, "owner-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if row.Status != types.StatusClosed {
+		t.Fatalf("allowed close did not land: %s", row.Status)
+	}
+}
+
+func TestOwnerContractJSONEnvelopeKeepsAuthoredNumbers(t *testing.T) {
+	t.Setenv("BD_JSON_ENVELOPE", "")
+	payload := map[string]any{"revision": "9007199254740993", "metadata": json.RawMessage(`{"revision":9007199254740993,"content_revision":-9007199254740993}`)}
+	encoded, err := json.Marshal(wrapWithSchemaVersion(payload))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result struct {
+		Revision string `json:"revision"`
+		Metadata struct {
+			Revision        int64 `json:"revision"`
+			ContentRevision int64 `json:"content_revision"`
+		} `json:"metadata"`
+	}
+	if err := json.Unmarshal(encoded, &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Revision != "9007199254740993" || result.Metadata.Revision != 9007199254740993 || result.Metadata.ContentRevision != -9007199254740993 {
+		t.Fatalf("envelope changed metadata: %s", encoded)
+	}
+}
+
+func TestOwnerContractEmptyJSONObjectDoesNotPanic(t *testing.T) {
+	t.Setenv("BD_JSON_ENVELOPE", "")
+	for _, value := range []any{map[string]string(nil), (*struct{ ID string })(nil)} {
+		encoded, err := json.Marshal(wrapWithSchemaVersion(value))
+		if err != nil {
+			t.Fatal(err)
+		}
+		var result struct {
+			SchemaVersion int `json:"schema_version"`
+		}
+		if err := json.Unmarshal(encoded, &result); err != nil {
+			t.Fatal(err)
+		}
+		if result.SchemaVersion != JSONSchemaVersion {
+			t.Fatalf("invalid empty object: %s", encoded)
+		}
+	}
+}
