+package issueops
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// ownerProvenance reports evidence edges touching members without changing the
+// dependency closure. Metadata values may name local IDs or external references.
+func (p *ownerReadPlan) provenance(ctx context.Context, db DBTX, items []map[string]any, limit int, membershipComplete bool) ([]map[string]any, map[string]any, error) {
+	members := map[string]bool{}
+	for _, item := range items {
+		members[fmt.Sprint(item["id"])] = true
+	}
+	edges := []map[string]any{}
+	frontier := []map[string]any{}
+	seen := map[string]bool{}
+	appendEdge := func(edge map[string]any) {
+		key := fmt.Sprint(edge["from"]) + "\x00" + fmt.Sprint(edge["to"]) + "\x00" + fmt.Sprint(edge["relation"])
+		if seen[key] {
+			return
+		}
+		seen[key] = true
+		if len(edges) >= limit {
+			if len(frontier) == 0 {
+				frontier = append(frontier, map[string]any{"reason": "edge_bound", "max_edges": limit})
+			}
+			return
+		}
+		edges = append(edges, edge)
+	}
+	if len(members) > 0 {
+		ids := []string{}
+		for id := range members {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		placeholders := []string{}
+		args := []any{}
+		for _, id := range ids {
+			placeholders = append(placeholders, "?")
+			args = append(args, id)
+		}
+		args = append(args, args...)
+		args = append(args, limit+1)
+		rows, err := ownerRows(ctx, db, "SELECT * FROM "+p.table("dependencies")+" WHERE type IN ('discovered-from','split-from','supersedes','residual-of') AND (issue_id IN ("+strings.Join(placeholders, ",")+") OR depends_on_issue_id IN ("+strings.Join(placeholders, ",")+")) ORDER BY issue_id,depends_on_issue_id,type LIMIT ?", args...)
+		if err != nil {
+			return nil, nil, err
+		}
+		if len(rows) > limit {
+			frontier = append(frontier, map[string]any{"reason": "edge_bound", "max_edges": limit})
+			rows = rows[:limit]
+		}
+		for _, row := range rows {
+			kind := fmt.Sprint(row["type"])
+			target := ownerEdgeTarget(row)
+			targetKind := "bead"
+			if row["depends_on_external"] != nil && row["depends_on_external"] != "" {
+				targetKind = "external"
+			}
+			if row["depends_on_wisp_id"] != nil && row["depends_on_wisp_id"] != "" {
+				targetKind = "wisp"
+			}
+			appendEdge(map[string]any{"from": row["issue_id"], "to": target, "relation": strings.ReplaceAll(kind, "-", "_"), "native_relation": kind, "target_kind": targetKind})
+		}
+		metadata, err := ownerRows(ctx, db, "SELECT id,metadata FROM "+p.table("issues")+" WHERE JSON_EXTRACT(metadata,'$.discovered_from') IS NOT NULL OR JSON_EXTRACT(metadata,'$.split_from') IS NOT NULL OR JSON_EXTRACT(metadata,'$.supersedes') IS NOT NULL OR JSON_EXTRACT(metadata,'$.residual_of') IS NOT NULL ORDER BY id LIMIT ?", limit+1)
+		if err != nil {
+			return nil, nil, err
+		}
+		if len(metadata) > limit {
+			frontier = append(frontier, map[string]any{"reason": "metadata_candidate_bound", "max_candidates": limit})
+			metadata = metadata[:limit]
+		}
+		for _, row := range metadata {
+			source := fmt.Sprint(row["id"])
+			object, ok := row["metadata"].(map[string]any)
+			if !ok {
+				frontier = append(frontier, map[string]any{"reason": "unsupported_metadata_value", "from": source})
+				continue
+			}
+			for _, key := range []string{"discovered_from", "split_from", "supersedes", "residual_of"} {
+				value, present := object[key]
+				if !present {
+					continue
+				}
+				target, ok := value.(string)
+				if !ok || target == "" {
+					frontier = append(frontier, map[string]any{"reason": "unsupported_metadata_value", "from": source, "key": key})
+					continue
+				}
+				if !members[source] && !members[target] {
+					continue
+				}
+				kind := "bead"
+				if strings.Contains(target, "://") {
+					kind = "external"
+				}
+				appendEdge(map[string]any{"from": source, "to": target, "relation": key, "native_relation": nil, "metadata_key": key, "source": "issue_metadata", "target_kind": kind})
+			}
+		}
+	}
+	if !membershipComplete {
+		frontier = append(frontier, map[string]any{"reason": "membership_incomplete"})
+	}
+	state := "complete"
+	if len(frontier) > 0 {
+		state = "partial"
+	}
+	return edges, map[string]any{"state": state, "complete": len(frontier) == 0, "scope": "incoming_and_outgoing_edges_touching_members", "revision": p.revision, "returned": len(edges), "frontier": frontier}, nil
+}
