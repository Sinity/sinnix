+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/types"
+	"github.com/steveyegge/beads/issueops"
+)
+
+func TestOwnerContractBatchUsesTypedRole(t *testing.T) {
+	applier := &roleBatchApplier{result: issueops.ApplyBatchResult{Items: []issueops.ItemResult{{Kind: issueops.ItemCreate, IssueID: "bd-one", Changed: true}}, Keys: map[string]string{"root": "bd-one"}}}
+	body, status, err := InvokeOwner(context.Background(), rolesConfig(Config{BatchApplier: applier}), "applyBatch", OwnerCall{Body: json.RawMessage(`{"actor":"operator","items":[{"kind":"create","create":{"key":"root","title":"One"}},{"kind":"update","update":{"target":{"key":"root"},"expected_version":42,"patch":{"notes":"updated"}}}]}`)})
+	if err != nil || status != http.StatusOK {
+		t.Fatalf("status=%d err=%v body=%s", status, err, body)
+	}
+	requests := applier.requests()
+	if len(requests) != 1 {
+		t.Fatalf("requests=%d", len(requests))
+	}
+	if requests[0].Items[1].Update.Target.Key != "root" || *requests[0].Items[1].Update.ExpectedVersion != 42 {
+		t.Fatal("binding or version guard lost")
+	}
+	var result map[string]any
+	if err := json.Unmarshal(body, &result); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestOwnerContractUpdateGuardAndValidation(t *testing.T) {
+	lifecycle := &roleLifecycle{updateResult: issueops.UpdateResult{Issue: &types.Issue{ID: "bd-one"}}}
+	cfg := rolesConfig(Config{Lifecycle: lifecycle})
+	body, status, err := InvokeOwner(context.Background(), cfg, "updateIssue", OwnerCall{Path: map[string]string{"id": "bd-one"}, Body: json.RawMessage(`{"actor":"operator","expected_version":42,"patch":{"description":"new body"}}`)})
+	if err != nil || status != http.StatusOK {
+		t.Fatalf("status=%d err=%v body=%s", status, err, body)
+	}
+	requests := lifecycle.updateRequests()
+	if len(requests) != 1 || *requests[0].ExpectedVersion != 42 {
+		t.Fatalf("guard not forwarded: %+v", requests)
+	}
+	_, status, err = InvokeOwner(context.Background(), cfg, "updateIssue", OwnerCall{Path: map[string]string{"id": "bd-one"}, Body: json.RawMessage(`{"actor":"operator","patch":{"unknown":"x"}}`)})
+	if err != nil || status != http.StatusBadRequest || len(lifecycle.updateRequests()) != 1 {
+		t.Fatalf("invalid body reached role: status=%d err=%v", status, err)
+	}
+}
+
+func TestOwnerContractSchemaPublishesMutationInputs(t *testing.T) {
+	document, err := OwnerSchema()
+	if err != nil {
+		t.Fatal(err)
+	}
+	paths := document["paths"].(map[string]any)
+	for _, path := range []string{"/v0/beads/issues:batchApply", "/v0/beads/issues/{id}"} {
+		if paths[path] == nil {
+			t.Fatalf("missing contract %s", path)
+		}
+	}
+	if _, err := json.Marshal(document); err != nil {
+		t.Fatal(err)
+	}
+}
