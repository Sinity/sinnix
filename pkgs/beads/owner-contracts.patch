+	mock.ExpectQuery(`SELECT DOLT_HASHOF\(\?\)`).WithArgs("HEAD").WillReturnRows(sqlmock.NewRows([]string{"hash"}).AddRow(hash))
+	mock.ExpectQuery(`SELECT COUNT\(\*\) FROM issues AS OF '` + hash + `'`).WillReturnRows(sqlmock.NewRows([]string{"count"}).AddRow(1))
