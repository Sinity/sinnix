+func TestOwnerContractTextBatchCloseRollsBackOnBlocker(t *testing.T) {
+	t.Setenv("DOLT_ROOT_PATH", t.TempDir())
+	ctx := t.Context()
+	st, err := embeddeddolt.Open(ctx, filepath.Join(t.TempDir(), ".beads"), "owner", "main")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	if err := st.SetConfig(ctx, "issue_prefix", "owner"); err != nil {
+		t.Fatal(err)
+	}
+	seedBatchTestIssues(t, ctx, st, "owner-a", "owner-b")
+	if err := st.AddDependency(ctx, &types.Dependency{IssueID: "owner-a", DependsOnID: "owner-b", Type: types.DepBlocks}, "operator"); err != nil {
+		t.Fatal(err)
+	}
+	if err := runBatchScriptInTx(t, ctx, st, "update owner-b priority=0\nclose owner-a blocked\n"); err == nil {
+		t.Fatal("closed an issue with an open blocker")
+	}
+	row, err := st.GetIssue(ctx, "owner-b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if row.Priority != 2 {
+		t.Fatalf("earlier batch edit survived refusal: %d", row.Priority)
+	}
+	if err := runBatchScriptInTx(t, ctx, st, "close owner-b done\nclose owner-a done\n"); err != nil {
+		t.Fatal(err)
+	}
+	row, err = st.GetIssue(ctx, "owner-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if row.Status != types.StatusClosed {
+		t.Fatalf("allowed close did not land: %s", row.Status)
+	}
+}
