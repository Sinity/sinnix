+package beads
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/git"
+)
+
+func TestOwnerContractExplicitStandaloneContext(t *testing.T) {
+	root := t.TempDir()
+	t.Chdir(root)
+	dir := filepath.Join(root, ".beads")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "beads.db"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BEADS_DIR", dir)
+	ResetCaches()
+	git.ResetCaches()
+	t.Cleanup(func() { ResetCaches(); git.ResetCaches() })
+	info, err := buildRepoContext()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.BeadsDir != dir || info.RepoRoot != root || info.CWDRepoRoot != "" || info.IsWorktree {
+		t.Fatalf("unexpected standalone identity: %+v", info)
+	}
+	t.Setenv("BEADS_DIR", "")
+	ResetCaches()
+	git.ResetCaches()
+	if _, err := buildRepoContext(); err == nil {
+		t.Fatal("implicit Gitless context unexpectedly accepted")
+	}
+}
