#!/usr/bin/env bash

# nix-direnv registers a GC root for every flake input by calling
# `nix build --out-link` once per input. This flake has 61 inputs, and that
# loop is almost entirely CLI process startup: 4.96s of the ~5-6.5s a
# cache-miss `cd` into this repo costs, against 0.07s for a single batched
# `nix-store --add-root --indirect --realise` covering the same 61 paths.
#
# So queue the input roots while `use flake` runs and register them in one
# call afterwards. Only roots destined for `flake-inputs/` are deferred: the
# profile root points at a temporary profile that use_flake deletes before it
# returns, so that one has to be created inline.
#
# The queue is a set, not a list: upstream names each link after its store
# path so repeated inputs collapse, and a batched call has to dedupe itself
# or it leaves duplicate links and duplicate entries in gcroots/auto.
declare -A _sinnix_flake_input_roots=()

_nix_add_gcroot() {
  local storepath=$1 symlink=$2
  case "$symlink" in
  */flake-inputs/*) _sinnix_flake_input_roots["$storepath"]=1 ;;
  *) _nix build --out-link "$symlink" "$storepath" ;;
  esac
}

use flake

if [ "${#_sinnix_flake_input_roots[@]}" -gt 0 ]; then
  _sinnix_nix_store="$(dirname "${_nix_direnv_nix:-$(command -v nix)}")/nix-store"
  [ -x "$_sinnix_nix_store" ] || _sinnix_nix_store="$(command -v nix-store)"
  # Falling back to the per-path loop on failure keeps the roots real: an
  # unregistered input is one `nh clean` away from being re-fetched.
  if ! "$_sinnix_nix_store" --add-root "$(direnv_layout_dir)/flake-inputs/input" \
    --indirect --realise "${!_sinnix_flake_input_roots[@]}" >/dev/null; then
    for _sinnix_root in "${!_sinnix_flake_input_roots[@]}"; do
      _nix build --out-link "$(direnv_layout_dir)/flake-inputs/${_sinnix_root##*/}" "$_sinnix_root"
    done
  fi
fi
