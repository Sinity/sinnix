+/// Reopening admission never sends a start signal to an operator-paused task.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_owned_admission_keeps_paused_task() -> Result<()> {
+    let daemon = daemon().await?;
+    let shared = &daemon.settings.shared;
+    add_group_with_slots(shared, "owned", 1).await?;
+    assert_success(add_task_to_group(shared, "sleep 60", "owned").await?);
+    wait_for_task_condition(shared, 0, Task::is_running).await?;
+    assert_success(send_request(shared, PauseRequest { tasks: TaskSelection::TaskIds(vec![0]), wait: false }).await?);
+    wait_for_task_condition(shared, 0, Task::is_paused).await?;
+    assert_success(send_request(shared, GroupRequest::PauseOwned { name: "owned".into(), token: "task-proof".into() }).await?);
+    assert_success(send_request(shared, GroupRequest::ResumeOwned { name: "owned".into(), token: "task-proof".into() }).await?);
+    assert!(get_state(shared).await?.tasks[&0].is_paused());
+    Ok(())
+}
