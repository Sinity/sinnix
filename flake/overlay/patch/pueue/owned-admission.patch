+/// Same-state operator intent invalidates automation, including pause-all.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_owned_admission_reassertion() -> Result<()> {
+    let daemon = daemon().await?;
+    let shared = &daemon.settings.shared;
+    add_group_with_slots(shared, "owned", 1).await?;
+    let claim = |token: &str| GroupRequest::PauseOwned { name: "owned".into(), token: token.into() };
+    let release = |token: &str| GroupRequest::ResumeOwned { name: "owned".into(), token: token.into() };
+    assert_success(send_request(shared, claim("first")).await?);
+    assert_failure(send_request(shared, claim("second")).await?);
+    assert_failure(send_request(shared, release("wrong")).await?);
+    assert_eq!(get_state(shared).await?.groups["owned"].pause_owner.as_deref(), Some("first"));
+    assert_success(send_request(shared, PauseRequest { tasks: TaskSelection::Group("owned".into()), wait: true }).await?);
+    assert_failure(send_request(shared, release("first")).await?);
+    assert_eq!(get_state(shared).await?.groups["owned"].status, pueue_lib::GroupStatus::Paused);
+    assert!(get_state(shared).await?.groups["owned"].pause_owner.is_none());
+    assert_success(send_request(shared, StartRequest { tasks: TaskSelection::Group("owned".into()) }).await?);
+    assert_success(send_request(shared, claim("second")).await?);
+    assert_failure(send_request(shared, release("first")).await?);
+    assert_success(send_request(shared, release("second")).await?);
+    assert_eq!(get_state(shared).await?.groups["owned"].status, pueue_lib::GroupStatus::Running);
+    assert_success(send_request(shared, claim("third")).await?);
+    assert_success(send_request(shared, PauseRequest { tasks: TaskSelection::All, wait: true }).await?);
+    assert_failure(send_request(shared, release("third")).await?);
+    Ok(())
+}
