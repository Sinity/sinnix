+/// A clean restart preserves a durable admission claim when no recovery hold intervenes.
+#[tokio::test]
+async fn test_owned_admission_survives_clean_restart() -> Result<()> {
+    let (settings, _tempdir) = daemon_base_setup()?;
+    let shared = &settings.shared;
+    let mut child = standalone_daemon(shared).await?;
+    assert_success(send_request(shared, pueue_lib::message::GroupRequest::PauseOwned {
+        name: PUEUE_DEFAULT_GROUP.into(), token: "restart-proof".into(),
+    }).await?);
+    assert_success(shutdown_daemon(shared).await?);
+    wait_for_shutdown(&mut child).await?;
+    let mut child = standalone_daemon(shared).await?;
+    assert_eq!(get_state(shared).await?.groups[PUEUE_DEFAULT_GROUP].pause_owner.as_deref(), Some("restart-proof"));
+    assert_success(send_request(shared, pueue_lib::message::GroupRequest::ResumeOwned {
+        name: PUEUE_DEFAULT_GROUP.into(), token: "restart-proof".into(),
+    }).await?);
+    assert_success(shutdown_daemon(shared).await?);
+    wait_for_shutdown(&mut child).await?;
+    Ok(())
+}
