+/// Either mutex ordering leaves the concurrent operator pause effective.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_owned_admission_operator_race() -> Result<()> {
+    let daemon = daemon().await?;
+    let shared = &daemon.settings.shared;
+    add_group_with_slots(shared, "owned", 1).await?;
+    assert_success(send_request(shared, GroupRequest::PauseOwned { name: "owned".into(), token: "race".into() }).await?);
+    let (operator, _release) = tokio::join!(
+        send_request(shared, PauseRequest { tasks: TaskSelection::Group("owned".into()), wait: true }),
+        send_request(shared, GroupRequest::ResumeOwned { name: "owned".into(), token: "race".into() }),
+    );
+    assert_success(operator?);
+    let state = get_state(shared).await?;
+    assert_eq!(state.groups["owned"].status, pueue_lib::GroupStatus::Paused);
+    assert!(state.groups["owned"].pause_owner.is_none());
+    Ok(())
+}
