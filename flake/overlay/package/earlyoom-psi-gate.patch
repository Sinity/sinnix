+/* Read the "full avg10" value from /proc/pressure/memory.
+ * Returns -1 when pressure data is unavailable (kernel without PSI,
+ * or unreadable file). EARLYOOM_PSI_PATH overrides the path (test hook).
+ */
+static double parse_psi_full_avg10()
+{
+    static FILE* fd;
+    static int warned = 0;
+    char buf[512] = { 0 };
+
+    if (fd == NULL) {
+        char pathbuf[PATH_LEN] = { 0 };
+        const char* path = getenv("EARLYOOM_PSI_PATH");
+        if (path == NULL) {
+            snprintf(pathbuf, sizeof(pathbuf), "%s/pressure/memory", procdir_path);
+            path = pathbuf;
+        }
+        fd = fopen(path, "r");
+        if (fd == NULL) {
+            if (!warned) {
+                warn("could not open %s: %s - memory pressure data unavailable\n",
+                    path, strerror(errno));
+                warned = 1;
+            }
+            return -1;
+        }
+    }
+    rewind(fd);
+
+    size_t len = fread(buf, 1, sizeof(buf) - 1, fd);
+    if (len == 0) {
+        return -1;
+    }
+    char* hit = strstr(buf, "full avg10=");
+    if (hit == NULL) {
+        return -1;
+    }
+    return strtod(hit + strlen("full avg10="), NULL);
+}
+
 /* Parse /proc/meminfo.
  * This function either returns valid data or kills the process
  * with a fatal error.
@@ -119,6 +159,8 @@
         m.SwapFreePercent = 0;
     }
 
+    m.MemPressureFullAvg10 = parse_psi_full_avg10();
+
     return m;
 }
 
