+// Resolve the service that will own an Accept=no listener in the new generation.
+// Accept=yes workers receive accepted connections, not the listening descriptor.
+fn socket_service_name(unit: &str, info: &UnitInfo) -> Option<String> {
+    let stem = unit.strip_suffix(".socket")?;
+    if parse_systemd_bool(Some(info), "Socket", "Accept", false) {
+        return None;
+    }
+    Some(
+        info.get("Socket")
+            .and_then(|section| section.get("Service"))
+            .and_then(|values| values.last())
+            .filter(|value| !value.is_empty())
+            .cloned()
+            .unwrap_or_else(|| format!("{stem}.service")),
+    )
+}
