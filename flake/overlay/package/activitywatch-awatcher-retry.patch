+    #[cfg(test)]
+    mod tests {
+        use super::ReportClient;
+        use std::sync::{Arc, Mutex};
+        use std::time::{Duration, Instant};
+
+        #[tokio::test]
+        async fn transition_retry_reuses_timestamp() {
+            let seen = Arc::new(Mutex::new(Vec::new()));
+            let seen_by_request = Arc::clone(&seen);
+            let timestamp = "2026-09-01T10:00:00Z";
+            let result = ReportClient::run_with_retries(move || {
+                let seen = Arc::clone(&seen_by_request);
+                async move {
+                    let mut seen = seen.lock().unwrap();
+                    seen.push(timestamp);
+                    if seen.len() == 1 {
+                        Err(std::io::Error::new(std::io::ErrorKind::ConnectionReset, "rejected"))
+                    } else {
+                        Ok::<_, std::io::Error>(())
+                    }
+                }
+            }).await;
+            assert!(result.is_ok());
+            assert_eq!(*seen.lock().unwrap(), vec![timestamp, timestamp]);
+        }
+
+        #[tokio::test]
+        async fn failure_is_bounded_to_four_attempts() {
+            let attempts = Arc::new(Mutex::new(0));
+            let attempts_by_request = Arc::clone(&attempts);
+            let started = Instant::now();
+            let result = ReportClient::run_with_retries(move || {
+                let attempts = Arc::clone(&attempts_by_request);
+                async move {
+                    *attempts.lock().unwrap() += 1;
+                    Err::<(), _>(std::io::Error::new(std::io::ErrorKind::TimedOut, "timeout"))
+                }
+            }).await;
+            assert!(result.is_err());
+            assert_eq!(*attempts.lock().unwrap(), 4);
+            assert!(started.elapsed() < Duration::from_secs(10));
+        }
+
