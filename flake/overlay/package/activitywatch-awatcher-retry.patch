+#[cfg(test)]
+mod tests {
+    use super::{ReportClient, RETRY_DELAYS_SECONDS};
+    use std::sync::{Arc, Mutex};
+
+    fn transport_error(message: &str) -> std::io::Error {
+        std::io::Error::new(std::io::ErrorKind::ConnectionReset, message.to_string())
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn retry_reuses_the_same_event_value() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let seen_by_request = Arc::clone(&seen);
+        let timestamp = "2026-09-01T10:00:00Z";
+        let result = ReportClient::run_with_retries(move || {
+            let seen = Arc::clone(&seen_by_request);
+            async move {
+                let mut seen = seen.lock().unwrap();
+                seen.push(timestamp);
+                if seen.len() == 1 {
+                    Err(transport_error("response lost"))
+                } else {
+                    Ok::<_, std::io::Error>(())
+                }
+            }
+        })
+        .await;
+        assert!(result.is_ok());
+        assert_eq!(*seen.lock().unwrap(), vec![timestamp, timestamp]);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn failure_is_bounded_to_one_attempt_past_the_delays() {
+        let attempts = Arc::new(Mutex::new(0_usize));
+        let attempts_by_request = Arc::clone(&attempts);
+        let result = ReportClient::run_with_retries(move || {
+            let attempts = Arc::clone(&attempts_by_request);
+            async move {
+                *attempts.lock().unwrap() += 1;
+                Err::<(), _>(transport_error("timeout"))
+            }
+        })
+        .await;
+        assert!(result.is_err());
+        assert_eq!(
+            *attempts.lock().unwrap(),
+            RETRY_DELAYS_SECONDS.len() + 1
+        );
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn a_non_connection_error_is_retried_too() {
+        let attempts = Arc::new(Mutex::new(0_usize));
+        let attempts_by_request = Arc::clone(&attempts);
+        let result = ReportClient::run_with_retries(move || {
+            let attempts = Arc::clone(&attempts_by_request);
+            async move {
+                let mut attempts = attempts.lock().unwrap();
+                *attempts += 1;
+                if *attempts == 1 {
+                    Err(std::io::Error::new(
+                        std::io::ErrorKind::BrokenPipe,
+                        "operation timed out",
+                    ))
+                } else {
+                    Ok::<_, std::io::Error>(())
+                }
+            }
+        })
+        .await;
+        assert!(result.is_ok());
+        assert_eq!(*attempts.lock().unwrap(), 2);
+    }
+}
