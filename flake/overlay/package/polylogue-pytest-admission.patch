+def _admission_not_ready(sizing: Mapping[str, Any] | None) -> bool:
+    """True when sizing forbids launching even one worker."""
+    if sizing is None:
+        return False
+    if sizing.get("admission") == RESOURCE_NOT_READY:
+        return True
+    workers = sizing.get("workers")
+    return isinstance(workers, int) and workers < 1
