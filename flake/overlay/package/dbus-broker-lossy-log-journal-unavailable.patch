From b4849638ecc5b5882b108ec9030e4ebd2cdd5dd9 Mon Sep 17 00:00:00 2001
From: Sinity <ezo.dev@gmail.com>
Date: Sat, 11 Jul 2026 16:06:20 +0200
Subject: [PATCH 1/2] util/log: do not treat an unavailable journal as fatal in
 lossy mode

The log layer has an explicit lossy mode, set unconditionally by both
the broker and the launcher, whose contract is that diagnostics may
be dropped when they cannot be sent. log_journal_send() only honors
that for EAGAIN: every other send(2) failure - apart from the
EMSGSIZE truncation path - propagates as a hard error, and callers
such as peer_queue_unicast() fold log errors into their own return
value, so a single failed diagnostic write unwinds through
driver_dispatch() into broker_run() and terminates the broker.

A connected AF_UNIX/SOCK_DGRAM journal socket can outlive its peer: a
full journald restart (socket units included - which stopping
journald for journal-file maintenance requires, since socket
activation otherwise resurrects it) destroys and recreates the
listening socket, permanently orphaning every already-connected
client. The orphaned socket fails the next send with ECONNREFUSED
and every later one with ENOTCONN, while the journal itself is long
back and healthy.

Observed twice in production (dbus-broker 37, systemd 260.2): a
journald restart orphaned the broker's log socket, and the next lossy
diagnostic - a policy send-denial emitted during session teardown at
shutdown, 25 hours later in one case and 4 days in the other -
killed the broker while the journal was alive (it recorded the
broker's own error trace, via the stderr stream, at the same
instant). PID 1 then serialized the rest of the shutdown behind 90 s
bus-reconnect timeouts, ~15 minutes in total.

In lossy mode, treat journal unavailability like the existing EAGAIN
case and drop the message. ECONNREFUSED and ENOTCONN are the errnos
observed in production; ECONNRESET, EPIPE, ENOBUFS - and, as a
conservative superset for unconnected or unusual log fds, ENOENT and
ESHUTDOWN - are included as the same "cannot deliver right now"
class. The dropped-messages marker in out_drop becomes best-effort
under the same reasoning (with MSG_DONTWAIT, so it cannot block
either): failing to send the "messages got dropped" marker must not
resurrect the fatal path it exists to soften. Non-lossy contexts
keep surfacing all errors unchanged.

Add a unit test covering the dead-peer case (ECONNREFUSED, then
ENOTCONN on subsequent sends) and the pre-existing full-queue EAGAIN
case.
---
 src/meson.build     |  3 ++
 src/util/log.c      | 28 +++++++++++++++--
 src/util/test-log.c | 76 +++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 105 insertions(+), 2 deletions(-)
 create mode 100644 src/util/test-log.c

diff --git a/src/meson.build b/src/meson.build
index 2d60346..995085d 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -318,6 +318,9 @@ test('Utility File-Desciptor Lists', test_fdlist, suite: 'unit')
 test_fs = executable('test-fs', sources: ['util/test-fs.c'], kwargs: test_kwargs)
 test('File System Helpers', test_fs, suite: 'unit')
 
+test_log = executable('test-log', sources: ['util/test-log.c'], kwargs: test_kwargs)
+test('Log Context', test_log, suite: 'unit')
+
 test_match = executable('test-match', sources: ['bus/test-match.c'], kwargs: test_kwargs)
 test('D-Bus Match Handling', test_match, suite: 'unit')
 
diff --git a/src/util/log.c b/src/util/log.c
index 6a609c4..6e499ee 100644
--- a/src/util/log.c
+++ b/src/util/log.c
@@ -409,6 +409,23 @@ static int log_journal_send(Log *log) {
                 return LOG_E_TRUNCATED;
         } else if (errno == EAGAIN) {
                 goto out_drop;
+        } else if (log->lossy && (errno == ECONNREFUSED ||
+                                  errno == ECONNRESET ||
+                                  errno == ENOTCONN ||
+                                  errno == ENOENT ||
+                                  errno == EPIPE ||
+                                  errno == ENOBUFS ||
+                                  errno == ESHUTDOWN)) {
+                /*
+                 * The journal peer is gone or refuses us: journald may be
+                 * restarting, or a past restart recreated its sockets and
+                 * left this long-connected socket permanently attached to
+                 * the dead peer. In lossy mode we are explicitly allowed
+                 * to drop diagnostics, and losing a log message must never
+                 * escalate into a fatal error that takes the message bus
+                 * down with it.
+                 */
+                goto out_drop;
         } else if (errno != EMSGSIZE) {
                 return error_origin(-errno);
         }
@@ -465,8 +482,15 @@ out_drop:
                 l = send(log->log_fd,
                          LOG_WARNING_DROPPED,
                          strlen(LOG_WARNING_DROPPED),
-                         MSG_NOSIGNAL);
-                if (l < 0)
+                         MSG_NOSIGNAL | (log->lossy ? MSG_DONTWAIT : 0));
+                /*
+                 * The dropped-messages marker is best-effort in lossy mode:
+                 * if the journal cannot take it either, dropping it is
+                 * exactly what lossy mode promises. Failing here would
+                 * reintroduce the fatal-log-write path this label exists to
+                 * avoid. In non-lossy mode, keep surfacing the error.
+                 */
+                if (l < 0 && !log->lossy)
                         return error_origin(-errno);
         }
 
diff --git a/src/util/test-log.c b/src/util/test-log.c
new file mode 100644
index 0000000..fe0d46a
--- /dev/null
+++ b/src/util/test-log.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* SPDX-FileCopyrightText: D-Bus Broker Developers */
+
+/*
+ * Test log context helpers
+ */
+
+#undef NDEBUG
+#include <c-stdaux.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include "util/log.h"
+
+/*
+ * In lossy mode, a journal that is gone (its socket closed, e.g. a journald
+ * restart recreated its sockets and orphaned this long-connected client)
+ * must lead to dropped messages, not to a fatal error: log emission
+ * failures escalating out of the log layer took the whole broker down in
+ * production.
+ */
+static void test_lossy_journal_gone(void) {
+        _c_cleanup_(log_deinit) Log log = LOG_NULL;
+        int fds[2], r;
+
+        r = socketpair(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0, fds);
+        c_assert(!r);
+
+        log_init_journal_consume(&log, fds[0]);
+        log_set_lossy(&log, true);
+
+        /* Peer closed: send(2) on the connected datagram socket now fails
+         * with ECONNREFUSED. */
+        close(fds[1]);
+
+        log_append_here(&log, LOG_WARNING, 0, NULL);
+        r = log_commitf(&log, "diagnostic while journal is gone\n");
+        c_assert(!r);
+
+        /* Subsequent messages keep being dropped silently. */
+        log_append_here(&log, LOG_WARNING, 0, NULL);
+        r = log_commitf(&log, "another diagnostic\n");
+        c_assert(!r);
+}
+
+/*
+ * In lossy mode, a full journal socket queue (EAGAIN) drops messages; this
+ * covered the pre-existing lossy path and must keep working alongside the
+ * unavailable-journal handling.
+ */
+static void test_lossy_journal_full(void) {
+        _c_cleanup_(log_deinit) Log log = LOG_NULL;
+        int fds[2], r;
+
+        r = socketpair(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0, fds);
+        c_assert(!r);
+
+        log_init_journal_consume(&log, fds[0]);
+        log_set_lossy(&log, true);
+
+        /* Nobody reads fds[1]: fill the queue until EAGAIN, all calls must
+         * still report success. */
+        for (unsigned int i = 0; i < 1024; ++i) {
+                log_append_here(&log, LOG_WARNING, 0, NULL);
+                r = log_commitf(&log, "flood diagnostic %u\n", i);
+                c_assert(!r);
+        }
+
+        close(fds[1]);
+}
+
+int main(int argc, char **argv) {
+        test_lossy_journal_gone();
+        test_lossy_journal_full();
+        return 0;
+}
