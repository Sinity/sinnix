{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "evidence",
    "refutation_attempted",
    "unsupported"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unsupported"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refutation_attempted": {
      "type": "boolean"
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
