#!/usr/bin/env bash
# Worker-side toolbelt for an agent queued by `agentctl lane start`.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  lane task                       print the dispatch prompt
  lane verify                     run the project's quick verification as a job and wait
  lane publish                    push, open the PR under the bead's subject, arm auto-merge
  lane done [--incomplete] <report-file>
                                  push the branch and emit the report as the final message
EOF
}

die() {
  printf 'lane: %s\n' "$*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a Git checkout"
}

project_file() {
  local root
  root=$(repo_root)
  [[ -f "$root/.agentctl/project.toml" ]] || die "missing $root/.agentctl/project.toml"
  printf '%s\n' "$root/.agentctl/project.toml"
}

project_id() {
  if [[ -n ${SINNIXD_PROJECT_ID:-} ]]; then
    printf '%s\n' "$SINNIXD_PROJECT_ID"
    return
  fi
  awk -F'"' '/^\[project\]/ { in_project = 1; next } /^\[/ { in_project = 0 } in_project && /^[[:space:]]*id[[:space:]]*=/ { print $2; exit }' "$(project_file)"
}

lane_task() {
  local prompt
  prompt=${SINNIXD_JOB_PROMPT_FILE:-$(repo_root)/.lane/prompt.md}
  [[ -r $prompt ]] || die "dispatch prompt is unavailable: $prompt"
  cat -- "$prompt"
}

operation_has_exec() {
  local file=$1 operation=$2
  awk -v target="[operations.$operation]" '
    $0 == target { in_operation = 1; next }
    /^\[/ { in_operation = 0 }
    in_operation && $0 ~ /^[[:space:]]*exec[[:space:]]*=/ { found = 1; exit }
    END { exit(found ? 0 : 1) }
  ' "$file"
}

select_verification_operation() {
  local file=$1 operation
  for operation in verify_quick verify_focused focused check; do
    if operation_has_exec "$file" "$operation"; then
      printf '%s\n' "$operation"
      return 0
    fi
  done
  return 1
}

lane_verify() {
  local file operation output
  file=$(project_file)
  if ! operation=$(select_verification_operation "$file"); then
    printf 'lane verify: no quick verification operation declared in %s\n' "$file"
    return 0
  fi
  command -v agentctl >/dev/null 2>&1 || die "agentctl is unavailable for managed verification"
  if ! output=$(agentctl job start "$(project_id)" "$operation" --workspace "$(repo_root)" --wait --timeout-seconds "${SINNIXD_TIMEOUT_SECONDS:-3600}"); then
    printf '%s\n' "$output" >&2
    die "managed verification did not succeed"
  fi
  printf '%s\n' "$output"
}

lane_publish() {
  command -v agentctl >/dev/null 2>&1 || die "agentctl is unavailable for publication"
  agentctl lane publish "$(repo_root)"
}

git_offenders() {
  git status --porcelain=v1 --untracked-files=all | grep -v ' \.lane/' || true
}

current_branch() {
  git symbolic-ref --quiet --short HEAD || die "cannot push a detached HEAD"
}

push_current_branch() {
  local branch remote
  branch=$(current_branch)
  if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
    git push >&2
    return
  fi
  remote=$(git config "branch.$branch.remote" 2>/dev/null || true)
  [[ -n $remote ]] || remote=origin
  git push --set-upstream "$remote" "$branch" >&2
}

lane_done() {
  local incomplete=0 report dirty
  if [[ ${1:-} == --incomplete ]]; then
    incomplete=1
    shift
  fi
  [[ $# -eq 1 ]] || {
    usage
    exit 2
  }
  report=$1
  [[ -f $report && -r $report ]] || die "report is not a readable file: $report"
  dirty=$(git_offenders)
  if [[ $incomplete -eq 0 && -n $dirty ]]; then
    printf 'lane: refusing complete handoff because the Git tree is dirty-uncommitted. Offenders:\n%s\n' "$dirty" >&2
    exit 1
  fi
  push_current_branch
  if [[ $incomplete -eq 1 ]]; then
    printf 'INCOMPLETE HANDOFF\nOnly committed WIP was pushed; uncommitted work remains in this workspace.\n\n'
  fi
  # The backend adapter stores stdout as the last message: the report must be
  # the final stdout of this command.
  cat -- "$report"
}

main() {
  case ${1:-} in
    task)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      lane_task
      ;;
    verify)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      lane_verify
      ;;
    publish)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      lane_publish
      ;;
    done)
      shift
      lane_done "$@"
      ;;
    -h | --help)
      usage >&1
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
