#!/usr/bin/env bash
# Worker-side toolbelt for a batch worker queued by `agentctl batch start`.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  lane task                       print the dispatch packet
  lane verify                     run the descriptor's focused verification as a job and wait
  lane done <result.json>         validate the result document and print it as the final message
EOF
}

die() {
  printf 'lane: %s\n' "$*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a Git checkout"
}

project_file() {
  local root
  root=$(repo_root)
  [[ -f "$root/.agentctl/project.toml" ]] || die "missing $root/.agentctl/project.toml"
  printf '%s\n' "$root/.agentctl/project.toml"
}

project_id() {
  if [[ -n ${AGENTCTL_PROJECT_ID:-} ]]; then
    printf '%s\n' "$AGENTCTL_PROJECT_ID"
    return
  fi
  awk -F'"' '/^\[project\]/ { in_project = 1; next } /^\[/ { in_project = 0 } in_project && /^[[:space:]]*id[[:space:]]*=/ { print $2; exit }' "$(project_file)"
}

lane_task() {
  local prompt
  prompt=${AGENTCTL_JOB_PROMPT_FILE:-$(repo_root)/.agentctl/prompt.md}
  [[ -r $prompt ]] || die "dispatch packet is unavailable: $prompt"
  cat -- "$prompt"
}

focused_operation() {
  # `[workspace].verify.focused` in the descriptor: an inline table on the
  # `verify` key or a `[workspace.verify]` table.
  awk '
    /^\[/ { in_workspace = ($0 ~ /^\[workspace(\.verify)?\]/) }
    in_workspace && match($0, /focused[[:space:]]*=[[:space:]]*"[^"]+"/) {
      value = substr($0, RSTART, RLENGTH)
      sub(/^[^"]*"/, "", value)
      sub(/"$/, "", value)
      print value
      exit
    }
  ' "$1"
}

lane_verify() {
  local operation output
  command -v agentctl >/dev/null 2>&1 || die "agentctl is unavailable for managed verification"
  operation=$(focused_operation "$(project_file)")
  if [[ -z $operation ]]; then
    printf 'lane verify: no focused verification declared in %s\n' "$(project_file)"
    return 0
  fi
  if ! output=$(agentctl job start "$(project_id)" "$operation" --workspace "$(repo_root)" --wait --timeout-seconds "${AGENTCTL_TIMEOUT_SECONDS:-3600}"); then
    printf '%s\n' "$output" >&2
    die "managed verification did not succeed"
  fi
  printf '%s\n' "$output"
}

git_offenders() {
  # Untracked files under .agentctl/ are agentctl's own (prompt, schema, result).
  git status --porcelain=v1 --untracked-files=all | grep -v '^?? \.agentctl/' || true
}

validate_result() {
  # The worker schema `agentctl batch start` writes next to the packet, checked
  # with a closed-object validator covering the schema's own vocabulary.
  local result=$1 schema
  schema=$(repo_root)/.agentctl/worker.schema.json
  [[ -r $schema ]] || die "worker schema is unavailable: $schema"
  command -v python3 >/dev/null 2>&1 || die "python3 is required to validate the result"
  python3 - "$schema" "$result" <<'EOF'
import json
import re
import sys

schema_path, result_path = sys.argv[1:]
with open(schema_path) as handle:
    schema = json.load(handle)
try:
    with open(result_path) as handle:
        value = json.load(handle)
except json.JSONDecodeError as error:
    sys.exit(f"lane: result is not JSON: {error}")

errors: list[str] = []


def check(node, value, path):
    kind = node.get("type")
    if kind == "object":
        if not isinstance(value, dict):
            errors.append(f"{path}: expected object")
            return
        properties = node.get("properties", {})
        for name in node.get("required", []):
            if name not in value:
                errors.append(f"{path}.{name}: required")
        if node.get("additionalProperties") is False:
            for name in value:
                if name not in properties:
                    errors.append(f"{path}.{name}: unknown property")
        for name, child in properties.items():
            if name in value:
                check(child, value[name], f"{path}.{name}")
    elif kind == "array":
        if not isinstance(value, list):
            errors.append(f"{path}: expected array")
            return
        if len(value) < node.get("minItems", 0):
            errors.append(f"{path}: at least {node['minItems']} item(s) required")
        for index, item in enumerate(value):
            check(node["items"], item, f"{path}[{index}]")
    elif kind == "string":
        if not isinstance(value, str):
            errors.append(f"{path}: expected string")
            return
        if len(value) < node.get("minLength", 0):
            errors.append(f"{path}: must not be empty")
        if "pattern" in node and not re.search(node["pattern"], value):
            errors.append(f"{path}: does not match {node['pattern']}")
        if "enum" in node and value not in node["enum"]:
            errors.append(f"{path}: must be one of {', '.join(node['enum'])}")


check(schema, value, "$")
if errors:
    sys.exit("lane: result does not validate:\n" + "\n".join(errors[:12]))
EOF
}

lane_done() {
  local result dirty head sha
  [[ $# -eq 1 ]] || {
    usage
    exit 2
  }
  result=$1
  [[ -f $result && -r $result ]] || die "result is not a readable file: $result"
  dirty=$(git_offenders)
  if [[ -n $dirty ]]; then
    printf 'lane: refusing to finish with uncommitted changes. Offenders:\n%s\n' "$dirty" >&2
    exit 1
  fi
  validate_result "$result"
  head=$(git rev-parse HEAD)
  sha=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["candidate_sha"])' "$result")
  [[ $sha == "$head" ]] || die "candidate_sha $sha is not HEAD $head"
  # The backend adapter stores stdout as the final message: the result
  # document must be the last stdout of this command.
  cat -- "$result"
}

main() {
  case ${1:-} in
    task)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      lane_task
      ;;
    verify)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      lane_verify
      ;;
    done)
      shift
      lane_done "$@"
      ;;
    -h | --help)
      usage >&1
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
