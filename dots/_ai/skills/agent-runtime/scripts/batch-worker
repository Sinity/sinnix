#!/usr/bin/env bash
# Worker-side toolbelt for a batch worker queued by `agentctl batch start`.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  batch-worker task                       print dispatch plus current beads task amendments
  batch-worker verify                     run the descriptor's focused verification as a job and wait
  batch-worker done <result.json>         validate with agentctl and print the result as the final message
EOF
}

die() {
  printf 'batch-worker: %s\n' "$*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a Git checkout"
}

project_file() {
  local root
  root=$(repo_root)
  [[ -f "$root/.agentctl/project.toml" ]] || die "missing $root/.agentctl/project.toml"
  printf '%s\n' "$root/.agentctl/project.toml"
}

project_id() {
  if [[ -n ${AGENTCTL_PROJECT_ID:-} ]]; then
    printf '%s\n' "$AGENTCTL_PROJECT_ID"
    return
  fi
  awk -F'"' '/^\[project\]/ { in_project = 1; next } /^\[/ { in_project = 0 } in_project && /^[[:space:]]*id[[:space:]]*=/ { print $2; exit }' "$(project_file)"
}

worker_task() {
  local prompt
  prompt=${AGENTCTL_JOB_PROMPT_FILE:-$(repo_root)/.agentctl/prompt.md}
  [[ -r $prompt ]] || die "dispatch prompt is unavailable: $prompt"
  cat -- "$prompt"
  if [[ -z ${AGENTCTL_RUN_ID:-} || -z ${AGENTCTL_WORKER_ID:-} ]]; then
    printf '\nbatch-worker: current beads tasks unavailable without a dispatch run/worker identity; prompt is historical.\n' >&2
    return 0
  fi
  printf '\n## Current beads tasks (read-only)\n'
  local -a context=(agentctl batch task --run "$AGENTCTL_RUN_ID" --worker "$AGENTCTL_WORKER_ID" --json)
  if [[ -n ${AGENTCTL_ATTEMPT:-} ]]; then
    context+=(--attempt "$AGENTCTL_ATTEMPT")
  fi
  "${context[@]}"
}

focused_operation() {
  # `[workspace].verify.focused` in the descriptor: an inline table on the
  # `verify` key or a `[workspace.verify]` table.
  awk '
    /^\[/ { in_workspace = ($0 ~ /^\[workspace(\.verify)?\]/) }
    in_workspace && match($0, /focused[[:space:]]*=[[:space:]]*"[^"]+"/) {
      value = substr($0, RSTART, RLENGTH)
      sub(/^[^"]*"/, "", value)
      sub(/"$/, "", value)
      print value
      exit
    }
  ' "$1"
}

worker_verify() {
  local operation output job_id reference identity
  command -v agentctl >/dev/null 2>&1 || die "agentctl is unavailable for managed verification"
  operation=$(focused_operation "$(project_file)")
  if [[ -z $operation ]]; then
    printf 'batch-worker verify: no focused verification declared in %s\n' "$(project_file)"
    return 0
  fi
  if ! output=$(agentctl job start "$(project_id)" "$operation" --workspace "$(repo_root)"); then
    printf '%s\n' "$output" >&2
    die "managed verification could not start"
  fi
  printf '%s\n' "$output"
  identity=$(python3 -c '
import json, sys
value = json.load(sys.stdin)
job_id, reference = value.get("job_id"), value.get("reference")
if type(job_id) is not int or job_id < 0 or not isinstance(reference, str) or not reference:
    raise SystemExit("missing job id or launch reference")
print(job_id)
print(reference)
' <<<"$output") || die "managed verification returned no launch identity"
  job_id=${identity%%$'\n'*}
  reference=${identity#*$'\n'}
  agentctl job wait "$job_id" --reference "$reference" --timeout-seconds "${AGENTCTL_TIMEOUT_SECONDS:-3600}" || die "managed verification did not succeed"
}

git_offenders() {
  local listing
  # Untracked files under .agentctl/ are agentctl's own (prompt, schema, result).
  listing=$(git status --porcelain=v1 --untracked-files=all) || return
  printf '%s\n' "$listing" | grep -v '^?? \.agentctl/' || [[ $? -eq 1 ]]
}

validate_result() {
  local result=$1
  command -v agentctl >/dev/null 2>&1 || die "agentctl is unavailable to validate the result"
  # Its verdict goes to stderr: stdout carries only the result document.
  agentctl result validate-worker "$result" >&2 || die "result does not validate"
}

worker_done() (
  local result dirty head sha snapshot
  [[ $# -eq 1 ]] || {
    usage
    exit 2
  }
  result=$1
  [[ -f $result && -r $result ]] || die "result is not a readable file: $result"
  dirty=$(git_offenders) || die "cannot inspect checkout status"
  if [[ -n $dirty ]]; then
    printf 'batch-worker: refusing to finish with uncommitted changes. Offenders:\n%s\n' "$dirty" >&2
    exit 1
  fi
  snapshot=$(mktemp "${TMPDIR:-/realm/tmp/work}/batch-worker-result.XXXXXXXX") || die "cannot allocate result snapshot"
  trap 'rm -f -- "$snapshot"' EXIT
  # Validate, inspect and emit one captured sequence, even if the worker
  # replaces its original result while validation is running.
  python3 - "$result" "$snapshot" <<'PY' || die "cannot capture result file"
import os
import shutil
import stat
import sys

with os.fdopen(os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK), "rb") as source:
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
        raise ValueError("result is not a regular file")
    with open(sys.argv[2], "wb") as destination:
        shutil.copyfileobj(source, destination, length=1024 * 1024)
PY
  result=$snapshot
  validate_result "$result"
  head=$(git rev-parse HEAD)
  sha=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["candidate_sha"])' "$result")
  [[ $sha == "$head" ]] || die "candidate_sha $sha is not HEAD $head"
  # The backend adapter stores stdout as the final message: the result
  # document must be the last stdout of this command.
  cat -- "$result"
)

main() {
  case ${1:-} in
    task)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      worker_task
      ;;
    verify)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      worker_verify
      ;;
    done)
      shift
      worker_done "$@"
      ;;
    -h | --help)
      usage >&1
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
