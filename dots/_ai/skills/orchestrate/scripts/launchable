#!/usr/bin/env bash
# Beads that are ready AND have no worktree/lane in flight — the set a refill
# can actually launch. `bd ready` alone includes everything already dispatched,
# so the coordinator was hand-diffing it against /realm/worktrees each time.
# Usage: launchable [project]   (default: polylogue)
set -u
PROJ=${1:-polylogue}
cd "/realm/project/$PROJ" 2>/dev/null || { echo "no such project: $PROJ" >&2; exit 1; }
bd ready 2>/dev/null | grep -vE "\[epic\]" | awk '{print $2}' | sed "s/^$PROJ-//" | grep -vE '^$|^○' | sort -u > /tmp/.launchable-ready.$$
ls -d "/realm/worktrees/packet-$PROJ-"* 2>/dev/null | sed "s|.*packet-$PROJ-||" | sort -u > /tmp/.launchable-inflight.$$
comm -23 /tmp/.launchable-ready.$$ /tmp/.launchable-inflight.$$
rm -f /tmp/.launchable-ready.$$ /tmp/.launchable-inflight.$$
