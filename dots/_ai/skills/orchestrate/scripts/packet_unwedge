#!/usr/bin/env bash
# Unwedge a packet whose launch fails with redacted OWNER_UNAVAILABLE because
# dead-collision recovery consumed the workspace record but left the worktree
# directory and branch behind (sinnix-dn4c split-brain).
# Usage: packet_unwedge <project-repo-path> <packet-name>
#   e.g. packet_unwedge /realm/project/polylogue polylogue-20eld
# Refuses when the worktree is dirty, has unpublished commits, or hosts a
# live process. Prints UNWEDGED on success; then retry the packet launch.
set -euo pipefail
REPO=$1; PACKET=$2
WT=/realm/worktrees/packet-$PACKET
BR=feature/packet/$PACKET
[ -d "$WT" ] || { echo "no worktree at $WT — nothing to unwedge"; exit 1; }
if pgrep -f "$WT" >/dev/null 2>&1; then
  echo "REFUSE: live process references $WT"; exit 2
fi
if [ -n "$(git -C "$WT" status --porcelain)" ]; then
  echo "REFUSE: dirty worktree $WT"; exit 3
fi
git -C "$WT" fetch -q origin
MB=$(git -C "$WT" merge-base HEAD origin/master)
if [ -n "$(git -C "$WT" log --oneline "$MB"..HEAD)" ]; then
  echo "REFUSE: unpublished commits ahead of merge-base in $WT"; exit 4
fi
git -C "$REPO" worktree remove "$WT"
git -C "$REPO" branch -D "$BR" 2>/dev/null || true
echo "UNWEDGED $PACKET"
