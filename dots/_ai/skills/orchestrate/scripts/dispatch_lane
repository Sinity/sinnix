#!/usr/bin/env bash
# Dispatch an ad-hoc lane with the standing worker contract injected by
# reference — author only the task delta.
# Usage: dispatch_lane <project> <delta-file> [model=gpt-5.6-luna] [effort=high] [checkout=default]
# checkout: "default" for a fresh workspace, or a registered workspace NAME (e.g. packet-polylogue-x) for completion lanes in an existing worktree.
set -u
PROJECT=$1; DELTA=$2; MODEL=${3:-gpt-5.6-luna}; EFFORT=${4:-high}; CHECKOUT=${5:-default}
# Refuse to dispatch into a worktree whose harvest is still running: the
# harvest rebases/amends/pushes that branch, so a lane there would race it.
case "$CHECKOUT" in
  worktree-*)
    for _lk in /realm/tmp/work/.wt-*.lock; do
      [ -e "$_lk" ] || continue
      if ! flock -n "$_lk" true 2>/dev/null; then
        _nm=$(basename "$_lk" .lock); _nm=${_nm#.wt-}
        _h=$(python3 -c "import hashlib,sys;print('worktree-'+hashlib.sha256(('/realm/worktrees/'+sys.argv[1]).encode()).hexdigest()[:16])" "$_nm" 2>/dev/null)
        if [ "$_h" = "$CHECKOUT" ]; then
          echo "dispatch refused: wt-busy — a harvest is holding $_nm; wait for HARVEST-OK/FAIL" >&2
          exit 7
        fi
      fi
    done
    ;;
esac

PROMPT=$(mktemp /realm/tmp/work/dispatch-XXXX.md)
cat > "$PROMPT" <<HDR
Read and follow the standing worker contract FIRST:
/realm/project/sinnix/dots/_ai/skills/orchestrate/references/worker-contract.md
(dispatch contract v2 clauses 1-8: launch snapshot, self-verification, red-first,
managed commands, honest single report, no scope expansion, exit rebased on
current origin/master with the quick gate green post-rebase, machine trailer).

# Task
HDR
cat "$DELTA" >> "$PROMPT"
agentctl agent launch --project "$PROJECT" --checkout "$CHECKOUT" \
  --prompt-file "$PROMPT" --backend codex --model "$MODEL" --effort "$EFFORT" 2>&1 \
  | grep -oE '"job_id": "[a-f0-9-]*"|"message": "[^"]*"' | head -1
