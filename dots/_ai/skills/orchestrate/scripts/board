#!/usr/bin/env bash
# Campaign board status front door. The board is a short-lived live-source cache.
set -eu
case "${1:-status}" in
  plan)
    python3 - <<'PYEOF'
import json, pathlib
path = pathlib.Path("/realm/tmp/work/dispatch-plan.json")
try:
    plan = json.loads(path.read_text())
except Exception:
    plan = {"groups": [], "generated_at": "never"}
print(f"generated {plan.get('generated_at', 'never')} | generation {plan.get('generation', 'none')}")
for row in plan.get("groups", []):
    print(" group", row.get("order"), row.get("group"), "orbit:", row.get("orbit"), "gates:", ",".join(row.get("judgment_gate", [])) or "none")
PYEOF
    ;;
  sync)
    python3 - <<'PYEOF'
import os
from pathlib import Path
from sinnixd.campaign_board import load_or_refresh_campaign_board

state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "sinnixd"
project_roots = {
    path.name: path for path in Path("/realm/project").iterdir()
    if path.is_dir() and (path / ".agentctl" / "project.toml").is_file()
}
load_or_refresh_campaign_board(
    Path("/realm/tmp/work/campaign-board.json"), force=True,
    state_dir=state_dir,
    project_roots=project_roots,
)
PYEOF
    ;;
  status|*)
    python3 - <<'PYEOF'
import json
import os
from pathlib import Path
from sinnixd.campaign_board import load_or_refresh_campaign_board

state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "sinnixd"
project_roots = {
    path.name: path for path in Path("/realm/project").iterdir()
    if path.is_dir() and (path / ".agentctl" / "project.toml").is_file()
}

b = load_or_refresh_campaign_board(
    Path("/realm/tmp/work/campaign-board.json"),
    state_dir=state_dir,
    project_roots=project_roots,
)
running = {k: v for k, v in b.get("lanes", {}).items() if isinstance(v, dict) and v.get("phase") not in ("succeeded", "failed", "cancelled", "timeout", "missing")}
print(f"updated {b.get('updated_at','never')} | lanes active {len(running)} | prs {len(b.get('prs',{}))}")
for k, v in list(running.items())[:12]: print(" lane", k[:8], v.get("phase"))
for n, t in list(b.get("prs", {}).items())[:8]:
    bead = t.get("bead_id")
    print(" PR", n, t.get("state"), *( [f"bead: {bead}", t.get("bead_status")] if bead else [] ))
PYEOF
    ;;
esac
