#!/usr/bin/env bash
# Campaign board status front door.  sinnixd-reactor is the sole writer; this
# compatibility command only asks it to drain once or reads its typed board.
set -eu
BOARD=/realm/tmp/work/campaign-board.json
case "${1:-status}" in
  sync)
    exec sinnixd-reactor --once
    ;;
  status|*)
    python3 - <<'PYEOF'
import json, pathlib
try: b = json.loads(pathlib.Path("/realm/tmp/work/campaign-board.json").read_text())
except Exception: b = {}
running = {k: v for k, v in b.get("lanes", {}).items() if isinstance(v, dict) and v.get("phase") not in ("succeeded", "failed", "cancelled", "timeout", "missing")}
print(f"updated {b.get('updated_at','never')} | lanes active {len(running)} | prs {len(b.get('prs',{}))}")
for k, v in list(running.items())[:12]: print(" lane", k[:8], v.get("phase"))
for n, t in list(b.get("prs", {}).items())[:8]: print(" PR", n, t.get("state"), "bead:", t.get("bead_id"), t.get("bead_close_status"))
PYEOF
    ;;
esac
