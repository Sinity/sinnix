#!/usr/bin/env python3
# @sinnix-package
# description: Post the codex-review commit status on open PR heads from the Codex review summary
# runtimeInputs: python3 gh

"""Publish a `codex-review` commit status that branch protection can require.

The hosted Codex reviewer posts a summary comment whose Code Review row names
the reviewed commit and its state; it publishes no status of its own. One pass
reads every open PR of each repository, with all of its comments, and sets the
head's status:

  success  the summary shows a completed Code Review of this exact head, or
           the PR carries the `codex-review-waived` label, or the gate is off;
  pending  anything else (running, not started, a draft, no summary).

A status is written only when it differs from the head's current one. Nothing
here ever passes a head it cannot read, so an outage leaves merges blocked.

The gate is on while `codex-review` is a required status context of the
default branch's protection, read on every pass. While it is off (the operator
removes it when Codex cannot review, for instance out of quota), every unwaived
head gets success "not required: Codex review gate is off" and the pass posts
no `@codex review` at all, the quota probe below included. Restoring the
required context restores everything below on the next pass. A pass that
cannot read the protection (an outage, or a branch with no required status
checks, which GitHub answers with 404) writes nothing for that repository.

Codex sometimes never starts on a pushed head. When a ready, unwaived head has
carried the "waiting for Codex" status for STALL_SECONDS with no review of it
in the summary, the pass posts one `@codex review` comment carrying a hidden
marker with the full head SHA. The marker lives on GitHub, so no later pass or
restart posts again for that head; a new head gets its own single request.

Codex answers a request it cannot serve with a usage-limit notice ("You have
reached your Codex usage limits for code reviews"). The limit belongs to the
account, so one notice on any open PR of the repository holds back requests
on every PR, and a request made before the newest notice no longer counts as
made. While held back, a waiting head's status reads "Codex usage limit
reached (<notice time>); not re-requesting". Recovery is probed, not assumed:

  - for QUOTA_RETRY_SECONDS after the newest notice, no request is posted;
  - then one pass posts a single request for the whole repository (the probe);
  - a notice answering the probe restarts the wait; a probe left unanswered
    for PROBE_GRACE_SECONDS means Codex is serving again, and every stalled
    head gets its one request again.

So a spent quota costs one request per repository per QUOTA_RETRY_SECONDS.
Notices on closed PRs are not read; a missed one costs one extra request,
which Codex answers with a fresh notice. The security-review notice
("... usage limits for security reviews") is a separate quota and is ignored.
A pass that could not read every PR's comments posts no request at all, since
the unread comments may hold the newest notice.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timezone

CONTEXT = "codex-review"
WAIVER_LABEL = "codex-review-waived"
SUMMARY_MARKER = "<!-- codex-pull-request-review-summary -->"
GH_TIMEOUT_S = 60
# Codex normally starts within minutes of a push; a head it never picks up
# would otherwise wait indefinitely.
STALL_SECONDS = 20 * 60
WAITING = "waiting for Codex to review this head"
REREQUESTED = "waiting for Codex; review re-requested for this head"
RETRIGGER_MARKER = "<!-- codex-review-retrigger: {sha} -->"
RETRIGGER_PREFIX = "<!-- codex-review-retrigger:"
GATE_OFF = "not required: Codex review gate is off"
QUOTA_NOTICE = "reached your Codex usage limits for code reviews"
LIMITED = "Codex usage limit reached ({since}); not re-requesting"
LIMITED_PREFIX = "Codex usage limit reached ("
# Codex's review allowance refills over hours; one probe per interval notices
# the refill without posting a request that can only draw another notice.
QUOTA_RETRY_SECONDS = 3 * 60 * 60
# Codex answers an unservable request within seconds; a probe it has left
# unanswered this long was accepted.
PROBE_GRACE_SECONDS = 10 * 60

QUERY = """
query($owner: String!, $name: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: OPEN, first: 100, after: $cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number
        url
        isDraft
        headRefOid
        labels(first: 100) { nodes { name } }
        comments(first: 100) {
          pageInfo { hasNextPage endCursor }
          nodes { url body createdAt author { login } }
        }
        commits(last: 1) {
          nodes {
            commit {
              status { context(name: "codex-review") { state description createdAt } }
            }
          }
        }
      }
    }
  }
}
"""

COMMENTS_QUERY = """
query($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      comments(first: 100, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes { url body createdAt author { login } }
      }
    }
  }
}
"""


class GhError(RuntimeError):
    pass


def gh(*args: str) -> str:
    try:
        done = subprocess.run(
            ["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT_S, check=False
        )
    except subprocess.TimeoutExpired as error:
        raise GhError(f"gh {args[0]} timed out after {GH_TIMEOUT_S}s") from error
    if done.returncode != 0:
        raise GhError(f"gh {' '.join(args[:2])} failed: {done.stderr.strip()[:300]}")
    return done.stdout


def summary_row(comments: list[dict]) -> tuple[str, bool, str | None]:
    """Return (reviewed short sha, completed, summary url) from the Codex summary."""
    summaries = [
        c
        for c in comments
        if SUMMARY_MARKER in (c.get("body") or "")
        and "codex" in ((c.get("author") or {}).get("login") or "")
    ]
    if not summaries:
        return "", False, None
    summary = summaries[-1]
    for line in summary["body"].splitlines():
        if "**Code Review**" in line:
            cells = [cell.strip() for cell in line.split("|")]
            reviewed = cells[3].replace("`", "") if len(cells) > 3 else ""
            completed = "**Completed**" in (cells[2] if len(cells) > 2 else "")
            return reviewed, completed, summary.get("url")
    return "", False, summary.get("url")


def graphql(query: str, **variables: object) -> dict:
    args = ["api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        if value is None:
            continue
        # -F types integers; -f keeps cursors and names as strings.
        flag = "-F" if isinstance(value, int) else "-f"
        args += [flag, f"{key}={value}"]
    return json.loads(gh(*args))


def open_pull_requests(owner: str, name: str) -> list[dict]:
    """Every open PR, following the listing past its first page."""
    prs: list[dict] = []
    cursor = None
    while True:
        page = graphql(QUERY, owner=owner, name=name, cursor=cursor)
        connection = page["data"]["repository"]["pullRequests"]
        prs.extend(connection["nodes"])
        if not connection["pageInfo"]["hasNextPage"]:
            return prs
        cursor = connection["pageInfo"]["endCursor"]


def gate_required(repository: str) -> bool:
    """`codex-review` is a required status context of the default branch."""
    branch = json.loads(gh("api", f"repos/{repository}"))["default_branch"]
    checks = json.loads(
        gh("api", f"repos/{repository}/branches/{branch}/protection/required_status_checks")
    )
    contexts = set(checks.get("contexts") or [])
    contexts |= {check["context"] for check in checks.get("checks") or []}
    return CONTEXT in contexts


def all_comments(owner: str, name: str, pr: dict) -> list[dict]:
    """The PR's comments, paging past the first 100 the listing carries."""
    comments = list(pr["comments"]["nodes"])
    info = pr["comments"]["pageInfo"]
    while info["hasNextPage"]:
        page = graphql(
            COMMENTS_QUERY, owner=owner, name=name, number=pr["number"], cursor=info["endCursor"]
        )
        connection = page["data"]["repository"]["pullRequest"]["comments"]
        comments.extend(connection["nodes"])
        info = connection["pageInfo"]
    return comments


def _time(stamp: str) -> datetime:
    return datetime.fromisoformat(stamp.replace("Z", "+00:00"))


def _stamp(moment: datetime) -> str:
    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")


def _by_codex(comment: dict) -> bool:
    return "codex" in ((comment.get("author") or {}).get("login") or "")


@dataclass(frozen=True)
class Quota:
    """The repository's Codex review quota as its open PRs' comments show it.

    `notice` is the newest code-review usage-limit notice; `probe` is the
    newest re-trigger request posted after it.
    """

    notice: datetime | None = None
    probe: datetime | None = None

    @classmethod
    def read(cls, threads: list[list[dict]]) -> Quota:
        comments = [comment for thread in threads for comment in thread]
        notices = [
            _time(c["createdAt"])
            for c in comments
            if _by_codex(c) and QUOTA_NOTICE in (c.get("body") or "")
        ]
        if not notices:
            return cls()
        notice = max(notices)
        probes = [
            _time(c["createdAt"])
            for c in comments
            if RETRIGGER_PREFIX in (c.get("body") or "") and _time(c["createdAt"]) > notice
        ]
        return cls(notice, max(probes, default=None))

    def held(self, now: datetime) -> bool:
        """Requests wait: the notice is recent, or a probe awaits its answer."""
        if self.notice is None:
            return False
        if self.probe is None:
            return (now - self.notice).total_seconds() < QUOTA_RETRY_SECONDS
        return (now - self.probe).total_seconds() < PROBE_GRACE_SECONDS

    def budget(self, now: datetime) -> int | None:
        """Requests this pass may post: none, one probe, or unlimited (None)."""
        if self.held(now):
            return 0
        if self.notice is not None and self.probe is None:
            return 1
        return None

    def description(self, now: datetime) -> str | None:
        """The waiting-head status while requests are held back."""
        if self.notice is None or self.budget(now) is None:
            return None
        return LIMITED.format(since=_stamp(self.notice))


def retriggered(comments: list[dict], head: str, since: datetime | None = None) -> bool:
    """A request for this head exists, posted after the newest quota notice."""
    marker = RETRIGGER_MARKER.format(sha=head)
    return any(
        marker in (c.get("body") or "") and (since is None or _time(c["createdAt"]) > since)
        for c in comments
    )


def desired(
    pr: dict, comments: list[dict], quota: Quota, now: datetime, *, required: bool
) -> tuple[str, str, str]:
    head = pr["headRefOid"]
    labels = {node["name"] for node in pr["labels"]["nodes"]}
    reviewed, completed, url = summary_row(comments)
    for_head = len(reviewed) >= 7 and head.startswith(reviewed)
    target = url or pr["url"]
    if WAIVER_LABEL in labels:
        return "SUCCESS", f"waived by the {WAIVER_LABEL} label", target
    if not required:
        return "SUCCESS", GATE_OFF, target
    if pr["isDraft"]:
        return "PENDING", "draft: Codex reviews once marked ready", target
    if for_head and completed:
        return "SUCCESS", f"Codex review completed on {reviewed}", target
    if for_head:
        return "PENDING", f"Codex review of {reviewed} not completed yet", target
    if retriggered(comments, head, quota.notice):
        return "PENDING", REREQUESTED, target
    return "PENDING", quota.description(now) or WAITING, target


def _waiting(description: str) -> bool:
    return description == WAITING or description.startswith(LIMITED_PREFIX)


def stalled(description: str, current: dict, now: datetime) -> bool:
    """The head has waited unreviewed for STALL_SECONDS.

    The pass writes WAITING (or, while the quota holds requests back, the
    usage-limit description) when it first sees a ready head, so that status's
    creation time is the clock; any other current status (none yet, a draft,
    a review in progress) does not count as waiting.
    """
    if not _waiting(description) or not _waiting(current.get("description") or ""):
        return False
    created = current.get("createdAt")
    if not created:
        return False
    return (now - _time(created)).total_seconds() >= STALL_SECONDS


def sync_repository(repository: str, *, dry_run: bool, now: datetime | None = None) -> int:
    owner, name = repository.split("/", 1)
    now = now or datetime.now(timezone.utc)
    changed = 0
    # Unreadable protection raises: the repository is left untouched this pass.
    required = gate_required(repository)
    read: list[tuple[dict, list[dict]]] = []
    complete = True
    for pr in open_pull_requests(owner, name):
        try:
            read.append((pr, all_comments(owner, name, pr)))
        except GhError as error:
            # Without every comment the summary or the marker may be missing:
            # leave this PR untouched and let the next pass retry.
            print(f"{repository}#{pr['number']}: {error}", file=sys.stderr)
            complete = False
    quota = Quota.read([comments for _, comments in read])
    # An unread PR may hold the newest quota notice, so requests wait for a
    # pass that read them all.
    # With the gate off nothing waits on Codex, so nothing asks it to review.
    budget = quota.budget(now) if complete and required else 0
    for pr, comments in read:
        head = pr["headRefOid"]
        state, description, target = desired(pr, comments, quota, now, required=required)
        commits = pr["commits"]["nodes"]
        status = commits[0]["commit"]["status"] if commits else None
        current = (status or {}).get("context") or {}
        if budget != 0 and stalled(description, current, now):
            if budget is not None:
                budget -= 1
            if dry_run:
                print(f"would request Codex review on {repository}#{pr['number']} {head[:9]}")
            else:
                try:
                    gh(
                        "api",
                        "-X",
                        "POST",
                        f"repos/{repository}/issues/{pr['number']}/comments",
                        "-f",
                        f"body=@codex review\n\n{RETRIGGER_MARKER.format(sha=head)}",
                    )
                except GhError as error:
                    # A request that landed despite the error leaves its marker,
                    # so the retry on the next pass cannot post twice.
                    print(f"{repository}#{pr['number']}: {error}", file=sys.stderr)
                    continue
                description = REREQUESTED
        if current.get("state") == state and current.get("description") == description:
            continue
        print(f"{repository}#{pr['number']} {head[:9]}: {state.lower()} ({description})")
        changed += 1
        if dry_run:
            continue
        gh(
            "api",
            "-X",
            "POST",
            f"repos/{repository}/statuses/{head}",
            "-f",
            f"state={state.lower()}",
            "-f",
            f"context={CONTEXT}",
            "-f",
            f"description={description[:140]}",
            "-f",
            f"target_url={target}",
        )
    return changed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("repositories", nargs="+", metavar="OWNER/NAME")
    parser.add_argument("--dry-run", action="store_true", help="print changes without posting")
    args = parser.parse_args()
    broken = False
    for repository in args.repositories:
        try:
            sync_repository(repository, dry_run=args.dry_run)
        except GhError as error:
            # Transient (network, rate limit): the next pass retries. A missed
            # pass never passes a head, so merges stay blocked meanwhile.
            print(f"{repository}: {error}", file=sys.stderr)
        except (KeyError, TypeError, ValueError) as error:
            # The API or summary shape changed: fail the unit so it is noticed.
            print(f"{repository}: unexpected response shape: {error!r}", file=sys.stderr)
            broken = True
    return 1 if broken else 0


if __name__ == "__main__":
    sys.exit(main())
