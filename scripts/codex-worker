#!/usr/bin/env bash
# @sinnix-package
# description: Run one non-interactive Codex worker in the current checkout, logging to an output directory
# runtimeInputs: coreutils gnugrep jq
# Usage: codex-worker <effort> <prompt-file> <output-schema> <output-dir> [model]
# Declared as each project's AgentCTL `codex` operation, so workers queue in
# the codex pool and run inside its slice; the coordinator prepares the
# worktree (passed as --workspace) and the prompt. A run that ends on a
# transient service error ("at capacity") resumes the same thread rather
# than losing the worker's state, up to three times.
set -euo pipefail
if [ $# -lt 4 ]; then
  echo "usage: codex-worker <effort> <prompt-file> <output-schema> <output-dir> [model]" >&2
  exit 2
fi
effort=$1 prompt=$2 schema=$3 out=$4 model=${5:-gpt-6.1-sol}
mkdir -p "$out"
date -Is >"$out/started"
common=(-m "$model" -c model_reasoning_effort="$effort"
  --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check
  --json -o "$out/final.md" --output-schema "$schema")
set +e
codex exec -C "$PWD" "${common[@]}" - <"$prompt" >>"$out/events.jsonl" 2>>"$out/stderr.log"
rc=$?
for attempt in 1 2 3; do
  [ "$rc" -ne 0 ] || break
  tail -n 5 "$out/events.jsonl" | grep -q 'at capacity' || break
  thread=$(jq -r 'select(.type=="thread.started") | .thread_id' "$out/events.jsonl" | tail -n 1)
  [ -n "$thread" ] || break
  echo "codex-worker: service at capacity; resuming thread $thread (attempt $attempt)" >>"$out/stderr.log"
  sleep $((120 * attempt))
  codex exec resume "${common[@]}" "$thread" \
    "The previous turn ended on a transient service error. Continue the task from where you stopped." \
    >>"$out/events.jsonl" 2>>"$out/stderr.log"
  rc=$?
done
set -e
date -Is >"$out/finished"
cat "$out/final.md" 2>/dev/null || tail -20 "$out/stderr.log"
exit "$rc"
