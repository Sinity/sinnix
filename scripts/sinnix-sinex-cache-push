#!/usr/bin/env bash
# @sinnix-package
# description: Push a store path's sinex package closure to sinity.cachix.org
# runtimeInputs: bash coreutils gnugrep nix cachix systemd
#
# Shared push logic for both the interactive `switch` path
# (flake/command-registry.nix's sinexCachePush, which passes
# /run/current-system after a successful activation) and the async
# sinex-cache-prebuild AgentCTL operation (which passes a freshly `nix build`d
# sinex output path).
#
# By default this remains best-effort for interactive `switch`: the push runs
# as a detached background.slice unit and reports failures through its journal.
# `--foreground` keeps the upload inside a declared AgentCTL operation so that
# its result, timeout, and cancellation cover both build and publication.

set -euo pipefail

foreground=0
if [ "${1:-}" = "--foreground" ]; then
  foreground=1
  shift
fi

if [ "$#" -eq 0 ]; then
  echo "usage: sinnix-sinex-cache-push [--foreground] <store-path> [<store-path>...]" >&2
  exit 64
fi

sinex_paths="$(nix path-info -r "$@" 2>/dev/null | grep -E -- '-sinex-[0-9][^/]*$' || true)"

if [ -z "$sinex_paths" ]; then
  echo "sinnix-sinex-cache-push: no sinex package paths found in the given closure(s); nothing to push"
  exit 0
fi

if [ "$foreground" -eq 1 ]; then
  echo "sinnix-sinex-cache-push: publishing sinex package closure to sinity.cachix.org"
  # shellcheck disable=SC2086
  exec cachix push sinity $sinex_paths
fi

echo "sinnix-sinex-cache-push: publishing sinex package closure to sinity.cachix.org in the background"
# shellcheck disable=SC2086
systemd-run --user --quiet --collect \
  --slice=background.slice \
  cachix push sinity $sinex_paths || true
