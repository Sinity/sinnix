#!/usr/bin/env bash
# @sinnix-package: skip
set -euo pipefail

shell_bin="${SHELL:-}"
if [[ -z "$shell_bin" || ! -x "$shell_bin" ]]; then
  shell_bin="$(command -v zsh)"
fi

capture_root_file="${XDG_CONFIG_HOME:-$HOME/.config}/sinnix/terminal-capture-root"
if [[ -r "$capture_root_file" ]]; then
  IFS= read -r capture_root < "$capture_root_file"
else
  capture_root="${SINNIX_CAPTURE_ROOT:-/realm/activity/terminal/asciinema}"
fi
capture_disabled="${SINNIX_CAPTURE_DISABLE:-}"

now_ms() {
  local raw="${EPOCHREALTIME:-}"

  if [[ -z "$raw" ]]; then
    raw="$(printf '%(%s)T' -1).000"
  fi

  raw="${raw//,/.}"

  local sec="${raw%%.*}"
  local frac="${raw#*.}"

  if [[ "$frac" == "$raw" ]]; then
    frac="0"
  fi

  frac="${frac}000"
  printf '%s%s' "$sec" "${frac:0:3}"
}

guess_project_root() {
  local cwd="$1"
  if [[ "$cwd" == /realm/project/* ]]; then
    local suffix="${cwd#/realm/project/}"
    local name="${suffix%%/*}"
    if [[ -n "$name" ]]; then
      printf '/realm/project/%s/repo' "$name"
      return 0
    fi
  fi
  printf ''
}

find_repo_root() {
  local dir="$1"

  while [[ -n "$dir" && "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then
      printf '%s' "$dir"
      return 0
    fi

    dir="${dir%/*}"
    if [[ -z "$dir" ]]; then
      dir="/"
    fi
  done

  return 1
}

while IFS='=' read -r name _; do
  case "$name" in
    SINNIX_CAPTURE_*)
      unset "$name"
      ;;
  esac
done < <(env)
unset SINNIX_CAPTURE_ACTIVE SINNIX_CAPTURE_CAST_FILE ASCIINEMA_SESSION || true

if [[ -n "$capture_disabled" || -n "${TMUX:-}" || ! -t 0 || -z "${KITTY_PID:-}" ]]; then
  exec "$shell_bin"
fi

if ! command -v asciinema >/dev/null 2>&1 || ! command -v setsid >/dev/null 2>&1; then
  exec "$shell_bin"
fi

# The recorder owns private captures; the interactive shell keeps its caller's
# file-creation policy.
shell_umask=$(umask)
umask 077

tty_path="$(tty 2>/dev/null || true)"
if [[ "$tty_path" == "not a tty" ]]; then
  tty_path=""
fi

tty_slug="${tty_path//\//_}"
if [[ -z "$tty_slug" ]]; then
  tty_slug="unknown_tty"
fi

started_at_ms="$(now_ms)"
host_name="${HOSTNAME:-}"
if [[ -z "$host_name" ]]; then
  host_name="$(hostname)"
fi

capture_day="$(printf '%(%Y/%m/%d)T' -1)"
session_id="${host_name}-${tty_slug}-${started_at_ms}"
session_dir="${capture_root}/${capture_day}/${session_id}"
cast_path="${session_dir}/session.cast"
start_cwd="$(pwd -P)"
start_repo_root="$(find_repo_root "$start_cwd" || true)"
start_project_root="$(guess_project_root "$start_cwd")"
writer="$(dirname "$(readlink -f "$0")")/sinnix-terminal-capture-writer"

export SINNIX_CAPTURE_ACTIVE=1
export SINNIX_CAPTURE_CAST_FILE="$cast_path"
export SINNIX_CAPTURE_SESSION_ID="$session_id"
export SINNIX_CAPTURE_SESSION_DIR="$session_dir"
export SINNIX_CAPTURE_SESSION_FILE="${session_dir}/session.json"
export SINNIX_CAPTURE_EVENTS_FILE="${session_dir}/events.jsonl"
export SINNIX_CAPTURE_STARTED_AT_MS="$started_at_ms"
export SINNIX_CAPTURE_HOST="$host_name"
export SINNIX_CAPTURE_USER="${USER:-}"
export SINNIX_CAPTURE_TTY="$tty_path"
export SINNIX_CAPTURE_TERMINAL="kitty"
export SINNIX_CAPTURE_SHELL="$shell_bin"
export SINNIX_CAPTURE_TERM_TYPE="${TERM:-}"
export SINNIX_CAPTURE_START_CWD="$start_cwd"
export SINNIX_CAPTURE_START_REPO_ROOT="$start_repo_root"
export SINNIX_CAPTURE_PROJECT_ROOT="$start_project_root"

# Nothing here or in the shell touches the capture directory or runs git: a
# stalled disk must not delay the prompt. The session writer creates the
# directory, queries the repository and owns events.jsonl and session.json.
# It reads this pipe in its own session, so closing the terminal does not cut
# it off; it ends when the shell and this launcher have closed their ends.
events_fd=""
if exec {events_fd}> >(exec setsid python3 "$writer" session "$capture_root" >/dev/null 2>&1); then
  # The shell opens its own close-on-exec end through this path.
  export SINNIX_CAPTURE_EVENTS_PIPE="/proc/$$/fd/$events_fd"
else
  events_fd=""
fi

cleanup_escalated=false
recorder_pid=""
recorder_status=""
supervisor_done=false
cleanup_reason=""

trim_spaces() {
  local value="${1:-}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

count_event_lines() {
  local events_file="${SINNIX_CAPTURE_EVENTS_FILE:-}"
  if [[ -z "$events_file" || ! -f "$events_file" ]]; then
    printf '0'
    return 0
  fi

  wc -l < "$events_file" | tr -d '[:space:]'
}

session_needs_finalization() {
  local session_file="${SINNIX_CAPTURE_SESSION_FILE:-}"

  if [[ -z "$session_file" || ! -f "$session_file" ]] || ! command -v jq >/dev/null 2>&1; then
    return 1
  fi

  jq -e '(.finished_at_ms == null)' "$session_file" >/dev/null 2>&1
}

wait_for_recorder() {
  if [[ -z "$recorder_pid" || -n "$recorder_status" ]]; then
    return 0
  fi

  if wait "$recorder_pid"; then
    recorder_status=0
  else
    recorder_status=$?
  fi
}

finalize_session_file_if_running() {
  local exit_reason="$1"
  local exit_code="${2:-}"
  local recorder_exit_code="${3:-}"
  local session_file="${SINNIX_CAPTURE_SESSION_FILE:-}"

  if [[ -z "$session_file" || ! -f "$session_file" ]] || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  if ! session_needs_finalization; then
    return 0
  fi

  local finished_at_ms
  finished_at_ms="$(now_ms)"

  local started_at_ms
  started_at_ms="$(jq -r '.started_at_ms // empty' "$session_file" 2>/dev/null || true)"

  local duration_ms="null"
  if [[ -n "$started_at_ms" ]]; then
    duration_ms=$((finished_at_ms - started_at_ms))
  fi

  local event_count
  event_count="$(count_event_lines)"

  local exit_code_json="null"
  if [[ -n "$exit_code" ]]; then
    exit_code_json="$exit_code"
  fi

  local recorder_exit_code_json="null"
  if [[ -n "$recorder_exit_code" ]]; then
    recorder_exit_code_json="$recorder_exit_code"
  fi

  local tmp_file="${session_file}.tmp"
  jq \
    --arg exit_reason "$exit_reason" \
    --argjson finished_at_ms "$finished_at_ms" \
    --argjson duration_ms "$duration_ms" \
    --argjson exit_code "$exit_code_json" \
    --argjson recorder_exit_code "$recorder_exit_code_json" \
    --argjson cleanup_escalated "$cleanup_escalated" \
    --argjson event_count "$event_count" \
    '
      .finished_at_ms = $finished_at_ms
      | .duration_ms = $duration_ms
      | .event_count = (if (.event_count // 0) < $event_count then $event_count else (.event_count // 0) end)
      | .exit_reason = $exit_reason
      | .exit_code = $exit_code
      | .recorder_exit_code = $recorder_exit_code
      | .cleanup_escalated = $cleanup_escalated
    ' \
    "$session_file" > "$tmp_file"
  mv "$tmp_file" "$session_file"
}

update_session_file() {
  local recorder_exit_code="$1"
  local session_file="${SINNIX_CAPTURE_SESSION_FILE:-}"

  if [[ -z "$session_file" || ! -f "$session_file" ]] || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  local tmp_file="${session_file}.tmp"
  jq \
    --argjson recorder_exit_code "$recorder_exit_code" \
    --argjson cleanup_escalated "$cleanup_escalated" \
    '.recorder_exit_code = $recorder_exit_code | .cleanup_escalated = $cleanup_escalated' \
    "$session_file" > "$tmp_file"
  mv "$tmp_file" "$session_file"
}

# The session writer is the only writer of session.json while it lives. The
# launcher sends it the recorder's outcome; that write fails only when no
# reader holds the pipe, and only then does the launcher edit the file itself.
report_recorder_end() {
  local exit_reason="$1"
  local exit_code="${2:-}"
  local recorder_exit_code="${3:-}"

  if [[ -n "$events_fd" ]]; then
    local fd="$events_fd" reported=false reason_json=null
    events_fd=""
    if [[ -n "$exit_reason" ]]; then
      reason_json="\"$exit_reason\""
    fi
    trap '' PIPE
    if printf '{"type":"supervisor_exit","ts_ms":%s,"exit_reason":%s,"exit_code":%s,"recorder_exit_code":%s,"cleanup_escalated":%s}\n' \
      "$(now_ms)" \
      "$reason_json" \
      "${exit_code:-null}" \
      "${recorder_exit_code:-null}" \
      "$cleanup_escalated" 1>&"$fd" 2>/dev/null; then
      reported=true
    fi
    exec {fd}>&-
    if [[ "$reported" == true ]]; then
      return 0
    fi
  fi

  if [[ -n "$exit_reason" ]]; then
    finalize_session_file_if_running "$exit_reason" "$exit_code" "$recorder_exit_code"
  fi
  update_session_file "${recorder_exit_code:-null}"
}

cleanup_recorder_subtree() {
  local exit_reason="$1"
  local exit_code="${2:-}"

  if [[ -z "$recorder_pid" ]]; then
    report_recorder_end "$exit_reason" "$exit_code" "$recorder_status"
    return 0
  fi

  kill -TERM "$recorder_pid" 2>/dev/null || true

  for _ in 1 2 3 4 5; do
    if ! kill -0 "$recorder_pid" 2>/dev/null; then
      break
    fi
    sleep 0.2
  done

  if kill -0 "$recorder_pid" 2>/dev/null; then
    cleanup_escalated=true
    kill -KILL "$recorder_pid" 2>/dev/null || true
  fi

  wait_for_recorder
  report_recorder_end "$exit_reason" "$exit_code" "$recorder_status"
}

handle_supervisor_signal() {
  local exit_reason="$1"
  local process_status="$2"
  cleanup_reason="$exit_reason"
  cleanup_recorder_subtree "$exit_reason" "$process_status"
  trap - EXIT
  exit "$process_status"
}

handle_supervisor_exit() {
  local exit_status="$1"

  if [[ "$supervisor_done" == true || -n "$cleanup_reason" ]]; then
    return 0
  fi

  cleanup_recorder_subtree "launcher_exit" "$exit_status"
}

trap 'handle_supervisor_signal "terminal_detached" 129' HUP
trap 'handle_supervisor_signal "launcher_interrupted" 130' INT
trap 'handle_supervisor_signal "launcher_terminated" 143' TERM
trap 'handle_supervisor_exit "$?"' EXIT

# The transport owns a pipe and drains its independent writer before exit.
run_recorder() {
  exec python3 "$writer" record "$cast_path" asciinema rec \
    --stdin \
    --quiet \
    --return \
    --output-format asciicast-v3 \
    --capture-env SHELL,TERM,SINNIX_CAPTURE_SESSION_ID,SINNIX_CAPTURE_HOST,SINNIX_CAPTURE_USER,SINNIX_CAPTURE_TTY,SINNIX_CAPTURE_TERMINAL,SINNIX_CAPTURE_START_CWD,SINNIX_CAPTURE_START_REPO_ROOT,SINNIX_CAPTURE_PROJECT_ROOT \
    --command "umask $shell_umask; exec \"\$SINNIX_CAPTURE_SHELL\""
}

# The recorder must not hold the events pipe open past the launcher.
if [[ -n "$events_fd" ]]; then
  run_recorder {events_fd}>&- &
else
  run_recorder &
fi
recorder_pid=$!

wait_for_recorder
report_recorder_end "" "" "$recorder_status"
supervisor_done=true
exit "$recorder_status"
