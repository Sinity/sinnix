#!/usr/bin/env bash
# @sinnix-package: skip

_sinnix_project_root() {
  if command -v git >/dev/null 2>&1; then
    local git_root
    git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$git_root" ]; then
      printf '%s\n' "$git_root"
      return 0
    fi
  fi

  case "$PWD" in
    /realm/project/*)
      local rest
      rest="${PWD#/realm/project/}"
      printf '/realm/project/%s\n' "${rest%%/*}"
      ;;
    *) return 1 ;;
  esac
}

# Classification target for _sinnix_project_kind. `--show-toplevel` returns
# the checkout PWD is actually in, which for an agent worktree
# (`.claude/worktrees/<id>`, `git worktree add`) is not any of the known
# project paths even though it is a full copy of one -- it would otherwise
# fall through to the generic realm-project bucket and lose the project's
# wrapper command set. `--git-common-dir` always resolves back to the
# shared .git directory regardless of which worktree PWD is in, so its
# parent is the identity every worktree of a project shares; a non-worktree
# checkout's common-dir is its own .git, so this is a no-op there.
_sinnix_project_identity_root() {
  if command -v git >/dev/null 2>&1; then
    local common_dir
    common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [ -n "$common_dir" ]; then
      printf '%s\n' "$(dirname "$common_dir")"
      return 0
    fi
  fi
  _sinnix_project_root
}

_sinnix_project_kind() {
  local project_root
  project_root="$(_sinnix_project_identity_root)" || return 1

  case "$project_root" in
    /realm/project/sinnix) printf '%s\n' sinnix ;;
    /realm/project/sinity-lynchpin) printf '%s\n' lynchpin ;;
    /realm/project/sinex | /realm/project/sinex-*) printf '%s\n' sinex ;;
    /realm/project/polylogue | /realm/project/polylogue-*) printf '%s\n' polylogue ;;
    /realm/project/scribe-tap) printf '%s\n' rust-project ;;
    /realm/project/intercept-bounce) printf '%s\n' rust-project ;;
    /realm/project/knowledge-extract) printf '%s\n' python-project ;;
    /realm/project/pwrank) printf '%s\n' web-project ;;
    /realm/data/knowledgebase) printf '%s\n' data-project ;;
    /realm/project/*)
      if [ -e "$project_root/flake.nix" ] \
        || [ -e "$project_root/Cargo.toml" ] \
        || [ -e "$project_root/pyproject.toml" ] \
        || [ -e "$project_root/package.json" ] \
        || [ -e "$project_root/justfile" ] \
        || [ -e "$project_root/Justfile" ]; then
        printf '%s\n' realm-project
      else
        return 1
      fi
      ;;
    *) return 1 ;;
  esac
}

_sinnix_setup_sinex_dev_cache() {
  local project_root="$1"
  local sinex_user
  local sinex_hash
  local sinex_cache_base

  sinex_user="${USER:-$(id -un)}"
  sinex_hash="$(printf '%s' "$project_root" | sha256sum | cut -c1-12)"
  sinex_cache_base="/var/cache/sinex/$sinex_user/$sinex_hash"

  export SINEX_DEV_ROOT="$project_root"

  if [ "${SINEX_DEV_CACHE_ROOT:-$project_root/.sinex/cache}" = "$project_root/.sinex/cache" ]; then
    export SINEX_DEV_CACHE_ROOT="$sinex_cache_base"
    export SINEX_CACHE_DIR="$SINEX_DEV_CACHE_ROOT"
    export CARGO_TARGET_DIR="$SINEX_DEV_CACHE_ROOT/target"
    export SINEX_TEST_RESULTS_DIR="$SINEX_CACHE_DIR/test-results"
    mkdir -p "$SINEX_DEV_CACHE_ROOT" "$CARGO_TARGET_DIR" "$SINEX_TEST_RESULTS_DIR"
  fi

  if [ "${SINEX_DEV_STATE_DIR:-$project_root/.sinex}" = "$project_root/.sinex" ]; then
    export SINEX_DEV_STATE_DIR="$sinex_cache_base/dev-state"
    export DATABASE_URL="postgresql:///sinex_dev?host=$SINEX_DEV_STATE_DIR/run"
    export PGHOST="$SINEX_DEV_STATE_DIR/run"
    mkdir -p "$SINEX_DEV_STATE_DIR"
  fi

  if [ "${SINEX_STATE_DIR:-$project_root/.sinex/state}" = "$project_root/.sinex/state" ]; then
    export SINEX_STATE_DIR="$project_root/.sinex/state"
    export SINEX_NATS_DIR="$SINEX_DEV_STATE_DIR/nats"
    mkdir -p "$SINEX_STATE_DIR" "$SINEX_NATS_DIR"
  fi

  # Tie the per-checkout dev-postgres lifetime to this devshell (sinex-grlv).
  # The sinex devshell starts postgres via `pg_ctl start`, which daemonizes it
  # so it outlives the launching shell. Register this interactive shell as an
  # owner and ensure a detached watcher is running; when the last owning shell
  # dies (including via kill -9) and nothing is connected, the watcher stops the
  # instance. See scripts/sinnix-sinex-dev-db.
  _sinnix_register_sinex_dev_owner "$SINEX_DEV_STATE_DIR" "$project_root"
}

# Best-effort resolution of the interactive shell PID that entered the checkout.
# Under direnv this rc is evaluated inside a bash child of the `direnv` process,
# whose own parent is the interactive shell; walk up to `direnv` and return its
# parent so the watcher tracks a PID that dies when the shell dies.
_sinnix_interactive_shell_pid() {
  local pid="$$"
  local comm ppid
  while [ "${pid:-1}" != "" ] && [ "${pid:-1}" -gt 1 ] 2>/dev/null; do
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || true)"
    ppid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)"
    if [ "$comm" = "direnv" ] && [ -n "$ppid" ]; then
      printf '%s' "$ppid"
      return 0
    fi
    [ -n "$ppid" ] || break
    pid="$ppid"
  done
  printf '%s' "$PPID"
}

_sinnix_register_sinex_dev_owner() {
  local state_dir="$1"
  local project_root="$2"
  local shell_pid owners
  [ -n "$state_dir" ] || return 0

  shell_pid="$(_sinnix_interactive_shell_pid)"
  case "$shell_pid" in '' | *[!0-9]*) return 0 ;; esac

  owners="$state_dir/owners"
  mkdir -p "$owners" 2>/dev/null || return 0
  printf '%s\t%s\n' "$project_root" "$(date -u +%FT%TZ 2>/dev/null || true)" \
    >"$owners/$shell_pid" 2>/dev/null || true

  _sinnix_ensure_sinex_dev_watcher "$state_dir"
}

_sinnix_ensure_sinex_dev_watcher() {
  local state_dir="$1"
  local lock="$state_dir/dev-db-watcher.lock"
  local bin _fd _n

  # Skip if a watcher already holds the lock for this checkout.
  if command -v flock >/dev/null 2>&1; then
    if ! flock -n "$lock" true 2>/dev/null; then
      return 0
    fi
  fi

  bin="$(command -v sinnix-sinex-dev-db 2>/dev/null || true)"
  if [ -z "$bin" ] && [ -x /realm/project/sinnix/scripts/sinnix-sinex-dev-db ]; then
    bin=/realm/project/sinnix/scripts/sinnix-sinex-dev-db
  fi
  [ -n "$bin" ] || return 0

  # Detach into its own session so a kill -9 / terminal-close (SIGHUP) of the
  # owning shell does not take the watcher down with it, and close inherited
  # direnv FDs (>2) so its private pipes are not held open (would hang direnv).
  (
    for _fd in "/proc/$$/fd/"*; do
      _n="${_fd##*/}"
      [ "$_n" -le 2 ] 2>/dev/null && continue
      eval "exec ${_n}>&-" 2>/dev/null || true
    done
    exec setsid "$bin" watch "$state_dir" \
      </dev/null >>"$state_dir/dev-db-watcher.log" 2>&1
  ) &
  disown 2>/dev/null || true
}

_sinnix_project_environment_setup() {
  local project_kind
  project_kind="$(_sinnix_project_kind)" || return 0

  local project_root
  project_root="$(_sinnix_project_root)" || return 0

  case "$project_kind" in
    sinex)
      _sinnix_setup_sinex_dev_cache "$project_root"
      ;;
  esac
}

# nix-direnv (3.1.2) registers a GC root for every flake input by shelling
# out to `nix build --out-link` once per input -- almost pure CLI process
# startup, and it scales with input count: on sinnix's 61-input flake this
# loop is 5-7s of the 5.5-7.1s `use flake` costs on a cache miss, against
# 0.07-0.97s for one batched `nix-store --add-root --indirect --realise`
# covering the same paths (sinnix-l9vp). Since every repo that calls
# `use flake` pays this per-input cost, the batching lives here rather than
# in each repo's .envrc: queue roots destined for `flake-inputs/` while
# upstream's use_flake runs, then register them in one call afterwards. Only
# flake-inputs roots are deferred -- the profile root points at a temporary
# profile use_flake deletes before returning, so that one is still created
# inline by the fallback branch below.
if declare -F use_flake >/dev/null 2>&1 && ! declare -F _sinnix_original_use_flake >/dev/null 2>&1; then
  eval "$(declare -f use_flake | sed '1s/use_flake/_sinnix_original_use_flake/')"

  declare -A _sinnix_flake_input_roots=()

  # The queue is a set, not a list: upstream names each link after its store
  # path so repeated inputs collapse, and a batched call has to dedupe
  # itself or it leaves duplicate links and duplicate gcroots/auto entries.
  _nix_add_gcroot() {
    local storepath=$1 symlink=$2
    case "$symlink" in
    */flake-inputs/*) _sinnix_flake_input_roots["$storepath"]=1 ;;
    *) _nix build --out-link "$symlink" "$storepath" ;;
    esac
  }

  _sinnix_flush_flake_input_roots() {
    [ "${#_sinnix_flake_input_roots[@]}" -gt 0 ] || return 0
    local nix_store
    nix_store="$(dirname "${_nix_direnv_nix:-$(command -v nix)}")/nix-store"
    [ -x "$nix_store" ] || nix_store="$(command -v nix-store)"
    # Falling back to the per-path loop on failure keeps the roots real: an
    # unregistered input is one `nh clean` away from being re-fetched.
    if ! "$nix_store" --add-root "$(direnv_layout_dir)/flake-inputs/input" \
      --indirect --realise "${!_sinnix_flake_input_roots[@]}" >/dev/null; then
      local root
      for root in "${!_sinnix_flake_input_roots[@]}"; do
        _nix build --out-link "$(direnv_layout_dir)/flake-inputs/${root##*/}" "$root"
      done
    fi
    _sinnix_flake_input_roots=()
  }

  use_flake() {
    # Reset per call: a repeated or nested `use flake` in the same shell
    # (direnv reload, a .envrc that calls it more than once) must not flush
    # a previous call's leftover queue against this call's layout dir.
    _sinnix_flake_input_roots=()
    _sinnix_project_environment_setup
    _sinnix_original_use_flake "$@"
    local status=$?
    _sinnix_flush_flake_input_roots
    if [ "$status" -eq 0 ]; then
      _sinnix_project_environment_setup
    fi
    return "$status"
  }
fi
