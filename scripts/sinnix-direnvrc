#!/usr/bin/env bash
# @sinnix-package: skip

# Product shells own their service, state, and database environment.
# Route compiler output for Cargo checkouts through the shared cache selector.
_sinnix_project_environment_setup() {
  [ -z "${CARGO_TARGET_DIR:-}" ] || return 0
  command -v sinnix-cargo-target >/dev/null 2>&1 || return 0
  local project_root cargo_target
  project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  [ -f "$project_root/Cargo.toml" ] || return 0
  if cargo_target="$(sinnix-cargo-target)"; then
    export CARGO_TARGET_DIR="$cargo_target"
  fi
}

# nix-direnv (3.1.2) registers a GC root for every flake input by shelling
# out to `nix build --out-link` once per input -- almost pure CLI process
# startup, and it scales with input count: on sinnix's 61-input flake this
# loop is 5-7s of the 5.5-7.1s `use flake` costs on a cache miss, against
# 0.07-0.97s for one batched `nix-store --add-root --indirect --realise`
# covering the same paths (sinnix-l9vp). Since every repo that calls
# `use flake` pays this per-input cost, the batching lives here rather than
# in each repo's .envrc: queue roots destined for `flake-inputs/` while
# upstream's use_flake runs, then register them in one call afterwards. Only
# flake-inputs roots are deferred -- the profile root points at a temporary
# profile use_flake deletes before returning, so that one is still created
# inline by the fallback branch below.
if declare -F use_flake >/dev/null 2>&1 && ! declare -F _sinnix_original_use_flake >/dev/null 2>&1; then
  eval "$(declare -f use_flake | sed '1s/use_flake/_sinnix_original_use_flake/')"

  declare -A _sinnix_flake_input_roots=()

  # The queue is a set, not a list: upstream names each link after its store
  # path so repeated inputs collapse, and a batched call has to dedupe
  # itself or it leaves duplicate links and duplicate gcroots/auto entries.
  _nix_add_gcroot() {
    local storepath=$1 symlink=$2
    case "$symlink" in
    */flake-inputs/*) _sinnix_flake_input_roots["$storepath"]=1 ;;
    *) _nix build --out-link "$symlink" "$storepath" ;;
    esac
  }

  _sinnix_flush_flake_input_roots() {
    [ "${#_sinnix_flake_input_roots[@]}" -gt 0 ] || return 0
    local nix_store
    nix_store="$(dirname "${_nix_direnv_nix:-$(command -v nix)}")/nix-store"
    [ -x "$nix_store" ] || nix_store="$(command -v nix-store)"
    # Falling back to the per-path loop on failure keeps the roots real: an
    # unregistered input is one `nh clean` away from being re-fetched.
    if ! "$nix_store" --add-root "$(direnv_layout_dir)/flake-inputs/input" \
      --indirect --realise "${!_sinnix_flake_input_roots[@]}" >/dev/null; then
      local root
      for root in "${!_sinnix_flake_input_roots[@]}"; do
        _nix build --out-link "$(direnv_layout_dir)/flake-inputs/${root##*/}" "$root"
      done
    fi
    _sinnix_flake_input_roots=()
  }

  use_flake() {
    # Reset per call: a repeated or nested `use flake` in the same shell
    # (direnv reload, a .envrc that calls it more than once) must not flush
    # a previous call's leftover queue against this call's layout dir.
    _sinnix_flake_input_roots=()
    _sinnix_project_environment_setup
    _sinnix_original_use_flake "$@"
    local status=$?
    _sinnix_flush_flake_input_roots
    if [ "$status" -eq 0 ]; then
      _sinnix_project_environment_setup
    fi
    return "$status"
  }
fi
