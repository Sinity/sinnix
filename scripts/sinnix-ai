#!/usr/bin/env bash
# @sinnix-package
# description: On-demand control plane for local AI services (list/status/start/stop/logs/pin)
# runtimeInputs: bash coreutils systemd curl gnugrep gawk gnused jq
set -euo pipefail

export LC_ALL=C

# Pin unit prefix: `sinnix-ai pin <name>` runs a transient --user unit that
# holds one open TCP connection to the service's public (proxy) port, which
# is what actually inhibits systemd-socket-proxyd's --exit-idle-time (the
# idle timer only starts once the proxy has zero active connections; it does
# not care whether traffic flows). RuntimeMaxSec on the transient unit is the
# auto-release: systemd itself kills the holder and closes the connection
# when the pin expires, no separate timer/daemon of ours required. Verified
# empirically 2026-08-13 against kokoro-proxy (30s --exit-idle-time): a held
# connection kept the backend resident past 50s, and closing it let the
# proxy tear the backend down ~20-30s later, matching --exit-idle-time.
PIN_PREFIX="sinnix-ai-pin-"
DEFAULT_PIN_DURATION="2h"

# Registry: name|unit|port|probe-path|description
# Keep in sync with modules/services/*.nix (ports are module defaults).
REGISTRY="$(cat <<'EOF'
whisper|whisper-server|8090|/|whisper.cpp STT server (CUDA, large-v3-turbo)
tts|podman-openedai-speech|8000|/v1/models|OpenedAI-Speech TTS (Piper + XTTS, container)
kokoro|podman-kokoro|8890|/health|Kokoro-82M TTS (CPU, OpenAI-compatible, container)
ollama|ollama|11434|/api/tags|Ollama LLM/VLM hub (CUDA)
litellm|litellm|4000|/health/liveliness|LiteLLM gateway (Anthropic<->OpenAI, fronts Ollama)
llama-cpp|llama-cpp|8081|/health|llama.cpp HTTP server (CUDA, GGUF)
koboldcpp|koboldcpp|5001|/api/v1/info|koboldcpp all-in-one (text/vision/SD, GGUF)
comfyui|podman-comfyui|8188|/system_stats|ComfyUI image/video generation (container)
musicgen|podman-musicgen|8010|/|MusicGen/Bark text-to-audio (container)
ocr|podman-ocr|8020|/|OCR / document understanding (marker-api, container)
open-webui|open-webui|8080|/health|Open WebUI chat frontend (fronts Ollama)
EOF
)"

usage() {
  cat <<'EOF'
usage: sinnix-ai <command> [args]

commands:
  list                 All AI services: state, port, autostart, description
  status [name]        Detail for one service (or GPU + active summary)
  start <name>...      Start service(s) (sudo systemctl start)
  stop <name>...       Stop service(s) and free VRAM
  pin <name> [dur]     Keep service resident past its idle timeout (default: 2h)
  unpin <name>         Release a pin early (idempotent; ok if not pinned)
  logs <name> [-n N]   Recent journal for a service (default 50 lines)
  gpu                  VRAM snapshot (nvidia-smi)

Services are on-demand by design: start them when needed, stop them to
reclaim VRAM. Registry lives in this script; ports are module defaults
from sinnix modules/services/*.nix.

Pinning: services fronted by an idle-aware socket proxy (see
modules/services/ai-control.nix) tear down after a short idle window
(currently 30s) once nothing is connected. `pin` holds one open
connection to the service's public port for a bounded duration so it
stays resident during a work session. Release is automatic (systemd
RuntimeMaxSec on a transient --user unit kills the holder and closes
the connection at the deadline), so a pin cannot outlive its duration
and never survives a reboot or a killed shell as orphan state. Duration
accepts bare seconds, or a number with s/m/h suffix (e.g. 30m, 2h). Services without
an idle-aware proxy (comfyui, tts, musicgen, ocr, open-webui) don't
idle-teardown in the first place, so pinning them is a no-op refused
with an explanation.
EOF
}

lookup() {
  local name="$1" line
  line=$(grep -m1 "^${name}|" <<<"$REGISTRY" || true)
  [[ -n "$line" ]] || { echo "unknown service: ${name} (see: sinnix-ai list)" >&2; exit 1; }
  IFS='|' read -r REG_NAME REG_UNIT REG_PORT REG_PROBE REG_DESC <<<"$line"
}

unit_installed() { systemctl cat "$1" >/dev/null 2>&1; }

unit_state() {
  if ! unit_installed "$1"; then echo "not-installed"; return; fi
  systemctl is-active "$1" 2>/dev/null || true
}

autostart_state() {
  local wanted
  wanted=$(systemctl show -p WantedBy --value "$1" 2>/dev/null || true)
  if [[ -n "$wanted" ]]; then echo "boot"; else echo "on-demand"; fi
}

port_alive() {
  curl -fsS -m 2 -o /dev/null "http://127.0.0.1:$1$2" 2>/dev/null && echo yes || echo no
}

has_proxy() { unit_installed "${1}-proxy.service"; }

# Prints one of: "" (not pinned/no pin unit), "unknown" (active, no parsable
# deadline), or a non-negative integer of seconds remaining. Live systemd
# state is the only source of truth -- if the transient unit isn't active,
# there is no pin, full stop; nothing here is read from a state file that
# could disagree with reality.
pin_remaining() {
  local unit="${PIN_PREFIX}${1}.service"
  systemctl --user is-active --quiet "$unit" 2>/dev/null || return 0
  local desc deadline now remaining
  desc=$(systemctl --user show -p Description --value "$unit" 2>/dev/null || true)
  deadline=$(grep -oE 'until [0-9]+' <<<"$desc" | awk '{print $2}')
  if [[ -z "$deadline" ]]; then echo "unknown"; return; fi
  now=$(date +%s)
  remaining=$(( deadline - now ))
  (( remaining < 0 )) && remaining=0
  echo "$remaining"
}

format_duration() {
  local s="$1" h m
  h=$(( s / 3600 )); m=$(( (s % 3600) / 60 )); s=$(( s % 60 ))
  if (( h > 0 )); then printf '%dh%dm' "$h" "$m"
  elif (( m > 0 )); then printf '%dm%ds' "$m" "$s"
  else printf '%ds' "$s"
  fi
}

pin_summary() {
  local remaining
  remaining=$(pin_remaining "$1")
  if [[ -z "$remaining" ]]; then echo "-"
  elif [[ "$remaining" == "unknown" ]]; then echo "pinned"
  else echo "pinned(${remaining}s)"
  fi
}

cmd_list() {
  printf '%-11s %-13s %-6s %-10s %-14s %s\n' NAME STATE PORT START PIN DESCRIPTION
  while IFS='|' read -r name unit port probe desc; do
    [[ -n "$name" ]] || continue
    local state astart="-" pin
    state=$(unit_state "$unit")
    [[ "$state" == "not-installed" ]] || astart=$(autostart_state "$unit")
    pin=$(pin_summary "$name")
    printf '%-11s %-13s %-6s %-10s %-14s %s\n' "$name" "$state" "$port" "$astart" "$pin" "$desc"
  done <<<"$REGISTRY"
}

cmd_gpu() {
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader
    nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true
  else
    echo "nvidia-smi not available" >&2
  fi
}

cmd_status() {
  if [[ $# -eq 0 ]]; then
    echo "== GPU =="; cmd_gpu; echo; echo "== active AI services =="
    cmd_list | awk 'NR==1 || $2=="active"'
    return
  fi
  lookup "$1"
  echo "service: $REG_NAME — $REG_DESC"
  echo "unit:    $REG_UNIT ($(unit_state "$REG_UNIT"), $(autostart_state "$REG_UNIT"))"
  # Probing the PUBLIC port is not a read: it is a connection to the
  # socket-activation front door, so it STARTS the backend -- and for a
  # gpu-inference member, starting it evicts whatever else was resident.
  # Observed live 2026-08-13: a bare `sinnix-ai status ollama` activated
  # ollama.service, whose Conflicts= SIGKILLed another agent's running
  # ComfyUI workload. A status command must never cost someone their
  # loaded model, so only probe a backend that is already up.
  if [[ "$(unit_state "$REG_UNIT")" == active ]]; then
    echo "port:    127.0.0.1:$REG_PORT (responding: $(port_alive "$REG_PORT" "$REG_PROBE"))"
  elif has_proxy "$REG_NAME"; then
    echo "port:    127.0.0.1:$REG_PORT (not probed — connecting would start it and evict any resident peer)"
  else
    echo "port:    127.0.0.1:$REG_PORT (not probed — backend is not running)"
  fi
  if has_proxy "$REG_NAME"; then
    local remaining
    remaining=$(pin_remaining "$REG_NAME")
    if [[ -z "$remaining" ]]; then
      echo "pin:     not pinned (idle teardown active, ${REG_NAME}-proxy.service)"
    elif [[ "$remaining" == "unknown" ]]; then
      echo "pin:     pinned (remaining time unknown)"
    else
      echo "pin:     pinned, $(format_duration "$remaining") remaining"
    fi
  else
    echo "pin:     n/a (no idle-aware proxy for this service)"
  fi
  if unit_installed "$REG_UNIT"; then
    systemctl status --no-pager -n 5 "$REG_UNIT" 2>/dev/null | sed -n '1,12p' || true
  fi
}

cmd_start() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  local name
  for name in "$@"; do
    lookup "$name"
    unit_installed "$REG_UNIT" || { echo "$name: unit $REG_UNIT not installed on this host (enable its sinnix module)" >&2; exit 1; }
    echo "starting $REG_NAME ($REG_UNIT)..."
    sudo systemctl start "$REG_UNIT"
    local i
    for i in $(seq 1 30); do
      [[ "$(port_alive "$REG_PORT" "$REG_PROBE")" == yes ]] && break
      sleep 1
    done
    echo "$REG_NAME: $(unit_state "$REG_UNIT"), port $REG_PORT responding: $(port_alive "$REG_PORT" "$REG_PROBE")"
  done
}

cmd_stop() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  local name
  for name in "$@"; do
    lookup "$name"
    echo "stopping $REG_NAME ($REG_UNIT)..."
    sudo systemctl stop "$REG_UNIT"
    echo "$REG_NAME: $(unit_state "$REG_UNIT")"
  done
}

parse_duration() {
  local input="$1"
  if [[ "$input" =~ ^([0-9]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"; return
  fi
  if [[ "$input" =~ ^([0-9]+)([smh])$ ]]; then
    case "${BASH_REMATCH[2]}" in
      s) echo "${BASH_REMATCH[1]}" ;;
      m) echo "$(( BASH_REMATCH[1] * 60 ))" ;;
      h) echo "$(( BASH_REMATCH[1] * 3600 ))" ;;
    esac
    return
  fi
  echo "invalid duration: ${input} (expected bare seconds, or Ns/Nm/Nh, e.g. 30m, 2h)" >&2
  exit 1
}

cmd_pin() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  local name="$1" duration="${2:-$DEFAULT_PIN_DURATION}"
  lookup "$name"
  has_proxy "$REG_NAME" || {
    echo "$REG_NAME has no idle-aware proxy (${REG_NAME}-proxy.service not installed) -- nothing auto-tears it down, so there is nothing to pin against" >&2
    exit 1
  }
  local seconds; seconds=$(parse_duration "$duration")
  local unit="${PIN_PREFIX}${REG_NAME}"
  local deadline=$(( $(date +%s) + seconds ))
  # Re-pinning replaces any existing pin (fresh deadline) rather than
  # stacking; --collect garbage-collects the transient unit once it stops
  # so repeated pin/unpin cycles never accumulate dead units.
  if systemctl --user is-active --quiet "${unit}.service" 2>/dev/null; then
    systemctl --user stop "${unit}.service" >/dev/null 2>&1 || true
  fi
  systemd-run --user --unit="$unit" --collect \
    --description="sinnix-ai pin ${REG_NAME} until ${deadline}" \
    --property="RuntimeMaxSec=${seconds}" \
    -- bash -c "exec 9<>/dev/tcp/127.0.0.1/${REG_PORT} || exit 1; sleep infinity" \
    >/dev/null
  echo "pinned $REG_NAME: holding a connection on port $REG_PORT for ${duration} (releases automatically; unit: ${unit}.service)"
}

cmd_unpin() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  lookup "$1"
  local unit="${PIN_PREFIX}${REG_NAME}.service"
  if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
    systemctl --user stop "$unit"
    echo "unpinned $REG_NAME (idle teardown resumes normally)"
  else
    echo "$REG_NAME was not pinned"
  fi
}

cmd_logs() {
  lookup "$1"; shift
  local n=50
  [[ "${1:-}" == "-n" ]] && n="$2"
  journalctl -u "$REG_UNIT" -n "$n" --no-pager
}

case "${1:-}" in
  list) cmd_list ;;
  status) shift; cmd_status "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  pin) shift; cmd_pin "$@" ;;
  unpin) shift; cmd_unpin "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  gpu) cmd_gpu ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
