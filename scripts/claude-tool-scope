#!/usr/bin/env bash
# @sinnix-package
# description: Run one Claude Code tool, hook or MCP command in its own scope under agenttool.slice
# runtimeInputs: coreutils systemd
#
# Claude Code's CLAUDE_CODE_SHELL_PREFIX: every Bash tool command, hook and
# stdio MCP server is launched as `claude-tool-scope '<command string>'`.
# Without this, those processes are children of the Claude process in its
# agent.slice scope and share its MemoryHigh. On 2026-09-28 a coordinator's
# subagents ran a dozen 0.5-0.9 GB verification gates at once, the slice sat
# at MemoryHigh, and the kernel throttled the Claude process itself in
# mem_cgroup_handle_over_high for hours (sinnix-6to8). A separate slice lets
# the tools throttle each other while the process supervising them stays
# responsive.
#
# Only a command started from agent.slice moves. A Claude worker inside an
# agentctl lane keeps its tools in the lane's scope, which carries the lane's
# MemoryMax and its cancellation reap.
set -uo pipefail

if [ "$#" -eq 1 ]; then
  # Claude Code hands over one command string written for the user's shell
  # (Bash tool commands source a zsh snapshot).
  cmd=("${SHELL:-/bin/sh}" -c "$1")
else
  cmd=("$@")
fi

case "$(< /proc/self/cgroup)" in
  */agent.slice/*) ;;
  *) exec "${cmd[@]}" ;;
esac

# Hooks run on every tool call and hold no meaningful memory; a scope per
# hook would only add a D-Bus round trip to each call.
case "${cmd[-1]}" in
  */dots/claude/hooks/* | polylogue-hook\ *) exec "${cmd[@]}" ;;
esac

# The scope keeps this PID, stdio and signals, so Claude's timeouts and
# kills still reach the command. Without a user manager to ask, run in place.
if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]; then
  exec systemd-run --user --scope --quiet --collect \
    --slice=agenttool.slice -- "${cmd[@]}"
fi
exec "${cmd[@]}"
