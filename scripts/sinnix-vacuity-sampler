#!/usr/bin/env python3
# @sinnix-package
# description: Sample completed agent runs for bounded vacuity judgments
# runtimeInputs: coreutils jq
# pythonPackages: @sinnix-lib
"""Enqueue and judge bounded completion-vacuity candidates."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

from sinnix_lib.ledger import append_jsonl, iter_jsonl


POLICY_VERSION = "sinnix-vacuity-sampling-v1"
DEFAULT_RATE = 0.10


def state_root() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "claude-code"


def ledger_path() -> Path:
    return state_root() / "dispatch-ledger.jsonl"


def queue_path() -> Path:
    return state_root() / "vacuity-judge-queue.jsonl"


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def read_payload() -> dict[str, Any]:
    try:
        value = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return {}
    return value if isinstance(value, dict) else {}


def existing_candidate_ids() -> set[str]:
    ids: set[str] = set()
    for path in (ledger_path(), queue_path()):
        for row in iter_jsonl(path):
            if row.get("type") == "vacuity_candidate" and row.get("candidate_id"):
                ids.add(str(row["candidate_id"]))
    return ids


def sampling_rate() -> float:
    raw = os.environ.get("SINNIX_VACUITY_SAMPLE_RATE", str(DEFAULT_RATE))
    try:
        value = float(raw)
    except ValueError:
        return DEFAULT_RATE
    return min(1.0, max(0.0, value))


def sampled(candidate_id: str, rate: float) -> bool:
    threshold = int(rate * 10_000)
    bucket = int.from_bytes(hashlib.sha256(f"{POLICY_VERSION}:{candidate_id}".encode()).digest()[:8], "big") % 10_000
    return bucket < threshold


def signals(payload: dict[str, Any]) -> list[str]:
    result: list[str] = []
    duration = payload.get("duration_ms")
    if isinstance(duration, (int, float)) and duration < 10_000:
        result.append("short_run")
    message = payload.get("last_assistant_message", payload.get("result", ""))
    if isinstance(message, str) and message and not any(token in message for token in ("/", "`", "http")):
        result.append("citation_free")
    if payload.get("status") in {"success", "completed"} or payload.get("stop_reason") == "end_turn":
        result.append("all_green")
    return result


def enqueue(payload: dict[str, Any]) -> int:
    session_id = str(payload.get("session_id") or "unknown")
    event_id = str(payload.get("event_id") or payload.get("stop_hook_id") or payload.get("transcript_path") or session_id)
    candidate_id = hashlib.sha256(f"{session_id}:{event_id}".encode()).hexdigest()[:24]
    if candidate_id in existing_candidate_ids():
        return 0
    rate = sampling_rate()
    row = {
        "type": "vacuity_candidate",
        "candidate_id": candidate_id,
        "terminal_event_id": event_id,
        "session_id": session_id,
        "timestamp": now(),
        "policy_version": POLICY_VERSION,
        "sample_rate": rate,
        "sampled": sampled(candidate_id, rate),
        "suspicious_signals": signals(payload),
        "artifact_handles": {"transcript_path": payload.get("transcript_path")},
        "status": "queued" if sampled(candidate_id, rate) else "not_sampled",
    }
    append_jsonl(queue_path(), row, fsync=True)
    append_jsonl(ledger_path(), row, fsync=True)
    return 0


def judge_once() -> int:
    pending: list[dict[str, Any]] = []
    judged_ids: set[str] = set()
    for path in (ledger_path(), queue_path()):
        for row in iter_jsonl(path):
            if row.get("type") == "vacuity_judgment":
                judged_ids.add(str(row.get("candidate_id")))
            if path == queue_path() and row.get("sampled") and row.get("status") == "queued" and row.get("candidate_id") not in judged_ids:
                pending.append(row)
    schema = Path(os.environ.get("SINNIX_VACUITY_JUDGE_SCHEMA", Path.home() / ".config/claude/agents/schemas/judge.schema.json"))
    judge = os.environ.get("SINNIX_CLAUDE_JUDGE", "sinnix-claude-judge")
    for row in pending:
        receipt_path: str | None = None
        model: Any = None
        cost: Any = None
        transcript = row.get("artifact_handles", {}).get("transcript_path")
        if not isinstance(transcript, str) or not Path(transcript).is_file():
            result = {"verdict": "unsupported", "confidence": 0.0, "evidence": ["transcript handle unavailable"], "refutation_attempted": False, "unsupported": ["missing transcript"]}
            status = "judged"
        else:
            with tempfile.TemporaryDirectory(prefix="sinnix-vacuity-") as receipt_dir:
                command = [judge, "--schema", str(schema), "--context", transcript, "--receipt-dir", receipt_dir, "--", "Assess whether this completed agent output is vacuous. Attempt one refutation and cite only supplied evidence."]
                try:
                    completed = subprocess.run(command, capture_output=True, text=True, timeout=45, check=False)
                except subprocess.TimeoutExpired:
                    completed = None
                if completed is not None:
                    match = re.search(r"receipt=(\S+)", completed.stderr)
                    receipt_path = match.group(1) if match else None
                    if receipt_path:
                        try:
                            receipt = json.loads(Path(receipt_path).read_text(encoding="utf-8"))
                            model = receipt.get("model")
                            cost = receipt.get("total_cost_usd")
                        except (OSError, json.JSONDecodeError):
                            pass
                try:
                    result = json.loads(completed.stdout.splitlines()[0]) if completed is not None else None
                    status = "judged" if completed is not None and completed.returncode == 0 else "failed"
                except (json.JSONDecodeError, IndexError, AttributeError):
                    result = {"verdict": "unsupported", "confidence": 0.0, "evidence": ["judge did not return schema-valid JSON"], "refutation_attempted": False, "unsupported": ["judge transport failure"]}
                    status = "failed"
        append_jsonl(ledger_path(), {"type": "vacuity_judgment", "candidate_id": row["candidate_id"], "session_id": row["session_id"], "timestamp": now(), "policy_version": POLICY_VERSION, "status": status, "model": model, "cost_usd": cost, "receipt_path": receipt_path, "verdict": result}, fsync=True)
        judged_ids.add(str(row["candidate_id"]))
    return 0


def report() -> int:
    rows: list[dict[str, Any]] = list(iter_jsonl(ledger_path()))
    candidates = [row for row in rows if row.get("type") == "vacuity_candidate"]
    judgments = [row for row in rows if row.get("type") == "vacuity_judgment"]
    distribution: dict[str, int] = {}
    cost = 0.0
    reviews = [row for row in rows if row.get("type") == "vacuity_review"]
    for row in judgments:
        verdict = row.get("verdict", {}).get("verdict", "unknown")
        distribution[verdict] = distribution.get(verdict, 0) + 1
        if isinstance(row.get("cost_usd"), (int, float)):
            cost += float(row["cost_usd"])
    false_positives = sum(row.get("label") == "false_positive" for row in reviews)
    print(json.dumps({"schema_version": 1, "policy_version": POLICY_VERSION, "denominator": len(candidates), "sampled": sum(bool(row.get("sampled")) for row in candidates), "judged": len(judgments), "cost_usd": cost, "verdict_distribution": distribution, "reviewed_count": len(reviews), "reviewed_false_positive_rate": (false_positives / len(reviews) if reviews else None)}, sort_keys=True))
    return 0


def review(candidate_id: str, label: str) -> int:
    if label not in {"false_positive", "confirmed"}:
        raise SystemExit("review label must be false_positive or confirmed")
    append_jsonl(ledger_path(), {"type": "vacuity_review", "candidate_id": candidate_id, "label": label, "timestamp": now(), "policy_version": POLICY_VERSION}, fsync=True)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["enqueue", "judge-once", "report", "review"])
    parser.add_argument("--candidate-id")
    parser.add_argument("--label", choices=["false_positive", "confirmed"])
    args = parser.parse_args()
    if args.command == "enqueue":
        return enqueue(read_payload())
    if args.command == "judge-once":
        return judge_once()
    if args.command == "review":
        if not args.candidate_id or not args.label:
            parser.error("review requires --candidate-id and --label")
        return review(args.candidate_id, args.label)
    return report()


if __name__ == "__main__":
    raise SystemExit(main())
