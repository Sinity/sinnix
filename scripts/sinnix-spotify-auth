#!/usr/bin/env python3
# @sinnix-package
# description: One-time interactive Spotify OAuth bootstrap -- mints the refresh token capture-spotify needs
# runtimeInputs: python3
"""Interactive Authorization Code bootstrap for the Spotify capture lane
(sinnix-0s27).

Spotify's recently-played API needs a user-authorized refresh token; that
authorization cannot be scripted headlessly (it is a click on Spotify's own
consent page), so this is the one operator-loop step the capture lane's
module header points at. Usage:

    sinnix spotify-auth

Prints an authorize URL, opens a loopback listener for the redirect, waits
up to 5 minutes for the browser round-trip, exchanges the returned code for
a refresh token, then prints the exact one-line command to store it:

    echo -n '<refresh_token>' | agenix -e secret/spotify-refresh-token.age

(run that from `nix develop`, where the `agenix` wrapper lives).

One-time prerequisite this script cannot do for the operator: Spotify
validates the redirect URI against an allowlist configured on the app's own
developer.spotify.com dashboard. Add http://127.0.0.1:8973/callback there
under "Redirect URIs" once, before the first run.
"""

from __future__ import annotations

import base64
import http.server
import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

REDIRECT_PORT = 8973
REDIRECT_URI = f"http://127.0.0.1:{REDIRECT_PORT}/callback"
AUTHORIZE_URL = "https://accounts.spotify.com/authorize"
TOKEN_URL = "https://accounts.spotify.com/api/token"
SCOPE = "user-read-recently-played"
WAIT_SECONDS = 300


def _read_secret(env_var: str, default_path: str) -> str:
    path = Path(os.environ.get(env_var, default_path))
    try:
        return path.read_text().strip()
    except OSError as exc:
        print(f"sinnix-spotify-auth: cannot read {path}: {exc}", file=sys.stderr)
        sys.exit(1)


class _CallbackServer(http.server.HTTPServer):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.result: dict[str, str] = {}


class _CallbackHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *_args) -> None:  # quiet -- the operator gets our own prints
        pass

    def do_GET(self) -> None:  # noqa: N802 (stdlib method name)
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/callback":
            self.send_response(404)
            self.end_headers()
            return
        params = urllib.parse.parse_qs(parsed.query)
        self.server.result = {k: v[0] for k, v in params.items()}  # type: ignore[attr-defined]
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(
            b"<html><body>sinnix spotify-auth: got it, you can close this tab.</body></html>"
        )


def _wait_for_callback(port: int, deadline: float) -> dict[str, str]:
    httpd = _CallbackServer(("127.0.0.1", port), _CallbackHandler)
    httpd.timeout = 1  # handle_request() re-polls at this cadence until the deadline
    try:
        while not httpd.result and time.monotonic() < deadline:
            httpd.handle_request()
    finally:
        httpd.server_close()
    return httpd.result


def main() -> int:
    # Unbuffered stdout: the authorize URL and the final refresh-token/agenix
    # command are the entire point of this script, and a block-buffered
    # stdout (the default once stdout isn't a tty -- piped through `tee`, a
    # log redirect, or an agent harness) can lose them if the process exits
    # or is interrupted before a flush happens to coincide with a full buffer.
    sys.stdout.reconfigure(line_buffering=True)

    client_id = _read_secret("SPOTIFY_CLIENT_ID_FILE", "/run/agenix/spotify-client-id")
    client_secret = _read_secret(
        "SPOTIFY_CLIENT_SECRET_FILE", "/run/agenix/spotify-client-secret"
    )

    state = secrets.token_urlsafe(16)
    params = {
        "client_id": client_id,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "scope": SCOPE,
        "state": state,
    }
    authorize_url = f"{AUTHORIZE_URL}?{urllib.parse.urlencode(params)}"

    print(f"AUTHORIZE_URL={authorize_url}")
    print(
        f"Open that URL in a browser signed into the target Spotify account and click Allow "
        f"({WAIT_SECONDS}s window)...",
        file=sys.stderr,
    )

    deadline = time.monotonic() + WAIT_SECONDS
    result = _wait_for_callback(REDIRECT_PORT, deadline)

    if not result:
        print(
            "sinnix-spotify-auth: timed out waiting for the browser callback -- rerun and "
            "click Allow within the window",
            file=sys.stderr,
        )
        return 1
    if "error" in result:
        print(
            f"sinnix-spotify-auth: Spotify returned an error: {result['error']}",
            file=sys.stderr,
        )
        return 1
    if result.get("state") != state:
        print(
            "sinnix-spotify-auth: state mismatch on callback -- aborting",
            file=sys.stderr,
        )
        return 1
    code = result.get("code")
    if not code:
        print(f"sinnix-spotify-auth: no code in callback: {result}", file=sys.stderr)
        return 1

    basic = base64.b64encode(f"{client_id}:{client_secret}".encode()).decode()
    body = urllib.parse.urlencode(
        {
            "grant_type": "authorization_code",
            "code": code,
            "redirect_uri": REDIRECT_URI,
        }
    ).encode()
    req = urllib.request.Request(
        TOKEN_URL,
        data=body,
        headers={
            "Authorization": f"Basic {basic}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        print(
            f"sinnix-spotify-auth: token exchange failed ({exc.code}): {detail}",
            file=sys.stderr,
        )
        return 1

    refresh_token = payload.get("refresh_token")
    if not refresh_token:
        print(
            f"sinnix-spotify-auth: no refresh_token in response: {payload}",
            file=sys.stderr,
        )
        return 1

    print("REFRESH_TOKEN_OK")
    print(f"REFRESH_TOKEN={refresh_token}")
    print(
        "\nStore it (run from `nix develop`, one command):\n"
        f"  echo -n '{refresh_token}' | agenix -e secret/spotify-refresh-token.age\n"
        "Then `switch` -- the next timer tick picks it up, no other config change needed."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
