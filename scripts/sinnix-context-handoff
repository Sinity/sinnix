#!/usr/bin/env bash
# @sinnix-package
# description: Write a private atomic pre-compaction handoff record
# runtimeInputs: bash coreutils git jq
#
# Input contract: the Claude Code PreCompact hook payload — session_id,
# transcript_path, cwd, trigger, custom_instructions. (Schema v1 read
# imagined `.handoff.mission`/`.handoff.task_ids` fields no harness ever
# sent, so every record was empty boilerplate; v2 records session identity
# and a transcript pointer instead. Transcript CONTENT stays excluded —
# the record may land in an arbitrary repo's .agent/scratch.)
set -euo pipefail

umask 077
input="$(cat)"
cwd="$(printf '%s' "$input" | jq -r '.cwd // .working_directory // empty')"
cwd="${cwd:-$PWD}"

repo_root=""
if [[ -d "$cwd" ]]; then
  repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -n "$repo_root" ]]; then
  target_dir="$repo_root/.agent/scratch"
  branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  dirty_paths="$(git -C "$repo_root" status --porcelain=v1 2>/dev/null | sed -E 's/^.. //')"
  worktree="$repo_root"
else
  target_dir="${CLAUDE_SCRATCH_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/claude/scratch}"
  branch=""
  dirty_paths=""
  worktree=""
fi

mkdir -p "$target_dir"
chmod 700 "$target_dir"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
final="$target_dir/compaction-$timestamp.md"
if [[ -e "$final" ]]; then
  final="$target_dir/compaction-$timestamp-$$.md"
fi
tmp="$(mktemp "$target_dir/.compaction-$timestamp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

yaml_string() {
  jq -rn --arg value "$1" '$value | @json'
}

session_id="$(printf '%s' "$input" | jq -r '.session_id // ""')"
transcript_path="$(printf '%s' "$input" | jq -r '.transcript_path // ""')"
trigger="$(printf '%s' "$input" | jq -r '.trigger // ""')"
custom_instructions="$(printf '%s' "$input" | jq -r '(.custom_instructions // "") | .[0:300]')"
source_client="$(printf '%s' "$input" | jq -r '.client // .provider // (if .hook_event_name then "claude-code" else "unknown" end)')"
created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

{
  printf '%s\n' '---'
  printf 'schema_version: 2\n'
  printf 'created_at: %s\n' "$(yaml_string "$created_at")"
  printf 'source_client: %s\n' "$(yaml_string "$source_client")"
  printf 'session_id: %s\n' "$(yaml_string "$session_id")"
  printf 'transcript_path: %s\n' "$(yaml_string "$transcript_path")"
  printf 'trigger: %s\n' "$(yaml_string "$trigger")"
  printf 'custom_instructions: %s\n' "$(yaml_string "$custom_instructions")"
  printf 'repo_root: %s\n' "$(yaml_string "$repo_root")"
  printf 'branch: %s\n' "$(yaml_string "$branch")"
  printf 'worktree: %s\n' "$(yaml_string "$worktree")"
  printf 'dirty_paths: %s\n' "$(printf '%s\n' "$dirty_paths" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  printf '%s\n' '---' '# Pre-compaction handoff' ''
  if [[ -n "$session_id" ]]; then
    printf 'Session `%s` compacted here (trigger: %s). Full resume state is the\n' "$session_id" "${trigger:-unknown}"
    printf 'transcript itself; render its prose with:\n\n'
    printf '    sinnix-claude-session prose %s\n\n' "$session_id"
  fi
  printf '%s\n' 'Transcript content and environment values are intentionally excluded.'
} >"$tmp"

chmod 600 "$tmp"
mv -f "$tmp" "$final"
trap - EXIT
printf '%s\n' "$final"
