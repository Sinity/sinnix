#!/usr/bin/env python3
# @sinnix-package
# description: Unified fuzzy picker over the reading stack, history, bookmarks, clipboard, and recent project dirs
# runtimeInputs: bash python3 noctalia kitty zoxide wl-clipboard @sinnix-browser-app @sinnix-reading-stack
# pythonPackages: @sinnix-lib
"""sinnix-picker: one fuzzy-search surface over heterogeneous "things I might
want to jump to" sources, presented by the Noctalia launcher through
`noctalia dmenu` (candidates on stdin, the chosen line on stdout, exit 1 on
cancel).

DESIGN DECISION (unified, not split): sinnix-r4u8 explicitly left the
unified-vs-split call to the builder. Chose ONE surface, category-prefixed
per line ("[hist] title -- url", "[mark] ...", "[clip] ...", "[dir] ..."),
because: (1) the operator's own framing was "convenient access" -- a single
keybind you don't have to pre-decide a category for beats remembering which
of 4 keybinds has the thing you're half-remembering; (2) fuzzel's substring
match already handles heterogeneous corpora fine at this scale (a few
thousand candidates, not the full 932k-row history -- see recency/frequency
capping below); (3) the category prefix keeps entries visually
distinguishable and *is* itself a cheap secondary filter (typing "clip "
narrows to clipboard). A split-keybind design was considered and rejected:
it front-loads a decision ("which source has this?") the operator often
can't answer before they've found the thing.

SOURCES (each optional -- a missing/unreadable source is skipped, never a
hard failure):
  - History: /realm/activity/browser/history/gestalt/derived/full_history.ndjson
    (932k+ rows spanning 2013-present) -- capped to the most-recent N by
    iso_time, deduplicated by normalized URL keeping the newest visit. Full
    history is too large to hand fuzzel wholesale; recency is the right cut
    for "convenient access" (old one-off visits are what the URL-ledger /
    lynchpin are for, not a keybind).
  - Bookmarks: raindrop processed export
    (/realm/account/raindrop/processed/bookmarks.csv) AND live Chrome
    bookmarks (~/.config/chrome-ws/Default/Bookmarks, Chrome's own JSON
    format, walked recursively for the folder tree).
  - Clipboard: capture-clipboard's own JSONL lane
    (/realm/activity/desktop/clipboard/clipboard-*.jsonl) -- text entries only
    (image/binary clipboard entries are skipped here; they have no useful
    single-line picker representation), most recent N.
  - Recent project directories: zoxide's own database (`zoxide query -l`,
    already-maintained "places of note" ranking -- reused rather than
    building a parallel file-recency tracker from scratch).

ONETAB: no export was found during the source audit; it is not implemented as a source.
This is a real gap, not an oversight; left as an explicit follow-up (the
OneTab extension's localStorage export would need to be dumped once,
manually or via a small extension-storage-reading script, before this
picker could include it).

"Recently touched files of note" beyond project directories (specific
files, not just dirs) was left out of v1 -- zoxide's directory-level
granularity is the cheap, already-available signal; a file-level tracker
would be new capture-lane work, not glue, and is flagged as a design
decision for the operator rather than built speculatively.

ACTIONS: selecting a [hist]/[mark] line opens the URL via the
browser-inversion launcher (sinnix-browser-app, --app=URL chromeless
window); [clip] copies the entry back onto the clipboard (wl-copy);
[dir] opens a new kitty terminal in that directory.
"""

from __future__ import annotations

import csv
import errno
import heapq
import io
import json
import os
import re
import stat
import subprocess
import sys
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from typing import BinaryIO

from sinnix_lib.layout import capture_lane_path

HISTORY_PATH = Path(
    "/realm/activity/browser/history/gestalt/derived/full_history.ndjson"
)
RAINDROP_CSV = Path("/realm/account/raindrop/processed/bookmarks.csv")
CHROME_BOOKMARKS = Path.home() / ".config/chrome-ws/Default/Bookmarks"
CLIPBOARD_DIR = capture_lane_path(
    Path(os.environ.get("SINNIX_ACTIVITY_ROOT", "/realm/activity")), "clipboard"
)
READING_STACK_PATH = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "sinnix/reading-stack.json"
)

HISTORY_LIMIT = 4000
RAINDROP_LIMIT = 4000
CLIPBOARD_LIMIT = 500
ZOXIDE_LIMIT = 200


@dataclass
class Entry:
    category: str
    label: str
    payload: str  # url, dir path, or clipboard text

    def display(self) -> str:
        one_line_label = self.label.replace("\t", " ").replace("\n", " ")
        if self.category in ("hist", "mark", "stack"):
            one_line_label = (
                f"{one_line_label} -- {self.payload}"
                if one_line_label and one_line_label != self.payload
                else self.payload
            )
        return f"[{self.category}] {one_line_label}"


def load_history() -> list[Entry]:
    if not HISTORY_PATH.exists():
        return []
    # Keep the newest visit per normalized URL; stream rather than sort
    # 932k rows in memory twice.
    seen: dict[str, tuple[str, str, str]] = {}
    try:
        with HISTORY_PATH.open(encoding="utf-8") as f:
            for line in f:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                norm = row.get("norm") or row.get("url")
                iso_time = row.get("iso_time", "")
                title = row.get("title") or row.get("url", "")
                url = row.get("url", "")
                if not norm or not url:
                    continue
                prior = seen.get(norm)
                if prior is None or iso_time > prior[0]:
                    seen[norm] = (iso_time, title, url)
    except OSError:
        return []
    ranked = sorted(seen.values(), key=lambda t: t[0], reverse=True)[:HISTORY_LIMIT]
    return [Entry("hist", title, url) for _, title, url in ranked]


def load_raindrop() -> list[Entry]:
    try:
        with (
            _regular_input(RAINDROP_CSV) as binary,
            io.TextIOWrapper(binary, encoding="utf-8", newline="") as source,
        ):
            candidates = (
                (
                    row.get("created") or "",
                    row.get("title") or row["url"],
                    row.get("folder") or "",
                    row["url"],
                )
                for row in csv.DictReader(source)
                if row.get("url")
            )
            rows = heapq.nlargest(RAINDROP_LIMIT, candidates, key=lambda row: row[0])
    except FileNotFoundError:
        return []
    except (OSError, UnicodeError, csv.Error) as error:
        _unavailable("bookmarks", RAINDROP_CSV, error)
        return []
    # nlargest preserves full-sort tie order while retaining only the rows
    # the menu will offer, rather than buffering the whole acquisition.
    out = []
    for _created, title, folder, url in rows:
        label = title if title != url else ""
        if folder:
            label = f"{label} ({folder})".strip()
        out.append(Entry("mark", label, url))
    return out


@contextmanager
def _regular_input(path: Path) -> Iterator[BinaryIO]:
    with open(
        path, "rb", opener=lambda name, flags: os.open(name, flags | os.O_NONBLOCK)
    ) as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise OSError(errno.EINVAL, "picker input must be a regular file", path)
        yield source


def _unavailable(source: str, path: Path, error: Exception) -> None:
    print(
        f"sinnix-picker: {source} source unavailable: {path}: {error}", file=sys.stderr
    )


def _reverse_lines(source: BinaryIO) -> Iterator[bytes]:
    """Read backwards in blocks, retaining one unfinished record.

    Chunks stay separate until a newline is found so a large record is joined
    once, without repeatedly copying its growing unfinished suffix.
    """
    position = source.seek(0, os.SEEK_END)
    suffix: list[bytes] = []
    while position:
        size = min(position, 65536)
        position -= size
        source.seek(position)
        pieces = source.read(size).split(b"\n")
        suffix.append(pieces[-1])
        if len(pieces) > 1:
            yield b"".join(reversed(suffix))
            yield from reversed(pieces[1:-1])
            suffix = [pieces[0]]
    if suffix:
        yield b"".join(reversed(suffix))


def _walk_chrome_bookmarks(node: dict, path: list[str], out: list[Entry]) -> None:
    node_type = node.get("type")
    if node_type == "url":
        url = node.get("url", "")
        name = node.get("name", url)
        if url:
            folder = "/".join(path) if path else ""
            label = name if name != url else ""
            if folder:
                label = f"{label} ({folder})".strip()
            out.append(Entry("mark", label, url))
    elif node_type == "folder":
        children = node.get("children", [])
        name = node.get("name", "")
        for child in children:
            _walk_chrome_bookmarks(child, path + ([name] if name else []), out)


def load_chrome_bookmarks() -> list[Entry]:
    if not CHROME_BOOKMARKS.exists():
        return []
    try:
        data = json.loads(CHROME_BOOKMARKS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    out: list[Entry] = []
    for root in data.get("roots", {}).values():
        if isinstance(root, dict):
            _walk_chrome_bookmarks(root, [], out)
    return out


def load_clipboard() -> list[Entry]:
    try:
        with os.scandir(CLIPBOARD_DIR) as source:
            files = sorted(
                (
                    Path(entry.path)
                    for entry in source
                    if entry.name.startswith("clipboard-")
                    and entry.name.endswith(".jsonl")
                    and entry.name != "clipboard-index.jsonl"
                ),
                reverse=True,
            )
    except FileNotFoundError:
        return []
    except OSError as error:
        _unavailable("clipboard", CLIPBOARD_DIR, error)
        return []
    out: list[Entry] = []
    for path in files:
        if len(out) >= CLIPBOARD_LIMIT:
            break
        try:
            with _regular_input(path) as source:
                for line in _reverse_lines(source):
                    try:
                        row = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if not isinstance(row, dict):
                        continue
                    payload = row.get("payload", {})
                    if (
                        not isinstance(payload, dict)
                        or payload.get("category") != "text"
                    ):
                        continue
                    text = payload.get("text", "")
                    if not isinstance(text, str) or not text.strip():
                        continue
                    snippet = re.sub(r"\s+", " ", text).strip()[:200]
                    out.append(Entry("clip", snippet, text))
                    if len(out) >= CLIPBOARD_LIMIT:
                        return out
        except (OSError, UnicodeError) as error:
            _unavailable("clipboard", path, error)
    return out


def load_recent_dirs() -> list[Entry]:
    try:
        result = subprocess.run(
            ["zoxide", "query", "-l"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if result.returncode != 0:
        return []
    dirs = [d for d in result.stdout.splitlines() if d.strip()][:ZOXIDE_LIMIT]
    return [Entry("dir", d, d) for d in dirs]


def load_reading_stack() -> list[Entry]:
    try:
        items = json.loads(READING_STACK_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    if not isinstance(items, list):
        return []
    entries = []
    for item in items:
        if not isinstance(item, dict) or not item.get("url"):
            continue
        label = item.get("title") or item["url"]
        if item.get("note"):
            label = f"{label} ({item['note']})"
        if item.get("source_title"):
            label = f"{label} <- {item['source_title']}"
        entries.append(Entry("stack", label, item["url"]))
    return entries


def gather() -> list[Entry]:
    entries: list[Entry] = []
    entries.extend(load_reading_stack())
    entries.extend(load_recent_dirs())
    entries.extend(load_clipboard())
    entries.extend(load_chrome_bookmarks())
    entries.extend(load_raindrop())
    entries.extend(load_history())
    # Sources overlap heavily. Keep the first row because source priority is
    # intentional: the live queue should win over bookmarks and history.
    unique: list[Entry] = []
    seen_urls: set[str] = set()
    for entry in entries:
        if entry.category in ("hist", "mark", "stack"):
            if entry.payload in seen_urls:
                continue
            seen_urls.add(entry.payload)
        unique.append(entry)
    return unique


def dispatch(category: str, payload: str) -> None:
    if category in ("hist", "mark"):
        subprocess.Popen(
            ["sinnix-browser-app", payload],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif category == "stack":
        subprocess.Popen(
            ["sinnix-reading-stack", "open", "--url", payload],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif category == "clip":
        proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        proc.communicate(payload.encode("utf-8"))
    elif category == "dir":
        subprocess.Popen(
            ["kitty", "--directory", payload],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def main() -> int:
    entries = gather()
    menu_lines = [f"{entry.display()}\t{index}" for index, entry in enumerate(entries)]
    menu_input = "\n".join(menu_lines)

    result = subprocess.run(
        ["noctalia", "dmenu", "-p", "> "],
        input=menu_input,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return 0  # cancelled

    try:
        selected_index = int(result.stdout.rstrip("\n").rsplit("\t", 1)[1])
        entry = entries[selected_index]
    except (IndexError, ValueError):
        return 1
    dispatch(entry.category, entry.payload)
    return 0


if __name__ == "__main__":
    sys.exit(main())
