#!/usr/bin/env bash
# @sinnix-package
# description: Skill cartography Layer 1 — mine polylogue/atuin/git evidence, synthesize a skill map via claude -p
# runtimeInputs: bash coreutils findutils gnugrep jq claude-code atuin sqlite

# sinnix-d0t Layer 1: evidence-based skill map, NOT self-report or agent
# testimony. Per the bead's own 2026-08-11 rescope: atuin/git evidence little
# object-level activity (operator directs agents, doesn't type code/commit) --
# the RICH lanes are agent-orchestration practice, architectural judgment
# (choice-points visible in polylogue dialogues), and domain knowledge from
# discussion corpora. Correction patterns ("what the operator catches agents
# on") are high-signal per the bead's own design and are mined explicitly.
#
# Same state-dump -> claude -p -> versioned-output shape as sinnix-enrich-dump
# (sinnix-jfiy.2) -- deliberately consistent with that pattern rather than
# inventing a new one.
#
# Output: /realm/data/derived/cartography/<timestamp>/{evidence-bundle.json,skill-map.json}
# Re-derivable at any time; this script never writes to polylogue's or
# sinex's stores.

set -euo pipefail

OUTPUT_ROOT="/realm/data/derived/cartography"
SINCE_DAYS="${SINNIX_CARTOGRAPHY_SINCE_DAYS:-90}"
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
RUN_DIR="$OUTPUT_ROOT/$(date -u +%Y%m%d-%H%M%S)"
mkdir -p "$RUN_DIR"

echo "sinnix-cartography: gathering evidence (last ${SINCE_DAYS}d) into $RUN_DIR" >&2

# ---------------------------------------------------------------- evidence

# 1. Correction patterns: operator messages that catch/correct an agent.
#    High-signal per the bead's own definition. Bounded window + busy_timeout
#    since index.db is a live-written sqlite the daemon may hold a WAL lock on.
CORRECTIONS_JSON="$RUN_DIR/corrections.json"
polylogue --since "${SINCE_DAYS} days ago" \
  find 'role:user AND (text:"no wait" OR text:"actually" OR text:"that.s wrong" OR text:"you are wrong" OR text:"incorrect")' \
  then read --view messages --format json --all \
  > "$CORRECTIONS_JSON" 2>"$RUN_DIR/corrections.stderr" || {
    echo '{"status":"unavailable","note":"polylogue query failed, see corrections.stderr"}' > "$CORRECTIONS_JSON"
  }

# 2. Domain/topic facets discussed (bounded window).
FACETS_JSON="$RUN_DIR/facets.json"
timeout 60 polylogue --since "${SINCE_DAYS} days ago" facets --format json \
  > "$FACETS_JSON" 2>"$RUN_DIR/facets.stderr" || {
    echo '{"status":"unavailable","note":"facets query timed out or failed, see facets.stderr"}' > "$FACETS_JSON"
  }

# 3. Atuin: tool vocabulary over time (thin evidence per rescope, still
#    gathered honestly rather than skipped).
ATUIN_JSON="$RUN_DIR/atuin-stats.json"
atuin stats "${SINCE_DAYS} days" 2>"$RUN_DIR/atuin.stderr" > "$RUN_DIR/atuin-stats.txt" || true
jq -Rn '{status:"text-only", note:"atuin stats has no --format json; raw text captured"}' > "$ATUIN_JSON"

# 4. Git: languages/repos touched across the project constellation (thin
#    evidence per rescope -- operator directs agents, rarely commits directly).
GIT_JSON="$RUN_DIR/git-activity.json"
{
  echo '['
  first=1
  for repo in /realm/project/*/; do
    [[ -d "$repo/.git" ]] || continue
    name="$(basename "$repo")"
    since_date="$(date -u -d "${SINCE_DAYS} days ago" +%Y-%m-%d 2>/dev/null || date -u -v-"${SINCE_DAYS}"d +%Y-%m-%d)"
    authored=$(git -C "$repo" log --author="Sinity" --since="$since_date" --oneline 2>/dev/null | wc -l)
    [[ "$authored" -eq 0 ]] && continue
    [[ $first -eq 1 ]] && first=0 || echo ','
    printf '{"repo":"%s","operator_authored_commits":%d}' "$name" "$authored"
  done
  echo ']'
} > "$GIT_JSON" 2>"$RUN_DIR/git.stderr" || echo '[]' > "$GIT_JSON"

# ---------------------------------------------------------------- bundle

BUNDLE="$RUN_DIR/evidence-bundle.json"
jq -n \
  --slurpfile corrections "$CORRECTIONS_JSON" \
  --slurpfile facets "$FACETS_JSON" \
  --slurpfile atuin "$ATUIN_JSON" \
  --slurpfile git_activity "$GIT_JSON" \
  --arg now "$NOW_ISO" \
  --arg since_days "$SINCE_DAYS" \
  '{
    generated_at: $now,
    window_days: ($since_days | tonumber),
    corrections: $corrections[0],
    facets: $facets[0],
    atuin: $atuin[0],
    git_activity: $git_activity[0]
  }' > "$BUNDLE"

echo "sinnix-cartography: evidence bundle written, invoking claude -p for synthesis" >&2

# ---------------------------------------------------------------- synthesis

SKILL_MAP="$RUN_DIR/skill-map.json"
claude -p --output-format json \
  "You are building Layer 1 of sinnix-d0t (skill cartography): a living, \
evidence-based model of the operator's actual knowledge/skills, NOT self-report \
or agent testimony/praise -- receiver-behavior and ground-truth evidence only. \
Read the evidence bundle at $BUNDLE (correction patterns from polylogue -- what \
the operator catches agents on is HIGH signal for real knowledge; discussed \
facets/topics; atuin/git activity, expected to be THIN since the operator \
directs agents rather than typing code directly -- treat that thinness itself \
as evidence of an agent-orchestration-heavy practice, not a gap). \
Output a JSON array of skill nodes, each: {\"skill\": name, \"taxonomy\": \
one of [languages_runtimes, systems, ml_ai_practice, math, domain_knowledge, \
meta_skills], \"confidence\": 0-1, \"evidence\": [short anchors citing what in \
the bundle supports this], \"note\": one sentence}. Per the bead's own \
rescope, expect meta_skills (agent orchestration, architectural judgment) to \
dominate with high confidence, and object-level coding fluency to show thin \
evidence -- say so explicitly rather than inflating it. Write ONLY the JSON \
array to stdout, no prose." \
  > "$RUN_DIR/claude-p-response.json" 2>"$RUN_DIR/claude-p.stderr" || {
    echo "sinnix-cartography: claude -p synthesis failed, see claude-p.stderr" >&2
    exit 1
  }

jq -r '.result // empty' "$RUN_DIR/claude-p-response.json" \
  | sed -e '/^```/d' > "$SKILL_MAP" 2>/dev/null || true
if [[ -s "$SKILL_MAP" ]] && ! jq empty "$SKILL_MAP" >/dev/null 2>&1; then
  echo "sinnix-cartography: WARNING -- skill-map.json is not valid JSON after fence-stripping, inspect claude-p-response.json" >&2
fi
if [[ ! -s "$SKILL_MAP" ]]; then
  echo "sinnix-cartography: WARNING -- could not extract skill-map.json from claude -p response, raw response preserved" >&2
fi

ln -sfn "$RUN_DIR" "$OUTPUT_ROOT/latest"
echo "sinnix-cartography: done -> $RUN_DIR" >&2
echo "$RUN_DIR"
