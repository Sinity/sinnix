#!/usr/bin/env bash
# @sinnix-package
# description: Archive all kernel audit records into the capture lake, raw plus structured JSONL
# runtimeInputs: bash coreutils gnugrep jq audit python3 systemd
set -euo pipefail
umask 077

# auditd's own log rotates and is binary-adjacent; the lake keeps it the way it
# keeps syslog. Every record since the watermark is archived verbatim, and a
# structured projection is written beside it for querying. No key filter: the
# rules decide what the kernel emits, the drain keeps all of it.

LANE="${SINNIX_AUDIT_LANE:-/realm/activity/shared/audit}"
WATERMARK="${SINNIX_AUDIT_WATERMARK:-/realm/state/cursors/audit-drain/last-run}"

mkdir -p "$LANE" "$(dirname "$WATERMARK")"

DAY="$(date -u +%Y-%m-%d)"
RAW_OUT="$LANE/audit-$DAY.log"
JSON_OUT="$LANE/audit-$DAY.jsonl"

# Only an absent cursor starts a new window. A failed or partial read must
# never reset capture to today and then advance past an unarchived backlog.
SINCE="$(python3 - "$WATERMARK" <<'PY_CURSOR'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
try:
    with path.open(encoding="ascii") as handle:
        value = handle.read(65)
except FileNotFoundError:
    if path.is_symlink():
        raise SystemExit("sinnix-audit-drain: dangling watermark link; cursor held")
    sys.exit(0)
except (OSError, UnicodeError) as error:
    raise SystemExit(f"sinnix-audit-drain: cannot read watermark; cursor held: {error}")
if re.fullmatch(r"[0-9]{1,20}\n?", value) is None:
    raise SystemExit("sinnix-audit-drain: invalid watermark; cursor held")
print(value.rstrip("\n"))
PY_CURSOR
)"
NOW_EPOCH="$(date +%s)"

if [[ -n "$SINCE" ]]; then
  # %y, NOT %Y. ausearch takes a TWO-digit year and rejects a four-digit one
  # outright ("Invalid start date (08/16/2026). Month, Day, and Year are
  # required."), exiting 1 -- the same code it uses for "nothing matched".
  # So the drain silently archived nothing for as long as a watermark had
  # existed, advancing past each unread window on every run.
  START_ARG=(-ts "$(date -d "@$SINCE" +%m/%d/%y)" "$(date -d "@$SINCE" +%H:%M:%S)")
else
  START_ARG=(-ts today)
fi

# ausearch exits 1 for "nothing matched" and >1 for a real failure, and the
# two must never collapse into each other. They used to: `|| true` with
# stderr discarded turned every failure into the empty-result path, which
# then ADVANCED THE WATERMARK past records it had not archived. On
# 2026-08-16 that reported "no new records" hourly for seven hours while
# auditd wrote 5.8 GB, and every record in those windows was permanently
# unrecoverable. On a real failure the watermark stays put and the unit goes
# red, so the next run re-reads the same window.
#
# Streamed through a temp FILE rather than a shell variable. A single
# catch-up run over a large window slurped 4.1 million records into `raw`
# and peaked at 7.4 GB RSS -- on a 32 GB host that is an OOM waiting for
# the right moment, and the whole point of this unit is to be the thing
# that still works when something else has gone wrong. The scratch file
# lives beside the watermark (NVMe), not in TMPDIR, which is a small tmpfs
# here.
scratch_dir="$(dirname "$WATERMARK")"
scratch="$(mktemp -d "$scratch_dir/drain.XXXXXX")"
trap 'rm -rf -- "$scratch"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
err_file="$scratch/stderr"
raw_file="$scratch/raw"
set +e
ausearch "${START_ARG[@]}" --format raw >"$raw_file" 2>"$err_file"
ausearch_rc=$?
set -e

# Exit status alone is not enough to tell failure from an empty window:
# ausearch reports a malformed -ts argument with exit 1, the very code it
# uses for "nothing matched". Anything on stderr therefore counts as a
# failure too -- it is silent on a genuinely empty window.
if [[ "$ausearch_rc" -gt 1 || -s "$err_file" ]]; then
  echo "sinnix-audit-drain: ausearch failed (exit $ausearch_rc); watermark held at ${SINCE:-<unset>}" >&2
  cat "$err_file" >&2
  exit 1
fi

if [[ ! -s "$raw_file" ]]; then
  echo "$NOW_EPOCH" >"$WATERMARK"
  echo "sinnix-audit-drain: no new records"
  exit 0
fi

cat "$raw_file" >>"$RAW_OUT"

# Structured projection. Every key=value on the record is preserved -- the
# point is to keep the whole record, not a chosen subset -- with the audit
# event id lifted out so records belonging to one event can be grouped.
count="$(python3 -c '
import json, re, sys, datetime

FIELD = re.compile(r"([a-zA-Z0-9_-]+)=(\"[^\"]*\"|\S+)")
HDR = re.compile(r"audit\((\d+)\.(\d+):(\d+)\):")
drained = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
n = 0
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line or line.startswith("----"):
        continue
    hdr = HDR.search(line)
    rec = {"drained_at": drained, "raw": line}
    if hdr:
        secs, msecs, serial = hdr.groups()
        rec["event_time"] = datetime.datetime.fromtimestamp(
            int(secs), datetime.timezone.utc
        ).strftime("%Y-%m-%dT%H:%M:%SZ")
        rec["event_epoch"] = float(f"{secs}.{msecs}")
        rec["event_id"] = int(serial)
    fields = {}
    for key, value in FIELD.findall(line):
        if key == "msg" and value.startswith("audit("):
            continue
        fields[key] = value[1:-1] if value.startswith("\"") else value
    rec["type"] = fields.pop("type", None)
    rec["fields"] = fields
    sys.stdout.write(json.dumps(rec, separators=(",", ":")) + "\n")
    n += 1
sys.stderr.write(str(n))
' <"$raw_file" 2>&1 >>"$JSON_OUT")" || {
  # Same rule as the ausearch guard above: a projection that died has not
  # archived the window, so the watermark must not move past it.
  echo "sinnix-audit-drain: structured projection failed; watermark held at ${SINCE:-<unset>}" >&2
  exit 1
}

echo "$NOW_EPOCH" >"$WATERMARK"
echo "sinnix-audit-drain: archived $count records to $RAW_OUT / $JSON_OUT"
