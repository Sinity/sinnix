#!/usr/bin/env bash
# @sinnix-package
# description: Serialize attestable heavyweight work with a private durable lease
# runtimeInputs: bash coreutils jq util-linux

set -euo pipefail

state_dir="${SINNIX_HEAVY_LEASE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/heavy-lease}"
wait_seconds=0
job_id="${SINNIX_JOB_ID:-}"
project="${SINNIX_PROJECT_ID:-}"
work_item="${SINNIX_WORK_ITEM:-}"

usage() {
  cat <<'EOF'
Usage:
  sinnix-heavy-lease [--state-dir <path>] [--wait-seconds <seconds>] [--job-id <uuid>] [--project <id>] [--work-item <id>] -- <command> [args...]
  sinnix-heavy-lease [--state-dir <path>] status
  sinnix-heavy-lease [--state-dir <path>] reconcile

There is deliberately no release command. The owner process holds the flock and
releases it only when its command exits or it is cancelled.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --state-dir) state_dir="${2:?--state-dir requires a value}"; shift 2 ;;
    --wait-seconds) wait_seconds="${2:?--wait-seconds requires a value}"; shift 2 ;;
    --job-id) job_id="${2:?--job-id requires a value}"; shift 2 ;;
    --project) project="${2:?--project requires a value}"; shift 2 ;;
    --work-item) work_item="${2:?--work-item requires a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

[[ "$wait_seconds" =~ ^[0-9]+$ ]] || { echo "sinnix-heavy-lease: invalid wait duration" >&2; exit 64; }
for value in "$job_id" "$project" "$work_item"; do
  [[ -z "$value" || "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$ ]] || {
    echo "sinnix-heavy-lease: invalid correlation value" >&2; exit 64;
  }
done

umask 077
mkdir -p -m 0700 "$state_dir"
chmod 0700 "$state_dir"
lock_file="$state_dir/owner.lock"
owner_file="$state_dir/owner.json"
audit_file="$state_dir/audit.jsonl"
audit_lock="$state_dir/audit.lock"
touch "$lock_file" "$audit_file" "$audit_lock"
chmod 0600 "$lock_file" "$owner_file" "$audit_file" "$audit_lock" 2>/dev/null || true

proc_start() {
  local pid="$1" stat
  [[ -r "/proc/$pid/stat" ]] || return 1
  stat="$(cat "/proc/$pid/stat")"
  printf '%s\n' "${stat##*) }" | awk '{print $20}'
}

proc_cgroup() {
  awk -F: '$1 == "0" && $2 == "" { print $3; exit }' "/proc/$1/cgroup" 2>/dev/null || true
}

append_audit() {
  local event="$1" detail="${2:-}" now entry
  [[ -n "$detail" ]] || detail='{}'
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  entry="$(jq -cn --arg schema "sinnix-heavy-lease-v1" --arg at "$now" --arg event "$event" --arg job_id "$job_id" --arg project "$project" --arg work_item "$work_item" --argjson detail "$detail" '{schema:$schema,at:$at,event:$event,job_id:(if $job_id=="" then null else $job_id end),project:(if $project=="" then null else $project end),work_item:(if $work_item=="" then null else $work_item end),detail:$detail}')"
  flock -x "$audit_lock" bash -c 'printf "%s\\n" "$1" >> "$2"' _ "$entry" "$audit_file"
  chmod 0600 "$audit_file"
}

owner_alive() {
  local pid start cgroup
  [[ -r "$owner_file" ]] || return 1
  pid="$(jq -r '.owner.pid // empty' "$owner_file" 2>/dev/null || true)"
  start="$(jq -r '.owner.proc_start // empty' "$owner_file" 2>/dev/null || true)"
  cgroup="$(jq -r '.owner.cgroup // empty' "$owner_file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ && -n "$start" && -n "$cgroup" ]] || return 1
  kill -0 "$pid" 2>/dev/null && [[ "$(proc_start "$pid" 2>/dev/null || true)" == "$start" ]] && [[ "$(proc_cgroup "$pid")" == "$cgroup" ]]
}

read_owner() {
  if [[ -r "$owner_file" ]] && jq -e . "$owner_file" >/dev/null 2>&1; then
    jq -c . "$owner_file"
  else
    printf '%s\n' '{"state":"absent_or_malformed"}'
  fi
}

command="${1:-}"
if [[ "$command" == status ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 64; }
  jq -cn --arg schema sinnix-heavy-lease-v1 --argjson owner "$(read_owner)" --arg audit "$audit_file" '{schema:$schema,owner:$owner,audit:$audit}'
  exit 0
fi

if [[ "$command" == reconcile ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 64; }
  exec 9>"$lock_file"
  if ! flock -n 9; then
    jq -cn --arg schema sinnix-heavy-lease-v1 --argjson owner "$(read_owner)" '{schema:$schema,reconciled:false,reason:"owner_lock_held",owner:$owner}'
    exit 0
  fi
  if [[ -e "$owner_file" ]] && ! owner_alive; then
    stale="$(read_owner)"
    rm -f "$owner_file"
    append_audit reconciled "$stale"
    jq -cn --arg schema sinnix-heavy-lease-v1 --argjson owner "$stale" '{schema:$schema,reconciled:true,owner:$owner}'
  else
    jq -cn --arg schema sinnix-heavy-lease-v1 '{schema:$schema,reconciled:false,reason:"no_stale_owner"}'
  fi
  exit 0
fi

[[ "$command" == -- && $# -ge 2 ]] || { usage >&2; exit 64; }
shift

# A token is created only after the parent owns the flock. Nested heavy
# wrappers inherit it and never contend with their own ancestor.
if [[ -n "${SINNIX_HEAVY_LEASE_TOKEN:-}" && -r "$owner_file" ]] && jq -e --arg token "$SINNIX_HEAVY_LEASE_TOKEN" '.token == $token' "$owner_file" >/dev/null 2>&1; then
  append_audit nested
  exec "$@"
fi

exec 9>"$lock_file"
deadline=$((SECONDS + wait_seconds))
while ! flock -n 9; do
  if (( SECONDS >= deadline )); then
    append_audit contention "$(read_owner)"
    echo "sinnix-heavy-lease: heavyweight lease is held: $(read_owner)" >&2
    exit 75
  fi
  sleep 0.05
done

if [[ -e "$owner_file" ]] && ! owner_alive; then
  stale="$(read_owner)"
  rm -f "$owner_file"
  append_audit reconciled "$stale"
fi

token="$(uuidgen | tr '[:upper:]' '[:lower:]')"
invocation="$(printf '%q ' "$@" | sha256sum | awk '{print $1}')"
pid="$BASHPID"
start="$(proc_start "$pid")"
cgroup="$(proc_cgroup "$pid")"
tmp="$(mktemp "$owner_file.tmp.XXXXXX")"
jq -n --arg schema sinnix-heavy-lease-v1 --arg token "$token" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg job_id "$job_id" --arg project "$project" --arg work_item "$work_item" --arg invocation "$invocation" --arg pid "$pid" --arg start "$start" --arg cgroup "$cgroup" '{schema:$schema,token:$token,acquired_at:$at,job_id:(if $job_id=="" then null else $job_id end),project:(if $project=="" then null else $project end),work_item:(if $work_item=="" then null else $work_item end),invocation_sha256:$invocation,owner:{pid:($pid|tonumber),proc_start:$start,cgroup:$cgroup}}' >"$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$owner_file"
append_audit acquired

child_pid=""
cleanup() {
  local status=$?
  if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
    kill -TERM -- "-$child_pid" 2>/dev/null || kill -TERM "$child_pid" 2>/dev/null || true
    for _ in {1..50}; do
      kill -0 "$child_pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$child_pid" 2>/dev/null; then
      kill -KILL -- "-$child_pid" 2>/dev/null || kill -KILL "$child_pid" 2>/dev/null || true
    fi
    wait "$child_pid" 2>/dev/null || true
  fi
  if jq -e --arg token "$token" '.token == $token' "$owner_file" >/dev/null 2>&1; then
    rm -f "$owner_file"
    append_audit released "$(jq -cn --argjson status "$status" '{exit_status:$status}')"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP QUIT
env SINNIX_HEAVY_LEASE_TOKEN="$token" SINNIX_JOB_ID="$job_id" SINNIX_PROJECT_ID="$project" SINNIX_WORK_ITEM="$work_item" setsid --wait "$@" &
child_pid=$!
wait "$child_pid"
