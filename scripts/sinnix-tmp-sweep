#!/usr/bin/env bash
# @sinnix-package
# description: Remove unheld nix-shell.* scratch directories from TMPDIR and /tmp
# runtimeInputs: bash coreutils psmisc

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: sinnix-tmp-sweep [--dry-run]

Remove `nix-shell.*` scratch directories that no live process holds, from
$TMPDIR and from /tmp. Every `nix develop` invocation creates one such
directory as the devshell's TMPDIR and removes it only on a clean exit; a
killed shell leaks it, so the population is bounded by cleanup, not by age.

A directory is held when a live process has it (or anything beneath it) as
cwd, root, executable, an open descriptor, or the value of TMPDIR / TMP /
TEMP / NIX_BUILD_TOP in its environment. Environment ownership is the case
`fuser` cannot see: an idle devshell whose shell sits in another cwd still
owns its scratch tree.

Only directories owned by the invoking user are considered; anything else is
counted as skipped.
EOF
}

dry_run=0
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --dry-run)
    dry_run=1
    ;;
  "") ;;
  *)
    usage
    exit 64
    ;;
esac

roots=()
add_root() {
  local candidate=$1 existing
  [ -n "$candidate" ] || return 0
  [ -d "$candidate" ] || return 0
  for existing in ${roots[@]+"${roots[@]}"}; do
    [ "$existing" = "$candidate" ] && return 0
  done
  roots+=("$candidate")
}
add_root "${TMPDIR:-}"
add_root /tmp

# Candidates first, then the /proc scan: a directory created after this
# listing is never a deletion candidate, which is what keeps a devshell that
# starts mid-sweep safe.
candidates=()
declare -A skipped=()
for root in "${roots[@]}"; do
  skipped["$root"]=0
  for dir in "$root"/nix-shell.*; do
    [ -d "$dir" ] || continue
    if [ ! -O "$dir" ]; then
      skipped["$root"]=$((skipped["$root"] + 1))
      continue
    fi
    candidates+=("$dir")
  done
done

declare -A held=()
mark() {
  local path=$1 root rest
  case $path in
    /*) ;;
    *) return 0 ;;
  esac
  for root in "${roots[@]}"; do
    case $path in
      "$root"/nix-shell.*)
        rest=${path#"$root"/}
        held["$root/${rest%%/*}"]=1
        return 0
        ;;
    esac
  done
}

scan_proc() {
  local proc link fd
  for proc in /proc/[0-9]*; do
    for link in cwd root exe; do
      mark "$(readlink "$proc/$link" 2>/dev/null || true)"
    done
    for fd in "$proc"/fd/*; do
      mark "$(readlink "$fd" 2>/dev/null || true)"
    done
    # Unreadable environ (another user's process) simply contributes nothing;
    # such a process cannot hold a directory this sweep is allowed to remove.
    while IFS= read -r entry; do
      case $entry in
        TMPDIR=* | TMP=* | TEMP=* | NIX_BUILD_TOP=*) mark "${entry#*=}" ;;
      esac
    done < <({ tr '\0' '\n' <"$proc/environ"; } 2>/dev/null || true)
  done
}

if [ ${#candidates[@]} -gt 0 ]; then
  scan_proc
fi

declare -A removed=() kept=()
for root in "${roots[@]}"; do
  removed["$root"]=0
  kept["$root"]=0
done

for dir in ${candidates[@]+"${candidates[@]}"}; do
  root=${dir%/nix-shell.*}
  if [ -n "${held[$dir]:-}" ] || fuser -s "$dir" 2>/dev/null; then
    kept["$root"]=$((kept["$root"] + 1))
    continue
  fi
  if [ "$dry_run" -eq 1 ]; then
    printf 'sinnix-tmp-sweep: would remove %s\n' "$dir"
  else
    rm -rf --one-file-system -- "$dir" || continue
  fi
  removed["$root"]=$((removed["$root"] + 1))
done

for root in "${roots[@]}"; do
  printf 'sinnix-tmp-sweep: root=%s removed=%d held=%d skipped=%d\n' \
    "$root" "${removed[$root]}" "${kept[$root]}" "${skipped[$root]}"
done
