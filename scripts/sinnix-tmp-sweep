#!/usr/bin/env python3
# @sinnix-package
# description: Remove unheld nix-shell.* scratch directories from TMPDIR and /tmp
# runtimeInputs: coreutils
"""Reclaim leaked devshell scratch trees.

Every `nix develop` creates a `nix-shell.*` directory as the devshell's
TMPDIR and removes it only on a clean exit, so a killed shell leaks one. The
population is bounded by cleanup, not by age: the criterion here is solely
whether a live process holds the tree.

A directory is held when a process has it, or anything beneath it, as cwd,
root, executable, an open descriptor, or the value of TMPDIR / TMP / TEMP /
NIX_BUILD_TOP in its environment. Environment ownership is the case an
open-file probe cannot see: an idle devshell whose shell sits in another cwd
still owns its scratch tree.

/proc is walked exactly once, after the candidate list is taken. Once, because
a probe repeated per candidate rescans every process on the host and turns a
few thousand directories into minutes of CPU. After, because a directory
created later is then not a candidate at all, which is what keeps a devshell
starting mid-sweep safe.
"""

from __future__ import annotations

import os
import shutil
import sys

HOLDER_VARS = (b"TMPDIR=", b"TMP=", b"TEMP=", b"NIX_BUILD_TOP=")
PREFIX = "nix-shell."

USAGE = """usage: sinnix-tmp-sweep [--dry-run]

Remove `nix-shell.*` scratch directories that no live process holds, from
$TMPDIR and from /tmp. Only directories owned by the invoking user are
considered; anything else is counted as skipped.
"""


def roots() -> list[str]:
    found: list[str] = []
    for candidate in (os.environ.get("TMPDIR"), "/tmp"):
        if not candidate:
            continue
        try:
            resolved = os.path.realpath(candidate)
        except OSError:
            continue
        if os.path.isdir(resolved) and resolved not in found:
            found.append(resolved)
    return found


def collect_candidates(root: str, uid: int) -> tuple[list[str], int]:
    """Owned `nix-shell.*` directories directly under root, plus a skip count."""
    candidates: list[str] = []
    skipped = 0
    try:
        entries = list(os.scandir(root))
    except OSError:
        return candidates, skipped
    for entry in entries:
        if not entry.name.startswith(PREFIX):
            continue
        try:
            if not entry.is_dir(follow_symlinks=False):
                continue
            if entry.stat(follow_symlinks=False).st_uid != uid:
                skipped += 1
                continue
        except OSError:
            continue
        candidates.append(entry.path)
    return candidates, skipped


def held_directories(candidates: set[str], root_list: list[str]) -> set[str]:
    """One /proc walk; every path seen is reduced to the candidate containing it."""
    held: set[str] = set()

    def claim(path: str) -> None:
        for root in root_list:
            if not path.startswith(root + "/"):
                continue
            segment = path[len(root) + 1 :].partition("/")[0]
            owner = root + "/" + segment
            if owner in candidates:
                held.add(owner)
            return

    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        proc = "/proc/" + pid
        for link in ("cwd", "root", "exe"):
            try:
                claim(os.readlink(proc + "/" + link))
            except OSError:
                pass
        try:
            fds = os.listdir(proc + "/fd")
        except OSError:
            fds = []
        for fd in fds:
            try:
                claim(os.readlink(proc + "/fd/" + fd))
            except OSError:
                pass
        # An unreadable environ (another user's process) contributes nothing;
        # such a process cannot hold a directory this sweep may remove.
        try:
            with open(proc + "/environ", "rb") as handle:
                blob = handle.read()
        except OSError:
            continue
        for item in blob.split(b"\0"):
            if item.startswith(HOLDER_VARS):
                value = item.partition(b"=")[2]
                try:
                    claim(os.fsdecode(value))
                except (UnicodeDecodeError, ValueError):
                    pass
        if held == candidates:
            break

    return held


def main(argv: list[str]) -> int:
    dry_run = False
    if len(argv) > 1:
        if argv[1] in ("-h", "--help"):
            sys.stdout.write(USAGE)
            return 0
        if argv[1] == "--dry-run":
            dry_run = True
        else:
            sys.stderr.write(USAGE)
            return 64

    uid = os.getuid()
    root_list = roots()

    candidates: dict[str, list[str]] = {}
    skipped: dict[str, int] = {}
    for root in root_list:
        candidates[root], skipped[root] = collect_candidates(root, uid)

    every = {path for paths in candidates.values() for path in paths}
    held = held_directories(every, root_list) if every else set()

    for root in root_list:
        removed = 0
        kept = 0
        for path in candidates[root]:
            if path in held:
                kept += 1
                continue
            if dry_run:
                print(f"sinnix-tmp-sweep: would remove {path}")
            else:
                errors: list[BaseException] = []
                shutil.rmtree(path, onerror=lambda _f, _p, info: errors.append(info[1]))
                if errors:
                    print(
                        f"sinnix-tmp-sweep: could not remove {path}: {errors[0]}",
                        file=sys.stderr,
                    )
                    continue
            removed += 1
        print(
            f"sinnix-tmp-sweep: root={root} removed={removed} "
            f"held={kept} skipped={skipped[root]}"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
