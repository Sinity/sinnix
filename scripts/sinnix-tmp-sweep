#!/usr/bin/env python3
# @sinnix-package
# description: Reclaim abandoned scratch with process and Git custody checks
# runtimeInputs: coreutils git openssh pueue util-linux
# pythonPackages: @sinnix-lib
"""Reclaim leaked devshell and PID-qualified producer scratch trees.

Nix creates `nix-shell.*` and `nix-develop-*` directories. Some `nix develop`
paths leave them behind even on normal exit. The sweeper removes owned,
unheld trees, with a short age floor for `nix-develop-*` to avoid racing a
new shell.

A directory is held when a process has it, or anything beneath it, as cwd,
root, executable, an open descriptor, or the value of TMPDIR / TMP / TEMP /
NIX_BUILD_TOP in its environment. Environment ownership is the case an
open-file probe cannot see: an idle devshell whose shell sits in another cwd
still owns its scratch tree. Environment paths are resolved through symlinks,
and relative values are interpreted against the owning process's cwd.

/proc is walked exactly once, after the candidate list is taken. Once, because
a probe repeated per candidate rescans every process on the host and turns a
few thousand directories into minutes of CPU. After, because a directory
created later is then not a candidate at all, which is what keeps a devshell
starting mid-sweep safe.
"""

from __future__ import annotations

import errno
import json
import os
import pwd
import re
import shlex
import subprocess
import stat
import sys
import time

from sinnix_lib.procfs import held_paths

HOLDER_VARS = (b"TMPDIR=", b"TMP=", b"TEMP=", b"NIX_BUILD_TOP=", b"AGENTCTL_SCRATCH=")
PREFIXES = ("nix-shell.", "nix-develop-")
DEVELOP_MIN_AGE_SECONDS = 10 * 60
MANAGED_ROOT = "/realm/tmp/work"
STALE_SECONDS = 7 * 86400
DELETE_LIMIT = 20000
DELETE_SECONDS = 45

OWNED_MIN_AGE_SECONDS = 24 * 60 * 60
# These producers allocate a private directory with their actual shell PID.
# Historical names without a PID remain outside this ownership contract.
OWNED_SCRATCH = re.compile(
    r"sinnix-(?:chatgpt-(?:native|download)|router-poll)\.([1-9][0-9]*)\.[A-Za-z0-9]{6}\Z"
)

USAGE = """usage: sinnix-tmp-sweep [--dry-run] [--owner USER]

Remove recognized scratch directories that no live process holds, from
$TMPDIR and from /tmp. Only directories owned by the selected owner (by
default, the invoking user) are considered; anything else is counted as skipped.
A privileged scheduled scan
uses --owner, then irreversibly drops to that user before deletion. Incomplete
process visibility refuses deletion. PID-qualified ChatGPT and router scratch
must also be at least 24 hours old and its allocating process must be dead.
Dry-run also proposes old entries under /realm/tmp/work and its codex/
children for owner classification: no file modified in seven days, no holders,
no active queue lane, and no dirty or unpublished Git work. Real runs keep
these unclassified entries. claude-* is always retained.
Dry-run reports candidates and logical bytes. Real runs use idle I/O
and remove at most 20000 entries over 45 seconds, pacing each unlink.
"""


class VisibilityError(RuntimeError):
    """A holder observation is unavailable, rather than absent."""


def vanished_entry(error: OSError, path: str) -> None:
    if error.errno not in (errno.ENOENT, errno.ESRCH):
        raise VisibilityError(f"cannot inspect {path}: {error.strerror}") from error


def drop_privileges(uid: int, owner: pwd.struct_passwd | None) -> None:
    if os.geteuid() == 0:
        if owner is None or uid == 0:
            raise PermissionError("deletion requires an explicit non-root owner")
        os.initgroups(owner.pw_name, owner.pw_gid)
        os.setresgid(owner.pw_gid, owner.pw_gid, owner.pw_gid)
        os.setresuid(uid, uid, uid)
    if uid == 0 or os.getresuid() != (uid, uid, uid):
        raise PermissionError("could not irreversibly drop to the directory owner")


def directory_identity(value: os.stat_result) -> tuple[int, int, int]:
    return value.st_dev, value.st_ino, value.st_uid


def roots() -> list[str]:
    found: list[str] = []
    for candidate in (os.environ.get("TMPDIR"), "/tmp"):
        if not candidate:
            continue
        try:
            resolved = os.path.realpath(candidate)
        except OSError:
            continue
        if os.path.isdir(resolved) and resolved not in found:
            found.append(resolved)
    return found


def owned_scratch_ready(name: str, modified: float) -> bool:
    """An explicit allocator PID must be absent, even after the holder scan."""
    owned = OWNED_SCRATCH.fullmatch(name)
    if owned is None:
        return True  # Nix scratch has its existing holder-based policy.
    if time.time() - modified < OWNED_MIN_AGE_SECONDS:
        return False
    try:
        os.stat("/proc/" + owned[1])
    except FileNotFoundError:
        return True
    return False  # Includes PID reuse; permission errors propagate.


def collect_candidates(root: str, uid: int) -> tuple[dict[str, tuple[int, int, int]], int]:
    """Recognized owned scratch directly under root, plus a skip count."""
    candidates: dict[str, tuple[int, int, int]] = {}
    skipped = 0
    try:
        entries = list(os.scandir(root))
    except OSError as error:
        vanished_entry(error, root)
        return candidates, skipped
    now = time.time()
    for entry in entries:
        owned = OWNED_SCRATCH.fullmatch(entry.name)
        if not entry.name.startswith(PREFIXES) and owned is None:
            continue
        try:
            if not entry.is_dir(follow_symlinks=False):
                continue
            observed = entry.stat(follow_symlinks=False)
            if observed.st_uid != uid:
                skipped += 1
                continue
            if not owned_scratch_ready(entry.name, observed.st_mtime):
                continue
            if entry.name.startswith("nix-develop-") and now - observed.st_mtime < DEVELOP_MIN_AGE_SECONDS:
                continue
        except OSError as error:
            vanished_entry(error, entry.path)
            continue
        candidates[entry.path] = directory_identity(observed)
    return candidates, skipped


def managed_candidates(root: str, uid: int) -> dict[str, tuple[int, int, int]]:
    """Only the declared managed root has the general seven-day policy."""
    result = {}
    if root != MANAGED_ROOT:
        return result
    for base in (root, root + "/codex"):
        if os.path.islink(base) or not os.path.isdir(base):
            continue
        for entry in os.scandir(base):
            if entry.name.startswith("claude-") or entry.path == root + "/codex":
                continue
            # A young devshell rejected by its owner must not fall back to
            # file aging when its inputs were copied with old timestamps.
            if (base == root and entry.is_dir(follow_symlinks=False)
                    and (entry.name.startswith(PREFIXES) or OWNED_SCRATCH.fullmatch(entry.name))):
                continue
            observed = entry.stat(follow_symlinks=False)
            if observed.st_uid == uid and not stat.S_ISLNK(observed.st_mode):
                result[entry.path] = directory_identity(observed)
    return result


def git_custody(checkout: str) -> None:
    """Cached remote branches must cover every local ref and detached HEAD."""
    # Each discovered checkout owns its Git context, regardless of the caller.
    environment = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    environment.update(
        GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", GIT_NO_LAZY_FETCH="1",
        GIT_ASKPASS="false", SSH_ASKPASS_REQUIRE="never",
        GIT_SSH_COMMAND="ssh -oBatchMode=yes -oConnectTimeout=10",
    )

    def git(*args: str) -> str:
        return subprocess.check_output(
            ["git", "-C", checkout, "-c", "core.fsmonitor=false", *args],
            text=True, stderr=subprocess.PIPE, timeout=15, env=environment,
        ).strip()

    if os.path.realpath(git("rev-parse", "--show-toplevel")) != os.path.realpath(checkout):
        raise VisibilityError("Git checkout root differs from the discovered tree")
    lock = os.path.join(checkout, git("rev-parse", "--git-path", "index.lock"))
    if os.path.lexists(lock):
        raise VisibilityError("Git index lock may hold unfinished work")
    if git("status", "--porcelain=v1", "--untracked-files=all", "--ignored"):
        raise VisibilityError("Git has working changes, untracked or ignored files")
    if git("rev-parse", "--is-shallow-repository") != "false":
        raise VisibilityError("shallow Git history")
    if not git("for-each-ref", "--format=%(refname)", "refs/remotes"):
        raise VisibilityError("Git has no cached remote branches")
    if git("rev-list", "--max-count=1", "HEAD", "--branches", "--tags",
           "--not", "--remotes"):
        raise VisibilityError("Git commits absent from cached remote branches")
    # Include stash, recovery refs and reflog-only commits, not only HEAD.
    if git("rev-list", "--max-count=1", "--all", "--reflog", "--not", "--remotes"):
        raise VisibilityError("Git refs absent from cached remote branches")
    # A stale remote-tracking ref can outlive a force-push or branch deletion.
    # Only advertised heads which match cached objects prove remote custody.
    remotes = git("remote").splitlines()
    if not remotes:
        raise VisibilityError("Git has no configured remote to verify custody")
    advertised = set()
    for remote in remotes:
        for line in git("ls-remote", "--heads", "--", remote).splitlines():
            fields = line.split()
            if len(fields) != 2 or not fields[1].startswith("refs/heads/"):
                raise VisibilityError("unrecognized remote branch advertisement")
            advertised.add(fields[0])
    cached = set(git("for-each-ref", "--format=%(objectname)", "refs/remotes").splitlines())
    confirmed = sorted(cached & advertised)
    if not confirmed:
        raise VisibilityError("cached Git tips do not match current remote heads")
    if git("rev-list", "--max-count=1", "HEAD", "--all", "--reflog", "--not", *confirmed):
        raise VisibilityError("Git work is not covered by verified current remote heads")
    # Unreferenced commits and staged blobs can survive only in the object
    # database, outside every ref and reflog. Never discard that custody.
    if git("fsck", "--unreachable", "--no-progress"):
        raise VisibilityError("unreachable Git objects may contain unpublished work")




def mount_points() -> set[str]:
    """Mount aliases can expose non-scratch data on the same device."""
    with open("/proc/self/mountinfo") as source:
        return {
            re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), line.split()[4])
            for line in source
        }


def inspect_tree(path: str, uid: int, aged: bool, mounts: set[str] | None = None) -> tuple[int, int, bool]:
    """No symlink following or cross-device traversal; any uncertainty retains."""
    mounts = mount_points() if mounts is None else mounts
    if any(
        m == path or m.startswith(path + "/")
        or (m.startswith(MANAGED_ROOT + "/") and path.startswith(m + "/"))
        for m in mounts
    ):
        raise VisibilityError("tree contains a mount point")
    root_stat = os.lstat(path)
    cutoff = time.time() - STALE_SECONDS
    size = 0
    count = 0
    has_git = False
    pending = [path]
    while pending:
        current = pending.pop()
        observed = os.lstat(current)
        count += 1
        if observed.st_uid != uid or observed.st_dev != root_stat.st_dev:
            raise VisibilityError("foreign owner or nested filesystem")
        if stat.S_ISDIR(observed.st_mode):
            entries = list(os.scandir(current))
            if not entries and aged and observed.st_mtime > cutoff:
                raise VisibilityError("recent empty directory")
            names = {entry.name for entry in entries}
            if (current == path or os.path.basename(current) != ".git") and {"HEAD", "objects", "refs"} <= names:
                raise VisibilityError("bare Git repository requires owner reconciliation")
            for entry in entries:
                if entry.name.startswith("claude-"):
                    raise VisibilityError("contains protected claude-* tree")
                if entry.name == ".git":
                    has_git = True
                    git_custody(current)
                pending.append(entry.path)
        else:
            if aged and observed.st_mtime > cutoff:
                raise VisibilityError("file modified within seven days")
            if stat.S_ISREG(observed.st_mode):
                size += observed.st_size
            elif not stat.S_ISLNK(observed.st_mode):
                raise VisibilityError("special file")
    return size, count, has_git



def queue_path_values(value: object) -> list[str]:
    """Keep typed argv paths intact, including spaces and symlink spellings."""
    if isinstance(value, dict):
        return [p for v in value.values() for p in queue_path_values(v)]
    if isinstance(value, list):
        return [p for v in value for p in queue_path_values(v)]
    if not isinstance(value, str) or MANAGED_ROOT + "/" not in value:
        return []
    paths = []
    if value.startswith(MANAGED_ROOT + "/"):
        paths.append(os.path.realpath(value))
    lexer = shlex.shlex(value, posix=True, punctuation_chars=";&|()<>")
    lexer.whitespace_split = True
    for word in lexer:
        path = word if word.startswith(MANAGED_ROOT + "/") else word.partition("=")[2]
        if path.startswith(MANAGED_ROOT + "/"):
            paths.append(os.path.realpath(path))
        elif word != value and MANAGED_ROOT + "/" in word:
            paths.extend(queue_path_values(word))
    return [p for p in paths if p != MANAGED_ROOT]


def active_queue_paths() -> list[str]:
    """Read the owner's pueue state, including AgentCTL launch arguments."""
    state = json.loads(subprocess.check_output(
        ["pueue", "status", "--json"], text=True, stderr=subprocess.PIPE, timeout=15,
    ))
    paths = []
    for task in state["tasks"].values():
        status = task["status"]
        # Queued and paused tasks also keep custody of their scratch arguments.
        if status == "Done" or isinstance(status, dict) and "Done" in status:
            continue
        paths.extend(queue_path_values(task))
        command = shlex.split(task["command"])
        if command and os.path.basename(command[0]) == "agentctl-run":
            if len(command) != 2:
                raise VisibilityError("unrecognized AgentCTL launch command")
            with open(command[1]) as source:
                paths.extend(queue_path_values(json.load(source)))
    return paths


def queue_holds(path: str, paths: list[str]) -> bool:
    return any(p == path or p.startswith(path + "/") or path.startswith(p.rstrip("/") + "/")
               for p in paths)


def paced_remove(path: str, budget: list[int], deadline: float) -> bool:
    """fd-relative traversal prevents following substituted directory symlinks."""
    if not os.path.isdir(path):
        if budget[0] <= 0 or time.monotonic() >= deadline:
            return False
        os.unlink(path)
        budget[0] -= 1
        time.sleep(0.001)
        return True
    for _, dirs, files, fd in os.fwalk(path, topdown=False, follow_symlinks=False):
        for name in files + dirs:
            if budget[0] <= 0 or time.monotonic() >= deadline:
                return False
            observed = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(observed.st_mode):
                os.rmdir(name, dir_fd=fd)
            else:
                os.unlink(name, dir_fd=fd)
            budget[0] -= 1
            time.sleep(0.001)
    if budget[0] <= 0 or time.monotonic() >= deadline:
        return False
    os.rmdir(path)
    budget[0] -= 1
    return True


def held_directories(candidates: set[str], root_list: list[str]) -> set[str]:
    """One /proc walk; every path seen is reduced to the candidate containing it."""
    held: set[str] = set()

    def claim(path: str) -> None:
        # Probe ancestors in O(path depth), independent of candidate count.
        owner = path
        while owner and owner != "/":
            if owner in candidates:
                held.add(owner)
            owner = os.path.dirname(owner)

    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        proc = "/proc/" + pid
        try:
            for kind, path in held_paths(proc, environment=HOLDER_VARS):
                if kind == "env":
                    if not path or path in root_list:
                        continue
                    # The process, not the sweeper, owns a relative spelling.
                    # realpath must resolve symlinks before consuming '..'.
                    if not os.path.isabs(path):
                        path = os.path.join(proc, "cwd", path)
                    try:
                        path = os.path.realpath(path, strict=os.path.ALLOW_MISSING)
                    except ValueError:
                        continue
                claim(path)
            # A mapping can keep a file live after its descriptor is closed.
            try:
                with open(proc + "/maps") as mappings:
                    for line in mappings:
                        fields = line.split(maxsplit=5)
                        if len(fields) == 6 and fields[5].startswith("/"):
                            claim(fields[5].rstrip())
            except OSError as error:
                vanished_entry(error, proc + "/maps")
        except OSError as error:
            # Missing process records are normal churn. Denied reads are unknown.
            where = error.filename or proc
            raise VisibilityError(f"cannot inspect {where}: {error.strerror}") from error
        if held == candidates:
            break

    return held


def main(argv: list[str]) -> int:
    dry_run = False
    owner = None
    uid = os.getuid()
    args = iter(argv[1:])
    for arg in args:
        if arg in ("-h", "--help"):
            sys.stdout.write(USAGE)
            return 0
        if arg == "--dry-run":
            dry_run = True
        elif arg == "--owner" and owner is None:
            name = next(args, None)
            try:
                owner = pwd.getpwnam(name) if name else None
            except KeyError:
                owner = None
            if owner is None:
                sys.stderr.write("sinnix-tmp-sweep: unknown or missing owner\n")
                return 64
            uid = owner.pw_uid
        else:
            sys.stderr.write(USAGE)
            return 64
    if uid == 0:
        sys.stderr.write("sinnix-tmp-sweep: select a non-root directory owner with --owner\n")
        return 64
    if os.geteuid() != 0 and uid != os.getuid():
        sys.stderr.write("sinnix-tmp-sweep: cannot select another user's directories\n")
        return 1
    root_list = roots()

    general: set[str] = set()
    candidates: dict[str, dict[str, tuple[int, int, int]]] = {}
    skipped: dict[str, int] = {}
    try:
        for root in root_list:
            candidates[root], skipped[root] = collect_candidates(root, uid)
            extra = managed_candidates(root, uid) if dry_run else {}
            general.update(set(extra) - set(candidates[root]))
            candidates[root].update(extra)
        every = {path for paths in candidates.values() for path in paths}
        held = held_directories(every, root_list) if every else set()
        # Scanning may require root; removal never does. This must precede
        # every mutation, including a run with no recognized holders.
        mounts = mount_points()
        drop_privileges(uid, owner)
        if owner:
            os.environ.update(HOME=owner.pw_dir, XDG_RUNTIME_DIR=f"/run/user/{uid}",
                              XDG_CONFIG_HOME=owner.pw_dir + "/.config")
        queue_paths: list[str] = []
        queue_unknown = False
        if general:
            try:
                queue_paths = active_queue_paths()
            except (OSError, ValueError, KeyError, subprocess.SubprocessError, VisibilityError) as error:
                queue_unknown = True
                print(f"sinnix-tmp-sweep: retaining managed scratch: queue unavailable: {error}")
        if not dry_run:
            subprocess.run(["ionice", "-c", "3", "-p", str(os.getpid())], check=True)
    except (OSError, VisibilityError, subprocess.SubprocessError) as error:
        print(f"sinnix-tmp-sweep: retaining candidates: {error}", file=sys.stderr)
        return 1

    failed = False
    total_count = total_bytes = 0
    budget = [DELETE_LIMIT]
    deadline = None
    for root in root_list:
        removed = 0
        kept = 0
        for path in candidates[root]:
            if not dry_run and (budget[0] <= 0 or deadline is not None and time.monotonic() >= deadline):
                print("sinnix-tmp-sweep: deletion budget reached; remaining candidates deferred")
                break
            if (path in held or queue_holds(path, queue_paths)
                    or queue_unknown and path in general):
                kept += 1
                continue
            try:
                observed = os.stat(path, follow_symlinks=False)
                if (stat.S_ISLNK(observed.st_mode) or observed.st_uid != uid
                        or directory_identity(observed) != candidates[root][path]):
                    skipped[root] += 1
                    continue
            except FileNotFoundError:
                skipped[root] += 1
                continue
            except OSError as error:
                print(f"sinnix-tmp-sweep: could not recheck {path}: {error}", file=sys.stderr)
                failed = True
                continue
            try:
                if not owned_scratch_ready(os.path.basename(path), observed.st_mtime):
                    kept += 1
                    continue
            except OSError as error:
                print(f"sinnix-tmp-sweep: could not recheck owner of {path}: {error}", file=sys.stderr)
                failed = True
                continue
            try:
                size, entries, has_git = inspect_tree(path, uid, path in general, mounts)
                if directory_identity(os.lstat(path)) != candidates[root][path]:
                    skipped[root] += 1
                    continue
            except (OSError, VisibilityError, subprocess.SubprocessError) as error:
                kept += 1
                print(f"sinnix-tmp-sweep: retain {path}: {error}")
                continue
            total_count += 1
            total_bytes += size
            if dry_run:
                action = "proposal requiring owner classification" if path in general else "would remove"
                print(f"sinnix-tmp-sweep: {action} {path} bytes={size} GB={size / 1e9:.6f}")
            else:
                if deadline is None:
                    deadline = time.monotonic() + DELETE_SECONDS
                # Do not leave a partly deleted checkout looking like new WIP.
                if has_git and (entries > budget[0] or entries * 0.001 > deadline - time.monotonic()):
                    print(f"sinnix-tmp-sweep: defer {path}: Git tree exceeds remaining deletion budget")
                    continue
                try:
                    if not paced_remove(path, budget, deadline):
                        print(f"sinnix-tmp-sweep: deferred remainder {path}: deletion budget")
                        continue
                except OSError as error:
                    failed = True
                    print(f"sinnix-tmp-sweep: could not remove {path}: {error}", file=sys.stderr)
                    continue
            removed += 1
        print(
            f"sinnix-tmp-sweep: root={root} removed={removed} "
            f"held={kept} skipped={skipped[root]}"
        )
    print(f"sinnix-tmp-sweep: reviewed={total_count} bytes={total_bytes} GB={total_bytes / 1e9:.6f}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
