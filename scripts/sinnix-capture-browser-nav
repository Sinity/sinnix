#!/usr/bin/env python3
# @sinnix-package
# description: Local HTTP receiver for browser provenance and reading-stack pushes
# runtimeInputs: @sinnix-capture @sinnix-reading-stack
# pythonPackages: @sinnix-lib
"""sinnix-capture-browser-nav: the local endpoint the nav-capture WebExtension
POSTs to. Three routes:

  POST /v1/link-event         -- {source_url, source_title, target_url,
                                   anchor_text, ts, trigger} -- every link
                                   click, any trigger type. Written to the
                                   "browser-nav-edges" capture lane via
                                   sinnix-capture write. This is the origin-
                                   chain graph: "how did I get to page X" is
                                   answerable later by walking edges backward
                                   from target_url. The extension queues the
                                   click before navigation and retries with its
                                   original capture_id and observation time until
                                   the receiver confirms the write.

  POST /v1/history-visit      -- {profile, url, visit}. Stores a Chrome
                                   history.getVisits reply in its own lane.
                                   The API visit time fixes its day file and
                                   the capture ID fixes the original reply.

  POST /v1/reading-stack/push -- {source_url, source_title, target_url,
                                   target_title, anchor_text, note, ts}.
                                   Delegates to `sinnix-reading-stack push`,
                                   which owns bounded working state.

Binds the configured loopback port only (never 0.0.0.0) -- this is a same-machine
extension<->daemon channel, not a network service. Port chosen to sit next
to Polylogue's web reader (127.0.0.1:8765) without
colliding.

Host must identify the loopback listener. Browser Origin must match the
installed extension identity from SINNIX_NAV_CAPTURE_EXTENSION_ID_FILE; native
JSON clients without browser metadata remain supported. CORS grants only that
extension. These checks protect against remote pages, not other local users.

Uses http.server and the shared Sinnix request framing parser. Capture and
reading-state mutations run through their owning commands; this daemon does
no analysis, it is a thin relay.
"""

from __future__ import annotations

import json
import math
import os
import re
import subprocess
import sys
from hashlib import sha256
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from sinnix_lib.http import read_body

CAPTURE_ROOT = os.environ.get("SINNIX_CAPTURE_ROOT", "/realm/activity")
BIND_HOST = "127.0.0.1"
BIND_PORT = int(os.environ.get("SINNIX_NAV_CAPTURE_PORT", "8767"))


def extension_origin() -> str | None:
    source = os.environ.get("SINNIX_NAV_CAPTURE_EXTENSION_ID_FILE")
    if not source:
        return None
    identity = Path(source).read_text().strip()
    if not re.fullmatch(r"[a-p]{32}", identity):
        raise ValueError("invalid nav-capture extension identity")
    return f"chrome-extension://{identity}"


def sinnix_capture_write(
    lane: str, payload: dict, *, observed_at: float | None = None
) -> None:
    retry_args = (
        [] if observed_at is None else ["--write-once", "--ts", str(observed_at)]
    )
    subprocess.run(
        [
            "sinnix-capture",
            "write",
            "--capture-root",
            CAPTURE_ROOT,
            "--lane",
            lane,
            *retry_args,
        ],
        input=json.dumps(payload),
        text=True,
        check=True,
        capture_output=True,
    )


def reading_stack_push(payload: dict) -> None:
    fields = {"url": payload.get("target_url", "")}
    for key, field in (
        ("title", "target_title"),
        ("source_url", "source_url"),
        ("source_title", "source_title"),
        ("anchor_text", "anchor_text"),
        ("note", "note"),
    ):
        value = payload.get(field)
        if value:
            fields[key] = value
    subprocess.run(
        ["sinnix-reading-stack", "push", "--json-stdin"],
        input=json.dumps(fields), text=True, check=True, capture_output=True,
    )


def history_visit(payload: dict) -> tuple[dict, float]:
    profile, url, visit = (payload.get(key) for key in ("profile", "url", "visit"))
    if not isinstance(profile, str) or not re.fullmatch(r"[0-9a-f]{32}", profile):
        raise ValueError("invalid browser profile installation")
    if not isinstance(url, str) or not url or not isinstance(visit, dict):
        raise ValueError("visit needs an API record and URL")
    for key, pattern in (
        ("id", r"[1-9][0-9]*"),
        ("visitId", r"[1-9][0-9]*"),
        ("referringVisitId", r"0|[1-9][0-9]*"),
    ):
        value = visit.get(key)
        if not isinstance(value, str) or not re.fullmatch(pattern, value):
            raise ValueError(f"invalid Chrome visit {key}")
    visited_ms = visit.get("visitTime")
    if type(visited_ms) not in (int, float) or not 0 <= visited_ms < 253402300800000:
        raise ValueError("invalid visit time")
    transition = visit.get("transition")
    if (
        not isinstance(transition, str)
        or not transition
        or type(visit.get("isLocal")) is not bool
    ):
        raise ValueError("invalid visit transition or locality")
    identity = [profile, visit["id"], visit["visitId"], float(visited_ms), url]
    return (
        {
            "capture_id": sha256(json.dumps(identity).encode()).hexdigest(),
            "source": "chrome.history.getVisits",
            "profile": profile,
            "url": url,
            "visit": visit,
        },
        visited_ms / 1000,
    )


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:  # quiet by default
        pass

    def _read_json(self) -> dict:
        # Preserve empty-body semantics; the shared reader validates framing
        # and completes short reads before anything reaches a capture writer.
        raw = read_body(
            self.headers, self.rfile, max_bytes=sys.maxsize,
            require_content_length=False,
        )
        payload = json.loads(raw or b"{}")
        if not isinstance(payload, dict):
            raise ValueError("request body must be a JSON object")
        return payload

    def _allowed(self) -> bool:
        hosts = self.headers.get_all("Host", [])
        port = self.server.server_port
        allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
        if port == 80:
            allowed_hosts.update({"127.0.0.1", "localhost"})
        if len(hosts) != 1 or hosts[0] not in allowed_hosts:
            return False
        origins = self.headers.get_all("Origin", [])
        sites = self.headers.get_all("Sec-Fetch-Site", [])
        if len(origins) > 1 or len(sites) > 1:
            return False
        if origins:
            return origins[0] == self.server.extension_origin
        return not sites or sites[0] in {"none", "same-origin"}

    def _refuse(self, status: int) -> None:
        self.close_connection = True
        self._respond(status)

    def _respond(self, status: int) -> None:
        self.send_response(status)
        self.send_header("Content-Length", "0")
        self.send_header("Vary", "Origin")
        origin = self.headers.get("Origin")
        if origin and origin == self.server.extension_origin:
            self.send_header("Access-Control-Allow-Origin", origin)
            if self.command == "OPTIONS" and status == 204:
                self.send_header("Access-Control-Allow-Methods", "POST")
                self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_OPTIONS(self) -> None:  # CORS preflight from the extension
        if not self._allowed():
            self._refuse(403)
            return
        methods = self.headers.get_all("Access-Control-Request-Method", [])
        headers = self.headers.get_all("Access-Control-Request-Headers", [])
        if methods != ["POST"] or len(headers) > 1 or any(
            field.strip().lower() != "content-type"
            for value in headers for field in value.split(",")
        ):
            self._refuse(403)
            return
        self._respond(204)

    def do_POST(self) -> None:
        if not self._allowed():
            self._refuse(403)
            return
        if self.path == "/v1/history-visit" and (
            self.server.extension_origin is None
            or self.headers.get("Origin") != self.server.extension_origin
        ):
            self._refuse(403)
            return
        types = self.headers.get_all("Content-Type", [])
        if len(types) != 1 or types[0].split(";", 1)[0].strip().lower() != "application/json":
            self._refuse(415)
            return
        try:
            payload = self._read_json()
        except ValueError:
            self._respond(400)
            return

        try:
            if self.path == "/v1/link-event":
                if "capture_id" not in payload:
                    sinnix_capture_write("browser-nav-edges", payload)
                else:
                    try:
                        capture_id = payload["capture_id"]
                        observed_at = payload.get("ts")
                        if not isinstance(capture_id, str) or not re.fullmatch(
                            r"[0-9a-f]{32}", capture_id
                        ):
                            raise ValueError("invalid capture_id")
                        if type(observed_at) not in (int, float) or not math.isfinite(
                            observed_at
                        ):
                            raise ValueError("invalid observation time")
                    except (ValueError, OverflowError):
                        self._respond(400)
                        return
                    sinnix_capture_write(
                        "browser-nav-edges", payload, observed_at=observed_at
                    )
            elif self.path == "/v1/history-visit":
                try:
                    record, visited_at = history_visit(payload)
                except ValueError:
                    self._respond(400)
                    return
                sinnix_capture_write(
                    "chromium-history-api", record, observed_at=visited_at
                )
            elif self.path == "/v1/reading-stack/push":
                reading_stack_push(payload)
            else:
                self._respond(404)
                return
            self._respond(204)
        except subprocess.CalledProcessError as exc:
            print(f"sinnix-capture-browser-nav: write failed: {exc.stderr!r}", file=sys.stderr)
            self._respond(500)


def main() -> int:
    origin = extension_origin()
    server = ThreadingHTTPServer((BIND_HOST, BIND_PORT), Handler)
    server.extension_origin = origin
    print(f"sinnix-capture-browser-nav: listening on {BIND_HOST}:{BIND_PORT}", file=sys.stderr)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
