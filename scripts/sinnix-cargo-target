#!/usr/bin/env bash
# @sinnix-package
# description: Select, and release with its checkout, an isolated compiler target in the provisioned Realm cache subvolume
# runtimeInputs: bash coreutils findutils gawk git gnused util-linux
set -euo pipefail

# Cargo aliases and external commands can compile. Skip preparation only for
# known introspection commands; arguments are Cargo's own argv, never a parent
# process command line.
cargo_needs_target() {
  local arg
  for arg in "$@"; do
    case "$arg" in
    --) break ;;
    --target-dir | --target-dir=*) return 1 ;;
    esac
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
    +* | -v | -vv | -vvv | --verbose | -q | --quiet | --locked | --offline | --frozen) shift ;;
    --color | --config | -C | -Z)
      [ "$#" -ge 2 ] || return 0
      shift 2
      ;;
    --color=* | --config=* | -C?* | -Z?*) shift ;;
    --help | -h | --version | -V | --list | help | version | metadata | locate-project | read-manifest | pkgid | tree | verify-project) return 1 ;;
    *) return 0 ;;
    esac
  done
  return 1
}

usage() {
  echo "usage: sinnix-cargo-target [--select-only | --cargo ARGS... | --release CHECKOUT... | --release-orphans]" >&2
  exit 2
}

cache_root="${SINNIX_CARGO_CACHE_ROOT:-/realm/state/cache/cargo}"
hash_of() { printf '%s' "$1" | sha256sum | cut -c1-32; }

# A target belongs to its checkout and goes when the checkout goes. Each entry
# is <cache>/<uid>/<hash of the checkout path>/{target,checkout}; the
# `checkout` marker names the path. An entry whose marker is missing, a link,
# or names a path with another hash is not ours to judge and stays.
entry_checkout() {
  local entry="$1" name checkout
  name="$(basename "$entry")"
  name="${name#.evicting.}"
  [[ "$name" =~ ^[0-9a-f]{32}$ ]] || return 1
  [ -f "$entry/checkout" ] && [ ! -L "$entry/checkout" ] || return 1
  checkout="$(head -n 1 "$entry/checkout")"
  [[ "$checkout" = /* ]] || return 1
  [ "$(hash_of "$checkout")" = "$name" ] || return 1
  printf '%s\n' "$checkout"
}

# Remove one entry while none of its Cargo build locks is held. The entry is
# renamed under the primary lock first, so a build that starts afterwards
# selects a fresh target instead of writing into one being deleted; an
# interrupted removal leaves the `.evicting.` name, which the same checks
# release later.
release_entry() {
  local entry="$1" checkout="$2" lock trash name
  while IFS= read -r lock; do
    if ! flock --nonblock "$lock" true; then
      echo "sinnix-cargo-target: a build holds the target of $checkout; kept" >&2
      return 1
    fi
  done < <(find "$entry/target" -maxdepth 3 -name .cargo-lock 2>/dev/null)
  name="$(basename "$entry")"
  trash="$(dirname "$entry")/.evicting.${name#.evicting.}"
  lock="$entry/target/debug/.cargo-lock"
  if [ "$entry" != "$trash" ]; then
    if [ -e "$lock" ]; then
      flock --nonblock "$lock" mv -T -- "$entry" "$trash" || return 1
    else
      mv -T -- "$entry" "$trash"
    fi
  fi
  rm -rf -- "$trash"
  echo "sinnix-cargo-target: released the target of removed checkout $checkout"
}

# Source left without Git metadata, or a dangling symlink, still counts as the
# checkout: only a path that is gone has released its build output.
checkout_gone() { [ ! -e "$1" ] && [ ! -L "$1" ]; }

release() {
  local dir checkout entry name status=0
  dir="$cache_root/$(id -u)"
  for checkout in "$@"; do
    [[ "$checkout" = /* ]] || {
      echo "sinnix-cargo-target: not an absolute path: $checkout" >&2
      status=1
      continue
    }
    checkout="${checkout%/}"
    if ! checkout_gone "$checkout"; then
      echo "sinnix-cargo-target: $checkout still exists; its target stays" >&2
      status=1
      continue
    fi
    name="$(hash_of "$checkout")"
    for entry in "$dir/$name" "$dir/.evicting.$name"; do
      [ -d "$entry" ] && [ ! -L "$entry" ] || continue
      [ "$(entry_checkout "$entry" || true)" = "$checkout" ] || continue
      release_entry "$entry" "$checkout" || status=1
    done
  done
  return "$status"
}

# Targets whose checkout was removed by something other than `wt remove` (a
# bare `git worktree remove`, `rm -rf`): released whenever a new target is
# made, so the cache never holds more than the live checkouts plus whatever a
# running build still locks.
release_orphans() {
  local dir entry checkout
  dir="$cache_root/$(id -u)"
  [ -d "$dir" ] || return 0
  for entry in "$dir"/*/ "$dir"/.evicting.*/; do
    [ -d "$entry" ] || continue
    entry="${entry%/}"
    checkout="$(entry_checkout "$entry")" || continue
    checkout_gone "$checkout" || continue
    release_entry "$entry" "$checkout" || true
  done
}

populate=1
case "${1:-}" in
--select-only)
  [ "$#" -eq 1 ] || usage
  populate=0
  ;;
--cargo)
  shift
  if ! cargo_needs_target "$@"; then populate=0; fi
  ;;
--release)
  shift
  [ "$#" -ge 1 ] || usage
  release "$@"
  exit
  ;;
--release-orphans)
  [ "$#" -eq 1 ] || usage
  release_orphans
  exit 0
  ;;
"") ;;
*) usage ;;
esac

if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  printf '%s\n' "$CARGO_TARGET_DIR"
  exit 0
fi

# Btrfs subvolume roots have inode 256. `subvolume show` also searches trees
# that require privileges unavailable to the developer process.
if [ -L "$cache_root" ] || [ ! -d "$cache_root" ] ||
  [ "$(stat -f -c %T "$cache_root")" != btrfs ] ||
  [ "$(stat -c %i "$cache_root")" != 256 ]; then
  echo "Cargo cache subvolume is not provisioned: $cache_root" >&2
  exit 1
fi
target_of() {
  printf '%s/%s/%s/target' "$cache_root" "$(id -u)" "$(hash_of "$1")"
}

checkout="$(git rev-parse --show-toplevel)"
checkout="$(realpath "$checkout")"
# Different checkouts keep independent writable targets, even on one branch.
target="$(target_of "$checkout")"
if [ "$populate" -eq 0 ]; then
  printf '%s\n' "$target"
  exit 0
fi
new_target=0
[ -d "$target" ] || new_target=1
mkdir -p "$target"

# Artifact filenames are not content hashes: two builds can use the same
# filename while their metadata requires different dependency builds. Seed an
# empty target from one idle source only, then leave it entirely to Cargo.
# All source profiles are locked together, and every output is copied before
# any fingerprint. Path packages remain local to this checkout.
seed_target() {
  local seed="$1" paths="$2"
  flock --nonblock "$target/.sinnix-seed.lock" \
    bash -euo pipefail -c '
      seed="$1" dest="$2" paths="$3"
      shopt -s nullglob
      profiles=()
      for fingerprints in "$seed"/*/.fingerprint "$seed"/*/*/.fingerprint; do
        [ -d "$fingerprints" ] || continue
        profile="${fingerprints#"$seed/"}"
        profile="${profile%/.fingerprint}"
        mkdir -p "$dest/$profile"
        exec {lock}>"$seed/$profile/.cargo-lock"
        flock --nonblock "$lock" || exit 1
        exec {lock}>"$dest/$profile/.cargo-lock"
        flock --nonblock "$lock" || exit 1
        profiles+=("$profile")
      done
      [ "${#profiles[@]}" -ne 0 ] || exit 1
      [ -z "$(find "$dest" -type f ! -name .cargo-lock ! -name CACHEDIR.TAG \
        ! -name .sinnix-seed.lock -print -quit)" ] || exit 1
      work="$(mktemp -d)"
      trap '\''rm -rf -- "$work"'\'' EXIT
      : >"$work/outputs"
      : >"$work/fingerprints"
      for profile in "${profiles[@]}"; do
        cd "$seed/$profile"
        ls -1 -f .fingerprint | awk -v paths="$paths" '\''
          BEGIN { n = split(paths, p, "\n"); for (i = 1; i <= n; i++) path[p[i]] = 1 }
          /^.+-[0-9a-f]{16}$/ { if (!(substr($0, 1, length($0) - 17) in path)) print }
        '\'' >"$work/units"
        {
          [ ! -d build ] || ls -1 -f build \
            | awk '\''NR == FNR { u[$0] = 1; next } $0 in u { print "build/" $0 }'\'' "$work/units" -
          [ ! -d deps ] || ls -1 -f deps | awk '\''
            NR == FNR { sub(/^.*-/, ""); h[$0] = 1; next }
            match($0, /-[0-9a-f]{16}(\.|$)/) {
              if (substr($0, RSTART + 1, 16) in h) print "deps/" $0
            }'\'' "$work/units" -
        } | sed "s|^|$profile/|" >>"$work/outputs"
        sed "s|^|$profile/.fingerprint/|" "$work/units" >>"$work/fingerprints"
      done
      [ -s "$work/outputs" ] || exit 1
      cd "$seed"
      for list in outputs fingerprints; do
        tr "\n" "\0" <"$work/$list" \
          | xargs -0 -r cp -a --parents --reflink=always --update=none --target-directory="$dest/" --
      done
      wc -l <"$work/fingerprints"
    ' bash "$seed" "$target" "$paths"
}

path_packages() {
  local lock
  for lock in "$@"; do
    [ -f "$lock" ] || continue
    awk '
      /^\[\[package\]\]/ { if (name != "" && !source) print name; name = ""; source = 0 }
      /^name = / { name = $3; gsub(/"/, "", name) }
      /^source = / { source = 1 }
      END { if (name != "" && !source) print name }
    ' "$lock"
  done | sort -u
}

if [ -f "$checkout/Cargo.lock" ] &&
  [ -z "$(find "$target" -type f ! -name .cargo-lock ! -name CACHEDIR.TAG \
    ! -name .sinnix-seed.lock -print -quit)" ]; then
  sources=()
  recent=()
  while IFS= read -r other; do
    [ -d "$other" ] || continue
    other="$(realpath "$other")"
    [ "$other" != "$checkout" ] || continue
    [ -d "$(target_of "$other")/debug" ] || continue
    recent+=("$(stat -c %Y "$(target_of "$other")/debug") $other")
  done < <(git worktree list --porcelain | sed -n 's/^worktree //p')
  while IFS= read -r line; do [ -n "$line" ] && sources+=("$line"); done \
    < <([ "${#recent[@]}" -eq 0 ] || printf '%s\n' "${recent[@]}" | sort -rn | head -n 3 | cut -d' ' -f2-)

  for source in ${sources[@]+"${sources[@]}"}; do
    seed="$(target_of "$source")"
    [ "$seed" != "$target" ] || continue
    paths="$(path_packages "$checkout/Cargo.lock" "$source/Cargo.lock")"
    if count="$(seed_target "$seed" "$paths" 2>/dev/null)"; then
      echo "sinnix-cargo-target: seeded $count units into $target from $source" >&2
      break
    fi
  done
fi

# Release reads the checkout from this marker; `agentctl worktree build-output`
# reads its mtime as the last selection. Rewriting it keeps both current.
printf '%s\n' "$checkout" >"$(dirname "$target")/checkout"
# Cargo tags only a target directory it creates itself, and this one exists
# before Cargo runs. Worktree cleanup retires only a tagged target.
if [ ! -e "$target/CACHEDIR.TAG" ]; then
  printf '%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' \
    '# A Cargo target selected by sinnix-cargo-target.' \
    '# For information about cache directory tags see https://bford.info/cachedir/' \
    >"$target/CACHEDIR.TAG"
fi
if [ "$new_target" -eq 1 ]; then
  # Detached at idle priority: the build that asked for a target never waits
  # on deleting another checkout's.
  setsid -f ionice -c 3 "$(realpath "${BASH_SOURCE[0]}")" --release-orphans \
    >/dev/null 2>&1 </dev/null || true
fi
printf '%s\n' "$target"
