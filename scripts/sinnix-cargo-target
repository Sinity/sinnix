#!/usr/bin/env bash
# @sinnix-package
# description: Select an isolated compiler target in the provisioned Realm cache subvolume
# runtimeInputs: bash coreutils findutils git util-linux
set -euo pipefail

if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  printf '%s\n' "$CARGO_TARGET_DIR"
  exit 0
fi

cache_root="${SINNIX_CARGO_CACHE_ROOT:-/realm/state/cache/cargo}"
# Btrfs subvolume roots have inode 256. `subvolume show` also searches trees
# that require privileges unavailable to the developer process.
if [ -L "$cache_root" ] || [ ! -d "$cache_root" ] \
  || [ "$(stat -f -c %T "$cache_root")" != btrfs ] \
  || [ "$(stat -c %i "$cache_root")" != 256 ]; then
  echo "Cargo cache subvolume is not provisioned: $cache_root" >&2
  exit 1
fi
target_of() {
  printf '%s/%s/%s/target' "$cache_root" "$(id -u)" \
    "$(printf '%s' "$1" | sha256sum | cut -c1-32)"
}

checkout="$(git rev-parse --show-toplevel)"
checkout="$(realpath "$checkout")"
# Different checkouts keep independent writable targets, even on one branch.
target="$(target_of "$checkout")"

# A new target starts as a copy of the repository's master-baseline target
# (`sinnix.baselineCheckout`, set by sinnix-master-baseline). Reflinks share
# the extents, and Cargo reuses dependency artifacts across checkout paths.
# Cargo's build lock on the source is held for the copy, so no build writes
# it meanwhile. Seeding is optional: a busy baseline or unavailable reflinks
# leaves an empty independent target, without delaying shell entry or fmt.
seed_checkout="$(git config --get sinnix.baselineCheckout || true)"
if [ ! -e "$target" ] && [ -n "$seed_checkout" ] && [ -d "$seed_checkout" ]; then
  seed="$(target_of "$(realpath "$seed_checkout")")"
  if [ "$seed" != "$target" ] && [ -d "$seed/debug" ]; then
    mkdir -p "$(dirname "$target")"
    staging="$(mktemp -d "$target.seed.XXXXXX")"
    trap 'rm -rf -- "$staging"' EXIT
    # Walk under the source lock. Prune before copying so disabled incremental
    # state and Cargo test scratch never create destination inodes. rustc's probe cache belongs to
    # the source checkout/toolchain and is cheap to regenerate.
    if flock --nonblock "$seed/debug/.cargo-lock" bash -euo pipefail -c '
      cd "$1"
      prune=( -path "./tmp" -o -path "./.rustc_info.json" )
      if [ "$3" = 0 ]; then
        prune+=( -o -type d -regex "./[^/]+(/[^/]+)?/incremental" )
      fi
      find . -regextype posix-extended \( "${prune[@]}" \) -prune -o \
        \( ! -type d -o -empty \) -exec cp -a --parents --reflink=always --target-directory="$2/" -- {} +
    ' bash "$seed" "$staging" "${CARGO_INCREMENTAL:-0}" 2>/dev/null \
      && mv -T "$staging" "$target" 2>/dev/null; then
      echo "sinnix-cargo-target: seeded $target from $seed_checkout" >&2
    fi
  fi
fi
mkdir -p "$target"
# Cargo tags only a target directory it creates itself, and this one exists
# before Cargo runs. Worktree cleanup retires only a tagged target.
if [ ! -e "$target/CACHEDIR.TAG" ]; then
  printf '%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' \
    '# A Cargo target selected by sinnix-cargo-target.' \
    '# For information about cache directory tags see https://bford.info/cachedir/' \
    >"$target/CACHEDIR.TAG"
fi
printf '%s\n' "$target"
