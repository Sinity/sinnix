#!/usr/bin/env bash
# @sinnix-package
# description: Select an isolated compiler target in the provisioned Realm cache subvolume
# runtimeInputs: bash coreutils git
set -euo pipefail

if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  printf '%s\n' "$CARGO_TARGET_DIR"
  exit 0
fi

cache_root="${SINNIX_CARGO_CACHE_ROOT:-/realm/state/cache/cargo}"
# Btrfs subvolume roots have inode 256. `subvolume show` also searches trees
# that require privileges unavailable to the developer process.
if [ -L "$cache_root" ] || [ ! -d "$cache_root" ] \
  || [ "$(stat -f -c %T "$cache_root")" != btrfs ] \
  || [ "$(stat -c %i "$cache_root")" != 256 ]; then
  echo "Cargo cache subvolume is not provisioned: $cache_root" >&2
  exit 1
fi
checkout="$(git rev-parse --show-toplevel)"
checkout="$(realpath "$checkout")"
# Different checkouts keep independent writable targets, even on one branch.
key="$(printf '%s' "$checkout" | sha256sum | cut -c1-32)"
target="$cache_root/$(id -u)/$key/target"
mkdir -p "$target"
printf '%s\n' "$target"
