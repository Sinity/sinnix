#!/usr/bin/env python3
# @sinnix-package
# description: Build a no-loss index for canonical boot-metric captures
# runtimeInputs: coreutils
# pythonPackages: @sinnix-lib
"""Build derived indexes for /realm/data/machine/syslog.

The index is not a summary replacement. It records where raw boot-metric files
live, with enough metadata to navigate them quickly. Raw logs remain canonical
and are never modified by this command.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import os
from pathlib import Path
from typing import Any

from sinnix_lib.atomic_json import write_json_atomic
from sinnix_lib.ledger import write_jsonl_atomic

SCHEMA = "sinnix-syslog-index-v1"
DEFAULT_ROOT = Path("/realm/data/machine/syslog")
OUTPUT_MODE = 0o640


def utc_now() -> str:
    return dt.datetime.now(dt.UTC).replace(microsecond=0).isoformat()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def stat_payload(path: Path, root: Path, *, include_hash: bool) -> dict[str, Any]:
    stat = path.stat()
    payload: dict[str, Any] = {
        "path": str(path),
        "relative_path": str(path.relative_to(root)),
        "bytes": stat.st_size,
        "mtime": dt.datetime.fromtimestamp(stat.st_mtime, dt.UTC).replace(microsecond=0).isoformat(),
        "mode": oct(stat.st_mode & 0o777),
        "inode": stat.st_ino,
    }
    if include_hash:
        payload["sha256"] = file_sha256(path)
    return payload


def boot_metric_rows(root: Path, *, include_hash: bool) -> list[dict[str, Any]]:
    metrics_root = root / "boot-metrics"
    rows: list[dict[str, Any]] = []
    if not metrics_root.exists():
        return rows
    for boot_dir in sorted(path for path in metrics_root.iterdir() if path.is_dir()):
        files = [path for path in sorted(boot_dir.rglob("*")) if path.is_file()]
        rows.append(
            {
                "kind": "boot_metrics_dir",
                "boot_id": boot_dir.name,
                "path": str(boot_dir),
                "relative_path": str(boot_dir.relative_to(root)),
                "bytes": sum(path.stat().st_size for path in files),
                "files": [stat_payload(path, root, include_hash=include_hash) for path in files],
            }
        )
    return rows


def give_to_owner(path: Path) -> None:
    """Hand a published file to whoever owns the directory it lives in.

    This runs as a root system oneshot into a sinity-owned capture tree, so a
    file left root-owned is a file the operator's own tooling cannot rewrite.
    The atomic writers do not know about ownership, so it is applied after the
    rename -- the same order the hand-rolled publisher used.
    """
    parent_stat = path.parent.stat()
    try:
        os.chown(path, parent_stat.st_uid, parent_stat.st_gid)
    except PermissionError:
        pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--hash", action="store_true", help="Hash raw files; slow but stronger for audits.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = args.root.resolve()
    output = (args.output or (root / "index")).resolve()
    if not root.exists():
        raise SystemExit(f"syslog root does not exist: {root}")

    boot_metrics = boot_metric_rows(root, include_hash=args.hash)
    metrics_path = output / "boot-metrics.jsonl"
    write_jsonl_atomic(metrics_path, boot_metrics, mode=OUTPUT_MODE)
    give_to_owner(metrics_path)
    manifest_path = output / "manifest.json"
    write_json_atomic(
        manifest_path,
        {
            "schema": SCHEMA,
            "created_at": utc_now(),
            "root": str(root),
            "output": str(output),
            "policy": "derived no-loss index; raw boot metric files remain canonical",
            "counts": {
                "boot_metric_dirs": len(boot_metrics),
            },
            "hashes_included": bool(args.hash),
        },
        mode=OUTPUT_MODE,
    )
    give_to_owner(manifest_path)
    print(manifest_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
