#!/usr/bin/env python3
# @sinnix-package
# description: Scan explicit GitHub publication content for credential patterns
# runtimeInputs: bash coreutils jq python3
import json
import os
import re
import shlex
from pathlib import Path

MAX_BYTES = 1024 * 1024
PATTERNS = (
    # Hyphenated segments included: current OpenAI keys are sk-proj-<base62>,
    # and the old alnum-run pattern stopped matching at the second hyphen
    # (found by the 2026-08-18 content-gate evaluation against a live-format
    # sample; this is the only BLOCKING tier, so the gap was enforced code).
    ("openai-style", re.compile(rb"\bsk-[A-Za-z0-9-]{20,}\b")),
    ("github-token", re.compile(rb"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\b|\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("cloud-key", re.compile(rb"\bAKIA[0-9A-Z]{16}\b")),
    ("slack-token", re.compile(rb"\bxox[baprs]-[A-Za-z0-9-]{16,}\b")),
    ("private-key", re.compile(rb"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")),
)


def emit(decision, reason=None):
    value = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": decision}}
    if reason:
        value["hookSpecificOutput"]["permissionDecisionReason"] = reason
    print(json.dumps(value))


def receipt(event, command, reason):
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "sinnix"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (root / "egress-guard.jsonl").open("a", encoding="utf-8") as handle:
        json.dump({"event": event, "command": command, "reason": reason}, handle)
        handle.write("\n")


def publication_args(tokens):
    for index, token in enumerate(tokens):
        if token == "gh" and index + 1 < len(tokens) and tokens[index + 1] == "api":
            method = "GET"
            for position, candidate in enumerate(tokens[index + 2 :], index + 2):
                if candidate in {"-X", "--method"} and position + 1 < len(tokens):
                    method = tokens[position + 1].upper()
            return method != "GET", tokens[index + 2 :]
        if token == "gh" and tokens[index + 1 : index + 3] == ["pr", "create"]:
            return True, tokens[index + 3 :]
    return False, []


def content_args(tokens, cwd):
    values = []
    field_names = {"--raw-field", "-f", "--field", "--body"}
    file_names = {"--input", "-F", "--input-file", "--body-file"}
    for index, token in enumerate(tokens):
        key, separator, value = token.partition("=")
        if key in file_names and separator:
            values.append(("file", value))
        elif token in file_names and index + 1 < len(tokens):
            values.append(("file", tokens[index + 1]))
        elif key in field_names and separator:
            values.append(("field", value))
        elif token in field_names and index + 1 < len(tokens):
            values.append(("field", tokens[index + 1]))
    return values


def scan(command, cwd):
    try:
        tokens = shlex.split(command)
    except ValueError:
        return []
    outward, args = publication_args(tokens)
    if not outward:
        return []
    findings = []
    for kind, value in content_args(args, cwd):
        if kind == "field":
            payload = value.encode()
        else:
            path = Path(value)
            if not path.is_absolute():
                path = Path(cwd) / path
            try:
                size = path.stat().st_size
            except OSError:
                continue
            if size > MAX_BYTES:
                findings.append(("oversized", str(path)))
                continue
            try:
                payload = path.read_bytes()
            except OSError:
                continue
            if b"\x00" in payload:
                continue
        for name, pattern in PATTERNS:
            if pattern.search(payload):
                findings.append((name, "content" if kind == "field" else value))
    return findings


command = os.environ.get("SINNIX_HOOK_COMMAND", "")
findings = scan(command, os.environ.get("SINNIX_HOOK_CWD", os.getcwd()))
if findings and os.environ.get("SINNIX_EGRESS_GUARD_OVERRIDE") == "1":
    receipt("override", command, "operator override recorded; payload omitted")
    emit("allow", "egress guard override recorded without payload")
elif findings:
    emit("deny", f"outward publication blocked by {findings[0][0]} detector; inspect source without sharing credential material")
else:
    emit("allow")
