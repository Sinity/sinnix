#!/usr/bin/env python3
# @sinnix-package
# description: Evidence-joined usage census across sinnix-owned artifact classes
# runtimeInputs: python3 systemd gnugrep

"""Join declaration inventories against usage evidence.

Read-only. Verdicts degrade to `unknown` when an evidence source is
unavailable -- absence of evidence infrastructure is never reported as
absence of use.

Declaration side: most classes below enumerate from
/etc/sinnix/capability-index.json (modules/lib/capability-index.nix), the one
Nix-derived answer to "what does this host declare and how do I invoke it".
Four classes stay on a private scraper instead, each because the index is
provably not a superset for that class (checked empirically, not assumed):

  * scripts   -- the index only carries PACKAGED scripts (those invocable via
    `sinnix <name>`, which is also why every row needs a description). A
    "# @sinnix-package: skip" script (Hyprland keybindings, sourced-not-run)
    has no description and cannot appear in the index at all, yet is exactly
    as declared as a packaged one -- 14 of 93 marker-carrying scripts are
    skip-mode on this tree. Auditing the marker directly is the only way to
    see all of them.
  * services  -- the index's service/ai-backend rows only cover
    `sinnix.services.*` (mkServiceModule/mkAiService). Backup jobs
    (modules/backup.nix), diagnostics jobs, config-drift, and several
    feature-owned surfaces (activitywatch, socket proxies, sinex, postgres,
    nats) register real runtime surfaces via `sinnix.runtime.surfaces`
    directly or through mkScheduledJob outside the services option --
    42 of 95 live runtime-inventory surfaces are invisible to the index for
    exactly this reason. The inventory is the actual superset.
  * models    -- LiteLLM's live model roster has no capability-index kind at
    all; local models are declared data (flake/data/local-models.nix) the
    index does not surface as rows.
  * secrets   -- the index deliberately never carries secret material.

The remaining classes (mcp-servers, skills, features, commands,
capture-lanes, agent-lanes) were checked to be an index superset (or exact
match) of what a private scraper could see, so they read the index alone --
features/commands/capture-lanes/agent-lanes are new census coverage the
index makes possible for the first time.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
REPO = Path(os.environ.get("SINNIX_REPO", "/realm/project/sinnix"))
CAPTURES = Path("/realm/data/machine")
SECRET_DIR = Path("/realm/data/secrets/sinnix/secret")
INVENTORY = Path("/etc/sinnix/runtime-inventory.json")
CAPABILITY_INDEX = Path("/etc/sinnix/capability-index.json")


def run(argv: list[str], timeout: int = 30) -> str | None:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout if proc.returncode == 0 else None


# ---------- evidence sources ----------

def atuin_evidence(names: list[str], since_ns: int) -> dict | None:
    db = HOME / ".local/share/atuin/history.db"
    if not db.exists():
        return None
    out: dict[str, dict] = {}
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
        for name in names:
            row = conn.execute(
                "SELECT count(*), max(timestamp) FROM history WHERE timestamp > ?"
                " AND (command = ? OR command LIKE ? OR command LIKE ? OR command LIKE ?)",
                (since_ns, name, f"{name} %", f"% {name} %", f"% {name}"),
            ).fetchone()
            out[name] = {"n": row[0], "last": row[1] and int(row[1] // 1_000_000_000)}
        conn.close()
    except sqlite3.Error:
        return None
    return out


def polylogue_evidence(name: str, window_days: int) -> dict | None:
    # Stable-interface rule: CLI only, never polylogue's sqlite (schema churns).
    # `search` was renamed to the query-first `find QUERY` dispatch; root
    # flags (--json/--limit) precede the subcommand, and results come back
    # as {"items": [...]} rather than a bare list or {"results": [...]}.
    out = run(["polylogue", "--json", "--limit", "5", "find", name], timeout=60)
    if out is None:
        return None
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return None
    if isinstance(data, dict):
        items = data.get("items", [])
    elif isinstance(data, list):
        items = data
    else:
        items = []
    return {"n": len(items), "last": None}


def journal_count(unit: str, days: int, manager_user: bool, pattern: str | None = None) -> int | None:
    argv = ["journalctl", f"--since=-{days}d", "-u", unit, "-o", "cat"]
    if manager_user:
        argv.insert(1, "--user")
    out = run(argv, timeout=60)
    if out is None:
        return None
    if pattern:
        return len(re.findall(pattern, out))
    return sum(1 for line in out.splitlines() if line.strip())


def lane_freshness(path_str: str | None, since_epoch: int) -> dict | None:
    """A capture lane's evidence isn't a shell/agent/journal event -- it is
    whether the path it owns has been written to inside the window. `None`
    means "cannot tell" (missing path, permission error), never "unused"."""
    if not path_str:
        return None
    path = Path(path_str)
    try:
        if path.is_file():
            last = path.stat().st_mtime
        elif path.is_dir():
            mtimes = [path.stat().st_mtime]
            mtimes += [entry.stat().st_mtime for entry in path.iterdir()]
            last = max(mtimes)
        else:
            return None
    except OSError:
        return None
    return {"n": 1 if last >= since_epoch else 0, "last": int(last)}


def static_refs(name: str) -> list[str]:
    refs: list[str] = []
    out = run(["grep", "-rl", "--include=*.nix", name, str(REPO / "modules"), str(REPO / "flake")], timeout=60)
    if out:
        refs += [p.removeprefix(str(REPO) + "/") for p in out.splitlines()]
    etc = run(["grep", "-rl", name, "/etc/systemd/system"], timeout=30)
    if etc:
        refs += ["/etc/systemd/system"]
    return refs


# ---------- declaration inventories ----------

def load_capability_index() -> dict[str, list[dict]] | None:
    """/etc/sinnix/capability-index.json, grouped by kind, or None.

    None covers both "host predates the index" and "malformed/wrong schema" --
    every index-sourced class below then contributes zero rows for this run
    rather than raising or guessing. A stderr note in main() makes that
    degradation visible instead of silent.
    """
    try:
        data = json.loads(CAPABILITY_INDEX.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or data.get("schema") != "sinnix-capability-index-v1":
        return None
    rows = data.get("rows")
    if not isinstance(rows, list):
        return None
    by_kind: dict[str, list[dict]] = {}
    for row in rows:
        if isinstance(row, dict) and row.get("kind") and row.get("name"):
            by_kind.setdefault(row["kind"], []).append(row)
    return by_kind


def declared_scripts() -> dict[str, dict]:
    # Not index-sourced: see the module docstring -- skip-mode scripts have no
    # description and cannot appear in the index.
    scripts: dict[str, dict] = {}
    for path in sorted((REPO / "scripts").iterdir()):
        if not path.is_file():
            continue
        head = path.read_text(errors="ignore")[:600]
        if "@sinnix-package" not in head:
            continue
        edges = []
        m = re.search(r"^# runtimeInputs:\s*(.+)$", head, re.M)
        if m:
            edges = [tok[1:] for tok in m.group(1).split() if tok.startswith("@")]
        scripts[path.name] = {"declared_in": f"scripts/{path.name}", "edges": edges}
    return scripts


def declared_mcp_servers(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {
        row["name"]: {"declared_in": row.get("owner") or "flake/data/mcp-registry.nix"}
        for row in index.get("mcp-server", [])
    }


def declared_skills(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {row["name"]: {"declared_in": row.get("owner") or "dots/_ai/skills"} for row in index.get("skill", [])}


def declared_models() -> dict[str, dict]:
    out = run(["curl", "-sm", "20", "-H", "Authorization: Bearer sk-local",
               "http://127.0.0.1:4000/v1/models"], timeout=25)
    models: dict[str, dict] = {}
    if out:
        try:
            for m in json.loads(out).get("data", []):
                models[m["id"]] = {"declared_in": "litellm model_list"}
        except json.JSONDecodeError:
            pass
    return models


def declared_secrets() -> dict[str, dict]:
    if not SECRET_DIR.is_dir():
        return {}
    return {p.stem: {"declared_in": "secret/"} for p in sorted(SECRET_DIR.glob("*.age"))}


def declared_services() -> dict[str, dict]:
    # Not index-sourced: see the module docstring -- the index's
    # service/ai-backend rows are a strict subset of the runtime inventory's
    # surfaces (backup/diagnostics/config-drift jobs and several feature-owned
    # surfaces register outside `sinnix.services.*`).
    try:
        inv = json.loads(INVENTORY.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return {
        name: {"declared_in": "runtime-inventory", "unit": s.get("unit"),
               "manager": s.get("manager", "system"), "kind": s.get("kind", "service"),
               "captures": [c.get("path") for c in s.get("captures", [])]}
        for name, s in inv.get("surfaces", {}).items()
    }


def declared_features(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {
        row["name"]: {"declared_in": row.get("owner"), "enabled": bool(row.get("enabled"))}
        for row in index.get("feature", [])
    }


def declared_commands(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {row["name"]: {"declared_in": row.get("owner")} for row in index.get("command", [])}


def declared_capture_lanes(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {
        row["name"]: {"declared_in": row.get("owner"), "path": row.get("path")}
        for row in index.get("capture-lane", [])
    }


def declared_agent_lanes(index: dict[str, list[dict]] | None) -> dict[str, dict]:
    if index is None:
        return {}
    return {row["name"]: {"declared_in": row.get("owner")} for row in index.get("agent-lane", [])}


# ---------- census ----------

def verdict(ev: dict, refs: list[str], reachable: bool) -> str:
    atuin, poly = ev.get("atuin"), ev.get("polylogue")
    jd = ev.get("journald")
    interactive = bool(atuin and atuin.get("n"))
    agent = bool(poly and poly.get("n"))
    daemon = bool(jd)
    if interactive or daemon:
        return "active"
    if agent:
        return "agent-only"
    if refs or reachable:
        return "referenced-only"
    if atuin is None and poly is None and jd is None:
        return "unknown"
    return "unused-in-window"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--window-days", type=int, default=90)
    ap.add_argument(
        "--classes",
        default="scripts,mcp-servers,skills,models,secrets,services,features,commands,capture-lanes,agent-lanes",
    )
    ap.add_argument("--jsonl-out", default=str(CAPTURES / "usage-census.jsonl"))
    ap.add_argument("--no-write", action="store_true")
    args = ap.parse_args()

    now = int(time.time())
    since_ns = (now - args.window_days * 86400) * 1_000_000_000
    since_epoch = now - args.window_days * 86400
    wanted = set(args.classes.split(","))
    rows: list[dict] = []

    index = load_capability_index()
    index_dependent = {"mcp-servers", "skills", "features", "commands", "capture-lanes", "agent-lanes"}
    if index is None and wanted & index_dependent:
        print(
            f"sinnix-census: no usable capability index at {CAPABILITY_INDEX}; "
            f"skipping index-derived classes: {', '.join(sorted(wanted & index_dependent))}",
            file=sys.stderr,
        )

    if "scripts" in wanted:
        scripts = declared_scripts()
        atuin = atuin_evidence(list(scripts), since_ns)
        used_roots: set[str] = set()
        pending: list[tuple[str, dict, dict]] = []
        for name, meta in scripts.items():
            ev = {
                "atuin": atuin.get(name) if atuin else None,
                "polylogue": polylogue_evidence(name, args.window_days),
                "journald": None,
            }
            refs = static_refs(name)
            pending.append((name, meta, {"ev": ev, "refs": refs}))
            if (ev["atuin"] and ev["atuin"]["n"]) or (ev["polylogue"] and ev["polylogue"]["n"]):
                used_roots.add(name)
        # reachability over @-edges from used roots
        changed = True
        while changed:
            changed = False
            for name, meta, _ in pending:
                if name in used_roots:
                    for edge in meta["edges"]:
                        target = edge if edge in scripts else f"sinnix-{edge}"
                        if target in scripts and target not in used_roots:
                            used_roots.add(target)
                            changed = True
        for name, meta, data in pending:
            reachable = name in used_roots and not (
                (data["ev"]["atuin"] and data["ev"]["atuin"]["n"])
                or (data["ev"]["polylogue"] and data["ev"]["polylogue"]["n"])
            )
            rows.append({
                "class": "scripts", "name": name, "declared_in": meta["declared_in"],
                "evidence": data["ev"], "static_refs": data["refs"][:6],
                "used_via_edges": reachable,
                "verdict": verdict(data["ev"], data["refs"], reachable),
            })

    if "mcp-servers" in wanted:
        for name, meta in declared_mcp_servers(index).items():
            ev = {"atuin": None, "polylogue": polylogue_evidence(f"mcp__{name}__", args.window_days), "journald": None}
            rows.append({"class": "mcp-servers", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "skills" in wanted:
        for name, meta in declared_skills(index).items():
            ev = {"atuin": None, "polylogue": polylogue_evidence(name, args.window_days), "journald": None}
            rows.append({"class": "skills", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "models" in wanted:
        ollama_log = run(["journalctl", f"--since=-{args.window_days}d", "-u", "ollama", "-o", "cat"], timeout=90) or ""
        for name, meta in declared_models().items():
            hits = ollama_log.count(name)
            ev = {"atuin": None, "polylogue": None,
                  "journald": {"n": hits} if hits else None}
            rows.append({"class": "models", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "secrets" in wanted:
        for name, meta in declared_secrets().items():
            refs = static_refs(name)
            ev = {"atuin": None, "polylogue": None, "journald": None}
            # OPERATOR RULE: secrets are NEVER pruning candidates — losing
            # key material is irreversible in a way no other class is.
            # Rows are informational inventory only.
            rows.append({"class": "secrets", "name": name, **meta,
                         "evidence": ev, "static_refs": refs[:6],
                         "never_prune": True,
                         "verdict": "referenced-only" if refs else "informational-no-static-consumers"})

    if "services" in wanted:
        for name, meta in declared_services().items():
            unit = meta.get("unit") or ""
            # `kind` is always a real systemd unit type and `unit` always
            # ends in it -- CLAUDE.md's runtime-governance invariant, so the
            # unit suffix alone tells journalctl-eligibility without needing
            # a separate field.
            kind = unit.rsplit(".", 1)[-1] if "." in unit else meta.get("kind", "service")
            n = None
            if kind in ("service", "timer", "socket", "target"):
                # journalctl accepts the full unit name for all these kinds;
                # timers/sockets log their trigger/incoming events too.
                n = journal_count(unit, args.window_days, meta.get("manager") == "user",
                                  r"Started|Starting|Triggering|Incoming|Listening|Reached")
            elif kind == "scope":
                # Transient scopes are named by prefix, not by a unit that
                # journalctl can be asked about directly.
                n = None
            ev = {"atuin": None, "polylogue": None, "journald": {"n": n} if n else None}
            rows.append({"class": "services", "name": name,
                         "declared_in": meta["declared_in"],
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "features" in wanted:
        features = declared_features(index)
        # A feature isn't invoked by its dotted id ("cli.docling"); the shell
        # or agent evidence that exists for it, if any, is under the leaf
        # name ("docling").
        leaves = {name: name.rsplit(".", 1)[-1] for name in features}
        atuin = atuin_evidence(sorted(set(leaves.values())), since_ns)
        for name, meta in features.items():
            leaf = leaves[name]
            ev = {
                "atuin": atuin.get(leaf) if atuin else None,
                "polylogue": polylogue_evidence(leaf, args.window_days),
                "journald": None,
            }
            # Reachable = the host actually turned it on; an enabled feature
            # with no direct evidence still reads as "present", not "unused".
            rows.append({"class": "features", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], meta.get("enabled", False))})

    if "commands" in wanted:
        commands = declared_commands(index)
        atuin = atuin_evidence(list(commands), since_ns)
        for name, meta in commands.items():
            ev = {
                "atuin": atuin.get(name) if atuin else None,
                "polylogue": polylogue_evidence(name, args.window_days),
                "journald": None,
            }
            rows.append({"class": "commands", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "capture-lanes" in wanted:
        for name, meta in declared_capture_lanes(index).items():
            fresh = lane_freshness(meta.get("path"), since_epoch)
            ev = {"atuin": None, "polylogue": None, "journald": None, "filesystem": fresh}
            if fresh is None:
                v = "unknown"
            elif fresh["n"]:
                v = "active"
            else:
                v = "unused-in-window"
            rows.append({"class": "capture-lanes", "name": name, **meta,
                         "evidence": ev, "static_refs": [], "verdict": v})

    if "agent-lanes" in wanted:
        lanes = declared_agent_lanes(index)
        atuin = atuin_evidence(list(lanes), since_ns)
        for name, meta in lanes.items():
            ev = {
                "atuin": atuin.get(name) if atuin else None,
                "polylogue": polylogue_evidence(name, args.window_days),
                "journald": None,
            }
            rows.append({"class": "agent-lanes", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    stamp = {"ts": now, "window_days": args.window_days}
    if not args.no_write:
        out = Path(args.jsonl_out)
        out.parent.mkdir(parents=True, exist_ok=True)
        with out.open("a") as fh:
            for row in rows:
                fh.write(json.dumps({**stamp, **row}) + "\n")

    order = {"unused-in-window": 0, "no-static-consumers": 1, "unknown": 2,
             "referenced-only": 3, "agent-only": 4, "active": 5}
    rows.sort(key=lambda r: (order.get(r["verdict"], 9), r["class"], r["name"]))
    width = max((len(r["name"]) for r in rows), default=10)
    for row in rows:
        print(f"{row['verdict']:<22} {row['class']:<14} {row['name']:<{width}}")
    counts: dict[str, int] = {}
    for row in rows:
        counts[row["verdict"]] = counts.get(row["verdict"], 0) + 1
    print("\n" + json.dumps(counts))
    return 0


if __name__ == "__main__":
    sys.exit(main())
