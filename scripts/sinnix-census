#!/usr/bin/env python3
# @sinnix-package
# description: Evidence-joined usage census across sinnix-owned artifact classes
# runtimeInputs: python3 systemd gnugrep

"""Join declaration inventories against usage evidence (bead sinnix-yfr).

Design: .agent/scratch/2026-08-11-census-design.md. Read-only. Verdicts
degrade to `unknown` when an evidence source is unavailable — absence of
evidence infrastructure is never reported as absence of use.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
REPO = Path(os.environ.get("SINNIX_REPO", "/realm/project/sinnix"))
CAPTURES = Path("/realm/data/captures/machine")
SECRET_DIR = Path("/realm/data/secrets/sinnix/secret")
INVENTORY = Path("/etc/sinnix/runtime-inventory.json")


def run(argv: list[str], timeout: int = 30) -> str | None:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout if proc.returncode == 0 else None


# ---------- evidence sources ----------

def atuin_evidence(names: list[str], since_ns: int) -> dict | None:
    db = HOME / ".local/share/atuin/history.db"
    if not db.exists():
        return None
    out: dict[str, dict] = {}
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
        for name in names:
            row = conn.execute(
                "SELECT count(*), max(timestamp) FROM history WHERE timestamp > ?"
                " AND (command = ? OR command LIKE ? OR command LIKE ?)",
                (since_ns, name, f"{name} %", f"% {name} %"),
            ).fetchone()
            out[name] = {"n": row[0], "last": row[1] and int(row[1] // 1_000_000_000)}
        conn.close()
    except sqlite3.Error:
        return None
    return out


def polylogue_evidence(name: str, window_days: int) -> dict | None:
    # Stable-interface rule: CLI only, never polylogue's sqlite (schema churns).
    out = run(["polylogue", "search", "--json", "--limit", "5", name], timeout=60)
    if out is None:
        return None
    try:
        rows = json.loads(out)
    except json.JSONDecodeError:
        return None
    n = len(rows) if isinstance(rows, list) else len(rows.get("results", []))
    return {"n": n, "last": None}


def journal_count(unit: str, days: int, manager_user: bool, pattern: str | None = None) -> int | None:
    argv = ["journalctl", f"--since=-{days}d", "-u", unit, "-o", "cat"]
    if manager_user:
        argv.insert(1, "--user")
    out = run(argv, timeout=60)
    if out is None:
        return None
    if pattern:
        return len(re.findall(pattern, out))
    return sum(1 for line in out.splitlines() if line.strip())


def static_refs(name: str) -> list[str]:
    refs: list[str] = []
    out = run(["grep", "-rl", "--include=*.nix", name, str(REPO / "modules"), str(REPO / "flake")], timeout=60)
    if out:
        refs += [p.removeprefix(str(REPO) + "/") for p in out.splitlines()]
    etc = run(["grep", "-rl", name, "/etc/systemd/system"], timeout=30)
    if etc:
        refs += ["/etc/systemd/system"]
    return refs


# ---------- declaration inventories ----------

def declared_scripts() -> dict[str, dict]:
    scripts: dict[str, dict] = {}
    for path in sorted((REPO / "scripts").iterdir()):
        if not path.is_file():
            continue
        head = path.read_text(errors="ignore")[:600]
        if "@sinnix-package" not in head:
            continue
        edges = []
        m = re.search(r"^# runtimeInputs:\s*(.+)$", head, re.M)
        if m:
            edges = [tok[1:] for tok in m.group(1).split() if tok.startswith("@")]
        scripts[path.name] = {"declared_in": f"scripts/{path.name}", "edges": edges}
    return scripts


def declared_mcp_servers() -> dict[str, dict]:
    servers: dict[str, dict] = {}
    for cfg in (HOME / ".config/claude").glob("mcp*.json"):
        try:
            data = json.loads(cfg.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        for name in data.get("mcpServers", {}):
            servers.setdefault(name, {"declared_in": cfg.name})
    return servers


def declared_skills() -> dict[str, dict]:
    root = HOME / ".config/claude/skills"
    if not root.is_dir():
        return {}
    return {p.name: {"declared_in": "dots/_ai/skills"} for p in sorted(root.iterdir())}


def declared_models() -> dict[str, dict]:
    out = run(["curl", "-sm", "20", "-H", "Authorization: Bearer sk-local",
               "http://127.0.0.1:4000/v1/models"], timeout=25)
    models: dict[str, dict] = {}
    if out:
        try:
            for m in json.loads(out).get("data", []):
                models[m["id"]] = {"declared_in": "litellm model_list"}
        except json.JSONDecodeError:
            pass
    return models


def declared_secrets() -> dict[str, dict]:
    if not SECRET_DIR.is_dir():
        return {}
    return {p.stem: {"declared_in": "secret/"} for p in sorted(SECRET_DIR.glob("*.age"))}


def declared_services() -> dict[str, dict]:
    try:
        inv = json.loads(INVENTORY.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return {
        name: {"declared_in": "runtime-inventory", "unit": s.get("unit"),
               "manager": s.get("manager", "system")}
        for name, s in inv.get("surfaces", {}).items()
    }


# ---------- census ----------

def verdict(ev: dict, refs: list[str], reachable: bool) -> str:
    atuin, poly = ev.get("atuin"), ev.get("polylogue")
    jd = ev.get("journald")
    interactive = bool(atuin and atuin.get("n"))
    agent = bool(poly and poly.get("n"))
    daemon = bool(jd)
    if interactive or daemon:
        return "active"
    if agent:
        return "agent-only"
    if refs or reachable:
        return "referenced-only"
    if atuin is None and poly is None and jd is None:
        return "unknown"
    return "unused-in-window"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--window-days", type=int, default=90)
    ap.add_argument("--classes", default="scripts,mcp-servers,skills,models,secrets,services")
    ap.add_argument("--jsonl-out", default=str(CAPTURES / "usage-census.jsonl"))
    ap.add_argument("--no-write", action="store_true")
    args = ap.parse_args()

    now = int(time.time())
    since_ns = (now - args.window_days * 86400) * 1_000_000_000
    wanted = set(args.classes.split(","))
    rows: list[dict] = []

    if "scripts" in wanted:
        scripts = declared_scripts()
        atuin = atuin_evidence(list(scripts), since_ns)
        used_roots: set[str] = set()
        pending: list[tuple[str, dict, dict]] = []
        for name, meta in scripts.items():
            ev = {
                "atuin": atuin.get(name) if atuin else None,
                "polylogue": polylogue_evidence(name, args.window_days),
                "journald": None,
            }
            refs = static_refs(name)
            pending.append((name, meta, {"ev": ev, "refs": refs}))
            if (ev["atuin"] and ev["atuin"]["n"]) or (ev["polylogue"] and ev["polylogue"]["n"]):
                used_roots.add(name)
        # reachability over @-edges from used roots
        changed = True
        while changed:
            changed = False
            for name, meta, _ in pending:
                if name in used_roots:
                    for edge in meta["edges"]:
                        target = edge if edge in scripts else f"sinnix-{edge}"
                        if target in scripts and target not in used_roots:
                            used_roots.add(target)
                            changed = True
        for name, meta, data in pending:
            reachable = name in used_roots and not (
                (data["ev"]["atuin"] and data["ev"]["atuin"]["n"])
                or (data["ev"]["polylogue"] and data["ev"]["polylogue"]["n"])
            )
            rows.append({
                "class": "scripts", "name": name, "declared_in": meta["declared_in"],
                "evidence": data["ev"], "static_refs": data["refs"][:6],
                "used_via_edges": reachable,
                "verdict": verdict(data["ev"], data["refs"], reachable),
            })

    if "mcp-servers" in wanted:
        for name, meta in declared_mcp_servers().items():
            ev = {"atuin": None, "polylogue": polylogue_evidence(f"mcp__{name}__", args.window_days), "journald": None}
            rows.append({"class": "mcp-servers", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "skills" in wanted:
        for name, meta in declared_skills().items():
            ev = {"atuin": None, "polylogue": polylogue_evidence(name, args.window_days), "journald": None}
            rows.append({"class": "skills", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "models" in wanted:
        ollama_log = run(["journalctl", f"--since=-{args.window_days}d", "-u", "ollama", "-o", "cat"], timeout=90) or ""
        for name, meta in declared_models().items():
            hits = ollama_log.count(name)
            ev = {"atuin": None, "polylogue": None,
                  "journald": {"n": hits} if hits else None}
            rows.append({"class": "models", "name": name, **meta,
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    if "secrets" in wanted:
        for name, meta in declared_secrets().items():
            refs = static_refs(name)
            ev = {"atuin": None, "polylogue": None, "journald": None}
            rows.append({"class": "secrets", "name": name, **meta,
                         "evidence": ev, "static_refs": refs[:6],
                         # runtime env reads are invisible; vocabulary reflects it
                         "verdict": "referenced-only" if refs else "no-static-consumers"})

    if "services" in wanted:
        for name, meta in declared_services().items():
            unit = meta.get("unit") or ""
            base = unit.removesuffix(".service")
            n = journal_count(base, args.window_days, meta.get("manager") == "user",
                              r"Started|Starting") if unit.endswith(".service") else None
            ev = {"atuin": None, "polylogue": None, "journald": {"n": n} if n else None}
            rows.append({"class": "services", "name": name,
                         "declared_in": meta["declared_in"],
                         "evidence": ev, "static_refs": [],
                         "verdict": verdict(ev, [], False)})

    stamp = {"ts": now, "window_days": args.window_days}
    if not args.no_write:
        out = Path(args.jsonl_out)
        out.parent.mkdir(parents=True, exist_ok=True)
        with out.open("a") as fh:
            for row in rows:
                fh.write(json.dumps({**stamp, **row}) + "\n")

    order = {"unused-in-window": 0, "no-static-consumers": 1, "unknown": 2,
             "referenced-only": 3, "agent-only": 4, "active": 5}
    rows.sort(key=lambda r: (order.get(r["verdict"], 9), r["class"], r["name"]))
    width = max((len(r["name"]) for r in rows), default=10)
    for row in rows:
        print(f"{row['verdict']:<22} {row['class']:<12} {row['name']:<{width}}")
    counts: dict[str, int] = {}
    for row in rows:
        counts[row["verdict"]] = counts.get(row["verdict"], 0) + 1
    print("\n" + json.dumps(counts))
    return 0


if __name__ == "__main__":
    sys.exit(main())
