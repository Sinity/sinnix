#!/usr/bin/env bash
# @sinnix-package
# description: Capture full-ANSI-fidelity kitty terminal scrollback across all instances
# runtimeInputs: bash coreutils findutils gnused hostname kitty jq
set -euo pipefail
umask 077

# Capture all kitty terminal scrollbacks with full ANSI fidelity.
# Iterates over ALL kitty instances (each has its own socket).
#
# Outputs: /realm/activity/terminal/scrollback/<timestamp>-<pid>-win<id>-<title_slug>.ansi
#
# Usage:
#   kitty-scrollback-capture           # Capture all windows from all instances
#   kitty-scrollback-capture --current # Capture current window only

CAPTURE_DIR="${KITTY_SCROLLBACK_DIR:-/realm/activity/terminal/scrollback}"
PROGRESS_MARKER="${KITTY_SCROLLBACK_PROGRESS_MARKER:-/realm/state/hub/capture-progress/kitty-scrollback}"
TIMESTAMP=$(date -u +%Y%m%dT%H%M%SZ)
HOSTNAME=$(hostname)
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

mkdir -p "$CAPTURE_DIR"

slugify() {
  printf '%s' "$1" | tr '\n\r' '  ' | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-50
}

window_rows() {
  jq -cs '
    if length != 1 then error("expected one inventory document") else .[0] end
    | if type != "array" then error("expected instance array") else .[] end
    | if (.tabs | type) != "array" then error("expected tabs array") else .tabs[] end
    | if (.windows | type) != "array" then error("expected windows array") else .windows[] end
    | if (.id | type) != "number" then error("expected numeric window id")
      elif .id < 0 or (.id | floor) != .id then error("expected nonnegative integer window id")
      else {id, title, cwd} end'
}

capture_window() {
  local socket="$1"
  local pid="$2"
  local win_id="$3"
  local title_json="$4"
  local cwd_json="$5"

  local title_slug
  title_slug=$(slugify "$(jq -r . <<< "$title_json")")
  [ -z "$title_slug" ] && title_slug="untitled"

  # Include PID to disambiguate window IDs across instances
  local filename="${TIMESTAMP}-${HOSTNAME}-pid${pid}-win${win_id}-${title_slug}.ansi"
  local filepath="$CAPTURE_DIR/$filename"

  local capture_error capture_output
  capture_error=$(mktemp "$CAPTURE_DIR/.capture-error.XXXXXX") || return 1
  if ! capture_output=$(mktemp "$CAPTURE_DIR/.capture-output.XXXXXX"); then
    rm -f -- "$capture_error"
    return 1
  fi
  if kitty @ --to "unix:$socket" get-text --match="id:$win_id" --extent=all --ansi --add-wrap-markers > "$capture_output" 2>"$capture_error"; then
    # Publish only complete bytes, and never replace an earlier capture.
    if ! ln -T -- "$capture_output" "$filepath"; then
      echo "  ✗ win:$win_id - publication failed; retained $capture_output and $capture_error" >&2
      return 1
    fi
    rm -f "$capture_output" "$capture_error"
    local lines
    lines=$(wc -l < "$filepath")
    local size
    size=$(du -h "$filepath" | cut -f1)

    # Stage the complete sidecar privately and refuse every existing target,
    # including symlinks and FIFOs, just as for the captured ANSI bytes.
    local metadata_output
    metadata_output=$(mktemp "$CAPTURE_DIR/.capture-metadata.XXXXXX") || return 1
    if ! cat > "$metadata_output" <<EOF
{
  "window_id": $win_id,
  "kitty_pid": $pid,
  "title": $title_json,
  "cwd": $cwd_json,
  "captured_at": "$TIMESTAMP",
  "hostname": "$HOSTNAME",
  "ansi_file": "$filename"
}
EOF
    then
      echo "  ✗ win:$win_id - metadata write failed; retained $metadata_output" >&2
      return 1
    fi
    if ! ln -T -- "$metadata_output" "${filepath%.ansi}.meta.json"; then
      echo "  ✗ win:$win_id - metadata publication failed; retained $metadata_output" >&2
      return 1
    fi
    rm -f -- "$metadata_output" || return 1
    # The health sweep stats this stable path when the archive's bounded
    # sample cannot reach the newest file. Write it only after real output.
    touch "$PROGRESS_MARKER" || return 1
    echo "  ✓ win:$win_id ($lines lines, $size) → $filename"
    return 0
  else
    # A window can close between listing and capture. Only Kitty's exact
    # missing-window response establishes this benign race.
    local error
    error=$(cat "$capture_error")
    if [[ ! -s "$capture_output" && "$error" == "Error: No matching windows for expression: id:$win_id" ]]; then
      rm -f "$capture_error" "$capture_output"
      echo "  ⚠ win:$win_id closed before capture, skipping"
      return 2
    fi
    echo "  ✗ win:$win_id - capture failed: $error; retained $capture_output and $capture_error" >&2
    return 1
  fi
}

CURRENT_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --current)
      CURRENT_ONLY=true
      shift
      ;;
    --help|-h)
      echo "Usage: kitty-scrollback-capture [--current]"
      echo ""
      echo "Captures kitty terminal scrollbacks with full ANSI fidelity."
      echo "Iterates over all kitty instances (separate processes)."
      echo ""
      echo "Output: $CAPTURE_DIR/<timestamp>-<pid>-win<id>-<title>.ansi"
      echo ""
      echo "Options:"
      echo "  --current   Capture current window only (uses KITTY_LISTEN_ON)"
      echo ""
      echo "View captured files with: less -R <file>"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$CURRENT_ONLY" = true ]; then
  if [ -z "${KITTY_LISTEN_ON:-}" ]; then
    echo "Error: KITTY_LISTEN_ON not set. Run from within kitty." >&2
    exit 1
  fi
  socket="${KITTY_LISTEN_ON#unix:}"
  pid=$(basename "$socket" | sed 's/kitty-[^-]*-//')

  if [ -z "${KITTY_WINDOW_ID:-}" ]; then
    echo "Error: KITTY_WINDOW_ID not set." >&2
    exit 1
  fi

  windows_json=$(kitty @ ls 2>/dev/null)
  window_lines=$(printf '%s\n' "$windows_json" | window_rows)
  while IFS= read -r window_json; do
    [ -n "$window_json" ] || continue
    win_id=$(jq -r '.id' <<< "$window_json")
    title_json=$(jq -c '.title' <<< "$window_json")
    cwd_json=$(jq -c '.cwd' <<< "$window_json")
    if [ "$win_id" = "$KITTY_WINDOW_ID" ]; then
      capture_window "$socket" "$pid" "$win_id" "$title_json" "$cwd_json"
      exit $?
    fi
  done <<< "$window_lines"
  echo "Error: Window $KITTY_WINDOW_ID not found" >&2
  exit 1
fi

sockets=()
if [[ ! -d "$RUNTIME_DIR" ]]; then
  echo "Error: runtime directory unavailable or not a directory: $RUNTIME_DIR" >&2
  exit 1
fi
# The owning capture unit makes only its declared output homes writable.
socket_listing=$(mktemp "$CAPTURE_DIR/.socket-listing.XXXXXX")
trap 'rm -f -- "$socket_listing"' EXIT
find -H "$RUNTIME_DIR" -maxdepth 1 -name 'kitty-*' -type s -print0 > "$socket_listing"
while IFS= read -r -d '' socket; do
  sockets+=("$socket")
done < "$socket_listing"
rm -f -- "$socket_listing"
trap - EXIT

if [ ${#sockets[@]} -eq 0 ]; then
  exit 0
fi

echo "Found ${#sockets[@]} kitty instance(s)"
echo ""

total_captured=0
total_failed=0
total_stale=0

for socket in "${sockets[@]}"; do
  pid=$(basename "$socket" | sed 's/kitty-[^-]*-//')
  echo "● Instance pid:$pid"

  # Only native missing/refused endpoint errors establish a stale socket.
  # Permission, authorization and other inventory failures must fail the run.
  inventory_error=$(mktemp "$CAPTURE_DIR/.inventory-error.XXXXXX")
  trap 'rm -f -- "$inventory_error"' EXIT
  if windows_json=$(kitty @ --to "unix:$socket" ls 2>"$inventory_error"); then
    rm -f -- "$inventory_error"
    trap - EXIT
  else
    inventory_message=$(cat "$inventory_error")
    rm -f -- "$inventory_error"
    trap - EXIT
    connection_error_prefix="Error: Failed to connect to unix:$socket with error: dial unix $socket: connect: "
    case "$inventory_message" in
      "${connection_error_prefix}connection refused"|"${connection_error_prefix}no such file or directory")
        echo "  ⚠ stale socket (missing or not accepting connections), skipping"
        total_stale=$((total_stale + 1))
        ;;
      *)
        printf '  ✗ inventory request failed for pid:%s: %s\n' "$pid" "$inventory_message" >&2
        total_failed=$((total_failed + 1))
        ;;
    esac
    continue
  fi

  if ! window_lines=$(printf '%s\n' "$windows_json" | window_rows); then
    echo "  ✗ invalid window inventory for pid:$pid" >&2
    total_failed=$((total_failed + 1))
    continue
  fi
  while IFS= read -r window_json; do
    [ -n "$window_json" ] || continue
    win_id=$(jq -r '.id' <<< "$window_json")
    title_json=$(jq -c '.title' <<< "$window_json")
    cwd_json=$(jq -c '.cwd' <<< "$window_json")
    [ -z "$win_id" ] && continue
    if capture_window "$socket" "$pid" "$win_id" "$title_json" "$cwd_json"; then
      ((total_captured++)) || true
    else
      capture_status=$?
      if [[ "$capture_status" -eq 2 ]]; then
        ((total_stale++)) || true
      else
        ((total_failed++)) || true
      fi
    fi
  done <<< "$window_lines"
done

echo ""
echo "Total: $total_captured window(s) captured, $total_failed failed, $total_stale stale source(s) skipped"
echo "Output: $CAPTURE_DIR"

# Proven stale sources are benign; inventory and publication failures
# remain visible to the owning unit.
[ "$total_failed" -eq 0 ] || exit 1
