#!/usr/bin/env bash
# @sinnix-package
# description: Assert the level-1 node sets of /realm and /outer-realm match the taxonomy
# runtimeInputs: bash coreutils
#
# Taxonomy source of truth: /realm/INVENTORY.md and /outer-realm/INVENTORY.md.
# Main nodes only at level 1 — anything unexpected at a root is
# either debris to triage or a taxonomy change that must update the INVENTORY
# and this manifest in the same commit.
set -euo pipefail

status=0

check_root() {
  local root="$1"
  shift
  local -a allowed=("$@")
  local entry base ok
  [ -d "$root" ] || {
    echo "lake-lint: SKIP $root (not present)" >&2
    return 0
  }
  for entry in "$root"/* "$root"/.[!.]*; do
    [ -e "$entry" ] || continue
    base="$(basename "$entry")"
    ok=1
    for a in "${allowed[@]}"; do
      if [ "$base" = "$a" ]; then
        ok=0
        break
      fi
    done
    if [ "$ok" -ne 0 ]; then
      echo "lake-lint: UNEXPECTED node: $entry"
      status=1
    fi
  done
}

# /realm level-1 manifest. backup/ holds explicit backup landings (the
# polylogue consolidation and its live-store snapshot, 2026-08-16); staging/
# and db/ were dissolved into state/{db-dumps,cursors} and removed outright
# respectively -- their absence here is deliberate, not an omission.
check_root /realm \
  project data library state backup swap cache worktrees tmp inbox \
  INVENTORY.md .btrfs .Trash-1000

check_root /outer-realm \
  backup archive inbox INVENTORY.md \
  archive-staged \
  .Trash-1000

# /realm/data level-1 manifest (personal lake only). accounts/ is the one
# place ownership-as-directory bends to loss profile: other people's
# personal exports (e.g. twitter-archives) are not re-acquirable the way a
# public dataset is, so they sit here rather than in library/, despite the
# owner not being the operator (estate charter Section 3).
check_root /realm/data \
  captures exports self knowledgebase derived secrets accounts \
  activity ai code INVENTORY.md

if [ "$status" -eq 0 ]; then
  echo "lake-lint: all roots match taxonomy"
fi
exit "$status"
