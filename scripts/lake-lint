#!/usr/bin/env bash
# @sinnix-package
# description: Assert the level-1 node sets of /realm and /outer-realm match the taxonomy exactly, in both directions
# runtimeInputs: bash coreutils
#
# The root inventory and this manifest describe the same physical layout.
# Unexpected nodes, missing required nodes, and aliases at canonical roots fail.
set -euo pipefail

status=0

# The roots are absolute by contract. LAKE_LINT_ROOT_PREFIX exists so the
# suite can exercise this manifest against a fixture tree; production leaves
# it empty.
prefix="${LAKE_LINT_ROOT_PREFIX:-}"

# A directory carrying CACHEDIR.TAG is a tool's regenerable cache, not a
# taxonomy node - the same property the backup policy uses to classify this
# class. Foreign test runners drop them into roots they do not own (a
# polylogue subprocess test resolves its rootdir to /realm and writes
# /realm/.pytest_cache), and this lint gates every lane's verification, so a
# gate that turns red for a cache is a gate that gets ignored. A renamed data
# node never carries the tag.
is_tool_cache() {
  [ -f "$1/CACHEDIR.TAG" ]
}

# check_root <root> -- <required nodes...> -- <optional nodes...>
# Required: must exist on disk and be named here. Optional: allowed if
# present (markers, trash, mount scaffolding), never required.
check_root() {
  local root="$prefix$1"
  shift
  local -a required=() optional=()
  local mode=required
  for a in "$@"; do
    if [ "$a" = "--" ]; then
      mode=optional
      continue
    fi
    if [ "$mode" = required ]; then required+=("$a"); else optional+=("$a"); fi
  done
  [ -d "$root" ] || {
    echo "lake-lint: SKIP $root (not present)" >&2
    return 0
  }
  local entry base ok
  for entry in "$root"/* "$root"/.[!.]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    base="$(basename "$entry")"
    ok=1
    for a in "${required[@]}" "${optional[@]}"; do
      if [ "$base" = "$a" ]; then
        ok=0
        break
      fi
    done
    if [ "$ok" -ne 0 ] && ! is_tool_cache "$entry"; then
      echo "lake-lint: UNEXPECTED node: $entry"
      status=1
    fi
  done
  for a in "${required[@]}"; do
    if [ -L "$root/$a" ]; then
      echo "lake-lint: SYMLINK at canonical node: $root/$a"
      status=1
    elif [ ! -e "$root/$a" ]; then
      echo "lake-lint: MISSING required node: $root/$a"
      status=1
    fi
  done
}

# Human-facing subjects and service-owned storage have distinct homes.
check_root /realm \
  project activity accounts ai archive code-snapshots documents health journal library machine \
  notes photos probable-junk reports secrets state backup swap cache worktrees tmp inbox INVENTORY.md \
  -- .btrfs .Trash-1000

check_root /outer-realm \
  backup archive inbox INVENTORY.md \
  -- .Trash-1000

if [ "$status" -eq 0 ]; then
  echo "lake-lint: all roots match taxonomy"
fi
exit "$status"
