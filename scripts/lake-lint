#!/usr/bin/env python3
# @sinnix-package
# description: Assert root nodes match the shared filesystem taxonomy in both directions
# runtimeInputs: python3
# pythonPackages: @sinnix-lib

import os
from pathlib import Path
import sys

from sinnix_lib.layout import COLLECTION_PATHS, MACHINE_LANES, OPTIONAL, RETIRED_PATHS, ROOTS


def is_tool_cache(path: Path) -> bool:
    tag = path / "CACHEDIR.TAG"
    if path.is_symlink() or not path.is_dir() or tag.is_symlink() or not tag.is_file():
        return False
    with tag.open("rb") as handle:
        return handle.read(43) == b"Signature: 8a477f597d28d172789f06886806bc55"


def main() -> int:
    status = 0
    prefix = os.environ.get("LAKE_LINT_ROOT_PREFIX", "")
    for absolute, subjects in ROOTS.items():
        root = Path(prefix + absolute)
        if not root.is_dir():
            print(f"lake-lint: SKIP {root} (not present)", file=sys.stderr)
            continue
        required = {*subjects, "INVENTORY.md"}
        for path in sorted(root.iterdir()):
            if path.name not in required | OPTIONAL[absolute] and not is_tool_cache(path):
                print(f"lake-lint: UNEXPECTED node: {path}")
                status = 1
        for name in sorted(required):
            path = root / name
            if path.is_symlink():
                print(f"lake-lint: SYMLINK at canonical node: {path}")
            elif not path.exists():
                print(f"lake-lint: MISSING required node: {path}")
            elif name == "INVENTORY.md" and not path.is_file():
                print(f"lake-lint: WRONG TYPE (expected regular file): {path}")
            elif name != "INVENTORY.md" and not path.is_dir():
                print(f"lake-lint: WRONG TYPE (expected directory): {path}")
            else:
                continue
            status = 1
    realm = Path(prefix + "/realm")
    if realm.is_dir():
        managed = list(COLLECTION_PATHS.values()) + [
            f"device/sinnix-prime/{relative}" for relative in MACHINE_LANES.values()
        ]
        for relative in managed:
            path = realm / relative
            if path.is_symlink() or not path.is_dir():
                print(f"lake-lint: INVALID managed directory: {path}")
                status = 1
        for relative in RETIRED_PATHS:
            path = realm / relative
            if path.exists() or path.is_symlink():
                print(f"lake-lint: RETIRED managed path recreated: {path}")
                status = 1
    if status == 0:
        print("lake-lint: all roots match taxonomy")
    return status


if __name__ == "__main__":
    raise SystemExit(main())
