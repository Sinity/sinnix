#!/usr/bin/env python3
# @sinnix-package
# description: Focus the oldest reducer-owned agent attention event
# runtimeInputs: python3
"""Focus the oldest pending attention item through the typed reducer action API."""

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


def main() -> int:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"))
    token = (runtime / "sinnix/ops.token").read_text(encoding="utf-8").strip()
    endpoint = os.environ.get("SINNIX_OPS_ENDPOINT", "http://127.0.0.1:3090")
    headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
    request = urllib.request.Request(f"{endpoint}/v1/snapshot", headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            snapshot = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as error:
        print(f"sinnix-attention: reducer unavailable: {type(error).__name__}", file=sys.stderr)
        return 1
    attention = snapshot.get("state", {}).get("attention", {})
    pending = attention.get("pending", []) if isinstance(attention, dict) else []
    if not pending:
        print("no pending attention")
        return 0
    oldest = pending[0]
    job_id = oldest.get("job_id")
    event_id = oldest.get("event_id")
    if not isinstance(job_id, str) or not isinstance(event_id, str):
        print("sinnix-attention: malformed pending item", file=sys.stderr)
        return 1
    payload = json.dumps(
        {
            "action": "focus",
            "target": {"job_id": job_id},
            "expected_revision": snapshot.get("sequence"),
            "idempotency_key": f"attention-focus:{event_id}",
            "operator_reason": "focus oldest pending attention",
        },
        separators=(",", ":"),
    ).encode()
    action_request = urllib.request.Request(
        f"{endpoint}/v1/actions",
        data=payload,
        headers={**headers, "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(action_request, timeout=10) as response:
            receipt = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as error:
        print(f"sinnix-attention: focus failed: {type(error).__name__}", file=sys.stderr)
        return 1
    print(json.dumps(receipt, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
