#!/usr/bin/env bash
# @sinnix-package
# description: Run read-only reboot and switch safety checks before changing generations
# runtimeInputs: bash coreutils findutils gawk gnugrep procps systemd util-linux jq
set -euo pipefail

mode="${1:-}"
case "$mode" in
  reboot|switch) ;;
  *) echo "Usage: sinnix-preflight reboot|switch" >&2; exit 2 ;;
esac

home_root="${SINNIX_PREFLIGHT_HOME_ROOT:-/home/sinity}"
var_root="${SINNIX_PREFLIGHT_VARLIB_ROOT:-/var/lib}"
persist_prefixes="${SINNIX_PREFLIGHT_PERSISTED_PREFIXES:-/persist:/realm}"
min_nix_kib="${SINNIX_PREFLIGHT_MIN_NIX_FREE_KB:-5242880}"
force="${SINNIX_PREFLIGHT_FORCE:-${SINNIX_REBUILD_SKIP_PRESSURE_PREFLIGHT:-0}}"
worst=0

status_name() {
  case "$1" in
    0) echo PASS ;;
    1) echo WARN ;;
    *) echo BLOCK ;;
  esac
}

report() {
  local level="$1" name="$2" evidence="$3" remediation="${4:-}"
  [ "$level" -gt "$worst" ] && worst="$level"
  printf '%s %s: %s\n' "$(status_name "$level")" "$name" "$evidence"
  [ -n "$remediation" ] && printf '  remediation: %s\n' "$remediation"
  return 0
}

is_persisted() {
  local path prefix
  IFS=: read -ra prefixes <<<"$persist_prefixes"
  for prefix in "${prefixes[@]}"; do
    case "$1" in
      "$prefix"|"$prefix"/*) return 0 ;;
    esac
  done
  return 1
}

scan_unpersisted() {
  local root path bytes newest=0 count=0
  for root in "$home_root" "$var_root"; do
    [ -d "$root" ] || continue
    while IFS= read -r -d '' path; do
      is_persisted "$path" && continue
      bytes="$(stat -c '%s' "$path" 2>/dev/null || echo 0)"
      count=$((count + 1))
      [ "$bytes" -gt "$newest" ] && newest="$bytes"
    done < <(find "$root" -xdev -type f -size +100M -print0 2>/dev/null)
  done
  if [ "$count" -gt 0 ]; then
    report 2 unpersisted-valuables "$count large unpersisted files; largest=$newest bytes" "move state under a declared persistence or realm bind before reboot"
  else
    report 0 unpersisted-valuables "no large unpersisted files found"
  fi
}

# The MemAvailable>=8GiB gate that used to live here is deliberately gone.
#
# It could not know what the rebuild was about to do: a one-line module
# change compiles nothing and needs no headroom, while a nixpkgs bump
# recompiles the world and would blow through any fixed threshold anyway.
# So it blocked correct operations on a busy desktop while protecting
# nothing on the runs that actually cost memory.
#
# The mechanism that does work is already in place and is not a
# prediction: nix-build.slice carries MemoryHigh=22G / MemoryMax=28G (see
# flake/data/runtime-defaults.nix), so a build is bounded while it runs
# rather than gated on a guess before it starts. Every rebuild path routes
# through that slice.
#
# It also failed unsafely. On 2026-08-13 it blocked three switches whose
# exit status was masked by the caller's shell, so fixes were reported as
# applied while the system stayed on an older generation -- a refusal that
# is easy to miss is worse than no check.

check_disk() {
  local available
  available="$(df -Pk /nix 2>/dev/null | awk 'NR==2 {print $4}')"
  if [ "${available:-0}" -lt "$min_nix_kib" ]; then
    report 2 nix-storage "free=${available:-0} KiB, required=${min_nix_kib} KiB" "free Nix storage before starting a rebuild"
  else
    report 0 nix-storage "free=${available} KiB"
  fi
}

check_generation() {
  local current booted
  current="$(readlink -f /run/current-system 2>/dev/null || echo unavailable)"
  booted="$(readlink -f /run/booted-system 2>/dev/null || echo unavailable)"
  if [ "$mode" = reboot ] && [ "$current" != "$booted" ]; then
    report 1 generation-pairing "current=${current##*/}, booted=${booted##*/}"
  else
    report 0 generation-pairing "current=${current##*/}, booted=${booted##*/}"
  fi
}

check_nvidia() {
  local loaded userspace
  loaded="${SINNIX_PREFLIGHT_NVIDIA_MODULE_VERSION:-}"
  [ -n "$loaded" ] || loaded="$(awk -F: '/Module version/ {gsub(/[[:space:]]/, "", $2); print $2}' /proc/driver/nvidia/version 2>/dev/null || true)"
  userspace="${SINNIX_PREFLIGHT_NVIDIA_USERSPACE_VERSION:-}"
  [ -n "$userspace" ] || userspace="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 || true)"
  if [ -z "$loaded" ] || [ -z "$userspace" ]; then
    report 1 nvidia-pairing "module=${loaded:-unavailable}, userspace=${userspace:-unavailable}"
  elif [ "$loaded" != "$userspace" ]; then
    report 2 nvidia-pairing "module=$loaded, userspace=$userspace" "reboot into the generation matching the loaded NVIDIA module"
  else
    report 0 nvidia-pairing "module=$loaded, userspace=$userspace"
  fi
}

check_snapshot() {
  local snapshot_root available
  snapshot_root="${SINNIX_PREFLIGHT_SNAPSHOT_ROOT:-/persist/.btrfs/snapshot}"
  available="${SINNIX_PREFLIGHT_SNAPSHOT_FREE_KIB:-}"
  [ -n "$available" ] || available="$(df -Pk "$snapshot_root" 2>/dev/null | awk 'NR==2 {print $4}')"
  if [ -z "$available" ]; then
    report 1 snapshot-headroom "snapshot filesystem unavailable at $snapshot_root"
  elif [ "$available" -lt 10485760 ]; then
    report 2 snapshot-headroom "free=${available} KiB, required=10485760 KiB" "free rollback snapshot headroom before reboot"
  else
    report 0 snapshot-headroom "free=${available} KiB"
  fi
}

check_flake() {
  local flake_dir dirty lock_changes
  flake_dir="${SINNIX_FLAKE_DIR:-$(pwd)}"
  dirty="$(git -C "$flake_dir" status --porcelain 2>/dev/null | wc -l || true)"
  lock_changes="$(git -C "$flake_dir" diff -- flake.lock 2>/dev/null | wc -l || true)"
  if [ "$dirty" -gt 0 ] || [ "$lock_changes" -gt 0 ]; then
    report 1 flake-drift "dirty_paths=$dirty, lock_diff_lines=$lock_changes"
  else
    report 0 flake-drift "clean flake tree and unchanged lockfile"
  fi
}

check_work() {
  local jobs leases
  jobs=0
  for manifest in "${SINNIX_AGENT_JOB_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/agent-jobs}"/*.json; do
    [ -r "$manifest" ] || continue
    case "$(jq -r '.lifecycle // empty' "$manifest" 2>/dev/null || true)" in
      starting|running|cancel_requested) jobs=$((jobs + 1)) ;;
    esac
  done
  leases="$(systemctl --user list-units --state=active --no-legend 2>/dev/null | awk '$1 ~ /sinnix-(build|agent|borg)/ {n++} END {print n+0}' || true)"
  if [ "$jobs" -gt 0 ] || [ "$leases" -gt 0 ]; then
    report 1 live-work "agent_manifests=${jobs}, active_work_units=${leases}"
  else
    report 0 live-work "no active agent or build units observed"
  fi
}

check_concurrency() {
  if pgrep -af 'nh os (switch|boot)|nixos-rebuild|nix.*--profile.*/nix/var/nix/profiles/system' >/dev/null 2>&1; then
    report 2 concurrent-switch "another generation operation is running" "wait for the existing switch or boot operation"
  else
    report 0 concurrent-switch "no concurrent generation operation observed"
  fi
}

if [ "$mode" = reboot ]; then
  scan_unpersisted
  check_generation
  check_nvidia
  check_snapshot
  check_work
else
  check_disk
  check_concurrency
  check_generation
  check_flake
fi

if [ "$mode" = switch ] && [ "$worst" -ge 2 ] && [ "$force" != 1 ]; then
  exit 75
fi
exit 0
