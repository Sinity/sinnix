#!/usr/bin/env bash
# @sinnix-package
# description: Detect a sinex flake input revision bump and pre-build + cache-push it asynchronously
# runtimeInputs: bash coreutils jq @sinnix-scope @sinnix-sinex-cache-push
#
# sinnix-m9v: the desktop is already sinex's "builder of record" -- switch
# publishes the sinex closure to sinity.cachix.org after every successful
# activation (sinexCachePush, flake/command-registry.nix), but that only pays
# off for REPEAT builds of the same input hash. The FIRST switch after any
# sinex master bump still pays the full local compile cost synchronously, on
# the interactive critical path.
#
# This script is the oneshot body of a periodic timer (see
# modules/services/sinex-cache-prebuild.nix). It diffs the sinex node's
# locked revision in the live flake.lock against the last revision this host
# has already prebuilt (a state file, not a live upstream poll -- what
# matters for `switch` is sinnix's OWN pinned input, which only moves via a
# committed flake.lock change, e.g. the routine `update` devshell command).
# When it has moved:
#   1. build sinex directly at that locked git revision -- bypassing
#      sinnix's own flake entirely (sinex intentionally does not follow
#      sinnix's nixpkgs, see CLAUDE.md's Input Pinning notes, so this
#      produces the exact same closure an eventual `switch` would build) --
#      under sinnix-scope's `nix-build` command class, i.e. the same
#      heavy-lease-serialized, nix-build.slice-contained path every other
#      heavy build on this host uses;
#   2. on success, push the result to sinity.cachix.org via the same push
#      logic `switch` uses (sinnix-sinex-cache-push);
#   3. only then record the new revision as built. A failed or lease-blocked
#      run (e.g. an interactive `switch` racing the same heavy lease) leaves
#      the state file untouched, so the next timer tick just retries.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: sinnix-sinex-cache-prebuild --flake-dir <path> [--system <system>] [--state-dir <path>]
EOF
}

flake_dir=""
system="x86_64-linux"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/sinex-cache-prebuild"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --flake-dir) flake_dir="${2:?--flake-dir requires a value}"; shift 2 ;;
    --system) system="${2:?--system requires a value}"; shift 2 ;;
    --state-dir) state_dir="${2:?--state-dir requires a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "sinnix-sinex-cache-prebuild: unknown argument: $1" >&2; usage >&2; exit 64 ;;
  esac
done

[[ -n "$flake_dir" ]] || { echo "sinnix-sinex-cache-prebuild: --flake-dir is required" >&2; exit 64; }

lock_file="$flake_dir/flake.lock"
[[ -r "$lock_file" ]] || { echo "sinnix-sinex-cache-prebuild: cannot read $lock_file" >&2; exit 1; }

locked_rev="$(jq -r '.nodes.sinex.locked.rev // empty' "$lock_file")"
locked_url="$(jq -r '.nodes.sinex.locked.url // empty' "$lock_file")"
if [[ -z "$locked_rev" || -z "$locked_url" ]]; then
  echo "sinnix-sinex-cache-prebuild: could not read .nodes.sinex.locked.{rev,url} from $lock_file" >&2
  exit 1
fi

mkdir -p -m 0700 "$state_dir"
last_rev_file="$state_dir/last-built-rev"
last_rev=""
if [[ -r "$last_rev_file" ]]; then
  last_rev="$(cat "$last_rev_file")"
fi

if [[ "$locked_rev" == "$last_rev" ]]; then
  echo "sinnix-sinex-cache-prebuild: sinex input unchanged (${locked_rev}); nothing to do"
  exit 0
fi

echo "sinnix-sinex-cache-prebuild: sinex input moved ${last_rev:-<none>} -> ${locked_rev}; prebuilding in the background"

# Build the exact locked commit directly from sinex's own repo, not through
# sinnix's flake -- sinnix has no flake output that re-exposes an input's
# packages, and going straight to the locked git rev is what guarantees
# byte-identical results with whatever `switch` will eventually need.
sinex_flake_ref="git+${locked_url}?rev=${locked_rev}"

mapfile -t built_paths < <(
  sinnix-scope nix-build \
    --project sinnix \
    --work-item sinex-cache-prebuild \
    -- nix build "${sinex_flake_ref}#packages.${system}.sinex" --no-link --print-out-paths
)

if [[ "${#built_paths[@]}" -eq 0 ]]; then
  echo "sinnix-sinex-cache-prebuild: build produced no output path" >&2
  exit 1
fi

sinnix-sinex-cache-push "${built_paths[@]}"

printf '%s' "$locked_rev" > "$last_rev_file.tmp"
mv -f "$last_rev_file.tmp" "$last_rev_file"
echo "sinnix-sinex-cache-prebuild: cached sinex @ ${locked_rev}"
