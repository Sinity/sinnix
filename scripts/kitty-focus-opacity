#!/usr/bin/env bash
# @sinnix-package: skip

set -u

active_opacity="${KITTY_ACTIVE_BACKGROUND_OPACITY:-0.70}"
inactive_opacity="${KITTY_INACTIVE_BACKGROUND_OPACITY:-0.20}"
runtime_dir="${KITTY_OPACITY_RUNTIME_DIR:-${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}}"
socket_prefix="kitty-${USER:?USER is required}-"
hyprctl_bin="${HYPRCTL_BIN:-hyprctl}"
kitty_bin="${KITTY_BIN:-kitty}"
jq_bin="${JQ_BIN:-jq}"
socat_bin="${SOCAT_BIN:-socat}"

kitty_remote() {
  local socket="$1"
  shift
  "$kitty_bin" @ --to "unix:${socket}" set-background-opacity "$@" >/dev/null 2>&1
}

apply_opacity() {
  local active_json active_class active_pid active_socket active_title active_window_id socket

  active_json="$($hyprctl_bin -j activewindow 2>/dev/null)" || return 0
  active_class="$(printf '%s' "$active_json" | "$jq_bin" -r '.class // ""')" || return 0
  active_pid="$(printf '%s' "$active_json" | "$jq_bin" -r '.pid // 0')" || return 0
  active_title="$(printf '%s' "$active_json" | "$jq_bin" -r '.title // ""')" || return 0

  case "$active_class" in
    kitty*)
      active_socket="$runtime_dir/${socket_prefix}${active_pid}"
      if [[ -e "$active_socket" || -S "$active_socket" ]]; then
        active_window_id="$($kitty_bin @ --to "unix:${active_socket}" ls 2>/dev/null | "$jq_bin" -r --arg title "$active_title" '
          [
            .[] | .tabs[].windows[]
            | select(
                .title == $title
                or (.title | sub("^[⠀-⣿] "; "")) == ($title | sub("^[⠀-⣿] "; ""))
              )
            | .id
          ]
          | if length == 1 then .[0] else empty end
        ')" || active_window_id=""
      fi
      ;;
  esac

  # Raise the active terminal before touching any inactive terminal. The old
  # all-inactive pre-pass visibly flashed the focused window on every event.
  if [[ -n "${active_window_id:-}" ]]; then
    kitty_remote "$active_socket" --match "id:${active_window_id}" "$active_opacity" || true
  fi

  shopt -s nullglob
  for socket in "$runtime_dir"/"$socket_prefix"*; do
    if [[ -n "${active_window_id:-}" && "$socket" == "$active_socket" ]]; then
      kitty_remote "$socket" --match "not id:${active_window_id}" "$inactive_opacity" || true
    else
      kitty_remote "$socket" --all "$inactive_opacity" || true
    fi
  done
  shopt -u nullglob
}

if [[ "${1:-}" == "--once" ]]; then
  apply_opacity
  exit 0
fi

apply_opacity
hypr_socket="$runtime_dir/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?HYPRLAND_INSTANCE_SIGNATURE is required}/.socket2.sock"
last_active_address="$($hyprctl_bin -j activewindow 2>/dev/null | "$jq_bin" -r '.address // ""')"
last_active_address="${last_active_address#0x}"

while true; do
  while IFS= read -r event; do
    case "$event" in
      activewindowv2\>\>*)
        active_address="${event#*>>}"
        if [[ "$active_address" != "$last_active_address" ]]; then
          apply_opacity
          last_active_address="$active_address"
        fi
        ;;
      openwindow\>\>*|closewindow\>\>*)
        apply_opacity
        last_active_address="$($hyprctl_bin -j activewindow 2>/dev/null | "$jq_bin" -r '.address // ""')"
        last_active_address="${last_active_address#0x}"
        ;;
    esac
  done < <("$socat_bin" -u "UNIX-CONNECT:${hypr_socket}" - 2>/dev/null)
  sleep 1
done
