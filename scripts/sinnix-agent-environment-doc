# @sinnix-package: skip
#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s --data FILE --skills-root DIR --agents-root DIR --output FILE\n' "$0" >&2
  exit 2
}

data= skills_root= agents_root= output=
while (($#)); do
  case "$1" in
    --data) data=${2-}; shift 2 ;;
    --skills-root) skills_root=${2-}; shift 2 ;;
    --agents-root) agents_root=${2-}; shift 2 ;;
    --output) output=${2-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$data" && -n "$skills_root" && -n "$agents_root" && -n "$output" ]] || usage
for path in "$data" "$skills_root" "$agents_root"; do
  [[ -e "$path" ]] || { printf 'missing input: %s\n' "$path" >&2; exit 1; }
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
skills="$tmp/skills.tsv"
agents="$tmp/agents.tsv"

extract_frontmatter() {
  local root=$1 result=$2
  : > "$result"
  while IFS= read -r -d '' file; do
    awk '
      NR == 1 && $0 == "---" { yaml=1; next }
      yaml && $0 == "---" { exit }
      yaml {
        line=$0; sub(/^[[:space:]]+/, "", line)
        if (line ~ /^(name|description|model|effort):[[:space:]]*/) {
          key=line; sub(/:.*/, "", key)
          value=line; sub(/^[^:]*:[[:space:]]*/, "", value)
          gsub(/\t/, " ", value); gsub(/\r/, "", value); fields[key]=value
        }
      }
      END {
        if (fields["name"] != "" && fields["description"] != "")
          printf "%s\t%s\t%s\t%s\n", fields["name"], fields["description"], fields["model"], fields["effort"]
      }
    ' "$file" >> "$result"
  done < <(find "$root" -type f \( -name '*.md' -o -name '*.markdown' \) -print0 | sort -z)
  sort -t $'\t' -k1,1 -u "$result" -o "$result"
}

extract_frontmatter "$skills_root" "$skills"
extract_frontmatter "$agents_root" "$agents"
mkdir -p "$(dirname "$output")"
{
  printf '# Sinnix agent environment\n\n'
  printf '> Generated by `sinnix-agent-environment-doc`. Edit the registry, shared skill list, or frontmatter sources, then regenerate this file.\n\n'
  printf '## Profiles\n\n'
  jq -r '.profiles[] | "### \(.name) (\(.client))\n\nTiers: \(.tiers | join(", ")).\nServers: \(.servers | join(", ")).\n"' "$data"
  printf '## MCP servers\n\n| Server | Tier | Transport | Command or URL | Clients |\n| --- | --- | --- | --- | --- |\n'
  jq -r '.servers[] | "| `\(.name)` | `\(.tier)` | `\(.transport)` | `\(.command // .url // "")` | \(.clients | join(", ")) |"' "$data"
  printf '\n## Agent definitions\n\n| Name | Description | Model | Effort |\n| --- | --- | --- | --- |\n'
  awk -F '\t' '{ printf "| `%s` | %s | `%s` | `%s` |\n", $1, $2, $3, $4 }' "$agents"
  printf '\n## Shared skills\n\n| Skill | When to use |\n| --- | --- |\n'
  jq -r '.skills[]' "$data" | while IFS= read -r skill; do
    row=$(awk -F '\t' -v name="$skill" '$1 == name { print; found=1 } END { if (!found) exit 1 }' "$skills") || {
      printf 'missing frontmatter for shared skill: %s\n' "$skill" >&2; exit 1
    }
    description=${row#*$'\t'}; description=${description%%$'\t'*}
    printf '| `%s` | %s |\n' "$skill" "$description"
  done
} > "$output"

if rg -n '/home/|/persist/|/realm/cache/|/realm/data/|/nix/store/' "$output" >/dev/null; then
  printf 'private path found in generated document: %s\n' "$output" >&2
  exit 1
fi
