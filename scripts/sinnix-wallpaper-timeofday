#!/usr/bin/env bash
# @sinnix-package
# description: Retarget ~/wallpaper/{dark,light} to the current time-of-day wallpaper set
# runtimeInputs: bash coreutils findutils
set -euo pipefail

export LC_ALL=C

# Config: modules/features/desktop/wallpaper.nix seeds these into the
# systemd unit and the login session; fall back to the module defaults so
# this also runs sanely when invoked by hand.
CORPUS="${SINNIX_WALLPAPER_CORPUS:-/realm/library/images/wallpaper}"
# Existing login sessions may retain the retired default after activation.
if [[ "$CORPUS" == /realm/library/media/wallpaper ]]; then
  CORPUS=/realm/library/images/wallpaper
fi
WALLPAPER_DIR="${HOME}/wallpaper"
# Last-resort source for the dark/light links while the curated corpus is
# still being filled. The flat legacy stash is the one directory guaranteed
# to hold images today.
FALLBACK="${SINNIX_WALLPAPER_FALLBACK:-${WALLPAPER_DIR}/stash}"

# Pinning transfers selection ownership to Noctalia.  Check the native IPC
# toggle before touching the watched links: a relink can otherwise make the
# pinned image resolve differently (or disappear) after Noctalia restarts.
noctalia_bin="${SINNIX_NOCTALIA_BIN:-noctalia}"
if ! automation_enabled="$("$noctalia_bin" msg wallpaper-automation-get 2>/dev/null)"; then
  echo "sinnix-wallpaper-timeofday: Noctalia automation owner unavailable; leaving wallpaper targets untouched" >&2
  exit 0
fi
if [[ "$automation_enabled" != "true" ]]; then
  echo "sinnix-wallpaper-timeofday: automation is paused; leaving wallpaper targets untouched"
  exit 0
fi

hour=$(date +%H)
hour=$((10#$hour))

# The wallpaper module injects the only declared mood/schedule source. A
# session that has not received it must fail closed rather than guessing a
# target and mutating Noctalia's watched links.
MOODS="${SINNIX_WALLPAPER_MOODS:?Sinnix wallpaper moods are not configured}"
SCHEDULE="${SINNIX_WALLPAPER_TIME_OF_DAY_SCHEDULE:?Sinnix wallpaper schedule is not configured}"
IFS=',' read -r -a schedule_entries <<< "$SCHEDULE"
previous_start=-1
mood=""
for entry in "${schedule_entries[@]}"; do
  if [[ ! "$entry" =~ ^([0-9]{1,2}):([[:alnum:]_-]+)$ ]]; then
    echo "sinnix-wallpaper-timeofday: invalid schedule entry '$entry'" >&2
    exit 1
  fi
  start=$((10#${BASH_REMATCH[1]}))
  candidate="${BASH_REMATCH[2]}"
  if (( start > 23 || start <= previous_start )); then
    echo "sinnix-wallpaper-timeofday: schedule hours must be strictly increasing from 0" >&2
    exit 1
  fi
  if [[ ",$MOODS," != *",$candidate,"* ]]; then
    echo "sinnix-wallpaper-timeofday: schedule mood '$candidate' is not declared" >&2
    exit 1
  fi
  if (( previous_start == -1 && start != 0 )); then
    echo "sinnix-wallpaper-timeofday: schedule must begin at hour 0" >&2
    exit 1
  fi
  previous_start=$start
  if (( hour >= start )); then mood="$candidate"; fi
done
if [[ -z "$mood" ]]; then
  echo "sinnix-wallpaper-timeofday: empty schedule" >&2
  exit 1
fi

target_dark="${CORPUS}/sets/${mood}/dark"
target_light="${CORPUS}/sets/${mood}/light"

mkdir -p "$WALLPAPER_DIR"

# Noctalia's config.toml points directory_dark/directory_light at
# ~/wallpaper/{dark,light} unconditionally, so those links existing and
# resolving to a directory that HAS images is a hard requirement, not a
# nicety: when they dangle, Noctalia has nothing to rotate, the screen goes
# static, and the panel's brightness limiter dims it. Never leave a link
# dangling; fall back to whatever is actually populated instead.
has_images() {
  [[ -d "$1" ]] && find -L "$1" -maxdepth 2 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print -quit 2>/dev/null | read -r _
}

relink() {
  local link="$1" target="$2"
  if ! has_images "$target"; then
    if has_images "$FALLBACK"; then
      echo "sinnix-wallpaper-timeofday: $target unusable, falling back to $FALLBACK" >&2
      target="$FALLBACK"
    else
      echo "sinnix-wallpaper-timeofday: neither $target nor $FALLBACK has images, leaving $link alone" >&2
      return 1
    fi
  fi
  local current=""
  if [[ -L "$link" ]]; then current=$(readlink -f "$link" 2>/dev/null || true); fi
  local resolved
  resolved=$(readlink -f "$target")
  if [[ "$current" != "$resolved" ]]; then
    ln -sfn "$target" "$link"
    return 0
  fi
  return 2
}

changed=0
if relink "${WALLPAPER_DIR}/dark" "$target_dark"; then changed=1; fi
if relink "${WALLPAPER_DIR}/light" "$target_light"; then changed=1; fi

if [[ "$changed" == "1" ]]; then
  echo "sinnix-wallpaper-timeofday: switched to '${mood}' set"
  "$noctalia_bin" msg wallpaper-random >/dev/null 2>&1 || true
fi
