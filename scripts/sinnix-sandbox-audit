#!/usr/bin/env bash
# @sinnix-package
# description: Report gaps between what sinnix declares and what it actually does — confinement, empty lanes, units that never succeed
# runtimeInputs: bash coreutils findutils gawk gnugrep jq systemd audit
set -euo pipefail

# Every check here answers one question: does a declaration match reality?
# That gap is silent by construction -- a denied write logs nothing, an empty
# lane looks like a quiet one, and a unit that never finishes is not "failed".
#
#   confined-from-own-output  the unit cannot write the path it declares
#   lane-missing / lane-empty  the declared path has never held anything
#   agent-transcript-loss      a hardened unit execs an agent CLI it cannot log
#   never-succeeded            a timer-driven unit with no completion on record
#   lane-abandoned             capture data belonging to no declared surface

INVENTORY="${SINNIX_RUNTIME_INVENTORY:-/etc/sinnix/runtime-inventory.json}"
OUT="${SINNIX_SANDBOX_AUDIT_OUT:-/realm/data/machine/sandbox-audit.jsonl}"
CAPTURES_ROOT="${SINNIX_CAPTURES_ROOT:-/realm/data/captures}"
# Journal retention bounds what "never" can mean here; say so in the finding
# rather than implying the unit has never run since it was written.
SINCE_WINDOW="${SINNIX_AUDIT_SINCE:-7 days ago}"
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
QUIET=0
[[ "${1:-}" == "--quiet" ]] && QUIET=1

[[ -r "$INVENTORY" ]] || {
  echo "sinnix-sandbox-audit: no runtime inventory at $INVENTORY" >&2
  exit 1
}

show_prop() {
  # $1=manager $2=unit $3=property -> bare value
  local scope=()
  [[ "$1" == "user" ]] && scope=(--user)
  systemctl "${scope[@]}" show "$2" -p "$3" --value 2>/dev/null || true
}

findings="$(mktemp)"
trap 'rm -f "$findings"' EXIT

emit() {
  jq -nc \
    --arg ts "$NOW" --arg unit "$2" --arg manager "$1" --arg kind "$3" \
    --arg path "$4" --arg detail "$5" \
    '{timestamp:$ts, unit:$unit, manager:$manager, kind:$kind, path:$path, detail:$detail}' \
    >>"$findings"
}

# The audit subsystem can be switched off underneath every rule in it, and
# nothing about the resulting silence looks different from "nothing was
# denied". That is not hypothetical: on 2026-08-16 restarting journald turned
# kernel auditing off -- the old journald had enabled it and disables it on
# stop, and the new one, correctly configured NOT to enable it, left it
# off -- so auditd stayed active, its rules stayed loaded, and the log went
# to exactly zero bytes. A measurement taken in that window read as a
# spectacular success for a narrowing that had barely landed.
#
# auditctl -s is the only thing that distinguishes a quiet lane from a deaf
# one, so ask it before believing any silence downstream.
if command -v auditctl >/dev/null 2>&1; then
  audit_enabled="$(auditctl -s 2>/dev/null | awk '$1 == "enabled" { print $2 }')"
  if [[ "$audit_enabled" == "0" ]]; then
    emit system auditd.service audit-disabled /var/log/audit/audit.log \
      "kernel auditing is disabled (auditctl -s reports enabled 0); every rule is loaded and recording nothing. Re-enable with 'auditctl -e 1'."
  fi
fi

# A path is writable if it sits under some ReadWritePaths entry. Under
# ProtectSystem=strict the whole hierarchy is read-only, so absence from that
# list is decisive; under weaker modes only /usr, /boot and /etc are.
covered_by() {
  local path="$1" rw="$2" entry
  for entry in $rw; do
    entry="${entry#-}"
    entry="${entry#+}"
    [[ -z "$entry" ]] && continue
    [[ "$path" == "$entry" || "$path" == "$entry"/* ]] && return 0
  done
  return 1
}

while IFS=$'\t' read -r _name unit manager path; do
  [[ -z "$unit" ]] && continue

  protect_system="$(show_prop "$manager" "$unit" ProtectSystem)"
  protect_home="$(show_prop "$manager" "$unit" ProtectHome)"
  rw_paths="$(show_prop "$manager" "$unit" ReadWritePaths)"
  state_dir="$(show_prop "$manager" "$unit" StateDirectory)"

  # StateDirectory is implicitly writable.
  [[ -n "$state_dir" ]] && rw_paths="$rw_paths /var/lib/$state_dir"

  hardened=0
  [[ "$protect_system" == "strict" || "$protect_system" == "full" ]] && hardened=1
  [[ "$protect_home" == "yes" || "$protect_home" == "read-only" ]] && hardened=1

  if [[ "$hardened" -eq 1 ]] && ! covered_by "$path" "$rw_paths"; then
    emit "$manager" "$unit" "confined-from-own-output" "$path" \
      "ProtectSystem=$protect_system ProtectHome=$protect_home ReadWritePaths='$rw_paths' does not cover this declared capture path"
  fi

  if [[ ! -e "$path" ]]; then
    emit "$manager" "$unit" "lane-missing" "$path" "declared capture path does not exist"
  elif [[ -d "$path" ]] && [[ -z "$(find "$path" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    emit "$manager" "$unit" "lane-empty" "$path" "declared capture lane has never held a file"
  elif [[ -f "$path" ]] && [[ ! -s "$path" ]]; then
    emit "$manager" "$unit" "lane-empty" "$path" "declared capture file is zero bytes"
  fi
done < <(
  jq -r '.surfaces | to_entries[] | .value as $s | ($s.captures // [])[]
         | select(.path != null)
         | [$s.unit // "", $s.manager // "system", .path] | @tsv' "$INVENTORY" \
    | awk -F'\t' '{print "-\t"$1"\t"$2"\t"$3}'
)

# Any hardened unit that can exec an agent CLI must be able to persist that
# agent's transcript, or the run vanishes with no error anywhere.
while IFS=$'\t' read -r unit manager; do
  [[ -z "$unit" ]] && continue
  exec_line="$(show_prop "$manager" "$unit" ExecStart)"
  grep -qE '\b(claude|codex|gemini)\b' <<<"$exec_line" || continue
  protect_home="$(show_prop "$manager" "$unit" ProtectHome)"
  protect_system="$(show_prop "$manager" "$unit" ProtectSystem)"
  rw_paths="$(show_prop "$manager" "$unit" ReadWritePaths)"
  [[ "$protect_system" == "strict" || "$protect_system" == "full" \
    || "$protect_home" == "yes" || "$protect_home" == "read-only" ]] || continue
  if ! covered_by "$HOME/.claude" "$rw_paths"; then
    emit "$manager" "$unit" "agent-transcript-loss" "$HOME/.claude" \
      "unit execs an agent CLI under mount-namespace hardening but cannot write the transcript directory"
  fi
done < <(jq -r '.surfaces | to_entries[] | [.value.unit // "", .value.manager // "system"] | @tsv' "$INVENTORY")

# A timer-driven unit that has never once succeeded is the inverse of an empty
# lane: the declaration is fine, the work never finishes. Nothing else notices,
# because "not currently failed" and "has never completed" look identical.
while IFS=$'\t' read -r unit manager acknowledged; do
  [[ -z "$unit" ]] && continue
  # An acknowledged outage is a decision already recorded, with a tracking
  # reference. Re-reporting it is how a checker teaches people to ignore it.
  [[ "$acknowledged" == "true" ]] && continue
  timer="${unit%.service}.timer"
  scope=()
  [[ "$manager" == "user" ]] && scope=(--user)
  systemctl "${scope[@]}" list-unit-files "$timer" &>/dev/null || continue
  systemctl "${scope[@]}" cat "$timer" &>/dev/null || continue
  # NOT `grep -q`: it exits on the first match, journalctl dies on SIGPIPE, and
  # under `set -o pipefail` the pipeline then reports failure -- which reads as
  # "never succeeded" for every healthy unit. Consume the whole stream.
  if ! journalctl "${scope[@]}" -u "$unit" --since "$SINCE_WINDOW" --no-pager 2>/dev/null \
    | grep -E "Deactivated successfully|Finished " >/dev/null; then
    emit "$manager" "$unit" "never-succeeded" "$timer" \
      "timer-driven unit with no successful completion in the journal since $SINCE_WINDOW"
  fi
done < <(jq -r '.surfaces | to_entries[]
         | [.value.unit // "", .value.manager // "system",
            (.value.acknowledged.down // false | tostring)] | @tsv' "$INVENTORY")

# Capture directories nobody declares. A lane that outlives the module that
# created it keeps its data out of every freshness and coverage check, and
# reads as live data while belonging to nothing.
declared_paths="$(jq -r '.surfaces[] | (.captures // [])[] | .path // empty' "$INVENTORY")"
while IFS= read -r dir; do
  [[ -z "$dir" ]] && continue
  covered=0
  while IFS= read -r decl; do
    [[ -z "$decl" ]] && continue
    if [[ "$decl" == "$dir" || "$decl" == "$dir"/* || "$dir" == "$decl"/* ]]; then
      covered=1
      break
    fi
  done <<<"$declared_paths"
  [[ "$covered" -eq 1 ]] && continue
  # Undeclared alone is weak evidence -- plenty of lanes are written by
  # producers outside the runtime inventory. Undeclared AND untouched for a
  # month is the abandoned-lane shape worth a human look.
  if [[ -z "$(find "$dir" -mindepth 1 -mtime -30 -print -quit 2>/dev/null)" ]]; then
    emit "-" "-" "lane-abandoned" "$dir" \
      "capture directory with no declaring surface and no write in 30 days"
  fi
done < <(find "$CAPTURES_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)

count="$(wc -l <"$findings" 2>/dev/null || echo 0)"
mkdir -p "$(dirname "$OUT")"
if [[ "$count" -gt 0 ]]; then
  cat "$findings" >>"$OUT"
  if [[ "$QUIET" -eq 0 ]]; then
    jq -r '"\(.kind)\t\(.unit)\t\(.path)\t\(.detail)"' "$findings"
  fi
  # Journal at warning level so the sentinel and `journalctl -p warning` see it.
  while IFS= read -r line; do
    printf 'sinnix-sandbox-audit: %s\n' \
      "$(jq -r '"\(.kind) \(.unit) \(.path): \(.detail)"' <<<"$line")" >&2
  done <"$findings"
else
  [[ "$QUIET" -eq 0 ]] && echo "sinnix-sandbox-audit: no findings"
fi
exit 0
