#!/usr/bin/env bash
# @sinnix-package
# description: Reach the phone over the tailnet — status, shell, screen mirror, media pull, clipboard push
# runtimeInputs: bash coreutils openssh rsync android-tools scrcpy iputils jq wl-clipboard gawk ffmpeg curl @sinnix-phone-dispatcher

#
# The phone (Redmi Note 11, unrooted) is a tailnet peer with two control
# surfaces: Termux sshd on :8022 for shell/file work, and adbd on :5555 for
# device-level control (input, screencap, packages, settings). Both ride the
# tailnet, so this works from anywhere the tailnet reaches — not just the LAN.
#
# adbd over TCP does NOT survive a phone reboot; `sinnix-phone adb-restore`
# re-enables it over USB. Everything else survives.
#
# Ambient audio is produced by the Sinnix Capture app (pkgs/sinnix-phone-app),
# not by Termux. Termux remains the drain transport and the clipboard/wifi
# surface, but it cannot hold the microphone: only an app declaring
# foregroundServiceType="microphone" keeps recording once the screen goes off,
# which is why the Termux recorder truncated chunks and never came back after
# a reboot (sinnix-hcjq). `app-install` retires Termux's runit `ambient`
# service with a `down` file so the two never contend for the mic.
#
# Clipboard is one-way (desktop -> phone). Android blocks clipboard READS
# from a backgrounded app (since Android 10): `termux-clipboard-get`
# silently returns empty unless Termux is the foreground app.
# `termux-clipboard-set` has no such restriction. Phone->desktop sync would
# need Termux kept foregrounded or an AccessibilityService-based reader.
# PRIMARY has no Android equivalent; this covers CLIPBOARD only.
set -euo pipefail

PHONE_TS_IP="${SINNIX_PHONE_IP:-100.124.215.25}"
PHONE_SSH_PORT="${SINNIX_PHONE_SSH_PORT:-8022}"
PHONE_USER="${SINNIX_PHONE_USER:-u0_a398}"
ADB_TARGET="${PHONE_TS_IP}:5555"
LAKE_ROOT="${SINNIX_PHONE_LAKE:-/realm/data/captures/phone}"
PHONE_STATE="${SINNIX_PHONE_STATE_DIR:-/realm/state/sinnix-phone}"

# -F /dev/null + explicit identity, not ~/.ssh/config: under a sandboxed
# systemd unit's ProtectHome, ssh rejects the Home-Manager ~/.ssh/config
# symlink outright ("Bad owner or permissions", exit 255). A script invoked
# by both a human and a timer should not depend on interactive config.
ssh_phone_opts=(
  # -o Port=, not -p: this array is shared verbatim with scp_phone() below,
  # and scp's -p means "preserve file attributes" (a no-arg flag), not
  # port -- passing `-p 8022` to scp silently misparses 8022 as a stray
  # filename argument. -o Port= means the same thing to both tools.
  -o "Port=$PHONE_SSH_PORT"
  -F /dev/null
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
  -o "UserKnownHostsFile=${SINNIX_PHONE_KNOWN_HOSTS:-$HOME/.ssh/known_hosts}"
  -o IdentitiesOnly=yes
  # ssh-agent can hold a key that LOOKS like a match and still answer
  # "signing failed... agent refused operation". IdentitiesOnly=yes restricts
  # which identity FILES are tried but does not stop the agent being asked
  # first, so go straight to the key file; this identity doesn't need
  # agent-forwarding semantics.
  -o IdentityAgent=none
  -i "${SINNIX_PHONE_IDENTITY:-$HOME/.ssh/id_ed25519}"
  # Connection multiplexing: raw tailnet RTT to the phone is ~4-11ms but a
  # cold SSH handshake is ~380-586ms, and multi-step commands (`pull`,
  # `status`) pay that 2-4x sequentially. ControlMaster reuses one
  # authenticated connection for every ssh/scp call in a single invocation;
  # ControlPersist=120 keeps it alive across quick successive commands
  # without lingering on a device that roams networks. %C is ssh's
  # single-token hash of user+host+port, so the socket path can't grow
  # unboundedly long.
  -o ControlMaster=auto
  -o ControlPersist=120
  -o "ControlPath=${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}/%C"
)
mkdir -p "${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}"
# Same flags as a single shell-word, for rsync -e (which needs a word, not
# an array) -- computed once at top level so every case branch can use it,
# including a `"$0" subcmd` re-invocation, which is a separate process.
rsync_ssh="ssh ${ssh_phone_opts[*]}"
# shellcheck disable=SC2029  # client-side expansion is intended: callers
# (clip-push) build the remote command with their own already-expanded args.
ssh_phone() { ssh "${ssh_phone_opts[@]}" "${PHONE_USER}@${PHONE_TS_IP}" "$@"; }
scp_phone() { scp "${ssh_phone_opts[@]}" "$@"; }
adb_phone() { ANDROID_SERIAL="$ADB_TARGET" adb "$@"; }

# `adb connect` to an unreachable host never returns on its own -- it is not
# a bounded handshake, it retries until something interrupts it. The phone
# roams networks and its tailnet is frequently down, so every connect attempt
# here is time-boxed; without that a status check hangs indefinitely instead
# of reporting "adb down".
ensure_adb() {
  if ! ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    timeout 8 adb connect "$ADB_TARGET" >/dev/null 2>&1 || true
    sleep 1
  fi
}

APP_ID="dev.sinnix.phone"
# The launcher activity, named once. Every headless recovery path goes through
# it, so a rename that misses this line is a silent capture outage.
APP_ACTIVITY="${SINNIX_PHONE_APP_ACTIVITY:-.ui.MainActivity}"

# adb over whichever transport is actually up. adbd's TCP mode does not
# survive a phone reboot, and after one the tailnet is often down too (the VPN
# service needs its own restart), so the USB cable is frequently the only
# working transport at exactly the moment something needs checking. Everything
# app-related goes through this rather than adb_phone, because the app's
# liveness must be answerable without Termux, without sshd, and without the
# tailnet -- those are the layers that kept failing.
ADB_RESOLVED="${ADB_RESOLVED:-}"

# Resolve the transport once, in the CALLER's shell.
#
# Each unresolved adb_any call spends up to 8s failing to reach a tailnet that
# is down, and a per-file loop makes two or three calls per chunk -- a drain of
# thirty chunks took forty minutes almost entirely in that timeout. Memoizing
# inside adb_any cannot fix it, because most calls are command substitutions
# and a subshell's assignment dies with the subshell. Callers that loop should
# resolve first; everything after is a direct adb invocation.
adb_resolve() {
  [ -n "$ADB_RESOLVED" ] && return 0
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    ADB_RESOLVED="$ADB_TARGET"
    return 0
  fi
  timeout 8 adb connect "$ADB_TARGET" >/dev/null 2>&1 || true
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    ADB_RESOLVED="$ADB_TARGET"
    return 0
  fi
  ADB_RESOLVED=$(adb devices | awk '$2 == "device" && $1 !~ /:/ { print $1; exit }')
  [ -n "$ADB_RESOLVED" ]
}

adb_any() {
  local serial
  if [ -n "$ADB_RESOLVED" ]; then
    ANDROID_SERIAL="$ADB_RESOLVED" adb "$@"
    return
  fi
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    ANDROID_SERIAL="$ADB_TARGET" adb "$@"
    return
  fi
  timeout 8 adb connect "$ADB_TARGET" >/dev/null 2>&1 || true
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    ANDROID_SERIAL="$ADB_TARGET" adb "$@"
    return
  fi
  serial=$(adb devices | awk '$2 == "device" && $1 !~ /:/ { print $1; exit }')
  if [ -n "$serial" ]; then
    ANDROID_SERIAL="$serial" adb "$@"
    return
  fi
  return 1
}

# The grants the app needs that only shell-uid can make. RECORD_AUDIO is
# deliberately NOT forced to `allow` here: the app declares
# foregroundServiceType="microphone", so the default MODE_FOREGROUND is
# already satisfied whenever its foreground service is up. That is the whole
# reason an app works where the Termux script did not, and overriding the
# appop would hide a regression in the service rather than fix one.
# MANAGE_EXTERNAL_STORAGE is set at both package and uid scope because the two
# are separate modes and only one of them reverting is what silently broke
# capture before (sinnix-hcjq).
ensure_app_grants() {
  adb_any shell pm grant "$APP_ID" android.permission.RECORD_AUDIO >/dev/null 2>&1 || true
  adb_any shell pm grant "$APP_ID" android.permission.POST_NOTIFICATIONS >/dev/null 2>&1 || true
  adb_any shell appops set "$APP_ID" MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true
  adb_any shell appops set --uid "$APP_ID" MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true
  adb_any shell cmd deviceidle whitelist "+$APP_ID" >/dev/null 2>&1 || true
}

# Drain ambient chunks over adb.
#
# The rsync path needs the tailnet up and Termux's sshd running, and both are
# routinely down at once -- the tailnet needs its own restart after a reboot,
# and sshd only runs while Termux does. That is the same dependency the capture
# app was written to escape, and leaving it in the drain means audio the app
# reliably records still cannot reach the lake. adb is a second transport with
# a different failure mode: over USB it works when the network does not.
#
# Copies only what the lake does not already hold, and never deletes on the
# phone -- the rsync path's `--ignore-existing` semantics, kept deliberately so
# whichever transport ran last does not change what the other one will do.
drain_ambient_adb() {
  local dest name local_size remote_size pulled=0 repaired=0
  adb_resolve || return 1
  dest="$LAKE_ROOT/ambient"
  mkdir -p "$dest"
  while IFS= read -r name; do
    case "$name" in
      '' | *.part | status.json*) continue ;;
    esac
    remote_size=$(adb_any shell "stat -c %s '/sdcard/sinnix-ambient/$name'" 2>/dev/null </dev/null | tr -d '\r')
    if [ -e "$dest/$name" ]; then
      # A closed chunk never changes, so a lake copy smaller than the phone's
      # is a transfer that was cut short, not a different recording. Skipping
      # anything already present would leave it truncated permanently; the
      # lake held one such chunk at 311392 of 1844320 bytes.
      local_size=$(stat -c %s "$dest/$name" 2>/dev/null || echo 0)
      if [ -z "$remote_size" ] || [ "$local_size" -ge "$remote_size" ]; then
        continue
      fi
      if adb_any pull "/sdcard/sinnix-ambient/$name" "$dest/$name" >/dev/null 2>&1; then
        repaired=$((repaired + 1))
      fi
      continue
    fi
    if adb_any pull "/sdcard/sinnix-ambient/$name" "$dest/$name" >/dev/null 2>&1; then
      pulled=$((pulled + 1))
    fi
  done < <(adb_any shell 'ls /sdcard/sinnix-ambient/' 2>/dev/null | tr -d '\r')
  echo "ambient: drained $pulled new chunk(s) over adb, repaired $repaired truncated"
}

# Device-side rotation for the adb transport.
#
# The rsync path uses --remove-source-files, which unlinks a source only after
# rsync has confirmed the destination matches. This reproduces that guarantee
# rather than trusting the pull's exit status: a chunk is removed from the
# phone only when the lake holds a file of identical, non-zero size. Anything
# that fails the comparison stays on the device, where the next drain can try
# again -- the failure mode is a full /sdcard, not lost audio.
# Collect the app's own estate: its event log and anything queued for prime.
#
# The audio lane is not the whole capture any more. The app records what it
# observed -- chunk closes, holes, grant transitions, sensor windows,
# instrument runs -- into append-only day files, and that record is what makes
# prime able to score rather than merely store. Left on the phone it is a
# diary nobody reads.
#
# Today's event file is copied and LEFT IN PLACE: it is still being appended
# to, and taking it would truncate the day at whatever second the drain ran.
# Older day files are complete, so they are moved. Outbox entries are one-shot
# requests and are moved as soon as the lake holds them.
drain_estate() {
  local dest today name pulled=0
  dest="$LAKE_ROOT/estate"
  mkdir -p "$dest/events" "$dest/outbox"
  today="events-$(date -u +%Y%m%d).jsonl"

  if [ "${1:-}" = "ssh" ]; then
    rsync -a --ignore-existing -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-phone/events/" "$dest/events/" 2>/dev/null || true
    rsync -a --remove-source-files -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-phone/outbox/" "$dest/outbox/" 2>/dev/null || true
    # Today's file is re-copied every drain because it grew; --ignore-existing
    # above would keep the first, shorter version forever.
    rsync -a -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-phone/events/$today" "$dest/events/" 2>/dev/null || true
    echo "estate: drained over ssh"
    return 0
  fi

  adb_resolve || return 1
  for sub in events outbox; do
    while IFS= read -r name; do
      [ -z "$name" ] && continue
      if adb_any pull "/sdcard/sinnix-phone/$sub/$name" "$dest/$sub/$name" >/dev/null 2>&1; then
        pulled=$((pulled + 1))
        # Never delete the file still being written; every other one has been
        # confirmed present in the lake by the pull that just succeeded.
        if [ "$sub" = "outbox" ] || [ "$name" != "$today" ]; then
          adb_any shell "rm -f '/sdcard/sinnix-phone/$sub/$name'" >/dev/null 2>&1 </dev/null
        fi
      fi
    done < <(adb_any shell "ls /sdcard/sinnix-phone/$sub/ 2>/dev/null" 2>/dev/null </dev/null | tr -d '\r')
  done
  echo "estate: drained $pulled file(s) over adb"
}

# Push prime's half of the estate to the phone.
#
# The drain was pull-only, and that asymmetry is what made the steering
# surfaces unbuildable: the phone can render a ready queue it has, and it had
# no way to ever have one. This is the return channel, and it is deliberately
# files rather than a listening port -- the phone leaves the house, roams
# networks, and spends most of its life unreachable, and a file that arrives
# whenever contact happens survives all three.
#
# What goes down: glance.json and steering.json (state, replaced every drain),
# receipts and notifications (one-shot, deleted by the app once shown), and
# drill decks (data that turns into instruments).
push_estate() {
  local src="$PHONE_STATE/inbox"
  sinnix-phone-dispatcher push >/dev/null 2>&1 || true
  [ -d "$src" ] || return 0

  if [ "${1:-}" = "ssh" ]; then
    ssh_phone "mkdir -p /sdcard/sinnix-phone/inbox/receipts /sdcard/sinnix-phone/inbox/notify /sdcard/sinnix-phone/inbox/decks" >/dev/null 2>&1 || true
    # State: replaced every drain, so a plain copy is right. glance.json and
    # steering.json are snapshots -- the phone should always hold the newest.
    rsync -a --exclude='receipts/' --exclude='notify/' -e "$rsync_ssh" \
      "$src/" "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-phone/inbox/" 2>/dev/null || true
    # One-shots: handed over, not shared. --remove-source-files unlinks a source
    # only after rsync has confirmed the destination matches, which is the same
    # guarantee the adb path reproduces by hand. Without it prime keeps every
    # receipt forever and re-pushes it on every drain, and since the app deletes
    # each one as it renders it, the operator gets the same notification again
    # every half hour -- observed: one voice receipt shown twice, 99 seconds
    # apart, from a single scoring run.
    for one in receipts notify; do
      [ -d "$src/$one" ] || continue
      rsync -a --remove-source-files -e "$rsync_ssh" \
        "$src/$one/" "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-phone/inbox/$one/" 2>/dev/null || true
    done
    echo "estate: pushed over ssh"
    return 0
  fi

  adb_resolve || return 1
  adb_any shell "mkdir -p /sdcard/sinnix-phone/inbox/receipts /sdcard/sinnix-phone/inbox/notify /sdcard/sinnix-phone/inbox/decks" >/dev/null 2>&1 </dev/null
  local pushed=0 rel
  # `adb push <dir>` merges rather than mirrors, which is what is wanted here:
  # the app deletes each receipt as it renders it, and a mirroring push would
  # resurrect every receipt the operator has already seen.
  while IFS= read -r file; do
    rel="${file#"$src"/}"
    if adb_any push "$file" "/sdcard/sinnix-phone/inbox/$rel" >/dev/null 2>&1; then
      pushed=$((pushed + 1))
      # One-shots are handed over, not shared: leaving a receipt on prime after
      # the phone holds it would re-deliver it on the next drain forever.
      case "$rel" in
        receipts/* | notify/*) rm -f "$file" ;;
      esac
    fi
  done < <(find "$src" -type f ! -name '*.part')
  echo "estate: pushed $pushed file(s) over adb"
}

# Hand collected intents to prime.
#
# Runs after the collect half, on whatever the drain just landed. The
# dispatcher is idempotent on send_token, so an intent that also went out live
# executes once and still gets its receipt -- which is why this can run
# unconditionally rather than trying to work out what the phone already did.
dispatch_intents() {
  sinnix-phone-dispatcher dispatch --outbox "$LAKE_ROOT/estate/outbox" || true
}

rotate_ambient_adb() {
  local dest name local_size remote_size removed=0
  adb_resolve || return 1
  dest="$LAKE_ROOT/ambient"
  while IFS= read -r name; do
    case "$name" in
      '' | *.part | status.json*) continue ;;
    esac
    [ -f "$dest/$name" ] || continue
    local_size=$(stat -c %s "$dest/$name" 2>/dev/null || echo 0)
    # `adb shell` reads stdin, and this loop's stdin is the file list; without
    # the redirect it consumes the list and the loop ends after one chunk.
    remote_size=$(adb_any shell "stat -c %s '/sdcard/sinnix-ambient/$name'" 2>/dev/null </dev/null | tr -d '\r')
    if [ -n "$remote_size" ] && [ "$remote_size" -gt 0 ] && [ "$local_size" = "$remote_size" ]; then
      adb_any shell "rm -f '/sdcard/sinnix-ambient/$name'" >/dev/null 2>&1 </dev/null && removed=$((removed + 1))
    fi
  done < <(adb_any shell 'ls /sdcard/sinnix-ambient/' 2>/dev/null | tr -d '\r')
  echo "ambient: released $removed chunk(s) from the phone (verified in the lake)"
}

usage() {
  cat <<'EOF'
sinnix-phone <command>

  status        tailnet reachability, adb + ssh liveness, capture app,
                battery, storage
  app-status    ambient capture liveness: heartbeat age, recording state,
                and the newest closed chunk's real duration and volume
  app-install   build, sign, and sideload the capture app, then grant and
                start it (needs adb: USB or tailnet)
  app-start     launch the app so its capture service comes back up
  app-grants    re-assert the shell-uid grants the app needs
  app-soak [s]  acceptance test: sample screen/foreground/mute state over a
                window, then measure every chunk closed in it (default 1200s)
  shell [cmd]   Termux shell over the tailnet (interactive when no cmd)
  mirror        scrcpy screen mirror/control over the tailnet
  screenshot    grab the current screen to /realm/tmp/work/
  pull          rsync camera + downloads + health exports into the lake
  ambient-audit decode every undecoded ambient chunk in the lake and record
                its real duration and level (runs at the end of `pull`)
  drain         pull, but only if the phone is on wifi (for a timer)
  push          refresh and send prime's estate half to the phone (no pull)
  adb-connect   (re)attach adb over the tailnet
  adb-restore   re-enable adbd TCP mode (requires the phone on USB), then
                re-assert the capture app's grants (see app-grants)
  clip-push     push the current desktop clipboard to the phone, once
  clip-watch    watch desktop clipboard, push on change (foreground loop)
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
status)
  echo "== phone =="
  # TCP, not ICMP: a dozing Android drops pings while still accepting
  # connections, so ping reports a false outage on a working link.
  if timeout 5 bash -c "exec 3<>/dev/tcp/$PHONE_TS_IP/$PHONE_SSH_PORT" 2>/dev/null; then
    echo "tailnet   : reachable ($PHONE_TS_IP)"
  else
    echo "tailnet   : UNREACHABLE ($PHONE_TS_IP)"
  fi
  if ssh_phone 'true' >/dev/null 2>&1; then
    echo "ssh       : up (termux :$PHONE_SSH_PORT) — drain transport"
  else
    echo "ssh       : down — drain blocked; open Termux, run: sshd"
  fi
  "$0" app-status
  ensure_adb
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    echo "adb       : up ($ADB_TARGET)"
    lvl=$(adb_phone shell dumpsys battery 2>/dev/null | awk -F': ' '/ level/{print $2}' | tr -d '\r')
    free=$(adb_phone shell df -h /sdcard 2>/dev/null | awk 'END{print $4}' | tr -d '\r')
    echo "battery   : ${lvl:-?}%"
    echo "sdcard    : ${free:-?} free"
  else
    echo "adb       : down — run: sinnix-phone adb-restore (needs USB)"
  fi
  ;;
app-status)
  # Ambient capture liveness, as reported by the capture app itself.
  #
  # Two independent readings, because either one alone lies. status.json says
  # what the app believes; its own staleness says whether the app is still
  # there to believe anything. And neither answers whether the bytes are
  # audio, so the newest CLOSED chunk is measured with ffprobe -- a recorder
  # muted by the platform still produces a file every five minutes, which is
  # exactly how the truncation bug hid.
  echo "== capture app =="
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app       : UNKNOWN — no adb transport (tailnet down and no USB cable?)"
    exit 0
  fi
  installed=$(adb_any shell pm list packages "$APP_ID" 2>/dev/null | tr -d '\r')
  if [ -z "$installed" ]; then
    echo "app       : NOT INSTALLED — run: sinnix-phone app-install"
    exit 0
  fi
  status_json=$(adb_any shell cat "/sdcard/sinnix-ambient/status.json" 2>/dev/null | tr -d '\r')
  if [ -z "$status_json" ] || ! echo "$status_json" | jq -e . >/dev/null 2>&1; then
    echo "app       : installed, but no readable status.json — service never started?"
    echo "            run: sinnix-phone app-start"
    exit 0
  fi

  updated=$(echo "$status_json" | jq -r '.updated_at')
  age=$(( $(date -u +%s) - $(date -u -d "$updated" +%s) ))
  recording=$(echo "$status_json" | jq -r '.recording')
  shared=$(echo "$status_json" | jq -r '.chunk_dir_is_shared')
  echo "app       : $(echo "$status_json" | jq -r '.package') v$(echo "$status_json" | jq -r '.app_version')"
  # The app refreshes status.json every 20s while alive, so anything past a
  # couple of minutes means the process is gone, not merely idle.
  if [ "$age" -gt 120 ]; then
    echo "heartbeat : STALE — ${age}s since last update (app not running)"
  else
    echo "heartbeat : ${age}s ago"
  fi
  echo "recording : $recording (chunk $(echo "$status_json" | jq -r '.current_chunk_elapsed_seconds')s/$(echo "$status_json" | jq -r '.chunk_seconds_target')s, $(echo "$status_json" | jq -r '.chunks_closed') closed since start)"
  if [ "$shared" != "true" ]; then
    echo "chunk dir : $(echo "$status_json" | jq -r '.chunk_dir') — NOT drainable, all-files access missing"
  fi
  failures=$(echo "$status_json" | jq -r '.failures')
  if [ "$failures" != "0" ]; then
    echo "failures  : $failures — last: $(echo "$status_json" | jq -r '.last_error')"
  fi

  latest_chunk=$(adb_any shell "ls -1t /sdcard/sinnix-ambient/*.m4a 2>/dev/null | head -1" | tr -d '\r')
  if [ -n "${latest_chunk:-}" ]; then
    tmp_chunk="$(mktemp --suffix=.m4a)"
    if adb_any pull "$latest_chunk" "$tmp_chunk" >/dev/null 2>&1; then
      dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$tmp_chunk" 2>/dev/null || true)
      # volumedetect reports at info level, so -v error (the right choice for
      # ffprobe above) would silently swallow the number and leave the
      # silence check permanently blank.
      vol=$(ffmpeg -hide_banner -nostats -v info -i "$tmp_chunk" -af volumedetect -f null - 2>&1 | awk -F': ' '/mean_volume/{print $2}')
      echo "last chunk: $(basename "$latest_chunk") (${dur:-?}s, expect ~${AMBIENT_CHUNK_SECONDS:-300}s; mean ${vol:-?})"
    else
      echo "last chunk: $(basename "$latest_chunk") (couldn't pull to measure)"
    fi
    rm -f "$tmp_chunk"
  else
    # No closed chunk on the phone is the NORMAL state after a successful
    # drain, not a sign of trouble -- rotation removes each chunk once the
    # lake holds it. Fall back to the lake's own measurement so this line
    # keeps answering "is the audio real", which is what it is for.
    ledger="$LAKE_ROOT/ambient-levels.jsonl"
    last_measured=$(jq -rs 'group_by(.chunk) | map(last) | sort_by(.chunk) | last //
      empty | "\(.chunk) (\(.duration_seconds // "?")s; mean \(.mean_db // "?") dB)"' \
      "$ledger" 2>/dev/null)
    if [ -n "$last_measured" ]; then
      echo "last chunk: none on the phone (drained); newest in the lake: $last_measured"
    else
      echo "last chunk: none closed yet"
    fi
  fi
  ;;
app-install)
  # Sideload the capture app and re-assert the shell-uid grants. Safe to
  # re-run: a stable signing key makes this an upgrade, so runtime grants and
  # the capture-enabled preference survive.
  #
  # THE PHONE MUST BE UNLOCKED. MIUI routes every adb install through its own
  # com.miui.permcenter.install.AdbInstallActivity confirmation dialog, which
  # cannot be shown over the keyguard, so the install is auto-cancelled with
  # INSTALL_FAILED_USER_RESTRICTED. Nothing on this side can work around it.
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app-install: no adb transport — plug in USB or run adb-restore" >&2
    exit 1
  fi
  serial=$(adb_any shell getprop ro.serialno 2>/dev/null | tr -d '\r')
  echo "installing to ${serial:-unknown device}"
  install_log="$(mktemp)"
  if ! ANDROID_SERIAL="$serial" nix run "${SINNIX_FLAKE_DIR:-/realm/project/sinnix}#sinnix-phone-app-install" 2>&1 | tee "$install_log"; then
    :
  fi
  if grep -q INSTALL_FAILED_USER_RESTRICTED "$install_log"; then
    rm -f "$install_log"
    echo >&2
    echo "app-install: MIUI refused the install (INSTALL_FAILED_USER_RESTRICTED)." >&2
    echo "  Unlock the phone screen and run this again. MIUI shows its own adb" >&2
    echo "  install confirmation, and that dialog cannot appear over the keyguard." >&2
    exit 1
  fi
  rm -f "$install_log"
  ensure_app_grants
  "$0" app-start

  # Retire Termux's runit `ambient` service, the previous recorder. Both
  # recorders can hold the microphone at once -- measured: two AudioRecord
  # clients, both State: Active, on separate input ports -- so the harm is not
  # contention but provenance: they write the same `ambient-<UTC>.m4a` shape
  # into the same directory, and the drain cannot tell whose chunk is whose.
  #
  # Over adb, not ssh: the install that just ran needs adb, while the phone's
  # sshd is usually down, so an ssh-only retirement silently no-ops in exactly
  # the case that reaches this line. Stopping the supervisor is not enough
  # either -- `termux-microphone-record` is a separate Termux:API process and
  # keeps the microphone until it is told to quit. `sv d` alone is not enough
  # for the same reason: the run script ignores the TERM it sends and was
  # observed opening a fresh recording six minutes later, so `sv k` follows it.
  # The `down` file is what makes the retirement survive a reboot. Termux
  # itself is left running -- its sshd is the transport the lake drain uses.
  echo "retiring the Termux recorder"
  termux_prefix=/data/data/com.termux/files/usr
  termux_retire="export PREFIX=$termux_prefix LD_LIBRARY_PATH=$termux_prefix/lib \
PATH=$termux_prefix/bin:\$PATH HOME=/data/data/com.termux/files/home; \
touch $termux_prefix/var/service/ambient/down; \
sv d $termux_prefix/var/service/ambient >/dev/null 2>&1; \
sv k $termux_prefix/var/service/ambient >/dev/null 2>&1; \
termux-microphone-record -q >/dev/null 2>&1; true"
  if adb_any shell "run-as com.termux sh -c '$termux_retire'" >/dev/null 2>&1; then
    echo "  Termux ambient service is down and will stay down across reboots"
  elif ssh_phone "$termux_retire" >/dev/null 2>&1; then
    echo "  Termux ambient service is down and will stay down across reboots"
  else
    echo "  WARNING: the Termux recorder could not be stopped over adb or ssh." >&2
    echo "  If it is still running, it will write chunks the drain cannot" >&2
    echo "  distinguish from the app's. Check: sinnix-phone app-status" >&2
  fi
  ;;
app-start)
  # Starting the foreground service directly from adb is refused (the service
  # is not exported, and exporting it would let any app on the phone drive the
  # microphone). Launching the activity is permitted and starts the service
  # from inside the app, which is why the app has a headless recovery path at
  # all -- the thing Termux never had.
  #
  # It is also the only path that gets the microphone back. A mic-typed
  # foreground service started from the BACKGROUND -- which is what
  # MY_PACKAGE_REPLACED does on every upgrade -- runs without the while-in-use
  # capability, and the platform silences its recording rather than failing it:
  # "App op 27 missing, silencing record" in logcat, exact zeroes in the file,
  # and a status.json that says recording=true throughout. Bringing an activity
  # to the foreground is what grants the capability.
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app-start: no adb transport" >&2
    exit 1
  fi
  # NOT redirected to /dev/null. `am start` reports a missing activity in its
  # own output with exit status 0, so a silent launch turns a renamed activity
  # into a capture outage nobody is told about -- which is exactly what
  # happened when the app's launcher moved to .ui.MainActivity.
  start_out=$(adb_any shell am start -n "$APP_ID/$APP_ACTIVITY" 2>&1 | tr -d '\r')
  if printf '%s' "$start_out" | grep -qi 'error'; then
    echo "app-start: could not launch $APP_ID/$APP_ACTIVITY" >&2
    printf '%s\n' "$start_out" >&2
    exit 1
  fi
  sleep 4
  "$0" app-status
  ;;
app-soak)
  # Acceptance test for both hard cases at once: capture must survive the
  # screen being off AND the phone being actively used. The second is the
  # operator's flat requirement -- "capture not working when telephone is
  # handled is not acceptable" -- and it is a genuinely different test, since
  # foregroundServiceType="microphone" buys background mic access but does
  # NOT win Android's concurrent-capture arbitration against a foreground app.
  #
  # Runs a window, samples what the phone was actually doing throughout (so
  # "the phone was in use" is evidence rather than a claim), then measures
  # every chunk closed inside it. Duration catches truncation; mean volume
  # catches a stream that encoded at full bitrate out of a muted microphone.
  seconds="${1:-1200}"
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app-soak: no adb transport" >&2
    exit 1
  fi
  start_epoch=$(date -u +%s)
  echo "== soak: ${seconds}s window, started $(date -u -d "@$start_epoch" +%H:%M:%SZ) =="
  echo "use the phone during this window -- open apps, type, play audio, take a call"
  echo
  printf '%-10s %-9s %-6s %-7s %-7s %-10s %s\n' \
    TIME SCREEN AGE RECORD MUTED AMPLITUDE FOREGROUND
  while [ "$(date -u +%s)" -lt "$((start_epoch + seconds))" ]; do
    soak_status=$(adb_any shell cat /sdcard/sinnix-ambient/status.json 2>/dev/null | tr -d '\r')
    wake=$(adb_any shell dumpsys power 2>/dev/null | awk -F= '/mWakefulness=/{print $2; exit}' | tr -d '\r')
    # Both spellings: dumpsys prints topResumedActivity in some states and only
    # ResumedActivity in others (notably behind the keyguard).
    top=$(adb_any shell dumpsys activity activities 2>/dev/null \
      | awk -F'u0 ' '/[tT]opResumedActivity|ResumedActivity:/{print $2; exit}' \
      | awk '{print $1}' | tr -d '\r}')
    if echo "$soak_status" | jq -e . >/dev/null 2>&1; then
      # Heartbeat age, not just the file's contents. A status.json left behind
      # by a dead app still says recording=true forever, which is precisely
      # the false-liveness reading this whole test exists to disprove.
      age=$(( $(date -u +%s) - $(date -u -d "$(echo "$soak_status" | jq -r '.updated_at')" +%s) ))
      if [ "$age" -gt 120 ]; then
        printf '%-10s %-9s %-6s %s\n' "$(date -u +%H:%M:%SZ)" "${wake:-?}" "${age}s" \
          "STALE -- app is not running, everything below it is a leftover"
      else
        printf '%-10s %-9s %-6s %-7s %-7s %-10s %s\n' \
          "$(date -u +%H:%M:%SZ)" "${wake:-?}" "${age}s" \
          "$(echo "$soak_status" | jq -r '.recording')" \
          "$(echo "$soak_status" | jq -r '.muted // "n/a"')" \
          "$(echo "$soak_status" | jq -r '.last_amplitude // "n/a"')" \
          "${top:-?}"
      fi
    else
      printf '%-10s %-9s %s\n' "$(date -u +%H:%M:%SZ)" "${wake:-?}" "NO STATUS -- app not installed or never started"
    fi
    sleep 60
  done

  echo
  echo "== chunks closed during the window =="
  workdir=$(mktemp -d)
  printf '%-40s %10s %12s %s\n' CHUNK SECONDS BYTES MEAN_dB
  adb_any shell ls -1 /sdcard/sinnix-ambient/ 2>/dev/null | tr -d '\r' | grep -E '^ambient-.*\.m4a$' | while read -r f; do
    stamp="${f#ambient-}"; stamp="${stamp%.m4a}"
    fe=$(date -u -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s 2>/dev/null || echo 0)
    [ "$fe" -ge "$start_epoch" ] || continue
    adb_any pull "/sdcard/sinnix-ambient/$f" "$workdir/$f" >/dev/null 2>&1 || continue
    dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$workdir/$f" 2>/dev/null)
    vol=$(ffmpeg -nostdin -hide_banner -nostats -v info -i "$workdir/$f" -af volumedetect -f null - 2>&1 | awk -F': ' '/mean_volume/{print $2}')
    printf '%-40s %10s %12s %s\n' "$f" "${dur:-?}" "$(stat -c%s "$workdir/$f")" "${vol:-?}"
  done
  rm -rf "$workdir"
  echo
  echo "PASS: every chunk at/near ${AMBIENT_CHUNK_SECONDS:-300}s, mean volume well above"
  echo "digital silence, muted=false throughout, and a FOREGROUND column showing"
  echo "apps other than dev.sinnix.phone."
  ;;
app-grants)
  ensure_app_grants
  echo "grants re-asserted for $APP_ID"
  ;;
shell)
  if [ "$#" -eq 0 ]; then ssh_phone; else ssh_phone "$@"; fi
  ;;
mirror)
  ensure_adb
  exec scrcpy -s "$ADB_TARGET" --window-title "phone (tailnet)" "$@"
  ;;
screenshot)
  ensure_adb
  mkdir -p /realm/tmp/work
  out="/realm/tmp/work/phone-$(date +%Y%m%d-%H%M%S).png"
  adb_phone shell screencap -p /sdcard/.sinnix-shot.png
  adb_phone pull /sdcard/.sinnix-shot.png "$out" >/dev/null
  adb_phone shell rm -f /sdcard/.sinnix-shot.png
  echo "$out"
  ;;
pull)
  # Camera and downloads are the durable originals; the health-export folder
  # is where the Health Connect scheduled export lands.
  # Pull only — never push back, and never delete on the phone.
  mkdir -p "$LAKE_ROOT"/{camera,download,health,ambient}
  set +e
  # One reachability check for all four lanes. Without it each rsync spends its
  # own connect timeout failing the same way and prints the same error three
  # times before the ambient lane gets to try a transport that works.
  ssh_up=false
  ssh_phone 'true' >/dev/null 2>&1 && ssh_up=true
  if [ "$ssh_up" = true ]; then
    rsync -av --ignore-existing -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/DCIM/" "$LAKE_ROOT/camera/"
    rsync -av --ignore-existing -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/Download/" "$LAKE_ROOT/download/"
    rsync -av --ignore-existing -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/HealthConnectExport/" "$LAKE_ROOT/health/" 2>/dev/null
  else
    echo "ssh unavailable: camera, downloads and health exports need it and are skipped"
  fi
  # Continuous ambient audio chunks. The capture app names the file it is
  # still writing `*.m4a.part` and renames it only after the muxer closes,
  # so "closed" is an explicit state here rather than something inferred
  # from mtime ordering. status.json is device-side liveness, not lake
  # content, and must never be drained -- see the exclusions below.
  if [ "$ssh_up" = true ]; then
    rsync -av --ignore-existing --exclude='*.part' --exclude='status.json*' -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-ambient/" "$LAKE_ROOT/ambient/" 2>/dev/null
  elif adb_any get-state >/dev/null 2>&1; then
    echo "ssh unavailable; draining ambient over adb instead"
    drain_ambient_adb
  else
    echo "no transport to the phone: ambient chunks stay on the device" >&2
  fi
  if [ "$ssh_up" = true ]; then
    drain_estate ssh
    push_estate ssh
  elif adb_any get-state >/dev/null 2>&1; then
    drain_estate
    push_estate
  fi
  dispatch_intents
  set -e
  du -sh "$LAKE_ROOT" 2>/dev/null
  "$0" ambient-audit
  ;;
ambient-audit)
  # A chunk that captured nothing is byte-for-byte plausible: full bitrate,
  # exact duration, valid container. One was produced on 2026-08-13 while a
  # second recorder held the microphone, and neither the file size, the
  # duration, nor the container told anyone. Only decoding the samples does,
  # so the lake records the level at intake and a dead capture window becomes
  # something visible in the data rather than something to be suspected later.
  ledger="$LAKE_ROOT/ambient-levels.jsonl"
  mkdir -p "$LAKE_ROOT/ambient"
  touch "$ledger"
  # One pass to learn what has already been measured; re-decoding the whole
  # lake on every drain would grow without bound.
  # Keyed on size as well as name: a chunk repaired from a truncated transfer
  # keeps its name but is a different file, and its old measurement describes
  # audio that was never fully there.
  seen=$(jq -r '"\(.chunk) \(.bytes // 0)"' "$ledger" 2>/dev/null | sort -u)
  added=0
  silent=0
  while IFS= read -r chunk; do
    name=$(basename "$chunk")
    bytes=$(stat -c %s "$chunk" 2>/dev/null || echo 0)
    if printf '%s\n' "$seen" | grep -qxF "$name $bytes"; then
      continue
    fi
    # A chunk this tool cannot decode is a finding, not an error: `set -e`
    # plus `pipefail` would otherwise abort the whole audit on the first
    # truncated file, which is precisely the file worth recording.
    duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$chunk" 2>/dev/null </dev/null || true)
    rate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of default=nw=1:nk=1 "$chunk" 2>/dev/null </dev/null || true)
    levels=$(ffmpeg -nostdin -hide_banner -nostats -i "$chunk" -af volumedetect -f null - 2>&1 |
      awk '/mean_volume:/ {mean=$(NF-1)} /max_volume:/ {max=$(NF-1)} END {print mean, max}' || true)
    mean=${levels% *}
    max=${levels#* }
    # -91 dB is what a stream of exact zeroes decodes to; anything at or below
    # it captured no sound at all, however healthy the file looks.
    dead=false
    case "$max" in
      -9[1-9]*|-inf) dead=true; silent=$((silent + 1)) ;;
    esac
    jq -nc --arg chunk "$name" --argjson bytes "${bytes:-0}" --arg dur "${duration:-}" --arg rate "${rate:-}" \
      --arg mean "${mean:-}" --arg max "${max:-}" --argjson dead "$dead" \
      '{chunk: $chunk, bytes: $bytes, duration_seconds: ($dur | tonumber? // null),
        sample_rate: ($rate | tonumber? // null),
        mean_db: ($mean | tonumber? // null), max_db: ($max | tonumber? // null),
        captured_nothing: $dead}' >>"$ledger"
    added=$((added + 1))
  done < <(find "$LAKE_ROOT/ambient" -maxdepth 1 \( -name '*.m4a' -o -name '*.m4a.orphan' \) | sort)
  echo "ambient-audit: measured $added new chunk(s), $silent captured nothing"
  # The ledger is append-only and a chunk may be measured more than once (a
  # repaired transfer is a different file under the same name), so the newest
  # record per chunk is the true one. Report that rather than raw line counts,
  # which overstate the lake by however many re-measurements have happened.
  jq -rs 'group_by(.chunk) | map(last)
    | "  lake now: \(length) chunks, \([.[] | select(.captured_nothing)] | length) captured nothing, \(([.[] | select(.captured_nothing | not) | .duration_seconds // 0] | add / 3600 * 10 | round / 10)) hours of real audio"' \
    "$ledger" 2>/dev/null || true
  if [ "$silent" -gt 0 ]; then
    echo "  silent chunks are listed in $ledger (captured_nothing: true)" >&2
  fi
  ;;
drain)
  # Drains the raw-audio tier: large and not time-critical, so it is
  # wifi-gated. Deliberately not charging-gated -- this is a network-cost
  # gate, not a battery one.
  if ! timeout 5 bash -c "exec 3<>/dev/tcp/$PHONE_TS_IP/$PHONE_SSH_PORT" 2>/dev/null; then
    # No tailnet. That is the normal state after a phone reboot and whenever
    # Termux is not running, and it used to end the drain -- so audio the app
    # had recorded correctly sat on the device indefinitely. adb is a separate
    # transport: if it answers (USB, typically), drain through it. The wifi
    # gate below exists to keep a large transfer off metered data, and a USB
    # cable is not metered, so it does not apply here.
    if adb_any get-state >/dev/null 2>&1; then
      echo "drain: no tailnet, draining over adb"
      "$0" pull
      rotate_ambient_adb
      exit 0
    fi
    echo "drain: phone unreachable, skipping"
    exit 0
  fi
  ensure_adb
  wifi_state=$(ssh_phone termux-wifi-connectioninfo 2>/dev/null | jq -r '.supplicant_state // empty')
  if [ "$wifi_state" != "COMPLETED" ]; then
    echo "drain: not on wifi (state: ${wifi_state:-unknown}), skipping"
    exit 0
  fi
  echo "drain: wifi confirmed, pulling"
  "$0" pull

  # Device-side rotation: the phone needs a ring that provably never deletes
  # a chunk the lake hasn't taken. --remove-source-files removes a source
  # file only once rsync has confirmed it matches the destination -- whether
  # that confirmation happened just now or on an earlier run -- so this is
  # safe to run standalone. Scoped to ambient only: camera/downloads/health
  # are the operator's originals, not a rotating buffer.
  #
  # The exclusions are load-bearing rather than cosmetic. --remove-source-files
  # deletes each source once it is confirmed transferred; applied to the chunk
  # the recorder currently holds open, that unlinks the file out from under a
  # live descriptor and the trailing moov atom is written into nothing, losing
  # the chunk. And deleting status.json would erase the phone's own liveness
  # report every time a drain ran.
  mkdir -p "$LAKE_ROOT/ambient"
  rsync -a --remove-source-files --exclude='*.part' --exclude='status.json*' -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-ambient/" "$LAKE_ROOT/ambient/" 2>/dev/null

  # A soft ring bounded by drain cadence, not a hard size cap. If drains
  # stop happening for an extended stretch, on-device growth is genuinely
  # unbounded -- surface that rather than trusting the cadence to hold.
  used_kb=$(ssh_phone "du -sk /sdcard/sinnix-ambient 2>/dev/null" | awk '{print $1}')
  if [ -n "${used_kb:-}" ] && [ "$used_kb" -gt 512000 ]; then
    echo "drain: WARNING -- /sdcard/sinnix-ambient is ${used_kb}KB and not shrinking after rotation; drains may have stalled"
  fi
  ;;
push)
  # The push half on its own, for when something on prime should reach the
  # phone now rather than at the next drain -- a receipt worth interrupting
  # for, a deck just generated.
  if ssh_phone 'true' >/dev/null 2>&1; then
    push_estate ssh
  elif adb_any get-state >/dev/null 2>&1; then
    push_estate
  else
    echo "push: phone unreachable; the next drain will carry it" >&2
    sinnix-phone-dispatcher push >/dev/null 2>&1 || true
  fi
  ;;
adb-connect)
  adb connect "$ADB_TARGET"
  ;;
adb-restore)
  echo "Phone must be on USB with debugging authorized."
  adb devices
  adb tcpip 5555
  sleep 3
  adb connect "$ADB_TARGET"
  ensure_app_grants
  ;;
clip-push)
  # text/* only -- termux-clipboard-set takes a string argument; pushing raw
  # image bytes (a screenshot copy, the common non-text case) would either
  # error or silently set garbage text, so skip non-text content instead.
  mime="$(wl-paste --list-types 2>/dev/null | head -1)"
  case "$mime" in
    text/*|"")
      text="$(wl-paste -n 2>/dev/null || true)"
      [ -n "$text" ] || exit 0
      ssh_phone "termux-clipboard-set" -- "$text" 2>/dev/null || true
      ;;
    *) : ;; # non-text clipboard (image, etc.) -- nothing to push
  esac
  ;;
clip-watch)
  # Foreground loop, run under systemd (Type=simple). wl-paste -w blocks
  # until the clipboard changes, so this is push-triggered, not polled. No
  # loop-guard needed: this direction never writes back to the desktop
  # clipboard, so there is nothing to echo.
  exec wl-paste --watch "$0" clip-push
  ;;
*)
  usage
  exit 1
  ;;
esac
