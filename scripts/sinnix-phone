#!/usr/bin/env bash
# @sinnix-package
# description: Reach the phone over the tailnet — status, shell, screen mirror, media pull, clipboard push
# runtimeInputs: bash python3 coreutils util-linux openssh rsync android-tools scrcpy iputils jq wl-clipboard gawk ffmpeg curl tailscale debootstrap zip avahi @sinnix-phone-dispatcher @sinnix-remote-command @sinnix-phone-keyguard

#
# Device control uses authenticated Android wireless debugging. Its connection
# port changes; discover the enrolled phone with Avahi rather than assuming 5555.
# USB remains a recovery route. `adb-restore` enables wireless debugging through
# an authorized USB connection without opening legacy TCP debugging.
#
# Ambient audio and durable delivery are produced by the native Sinnix app,
# not by Termux. Termux remains an emergency shell and clipboard surface, but
# it cannot hold the microphone: only an app declaring
# foregroundServiceType="microphone" keeps recording once the screen goes off,
# which is why the Termux recorder truncated chunks and never came back after
# a reboot (sinnix-hcjq). `app-install` retires Termux's runit `ambient`
# service with a `down` file so the two never contend for the mic.
#
# Clipboard is one-way (desktop -> phone). Android blocks clipboard READS
# from a backgrounded app (since Android 10): `termux-clipboard-get`
# silently returns empty unless Termux is the foreground app.
# `termux-clipboard-set` has no such restriction. Phone->desktop sync would
# need Termux kept foregrounded or an AccessibilityService-based reader.
# PRIMARY has no Android equivalent; this covers CLIPBOARD only.
set -euo pipefail
umask 077

# Where the phone is, in preference order, not where it is assumed to be.
#
# The tailnet address used to be the only one. That made a dropped VPN sever
# every lane at once -- drain, stream and dispatcher -- while the phone sat on
# the same desk, healthy, still recording. Resolution now tries the tailnet
# first (it works off-wifi, which the LAN paths cannot), then mDNS, then the
# last address that worked, then a LAN sweep for an authenticated phone.
# SINNIX_PHONE_IP still overrides address selection; SSH still verifies identity.
PHONE_TS_IP_DEFAULT="100.111.240.107"
PHONE_MDNS_NAME="${SINNIX_PHONE_MDNS:-redmi-note-11.local}"
PHONE_HOST_CACHE="${SINNIX_PHONE_STATE_DIR:-/realm/state/sinnix-phone}/last-host"

PHONE_SSH_PORT="${SINNIX_PHONE_SSH_PORT:-8022}"
PHONE_USER="${SINNIX_PHONE_USER:-u0_a460}"

# -F /dev/null + explicit identity, not ~/.ssh/config: under a sandboxed
# systemd unit's ProtectHome, ssh rejects the Home-Manager ~/.ssh/config
# symlink outright ("Bad owner or permissions", exit 255). A script invoked
# by both a human and a timer should not depend on interactive config.
ssh_phone_opts=(
  # -o Port=, not -p: the array must stay safe for every OpenSSH tool --
  # scp's -p means "preserve file attributes" (a no-arg flag), not port, so
  # `-p 8022` would silently misparse 8022 as a stray filename argument.
  # -o Port= means the same thing everywhere.
  -o "Port=$PHONE_SSH_PORT"
  -F /dev/null
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=yes
  -o HostKeyAlias=sinnix-phone
  -o "UserKnownHostsFile=${SINNIX_PHONE_KNOWN_HOSTS:-${SINNIX_PHONE_STATE_DIR:-/realm/state/sinnix-phone}/known_hosts}"
  -o IdentitiesOnly=yes
  # ssh-agent can hold a key that LOOKS like a match and still answer
  # "signing failed... agent refused operation". IdentitiesOnly=yes restricts
  # which identity FILES are tried but does not stop the agent being asked
  # first, so go straight to the key file; this identity doesn't need
  # agent-forwarding semantics.
  -o IdentityAgent=none
  -i "${SINNIX_PHONE_IDENTITY:-$HOME/.ssh/id_ed25519}"
  # Connection multiplexing: raw tailnet RTT to the phone is ~4-11ms but a
  # cold SSH handshake is ~380-586ms, and multi-step commands (`pull`,
  # `status`) pay that 2-4x sequentially. ControlMaster reuses one
  # authenticated connection for payload ssh/scp calls in an invocation;
  # discovery disables reuse to verify each candidate connection afresh.
  # ControlPersist=120 keeps it alive across quick successive commands
  # without lingering on a device that roams networks. %C is ssh's
  # single-token hash of user+host+port, so the socket path can't grow
  # unboundedly long.
  -o ControlMaster=auto
  -o ControlPersist=120
  -o "ControlPath=${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}/%C"
)
mkdir -p "${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}"

# Re-enrolling the Android client creates a new Tailscale node identity and
# therefore a new 100.64/10 address. Resolve the currently-online Android peer
# by its stable device hostname before consulting any remembered address; the
# numeric default is only the final diagnostic fallback when tailscaled is not
# available locally.
tailscale_phone_ip() {
  tailscale status --json 2>/dev/null \
    | jq -r '
        [.Peer[]
          | select(.Online == true and .OS == "android" and .HostName == "Redmi Note 11")
          | .TailscaleIPs[]
          | select(test("^[0-9]+\\."))][0] // empty
      ' 2>/dev/null
}

# Reachability is not identity. Authenticate each candidate against the
# phone's pinned host key before selecting or remembering its address. The
# pin is enrolled through an authenticated device connection, never a scan.
phone_answers() {
  local host="$1"
  timeout 2 bash -c "exec 3<>/dev/tcp/$host/$PHONE_SSH_PORT" 2>/dev/null || return 1
  ssh -o BatchMode=yes -o ControlMaster=no -o ControlPath=none \
    "${ssh_phone_opts[@]}" "${PHONE_USER}@${host}" true >/dev/null 2>&1
}

resolve_phone_host() {
  local candidate cached tailnet
  if [ -n "${SINNIX_PHONE_IP:-}" ]; then
    echo "$SINNIX_PHONE_IP"
    return 0
  fi
  cached="$(cat "$PHONE_HOST_CACHE" 2>/dev/null || true)"
  tailnet="$(tailscale_phone_ip || true)"
  for candidate in "$tailnet" "$PHONE_TS_IP_DEFAULT" "$PHONE_MDNS_NAME" $cached; do
    [ -n "$candidate" ] || continue
    if phone_answers "$candidate"; then
      mkdir -p "$(dirname "$PHONE_HOST_CACHE")" 2>/dev/null || true
      echo "$candidate" >"$PHONE_HOST_CACHE" 2>/dev/null || true
      echo "$candidate"
      return 0
    fi
  done
  # LAN sweep, last: every candidate must authenticate before it can win.
  # It runs only once the addressed paths have all failed.
  local subnet ip
  subnet="$(ip -4 -o route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}' | cut -d. -f1-3)"
  if [ -n "$subnet" ]; then
    for ip in $(seq 2 254); do
      ( phone_answers "$subnet.$ip" && echo "$subnet.$ip" ) &
    done | head -1 | while IFS= read -r found; do
      [ -n "$found" ] || continue
      mkdir -p "$(dirname "$PHONE_HOST_CACHE")" 2>/dev/null || true
      echo "$found" >"$PHONE_HOST_CACHE" 2>/dev/null || true
      echo "$found"
      return 0
    done
    wait 2>/dev/null || true
  fi
  # Nothing answered. Return the tailnet address so callers fail against a
  # meaningful target and their own timeouts report it.
  echo "$PHONE_TS_IP_DEFAULT"
  return 1
}

PHONE_TS_IP="${SINNIX_PHONE_IP:-$(tailscale_phone_ip || true)}"
PHONE_TS_IP="${PHONE_TS_IP:-$PHONE_TS_IP_DEFAULT}"
PHONE_SSH_HOST=""
ADB_TARGET=""
LAKE_ROOT="${SINNIX_PHONE_LAKE:-/realm/device/shared/phone}"
PHONE_STATE="${SINNIX_PHONE_STATE_DIR:-/realm/state/sinnix-phone}"

# Same flags as a single shell-word, for rsync -e (which needs a word, not
# an array) -- computed once at top level so every case branch can use it,
# including a `"$0" subcmd` re-invocation, which is a separate process.
rsync_ssh="ssh ${ssh_phone_opts[*]}"
# Raw command text is reserved for fixed scripts and the explicit shell command.
ssh_phone() {
  # Device-only commands need no Termux discovery. Resolve authenticated SSH
  # routing only when a command actually asks for that transport.
  if [ -z "$PHONE_SSH_HOST" ]; then
    PHONE_SSH_HOST=$(resolve_phone_host || true)
  fi
  ssh "${ssh_phone_opts[@]}" "${PHONE_USER}@${PHONE_SSH_HOST}" "$@"
}
adb_phone() { ANDROID_SERIAL="$ADB_TARGET" adb "$@"; }

# `adb connect` to an unreachable host never returns on its own -- it is not
# a bounded handshake, it retries until something interrupts it. The phone
# roams networks and its tailnet is frequently down, so every connect attempt
# here is time-boxed; without that a status check hangs indefinitely instead
# of reporting "adb down".
ensure_adb() {
  adb_resolve || return 1
  ADB_TARGET="$ADB_RESOLVED"
}

APP_ID="dev.sinnix.phone"
# The launcher activity, named once. Every headless recovery path goes through
# it, so a rename that misses this line is a silent capture outage.
APP_ACTIVITY="${SINNIX_PHONE_APP_ACTIVITY:-.ui.MainActivity}"

# adb over whichever transport is actually up. adbd's TCP mode does not
# survive a phone reboot, and after one the tailnet is often down too (the VPN
# service needs its own restart), so the USB cable is frequently the only
# working transport at exactly the moment something needs checking. Everything
# app-related goes through this rather than adb_phone, because the app's
# liveness must be answerable without Termux, without sshd, and without the
# tailnet -- those are the layers that kept failing.
ADB_RESOLVED="${ADB_RESOLVED:-}"

# Resolve the transport once, in the CALLER's shell.
#
# Each unresolved adb_any call spends up to 8s failing to reach a tailnet that
# is down, and a per-file loop makes two or three calls per chunk -- a drain of
# thirty chunks took forty minutes almost entirely in that timeout. Memoizing
# inside adb_any cannot fix it, because most calls are command substitutions
# and a subshell's assignment dies with the subshell. Callers that loop should
# resolve first; everything after is a direct adb invocation.
adb_resolve() {
  [ -n "$ADB_RESOLVED" ] && return 0
  local target serial
  serial="${SINNIX_PHONE_ADB_SERIAL:-$(cat "$PHONE_STATE/adb-serial" 2>/dev/null || true)}"
  [ -n "$serial" ] || { echo "phone ADB serial not enrolled" >&2; return 1; }
  local -a targets=()
  [ -z "${SINNIX_PHONE_ADB_ENDPOINT:-}" ] || targets+=("$SINNIX_PHONE_ADB_ENDPOINT")
  # Reuse a connected transport only after checking the enrolled serial. A
  # connected headset or another phone must not receive phone commands.
  while IFS= read -r target; do
    [ -z "$target" ] || targets+=("$target")
  done < <(adb devices | awk '$2 == "device" { print $1 }')
  while IFS= read -r target; do
    [ -z "$target" ] || targets+=("$target")
  done < <(timeout 3 avahi-browse -rtp _adb-tls-connect._tcp 2>/dev/null |
    awk -F';' -v serial="$serial" '$1 == "=" && $3 == "IPv4" && index($4, "adb-" serial "-") == 1 && $5 == "_adb-tls-connect._tcp" { print $8 ":" $9 }' || true)
  for target in "${targets[@]}"; do
    if ! adb -s "$target" get-state >/dev/null 2>&1; then
      timeout 5 adb connect "$target" >/dev/null 2>&1 || continue
    fi
    if [ "$(timeout 3 adb -s "$target" shell getprop ro.serialno 2>/dev/null | tr -d '\r')" = "$serial" ]; then
      ADB_RESOLVED="$target"
      return 0
    fi
  done
  echo "phone ADB unavailable; enable Wireless debugging or attach authorized USB" >&2
  return 1
}

adb_any() {
  adb_resolve || return 1
  ANDROID_SERIAL="$ADB_RESOLVED" adb "$@"
}

adb_shell_args() {
  local command
  command=$(sinnix-remote-command "$@") || return
  adb_any shell -T "$command"
}

install_wireless_adb_boot() {
  local boot_script write_command
  boot_script=$(cat <<'BOOT'
#!/system/bin/sh
# Sinnix-owned authenticated wireless ADB startup hook.
umask 077
home=/data/adb/sinnix-wireless-adb
[ ! -L "$home" ] || exit 1
mkdir -p "$home"
chmod 700 "$home"
exec 9>"$home/lock"
# Android's shell otherwise marks this persistent descriptor close-on-exec.
# Export it explicitly to the lock command while retaining our shared FD.
if command -v flock >/dev/null 2>&1; then
  flock -n 9 9>&9 || exit 0
elif [ -x /data/adb/magisk/busybox ]; then
  /data/adb/magisk/busybox flock -n 9 9>&9 || exit 0
else
  echo "wireless ADB owner requires kernel file locking" >&2
  exit 1
fi
birth=$(awk '{print $22}' "/proc/$$/stat")
published_phase=""
publish_owner() {
  [ "$1" != "$published_phase" ] || return 0
  printf '%s %s %s\n' "$$" "$birth" "$1" > "$home/owner.new"
  mv "$home/owner.new" "$home/owner"
  published_phase="$1"
}
publish_owner starting
trap 'rm -f "$home/owner" "$home/owner.new"' EXIT
trap 'exit 0' TERM INT
pause() {
  # Let TERM interrupt the owner promptly; the sleeper must not retain its lock.
  sleep 10 9>&- &
  wait "$!"
}
# Android disables wireless ADB on Wi-Fi loss or BSSID change. Restore only
# on an observed association, through Android's normal trusted-network gate.
last_association=""
while [ -f "$0" ]; do
  if [ "$(getprop sys.boot_completed)" != 1 ]; then
    publish_owner waiting_boot
    pause
    continue
  fi
  if ! status=$(cmd wifi status 2>/dev/null); then
    # An unreadable status is not evidence of a network transition.
    publish_owner status_unavailable
    pause
    continue
  fi
  phase=status_unavailable
  if printf '%s\n' "$status" | grep -Eq '^Wifi is (not connected|disabled)$'; then
    last_association=""
    phase=waiting_wifi
  elif printf '%s\n' "$status" | grep -q '^Wifi is connected to '; then
    association=$(printf '%s\n' "$status" | sed -n 's/^WifiInfo: .* BSSID: \([^, ]*\).*$/\1/p')
    if printf '%s\n' "$association" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$'; then
      case "$association" in
        00:00:00:00:00:00|02:00:00:00:00:00) ;;
        *)
          phase=request_succeeded
          if [ "$association" != "$last_association" ]; then
            # Repeated ticks do not undo a same-association manual disable.
            # This does not add trusted networks or alter paired host keys.
            # Binder cannot accept a root-private log file as its stdio FD.
            if settings put global adb_wifi_enabled 1 >/dev/null 2>&1; then
              last_association="$association"
            else
              phase=request_failed
            fi
          fi
          ;;
      esac
    fi
  fi
  publish_owner "$phase"
  pause
done
BOOT
)
  write_command=$(sinnix-remote-command printf '%s\n' "$boot_script") || return
  # Only replace this owner's hook. Root authority comes from the phone's
  # existing su grant; no authentication or listening-port policy is bypassed.
  local prepare restart root_command
  prepare=$(cat <<'PREPARE'
set -e
umask 077
home=/data/adb/sinnix-wireless-adb
hook=/data/adb/service.d/sinnix-wireless-adb.sh
test -d /data/adb/service.d
test ! -L "$home"
mkdir -p "$home"
chmod 700 "$home"
if [ -e "$hook" ]; then
  test ! -L "$hook"
  grep -q '^# Sinnix-owned authenticated wireless ADB startup hook.$' "$hook"
  test ! -L "$home/original.sh"
  if [ ! -e "$home/original.sh" ]; then
    cp -p "$hook" "$home/original.sh"
    chmod 400 "$home/original.sh"
  fi
fi
PREPARE
)
  restart=$(cat <<'RESTART'
chmod 700 /data/adb/service.d/.sinnix-wireless-adb.sh.new
mv /data/adb/service.d/.sinnix-wireless-adb.sh.new "$hook"
same_process() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  case "$2" in ''|*[!0-9]*) return 1 ;; esac
  current=$(awk '{print $3 " " $22}' "/proc/$1/stat" 2>/dev/null) || return 1
  [ "${current#* }" = "$2" ] && [ "${current%% *}" != Z ] && [ "${current%% *}" != X ]
}
is_owner() {
  same_process "$1" "$2" || return 1
  tr '\000' '\n' < "/proc/$1/cmdline" | grep -Fxq "$hook"
}
if [ -f "$home/owner" ] && read -r owner_pid owner_birth owner_phase < "$home/owner"; then
  cp -p "$home/owner" "$home/previous-owner"
  if is_owner "$owner_pid" "$owner_birth"; then
    kill -TERM "$owner_pid"
    i=0
    # A dying process's cmdline is not a safe read on Android. Once identity
    # authorized TERM, wait only on its birth identity and non-zombie state.
    while same_process "$owner_pid" "$owner_birth"; do
      [ "$i" -lt 50 ] || { echo "wireless ADB owner did not stop" >&2; exit 1; }
      sleep 0.1
      i=$((i + 1))
    done
  fi
fi
nohup /system/bin/sh "$hook" </dev/null >"$home/last-start.log" 2>&1 &
started_pid=$!
i=0
while [ "$i" -lt 50 ]; do
  if [ -f "$home/owner" ] && read -r owner_pid owner_birth owner_phase < "$home/owner"; then
    if [ "$owner_pid" = "$started_pid" ] && is_owner "$owner_pid" "$owner_birth"; then
      case "$owner_phase" in
        waiting_boot|waiting_wifi|request_succeeded)
          echo "WIRELESS_ADB_OWNER_ACTIVE $owner_phase"
          exit 0
          ;;
        request_failed|status_unavailable)
          echo "wireless ADB owner active but $owner_phase" >&2
          exit 1
          ;;
      esac
    fi
  fi
  kill -0 "$started_pid" 2>/dev/null || break
  sleep 0.1
  i=$((i + 1))
done
echo "wireless ADB owner did not start" >&2
exit 1
RESTART
)
  root_command=$(printf '%s\n%s\n%s' "$prepare" \
    "$write_command > /data/adb/service.d/.sinnix-wireless-adb.sh.new" "$restart")
  adb_shell_args su -c "$root_command"
}

# The grants the app needs that only shell-uid can make. RECORD_AUDIO is
# deliberately NOT forced to `allow` here: the app declares
# foregroundServiceType="microphone", so the default MODE_FOREGROUND is
# already satisfied whenever its foreground service is up. That is the whole
# reason an app works where the Termux script did not, and overriding the
# appop would hide a regression in the service rather than fix one.
# MANAGE_EXTERNAL_STORAGE is set at both package and uid scope because the two
# are separate modes and only one of them reverting is what silently broke
# capture before (sinnix-hcjq).
#
# Every runtime permission the manifest declares is granted here, not just the
# ones a particular lane needed on the day it was written. The app is the
# capture agent on this device; enumerating a subset means a lane
# added later is dark until someone remembers this function exists.
#
# The notification listener is the case that proves it. `PhoneNotificationListener`
# was written, declared in the manifest, and never bound, because nothing ever
# put it in `enabled_notification_listeners` -- so the inbound-comms timeline
# recorded nothing from the day it was built until 2026-08-14. `allow_listener`
# needs no root and shows no dialog, so there was never a reason for it to be
# manual. MIUI also revokes listener bindings silently, which is why this is
# re-asserted on every install and adb restore rather than done once.
ensure_app_grants() {
  local perm
  for perm in \
    RECORD_AUDIO \
    POST_NOTIFICATIONS \
    CAMERA \
    ACCESS_COARSE_LOCATION \
    READ_EXTERNAL_STORAGE; do
    adb_any shell pm grant "$APP_ID" "android.permission.$perm" >/dev/null 2>&1 || true
  done
  adb_any shell appops set "$APP_ID" MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true
  adb_any shell appops set --uid "$APP_ID" MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true
  adb_any shell cmd deviceidle whitelist "+$APP_ID" >/dev/null 2>&1 || true
  adb_any shell cmd notification allow_listener \
    "$APP_ID/$APP_ID.ingress.PhoneNotificationListener" >/dev/null 2>&1 || true

  # Health Connect permissions are deliberately absent: on Android 13 they are
  # held by the Health Connect APK rather than the platform, so `pm grant`
  # accepts them and silently does nothing. They are granted once through the
  # Health Connect consent UI and survive app upgrades, which is why they are
  # not this function's job -- see docs/phone.md.
}

require_unlocked_phone() {
  local window_state
  window_state=$(adb_any shell dumpsys window 2>/dev/null || true)
  if printf '%s' "$window_state" \
    | grep -Eq 'mDreamingLockscreen=true|mShowingLockscreen=true|isStatusBarKeyguard=true'; then
    echo "phone screen is locked; unlock it before starting or upgrading the capture app" >&2
    return 1
  fi
}

# Device-level capture settings that are not app grants and do not survive a
# reboot. Ring buffers ship at 256 KiB (~4h on this phone); 64 MiB is the most
# the shell can set without root. `persist.logd.size` would persist it but is
# refused to the shell uid, so re-assert on every adb attach. Notification
# history is Android's own second witness beside the app listener; it
# defaults off.
ensure_device_capture_settings() {
  local buf
  for buf in main system crash kernel; do
    adb_any logcat -b "$buf" -G 64M >/dev/null 2>&1 || true
  done
  adb_any shell settings put secure notification_history_enabled 1 >/dev/null 2>&1 || true
}

# Drain the phone's system log into the lake. Bigger ring buffers only buy
# time; without this the log is never captured at all.
#
# `-T <ts>` resumes from the last drained line. A missing, malformed or
# future cursor relative to the host UTC clock requests a full dump; logcat
# answers a future timestamp with silence. Failed pulls do not advance it.
# Raw threadtime lines, not JSON: every Android tool already speaks the format.
drain_logcat_adb() {
  local dest cursor since day out lines total before stage cursor_epoch now_epoch
  local -a logcat_args=(-b all -d -v threadtime -v UTC -v year)
  adb_resolve || return 1
  dest="$LAKE_ROOT/logcat"
  cursor="$PHONE_STATE/logcat.cursor"
  mkdir -p "$dest" "$(dirname "$cursor")" || return 1
  day="$(date -u +%Y%m%d)" || return 1
  out="$dest/logcat-$day.txt"

  since=""
  if [ -s "$cursor" ]; then
    since="$(cat "$cursor")" || return 1
    now_epoch="$(date -u +%s)" || return 1
    if ! cursor_epoch="$(date -u -d "$since" +%s 2>/dev/null)" ||
      [ "$cursor_epoch" -gt "$now_epoch" ]; then
      echo "logcat: invalid or future UTC cursor; requesting a full dump" >&2
      since=""
    fi
  fi

  before=0
  if [ -e "$out" ]; then
    # grep prints one zero and exits 1 for an empty match set.
    before=$(grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$out" || [ "$?" -eq 1 ]) || return 1
  fi
  stage="$(mktemp "$dest/.logcat-pull.XXXXXX")" || return 1
  # Interrupted or failed pulls retain their exact bytes outside the daily
  # reader entrance. Never advance the cursor from incomplete output.
  [ -z "$since" ] || logcat_args+=(-T "$since")
  if ! adb_any logcat "${logcat_args[@]}" >"$stage"; then
    if [ -s "$stage" ]; then
      echo "logcat: pull failed; incomplete output retained at $stage" >&2
    else
      rm -f "$stage"
      echo "logcat: pull failed; no output captured" >&2
    fi
    return 1
  fi
  if ! cat "$stage" >>"$out"; then
    echo "logcat: publication failed; complete pull retained at $stage" >&2
    return 1
  fi
  total=$(grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$out" || [ "$?" -eq 1 ]) || return 1
  lines=$(( total - before ))
  if [ "$total" -gt 0 ]; then
    if ! grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$out" | tail -n 1 | awk '{ print $1 " " $2 }' > "$cursor.tmp"; then
      echo "logcat: cursor extraction failed; pull retained at $stage" >&2
      return 1
    fi
    mv -f "$cursor.tmp" "$cursor" || return 1
  fi
  rm -f "$stage"
  echo "logcat: $lines new lines ($total total) in $out"
}

# Drain ambient chunks over adb.
#
# The rsync path needs the tailnet up and Termux's sshd running, and both are
# routinely down at once -- the tailnet needs its own restart after a reboot,
# and sshd only runs while Termux does. That is the same dependency the capture
# app was written to escape, and leaving it in the drain means audio the app
# reliably records still cannot reach the lake. adb is a second transport with
# a different failure mode: over USB it works when the network does not.
#
# Verify staged bytes before publication. Existing different bytes remain
# evidence; preserve the incoming version separately rather than overwriting.
drain_ambient_adb() {
  local dest name remote listing staging digest copied_digest after_digest target
  local pulled=0 conflicts=0 failed=0
  adb_resolve || return 1
  dest="$LAKE_ROOT/ambient"
  mkdir -p "$dest"
  listing=$(mktemp "$dest/.inventory.XXXXXX") || return 1
  if ! adb_shell_args find /sdcard/sinnix-ambient -maxdepth 1 -type f -print0 >"$listing"; then
    rm -- "$listing"
    echo "ambient: inventory failed" >&2
    return 1
  fi
  while IFS= read -r -d '' remote; do
    name=${remote##*/}
    case "$name" in *.m4a | *.m4a.orphan) ;; *) continue ;; esac
    if ! digest=$(adb_shell_args sha256sum "$remote" </dev/null); then
      failed=$((failed + 1)); continue
    fi
    digest=${digest%% *}
    # GNU sha256sum prefixes an escaped filename record with a backslash.
    # The prefix describes the filename, not the digest itself.
    digest=${digest#\\}
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || { failed=$((failed + 1)); continue; }
    target="$dest/$name"
    if [ -f "$target" ] && [ ! -L "$target" ] && [ "$(sha256sum < "$target" | cut -d ' ' -f 1)" = "$digest" ]; then
      continue
    fi
    staging=$(mktemp "$dest/.incoming.XXXXXX") || return 1
    if ! adb_any pull "$remote" "$staging" >/dev/null 2>&1; then
      echo "ambient: failed transfer retained at $staging" >&2
      failed=$((failed + 1)); continue
    fi
    copied_digest=$(sha256sum "$staging" | cut -d ' ' -f 1)
    after_digest=$(adb_shell_args sha256sum "$remote" </dev/null) || after_digest=""
    after_digest=${after_digest%% *}
    after_digest=${after_digest#\\}
    if [ "$copied_digest" != "$digest" ] || [ "$after_digest" != "$digest" ]; then
      echo "ambient: unverified transfer retained at $staging" >&2
      failed=$((failed + 1)); continue
    fi
    # Hard-link publication never overwrites a concurrent arrival or follows
    # an existing symlink. A conflict has a full-content identity in its name.
    if [ -e "$target" ] || [ -L "$target" ]; then
      target="$dest/${name}.conflict-$digest"
      conflicts=$((conflicts + 1))
    fi
    python3 -c 'import os, sys; fd = os.open(sys.argv[1], os.O_RDONLY); os.fsync(fd); os.close(fd)' "$staging" || return 1
    if ln -T -- "$staging" "$target"; then
      python3 -c 'import os, sys; fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY); os.fsync(fd); os.close(fd)' "$dest" || return 1
      rm -- "$staging"
      pulled=$((pulled + 1))
    elif [ -f "$target" ] && [ ! -L "$target" ] && [ "$(sha256sum < "$target" | cut -d ' ' -f 1)" = "$digest" ]; then
      rm -- "$staging"
    else
      echo "ambient: publication conflict retained at $staging" >&2
      failed=$((failed + 1))
    fi
  done <"$listing"
  rm -- "$listing"
  echo "ambient: retained $pulled verified version(s), $conflicts differing name(s), $failed failed"
  [ "$failed" -eq 0 ]
}

# Preserve and audit BCR call recordings.
#
# BCR writes a staging recording under its app-specific external directory and
# then copies it through Android's document provider to /sdcard/sinnix-calls.
# A retained staging file is the archive authority: a document-provider copy
# can be shorter if that final copy is interrupted. Successful exports may
# remove staging; accept those only with matching native completion metadata.
# Nothing here deletes phone data.
#
# A valid Ogg/Opus file can still contain exact zeroes for an entire call when
# the vendor VOICE_CALL route fails. Decode every newly observed recording at
# intake so "BCR produced a file" is never confused with "call audio exists".
drain_bcr_calls_adb() (
  local remote_dir export_dir dest debug_dir history_dir ledger seen remote name
  local remote_size export_size duration rate channels
  local source_kind sidecar_target samples expected_frames expected_rate expected_channels staging_bytes
  local levels mean max dead truncated_export log_remote log_name display audio_candidate decode_ok
  local listing checked_at metadata_missing row_needed sync_lock_fd failed=0
  local rollback_kind rollback_target rollback_source rollback_stage
  local pulled=0 repaired=0 audited=0 silent=0 broken=0
  local -A revision_source_path revision_archive_path revision_source_identity
  local -A revision_archive_identity revision_source_sha revision_archive_sha
  local -A revision_stage revision_previous_sha revision_previous_path
  local -A revision_prior revision_target_existed revision_needs_row revision_published

  adb_resolve || return 1
  remote_dir="/sdcard/Android/data/com.chiller3.bcr/files"
  export_dir="/sdcard/sinnix-calls"
  dest="$LAKE_ROOT/calls"
  debug_dir="$dest/debug"
  history_dir="$dest/history"
  ledger="$dest/levels.jsonl"
  mkdir -p "$dest" || return 1
  # Serialize the complete receipt/publication transaction, including rollback.
  # The function subshell closes this descriptor on every return or signal.
  exec {sync_lock_fd}>>"$dest/.sync.lock" || return 1
  if ! flock -n "$sync_lock_fd"; then
    echo "bcr: sync already active for this archive; retry later" >&2
    return 75
  fi
  mkdir -p "$debug_dir" || return 1
  mkdir -p "$dest/metadata" || return 1
  touch "$ledger" || return 1
  seen=$(jq -c -s 'map(select(type == "object"))' "$ledger") || return 1

  # Android's toybox stat exposes device, inode, size, and nanosecond-formatted
  # mtime/ctime on the enrolled phone. Keep the timestamps as raw strings so
  # their precision and timezone survive the receipt round trip. If the
  # runtime stops exposing this identity, refuse the scan rather than quietly
  # returning to filename+size deduplication.
  bcr_remote_identity() {
    local raw device inode size mtime ctime kind
    raw=$(adb_shell_args stat -c '%d|%i|%s|%y|%z|%F' "$1" 2>/dev/null </dev/null) || return 1
    raw=${raw//$'\r'/}
    IFS='|' read -r device inode size mtime ctime kind <<<"$raw"
    [[ "$device" =~ ^[0-9]+$ && "$inode" =~ ^[0-9]+$ && "$size" =~ ^[0-9]+$ ]] || return 1
    [[ "$mtime" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}[[:space:]][+-][0-9]{4}$ ]] || return 1
    [[ "$ctime" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}[[:space:]][+-][0-9]{4}$ ]] || return 1
    case "$kind" in "regular file" | "regular empty file") ;; *) return 1 ;; esac
    BCR_IDENTITY_SIZE=$size
    BCR_IDENTITY=$(jq -cn --arg device "$device" --arg inode "$inode" \
      --arg size "$size" --arg mtime "$mtime" --arg ctime "$ctime" \
      '{device: $device, inode: $inode, size: $size, mtime: $mtime, ctime: $ctime}') || return 1
  }

  bcr_local_identity() {
    local raw device inode size mtime ctime kind
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    raw=$(stat -c '%d|%i|%s|%y|%z|%F' "$1") || return 1
    IFS='|' read -r device inode size mtime ctime kind <<<"$raw"
    [[ "$device" =~ ^[0-9]+$ && "$inode" =~ ^[0-9]+$ && "$size" =~ ^[0-9]+$ ]] || return 1
    [[ "$mtime" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}[[:space:]][+-][0-9]{4}$ ]] || return 1
    [[ "$ctime" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}[[:space:]][+-][0-9]{4}$ ]] || return 1
    case "$kind" in "regular file" | "regular empty file") ;; *) return 1 ;; esac
    BCR_IDENTITY_SIZE=$size
    BCR_IDENTITY=$(jq -cn --arg device "$device" --arg inode "$inode" \
      --arg size "$size" --arg mtime "$mtime" --arg ctime "$ctime" \
      '{device: $device, inode: $inode, size: $size, mtime: $mtime, ctime: $ctime}') || return 1
  }

  bcr_remote_hash() {
    local raw digest
    raw=$(adb_shell_args sha256sum "$1" 2>/dev/null </dev/null) || return 1
    raw=${raw//$'\r'/}
    IFS=' ' read -r digest _ <<<"$raw"
    digest=${digest#\\}
    [[ "$digest" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
    BCR_HASH=${digest,,}
  }

  bcr_local_hash() {
    local raw digest
    raw=$(sha256sum <"$1") || return 1
    digest=${raw%% *}
    [[ "$digest" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
    BCR_HASH=${digest,,}
  }

  # Hash only a new or changed source. Bracket both reads with the same native
  # identity; an active/replaced source cannot produce a durable receipt.
  bcr_remote_hash_stable() {
    local expected="$2" first identity
    bcr_remote_identity "$1" || return 1
    [ "$BCR_IDENTITY" = "$expected" ] || return 1
    identity=$BCR_IDENTITY
    bcr_remote_hash "$1" || return 1
    first=$BCR_HASH
    bcr_remote_identity "$1" || return 1
    [ "$BCR_IDENTITY" = "$identity" ] || return 1
    bcr_remote_hash "$1" || return 1
    [ "$BCR_HASH" = "$first" ] || return 1
    bcr_remote_identity "$1" || return 1
    [ "$BCR_IDENTITY" = "$identity" ] || return 1
  }

  bcr_local_hash_stable() {
    local first identity
    bcr_local_identity "$1" || return 1
    identity=$BCR_IDENTITY
    bcr_local_hash "$1" || return 1
    first=$BCR_HASH
    bcr_local_identity "$1" || return 1
    [ "$BCR_IDENTITY" = "$identity" ] || return 1
    bcr_local_hash "$1" || return 1
    [ "$BCR_HASH" = "$first" ] || return 1
    bcr_local_identity "$1" || return 1
    [ "$BCR_IDENTITY" = "$identity" ] || return 1
  }

  bcr_find_receipt() {
    local key="$1" source_path="$2" archive_path="$3"
    local source_identity="$4" archive_identity="$5"
    BCR_PRIOR=$(printf '%s\n' "$seen" | jq -c \
      --arg key "$key" --arg source_path "$source_path" \
      --arg archive_path "$archive_path" \
      --argjson source_identity "$source_identity" \
      --argjson archive_identity "$archive_identity" \
      '[.[] | .[$key]? | select(type == "object") |
        select(.source_path == $source_path and .archive_path == $archive_path and
          .source_identity == $source_identity and .archive_identity == $archive_identity and
          (.source_sha256 | type) == "string" and
          .source_sha256 == .archive_sha256)] | last // empty') || return 1
  }

  # Inspect a source/archive pair. A prior receipt is reusable only when both
  # exact metadata identities still match. Legacy levels rows deliberately do
  # not match; they receive a fresh, explicitly current hash baseline.
  bcr_prepare_revision() {
    local kind="$1" remote_path="$2" archive_path="$3" key target
    local source_identity archive_identity source_digest archive_digest
    local stage
    case "$kind" in audio) key=audio_revision ;; sidecar) key=sidecar_revision ;; *) return 1 ;; esac
    target="$dest/$archive_path"
    revision_source_path[$kind]=$remote_path
    revision_archive_path[$kind]=$archive_path
    revision_stage[$kind]=""
    revision_previous_sha[$kind]=""
    revision_previous_path[$kind]=""
    revision_target_existed[$kind]=0
    revision_published[$kind]=0
    revision_needs_row[$kind]=1

    bcr_remote_identity "$remote_path" || return 1
    source_identity=$BCR_IDENTITY
    revision_source_identity[$kind]=$source_identity
    if [ "$kind" = audio ]; then
      remote_size=$BCR_IDENTITY_SIZE
    fi

    if [ -e "$target" ] || [ -L "$target" ]; then
      bcr_local_identity "$target" || return 1
      archive_identity=$BCR_IDENTITY
      revision_target_existed[$kind]=1
      bcr_find_receipt "$key" "$remote_path" "$archive_path" \
        "$source_identity" "$archive_identity" || return 1
      if [ -n "$BCR_PRIOR" ]; then
        source_digest=$(jq -r '.source_sha256' <<<"$BCR_PRIOR") || return 1
        archive_digest=$(jq -r '.archive_sha256' <<<"$BCR_PRIOR") || return 1
        [[ "$source_digest" =~ ^[0-9a-f]{64}$ && "$archive_digest" = "$source_digest" ]] || return 1
        revision_source_sha[$kind]=$source_digest
        revision_archive_sha[$kind]=$archive_digest
        revision_archive_identity[$kind]=$archive_identity
        revision_prior[$kind]=$BCR_PRIOR
        revision_needs_row[$kind]=0
        return 0
      fi
    else
      archive_identity=""
    fi

    bcr_remote_hash_stable "$remote_path" "$source_identity" || return 1
    source_digest=$BCR_HASH
    revision_source_sha[$kind]=$source_digest

    if [ "${revision_target_existed[$kind]}" -eq 1 ]; then
      bcr_local_hash_stable "$target" || return 1
      archive_identity=$BCR_IDENTITY
      archive_digest=$BCR_HASH
      if [ "$archive_digest" = "$source_digest" ]; then
        revision_archive_identity[$kind]=$archive_identity
        revision_archive_sha[$kind]=$archive_digest
        revision_prior[$kind]=""
        return 0
      fi
      revision_previous_sha[$kind]=$archive_digest
    fi

    stage=$(mktemp "$dest/.$kind-incoming.XXXXXX") || return 1
    if ! adb_any pull "$remote_path" "$stage" >/dev/null 2>&1; then
      rm -- "$stage"
      return 1
    fi
    bcr_local_hash "$stage" || { rm -- "$stage"; return 1; }
    [ "$BCR_HASH" = "$source_digest" ] || { rm -- "$stage"; return 1; }
    bcr_remote_hash_stable "$remote_path" "$source_identity" || { rm -- "$stage"; return 1; }
    [ "$BCR_HASH" = "$source_digest" ] || { rm -- "$stage"; return 1; }
    revision_stage[$kind]=$stage
    revision_archive_sha[$kind]=$source_digest
    revision_archive_identity[$kind]=""
    revision_prior[$kind]=""
  }

  # Keep the exact old bytes before replacing the call entrance. The digest
  # directory is create-only and the original basename remains recognizable.
  bcr_preserve_revision() {
    local kind="$1" target digest history_rel history_path
    target="$dest/${revision_archive_path[$kind]}"
    [ -n "${revision_stage[$kind]}" ] || return 0
    digest=${revision_previous_sha[$kind]:-}
    [ -n "$digest" ] || return 0
    bcr_local_hash_stable "$target" || return 1
    [ "$BCR_HASH" = "$digest" ] || return 1
    history_rel="history/$digest/${target##*/}"
    history_path="$dest/$history_rel"
    mkdir -p "$(dirname "$history_path")" || return 1
    if [ -e "$history_path" ] || [ -L "$history_path" ]; then
      bcr_local_hash_stable "$history_path" || return 1
      [ "$BCR_HASH" = "$digest" ] || return 1
    else
      ln -T -- "$target" "$history_path" || return 1
      bcr_local_hash_stable "$history_path" || return 1
      [ "$BCR_HASH" = "$digest" ] || return 1
    fi
    # Adding the hard link changes inode ctime, so compare content after the
    # link and rely on the digest rather than the pre-link identity tuple.
    bcr_local_hash_stable "$target" || return 1
    [ "$BCR_HASH" = "$digest" ] || return 1
    revision_previous_path[$kind]=$history_rel
  }

  bcr_publish_revision() {
    local kind="$1" target stage expected
    target="$dest/${revision_archive_path[$kind]}"
    stage=${revision_stage[$kind]:-}
    [ -n "$stage" ] || return 0
    expected=${revision_source_sha[$kind]}
    if [ "${revision_target_existed[$kind]}" -eq 1 ]; then
      bcr_local_hash_stable "$target" || return 1
      [ "$BCR_HASH" = "${revision_previous_sha[$kind]}" ] || return 1
      mv -f -- "$stage" "$target" || return 1
      revision_published[$kind]=1
    else
      if [ -e "$target" ] || [ -L "$target" ]; then
        return 1
      fi
      ln -T -- "$stage" "$target" || return 1
      revision_published[$kind]=1
      rm -- "$stage" || return 1
    fi
    revision_stage[$kind]=""
    bcr_local_hash_stable "$target" || return 1
    [ "$BCR_HASH" = "$expected" ] || return 1
    revision_archive_identity[$kind]=$BCR_IDENTITY
    revision_archive_sha[$kind]=$BCR_HASH
  }

  bcr_revision_json() {
    local kind="$1"
    if [ -n "${revision_prior[$kind]:-}" ]; then
      printf '%s' "${revision_prior[$kind]}"
      return 0
    fi
    jq -cn --arg source_path "${revision_source_path[$kind]}" \
      --arg archive_path "${revision_archive_path[$kind]}" \
      --argjson source_identity "${revision_source_identity[$kind]}" \
      --argjson archive_identity "${revision_archive_identity[$kind]}" \
      --arg source_sha256 "${revision_source_sha[$kind]}" \
      --arg archive_sha256 "${revision_archive_sha[$kind]}" \
      '{source_path: $source_path, source_identity: $source_identity,
        source_sha256: $source_sha256, archive_path: $archive_path,
        archive_identity: $archive_identity, archive_sha256: $archive_sha256}'
  }

  # BCR updates the staging file while a call is active. One quiet minute is
  # enough to distinguish a completed file from the current recording.
  listing=$(mktemp "$dest/.inventory.XXXXXX") || return 1
  if ! adb_shell_args find "$remote_dir" "$export_dir" -maxdepth 1 -type f -name '*.oga' -mmin +1 -print0 >"$listing"; then
    rm -f "$listing"
    echo "bcr: staging/export inventory failed" >&2
    return 1
  fi
  while IFS= read -r -d '' remote; do
    [ -n "$remote" ] || continue
    name=${remote##*/}
    source_kind=staging
    if [[ "$remote" == "$export_dir/"* ]]; then
      # A retained staging copy wins, including one still being recorded.
      # Successful BCR exports can remove staging; those need native metadata.
      if adb_shell_args test -f "$remote_dir/$name" >/dev/null 2>&1 </dev/null; then
        continue
      fi
      source_kind=export
    fi
    log_remote="${remote%.oga}.log.txt"
    log_name="${name%.oga}.log.txt"
    sidecar_target="debug/$log_name"
    if adb_shell_args test -f "$export_dir/${name%.oga}.json" >/dev/null 2>&1 </dev/null; then
      log_remote="$export_dir/${name%.oga}.json"
      log_name="${name%.oga}.json"
      sidecar_target="metadata/$log_name"
    elif [ "$source_kind" = export ]; then
      echo "bcr: exported call has no native completion metadata; source preserved" >&2
      failed=$((failed + 1))
      continue
    fi
    revision_source_path=()
    revision_archive_path=()
    revision_source_identity=()
    revision_archive_identity=()
    revision_source_sha=()
    revision_archive_sha=()
    revision_stage=()
    revision_previous_sha=()
    revision_previous_path=()
    revision_prior=()
    revision_target_existed=()
    revision_needs_row=()
    revision_published=()
    metadata_missing=0
    row_needed=0

    if ! bcr_prepare_revision audio "$remote" "$name"; then
      echo "bcr: audio identity or digest verification failed; archive preserved" >&2
      failed=$((failed + 1))
      continue
    fi
    revision_needs_row[audio]=${revision_needs_row[audio]:-1}
    [ "${revision_needs_row[audio]}" -eq 1 ] && row_needed=1

    # ADB otherwise forwards this loop's inventory as remote stdin and can
    # discard every recording after the first metadata check.
    if adb_shell_args test -f "$log_remote" >/dev/null 2>&1 </dev/null; then
      if ! bcr_prepare_revision sidecar "$log_remote" "$sidecar_target"; then
        echo "bcr: metadata identity or digest verification failed; archive preserved" >&2
        for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
          [ -z "$stage" ] || rm -- "$stage"
        done
        failed=$((failed + 1))
        continue
      fi
      [ "${revision_needs_row[sidecar]}" -eq 1 ] && row_needed=1
    else
      metadata_missing=1
      echo "bcr: completed call has no readable paired metadata sidecar" >&2
      failed=$((failed + 1))
    fi

    # A receipt hit is valid only while both endpoint identities remain the
    # ones checked above. A no-op poll creates no extra ledger row.
    if [ "$row_needed" -eq 0 ]; then
      bcr_remote_identity "$remote" || { failed=$((failed + 1)); continue; }
      if [ "$BCR_IDENTITY" != "${revision_source_identity[audio]}" ]; then
        failed=$((failed + 1)); continue
      fi
      bcr_local_identity "$dest/$name" || { failed=$((failed + 1)); continue; }
      if [ "$BCR_IDENTITY" != "${revision_archive_identity[audio]}" ]; then
        failed=$((failed + 1)); continue
      fi
      if [ "$metadata_missing" -eq 0 ]; then
        bcr_remote_identity "$log_remote" || { failed=$((failed + 1)); continue; }
        if [ "$BCR_IDENTITY" != "${revision_source_identity[sidecar]}" ]; then
          failed=$((failed + 1)); continue
        fi
        bcr_local_identity "$dest/$sidecar_target" || { failed=$((failed + 1)); continue; }
        if [ "$BCR_IDENTITY" != "${revision_archive_identity[sidecar]}" ]; then
          failed=$((failed + 1)); continue
        fi
      fi
      continue
    fi

    # Stage every changed member first. No current archive path is changed
    # until both available source files have passed their digest checks.
    audio_candidate=${revision_stage[audio]:-$dest/$name}
    duration=$(ffprobe -v error -show_entries format=duration \
      -of default=nw=1:nk=1 "$audio_candidate" 2>/dev/null </dev/null || true)
    rate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate \
      -of default=nw=1:nk=1 "$audio_candidate" 2>/dev/null </dev/null || true)
    channels=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels \
      -of default=nw=1:nk=1 "$audio_candidate" 2>/dev/null </dev/null || true)
    decode_ok=true
    levels=$(ffmpeg -nostdin -hide_banner -nostats -i "$audio_candidate" \
      -af volumedetect -f null - 2>&1 \
      | awk '/mean_volume:/ {mean=$(NF-1)} /max_volume:/ {max=$(NF-1)} /n_samples:/ {samples=$NF} END {print mean, max, samples}' \
      ) || decode_ok=false
    read -r mean max samples <<< "$levels"
    if [ "$decode_ok" = false ] || [ -z "$duration" ] || [ -z "$max" ]; then
      echo "bcr: candidate audio did not decode; archive preserved" >&2
      for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
        [ -z "$stage" ] || rm -- "$stage"
      done
      broken=$((broken + 1))
      continue
    fi
    if [[ "$log_remote" == *.json ]]; then
      local metadata_candidate completion
      metadata_candidate=${revision_stage[sidecar]:-$dest/$sidecar_target}
      if ! completion=$(jq -er '.output.recording |
        select((.frames_encoded|type)=="number" and .frames_encoded>0 and (.frames_encoded|floor)==.frames_encoded and
          (.sample_rate|type)=="number" and .sample_rate>0 and (.sample_rate|floor)==.sample_rate and
          (.channel_count|type)=="number" and .channel_count>0 and (.channel_count|floor)==.channel_count) |
        [.frames_encoded,.sample_rate,.channel_count] | @tsv' "$metadata_candidate"); then
        echo "bcr: native completion metadata is invalid; source preserved" >&2
        failed=$((failed + 1))
        for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
          [ -z "$stage" ] || rm -- "$stage"
        done
        continue
      fi
      IFS=$'\t' read -r expected_frames expected_rate expected_channels <<< "$completion"
      # Opus decodes at 48kHz even when BCR recorded at 16kHz. Compare the
      # exact frame duration in both sample-rate domains, without rounding.
      if ! awk -v frames="$expected_frames" -v expected_rate="$expected_rate" -v expected_channels="$expected_channels" \
        -v samples="$samples" -v rate="$rate" -v channels="$channels" \
        'BEGIN { exit !(samples * expected_rate == frames * expected_channels * rate && channels == expected_channels) }'; then
        echo "bcr: decoded audio differs from native completion metadata; source preserved" >&2
        failed=$((failed + 1))
        for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
          [ -z "$stage" ] || rm -- "$stage"
        done
        continue
      fi
    fi
    dead=false
    if [ "$max" = "-inf" ]; then
      dead=true
    elif [ -n "$max" ] && awk -v v="$max" 'BEGIN { exit !(v <= -90.0) }'; then
      dead=true
    fi

    for kind in audio sidecar; do
      [ -n "${revision_stage[$kind]:-}" ] || continue
      if ! bcr_preserve_revision "$kind"; then
        echo "bcr: could not preserve the previous archive bytes" >&2
        for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
          [ -z "$stage" ] || rm -- "$stage"
        done
        failed=$((failed + 1))
        continue 2
      fi
    done

    # The successful call row links current revisions to exact preimages. A
    # publication failure rolls back any member already replaced.
    local previous_audio=null previous_sidecar=null
    if [ -n "${revision_previous_path[audio]:-}" ]; then
      previous_audio=$(jq -cn --arg path "${revision_archive_path[audio]}" \
        --arg history "${revision_previous_path[audio]}" \
        --arg sha256 "${revision_previous_sha[audio]}" \
        '{archive_path: $path, history_path: $history, sha256: $sha256}') || return 1
    fi
    if [ -n "${revision_previous_path[sidecar]:-}" ]; then
      previous_sidecar=$(jq -cn --arg path "${revision_archive_path[sidecar]}" \
        --arg history "${revision_previous_path[sidecar]}" \
        --arg sha256 "${revision_previous_sha[sidecar]}" \
        '{archive_path: $path, history_path: $history, sha256: $sha256}') || return 1
    fi
    for kind in audio sidecar; do
      [ -n "${revision_stage[$kind]:-}" ] || continue
      if ! bcr_publish_revision "$kind"; then
        for rollback_kind in sidecar audio; do
          [ "${revision_published[$rollback_kind]:-0}" -eq 1 ] || continue
          rollback_target="$dest/${revision_archive_path[$rollback_kind]}"
          if [ "${revision_target_existed[$rollback_kind]}" -eq 1 ]; then
            rollback_source="$dest/${revision_previous_path[$rollback_kind]}"
            if ! bcr_local_hash_stable "$rollback_target" || \
              [ "$BCR_HASH" != "${revision_source_sha[$rollback_kind]}" ] || \
              [ "$BCR_IDENTITY" != "${revision_archive_identity[$rollback_kind]}" ]; then
              continue
            fi
            rollback_stage=$(mktemp "$(dirname "$rollback_target")/.rollback.XXXXXX") || continue
            rm -- "$rollback_stage" || continue
            if ln -T -- "$rollback_source" "$rollback_stage" && mv -f -- "$rollback_stage" "$rollback_target"; then
              revision_published[$rollback_kind]=0
            else
              rm -f -- "$rollback_stage"
            fi
          elif bcr_local_hash_stable "$rollback_target" && [ "$BCR_HASH" = "${revision_source_sha[$rollback_kind]}" ]; then
            rm -- "$rollback_target" && revision_published[$rollback_kind]=0
          fi
        done
        echo "bcr: verified incoming bytes were not published; prior archive restored where possible" >&2
        for stage in "${revision_stage[audio]:-}" "${revision_stage[sidecar]:-}"; do
          [ -z "$stage" ] || rm -- "$stage"
        done
        failed=$((failed + 1))
        continue 2
      fi
      if [ "${revision_target_existed[$kind]}" -eq 1 ]; then
        repaired=$((repaired + 1))
      elif [ "$kind" = audio ]; then
        pulled=$((pulled + 1))
      fi
    done

    # Recheck source identities and archive identities after publication. The
    # digests in the new row now describe the exact audio and sidecar revisions
    # reachable at the ordinary call paths.
    bcr_remote_identity "$remote" || { failed=$((failed + 1)); continue; }
    if [ "$BCR_IDENTITY" != "${revision_source_identity[audio]}" ]; then
      failed=$((failed + 1)); continue
    fi
    bcr_local_identity "$dest/$name" || { failed=$((failed + 1)); continue; }
    if [ "$BCR_IDENTITY" != "${revision_archive_identity[audio]}" ]; then
      failed=$((failed + 1)); continue
    fi
    if [ "$metadata_missing" -eq 0 ]; then
      bcr_remote_identity "$log_remote" || { failed=$((failed + 1)); continue; }
      if [ "$BCR_IDENTITY" != "${revision_source_identity[sidecar]}" ]; then
        failed=$((failed + 1)); continue
      fi
      bcr_local_identity "$dest/$sidecar_target" || { failed=$((failed + 1)); continue; }
      if [ "$BCR_IDENTITY" != "${revision_archive_identity[sidecar]}" ]; then
        failed=$((failed + 1)); continue
      fi
    fi
    export_size=$(adb_shell_args stat -c %s "$export_dir/$name" 2>/dev/null </dev/null | tr -d '\r' || true)
    case "$export_size" in *[!0-9]*) export_size= ;; esac
    truncated_export=false
    if [ -n "$export_size" ] && [ "$export_size" -lt "$remote_size" ]; then
      truncated_export=true
    fi

    [ "$dead" = false ] || silent=$((silent + 1))

    checked_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || return 1
    staging_bytes=null
    [ "$source_kind" != staging ] || staging_bytes="${remote_size:-0}"
    local audio_revision sidecar_revision
    audio_revision=$(bcr_revision_json audio) || return 1
    sidecar_revision=null
    if [ "$metadata_missing" -eq 0 ]; then
      sidecar_revision=$(bcr_revision_json sidecar) || return 1
    fi
    jq -nc \
      --arg file "$name" --argjson bytes "$(stat -c %s "$dest/$name")" \
      --argjson staging_bytes "$staging_bytes" --arg export_bytes "${export_size:-}" --arg source_kind "$source_kind" \
      --arg duration "${duration:-}" --arg rate "${rate:-}" --arg channels "${channels:-}" \
      --arg mean "${mean:-}" --arg max "${max:-}" --argjson dead "$dead" \
      --argjson truncated_export "$truncated_export" \
      --arg checked_at "$checked_at" --argjson audio_revision "$audio_revision" \
      --argjson sidecar_revision "$sidecar_revision" --argjson metadata_missing "$metadata_missing" \
      --argjson previous_audio "$previous_audio" --argjson previous_sidecar "$previous_sidecar" \
      '{file: $file, bytes: $bytes, source_kind: $source_kind, staging_bytes: $staging_bytes,
        export_bytes: ($export_bytes | tonumber? // null),
        duration_seconds: ($duration | tonumber? // null),
        sample_rate: ($rate | tonumber? // null),
        channels: ($channels | tonumber? // null),
        mean_db: ($mean | tonumber? // null), max_db: ($max | tonumber? // null),
        captured_nothing: $dead, export_truncated: $truncated_export,
        checked_at: $checked_at, audio_revision: $audio_revision,
        sidecar_revision: $sidecar_revision, metadata_missing: $metadata_missing,
        previous_audio: $previous_audio, previous_sidecar: $previous_sidecar}' >>"$ledger" || return 1
    # The in-memory receipt snapshot is intentionally not rewritten. A unique
    # BCR staging basename is processed once per inventory pass; a later poll
    # reads the newly appended verified revision.
    audited=$((audited + 1))

    # BCR filenames may contain a phone number or contact. Logs and operator
    # output identify the call only by its timestamp/direction prefix.
    display=${name%%_IN_*}
    display=${display%%_OUT_*}
    if [ "$dead" = true ]; then
      echo "BCR WARNING: $display captured DIGITAL SILENCE (${duration:-?}s)" >&2
    elif [ "$truncated_export" = true ]; then
      echo "BCR WARNING: $display export copy is truncated; full staging copy preserved" >&2
    fi
  done <"$listing"
  rm -f "$listing"

  echo "bcr: synced $pulled new call(s), repaired $repaired partial copy/copies, audited $audited; $silent silent, $broken undecodable, $failed transfer/inventory failures"
  if [ "$silent" -gt 0 ] || [ "$broken" -gt 0 ] || [ "$failed" -gt 0 ]; then
    return 2
  fi
)

nix_userland_identity() {
  NIX_APP_UID=$(adb_any shell pm list packages -U com.termux.nix 2>/dev/null \
    | sed -n 's/.*uid:\([0-9][0-9]*\).*/\1/p' | tr -d '\r')
  [ -n "$NIX_APP_UID" ] || {
    echo "Nix-on-Droid is not installed" >&2
    return 1
  }
  NIX_APP_CONTEXT=$(adb_shell_args su "$NIX_APP_UID" -c \
    '/system/bin/ls -Zd /data/data/com.termux.nix/files/home' 2>/dev/null \
    | awk '{print $1}' | tr -d '\r')
  case "$NIX_APP_CONTEXT" in
    u:object_r:app_data_file:s0:c*) ;;
    *)
      echo "could not determine the Nix-on-Droid app-data context" >&2
      return 1
      ;;
  esac
}

nix_userland_fix_labels() {
  nix_userland_identity
  local roots=(
    /data/data/com.termux.nix/files/usr/nix/store
    /data/data/com.termux.nix/files/home
    /data/data/com.termux.nix/files/usr/bin
    /data/data/com.termux.nix/files/usr/etc
    /data/data/com.termux.nix/files/usr/usr
    /data/data/com.termux.nix/files/usr/nix/var/nix/profiles
  )
  adb_shell_args su "$NIX_APP_UID" -c "$(sinnix-remote-command /system/bin/find "${roots[@]}" -print0)" \
    | adb_shell_args su -c "$(sinnix-remote-command xargs -0 chcon -h "$NIX_APP_CONTEXT")"
}

CHROOT_MODULE_ID=sinnix_debian_chroot
CHROOT_MODULE_ROOT=/data/adb/modules/$CHROOT_MODULE_ID

chroot_module_source() {
  local sinnix_dir="${SINNIX_FLAKE_DIR:-/realm/project/sinnix/repo}"
  printf '%s\n' "$sinnix_dir/devices/android/magisk/sinnix-debian-chroot"
}

chroot_build() (
  local output="${1:-/realm/tmp/work/sinnix-debian-chroot.zip}"
  local work source
  # The archive command runs inside scratch; resolve the caller's destination
  # before changing directories so cleanup cannot discard a relative output.
  output=$(realpath -m -- "$output")
  work=$(mktemp -d "${TMPDIR:-/realm/tmp/work}/sinnix-debian-chroot.XXXXXX")
  cleanup_chroot_build() {
    if ! sudo rm -rf -- "$work"; then
      printf 'chroot-build: could not remove temporary workspace %s\n' "$work" >&2
    fi
  }
  trap cleanup_chroot_build EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  source=$(chroot_module_source)
  [ -f "$source/module.prop" ] || {
    echo "missing module source: $source" >&2
    return 1
  }
  mkdir -p "$work/rootfs" "$work/module"
  sudo debootstrap --foreign --arch=arm64 --variant=minbase trixie "$work/rootfs" http://deb.debian.org/debian
  sudo tar --numeric-owner -C "$work/rootfs" -czf "$work/rootfs.tar.gz" .
  cp -a "$source/." "$work/module/"
  cp "$work/rootfs.tar.gz" "$work/module/rootfs.tar.gz"
  chmod 0755 "$work/module/customize.sh" "$work/module/run.sh"
  mkdir -p "$(dirname "$output")"
  (cd "$work/module" && zip -q -r "$output" .)
  sha256sum "$output"
)

chroot_root() {
  adb_shell_args su -c "$1"
}


usage() {
  cat <<'EOF'
sinnix-phone <command>

  status        tailnet reachability, adb + ssh liveness, capture app,
                battery, storage
  app-status    ambient capture liveness: heartbeat age, recording state,
                and the newest closed chunk's real duration and volume
  app-install   build, sign, and sideload the capture app, then grant and
                start it (needs adb: USB or tailnet)
  app-start     launch the app so its capture service comes back up
  app-grants    re-assert the shell-uid grants the app needs
  app-soak [s]  observe screen/foreground/mute and available chunk measurements
                over a window (default 1200s); review required, no automatic pass
  nix-switch [flake]
                switch the Nix-on-Droid userland and repair Android 16 MCS
                labels; defaults to the exact published Sinnix master revision
  nix-fix-labels repair Nix-on-Droid app-data labels without switching
  chroot-build [zip]
                build the Debian arm64 Magisk module (default: /realm/tmp/work/)
  chroot-install [zip]
                install the built module; one reboot is required
  chroot-bootstrap
                complete Debian and install the declared development baseline
  chroot [cmd]  enter Debian or run a command in its private mount namespace
  chroot-verify verify architecture, compiler, network, packages, and dpkg state
  shell [cmd]   Termux shell over the tailnet (interactive when no cmd)
  mirror        scrcpy screen mirror/control over the tailnet
  screenshot    grab the current screen to /realm/tmp/work/
  logcat        pull the phone's system log and preserve BCR calls over adb;
                this is the scheduled foreign-app/system drain
  ambient-audit decode every undecoded ambient chunk in the lake and record
                its real duration and level
  bcr-sync      preserve completed BCR calls from its staging directory and
                audit every new recording for digital silence/truncated export
  pull-ambient  rescue chunks the app could not upload (the app ships them
                itself; this is for when that is failing)
  unlock [SEC]  root-authorized unlock lease (default 60, maximum 600 seconds)
  adb-connect   discover and attach authenticated wireless ADB
  adb-restore   enable authenticated Wireless debugging over authorized USB
                --persistent also installs the rooted phone’s Magisk boot hook
  clip-push     push the current desktop clipboard to the phone, once
  clip-watch    watch desktop clipboard, push on change (foreground loop)
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
help|--help|-h)
  usage
  ;;
status)
  echo "== phone =="
  # TCP, not ICMP: a dozing Android drops pings while still accepting
  # connections, so ping reports a false outage on a working link.
  if timeout 5 bash -c "exec 3<>/dev/tcp/$PHONE_TS_IP/$PHONE_SSH_PORT" 2>/dev/null; then
    echo "tailnet   : reachable ($PHONE_TS_IP)"
  else
    echo "tailnet   : UNREACHABLE ($PHONE_TS_IP)"
  fi
  if ssh_phone 'true' >/dev/null 2>&1; then
    echo "ssh       : up (termux :$PHONE_SSH_PORT) — shell/file/clipboard route"
  else
    echo "ssh       : down — Termux route unavailable; open Termux, run: sshd"
  fi
  "$0" app-status
  if adb_resolve; then
    case "$ADB_RESOLVED" in
      *:*) adb_transport="network" ;;
      *) adb_transport="USB" ;;
    esac
    echo "adb       : up ($adb_transport, $ADB_RESOLVED)"
    lvl=$(adb_any shell dumpsys battery 2>/dev/null | awk -F': ' '$1 ~ /^[[:space:]]*level$/ { print $2; exit }' | tr -d '\r')
    free=$(adb_any shell df -h /sdcard 2>/dev/null | awk 'END{print $4}' | tr -d '\r')
    echo "battery   : ${lvl:-?}%"
    echo "sdcard    : ${free:-?} free"
  else
    echo "adb       : down — run: sinnix-phone adb-restore (needs USB)"
  fi
  ;;
app-status)
  # Ambient capture liveness, as reported by the capture app itself.
  #
  # Two independent readings, because either one alone lies. status.json says
  # what the app believes; its own staleness says whether the app is still
  # there to believe anything. And neither answers whether the bytes are
  # audio, so the newest CLOSED chunk is measured with ffprobe -- a recorder
  # muted by the platform still produces a file every five minutes, which is
  # exactly how the truncation bug hid.
  echo "== capture app =="
  if ! adb_any get-state >/dev/null 2>&1; then
    # No adb is exactly when this question matters most, and prime is not
    # actually blind: the app pushes its event log to the dispatcher every
    # heartbeat, so the lake holds the app's own account of itself up to about
    # twenty seconds ago. Weaker than status.json (it cannot say what the app
    # believes RIGHT NOW) and much better than "UNKNOWN".
    #
    # Read from the pushed day file rather than the retired mirror lane
    # (phone-event), which carried the same records in a capture envelope
    # until the app started shipping the day file itself.
    echo "app       : no adb transport — answering from the pushed event log"
    # Newest by name, which for `events-YYYYMMDD.jsonl` is newest by date.
    events_file=""
    for f in "$LAKE_ROOT"/events/events-*.jsonl; do
      [ -e "$f" ] && events_file="$f"
    done
    # Limit payload bytes as well as individual records; line counts alone
    # cannot bound Health Connect records. This reads only complete JSON lines.
    if [ -n "$events_file" ]; then
      pushed=$(sinnix-phone-dispatcher event-status --file "$events_file")
    else
      pushed=$(sinnix-phone-dispatcher event-status)
    fi
    pushed_state=$(printf '%s' "$pushed" | jq -r '.state')
    if [ "$pushed_state" != "observed" ]; then
      echo "events    : retained source $pushed_state; capture and upload state unavailable"
      exit 0
    fi
    pushed_ts=$(printf '%s' "$pushed" | jq -r '.ts')
    echo "events    : $(( $(date -u +%s) - $(date -u -d "$pushed_ts" +%s) ))s since newest readable retained event"
    printf '%s' "$pushed" | jq -r '
      if .chunk then "last chunk: \(.chunk) (closed, per the phone)" else empty end,
      if .upload then "uploads   : \(.upload)" else empty end'
    exit 0
  fi
  installed=$(adb_any shell pm list packages "$APP_ID" 2>/dev/null | tr -d '\r')
  if [ -z "$installed" ]; then
    echo "app       : NOT INSTALLED — run: sinnix-phone app-install"
    exit 0
  fi
  status_json=$(adb_any shell cat "/sdcard/sinnix-ambient/status.json" 2>/dev/null | tr -d '\r')
  if [ -z "$status_json" ] || ! echo "$status_json" | jq -e . >/dev/null 2>&1; then
    echo "app       : installed, but no readable status.json — service never started?"
    echo "            run: sinnix-phone app-start"
    exit 0
  fi

  updated=$(echo "$status_json" | jq -r '.updated_at')
  age=$(( $(date -u +%s) - $(date -u -d "$updated" +%s) ))
  recording=$(echo "$status_json" | jq -r '.recording')
  shared=$(echo "$status_json" | jq -r '.chunk_dir_is_shared')
  echo "app       : $(echo "$status_json" | jq -r '.package') v$(echo "$status_json" | jq -r '.app_version')"
  # The app refreshes status.json every 20s while alive, so anything past a
  # couple of minutes means the process is gone, not merely idle.
  if [ "$age" -gt 120 ]; then
    echo "heartbeat : STALE — ${age}s since last update (app not running)"
  else
    echo "heartbeat : ${age}s ago"
  fi
  echo "recording : $recording (chunk $(echo "$status_json" | jq -r '.current_chunk_elapsed_seconds')s/$(echo "$status_json" | jq -r '.chunk_seconds_target')s, $(echo "$status_json" | jq -r '.chunks_closed') closed since start)"
  if [ "$shared" != "true" ]; then
    echo "chunk dir : $(echo "$status_json" | jq -r '.chunk_dir') — NOT drainable, all-files access missing"
  fi
  failures=$(echo "$status_json" | jq -r '.failures')
  if [ "$failures" != "0" ]; then
    echo "failures  : $failures — last: $(echo "$status_json" | jq -r '.last_error')"
  fi

  # Keep the remote listing's status: ls|head turns lookup/access failures
  # into an empty successful result, indistinguishable from an empty directory.
  if ! chunk_listing=$(adb_any shell '
    directory=/sdcard/sinnix-ambient
    [ -d "$directory" ] && [ -r "$directory" ] && [ -x "$directory" ] || exit 1
    set -- "$directory"/*.m4a
    if [ "$#" -eq 1 ] && [ "$1" = "$directory/*.m4a" ] && [ ! -e "$1" ]; then
      exit 0
    fi
    ls -1t -- "$@"
  '); then
    echo "last chunk: phone recording directory unavailable; retained lake data does not establish its current contents" >&2
    exit 1
  fi
  chunk_listing=${chunk_listing//$'\r'/}
  latest_chunk=${chunk_listing%%$'\n'*}
  if [ -n "${latest_chunk:-}" ]; then
    tmp_chunk="$(mktemp --tmpdir="${TMPDIR:-/realm/tmp/work}" --suffix=.m4a sinnix-phone-status.XXXXXX)"
    trap 'rm -f -- "$tmp_chunk"' EXIT
    if adb_any pull "$latest_chunk" "$tmp_chunk" >/dev/null 2>&1; then
      dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$tmp_chunk" 2>/dev/null || true)
      # volumedetect reports at info level, so -v error (the right choice for
      # ffprobe above) would silently swallow the number and leave the
      # silence check permanently blank.
      vol=$(ffmpeg -hide_banner -nostats -v info -i "$tmp_chunk" -af volumedetect -f null - 2>&1 | awk -F': ' '/mean_volume/{print $2}')
      echo "last chunk: $(basename "$latest_chunk") (${dur:-?}s, expect ~${AMBIENT_CHUNK_SECONDS:-300}s; mean ${vol:-?})"
    else
      echo "last chunk: $(basename "$latest_chunk") (couldn't pull to measure)"
    fi
    rm -f -- "$tmp_chunk"
    trap - EXIT
  else
    # An accessible empty directory can follow a successful drain. It does
    # not establish why the phone has no closed chunks. Measure the retained
    # lake file separately; the asynchronous audit ledger can lag recovery.
    lake_chunk=""
    for f in "$LAKE_ROOT"/ambient/ambient-*.m4a; do
      [ -e "$f" ] && lake_chunk="$f"
    done
    if [ -n "$lake_chunk" ]; then
      dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$lake_chunk" 2>/dev/null || true)
      vol=$(ffmpeg -hide_banner -nostats -v info -i "$lake_chunk" -af volumedetect -f null - 2>&1 | awk -F': ' '/mean_volume/{print $2}')
      echo "last chunk: none retained on the phone; newest in the lake: $(basename "$lake_chunk") (${dur:-?}s; mean ${vol:-?})"
    else
      echo "last chunk: none closed yet"
    fi
  fi
  ;;
app-install)
  # Sideload the capture app and re-assert the shell-uid grants. Safe to
  # re-run: a stable signing key makes this an upgrade, so runtime grants and
  # the capture-enabled preference survive.
  #
  # The phone must be unlocked for a foreground microphone restart; some
  # ROMs also put installation confirmation behind the keyguard. Authorized
  # root devices can use a bounded `sinnix phone unlock` maintenance window.
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app-install: no adb transport — plug in USB or run adb-restore" >&2
    exit 1
  fi
  require_unlocked_phone || exit 1
  # The TRANSPORT serial, not ro.serialno. Over the tailnet adb addresses the
  # phone as "<ip>:<port>" and its hardware serial names no transport at all, so
  # passing the latter made every network install fail with "device not found"
  # -- while the rest of this case carried on re-asserting grants and retiring
  # the Termux recorder as though a new APK were running.
  serial="$ADB_RESOLVED"
  echo "installing to ${serial:-unknown device} ($(adb_any shell getprop ro.serialno 2>/dev/null | tr -d '\r'))"
  install_log="$(mktemp --tmpdir="${TMPDIR:-/realm/tmp/work}" sinnix-phone-install.XXXXXX)"
  trap 'rm -f -- "$install_log"' EXIT
  install_ok=1
  if ! ANDROID_SERIAL="$serial" nix run "${SINNIX_FLAKE_DIR:-/realm/project/sinnix/repo}#sinnix-phone-app-install" 2>&1 | tee "$install_log"; then
    install_ok=0
  fi
  # Success wins over any earlier refusal line. `adb install` retries through
  # more than one strategy (incremental first, then a plain push), so a log
  # can legitimately carry MIUI's refusal AND the install that then worked --
  # and reading the refusal alone turns a completed upgrade into a hard exit.
  if grep -q '^Success' "$install_log"; then
    install_ok=1
  elif grep -q INSTALL_FAILED_USER_RESTRICTED "$install_log"; then
    echo >&2
    echo "app-install: MIUI refused the install (INSTALL_FAILED_USER_RESTRICTED)." >&2
    echo "  Unlock the phone screen and run this again. MIUI shows its own adb" >&2
    echo "  install confirmation, and that dialog cannot appear over the keyguard." >&2
    exit 1
  fi
  if [ "$install_ok" -eq 0 ]; then
    echo "app-install: adb install failed; see the output above" >&2
    exit 1
  fi
  rm -f -- "$install_log"
  trap - EXIT
  ensure_app_grants
  ensure_device_capture_settings
  "$0" app-start

  # Retire Termux's runit `ambient` service. Both recorders can hold the mic
  # at once and write the same `ambient-<UTC>.m4a` shape, so the hazard is
  # provenance, not contention. Over adb because the phone's sshd is usually
  # down. `sv d` is not enough -- termux-microphone-record is a separate
  # process that ignores the TERM -- so `sv k` and a `down` file follow, which
  # is also what makes it survive a reboot. Termux itself stays up: its sshd
  # is the drain's transport.
  echo "retiring the Termux recorder"
  termux_prefix=/data/data/com.termux/files/usr
  termux_retire="export PREFIX=$termux_prefix LD_LIBRARY_PATH=$termux_prefix/lib \
PATH=$termux_prefix/bin:\$PATH HOME=/data/data/com.termux/files/home; \
touch $termux_prefix/var/service/ambient/down; \
sv d $termux_prefix/var/service/ambient >/dev/null 2>&1; \
sv k $termux_prefix/var/service/ambient >/dev/null 2>&1; \
termux-microphone-record -q >/dev/null 2>&1; true"
  if adb_shell_args run-as com.termux sh -c "$termux_retire" >/dev/null 2>&1; then
    echo "  Termux ambient service is down and will stay down across reboots"
  elif ssh_phone "$termux_retire" >/dev/null 2>&1; then
    echo "  Termux ambient service is down and will stay down across reboots"
  else
    echo "  WARNING: the Termux recorder could not be stopped over adb or ssh." >&2
    echo "  If it is still running, it will write chunks the drain cannot" >&2
    echo "  distinguish from the app's. Check: sinnix-phone app-status" >&2
  fi
  ;;
app-start)
  # Starting the foreground service directly from adb is refused (the service
  # is not exported, and exporting it would let any app on the phone drive the
  # microphone). Launching the activity is permitted and starts the service
  # from inside the app, which is why the app has a headless recovery path at
  # all -- the thing Termux never had.
  #
  # It is also the only path that gets the microphone back. A mic-typed
  # foreground service started from the BACKGROUND -- which is what
  # MY_PACKAGE_REPLACED does on every upgrade -- runs without the while-in-use
  # capability, and the platform silences its recording rather than failing it:
  # "App op 27 missing, silencing record" in logcat, exact zeroes in the file,
  # and a status.json that says recording=true throughout. Bringing an activity
  # to the foreground is what grants the capability.
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "app-start: no adb transport" >&2
    exit 1
  fi
  require_unlocked_phone || exit 1
  # NOT redirected to /dev/null. `am start` reports a missing activity in its
  # own output with exit status 0, so a silent launch turns a renamed activity
  # into a capture outage nobody is told about -- which is exactly what
  # happened when the app's launcher moved to .ui.MainActivity.
  start_out=$(adb_any shell am start -n "$APP_ID/$APP_ACTIVITY" 2>&1 | tr -d '\r')
  if printf '%s' "$start_out" | grep -qi 'error'; then
    echo "app-start: could not launch $APP_ID/$APP_ACTIVITY" >&2
    printf '%s\n' "$start_out" >&2
    exit 1
  fi
  sleep 4
  "$0" app-status
  ;;
nix-switch)
  adb_resolve || {
    echo "nix-switch: no adb transport" >&2
    exit 1
  }
  nix_userland_identity
  flake_ref="${1:-}"
  if [ -z "$flake_ref" ]; then
    sinnix_dir="${SINNIX_FLAKE_DIR:-/realm/project/sinnix/repo}"
    revision=$(git -C "$sinnix_dir" rev-parse origin/master)
    flake_ref="github:Sinity/sinnix/$revision#redmi-note-11"
  fi
  adb_shell_args su "$NIX_APP_UID" -c \
    "$(sinnix-remote-command env TMPDIR=/data/data/com.termux.nix/files/usr/tmp /data/data/com.termux.nix/files/usr/bin/login nix-on-droid switch --flake "$flake_ref")"
  nix_userland_fix_labels
  adb_shell_args su "$NIX_APP_UID" -c \
    '/data/data/com.termux.nix/files/usr/bin/login nvim --version' | head -n 1
  ;;
nix-fix-labels)
  adb_resolve || {
    echo "nix-fix-labels: no adb transport" >&2
    exit 1
  }
  nix_userland_fix_labels
  ;;
chroot-build)
  chroot_build "${1:-}"
  ;;
chroot-install)
  adb_resolve || {
    echo "chroot-install: no adb transport" >&2
    exit 1
  }
  module_zip="${1:-/realm/tmp/work/sinnix-debian-chroot.zip}"
  [ -f "$module_zip" ] || {
    echo "missing module archive: $module_zip" >&2
    exit 1
  }
  adb_any push "$module_zip" /data/local/tmp/sinnix-debian-chroot.zip
  chroot_root 'magisk --install-module /data/local/tmp/sinnix-debian-chroot.zip'
  echo "reboot the phone, unlock it, then run: sinnix-phone chroot-bootstrap"
  ;;
chroot-bootstrap)
  adb_resolve || {
    echo "chroot-bootstrap: no adb transport" >&2
    exit 1
  }
  run="$CHROOT_MODULE_ROOT/run.sh"
  chroot_root "test -x $run"
  chroot_root "test ! -x $CHROOT_MODULE_ROOT/rootfs/debootstrap/debootstrap || $run /debootstrap/debootstrap --second-stage"
  chroot_root "$run /usr/bin/apt-get update"
  chroot_root "$run /usr/bin/apt-get install -y --reinstall mawk coreutils dash debianutils findutils grep gzip hostname ncurses-bin sed"
  chroot_root "$run /usr/bin/env DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y --no-install-recommends build-essential ca-certificates curl git jq less locales openssh-client python3 python3-venv rsync sudo tmux vim-tiny"
  chroot_root "$run /usr/bin/env DEBIAN_FRONTEND=noninteractive /usr/bin/dpkg --configure -a"
  chroot_root "$run /usr/bin/dpkg --audit"
  ;;
chroot)
  adb_resolve || {
    echo "chroot: no adb transport" >&2
    exit 1
  }
  if [ "$#" -eq 0 ]; then
    adb_any shell -t "$(sinnix-remote-command su -c "$CHROOT_MODULE_ROOT/run.sh")"
  else
