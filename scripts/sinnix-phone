  out="/realm/tmp/work/phone-$(date +%Y%m%d-%H%M%S).png"
  adb_phone shell screencap -p /sdcard/.sinnix-shot.png
  adb_phone pull /sdcard/.sinnix-shot.png "$out" >/dev/null
  adb_phone shell rm -f /sdcard/.sinnix-shot.png
  echo "$out"
  ;;
logcat)
  # System log and BCR recordings are the two deliberate pulls. The Sinnix
  # capture app pushes its own data, but logcat needs READ_LOGS and BCR is a
  # separate privileged app whose staging file is more authoritative than its
  # document-provider export.
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "logcat: no adb transport — adbd's TCP mode does not survive a reboot"
    echo "        restore it over USB with: sinnix-phone adb-restore"
    exit 1
  fi
  ensure_device_capture_settings
  # Android can leave its always-on VPN service registered with no process
  # after a low-memory kill. Restore only the operator-selected VPN, without
  # opening an activity or changing VPN preferences.
  configured_vpn=$(adb_shell_args settings get secure always_on_vpn_app | tr -d '\r')
  if [ "$configured_vpn" = com.tailscale.ipn ] &&
    ! adb_shell_args pidof com.tailscale.ipn >/dev/null 2>&1; then
    adb_shell_args su -c "$(sinnix-remote-command am startservice -n com.tailscale.ipn/.IPNService -a android.net.VpnService)" || exit 1
    sleep 1
    adb_shell_args pidof com.tailscale.ipn >/dev/null || {
      echo "logcat: configured always-on VPN did not restart; phone uploads remain blocked" >&2
      exit 1
    }
  fi
  logcat_rc=0
  drain_logcat_adb || logcat_rc=$?
  bcr_rc=0
  drain_bcr_calls_adb || bcr_rc=$?

  # This scheduled probe also checks whether the capture app's uploads land.
  backlog=$(adb_any shell 'ls /sdcard/sinnix-ambient/*.m4a 2>/dev/null | wc -l' 2>/dev/null | tr -d '\r')
  if [ -n "${backlog:-}" ] && [ "$backlog" -gt 12 ]; then
    echo "logcat: WARNING -- $backlog finished chunks still on the phone; uploads are not landing." >&2
    echo "  Ask the app why: adb shell grep chunk_upload_blocked in today's events file." >&2
    echo "  Recover them by hand with: sinnix-phone pull-ambient" >&2
  fi
  if [ "$bcr_rc" -ne 0 ]; then
    exit "$bcr_rc"
  fi
  if [ "$logcat_rc" -ne 0 ]; then
    exit "$logcat_rc"
  fi
  ;;
bcr-sync)
  if ! adb_any get-state >/dev/null 2>&1; then
    echo "bcr-sync: no adb transport" >&2
    exit 1
  fi
  drain_bcr_calls_adb
  ;;
health-sync)
  # Fresh resource-id bounds support the English and Polish app layouts.
  adb_resolve || { echo "health-sync: no adb transport" >&2; exit 1; }
  require_unlocked_phone || exit 1
  ui_dump="/sdcard/sinnix-health-sync.xml"
  tap_control() {
    adb_any shell uiautomator dump "$ui_dump" >/dev/null 2>&1
    local bounds
    bounds="$(adb_any shell cat "$ui_dump" | python3 -c '
import re, sys, xml.etree.ElementTree as ET
root = ET.fromstring(sys.stdin.read())
resource, *labels = sys.argv[1:]
nodes = [n for n in root.iter("node")
         if n.get("package") == "com.xiaomi.wearable"
         and n.get("resource-id") == resource
         and n.get("text") in labels]
if len(nodes) != 1:
    sys.exit("health-sync: expected one matching control; not tapping")
b = list(map(int, re.findall(r"\d+", nodes[0].get("bounds", ""))))
if len(b) != 4 or b[2] <= b[0] or b[3] <= b[1]:
    sys.exit("health-sync: control has no visible bounds")
print((b[0] + b[2]) // 2, (b[1] + b[3]) // 2)
' "$@")" || return 1
    local x y
    read -r x y <<<"$bounds"
    adb_any shell input tap "$x" "$y"
  }
  adb_any shell monkey -p com.xiaomi.wearable \
    -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
  sleep 3
  tap_control com.xiaomi.wearable:id/main_tv_tab_name Device Urządzenie
  sleep 3
  tap_control com.xiaomi.wearable:id/device_tv_synchronize Sync Synchronizuj
  sleep 30
  # The watchdog is deliberately not exported. Shell broadcasts finish with
  # result=0 even when Android refuses delivery; the rooted phone must send it
  # as root to run the Health Connect sweep after the band sync.
  adb_shell_args su -c "$(sinnix-remote-command am broadcast -n dev.sinnix.phone/.capture.WatchdogReceiver)"
  adb_any shell rm -f "$ui_dump"
  echo "health-sync: Mi Fitness sync triggered; verify imported measurement timestamps"
  ;;
ambient-audit)
  # A chunk that captured nothing is byte-for-byte plausible: full bitrate,
  # exact duration, valid container. Only decoding the samples reveals it, so
  # the level is recorded at intake and a dead window becomes visible data
  # rather than a later suspicion.
  ledger="$LAKE_ROOT/ambient-levels.jsonl"
  if [ ! -d "$LAKE_ROOT/ambient" ] || [ ! -r "$LAKE_ROOT/ambient" ] || [ ! -x "$LAKE_ROOT/ambient" ]; then
    echo "ambient-audit: source unavailable: $LAKE_ROOT/ambient" >&2
    exit 1
  fi
  touch "$ledger"
  # Previous inspections remain history. Only content-bound decode results
  # qualify for reuse; size alone cannot identify a repaired/replaced chunk.
  seen=$(jq -r 'select(has("decode_ok") and .sha256 != null) | "\(.chunk) \(.sha256)"' "$ledger" | sort -u)
  added=0
  silent=0
  changed=0
  while IFS= read -r chunk; do
    name=$(basename "$chunk")
    bytes=$(stat -c %s "$chunk")
    digest=$(sha256sum "$chunk")
    digest=${digest%% *}
    if printf '%s\n' "$seen" | grep -qxF "$name $digest"; then
      continue
    fi
    # A chunk this tool cannot decode is a finding, not an error: `set -e`
    # plus `pipefail` would otherwise abort the whole audit on the first
    # truncated file, which is precisely the file worth recording.
    duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$chunk" 2>/dev/null </dev/null || true)
    rate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of default=nw=1:nk=1 "$chunk" 2>/dev/null </dev/null || true)
    decode_ok=true
    if ! levels=$(ffmpeg -nostdin -hide_banner -nostats -i "$chunk" -af volumedetect -f null - 2>&1 |
      awk '/mean_volume:/ {mean=$(NF-1)} /max_volume:/ {max=$(NF-1)} END {print mean, max}'); then
      decode_ok=false
    fi
    after_digest=$(sha256sum "$chunk")
    after_digest=${after_digest%% *}
    if [ "$after_digest" != "$digest" ]; then
      echo "ambient-audit: source changed during inspection: $chunk" >&2
      changed=$((changed + 1))
      continue
    fi
    mean=${levels% *}
    max=${levels#* }
    # -91 dB is what a stream of exact zeroes decodes to; anything at or below
    # it captured no sound at all, however healthy the file looks.
    dead=$(jq -n --arg max "$max" --argjson decoded "$decode_ok" '
      if $decoded | not then null
      elif $max == "-inf" then true
      else ($max | tonumber?) as $level | if $level == null then null else $level <= -91 end end')
    # tonumber? can produce no value, which is also an unknown measurement.
    dead=${dead:-null}
    [ "$dead" != true ] || silent=$((silent + 1))
    jq -nc --arg chunk "$name" --argjson bytes "${bytes:-0}" --arg dur "${duration:-}" --arg rate "${rate:-}" \
      --arg mean "${mean:-}" --arg max "${max:-}" --argjson dead "$dead" \
      --argjson decoded "$decode_ok" --arg sha256 "$digest" \
      '{chunk: $chunk, bytes: $bytes, duration_seconds: ($dur | tonumber? // null),
        sample_rate: ($rate | tonumber? // null),
        mean_db: ($mean | tonumber? // null), max_db: ($max | tonumber? // null),
        captured_nothing: $dead, decode_ok: $decoded, sha256: $sha256}' >>"$ledger"
    added=$((added + 1))
    if [ "$((added % 100))" -eq 0 ]; then
      echo "ambient-audit: progress $added inspected"
    fi
  done < <(find "$LAKE_ROOT/ambient" -maxdepth 1 -type f \( -name '*.m4a' -o -name '*.m4a.orphan' \) | sort)
  echo "ambient-audit: measured $added new chunk(s), $silent captured nothing"
  # The ledger is append-only and a chunk may be measured more than once (a
  # repaired transfer is a different file under the same name), so the newest
  # record per chunk is the true one. Report that rather than raw line counts,
  # which overstate the lake by however many re-measurements have happened.
  jq -rs 'group_by(.chunk) | map(last)
    | "  lake now: \(length) inspected files, \([.[] | select(.decode_ok == true and .captured_nothing == true)] | length) captured nothing, \([.[] | select(.decode_ok != true or .captured_nothing == null)] | length) unknown, \((([.[] | select(.decode_ok == true and .captured_nothing == false) | .duration_seconds // 0] | add // 0) / 3600 * 10 | round / 10)) hours in sound-bearing chunks"' \
    "$ledger"
  if [ "$silent" -gt 0 ]; then
    echo "  silent chunks are listed in $ledger (captured_nothing: true)" >&2
  fi
  [ "$changed" -eq 0 ] || exit 1
  ;;
pull-ambient)
  # The manual recovery path for chunks the app could not upload. Not part of
  # the drain: this exists for the case where uploads are broken and the audio
  # has to be rescued over whichever transport is up.
  mkdir -p "$LAKE_ROOT/ambient"
  # Same storage-read probe `pull` uses: an sshd in the runas_app SELinux
  # domain answers rsync with an empty listing and exit 0, so "answers" is
  # not the same question as "can read the chunks".
  if ssh_phone 'test -r /sdcard/sinnix-ambient' >/dev/null 2>&1; then
    rsync -av --ignore-existing --exclude='*.part' --exclude='status.json*' -e "$rsync_ssh" \
      "${PHONE_USER}@${PHONE_SSH_HOST}:/sdcard/sinnix-ambient/" "$LAKE_ROOT/ambient/"
  elif adb_any get-state >/dev/null 2>&1; then
    echo "ssh unavailable; pulling ambient over adb instead"
    drain_ambient_adb
  else
    echo "no transport to the phone: ambient chunks stay on the device" >&2
    exit 1
  fi
  ;;
unlock)
  ensure_adb
  helper=$(command -v sinnix-phone-keyguard)
  dex="$(dirname "$(dirname "$helper")")/share/keyguard.dex"
  exec sinnix-phone-keyguard "$ADB_TARGET" "$dex" "${1:-60}"
  ;;
adb-connect)
  ensure_adb
  echo "Connected to $ADB_TARGET"
  ;;
adb-restore)
  if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --persistent ]; }; then
    echo "adb-restore: expected --persistent or no argument" >&2
    exit 2
  fi
  usb_serial="${SINNIX_PHONE_ADB_SERIAL:-$(cat "$PHONE_STATE/adb-serial" 2>/dev/null || true)}"
  [ -n "$usb_serial" ] || { echo "phone ADB serial not enrolled" >&2; exit 1; }
  adb -s "$usb_serial" get-state >/dev/null
  adb -s "$usb_serial" shell settings put global adb_wifi_enabled 1
  ADB_RESOLVED="$usb_serial"
  if [ "${1:-}" = --persistent ]; then
    install_wireless_adb_boot
  fi
  echo "Wireless debugging requested; endpoint discovery follows port changes."
  ;;
clip-push)
  # text/* only -- termux-clipboard-set takes a string argument; pushing raw
  # image bytes (a screenshot copy, the common non-text case) would either
  # error or silently set garbage text, so skip non-text content instead.
  mime="$(wl-paste --list-types 2>/dev/null | head -1)"
  case "$mime" in
    text/*|"")
      if ! clipboard_command=$(wl-paste -n | sinnix-remote-command --stdin-last termux-clipboard-set --); then
        echo "clip-push: clipboard could not be encoded" >&2
        exit 1
      fi
      ssh_phone "$clipboard_command"
      ;;
    *) : ;; # non-text clipboard (image, etc.) -- nothing to push
  esac
  ;;
clip-watch)
  # Foreground loop, run under systemd (Type=simple). wl-paste -w blocks
  # until the clipboard changes, so this is push-triggered, not polled. No
  # loop-guard needed: this direction never writes back to the desktop
  # clipboard, so there is nothing to echo.
  exec wl-paste --watch "$0" clip-push
  ;;
*)
  usage
  exit 1
  ;;
esac
