#!/usr/bin/env bash
# @sinnix-package
# description: Reach the phone over the tailnet — status, shell, screen mirror, media pull, clipboard push
# runtimeInputs: bash coreutils openssh rsync android-tools scrcpy iputils jq wl-clipboard

#
# The phone (Redmi Note 11, unrooted) is a tailnet peer with two control
# surfaces: Termux sshd on :8022 for shell/file work, and adbd on :5555 for
# device-level control (input, screencap, packages, settings). Both ride the
# tailnet, so this works from anywhere the tailnet reaches — not just the LAN.
#
# adbd over TCP does NOT survive a phone reboot; `sinnix-phone adb-restore`
# re-enables it over USB. Everything else survives.
#
# CLIPBOARD IS ONE-WAY (desktop -> phone), NOT A BUG. Android blocks
# clipboard READS from a backgrounded app (privacy restriction since Android
# 10): `termux-clipboard-get` silently returns empty unless Termux is the
# foreground app (verified live 2026-08-13). `termux-clipboard-set` has no
# such restriction and works fine from a backgrounded ssh session. So
# phone->desktop clipboard sync would need Termux kept foregrounded
# continuously (bad UX) or an AccessibilityService-based reader (see
# sinnix-uyvt.6) -- not attempted here. PRIMARY has no Android equivalent at
# all, so there is nothing to sync for it; this covers CLIPBOARD only.
set -euo pipefail

PHONE_TS_IP="${SINNIX_PHONE_IP:-100.124.215.25}"
PHONE_SSH_PORT="${SINNIX_PHONE_SSH_PORT:-8022}"
PHONE_USER="${SINNIX_PHONE_USER:-u0_a398}"
ADB_TARGET="${PHONE_TS_IP}:5555"
LAKE_ROOT="${SINNIX_PHONE_LAKE:-/realm/data/captures/phone}"

# -F /dev/null + explicit identity, not ~/.ssh/config: under a sandboxed
# systemd unit's ProtectHome, ssh rejects the Home-Manager ~/.ssh/config
# symlink outright ("Bad owner or permissions", exit 255) -- the same trap
# capture-router.nix hit. A script invoked by both a human and a timer
# should not depend on interactive config either way.
ssh_phone_opts=(
  # -o Port=, not -p: this array is shared verbatim with scp_phone() below,
  # and scp's -p means "preserve file attributes" (a no-arg flag), not
  # port -- passing `-p 8022` to scp silently misparses 8022 as a stray
  # filename argument. -o Port= means the same thing to both tools.
  -o "Port=$PHONE_SSH_PORT"
  -F /dev/null
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
  -o "UserKnownHostsFile=${SINNIX_PHONE_KNOWN_HOSTS:-$HOME/.ssh/known_hosts}"
  -o IdentitiesOnly=yes
  # ssh-agent can hold a key that LOOKS like a match and still get "signing
  # failed... agent refused operation" from it (observed live 2026-08-13,
  # reproducible, agent had 12 keys loaded) -- IdentitiesOnly=yes restricts
  # which identity FILES are tried but does not stop the agent from being
  # asked first. Go straight to the key file; this identity doesn't need
  # agent-forwarding semantics.
  -o IdentityAgent=none
  -i "${SINNIX_PHONE_IDENTITY:-$HOME/.ssh/id_ed25519}"
  # Connection multiplexing (sinnix-uyvt.1 latency profiling, 2026-08-13):
  # raw tailnet RTT to the phone is ~4-11ms, but each cold SSH handshake
  # measured ~380-586ms -- multi-step commands like `note` (list, then N
  # scp pulls) were paying that cost 2-4x sequentially, dwarfing the actual
  # network hop and accounting for most of a reported "1-2s" round-trip.
  # ControlMaster reuses one authenticated connection for every ssh/scp
  # call in a single script invocation; ControlPersist=120 keeps it alive
  # briefly across quick successive commands (e.g. a human running `note`
  # right after `status`) without lingering indefinitely on a device that
  # roams networks. %C is ssh's single-token hash of user+host+port, so the
  # socket path can't grow unboundedly long.
  -o ControlMaster=auto
  -o ControlPersist=120
  -o "ControlPath=${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}/%C"
)
mkdir -p "${SINNIX_PHONE_SSH_CONTROL_DIR:-$HOME/.cache/sinnix-phone-ssh}"
# Same flags as a single shell-word, for rsync -e (which needs a word, not
# an array) -- computed once at top level so every case branch can use it,
# not just whichever one happens to run first (case branches are NOT
# separate scopes; a `"$0" subcmd` re-invocation IS a separate process,
# which is why this isn't computed inline inside `pull)` alone).
rsync_ssh="ssh ${ssh_phone_opts[*]}"
# shellcheck disable=SC2029  # client-side expansion is intended: callers
# (clip-push) build the remote command with their own already-expanded args.
ssh_phone() { ssh "${ssh_phone_opts[@]}" "${PHONE_USER}@${PHONE_TS_IP}" "$@"; }
scp_phone() { scp "${ssh_phone_opts[@]}" "$@"; }
adb_phone() { ANDROID_SERIAL="$ADB_TARGET" adb "$@"; }

ensure_adb() {
  if ! ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    adb connect "$ADB_TARGET" >/dev/null 2>&1 || true
    sleep 1
  fi
}

usage() {
  cat <<'EOF'
sinnix-phone <command>

  status        tailnet reachability, adb + ssh liveness, battery, storage
  shell [cmd]   Termux shell over the tailnet (interactive when no cmd)
  mirror        scrcpy screen mirror/control over the tailnet
  screenshot    grab the current screen to /realm/tmp/work/
  pull          rsync camera + downloads + health exports into the lake
  drain         pull, but only if the phone is on wifi (for a timer)
  adb-connect   (re)attach adb over the tailnet
  adb-restore   re-enable adbd TCP mode (requires the phone on USB)
  clip-push     push the current desktop clipboard to the phone, once
  clip-watch    watch desktop clipboard, push on change (foreground loop)
  note [min]    mark+transcribe the last [min] minutes (default 3) of the
                already-running ambient capture, land a dated note in the
                knowledgebase -- no separate recording, nothing to walk
                away from
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
status)
  echo "== phone =="
  # TCP, not ICMP: a dozing Android drops pings while still accepting
  # connections, so ping reports a false outage on a working link.
  if timeout 5 bash -c "exec 3<>/dev/tcp/$PHONE_TS_IP/$PHONE_SSH_PORT" 2>/dev/null; then
    echo "tailnet   : reachable ($PHONE_TS_IP)"
  else
    echo "tailnet   : UNREACHABLE ($PHONE_TS_IP)"
  fi
  if ssh_phone 'true' >/dev/null 2>&1; then
    echo "ssh       : up (termux :$PHONE_SSH_PORT)"
  else
    echo "ssh       : down — Termux may be stopped; open Termux, run: sshd"
  fi
  ensure_adb
  if ANDROID_SERIAL="$ADB_TARGET" adb get-state >/dev/null 2>&1; then
    echo "adb       : up ($ADB_TARGET)"
    lvl=$(adb_phone shell dumpsys battery 2>/dev/null | awk -F': ' '/ level/{print $2}' | tr -d '\r')
    free=$(adb_phone shell df -h /sdcard 2>/dev/null | awk 'END{print $4}' | tr -d '\r')
    echo "battery   : ${lvl:-?}%"
    echo "sdcard    : ${free:-?} free"
  else
    echo "adb       : down — run: sinnix-phone adb-restore (needs USB)"
  fi
  ;;
shell)
  if [ "$#" -eq 0 ]; then ssh_phone; else ssh_phone "$@"; fi
  ;;
mirror)
  ensure_adb
  exec scrcpy -s "$ADB_TARGET" --window-title "phone (tailnet)" "$@"
  ;;
screenshot)
  ensure_adb
  mkdir -p /realm/tmp/work
  out="/realm/tmp/work/phone-$(date +%Y%m%d-%H%M%S).png"
  adb_phone shell screencap -p /sdcard/.sinnix-shot.png
  adb_phone pull /sdcard/.sinnix-shot.png "$out" >/dev/null
  adb_phone shell rm -f /sdcard/.sinnix-shot.png
  echo "$out"
  ;;
pull)
  # Camera and downloads are the durable originals; the health-export folder
  # is where the Health Connect scheduled export lands (see bead sinnix-fmkb).
  # Pull only — never push back, and never delete on the phone.
  mkdir -p "$LAKE_ROOT"/{camera,download,health,ambient}
  set +e
  rsync -av --ignore-existing -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/DCIM/" "$LAKE_ROOT/camera/"
  rsync -av --ignore-existing -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/Download/" "$LAKE_ROOT/download/"
  rsync -av --ignore-existing -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/HealthConnectExport/" "$LAKE_ROOT/health/" 2>/dev/null
  # Continuous ambient audio chunks. --ignore-existing plus the fact that a
  # chunk is only closed when the next one starts means the in-progress file
  # gets skipped now and collected on the following run, rather than being
  # copied half-written.
  rsync -av --ignore-existing -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-ambient/" "$LAKE_ROOT/ambient/" 2>/dev/null
  set -e
  du -sh "$LAKE_ROOT" 2>/dev/null
  ;;
drain)
  # sinnix-uyvt.2.1's tiered-sync policy, revised 2026-08-13 (operator: "no
  # need to charging gate"). This drains the RAW AUDIO tier specifically --
  # large, not time-critical -- which the operator explicitly still wants
  # wifi-gated ("we'd still want full data transferred on wifi, to be
  # clear, eventually"), so that half of the original gate stays. Charging
  # had no stated justification and is dropped: a phone that's been off
  # wifi+charging for hours was already an accepted gap per the runtime
  # surface's generous staleAfterSeconds, and charging specifically just
  # delayed draining without protecting anything the wifi gate doesn't
  # already cover (this is a network-cost/opportunism gate, not a battery
  # one). A future always-on VAD-gated live stream (sinnix-uyvt.4, small by
  # construction) is a SEPARATE tier this bead doesn't cover -- see uyvt.2.1
  # notes for why it isn't built yet (no VAD tooling installed on-device).
  if ! timeout 5 bash -c "exec 3<>/dev/tcp/$PHONE_TS_IP/$PHONE_SSH_PORT" 2>/dev/null; then
    echo "drain: phone unreachable, skipping"
    exit 0
  fi
  ensure_adb
  wifi_state=$(ssh_phone termux-wifi-connectioninfo 2>/dev/null | jq -r '.supplicant_state // empty')
  if [ "$wifi_state" != "COMPLETED" ]; then
    echo "drain: not on wifi (state: ${wifi_state:-unknown}), skipping"
    exit 0
  fi
  echo "drain: wifi confirmed, pulling"
  "$0" pull

  # sinnix-uyvt.2.1 (3): device-side rotation. 37G free is finite; the phone
  # needs a ring that provably never deletes a chunk the lake hasn't taken.
  # --remove-source-files removes a source file only once rsync has
  # confirmed it matches the destination -- whether that confirmation
  # happened just now or on an earlier run (a file `pull`'s --ignore-existing
  # skipped because it was already there is still confirmed-in-sync, so this
  # is safe to run standalone). Scoped to ambient only: camera/downloads/
  # health are the operator's originals, not a rotating buffer.
  mkdir -p "$LAKE_ROOT/ambient"
  rsync -a --remove-source-files -e "$rsync_ssh" \
    "${PHONE_USER}@${PHONE_TS_IP}:/sdcard/sinnix-ambient/" "$LAKE_ROOT/ambient/" 2>/dev/null

  # This is a soft ring (bounded by drain cadence: at most ~1 interval's
  # worth of chunks accumulate between drains) rather than a hard size cap.
  # If drains stop happening for an extended stretch (phone never on wifi +
  # charging), on-device growth is genuinely unbounded -- surface that
  # rather than silently trusting the cadence to hold.
  used_kb=$(ssh_phone "du -sk /sdcard/sinnix-ambient 2>/dev/null" | awk '{print $1}')
  if [ -n "${used_kb:-}" ] && [ "$used_kb" -gt 512000 ]; then
    echo "drain: WARNING -- /sdcard/sinnix-ambient is ${used_kb}KB and not shrinking after rotation; drains may have stalled"
  fi
  ;;
adb-connect)
  adb connect "$ADB_TARGET"
  ;;
adb-restore)
  echo "Phone must be on USB with debugging authorized."
  adb devices
  adb tcpip 5555
  sleep 3
  adb connect "$ADB_TARGET"
  ;;
clip-push)
  # text/* only -- termux-clipboard-set takes a string argument; pushing raw
  # image bytes (a screenshot copy, the common non-text case) would either
  # error or silently set garbage text, so skip non-text content instead.
  mime="$(wl-paste --list-types 2>/dev/null | head -1)"
  case "$mime" in
    text/*|"")
      text="$(wl-paste -n 2>/dev/null || true)"
      [ -n "$text" ] || exit 0
      ssh_phone "termux-clipboard-set" -- "$text" 2>/dev/null || true
      ;;
    *) : ;; # non-text clipboard (image, etc.) -- nothing to push
  esac
  ;;
clip-watch)
  # Foreground loop, run under systemd (Type=simple). wl-paste -w blocks
  # until the clipboard changes, so this is push-triggered, not polled --
  # cheap and immediate. No loop-guard needed: this direction never writes
  # back to the desktop clipboard, so there is nothing to echo.
  exec wl-paste --watch "$0" clip-push
  ;;
note)
  # sinnix-uyvt.1 track 2, redesigned 2026-08-13. The operator already runs
  # the sinnix-uyvt.2.1 ambient lane continuously (~/ambient-capture.sh, 5min
  # chunks to /sdcard/sinnix-ambient/) -- the first version of this command
  # started a SEPARATE bounded recording ("voicenote 30" = record 30s, walk
  # away, get a note eventually), which the operator correctly called
  # bizarre: it duplicates capture that's already happening and forces
  # specifying a duration upfront for something that should just mean "what
  # I just said matters, go find it".
  #
  # This version is retroactive: it marks and transcribes the END of the
  # ambient stream instead of starting a new recording. `note [minutes]`
  # (default 3) grabs however many already-CLOSED ambient chunks cover the
  # requested trailing window and transcribes them.
  #
  # LATENCY, STATED HONESTLY: chunks are 5min (AMBIENT_CHUNK_SECONDS) and an
  # m4a container is unreadable until termux-microphone-record finalizes it,
  # so the most recent chunk is always excluded even if it already covers
  # the requested window -- worst case, something said right after a chunk
  # boundary isn't groupable until the NEXT boundary, up to ~5min later. An
  # on-demand early-rotation trigger was attempted and reverted the same
  # night: live-testing a second termux-microphone-record call against the
  # running one showed real mic-contention side effects, not worth risking
  # a continuous capture the operator depends on. Fix properly (e.g. a
  # rotation request queued and honored at the TOP of the next natural loop
  # iteration, never interrupting an active recording) in a follow-on, not
  # here.
  #
  # ENGINE NOTE (unchanged from the original bead instruction): whisper.cpp
  # on :8090 is a stated v0 stopgap, not sinnix-mke's target engine.
  minutes="${1:-3}"
  note_root="${SINNIX_KB_ROOT:-/realm/data/knowledgebase}"
  work="/realm/tmp/work/note-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$work"

  echo "note: listing closed ambient chunks (last ${minutes}min window)"
  # Sorted oldest-first; the newest name is always excluded, live or not --
  # simpler and safer than timing out whether it happened to finish.
  chunk_list=$(ssh_phone "ls -1 /sdcard/sinnix-ambient/*.m4a 2>/dev/null | sort")
  if [ -z "$chunk_list" ]; then
    echo "note: no ambient chunks found on the phone. Is sinnix-uyvt.2.1's" >&2
    echo "  capture loop running? (sinnix-phone shell 'pgrep -af ambient-capture')" >&2
    exit 1
  fi
  # Drop the newest (possibly still open); walk backwards from there
  # accumulating chunks until we cover the requested window or run out.
  mapfile -t chunks <<< "$chunk_list"
  closed_count=$(( ${#chunks[@]} - 1 ))
  if [ "$closed_count" -lt 1 ]; then
    echo "note: only one ambient chunk exists and it's still open (started" >&2
    echo "  within the last ~5min) -- nothing closed to transcribe yet." >&2
    exit 1
  fi
  # 300s default chunk length; ceil(minutes*60 / 300), at least 1, capped to
  # what's actually available.
  chunk_secs="${AMBIENT_CHUNK_SECONDS:-300}"
  want=$(( (minutes * 60 + chunk_secs - 1) / chunk_secs ))
  [ "$want" -lt 1 ] && want=1
  [ "$want" -gt "$closed_count" ] && want=$closed_count
  start_idx=$(( closed_count - want ))
  selected=("${chunks[@]:$start_idx:$want}")

  echo "note: pulling ${#selected[@]} chunk(s)"
  local_clips=()
  i=0
  for remote in "${selected[@]}"; do
    i=$((i + 1))
    local_clip="$work/chunk-$i.m4a"
    # scp_phone() reuses ssh_phone_opts, so this rides the same
    # ControlMaster connection the preceding `ssh_phone "ls..."` call
    # opened above -- no repeat handshake per chunk pulled.
    scp_phone "${PHONE_USER}@${PHONE_TS_IP}:${remote}" "$local_clip"
    local_clips+=("$local_clip")
  done

  # Concat via ffmpeg's concat demuxer, then trim to the trailing $minutes
  # (a chunk boundary rarely lines up with the requested window exactly).
  concat_list="$work/concat.txt"
  : > "$concat_list"
  for c in "${local_clips[@]}"; do
    printf "file '%s'\n" "$c" >> "$concat_list"
  done
  full="$work/full.m4a"
  ffmpeg -y -f concat -safe 0 -i "$concat_list" -c copy "$full" >/dev/null 2>&1
  trimmed="$work/trimmed.wav"
  total_secs=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$full")
  trim_start=$(awk -v t="$total_secs" -v m="$minutes" 'BEGIN { s = t - (m*60); print (s < 0 ? 0 : s) }')
  ffmpeg -y -i "$full" -ss "$trim_start" -ar 16000 -ac 1 "$trimmed" >/dev/null 2>&1

  echo "note: transcribing via the STT hub (:8090, whisper v0 stopgap)"
  set +e
  transcript_json=$(curl -sf -X POST "http://127.0.0.1:8090/v1/audio/transcriptions" \
    -F "file=@${trimmed}" -F "model=whisper-1")
  curl_status=$?
  set -e
  if [ "$curl_status" -ne 0 ]; then
    echo "note: STT hub unreachable at :8090 (curl exit $curl_status)." >&2
    echo "  whisper.enable is set in host config but this looks like it hasn't" >&2
    echo "  been switched live yet -- the audio is saved at $trimmed," >&2
    echo "  retry this command after switch." >&2
    exit 1
  fi
  text=$(printf '%s' "$transcript_json" | jq -r '.text // empty')
  if [ -z "$text" ]; then
    echo "note: transcription failed or empty (silence in the window?). Raw response:" >&2
    printf '%s\n' "$transcript_json" >&2
    exit 1
  fi

  stamp="$(date +%Y-%m-%d_%H-%M-%S)"
  note_path="${note_root}/voicenote.${stamp}.md"
  {
    echo "---"
    echo "source: phone-ambient-note"
    echo "engine: whisper-v0-stopgap  # sinnix-uyvt.1: replace with sinnix-mke once its hub lands"
    echo "marked: ${stamp}"
    echo "window_minutes: ${minutes}"
    echo "source_chunks: ${selected[*]}"
    echo "audio: ${trimmed}"
    echo "---"
    echo ""
    printf '%s\n' "$text"
  } > "$note_path"
  echo "note: wrote $note_path"
  printf '%s\n' "$text"
  ;;
*)
  usage
  exit 1
  ;;
esac
