#!/usr/bin/env python3
# @sinnix-package
# description: Filesystem index pipeline — directory inventory, content scan and judgment ledger (inventory/content/ledger/run)
# runtimeInputs: python3 duckdb coreutils file
# pythonPackages: @sinnix-lib

"""sinnix-fs — the filesystem index pipeline, as one CLI.

Three stages, previously three scripts, always run in sequence by
`sinnix-fs-index.service`: `inventory` walks directories into a mechanical
scan, `content` indexes document-bearing files (hashes, titles, excerpts),
and `ledger` materializes the hand-authored judgment ledger against both
scans. They share one process shape (JSONL -> DuckDB -> Parquet, run
through the duckdb CLI via a scratch script file) and one `--out-dir` /
`--index-dir` on disk, which is why they are one script now: splitting them
never bought independent invocation, only duplicated the mechanics. `run`
is the three in sequence, sharing one out-dir -- the service's actual entry
point.

Each subcommand's own docstring below (`INVENTORY_DOC`, `CONTENT_DOC`,
`LEDGER_DOC`) carries the design rationale that used to live at the top of
its standalone file; read it via `sinnix-fs <subcommand> --help`.
"""

from __future__ import annotations

from sinnix_lib.atomic import atomic_text_writer

import argparse
import datetime as dt
import hashlib
import json
import os
import pwd
import grp
import re
import stat
import subprocess
import sys
import tempfile
import time
from collections import Counter, deque
from pathlib import Path

DEFAULT_ROOTS = ["/realm", "/outer-realm"]


def safe(value):
    """Filenames on this system are not all valid UTF-8.

    os.scandir hands back surrogate escapes for undecodable bytes, and
    json.dumps then refuses to encode them -- killing a whole-filesystem walk
    over one badly-named file. Replace the unencodable parts rather than skip
    the entry: the name is degraded, the record survives.
    """
    if isinstance(value, str):
        return value.encode("utf-8", "replace").decode("utf-8")
    if isinstance(value, dict):
        return {safe(k): safe(v) for k, v in value.items()}
    if isinstance(value, list):
        return [safe(v) for v in value]
    return value


def run_duckdb_file(db: Path, sql: str, script_name: str) -> subprocess.CompletedProcess:
    """Execute SQL through a private scratch file beside its staged database."""
    db.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", prefix=f".{script_name}.", suffix=".sql",
        dir=db.parent, delete=False,
    ) as handle:
        script = Path(handle.name)
        handle.write(sql)
    try:
        return subprocess.run(["duckdb", str(db), "-f", str(script)], text=True,
                              capture_output=True, check=False)
    finally:
        script.unlink(missing_ok=True)


def duckdb_query(db: Path, sql: str) -> subprocess.CompletedProcess:
    return subprocess.run(["duckdb", str(db), "-noheader", "-list", "-c", sql],
                          text=True, capture_output=True, check=False)


def _fsync_file(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def materialize_pair(
    db: Path, parquet: Path, sql_for_parquet, table: str,
) -> str:
    """Build and validate a database/Parquet pair before replacing either output.

    The two final names remain a compatibility contract for existing readers.
    Staging prevents a failed rerun from destroying their prior generation;
    readers can only observe a mixed pair during the two final renames.
    """
    db.parent.mkdir(parents=True, exist_ok=True)
    if db.parent != parquet.parent:
        raise ValueError("database and parquet must share a publication directory")
    with tempfile.TemporaryDirectory(prefix=f".{db.stem}.materialize-", dir=db.parent) as staging:
        stage = Path(staging)
        staged_db = stage / db.name
        staged_parquet = stage / parquet.name
        proc = run_duckdb_file(staged_db, sql_for_parquet(staged_parquet), "materialize")
        if proc.returncode != 0:
            print(proc.stdout, file=sys.stderr)
            print(proc.stderr, file=sys.stderr)
            raise SystemExit(f"duckdb failed ({proc.returncode})")

        check = duckdb_query(staged_db, f"SELECT count(*) FROM {table}")
        rows = check.stdout.strip()
        if check.returncode != 0 or not rows.isdigit() or int(rows) == 0:
            raise SystemExit(f"materialize produced no rows (duckdb said: {rows!r} "
                             f"{check.stderr.strip()})")
        parquet_check = duckdb_query(
            staged_db, f"SELECT count(*) FROM read_parquet({sql_string(staged_parquet)})",
        )
        if (parquet_check.returncode != 0 or parquet_check.stdout.strip() != rows):
            raise SystemExit(f"parquet validation failed for {staged_parquet}: "
                             f"{parquet_check.stderr.strip()}")

        # DuckDB has closed its writers; make both completed files durable
        # before either public name moves.  os.replace is same-directory here.
        _fsync_file(staged_db)
        _fsync_file(staged_parquet)
        os.replace(staged_db, db)
        os.replace(staged_parquet, parquet)
        directory = os.open(db.parent, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        return rows


# =====================================================================
# inventory
# =====================================================================

INVENTORY_DOC = """A queryable index of what is on this machine's disks.

This system has ~4 TB across /realm and /outer-realm and no way to answer
"what is this, who writes it, is it a copy of something else" without walking
it by hand every time. This builds the index once and makes it a dataset.

Two layers, deliberately:

  MECHANICAL (this subcommand)  one row per directory: sizes, counts, mtime
                             range, owners, an extension histogram and a
                             sample of names. Cheap, exhaustive, re-runnable.
  CHARACTERISED (agents)     prose per directory: what it actually is, who
                             writes it, whether it duplicates something else.
                             Written into a separate table so a re-scan never
                             destroys it.

Keeping those apart is the whole design. A scan must be free to re-run nightly;
a judgement about what a directory is for costs real attention and must
survive. They join on the path.

Storage follows the url-ledger precedent: JSONL is the append-only source of
truth (diffable, re-ingestable, survives a DuckDB version bump) and DuckDB +
Parquet are the materialisation you query.

Directories are the unit. A file-level index of this system would be tens of
millions of rows to answer questions that are all really about directories;
per-directory aggregates plus a sample answers them at a thousandth the size.
"""

INVENTORY_SCHEMA = "sinnix-fs-inventory-v1"

# Pruned: opaque by construction (a borg repo is deduplicated chunks, a .git
# object store is content-addressed blobs), or someone else's index already
# describes them better than a walk could. Recorded as a single node with
# prune_reason set, never silently skipped -- an absent directory and a
# deliberately-unwalked one must not look the same.
INVENTORY_PRUNE_NAMES = {
    # btrfs snapshot root. Snapshots reflink the same extents, so walking it
    # counts the system once per snapshot: measured 29.3 TB across 1.18M
    # directories on a filesystem holding 2.8 TB, which is 69% of every
    # directory on the machine and none of it distinct content.
    ".btrfs",
    ".git",
    "node_modules",
    ".direnv",
    "__pycache__",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    "target",  # rust build output; size recorded, contents meaningless
    ".cargo",
    "venv",
    ".venv",
}

INVENTORY_SAMPLE_NAMES = 12
INVENTORY_TOP_EXTENSIONS = 15


def is_borg_repo(entries: list[os.DirEntry]) -> bool:
    names = {e.name for e in entries}
    return "config" in names and "data" in names and any(n.startswith("index.") for n in names)


def owner_of(st: os.stat_result) -> tuple[str, str]:
    try:
        user = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        user = str(st.st_uid)
    try:
        group = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        group = str(st.st_gid)
    return user, group


def inventory_scan(roots: list[str], max_depth: int, out_path: Path, progress_every: int) -> int:
    """Breadth-first walk, one JSONL record per directory.

    BFS rather than DFS so a truncated run still describes the shallow
    structure completely -- the part a reader needs first -- instead of one
    deep spur and nothing else.
    """
    out_path.parent.mkdir(parents=True, exist_ok=True)
    written = 0
    started = time.monotonic()

    with atomic_text_writer(out_path, fsync=True, mode=0o600) as out:
        queue = deque((r, 0) for r in roots)
        while queue:
            path, depth = queue.popleft()
            # error rows MUST carry "parent" like ordinary rows do -- without
            # it, the rollup's recursive join (n.parent = d.path) never links
            # an error row to its ancestors, has_error never propagates, and
            # subtree_complete reads true for a subtree that was never fully
            # seen. Found by testing against a real permission wall
            # (/realm/library/models/ollama/blobs -- then /realm/media/model -- root:root 0700): the flag came
            # back true until this was added.
            parent = os.path.dirname(path) if depth else None
            try:
                st = os.lstat(path)
            except OSError as exc:
                out.write(json.dumps({"schema": INVENTORY_SCHEMA, "path": path, "parent": parent,
                                      "depth": depth, "error": str(exc)}) + "\n")
                written += 1
                continue

            if not stat.S_ISDIR(st.st_mode):
                out.write(json.dumps(safe({"schema": INVENTORY_SCHEMA, "path": path,
                    "parent": parent, "depth": depth,
                    "error": "not a directory (root symlinks are not followed)"})) + "\n")
                written += 1
                continue
            try:
                with os.scandir(path) as it:
                    entries = list(it)
            except PermissionError:
                out.write(json.dumps({"schema": INVENTORY_SCHEMA, "path": path, "parent": parent,
                                      "depth": depth, "error": "permission denied"}) + "\n")
                written += 1
                continue
            except OSError as exc:
                out.write(json.dumps({"schema": INVENTORY_SCHEMA, "path": path, "parent": parent,
                                      "depth": depth, "error": str(exc)}) + "\n")
                written += 1
                continue

            files: list[os.DirEntry] = []
            dirs: list[os.DirEntry] = []
            links = 0
            for e in entries:
                try:
                    if e.is_symlink():
                        links += 1
                    elif e.is_dir(follow_symlinks=False):
                        dirs.append(e)
                    else:
                        files.append(e)
                except OSError:
                    continue

            direct_bytes = 0
            mtimes: list[float] = []
            ext_counter: Counter[str] = Counter()
            biggest: list[tuple[int, str]] = []
            for e in files:
                try:
                    est = e.stat(follow_symlinks=False)
                except OSError:
                    continue
                direct_bytes += est.st_size
                mtimes.append(est.st_mtime)
                ext = Path(e.name).suffix.lower() or "(none)"
                ext_counter[ext] += 1
                biggest.append((est.st_size, e.name))
            biggest.sort(reverse=True)

            user, group = owner_of(st)
            prune_reason = None
            if is_borg_repo(files + dirs):
                prune_reason = "borg repository (deduplicated chunks)"
            elif os.path.basename(path) in INVENTORY_PRUNE_NAMES and depth > 0:
                prune_reason = f"pruned by name: {os.path.basename(path)}"
            elif max_depth >= 0 and depth >= max_depth:
                prune_reason = f"max depth {max_depth}"

            record = {
                "schema": INVENTORY_SCHEMA,
                "path": path,
                "parent": os.path.dirname(path) if depth else None,
                "name": os.path.basename(path) or path,
                "depth": depth,
                "direct_files": len(files),
                "direct_dirs": len(dirs),
                "direct_symlinks": links,
                "direct_bytes": direct_bytes,
                "mtime_min": min(mtimes) if mtimes else None,
                "mtime_max": max(mtimes) if mtimes else None,
                "dir_mtime": st.st_mtime,
                "mode": stat.filemode(st.st_mode),
                "owner": user,
                "group": group,
                "extensions": dict(ext_counter.most_common(INVENTORY_TOP_EXTENSIONS)),
                "sample_names": [e.name for e in files[:INVENTORY_SAMPLE_NAMES]],
                "biggest_files": [{"bytes": b, "name": n} for b, n in biggest[:5]],
                "child_dirs": [e.name for e in dirs[:40]],
                "prune_reason": prune_reason,
            }
            out.write(json.dumps(safe(record), ensure_ascii=False) + "\n")
            written += 1

            if progress_every and written % progress_every == 0:
                print(f"  {written} dirs, {time.monotonic()-started:.0f}s, at depth {depth}",
                      file=sys.stderr)

            if prune_reason is None:
                for e in dirs:
                    queue.append((os.path.join(path, e.name), depth + 1))

    print(f"sinnix-fs inventory: {written} directories in {time.monotonic()-started:.0f}s "
          f"-> {out_path}")
    return written


def inventory_materialize(jsonl: Path, db: Path, parquet: Path) -> None:
    """JSONL -> DuckDB + Parquet, with the rolled-up subtree sizes.

    direct_bytes is what a directory holds itself; total_bytes is it plus
    everything under it. The rollup is done here rather than during the walk
    because it needs the whole tree, and doing it in SQL keeps the walk a
    single pass that can be interrupted.
    """
    sql = f"""
INSTALL json; LOAD json;
DROP TABLE IF EXISTS nodes;
CREATE TABLE nodes AS SELECT * FROM read_json_auto('{jsonl}', ignore_errors=true);

-- Recursive rollup: every node accumulates its own bytes plus its descendants'.
--
-- total_bytes used to be silently a FLOOR wherever a permission-denied leaf
-- sat in the subtree: the leaf's own direct_bytes is 0 (its contents were
-- never seen), that 0 gets summed like any other, and nothing on the parent
-- row said the number was incomplete. Measured live: the model store (now /realm/library/models, then /realm/media/model)
-- reported 35G that way while the true size (readable only as root) is 120G
-- -- a 3.4x undercount with no marker distinguishing it from a directory that
-- actually is 35G. subtree_complete/incomplete_reason close that gap: any
-- error anywhere in the subtree flips the root's subtree_complete to false and
-- names one reason, so total_bytes can be read as "at least this much" instead
-- of mistaken for a total.
DROP TABLE IF EXISTS rollup;
CREATE TABLE rollup AS
WITH RECURSIVE descend(root, path, direct_bytes, has_error, error_path) AS (
    SELECT path AS root, path, COALESCE(direct_bytes, 0),
           error IS NOT NULL, CASE WHEN error IS NOT NULL THEN path END
    FROM nodes
    UNION ALL
    SELECT d.root, n.path, COALESCE(n.direct_bytes, 0),
           n.error IS NOT NULL, CASE WHEN n.error IS NOT NULL THEN n.path END
    FROM descend d JOIN nodes n ON n.parent = d.path
)
SELECT root AS path,
       SUM(direct_bytes) AS total_bytes,
       COUNT(*) AS subtree_dirs,
       NOT bool_or(has_error) AS subtree_complete,
       CASE WHEN bool_or(has_error)
            THEN 'unreadable: ' || any_value(error_path) FILTER (WHERE has_error)
       END AS incomplete_reason
FROM descend GROUP BY root;

DROP VIEW IF EXISTS inventory;
CREATE VIEW inventory AS
SELECT n.*, r.total_bytes, r.subtree_dirs, r.subtree_complete, r.incomplete_reason
FROM nodes n LEFT JOIN rollup r USING (path);

COPY (SELECT * FROM inventory) TO '{parquet}' (FORMAT PARQUET);
"""
    rows = materialize_pair(db, parquet, lambda staged_parquet: sql.replace(str(parquet), str(staged_parquet)), "inventory")
    print(f"sinnix-fs inventory: materialized {rows} rows -> {db}, {parquet}")


def cmd_inventory(args: argparse.Namespace) -> int:
    roots = args.root or DEFAULT_ROOTS
    out_dir = Path(args.out_dir)
    jsonl = out_dir / "nodes.jsonl"

    inventory_scan(roots, args.max_depth, jsonl, args.progress_every)
    if not args.scan_only:
        inventory_materialize(jsonl, out_dir / "inventory.duckdb", out_dir / "nodes.parquet")
    return 0


# =====================================================================
# content
# =====================================================================

CONTENT_DOC = """File-level index of the things a person wrote or collected.

The directory inventory answers "how big is this and who owns it". It cannot
answer the question that actually matters for reorganising a system: *which
files belong together but are not stored together*. That is a content
question, and it needs content.

Scope is deliberately narrow. There are tens of millions of files on this
machine and almost all of them are uninteresting in bulk -- capture stream
records, media blobs, build output, package trees. What is interesting is the
~60k documents: markdown notes, text dumps, PDFs, spreadsheets, the debris of
years of half-finished organisation. Those are the ones that turn up in six
places at once, and there are few enough to index individually.

Three things per file make the strewn-ness visible:

  sha256    full-file digest for bounded small files; never a sampled hash.
  sample_sha256  large-file head/tail/size fingerprint; candidate grouping
            only. Equal samples do NOT establish equal contents. Neither
            group authorizes deletion or ignores native provenance.
  title     for markdown/HTML, the first heading; for the rest, the filename.
            Lets near-duplicates and topic clusters surface by name.
  head      the first few hundred characters, so a later pass can classify
            what a thing IS without re-reading 60k files off disk.

Excluded on purpose, with the reason recorded rather than silently dropped:
anything inside a capture lane (those are streams, described by their lane),
media, build output, and VCS internals.
"""

CONTENT_SCHEMA = "sinnix-fs-content-v2"
CONTENT_FULL_HASH_LIMIT = 8 << 20
CONTENT_SAMPLE_BYTES = 1 << 20
CONTENT_COLUMNS = {
    "schema": "VARCHAR", "path": "VARCHAR", "dir": "VARCHAR", "name": "VARCHAR",
    "ext": "VARCHAR", "bytes": "BIGINT", "mtime": "DOUBLE", "sha256": "VARCHAR",
    "sample_sha256": "VARCHAR", "fingerprint_kind": "VARCHAR", "fingerprint_bytes": "BIGINT",
    "title": "VARCHAR", "head": "VARCHAR", "magic_type": "VARCHAR", "line_count": "BIGINT",
    "error": "VARCHAR", "kind": "VARCHAR", "symlink_target": "VARCHAR",
    "exclusion_reason": "VARCHAR",
}


def sql_string(value: object) -> str:
    return "'" + str(value).replace("'", "''") + "'"


def content_digest_views_sql(*, legacy: bool = False) -> str:
    """Rebuild only derived comparison views. V1 large hashes were samples.

    The source table remains an observation, not a destructive-cleanup plan.
    Legacy sample values are not eligible for exact-content grouping.
    """
    exact = ("schema = 'sinnix-fs-content-v1' AND bytes BETWEEN 0 AND 8388608"
             if legacy else "fingerprint_kind = 'sha256-full'")
    sampled = ("sha256" if legacy else "sample_sha256")
    sample_condition = ("schema = 'sinnix-fs-content-v1' AND bytes > 8388608"
                        if legacy else "fingerprint_kind = 'sha256-head-tail-size-v1'")
    return f"""
CREATE OR REPLACE VIEW duplicates AS
SELECT sha256, count(*) AS copies, sum(bytes) AS total_bytes,
       min(bytes) AS unit_bytes, list(path) AS paths, min(name) AS a_name
FROM files
WHERE error IS NULL AND {exact}
  AND regexp_full_match(sha256, '[0-9a-fA-F]{{64}}')
GROUP BY sha256, bytes HAVING count(*) > 1
ORDER BY (count(*)-1) * min(bytes) DESC;
CREATE OR REPLACE VIEW sampled_duplicate_candidates AS
SELECT {sampled} AS sample_sha256, count(*) AS candidates, min(bytes) AS unit_bytes,
       list(path) AS paths,
       'Sample equality only; full-byte verification and owner review required' AS limitation
FROM files WHERE error IS NULL AND {sample_condition}
  AND regexp_full_match({sampled}, '[0-9a-fA-F]{{64}}')
GROUP BY {sampled}, bytes HAVING count(*) > 1;
"""


def content_views_refresh(db: Path) -> int:
    """Repair comparison semantics without rescanning or changing file rows."""
    if not db.is_file():
        print(f"sinnix-fs content-views: database absent: {db}", file=sys.stderr)
        return 1
    probe = duckdb_query(db, "SELECT column_name FROM information_schema.columns WHERE table_name='files'")
    if probe.returncode:
        print(probe.stderr, file=sys.stderr)
        return 1
    columns = set(probe.stdout.splitlines())
    if not {"schema", "path", "bytes", "sha256", "error", "name"} <= columns:
        raise ValueError("content files table does not satisfy the observed v1/v2 contract")
    legacy = not {"fingerprint_kind", "sample_sha256"} <= columns
    proc = run_duckdb_file(db, "BEGIN TRANSACTION;\n" + content_digest_views_sql(legacy=legacy) + "COMMIT;", "content-views")
    if proc.returncode:
        print(proc.stderr, file=sys.stderr)
        return 1
    print(f"sinnix-fs content-views: corrected {'legacy v1' if legacy else 'typed'} comparison views; source rows and payloads unchanged")
    return 0


CONTENT_EXTS = {
    ".md", ".markdown", ".txt", ".org", ".rst", ".adoc",
    ".pdf", ".docx", ".odt", ".rtf", ".epub",
    ".csv", ".tsv", ".tex", ".bib",
    ".html", ".htm",
    ".json", ".yaml", ".yml", ".toml", ".ini", ".conf",
}

# Streams and blobs, not documents. A capture lane's contents are described by
# the lane; indexing each record would drown the signal in telemetry.
CONTENT_EXCLUDE_DIR_PARTS = {
    ".git", "node_modules", "target", ".venv", "venv", "__pycache__",
    ".direnv", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".cargo",
    "site-packages", ".cache", "share/doc",
}
CONTENT_EXCLUDE_PREFIXES = (
    # btrfs snapshot root. Every snapshot mirrors the whole system, so without
    # this the index is mostly copies of itself: measured 3.85M of 4.43M files
    # and 203 GB of 263 GB. It also produces phantom findings — a stray-file
    # search over the polluted index reported 821 hits where 8 were real.
    "/realm/.btrfs/",
    "/realm/activity/",
    "/realm/library/images/",
    "/realm/library/videos/",
    "/realm/library/games/",
    "/realm/library/models/",
    "/realm/library/datasets/",
    "/realm/state/cache/",
    "/realm/tmp/shell/",
    "/realm/worktrees/",
    "/nix/store/",
)

# Above this bound, omit the content excerpt without inferring the file
# is disposable or generated. Fingerprint scope is recorded separately.
CONTENT_MAX_READ_BYTES = 2 << 20
CONTENT_HEAD_CHARS = 400

CONTENT_H1 = re.compile(r"^\s{0,3}#\s+(.+?)\s*$", re.M)
CONTENT_TITLE_TAG = re.compile(r"<title[^>]*>(.*?)</title>", re.I | re.S)
CONTENT_YAML_TITLE = re.compile(r"^title:\s*(.+?)\s*$", re.M)


# This is a content-inspection boundary, never a deletion or backup exclusion.
# The directory inventory remains independent; native owners remain queryable.
# Scratch does not become durable just because a generic text scanner sees it.
CONTENT_COLLECTION_BOUNDARIES = {
    "/realm/tmp": "temporary execution workspace; promote retained artifacts before cataloging",
    "/realm/state/polylogue": "Polylogue owns archive contents and native querying",
    "/realm/archive/polylogue-old-home": "preserved native Polylogue recovery collection",
    "/realm/state/stashbox": "Stashbox owns media catalog and derived resources",
}


def content_excluded(path: str) -> str | None:
    normalized = path.rstrip("/") or "/"
    for boundary, reason in CONTENT_COLLECTION_BOUNDARIES.items():
        if normalized == boundary or normalized.startswith(boundary + "/"):
            return reason
    if any(normalized == prefix.rstrip("/") or normalized.startswith(prefix)
           for prefix in CONTENT_EXCLUDE_PREFIXES):
        return "bulk lane (stream, media, cache or build)"
    parts = set(Path(path).parts)
    hit = parts & CONTENT_EXCLUDE_DIR_PARTS
    if hit:
        return f"inside {sorted(hit)[0]}"
    return None


def content_magic_type(path: Path) -> str | None:
    """Real content type from `file -b --mime-type`, independent of extension.

    Extension-based classification is what this scanner otherwise relies on
    (CONTENT_EXTS), and extensions lie: a renamed archive, a misnamed export,
    a script saved as .txt. magic_type is the cheap cross-check -- one
    subprocess call, no new library dependency, and it is what would have
    caught this system's own mismatched-build-system class of bug earlier if
    it had existed on the file layer rather than only the config layer.
    """
    try:
        out = subprocess.run(["file", "-b", "--mime-type", str(path)],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def content_extract(path: Path, size: int, ext: str) -> tuple[str | None, str | None, int | None, str | None]:
    """(title, head, line_count, error) with a bounded, non-stream read.

    Returns the reason in the fourth slot instead of swallowing it. A file that
    could not be read used to be indistinguishable from a file with no title:
    both produced (None, None). That is the same shape as sinnix's other
    silent-success bugs -- the sibling scanner (sinnix-fs inventory) already
    gets this right by writing an explicit permission-denied row.
    """
    if size > CONTENT_MAX_READ_BYTES or ext in {".pdf", ".docx", ".odt", ".epub", ".rtf"}:
        return None, None, None, None
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(descriptor, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if not stat.S_ISREG(opened.st_mode):
                return None, None, None, "not a regular file"
            payload = handle.read(CONTENT_MAX_READ_BYTES + 1)
        if len(payload) > CONTENT_MAX_READ_BYTES:
            return None, None, None, "grew beyond extraction bound"
        raw = payload.decode("utf-8", errors="replace")
    except PermissionError:
        return None, None, None, "permission denied"
    except OSError as exc:
        return None, None, None, f"read failed: {exc.__class__.__name__}"
    title = None
    if ext in {".md", ".markdown"}:
        if raw.startswith("---"):
            end = raw.find("\n---", 3)
            if end > 0:
                m = CONTENT_YAML_TITLE.search(raw[:end])
                if m:
                    title = m.group(1)
        if not title:
            m = CONTENT_H1.search(raw)
            title = m.group(1) if m else None
    elif ext in {".html", ".htm"}:
        m = CONTENT_TITLE_TAG.search(raw)
        title = " ".join(m.group(1).split()) if m else None
    # The real line count of what was actually read, computed BEFORE head
    # collapses whitespace into one line -- head.count("\n") is always 0
    # after that collapse, which would make line_count silently always 1.
    # wc -l convention: count newlines, plus one more only for a trailing
    # partial line with no terminator. Most text files end in \n, so the
    # naive raw.count("\n") + 1 over-counts by one for the common case --
    # caught by testing against a file with a real trailing newline rather
    # than trusting the arithmetic.
    line_count = raw.count("\n") + (1 if raw and not raw.endswith("\n") else 0)
    head = " ".join(raw[:CONTENT_HEAD_CHARS * 3].split())[:CONTENT_HEAD_CHARS] or None
    return title, head, line_count, None


def content_fingerprint(path: Path, size: int, expected: os.stat_result | None = None) -> dict:
    """Read a bounded fingerprint of one stable regular file, never a stream.

    O_NONBLOCK prevents a substituted FIFO from hanging the scan; O_NOFOLLOW
    and lstat/fstat checks keep symlink aliases out of duplicate candidates.
    Metadata stability detects ordinary concurrent writes, not adversarial
    manipulation or the validity of a historical content claim.
    """
    empty = {"sha256": None, "sample_sha256": None,
             "fingerprint_kind": None, "fingerprint_bytes": 0}
    def token(st):
        return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
    try:
        before = path.lstat()
        if not stat.S_ISREG(before.st_mode):
            return {**empty, "error": "not a regular file"}
        if before.st_size != size or (expected is not None and token(before) != token(expected)):
            return {**empty, "error": "changed before fingerprint"}
        flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(path, flags)
        with os.fdopen(fd, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if not stat.S_ISREG(opened.st_mode) or token(before) != token(opened):
                return {**empty, "error": "replaced before fingerprint"}
            h = hashlib.sha256()
            if size <= CONTENT_FULL_HASH_LIMIT:
                payload = handle.read(size + 1)
                h.update(payload)
                read_bytes = len(payload)
                kind, field = "sha256-full", "sha256"
                if read_bytes != size:
                    return {**empty, "error": "changed while fingerprinting"}
            else:
                head = handle.read(CONTENT_SAMPLE_BYTES)
                handle.seek(-CONTENT_SAMPLE_BYTES, os.SEEK_END)
                tail = handle.read(CONTENT_SAMPLE_BYTES)
                if len(head) != CONTENT_SAMPLE_BYTES or len(tail) != CONTENT_SAMPLE_BYTES:
                    return {**empty, "error": "short sampled read"}
                h.update(head); h.update(tail); h.update(str(size).encode())
                read_bytes = len(head) + len(tail)
                kind, field = "sha256-head-tail-size-v1", "sample_sha256"
            after = os.fstat(handle.fileno())
        if token(before) != token(after) or token(before) != token(path.lstat()):
            return {**empty, "error": "changed while fingerprinting"}
        return {**empty, field: h.hexdigest(), "fingerprint_kind": kind,
                "fingerprint_bytes": read_bytes, "error": None}
    except PermissionError:
        return {**empty, "error": "permission denied"}
    except OSError as exc:
        return {**empty, "error": f"fingerprint failed: {exc.__class__.__name__}"}


def content_walk(roots: list[str], out_path: Path, progress_every: int) -> int:
    out_path.parent.mkdir(parents=True, exist_ok=True)
    written = 0
    errored = 0
    skipped = 0
    started = time.monotonic()
    with atomic_text_writer(out_path, fsync=True, mode=0o600) as out:
        def boundary_error(path, reason):
            nonlocal written, errored
            out.write(json.dumps(safe({"schema": CONTENT_SCHEMA, "path": str(path),
                "dir": str(Path(path).parent), "name": Path(path).name,
                "kind": "directory", "error": reason, "sha256": None,
                "sample_sha256": None}), ensure_ascii=False) + "\n")
            written += 1
            errored += 1
        boundary_paths: set[str] = set()
        def boundary_record(path, reason):
            nonlocal written, skipped
            path = str(Path(path))
            if path in boundary_paths:
                return
            boundary_paths.add(path)
            out.write(json.dumps(safe({"schema": CONTENT_SCHEMA, "path": path,
                "dir": str(Path(path).parent), "name": Path(path).name,
                "kind": "collection_boundary", "exclusion_reason": reason,
                "error": None, "sha256": None, "sample_sha256": None,
                "head": None, "title": None}), ensure_ascii=False) + "\n")
            written += 1
            skipped += 1
        for root in roots:
            try:
                root_stat = Path(root).lstat()
                if not stat.S_ISDIR(root_stat.st_mode):
                    boundary_error(root, "not a directory (root aliases are not followed)")
                    continue
            except OSError as exc:
                boundary_error(root, f"root unavailable: {exc.__class__.__name__}")
                continue
            excluded = content_excluded(root)
            if excluded:
                boundary_record(root, excluded)
                continue
            def walk_error(exc):
                boundary_error(exc.filename or root, f"directory unreadable: {exc.__class__.__name__}")
            for dirpath, dirnames, filenames in os.walk(root, topdown=True, onerror=walk_error):
                excluded = content_excluded(dirpath)
                if excluded:
                    boundary_record(dirpath, excluded)
                    dirnames[:] = []
                    continue
                descend = []
                for child in dirnames:
                    child_path = os.path.join(dirpath, child)
                    excluded = content_excluded(child_path)
                    if excluded:
                        boundary_record(child_path, excluded)
                    else:
                        descend.append(child)
                dirnames[:] = descend
                for fn in filenames:
                    ext = Path(fn).suffix.lower()
                    if ext not in CONTENT_EXTS:
                        continue
                    p = Path(dirpath) / fn
                    try:
                        st = p.lstat()
                    except PermissionError:
                        # An unreadable file used to `continue` -- it vanished
                        # from the index entirely, indistinguishable from a file
                        # that does not exist. Emit a row saying so instead; a
                        # visible hole is information, a missing row is not.
                        out.write(json.dumps(safe({
                            "schema": CONTENT_SCHEMA, "path": str(p), "dir": dirpath,
                            "name": fn, "ext": ext, "error": "permission denied",
                        }), ensure_ascii=False) + "\n")
                        errored += 1
                        written += 1
                        continue
                    except OSError as exc:
                        out.write(json.dumps(safe({
                            "schema": CONTENT_SCHEMA, "path": str(p), "dir": dirpath,
                            "name": fn, "ext": ext,
                            "error": f"stat failed: {exc.__class__.__name__}",
                        }), ensure_ascii=False) + "\n")
                        errored += 1
                        written += 1
                        continue
                    if not stat.S_ISREG(st.st_mode):
                        is_link = stat.S_ISLNK(st.st_mode)
                        out.write(json.dumps(safe({
                            "schema": CONTENT_SCHEMA, "path": str(p), "dir": dirpath,
                            "name": fn, "ext": ext, "bytes": st.st_size,
                            "kind": "symlink" if is_link else "special",
                            "error": "alias not traversed" if is_link else "not a regular file",
                            "sha256": None, "sample_sha256": None,
                        }), ensure_ascii=False) + "\n")
                        written += 1
                        skipped += 1
                        continue
                    title, head, line_count, read_error = content_extract(p, st.st_size, ext)
                    fingerprint = content_fingerprint(p, st.st_size, expected=st)
                    read_error = read_error or fingerprint["error"]
                    if read_error:
                        errored += 1
                    # line_count is NULL for anything extract() skipped (too
                    # large, or a binary-shaped extension like .pdf) -- it is
                    # not computed from a second read, and is a real count of
                    # what was read, not a lower bound guessed from the
                    # excerpt.
                    out.write(json.dumps(safe({
                        "schema": CONTENT_SCHEMA,
                        "path": str(p),
                        "dir": dirpath,
                        "name": fn,
                        "ext": ext,
                        "bytes": st.st_size,
                        "mtime": st.st_mtime,
                        **fingerprint,
                        "kind": "file",
                        "title": title,
                        "head": head,
                        "magic_type": content_magic_type(p),
                        "line_count": line_count,
                        "error": read_error,
                    }), ensure_ascii=False) + "\n")
                    written += 1
                    if progress_every and written % progress_every == 0:
                        print(f"  {written} files, {time.monotonic()-started:.0f}s",
                              file=sys.stderr)
    # errored is reported separately from skipped: `skipped` is deliberate
    # prune-exclusion, `errored` is the scanner failing to see something it was
    # asked to see. Conflating them is how an unreadable subtree reads as an
    # intentionally-excluded one.
    print(f"sinnix-fs content: {written} observations ({skipped} boundaries/nonregular entries, "
          f"{errored} unreadable) in {time.monotonic()-started:.0f}s -> {out_path}")
    return written


def content_materialize(jsonl: Path, db: Path, parquet: Path) -> None:
    columns = "{" + ", ".join(sql_string(k) + ": " + sql_string(v) for k, v in CONTENT_COLUMNS.items()) + "}"
    exact = "regexp_full_match(sha256, '[0-9a-fA-F]{64}') AND error IS NULL AND bytes >= 0 AND ((schema = 'sinnix-fs-content-v2' AND fingerprint_kind = 'sha256-full') OR (schema = 'sinnix-fs-content-v1' AND bytes <= 8388608))"
    sample = "error IS NULL AND bytes > 8388608 AND ((schema = 'sinnix-fs-content-v2' AND fingerprint_kind = 'sha256-head-tail-size-v1' AND regexp_full_match(sample_sha256, '[0-9a-fA-F]{64}')) OR (schema = 'sinnix-fs-content-v1' AND regexp_full_match(sha256, '[0-9a-fA-F]{64}')))"
    sql = f"""
DROP TABLE IF EXISTS files;
CREATE TABLE files AS
SELECT * EXCLUDE (sha256, sample_sha256, fingerprint_kind),
  CASE WHEN {exact} THEN lower(sha256) ELSE NULL END AS sha256,
  CASE WHEN {sample} THEN lower(CASE WHEN schema = 'sinnix-fs-content-v1' THEN sha256 ELSE sample_sha256 END) ELSE NULL END AS sample_sha256,
  CASE WHEN {exact} THEN 'sha256-full' WHEN {sample} THEN 'sha256-head-tail-size-v1' ELSE NULL END AS fingerprint_kind,
  -- Prose a person reads. This is the corpus that enters text embedding and
  -- per-file classification.
  ext IN ('.md','.markdown','.txt','.html','.htm','.pdf','.epub','.rst') AS document_like,
  -- Tabular: classifiable, but not prose. Clusters and embeds differently, so
  -- it stays out of the text corpus by default rather than diluting it.
  ext IN ('.csv','.tsv') AS data_like
FROM read_json({sql_string(jsonl)}, format='newline_delimited', columns={columns}, ignore_errors=false);

-- Full hashes and large-file samples have deliberately separate views.
{content_digest_views_sql()}

-- Same name in many directories: near-duplicates the hash cannot catch,
-- because someone edited one copy.
DROP VIEW IF EXISTS scattered_names;
CREATE VIEW scattered_names AS
SELECT name, count(*) AS copies, count(DISTINCT dir) AS dirs, list(DISTINCT dir) AS where_
FROM files GROUP BY name HAVING count(DISTINCT dir) > 2
ORDER BY count(DISTINCT dir) DESC;

-- The population split, so a coverage query never has to restate the
-- predicate. Structured-data rows (export payloads, archive internals) are
-- neither document_like nor data_like and are characterised at container
-- level, never queued per file.
DROP VIEW IF EXISTS population;
CREATE VIEW population AS
SELECT CASE WHEN document_like THEN 'document'
            WHEN data_like     THEN 'tabular'
            ELSE 'structured-data' END AS population,
       count(*) AS files, sum(bytes) AS bytes
FROM files GROUP BY 1;

COPY (SELECT * FROM files) TO {sql_string(parquet)} (FORMAT PARQUET);
"""
    rows = materialize_pair(db, parquet, lambda staged_parquet: sql.replace(sql_string(parquet), sql_string(staged_parquet)), "files")
    print(f"sinnix-fs content: materialized {rows} rows -> {db}, {parquet}")


def cmd_content(args: argparse.Namespace) -> int:
    roots = args.root or DEFAULT_ROOTS
    out_dir = Path(args.out_dir)
    jsonl = out_dir / "files.jsonl"
    content_walk(roots, jsonl, args.progress_every)
    content_materialize(jsonl, out_dir / "content.duckdb", out_dir / "files.parquet")
    return 0


# =====================================================================
# ledger
# =====================================================================

LEDGER_DOC = """Turn judgments.jsonl from a file agents write into a file agents can query.

`sinnix-fs inventory` and `sinnix-fs content` produce the mechanical scan
(nodes/files: what is on disk). Alongside them, an append-only ledger of
per-path judgments (subject, owner, provenance, lifecycle...) has existed
since the system charter pass on 2026-08-16 -- but nothing had ever loaded it
into either DuckDB file, so "what fraction of the system is classified" was a
question with no way to answer it. This closes that gap in SQL, not new
scanning code: everything here reads data that was already on disk.

Three views, corresponding to the charter's design (system-charter-2026-08-16
Section 4):

  resolved_judgments   latest-wins per (target, field), except that a
                        method='operator' row is only ever superseded by
                        another operator row -- an agent's rule-based guess
                        never overrides a human decision, no matter which
                        came later.

  inherited_judgments  every path in nodes/files joined to whichever
                        judgment target -- a literal sha256: row, or the
                        LONGEST matching prefix: row -- actually governs it.
                        This is what lets ~200 prefix judgments classify
                        millions of files without reading them.

  coverage             the four disjoint states the charter names, per
                        field: classified (has a judgment) / unclassifiable
                        (resolved to observation='unknown') / exempt
                        (not_applicable or withheld) / not_yet_examined (no
                        row reaches this path at all). Only the last one is
                        the work queue -- the other three are all "examined",
                        whatever the answer turned out to be.
"""

LEDGER_SQL = r"""
-- JSON readers are supplied by the declared DuckDB runtime. No extension
-- installation or home-directory cache is part of ledger materialization.

DROP TABLE IF EXISTS judgments;
CREATE TABLE judgments AS
SELECT * FROM read_json_auto('{judgments_jsonl}', ignore_errors=true);

-- Latest-wins per (target, field), with the operator-override exception: a
-- method='operator' row can only be superseded by another operator row. Rank
-- operator rows above rule/model rows regardless of timestamp, then by ts
-- within each tier.
DROP VIEW IF EXISTS resolved_judgments;
CREATE VIEW resolved_judgments AS
SELECT * EXCLUDE (rk) FROM (
    SELECT *,
           row_number() OVER (
               PARTITION BY target, field
               ORDER BY (method = 'operator') DESC, ts DESC
           ) AS rk
    FROM judgments
) WHERE rk = 1;

-- Prefix inheritance. A path's judgment is its own sha256: row if one
-- exists, else the LONGEST prefix: row whose prefix it starts with. DuckDB
-- has no native trie join, so this is a correlated subquery keyed on
-- string length -- fine at this row count (hundreds of judgments, not
-- millions), and the alternative (materializing every prefix x path pair)
-- would be the thing actually too slow to run.
DROP VIEW IF EXISTS prefix_judgments;
CREATE VIEW prefix_judgments AS
SELECT target, field, value, confidence, observation, method, evidence, ts,
       substr(target, 8) AS prefix
FROM resolved_judgments
WHERE target LIKE 'prefix:%';

-- all_paths / inherited_judgments / coverage are TABLES, not views: they
-- read from `files`, which lives behind a cross-database ATTACH that does
-- not persist once this duckdb session exits. A view here would work for
-- the rest of this script and then silently break -- "table ctn.files does
-- not exist" -- for every later, ordinary `duckdb inventory.duckdb -c ...`
-- query. Materializing means re-running `sinnix-fs ledger` is how you
-- refresh them, same contract as the rollup in `sinnix-fs inventory`.
DROP TABLE IF EXISTS all_paths;
CREATE TABLE all_paths AS
SELECT path, sha256 FROM (
    SELECT path, NULL AS sha256 FROM nodes
    UNION ALL
    SELECT path, sha256 FROM files
);

-- Only paths that DO match something appear here (an inner join, not a
-- left join): the "no row at all" case is what QUALIFYing against the full
-- path population in `coverage` below is for, and this view stays a clean
-- "here is what governs each classified path" rather than a padded table.
-- sha256 exact matches always outrank the longest prefix match for the
-- same (path, field) -- a specific judgment about one file wins over a
-- general one about its directory.
DROP TABLE IF EXISTS inherited_judgments;
CREATE TABLE inherited_judgments AS
SELECT path, sha256, field, value, confidence, observation, method, evidence, via_prefix
FROM (
    SELECT p.path, p.sha256, pj.field, pj.value, pj.confidence, pj.observation,
           pj.method, pj.evidence, pj.prefix AS via_prefix, 1 AS specificity,
           length(pj.prefix) AS match_len
    FROM all_paths p
    JOIN prefix_judgments pj ON
        p.path = rtrim(pj.prefix, '/')
        OR starts_with(p.path, rtrim(pj.prefix, '/') || '/')

    UNION ALL

    SELECT p.path, p.sha256, rj.field, rj.value, rj.confidence, rj.observation,
           rj.method, rj.evidence, NULL AS via_prefix, 0 AS specificity, 0 AS match_len
    FROM all_paths p
    JOIN resolved_judgments rj ON rj.target = 'sha256:' || p.sha256
    WHERE p.sha256 IS NOT NULL
)
QUALIFY row_number() OVER (
    PARTITION BY path, field ORDER BY specificity ASC, match_len DESC
) = 1;

-- Coverage: four disjoint states per (path, field). Built against the
-- 'subject' field, the one the system charter's routing decisions actually
-- key on; other fields (owner, provenance, lifecycle...) can be queried the
-- same way by re-running this view with a different field filter -- kept as
-- one field here rather than a cross-product over all fields, because that
-- cross-product is exactly the kind of premature generality the operating
-- contract warns against and nothing downstream needs it yet.
DROP TABLE IF EXISTS coverage;
CREATE TABLE coverage AS
WITH subject_state AS (
    SELECT p.path,
           CASE
             WHEN ij.field IS NULL THEN 'not_yet_examined'
             WHEN ij.observation = 'not_applicable' OR ij.observation = 'withheld' THEN 'exempt'
             WHEN ij.observation = 'unknown' THEN 'unclassifiable'
             ELSE 'classified'
           END AS state
    FROM all_paths p
    LEFT JOIN inherited_judgments ij ON ij.path = p.path AND ij.field = 'subject'
)
SELECT state, count(*) AS paths,
       round(100.0 * count(*) / sum(count(*)) OVER (), 1) AS pct
FROM subject_state GROUP BY state ORDER BY paths DESC;
"""

LEDGER_OBJECT_KIND = {
    "resolved_judgments": "VIEW", "prefix_judgments": "VIEW",
    "all_paths": "TABLE", "inherited_judgments": "TABLE", "coverage": "TABLE",
}


def ledger_run(index_dir: Path) -> int:
    judgments = index_dir / "judgments.jsonl"
    inv_db = index_dir / "inventory.duckdb"
    content_db = index_dir / "content.duckdb"
    for p in (judgments, inv_db, content_db):
        if not p.exists():
            print(f"sinnix-fs ledger: missing {p} -- run sinnix-fs inventory and "
                  f"sinnix-fs content first", file=sys.stderr)
            return 1

    sql = LEDGER_SQL.format(judgments_jsonl=str(judgments))
    # A prior run may have left an object with the same name as a different
    # kind (view vs table) -- DROP ... IF EXISTS does not suppress a type
    # mismatch, only a missing name, so a plain drop-then-create can fail
    # against the catalog's actual current state. Query it and drop each
    # target object precisely as whatever it currently is, before running the
    # real script.
    catalog_probe = (
        "SELECT table_name, 'TABLE' FROM duckdb_tables() "
        "UNION ALL SELECT view_name, 'VIEW' FROM duckdb_views();"
    )
    probe = subprocess.run(["duckdb", str(inv_db), "-csv", "-c", catalog_probe],
                            text=True, capture_output=True)
    existing = {}
    if probe.returncode == 0:
        for line in probe.stdout.splitlines()[1:]:
            if "," not in line:
                continue
            n, kind = line.rsplit(",", 1)
            existing[n.strip('"')] = kind
    precise_drops = "\n".join(
        f"DROP {existing[name]} IF EXISTS {name};"
        for name in LEDGER_OBJECT_KIND
        if name in existing and existing[name] != LEDGER_OBJECT_KIND[name]
    )

    columns_probe = duckdb_query(content_db, "SELECT column_name FROM information_schema.columns WHERE table_name='files'")
    if columns_probe.returncode:
        print(columns_probe.stderr, file=sys.stderr)
        return 1
    typed = 'fingerprint_kind' in columns_probe.stdout.splitlines()
    exact_clause = ("fingerprint_kind = 'sha256-full'" if typed else
                    "schema = 'sinnix-fs-content-v1' AND bytes BETWEEN 0 AND 8388608")

    # inventory.duckdb is opened directly (it already has nodes/rollup); only
    # content.duckdb needs ATTACHing, as a view rather than a copy, so a
    # re-run of either scanner remains the only place that table is written.
    full_sql = f"""
{precise_drops}
ATTACH '{content_db}' AS ctn (READ_ONLY);
CREATE OR REPLACE VIEW files AS
SELECT path, CASE WHEN error IS NULL AND {exact_clause}
  AND regexp_full_match(sha256, '[0-9a-fA-F]{{64}}')
  THEN sha256 ELSE NULL END AS sha256 FROM ctn.files;
{sql}
.print
SELECT * FROM coverage;
"""
    proc = run_duckdb_file(inv_db, full_sql, ".ledger.sql")
    if proc.returncode != 0:
        print(f"sinnix-fs ledger: duckdb failed: {proc.stderr}", file=sys.stderr)
        return 1
    print(proc.stdout)
    print(f"sinnix-fs ledger: materialized resolved_judgments, prefix_judgments, "
          f"inherited_judgments, coverage in {inv_db}", file=sys.stderr)
    return 0


def cmd_ledger(args: argparse.Namespace) -> int:
    return ledger_run(args.index_dir)


# =====================================================================
# run — the fs-index service's entry point
# =====================================================================

def cmd_run(args: argparse.Namespace) -> int:
    """inventory, then content, then ledger, sharing one out-dir.

    This is what `sinnix-fs-index.service` invokes: the ledger step reads
    the scan's own DuckDB output, so the three stages always run in this
    order against the same directory.
    """
    roots = args.root or DEFAULT_ROOTS
    out_dir = Path(args.out_dir)

    nodes_jsonl = out_dir / "nodes.jsonl"
    inventory_scan(roots, -1, nodes_jsonl, 2000)
    inventory_materialize(nodes_jsonl, out_dir / "inventory.duckdb", out_dir / "nodes.parquet")

    files_jsonl = out_dir / "files.jsonl"
    content_walk(roots, files_jsonl, 5000)
    content_materialize(files_jsonl, out_dir / "content.duckdb", out_dir / "files.parquet")

    return ledger_run(out_dir)



# Read authored definitions directly. These operations neither inspect payloads
# nor require a multi-million-row inventory/materialization to be current.
JUDGMENT_FACETS = ("topic", "role", "maintenance_owner", "preservation")
JUDGMENT_LIMIT_BYTES = 8 << 20


def judgment_target(target: str) -> tuple[str, str]:
    if target.startswith("sha256:"):
        digest = target[7:]
        if not re.fullmatch(r"[0-9a-fA-F]{64}", digest):
            raise ValueError("sha256 target is not a 64-digit full digest")
        return "sha256", digest.lower()
    if not target.startswith("prefix:"):
        raise ValueError("target must be prefix:/absolute/path or sha256:<full digest>")
    path = target[7:]
    if not path.startswith("/") or any(ord(c) < 32 for c in path):
        raise ValueError("prefix target requires an absolute path without control characters")
    if path.startswith("//") or os.path.normpath(path) != path.rstrip("/") and path != "/":
        raise ValueError("prefix target must be normalized; dot segments are not interpreted")
    return "prefix", path.rstrip("/") or "/"


def read_judgments(path: Path) -> dict:
    with path.open("rb") as handle:
        raw = handle.read(JUDGMENT_LIMIT_BYTES + 1)
    if len(raw) > JUDGMENT_LIMIT_BYTES:
        raise ValueError("judgment ledger exceeds the 8 MiB read bound")
    valid, issues, total = [], [], 0
    for number, line in enumerate(raw.decode("utf-8").splitlines(), 1):
        if not line.strip():
            continue
        total += 1
        if total > 25000:
            raise ValueError("judgment ledger exceeds the 25,000-record bound")
        try:
            record = json.loads(line, parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))
        except ValueError as exc:
            raise ValueError(f"Malformed JSON at ledger line {number}; no partial result") from exc
        try:
            if not isinstance(record, dict):
                raise ValueError("record is not an object")
            for key in ("target", "field", "method", "ts", "evidence"):
                if not isinstance(record.get(key), str) or not record[key].strip():
                    raise ValueError(f"missing or non-text {key}")
            if "value" not in record:
                raise ValueError("record has no value")
            kind, address = judgment_target(record["target"])
            timestamp = dt.datetime.fromisoformat(record["ts"].replace("Z", "+00:00"))
            if timestamp.tzinfo is None:
                raise ValueError("timestamp must state a timezone")
            canonical = json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            valid.append({"record": record, "line": number,
                          "record_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
                          "kind": kind, "address": address, "timestamp": timestamp.timestamp()})
        except (ValueError, TypeError) as exc:
            issues.append({"line": number, "reason": str(exc)})
    return {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest(),
            "records": total, "valid": valid, "issues": issues}


def resolve_judgments(ledger: dict, path: str) -> dict:
    """Per target: operator tier, then decision time. Per field: specificity.

    Equal-priority conflicting decisions remain ambiguous, rather than using
    iteration order as a hidden policy. Unknown/withheld child rules mask an
    inherited value. Path lookup does not guess or calculate a content digest.
    """
    _, path = judgment_target("prefix:" + path)
    grouped = {}
    for entry in ledger["valid"]:
        prefix = entry["address"]
        if entry["kind"] != "prefix" or not (path == prefix or path.startswith(prefix.rstrip("/") + "/")):
            continue
        grouped.setdefault((prefix, entry["record"]["field"]), []).append(entry)
    candidates = {}
    for (prefix, field), entries in grouped.items():
        rank = lambda e: (e["record"]["method"] == "operator", e["timestamp"])
        best = max(map(rank, entries))
        selected = [e for e in entries if rank(e) == best]
        candidates.setdefault(field, []).append((prefix, selected))
    output = {}
    for field, options in sorted(candidates.items()):
        prefix, selected = max(options, key=lambda item: len(item[0]))
        signatures = {json.dumps([e["record"]["value"], e["record"].get("observation") or "known"], sort_keys=True) for e in selected}
        evidence = [{"line": e["line"], "record_sha256": e["record_sha256"],
                     "decision": e["record"]} for e in sorted(selected,key=lambda e:e["line"])]
        if len(signatures) > 1:
            output[field] = {"status": "ambiguous", "via": prefix, "evidence": evidence}
        else:
            record = selected[0]["record"]
            output[field] = {"status": record.get("observation") or "known",
                             "value": record["value"], "via": prefix, "evidence": evidence}
    return output


def cmd_judgments(args: argparse.Namespace) -> int:
    ledger = read_judgments(args.index_dir / "judgments.jsonl")
    provenance = {k: ledger[k] for k in ("path", "sha256", "records", "issues")}
    if args.action == "explain":
        fields = resolve_judgments(ledger, args.path)
        result = {"schema": "sinnix-fs-judgment-explanation-v1", "path": args.path,
                  "ledger": provenance,
                  "facets": {k:v for k,v in fields.items() if k in JUDGMENT_FACETS},
                  "other_fields": {k:v for k,v in fields.items() if k not in JUDGMENT_FACETS},
                  "scope": "Lexical path inheritance only; no path stat, symlink traversal, payload read, full digest or backup verification. Dates and methods describe the source decisions, not a new operator ruling."}
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 1 if any(x["status"] == "ambiguous" for x in fields.values()) else 0
    if args.action == "audit":
        targets = sorted({e["address"] for e in ledger["valid"] if e["kind"] == "prefix"})
        locations = []
        if args.check_paths:
            for path in targets:
                try:
                    info = os.lstat(path)
                    state = "symlink" if stat.S_ISLNK(info.st_mode) else "present"
                except FileNotFoundError:
                    state = "missing"
                except OSError:
                    state = "unavailable"
                locations.append({"path": path, "status": state})
        modern = {e["address"] for e in ledger["valid"] if e["kind"] == "prefix" and e["record"]["field"] in JUDGMENT_FACETS}
        result = {"schema": "sinnix-fs-judgment-audit-v1", "ledger": provenance,
                  "valid_records": len(ledger["valid"]), "prefix_targets":len(targets),
                  "facet_targets":len(modern), "location_counts":dict(Counter(r["status"] for r in locations)),
                  "locations":locations, "scope":"Definition audit only; missing historical targets are retained, not relocated or deleted. Path checks are opt-in and do not enumerate descendants."}
        print(json.dumps(result,ensure_ascii=False,indent=2))
        return 1 if ledger["issues"] or any(r["status"] in ("missing","unavailable") for r in locations) else 0
    # A rebuildable Markdown projection of selected orthogonal collection facets.
    # Historical and non-facet fields remain in the canonical ledger, not erased.
    targets = sorted({e["address"] for e in ledger["valid"] if e["kind"] == "prefix" and e["record"]["field"] in JUDGMENT_FACETS})
    def cell(value):
        return str(value).replace("\\", "\\\\").replace("|", "\\|").replace("\n", " ").replace("\r", " ").replace("<", "&lt;").replace(">", "&gt;")
    print("# Current collection facets\n")
    print("Generated from the existing authored judgment ledger, not a second registry. Each value is an inherited, dated classification of the collection's role—not inspection of every member or proof of backup coverage. Unknown values block broader assumptions.\n")
    print(f"Ledger: `{cell(ledger['path'])}`. Source SHA-256: `{ledger['sha256']}`. {len(targets)} explicitly described locations. {len(ledger['issues'])} invalid historical definitions excluded from resolution.\n")
    print("| Location | Topic | Role | Maintenance owner | Preservation constraint |")
    print("|---|---|---|---|---|")
    for path in targets:
        fields=resolve_judgments(ledger,path)
        values=[]
        for field in JUDGMENT_FACETS:
            result=fields.get(field,{"status":"not-recorded"})
            values.append(cell(result.get("value",result["status"])) if result["status"]=="known" else cell(result["status"]))
        print("| "+cell(path)+" | "+" | ".join(values)+" |")
    print("\nUse `sinnix-fs judgments explain /absolute/path` for winning rule targets, dates, methods and evidence. A `preservation` classification never authorizes deletion. Native application state, workflow dependencies and independent backup evidence still control actual maintenance.")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="sinnix-fs", description=__doc__,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    inv = sub.add_parser(
        "inventory", description=INVENTORY_DOC,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        help="Walk filesystems into a directory-level inventory (JSONL + DuckDB/Parquet)",
    )
    inv.add_argument("--root", action="append", default=None,
                      help=f"Filesystem root to walk (repeatable). Default: {DEFAULT_ROOTS}")
    inv.add_argument("--out-dir", default="/realm/state/fs-index")
    inv.add_argument("--max-depth", type=int, default=-1,
                      help="Stop descending past this depth; -1 for unlimited")
    inv.add_argument("--progress-every", type=int, default=2000)
    inv.add_argument("--scan-only", action="store_true")
    inv.set_defaults(func=cmd_inventory)

    con = sub.add_parser(
        "content", description=CONTENT_DOC,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        help="Index content-bearing files (hashes, titles, excerpts) across the system",
    )
    con.add_argument("--root", action="append", default=None,
                      help=f"Filesystem root to walk (repeatable). Default: {DEFAULT_ROOTS}")
    con.add_argument("--out-dir", default="/realm/state/fs-index")
    con.add_argument("--progress-every", type=int, default=5000)
    con.set_defaults(func=cmd_content)

    led = sub.add_parser(
        "ledger", description=LEDGER_DOC,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        help="Materialize the judgment ledger into resolved judgments, prefix inheritance and a coverage report",
    )
    led.add_argument("--index-dir", type=Path, default=Path("/realm/state/fs-index"),
                      help="directory holding judgments.jsonl, inventory.duckdb, content.duckdb")
    led.set_defaults(func=cmd_ledger)

    run = sub.add_parser(
        "run", description=cmd_run.__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        help="Run inventory, content and ledger in sequence, sharing one out-dir",
    )
    run.add_argument("--root", action="append", default=None,
                      help=f"Filesystem root to walk (repeatable). Default: {DEFAULT_ROOTS}")
    run.add_argument("--out-dir", default="/realm/state/fs-index")
    run.set_defaults(func=cmd_run)

    views = sub.add_parser("content-views", help="Correct derived full-hash/sample comparison views without rescanning")
    views.add_argument("--index-dir", type=Path, default=Path("/realm/state/fs-index"))
    views.set_defaults(func=lambda a: content_views_refresh(a.index_dir / "content.duckdb"))
    judgments = sub.add_parser("judgments", help="Read authored collection classifications without scanning or materializing")
    judgments.add_argument("--index-dir", type=Path, default=Path("/realm/state/fs-index"))
    actions = judgments.add_subparsers(dest="action", required=True)
    explain = actions.add_parser("explain", help="Explain lexical path classification with evidence; no payload access")
    explain.add_argument("path")
    audit = actions.add_parser("audit", help="Audit definitions; explicitly request path checks")
    audit.add_argument("--check-paths", action="store_true")
    actions.add_parser("report", help="Print a rebuildable Markdown collection-facet view")
    judgments.set_defaults(func=cmd_judgments)
    args = ap.parse_args()
    try:
        return args.func(args)
    except (ValueError, OSError) as exc:
        if args.command != "judgments":
            raise
        print(f"sinnix-fs judgments: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
