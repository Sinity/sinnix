# @sinnix-package
# description: Open a URL as a chromeless --app= Chrome window -- the browser-inversion front door
# runtimeInputs: bash
#!/usr/bin/env bash
# Each resource is its own window rather than a tab in a permanent tab bar,
# so closing the window is closing the "tab" and no pile can accumulate.
# Chrome's --app= mode hides only the browser chrome: extensions (Vimium C,
# the polylogue capture extension) still run inside these windows. Routes
# through sinnix-chrome (the scoped-systemd-run launcher in
# modules/features/desktop/browser.nix) so app windows land in the same
# cgroup accounting as normal Chrome.
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: sinnix-browser-app <url>" >&2
  exit 1
fi

url="$1"
browser_cmd="${SINNIX_BROWSER_COMMAND:-sinnix-chrome}"
if ! command -v "$browser_cmd" >/dev/null 2>&1; then
  browser_cmd=google-chrome-stable
fi

exec "$browser_cmd" "--app=${url}"
