#!/usr/bin/env bash
# @sinnix-package
# description: Hide visible declared Hyprland scratchpads
# runtimeInputs: bash coreutils hyprland jq
set -euo pipefail

command -v hyprctl >/dev/null 2>&1 || {
  echo "dismiss-scratchpads: hyprctl not found" >&2
  exit 1
}

monitors=$(hyprctl -j monitors)
while IFS= read -r workspace; do
  case "$workspace" in
    special:*)
      name=${workspace#special:}
      case "$name" in
        *[!A-Za-z0-9_.-]*) continue ;;
      esac
      hyprctl eval "hl.dispatch(hl.dsp.workspace.toggle_special(\"$name\"))" >/dev/null
      ;;
  esac
done < <(printf '%s' "$monitors" | jq -r '.[] | (.specialWorkspace // .activeSpecialWorkspace // {}).name // empty | select(startswith("special:"))')
