#!/usr/bin/env bash
# @sinnix-package
# description: Precompute and query cached media preview thumbnails
# runtimeInputs: bash coreutils fd ffmpeg ffmpegthumbnailer findutils gawk util-linux @video-projection
set -euo pipefail

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/media-preview-cache/v1"
video_cache_root="${cache_root}/video"
default_percent="${MEDIA_PREVIEW_PERCENT:-10}"

usage() {
  cat <<'EOF'
Usage:
  media-preview-cache thumb-path FILE [PERCENT]
  media-preview-cache ensure FILE [PERCENT]
  media-preview-cache warm DIR [PERCENT]

Commands:
  thumb-path  Print the deterministic cache path for a file thumbnail.
  ensure      Generate the thumbnail if it is missing, then print its path.
  warm        Recursively precompute thumbnails for video files under DIR.
EOF
}

canonical_file() {
  readlink -fz -- "$1"
}

thumb_path() {
  local resolved="$1" percent="$2" filter="$3"
  local metadata key shard

  metadata="$(stat --printf='%s\t%Y\t%Z' -- "$resolved")" || return
  key="$(
    {
      printf '%s\t%s\t%s\n' "$resolved" "$metadata" "$percent"
      if [[ -n "$filter" ]]; then
        printf '%s\n' "$filter"
      fi
    } | sha256sum | cut -d' ' -f1
  )"
  shard="${key:0:2}"

  printf '%s/%s/%s.jpg\n' "$video_cache_root" "$shard" "$key"
}

projected_thumb() {
  local source="$1" percent="$2" filter="$3" output="$4"
  local duration seek
  [[ "$percent" =~ ^[0-9]+$ ]] || return 2
  duration="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$source")" || return
  seek="$(awk -v duration="$duration" -v percent="$percent" 'BEGIN {
    if (duration !~ /^[0-9]+([.][0-9]+)?$/) exit 1
    printf "%.6f", duration * percent / 100
  }')" || return
  ffmpeg -nostdin -v error -y -filter_threads 2 -threads 4 -ss "$seek" -i "$source" \
    -map 0:V:0 -frames:v 1 -vf "$filter" -f image2 -update 1 "$output"
}

ensure_thumb() (
  local resolved="$1" percent="$2" filter="$3"
  local output lock_dir lock_file tmp_file status

  output="$(thumb_path "$resolved" "$percent" "$filter")" || return
  lock_dir="$(dirname "$output")"
  lock_file="${output}.lock"

  mkdir -p "$lock_dir"

  if [[ -s "$output" ]]; then
    printf '%s\n' "$output"
    return 0
  fi

  exec 9>"$lock_file"
  flock 9

  if [[ -s "$output" ]]; then
    printf '%s\n' "$output"
    return 0
  fi

  tmp_file="$(mktemp "${output}.tmp.XXXXXX")"
  trap 'rm -f -- "$tmp_file"' EXIT

  {
    if [[ -n "$filter" ]]; then
      projected_thumb "$resolved" "$percent" "$filter" "$tmp_file"
    else
      ffmpegthumbnailer -i "$resolved" -o "$tmp_file" -c jpeg -s 0 -t "$percent" -m
    fi
  } >/dev/null 2>&1 || {
    status=$?
    printf 'media-preview-cache: thumbnail generation failed: %q\n' "$resolved" >&2
    return "$status"
  }

  if [[ ! -s "$tmp_file" ]]; then
    printf 'media-preview-cache: thumbnail generator produced no image: %q\n' "$resolved" >&2
    return 1
  fi
  mv "$tmp_file" "$output"
  trap - EXIT

  printf '%s\n' "$output"
)

warm_tree() {
  local dir="$1"
  local percent="${2:-$default_percent}"
  local jobs="${MEDIA_PREVIEW_JOBS:-$(nproc)}"
  local resolved_dir

  IFS= read -r -d '' resolved_dir < <(canonical_file "$dir") || return

  fd \
    -HI \
    -t f \
    -e 3gp \
    -e asf \
    -e avi \
    -e flv \
    -e m4v \
    -e mkv \
    -e mov \
    -e mp4 \
    -e mpeg \
    -e mpg \
    -e mts \
    -e m2ts \
    -e ts \
    -e webm \
    . \
    "$resolved_dir" \
    -0 \
    | xargs -0 -r -P "$jobs" -I{} bash -c 'bash "$1" ensure "$2" "$3" >/dev/null' _ "$0" "{}" "$percent"
}

main() {
  local cmd="${1:-}"

  case "$cmd" in
    thumb-path|ensure)
      [[ $# -ge 2 ]] || {
        usage >&2
        exit 1
      }
      local resolved filter
      IFS= read -r -d '' resolved < <(canonical_file "$2") || return
      filter="$(video-projection thumbnail-filter "$resolved")" || return
      if [[ "$cmd" == "thumb-path" ]]; then
        thumb_path "$resolved" "${3:-$default_percent}" "$filter"
      else
        ensure_thumb "$resolved" "${3:-$default_percent}" "$filter"
      fi
      ;;
    warm)
      [[ $# -ge 2 ]] || {
        usage >&2
        exit 1
      }
      warm_tree "$2" "${3:-$default_percent}"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
