#!/usr/bin/env bash
# @sinnix-package
# description: Bootstrap and launch Meta Muse Code in persistent user state
# runtimeInputs: bash coreutils curl util-linux

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/muse-code"
install_dir="$state_dir/bin"
launcher="$install_dir/muse"
auth_path="$state_dir/auth.json"
installer_url="https://dev.meta.ai/install.sh"

mkdir -p "$install_dir"
exec 9>"$state_dir/bootstrap.lock"
flock 9

if [[ ! -x "$launcher" ]]; then
  installer="$(mktemp "$state_dir/installer.XXXXXX")"
  trap 'rm -f "$installer"' EXIT
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    "$installer_url" >"$installer"
  chmod 0700 "$installer"
  MUSE_INSTALL_DIR="$install_dir" \
    MUSE_AUTH_PATH="$auth_path" \
    MUSE_NO_MODIFY_PATH=1 \
    bash "$installer"
  rm -f "$installer"
  trap - EXIT
fi

# The contributor endpoint is the requested default. MUSE_MODEL remains
# overridable for standard-tier comparisons without changing the wrapper.
export MUSE_MODEL="${MUSE_MODEL:-muse-spark-1.2-contributor}"
export MUSE_AUTH_PATH="$auth_path"
export MUSE_INSTALL_DIR="$install_dir"
exec "$launcher" "$@"
