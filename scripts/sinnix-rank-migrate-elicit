#!/usr/bin/env python3
# @sinnix-package: skip

"""One-shot: convert a sinnix-rank-pairs (elicit) domain to the sinnix-rank store.

    sinnix-rank-migrate-elicit /realm/state/elicit/wallpaper \
        /realm/activity/shared/ranking/wallpaper

The old domain held `items.json` (a JSON array roster) and `comparisons.jsonl`
with `{a, b, outcome}` pair records; `model.json` was a cached fit and is not
carried over, since sinnix-rank refits on every read. The new domain is the
rank_core store: `items.jsonl` ({id, label, meta}) and `comparisons.jsonl`
({id, at, kind, set, winner, weight, context}).

Every record keeps its id and timestamp, and tombstones keep pointing at the
ids they deleted. A pair's outcome becomes its winner (1 -> a, 0 -> b,
0.5 -> no winner, which rank_core fits as a tie). A record whose outcome is
unreadable is kept as `incomparable` with the original outcome beside it, so
the fit ignores it exactly as the old tool did. The source directory is read,
never modified; delete this script once the live domain is migrated.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def convert_item(item: dict) -> dict:
    meta = {k: v for k, v in item.items() if k not in ("id", "label")}
    return {"id": str(item["id"]), "label": item.get("label", str(item["id"])), "meta": meta}


def convert_comparison(record: dict) -> dict:
    if "delete" in record:
        return dict(record)
    out = {"id": record["id"], "at": record["at"]}
    if record.get("kind") == "choice-set":
        out.update(
            kind="choice-set",
            set=[str(m) for m in record.get("set") or []],
            winner=str(record["winner"]) if record.get("winner") is not None else None,
        )
    else:
        a, b = str(record.get("a")), str(record.get("b"))
        out["set"] = [a, b]
        try:
            outcome = float(record["outcome"])
        except (KeyError, TypeError, ValueError):
            out.update(kind="incomparable", winner=None, outcome=record.get("outcome"))
        else:
            out.update(
                kind="pair",
                winner=a if outcome == 1 else (b if outcome == 0 else None),
            )
    out["weight"] = 1.0
    out["context"] = record.get("session")
    return out


def migrate(source: Path, target: Path) -> tuple[int, int]:
    items = json.loads((source / "items.json").read_text())
    if not isinstance(items, list):
        raise SystemExit(f"{source}/items.json is not a JSON array")
    lines = (source / "comparisons.jsonl").read_text().splitlines()
    records = [json.loads(line) for line in lines if line.strip()]
    if target.exists() and any(target.iterdir()):
        raise SystemExit(f"{target} exists and is not empty; refusing to merge into it")
    target.mkdir(parents=True, exist_ok=True)
    for name, rows in (
        ("items.jsonl", [convert_item(i) for i in items]),
        ("comparisons.jsonl", [convert_comparison(r) for r in records]),
    ):
        tmp = target / f".{name}.tmp"
        with tmp.open("w") as handle:
            for row in rows:
                handle.write(json.dumps(row, sort_keys=True) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        tmp.rename(target / name)
    return len(items), len(records)


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    n_items, n_records = migrate(Path(argv[1]), Path(argv[2]))
    print(f"migrated {n_items} items and {n_records} log records to {argv[2]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
