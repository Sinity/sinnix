#!/usr/bin/env bash
# @sinnix-package
# description: Resolve video-hosting URLs found in the URL ledger into archived copies
# runtimeInputs: duckdb coreutils jq @sinnix-ytdlp @sinnix-url-ledger

# The URL ledger discovers and normalizes every URL this operator's browsing
# history has touched, joined against archive-availability. This script is
# the video special-case: URLs on known video-hosting domains get resolved
# into a real archived copy via yt-dlp, since neither Wayback nor Common
# Crawl preserve video content -- their CDX coverage check only tells you a
# page existed, not that the video survives.
#
# A manifest (archived.jsonl) tracks what's already been pulled so re-runs
# are cheap; yt-dlp's own --download-archive gives the same guarantee at
# the download layer, used here as the primary de-dup mechanism.
set -euo pipefail
umask 077

LEDGER_PARQUET="${SINNIX_URL_LEDGER_PARQUET:-}"
ARCHIVE_ROOT="${SINNIX_VIDEO_ARCHIVE_ROOT:-/realm/activity/browser/recovery}"
DL_ARCHIVE="$ARCHIVE_ROOT/.yt-dlp-archive"
# Compatibility record from the first resolver implementation. It remains
# append-only, but no longer suppresses retries because it contains failures
# as well as successes.
TRIED="$ARCHIVE_ROOT/.tried-urls"
# The ledger holds tens of thousands of watch URLs; a run pulls a bounded
# slice, most-visited first, and the rest waits for later runs.
LIMIT="${SINNIX_VIDEO_RESOLVE_LIMIT:-20}"

# Video pages only, matched on the exact host and path shape: the ledger
# also carries channel/home/search pages and local archive-replay URLs whose
# paths mention these domains.
VIDEO_URL_PATTERN='^https?://((www\.|m\.)?youtube\.com/(watch\?|shorts/)|youtu\.be/[A-Za-z0-9_-]+|(www\.)?vimeo\.com/[0-9]+|(www\.)?twitch\.tv/videos/[0-9]+|streamable\.com/[A-Za-z0-9]+|(www\.)?dailymotion\.com/video/)'

# This function runs only the bounded extraction. The owner wrapper holds the
# same kernel lock as publication/GC until DuckDB and its connection have closed.
query_ledger() {
  local ledger=$1 pattern=$2 limit=$3 ledger_sql
  if [[ ! -f "$ledger" ]]; then
    echo "sinnix-video-resolve: no ledger parquet at $ledger (run 'sinnix-url-ledger build' first)" >&2
    return 1
  fi
  ledger_sql=${ledger//\'/\'\'}
  duckdb -list -noheader -c "
    SELECT normalized_url
    FROM read_parquet('$ledger_sql')
    WHERE regexp_matches(normalized_url, '$pattern')
    ORDER BY visit_count DESC, normalized_url
    LIMIT $limit;"
}

if [[ -n "$LEDGER_PARQUET" ]]; then
  # Explicit override lifetime belongs to its caller, outside managed GC.
  if ! url_lines=$(query_ledger "$LEDGER_PARQUET" "$VIDEO_URL_PATTERN" "$LIMIT"); then
    echo "sinnix-video-resolve: ledger query failed" >&2
    exit 1
  fi
else
  ledger_args=()
  if [[ -n "${SINNIX_URL_LEDGER_ROOT:-}" ]]; then
    ledger_args=(--derived-root "$SINNIX_URL_LEDGER_ROOT")
  fi
  export -f query_ledger
  if ! url_lines=$(sinnix-url-ledger published "${ledger_args[@]}" --exec "$BASH" -c \
    'query_ledger "$SINNIX_URL_LEDGER_GENERATION/url_ledger.parquet" "$@"' _ "$VIDEO_URL_PATTERN" "$LIMIT"); then
    echo "sinnix-video-resolve: ledger query failed" >&2
    exit 1
  fi
fi
urls=()
if [[ -n "$url_lines" ]]; then
  mapfile -t urls <<< "$url_lines"
fi

mkdir -p "$ARCHIVE_ROOT"
touch "$TRIED"

echo "sinnix-video-resolve: ${#urls[@]} candidate video URLs from the ledger (limit $LIMIT, $(wc -l < "$TRIED") already tried)" >&2

resolved=0
failed=0
for url in "${urls[@]}"; do
  [[ -n "$url" ]] || continue
  printf '%s\n' "$url" >> "$TRIED"
  if sinnix-ytdlp \
    --download-archive "$DL_ARCHIVE" \
    --no-playlist \
    --extractor-args 'youtube:player_client=android' \
    --paths "$ARCHIVE_ROOT" \
    --output "%(extractor)s/%(id)s.%(ext)s" \
    --write-info-json \
    -- "$url"; then
    resolved=$((resolved + 1))
  else
    failed=$((failed + 1))
  fi
done

echo "sinnix-video-resolve: $resolved resolved (or already archived), $failed failed/unavailable" >&2
