#!/usr/bin/env python3
# @sinnix-package
# description: Preference elicitation over arbitrary item domains via pairwise comparison (Bradley-Terry)
# runtimeInputs: coreutils xdg-utils
# pythonPackages: @sinnix-rank-core

"""Domain-general preference elicitation for the operator.

Given a *domain* -- a named set of concrete items (wallpapers, theme
directions, keybind conventions, anything) -- this tool runs the loop the
stashbox ranker and Gwern's resorter already validated on media libraries:

  1. ask the operator to compare pairs of items, choosing the *most
     informative* next pair (highest-uncertainty anchor + nearest rival,
     with epsilon exploration -- the resorter heuristic);
  2. infer latent quality scores under the Bradley-Terry model (the
     Plackett-Luce top-1 extension is kept, so n-wise choice sets from
     other frontends fit too);
  3. where items carry feature vectors, infer *why*: a logistic fit on
     standardized feature deltas across all comparisons yields per-feature
     preference weights ("darker preferred", "saturation disliked") that an
     agent can narrate, plus theta/feature correlations as a cross-check.

The fit is `rank_core.fit`, the estate's one ranking engine (docs/ranking.md);
this file owns the domain file format and the surfaces, not the model. The
question-selection strategy follows docs/upstream/gwern/resorter.md.

Comparison surfaces, cheapest first:
  * `ask`      -- interactive terminal loop (resorter-style), for text domains;
  * `record`   -- one comparison from the command line (agent-mediated);
  * `session`  -- renders a self-contained HTML page into the hub's reports
                  tree; each tap POSTs to the hub's /feedback spool, and
                  `ingest` drains the spool back into the domain. Works from
                  desktop or phone anywhere on the tailnet, needs no new
                  service, no new port, no hub changes;
  * `serve`    -- a loopback page for image domains: two items filling a 4K
                  screen, one keypress per judgment, refit after every
                  answer so the next pair follows from the last one.

State lives under /realm/state/elicit/<domain>/ (mutable application state, owned
by this tool, backed up as part of /realm/state):
  items.json        the item roster (id, label, optional image/description/
                    features/prior), written by `init`, editable;
  comparisons.jsonl append-only operator judgments with tombstone undo --
                    the primary evidence, never rewritten;
  model.json        latest fitted model (regenerated by `rank`).
"""

from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import math
import mimetypes
import os
import random
import shutil
import subprocess
import sys
import threading
import urllib.parse
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from rank_core import Comparison, Selector, fit, top_k_stability

SCHEMA = "sinnix-elicit-v1"
BASE_DIR = Path(os.environ.get("SINNIX_ELICIT_DIR", "/realm/state/elicit"))
REPORTS_DIR = Path(os.environ.get("SINNIX_HUB_REPORTS_DIR", "/realm/data/derived/reports"))
FEEDBACK_DIR = Path(os.environ.get("SINNIX_HUB_FEEDBACK_DIR", "/realm/data/derived/hub-feedback"))


def now_iso():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ──────────────────────────────────────────────────────────────────────────
# Domain store
# ──────────────────────────────────────────────────────────────────────────
class Domain:
    def __init__(self, name):
        self.name = name
        self.dir = BASE_DIR / name
        self.items_path = self.dir / "items.json"
        self.comparisons_path = self.dir / "comparisons.jsonl"
        self.model_path = self.dir / "model.json"

    def exists(self):
        return self.items_path.exists()

    def load_items(self):
        items = json.loads(self.items_path.read_text())
        by_id = {}
        for it in items:
            iid = str(it["id"])
            if iid in by_id:
                raise SystemExit(f"duplicate item id in {self.items_path}: {iid}")
            by_id[iid] = it
        return items, by_id

    def load_comparisons(self):
        rows, deleted = [], set()
        if self.comparisons_path.exists():
            for line in self.comparisons_path.read_text().splitlines():
                if not line.strip():
                    continue
                rec = json.loads(line)
                if "delete" in rec:
                    deleted.add(rec["delete"])
                else:
                    rows.append(rec)
        return [r for r in rows if r.get("id") not in deleted]

    def scan_ids(self):
        """(every comparison id the log has ever carried, the tombstoned ones).

        The first set is what `ingest` must dedup against. Deduping against
        the live records instead re-imports every undone judgment on every
        drain, and the drain runs on every arriving comparison -- a single
        undone record grows the log without bound.
        """
        seen, deleted = set(), set()
        if self.comparisons_path.exists():
            for line in self.comparisons_path.read_text().splitlines():
                if not line.strip():
                    continue
                rec = json.loads(line)
                if "delete" in rec:
                    deleted.add(rec["delete"])
                else:
                    seen.add(rec.get("id"))
        return seen, deleted

    def append(self, record):
        record.setdefault("id", str(uuid.uuid4()))
        record.setdefault("at", now_iso())
        self.dir.mkdir(parents=True, exist_ok=True)
        with self.comparisons_path.open("a") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
        return record["id"]


# ──────────────────────────────────────────────────────────────────────────
# The fit: this file's record shape, rank_core's model
# ──────────────────────────────────────────────────────────────────────────
def to_comparisons(comparisons, known):
    """This domain's records as rank_core comparisons, dropping what the model
    cannot use.

    A record naming an id that is not in items.json is dropped rather than
    ranked: rank_core would happily fit a comparison-only id, but here the
    roster is the operator's declared item set, and a stale id in the
    comparison log is evidence about an item that no longer exists -- ranking
    it would put a deleted wallpaper back in `rank` output.

    `outcome` is a three-way judgment, so anything that is not exactly 1 or 0
    is the tie, which rank_core represents as a winner-less pair and splits
    into two half-weight records.
    """
    out = []
    for c in comparisons:
        if c.get("kind") == "choice-set":
            members = [str(m) for m in (c.get("set") or []) if str(m) in known]
            winner = str(c.get("winner"))
            if len(members) >= 2 and winner in known and winner in members:
                out.append(
                    Comparison(
                        id=str(c.get("id", "")),
                        at=str(c.get("at", "")),
                        kind="choice-set",
                        set=members,
                        winner=winner,
                    )
                )
            continue
        a, b = str(c.get("a")), str(c.get("b"))
        if a not in known or b not in known or a == b:
            continue
        try:
            y = float(c["outcome"])
        except (KeyError, TypeError, ValueError):
            continue
        winner = a if y == 1 else (b if y == 0 else None)
        out.append(
            Comparison(
                id=str(c.get("id", "")),
                at=str(c.get("at", "")),
                kind="pair",
                set=[a, b],
                winner=winner,
            )
        )
    return out


def fit_bradley_terry(items, comparisons, tau=1.0, tol=1e-8, max_iter=2000):
    """theta/se/matches per item id, in this file's dict shape.

    Per-item `prior` is not passed on: it only ever chose the MM iteration's
    starting point, and the anchored objective has one maximum, so it never
    moved a converged fit.
    """
    ids = sorted({str(i["id"]) for i in items})
    result = fit(
        ids,
        to_comparisons(comparisons, set(ids)),
        tau=tau,
        tol=tol,
        max_iter=max_iter,
    )
    return {
        r.id: {"id": r.id, "theta": r.theta, "se": r.se, "matches": r.matches}
        for r in result.records.values()
    }


# ──────────────────────────────────────────────────────────────────────────
# Informative-pair selection (resorter heuristic)
# ──────────────────────────────────────────────────────────────────────────
def pick_pairs(items, comparisons, n_pairs, explore_every=3, rng=random):
    records = fit_bradley_terry(items, comparisons)
    counts = {str(i["id"]): records[str(i["id"])]["matches"] for i in items}
    ordered = sorted(records.values(), key=lambda r: r["theta"])
    rank_pos = {r["id"]: i for i, r in enumerate(ordered)}
    seen_pairs = {frozenset((str(c.get("a")), str(c.get("b")))) for c in comparisons if c.get("a") and c.get("b")}

    pairs = []
    used = set()
    tick = 0
    ids = [str(i["id"]) for i in items]
    while len(pairs) < n_pairs:
        tick += 1
        if tick > n_pairs * 20:
            break
        pool = [i for i in ids if i not in used]
        if len(pool) < 2:
            used = set()
            pool = ids
        if tick % explore_every == 0:
            a, b = rng.sample(pool, 2)
        else:
            # anchor: most uncertain (max SE; cold start = least seen);
            # rival: within a rank window, highest SE.
            anchors = sorted(pool, key=lambda i: (-records[i]["se"], counts[i]))
            a = rng.choice(anchors[: max(1, min(8, len(anchors)))])
            apos = rank_pos[a]
            window = [i for i in pool if i != a and abs(rank_pos[i] - apos) <= 8] or [i for i in pool if i != a]
            b = max(window, key=lambda i: records[i]["se"])
        key = frozenset((a, b))
        if key in {frozenset(p) for p in pairs} or (key in seen_pairs and tick % explore_every != 0):
            continue
        pairs.append((a, b))
        used.update((a, b))
    return pairs, records


# ──────────────────────────────────────────────────────────────────────────
# Why: feature-delta logistic + theta correlations
# ──────────────────────────────────────────────────────────────────────────
def logistic(x):
    if x >= 0:
        z = math.exp(-x)
        return 1 / (1 + z)
    z = math.exp(x)
    return z / (1 + z)


def explain(items, comparisons, records):
    feats = {}
    for it in items:
        f = it.get("features")
        if isinstance(f, dict):
            feats[str(it["id"])] = {k: float(v) for k, v in f.items()}
    if not feats:
        return {"note": "no items carry feature vectors; explain has nothing to work with"}
    keys = sorted({k for f in feats.values() for k in f})

    def std(k):
        vals = [f[k] for f in feats.values() if k in f]
        if len(vals) < 2:
            return None
        m = sum(vals) / len(vals)
        v = sum((x - m) ** 2 for x in vals) / (len(vals) - 1)
        return math.sqrt(v) or None

    stds = {k: std(k) for k in keys}
    usable = [k for k in keys if stds[k]]

    rows = []
    for c in comparisons:
        a, b = feats.get(str(c.get("a"))), feats.get(str(c.get("b")))
        if not (a and b):
            continue
        try:
            y = float(c["outcome"])
        except (KeyError, TypeError, ValueError):
            continue
        x = [((a.get(k, 0.0) - b.get(k, 0.0)) / stds[k]) for k in usable]
        rows.append((x, y))

    weights = [0.0] * len(usable)
    if rows:
        lam = 1.0 / max(len(rows), 1)
        lr = 0.5
        for _ in range(2000):
            grad = [lam * w for w in weights]
            for x, y in rows:
                p = logistic(sum(w * xi for w, xi in zip(weights, x)))
                for i, xi in enumerate(x):
                    grad[i] += (p - y) * xi / len(rows)
            weights = [w - lr * g for w, g in zip(weights, grad)]

    def pearson(k):
        pts = [(feats[i][k], records[i]["theta"]) for i in feats if k in feats[i] and i in records]
        if len(pts) < 3:
            return None
        mx = sum(p[0] for p in pts) / len(pts)
        my = sum(p[1] for p in pts) / len(pts)
        sx = math.sqrt(sum((p[0] - mx) ** 2 for p in pts))
        sy = math.sqrt(sum((p[1] - my) ** 2 for p in pts))
        if not sx or not sy:
            return None
        return sum((p[0] - mx) * (p[1] - my) for p in pts) / (sx * sy)

    features = sorted(
        (
            {
                "feature": k,
                "choice_weight": round(w, 4),
                "theta_correlation": (lambda r: round(r, 4) if r is not None else None)(pearson(k)),
            }
            for k, w in zip(usable, weights)
        ),
        key=lambda r: -abs(r["choice_weight"]),
    )
    return {
        "n_comparisons_used": len(rows),
        "reading": "choice_weight > 0 means the operator tends to pick the item with the HIGHER value of that feature; theta_correlation is the same question asked of the fitted ranking. Agreement in sign across both = a real pattern; treat |weight| on <10 comparisons as anecdote.",
        "features": features,
    }


# ──────────────────────────────────────────────────────────────────────────
# HTML session page (served by the hub, posts to its /feedback spool)
# ──────────────────────────────────────────────────────────────────────────
PAGE_TEMPLATE = """<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>elicit: __DOMAIN__</title>
<style>
 body{margin:0;background:#111;color:#ddd;font-family:system-ui,sans-serif;display:flex;flex-direction:column;min-height:100vh}
 #stage{flex:1;display:flex;gap:8px;padding:8px}
 .opt{flex:1;display:flex;flex-direction:column;cursor:pointer;border:3px solid #333;border-radius:8px;overflow:hidden;background:#1a1a1a}
 .opt:hover{border-color:#4ea1ff}
 .opt img{width:100%;height:100%;object-fit:contain;min-height:0;flex:1}
 .opt .txt{padding:16px;font-size:1.1em;white-space:pre-wrap}
 .opt .cap{padding:6px 10px;font-size:.8em;color:#888;background:#161616}
 @media (orientation:portrait){#stage{flex-direction:column}}
 #bar{display:flex;gap:8px;align-items:center;padding:8px;background:#181818;font-size:.9em}
 #bar button{background:#2a2a2a;color:#ddd;border:1px solid #444;border-radius:6px;padding:8px 14px;font-size:1em}
 #done{padding:40px;text-align:center;font-size:1.2em;display:none}
 #sync{margin-left:auto;color:#7a7}
</style>
<div id="stage"></div>
<div id="done"></div>
<div id="bar">
 <span id="progress"></span>
 <button onclick="answer(0.5)">tie</button>
 <button onclick="skip()">skip</button>
 <button onclick="undo()">undo</button>
 <span id="sync"></span>
</div>
<script>
const SESSION = __SESSION_JSON__;
const KEY = "elicit-" + SESSION.session;
let idx = 0, log = JSON.parse(localStorage.getItem(KEY) || "[]");
idx = log.filter(r => !r.undone).length;
function card(item, side){
  const el = document.createElement("div");
  el.className = "opt";
  el.onclick = () => answer(side === 0 ? 1 : 0);
  if (item.image) { const im = document.createElement("img"); im.src = item.image; el.appendChild(im); }
  if (item.description && !item.image) { const t = document.createElement("div"); t.className = "txt"; t.textContent = item.description; el.appendChild(t); }
  const c = document.createElement("div"); c.className = "cap"; c.textContent = item.label || item.id; el.appendChild(c);
  return el;
}
function render(){
  const stage = document.getElementById("stage");
  stage.innerHTML = "";
  if (idx >= SESSION.pairs.length){
    stage.style.display = "none";
    const d = document.getElementById("done");
    d.style.display = "block";
    d.textContent = "Done — " + log.filter(r=>!r.undone).length + " judgments recorded. They'll be ingested and the ranking refit automatically a few seconds after you stop (sinnix-elicit-autoingest) — check with: sinnix elicit rank " + SESSION.domain;
    document.getElementById("progress").textContent = "complete";
    return;
  }
  const [a, b] = SESSION.pairs[idx];
  stage.appendChild(card(SESSION.items[a], 0));
  stage.appendChild(card(SESSION.items[b], 1));
  document.getElementById("progress").textContent = (idx+1) + " / " + SESSION.pairs.length;
}
function post(rec){
  fetch("/feedback", {method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(rec)})
    .then(r => { document.getElementById("sync").textContent = r.ok ? "synced" : "spool error " + r.status; })
    .catch(() => { document.getElementById("sync").textContent = "offline — kept locally, re-open on the hub"; });
}
function answer(outcome){
  const [a, b] = SESSION.pairs[idx];
  const rec = {schema: SESSION.schema, domain: SESSION.domain, session: SESSION.session,
               id: crypto.randomUUID(), a: a, b: b, outcome: outcome, at: new Date().toISOString()};
  log.push(rec);
  localStorage.setItem(KEY, JSON.stringify(log));
  post(rec);
  idx++; render();
}
function skip(){ idx++; render(); }
function undo(){
  const last = log.filter(r=>!r.undone).pop();
  if (!last) return;
  last.undone = true;
  localStorage.setItem(KEY, JSON.stringify(log));
  post({schema: SESSION.schema, domain: SESSION.domain, session: SESSION.session, delete: last.id});
  idx = Math.max(0, idx-1); render();
}
document.addEventListener("keydown", e => {
  if (e.key === "1" || e.key === "ArrowLeft") answer(1);
  else if (e.key === "2" || e.key === "ArrowRight") answer(0);
  else if (e.key === "t") answer(0.5);
  else if (e.key === "s") skip();
  else if (e.key === "u") undo();
});
render();
</script>
"""


def cmd_session(domain, args):
    items, by_id = domain.load_items()
    comparisons = domain.load_comparisons()
    pairs, _ = pick_pairs(items, comparisons, args.pairs)
    if not pairs:
        raise SystemExit("could not build any pairs (need >= 2 items)")
    session_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    out_dir = REPORTS_DIR / "elicit" / domain.name
    assets = out_dir / "assets"
    page_items = {}
    for a, b in pairs:
        for iid in (a, b):
            if iid in page_items:
                continue
            it = by_id[iid]
            entry = {"id": iid, "label": it.get("label", iid), "description": it.get("description")}
            if it.get("image"):
                src = Path(it["image"])
                if not src.exists():
                    raise SystemExit(f"item {iid}: image not found: {src}")
                assets.mkdir(parents=True, exist_ok=True)
                dest = assets / f"{iid}{src.suffix}"
                if not dest.exists():
                    shutil.copy2(src, dest)
                entry["image"] = f"assets/{dest.name}"
            page_items[iid] = entry
    session = {
        "schema": SCHEMA,
        "domain": domain.name,
        "session": session_id,
        "pairs": pairs,
        "items": page_items,
    }
    page = PAGE_TEMPLATE.replace("__DOMAIN__", html.escape(domain.name)).replace(
        "__SESSION_JSON__", json.dumps(session)
    )
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / f"session-{session_id}.html"
    out.write_text(page)
    rel = out.relative_to(REPORTS_DIR)
    print(f"session page: {out}")
    print(f"hub URL:      http://<hub>/reports/{rel}   ({len(pairs)} pairs)")
    print(f"afterwards:   sinnix elicit ingest {domain.name}")


def cmd_ingest(domain, args):
    existing, tombstoned = domain.scan_ids()
    imported = deleted = 0
    for spool in sorted(FEEDBACK_DIR.glob("*.jsonl")):
        for line in spool.read_text().splitlines():
            if not line.strip():
                continue
            try:
                payload = json.loads(line).get("payload") or {}
            except json.JSONDecodeError:
                continue
            if payload.get("schema") != SCHEMA or payload.get("domain") != domain.name:
                continue
            if "delete" in payload:
                if payload["delete"] not in tombstoned:
                    domain.append({"delete": payload["delete"], "id": str(uuid.uuid4())})
                    tombstoned.add(payload["delete"])
                    deleted += 1
                continue
            if payload.get("id") in existing:
                continue
            try:
                outcome = float(payload["outcome"])
                rec = {
                    "id": payload["id"],
                    "kind": "pair",
                    "a": str(payload["a"]),
                    "b": str(payload["b"]),
                    "outcome": outcome,
                    "session": payload.get("session"),
                    "at": payload.get("at", now_iso()),
                }
            except (KeyError, TypeError, ValueError):
                continue
            domain.append(rec)
            existing.add(rec["id"])
            imported += 1
    print(f"ingested {imported} comparisons, {deleted} undos from {FEEDBACK_DIR}")


def cmd_init(domain, args):
    if domain.exists() and not args.force:
        raise SystemExit(f"domain '{domain.name}' already exists at {domain.dir} (use --force to overwrite items.json)")
    items = json.loads(Path(args.items).read_text())
    if not isinstance(items, list) or len(items) < 2:
        raise SystemExit("items file must be a JSON list of >= 2 items")
    for it in items:
        if "id" not in it:
            raise SystemExit(f"item missing id: {it}")
    if args.image_features:
        # `explain` is inert on items that carry no feature vectors, so
        # populate them here from sinnix-image-features rather than leaving
        # every image domain to hand-roll its own.
        missing = [it for it in items if it.get("image") and "features" not in it]
        computed = failed = 0
        for it in missing:
            try:
                out = subprocess.run(
                    ["sinnix-image-features", it["image"]],
                    capture_output=True, text=True, timeout=60, check=True,
                )
                it["features"] = json.loads(out.stdout)
                computed += 1
            except (subprocess.SubprocessError, json.JSONDecodeError, OSError) as exc:
                # Report, never silently drop: an item quietly missing its
                # features degrades `explain` in a way nothing surfaces.
                print(f"  feature extraction failed for {it['id']}: {exc}", file=sys.stderr)
                failed += 1
        print(f"computed image features for {computed} item(s)"
              + (f", {failed} failed" if failed else ""))
    domain.dir.mkdir(parents=True, exist_ok=True)
    domain.items_path.write_text(json.dumps(items, indent=2) + "\n")
    print(f"initialized domain '{domain.name}' with {len(items)} items at {domain.dir}")


def cmd_record(domain, args):
    _, by_id = domain.load_items()
    for iid in (args.a, args.b):
        if iid not in by_id:
            raise SystemExit(f"unknown item id: {iid}")
    outcome = {"a": 1.0, "b": 0.0, "tie": 0.5}[args.winner]
    rid = domain.append({"kind": "pair", "a": args.a, "b": args.b, "outcome": outcome, "session": "cli"})
    print(rid)


def cmd_ask(domain, args):
    items, by_id = domain.load_items()
    comparisons = domain.load_comparisons()
    print("commands: 1=first  2=second  t=tie  s=skip  q=quit")
    asked = 0
    while asked < args.pairs:
        pairs, records = pick_pairs(items, comparisons, 1)
        if not pairs:
            break
        a, b = pairs[0]
        mean_se = sum(r["se"] for r in records.values()) / len(records)
        la = by_id[a].get("label", a)
        lb = by_id[b].get("label", b)
        try:
            answer = input(f"[se~{mean_se:.2f}] '{la}'  vs  '{lb}'  ? ").strip().lower()
        except EOFError:
            break
        if answer == "q":
            break
        if answer == "s":
            continue
        outcome = {"1": 1.0, "2": 0.0, "t": 0.5}.get(answer)
        if outcome is None:
            print("  (1, 2, t, s or q)")
            continue
        rec = {"kind": "pair", "a": a, "b": b, "outcome": outcome, "session": "ask"}
        domain.append(rec)
        comparisons.append(rec)
        asked += 1
    print(f"recorded {asked} comparisons")


def fit_and_save_model(domain, items, comparisons):
    by_id = {str(i["id"]): i for i in items}
    records = fit_bradley_terry(items, comparisons)
    ordered = sorted(records.values(), key=lambda r: -r["theta"])
    model = {
        "schema": "sinnix-elicit-model-v1",
        "domain": domain.name,
        "fitted_at": now_iso(),
        "n_comparisons": len(comparisons),
        "ranking": [
            {**r, "label": by_id[r["id"]].get("label", r["id"]), "theta": round(r["theta"], 4), "se": round(r["se"], 4)}
            for r in ordered
        ],
        "explain": explain(items, comparisons, records),
    }
    domain.model_path.write_text(json.dumps(model, indent=2) + "\n")
    return model


def cmd_rank(domain, args):
    items, _by_id = domain.load_items()
    comparisons = domain.load_comparisons()
    model = fit_and_save_model(domain, items, comparisons)
    if args.json:
        print(json.dumps(model, indent=2))
        return
    print(f"{domain.name}: {len(comparisons)} comparisons over {len(items)} items")
    for i, r in enumerate(model["ranking"]):
        print(f"{i + 1:3d}. θ={r['theta']:+6.2f} ±{r['se']:.2f}  ({int(r['matches'])} matches)  {r['label']}")


def cmd_explain(domain, args):
    items, _ = domain.load_items()
    comparisons = domain.load_comparisons()
    records = fit_bradley_terry(items, comparisons)
    result = explain(items, comparisons, records)
    if args.json:
        print(json.dumps(result, indent=2))
        return
    if "features" not in result:
        print(result.get("note", "nothing to explain"))
        return
    print(f"{result['n_comparisons_used']} feature-bearing comparisons")
    print(f"({result['reading']})")
    for f in result["features"]:
        corr = f["theta_correlation"]
        corr_s = f"{corr:+.2f}" if corr is not None else "  n/a"
        print(f"  {f['choice_weight']:+7.3f}  (θ-corr {corr_s})  {f['feature']}")


def cmd_pairs(domain, args):
    items, by_id = domain.load_items()
    comparisons = domain.load_comparisons()
    pairs, _ = pick_pairs(items, comparisons, args.pairs)
    out = [{"a": a, "b": b, "label_a": by_id[a].get("label", a), "label_b": by_id[b].get("label", b)} for a, b in pairs]
    print(json.dumps(out, indent=2))


def cmd_autoingest(_domain, args):
    """Drain the hub feedback spool into every existing domain and refit.

    The operator's own question: "why does this require a separate step?"
    after tapping through a comparison session. It doesn't, once this runs on
    a timer -- `ingest` already knows how to no-op cleanly on records it's
    seen before (dedup by comparison id), so running it every couple of
    minutes against every domain is just as safe as running it once by hand,
    and the model.json a domain's `explain`/session page reads stays fresh
    without the operator ever typing the two commands themselves.
    """
    if not BASE_DIR.exists():
        return
    for d in sorted(BASE_DIR.iterdir()):
        dom = Domain(d.name)
        if not dom.exists():
            continue
        before = len(dom.load_comparisons())
        cmd_ingest(dom, args)
        after_items, _ = dom.load_items()
        after_comparisons = dom.load_comparisons()
        if len(after_comparisons) != before:
            fit_and_save_model(dom, after_items, after_comparisons)
            print(f"{dom.name}: +{len(after_comparisons) - before} comparisons, model refit")


def cmd_domains(_domain, _args):
    if not BASE_DIR.exists():
        return
    for d in sorted(BASE_DIR.iterdir()):
        dom = Domain(d.name)
        if dom.exists():
            items, _ = dom.load_items()
            n = len(dom.load_comparisons())
            print(f"{d.name}: {len(items)} items, {n} comparisons")


# ──────────────────────────────────────────────────────────────────────────
# serve: side-by-side comparison on a loopback page
# ──────────────────────────────────────────────────────────────────────────
# `session` renders a fixed pair list into a file the hub serves, so nothing
# can refit between taps. `serve` is the same judgment against a live process:
# it refits after every answer, so the next pair is chosen from what the
# operator just said, and a 126-image roster is one sitting rather than rounds
# of page, tap, drain, refit.
#
# It selects through `rank_core.Selector` rather than this file's `pick_pairs`
# because a cold roster starts as one connected component per item, and only
# the Selector deliberately bridges components -- without that, thetas across
# the roster stay mutually meaningless however long the operator clicks.
SERVE_PAGE = """<!doctype html>
<meta charset="utf-8">
<title>elicit: __DOMAIN__</title>
<style>
 html,body{margin:0;height:100%;background:#0b0b0b;color:#ddd;
           font-family:system-ui,sans-serif;overflow:hidden}
 #stage{position:absolute;inset:0 0 34px 0;display:flex;gap:6px;padding:6px}
 .opt{flex:1;position:relative;display:flex;align-items:center;justify-content:center;
      border:2px solid #222;border-radius:6px;overflow:hidden;background:#000;cursor:pointer}
 .opt:hover{border-color:#4ea1ff}
 .opt img{max-width:100%;max-height:100%;object-fit:contain}
 .opt .cap{position:absolute;left:0;bottom:0;padding:2px 8px;font-size:12px;
           color:#9a9a9a;background:rgba(0,0,0,.65)}
 #bar{position:absolute;left:0;right:0;bottom:0;height:34px;display:flex;align-items:center;
      gap:20px;padding:0 12px;font-size:13px;background:#141414;color:#8a8a8a;
      white-space:nowrap;overflow:hidden}
 #err{color:#e07a5f}
 #done{position:absolute;inset:0;display:none;align-items:center;justify-content:center;
       flex-direction:column;gap:12px;font-size:20px;text-align:center;padding:40px}
</style>
<div id="stage">
 <div class="opt" id="left"></div>
 <div class="opt" id="right"></div>
</div>
<div id="done"></div>
<div id="bar">
 <span>&larr;/&rarr; pick &middot; d draw &middot; s skip &middot; u undo &middot; q quit</span>
 <span id="count"></span><span id="stab"></span><span id="lead"></span><span id="err"></span>
</div>
<script>
const CONFIG = __CONFIG_JSON__;
let cur = null, busy = false, over = false;
const el = id => document.getElementById(id);
function newId(){
  if (self.crypto && crypto.randomUUID) return crypto.randomUUID();
  return "c-" + Date.now() + "-" + Math.random().toString(16).slice(2);
}
function paint(side, item){
  const box = el(side);
  box.textContent = "";
  const img = document.createElement("img");
  img.src = item.src;
  img.alt = item.label;
  box.appendChild(img);
  const cap = document.createElement("div");
  cap.className = "cap";
  cap.textContent = item.label;
  box.appendChild(cap);
  box.onclick = () => answer(side === "left" ? 1 : 0);
}
function status(s){
  el("count").textContent = s.comparisons + " comparisons · " + s.judged_items + "/" +
    s.items + " items seen · " + s.components + " groups";
  el("stab").textContent = "top-" + s.stability.k + " stability p=" +
    s.stability.p_stable + (s.stability.settled ? " (settled)" : "");
  el("lead").textContent = s.top.length ? "leader: " + s.top[0].label : "";
}
function finish(s){
  over = true;
  el("stage").style.display = "none";
  const d = el("done");
  d.style.display = "flex";
  d.textContent = s.recorded_this_session + " judgments recorded this run, " +
    s.comparisons + " in the domain. The refit is saved and the server has stopped. " +
    "Read it with: sinnix elicit rank " + CONFIG.domain;
}
function show(payload){
  if (payload.status) status(payload.status);
  if (payload.done || !payload.pair){ finish(payload.status); return; }
  cur = payload.pair;
  paint("left", cur.a);
  paint("right", cur.b);
  (payload.preload || []).forEach(url => { const im = new Image(); im.src = url; });
}
async function call(path, body){
  if (busy || over) return;
  busy = true;
  try {
    const opts = body ? {method: "POST", headers: {"Content-Type": "application/json"},
                         body: JSON.stringify(body)} : {};
    const r = await fetch(path, opts);
    if (!r.ok) throw new Error("HTTP " + r.status);
    el("err").textContent = "";
    show(await r.json());
  } catch (e) {
    el("err").textContent = "error: " + e.message + " (nothing recorded)";
  } finally {
    busy = false;
  }
}
const answer = outcome => cur && call("/answer",
  {id: newId(), a: cur.a.id, b: cur.b.id, outcome: outcome});
const skip = () => cur && call("/skip", {a: cur.a.id, b: cur.b.id});
document.addEventListener("keydown", e => {
  if (e.key === "ArrowLeft" || e.key === "1") answer(1);
  else if (e.key === "ArrowRight" || e.key === "2") answer(0);
  else if (e.key === "d" || e.key === "t") answer(0.5);
  else if (e.key === "s") skip();
  else if (e.key === "u") call("/undo", {});
  else if (e.key === "q") call("/quit", {});
  else return;
  e.preventDefault();
});
call("/next");
</script>
"""


class ServeSession:
    """The comparison loop's live state.

    The append-only log is the truth and everything here is a view of it,
    rebuilt after every judgment: a run is resumable because starting a second
    time over the same domain reconstructs the same state.
    """

    def __init__(self, domain, top_k=10, seed=None, stability_samples=200, session=None):
        self.domain = domain
        self.items, self.by_id = domain.load_items()
        self.ids = [str(i["id"]) for i in self.items]
        self.top_k = max(1, min(top_k, len(self.ids)))
        self.stability_samples = stability_samples
        self.session = session or ("serve-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S"))
        self.rng = random.Random(seed)
        self.selector = Selector(item_ids=self.ids, grid_n=2, rng=self.rng)
        self.lock = threading.RLock()
        self.queue = []
        self.recorded = []
        self.done = False
        self.reload()
        self.selector.seed_counts(to_comparisons(self.comparisons, set(self.ids)))

    # ── state ────────────────────────────────────────────────────────────
    def reload(self):
        # Dedup against every id the log has ever carried, tombstones
        # included, re-read on every judgment: a record the operator undid is
        # still one this domain has seen, and the hub drain appends to the
        # same log while this loop runs. Deduping against the live records
        # instead re-appends an undone judgment on every retry.
        seen, tombstoned = self.domain.scan_ids()
        self.known_ids = seen | tombstoned
        self.comparisons = self.domain.load_comparisons()
        self.fit = fit(self.ids, to_comparisons(self.comparisons, set(self.ids)))
        self.selector.update_fit(self.fit)
        self.judged = {
            frozenset((str(c.get("a")), str(c.get("b"))))
            for c in self.comparisons
            if c.get("a") and c.get("b")
        }

    def status(self):
        stability = top_k_stability(
            self.fit, k=self.top_k, samples=self.stability_samples, seed=0
        )
        records = self.fit.records
        return {
            "domain": self.domain.name,
            "items": len(self.ids),
            "comparisons": len(self.comparisons),
            "recorded_this_session": len(self.recorded),
            "judged_items": sum(1 for r in records.values() if r.matches > 0),
            "components": len({r.component for r in records.values()}),
            "stability": {
                "k": stability.k,
                "p_stable": round(stability.p_stable, 3),
                "settled": stability.p_stable >= 0.9,
                "top_k": list(stability.top_k),
            },
            "top": [
                {
                    "id": r.id,
                    "label": self.by_id[r.id].get("label", r.id),
                    "theta": round(r.theta, 3),
                    "se": round(r.se, 3),
                }
                for r in self.fit.ranked()[: self.top_k]
            ],
        }

    # ── pair supply ──────────────────────────────────────────────────────
    def _pick(self):
        queued = {frozenset(p) for p in self.queue}
        chosen = None
        for _ in range(40):
            candidate, _strategy = self.selector.pick_set()
            key = frozenset(candidate)
            chosen = candidate
            if len(key) == 2 and key not in self.judged and key not in queued:
                return candidate
        # Fresh pairs exhausted, or the selector keeps landing on judged ones:
        # re-asking beats stalling the loop, and a repeated comparison is
        # evidence about consistency rather than a duplicate record.
        return chosen

    def _fill(self):
        while len(self.queue) < 2:
            pair = self._pick()
            if not pair or len(set(pair)) < 2:
                break
            self.queue.append(list(pair))

    def _drop(self, a, b):
        key = frozenset((a, b))
        self.queue = [p for p in self.queue if frozenset(p) != key]

    def _card(self, item_id):
        item = self.by_id[item_id]
        return {
            "id": item_id,
            "label": item.get("label", item_id),
            "src": f"/image/{urllib.parse.quote(item_id)}",
        }

    def next_payload(self):
        with self.lock:
            if self.done:
                return {"done": True, "status": self.status()}
            self._fill()
            if not self.queue:
                return {"done": True, "status": self.status()}
            a, b = self.queue[0]
            ahead = self.queue[1] if len(self.queue) > 1 else []
            return {
                "pair": {"a": self._card(a), "b": self._card(b)},
                "preload": [self._card(i)["src"] for i in ahead],
                "status": self.status(),
            }

    # ── judgments ────────────────────────────────────────────────────────
    def answer(self, record_id, a, b, outcome):
        with self.lock:
            a, b = str(a), str(b)
            if a not in self.by_id or b not in self.by_id or a == b:
                raise ValueError(f"not a comparable pair of roster items: {a!r}, {b!r}")
            outcome = float(outcome)
            if outcome not in (0.0, 0.5, 1.0):
                raise ValueError(f"outcome must be 1 (a), 0 (b) or 0.5 (draw): {outcome!r}")
            record_id = str(record_id or uuid.uuid4())
            self.reload()
            if record_id not in self.known_ids:
                self.domain.append(
                    {
                        "id": record_id,
                        "kind": "pair",
                        "a": a,
                        "b": b,
                        "outcome": outcome,
                        "session": self.session,
                    }
                )
                self.recorded.append(record_id)
                self.reload()
            self._drop(a, b)
            return self.next_payload()

    def skip(self, a, b):
        with self.lock:
            self._drop(str(a), str(b))
            return self.next_payload()

    def undo(self):
        with self.lock:
            if self.recorded:
                self.domain.append({"delete": self.recorded.pop()})
                self.reload()
            return self.next_payload()

    def finish(self):
        with self.lock:
            self.done = True
            fit_and_save_model(self.domain, self.items, self.comparisons)
            return {"done": True, "status": self.status()}


class ServeHandler(BaseHTTPRequestHandler):
    """Loopback-only JSON/image surface for SERVE_PAGE."""

    protocol_version = "HTTP/1.1"
    server_version = "sinnix-elicit"
    sys_version = ""
    session_state = None

    def log_message(self, fmt, *args):
        pass

    # ── plumbing ─────────────────────────────────────────────────────────
    def _send(self, code, body, content_type, extra=None):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(body)

    def _json(self, payload, code=200):
        self._send(code, json.dumps(payload).encode(), "application/json")

    def _read_body(self):
        length = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(length).decode()) if length else {}

    # ── routes ───────────────────────────────────────────────────────────
    def do_GET(self):
        state = self.session_state
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            page = SERVE_PAGE.replace("__DOMAIN__", html.escape(state.domain.name)).replace(
                "__CONFIG_JSON__", json.dumps({"domain": state.domain.name})
            )
            self._send(200, page.encode(), "text/html; charset=utf-8")
        elif path == "/next":
            self._json(state.next_payload())
        elif path == "/status":
            self._json(state.status())
        elif path.startswith("/image/"):
            self._image(urllib.parse.unquote(path[len("/image/") :]))
        else:
            self._json({"error": "not found"}, 404)

    def _image(self, item_id):
        # The roster is the only source of paths, so a crafted request reaches
        # no file the operator did not put in items.json.
        item = self.session_state.by_id.get(item_id)
        source = Path(item["image"]) if item and item.get("image") else None
        if source is None or not source.is_file():
            self._json({"error": f"no image for item {item_id}"}, 404)
            return
        content_type = mimetypes.guess_type(source.name)[0] or "application/octet-stream"
        self._send(200, source.read_bytes(), content_type, {"Cache-Control": "max-age=3600"})

    def do_POST(self):
        state = self.session_state
        path = urllib.parse.urlparse(self.path).path
        try:
            body = self._read_body()
            if path == "/answer":
                self._json(
                    state.answer(body.get("id"), body.get("a"), body.get("b"), body.get("outcome"))
                )
            elif path == "/skip":
                self._json(state.skip(body.get("a"), body.get("b")))
            elif path == "/undo":
                self._json(state.undo())
            elif path == "/quit":
                self._json(state.finish())
                threading.Thread(target=self.server.shutdown, daemon=True).start()
            else:
                self._json({"error": "not found"}, 404)
        except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
            self._json({"error": str(exc)}, 400)


def build_serve_server(domain, host="127.0.0.1", port=0, top_k=10, seed=None):
    """(bound server, session). Loopback by default; nothing here authenticates."""
    state = ServeSession(domain, top_k=top_k, seed=seed)
    handler = type("BoundServeHandler", (ServeHandler,), {"session_state": state})
    return ThreadingHTTPServer((host, port), handler), state


def cmd_serve(domain, args):
    server, state = build_serve_server(domain, host=args.host, port=args.port, top_k=args.top_k)
    url = f"http://{args.host}:{server.server_port}/"
    missing = [str(i["id"]) for i in state.items if not Path(i.get("image") or "").is_file()]
    if missing:
        print(
            f"{len(missing)} item(s) have no readable image, e.g. {', '.join(missing[:5])}",
            file=sys.stderr,
        )
    print(f"{domain.name}: {len(state.ids)} items, {len(state.comparisons)} comparisons")
    # Flushed: the URL is the only way in, and a redirected stdout would hold
    # it in the buffer until the server stops.
    print(f"serving {url}  (left/right pick, d draw, s skip, u undo, q quit)", flush=True)
    if args.open:
        try:
            subprocess.Popen(
                ["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except OSError as exc:
            print(f"could not open a browser ({exc}); the URL above still works", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        if not state.done:
            fit_and_save_model(domain, state.items, state.comparisons)
    print(f"recorded {len(state.recorded)} comparisons; model refit at {domain.model_path}")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, needs_domain=True):
        sp = sub.add_parser(name)
        if needs_domain:
            sp.add_argument("domain")
        sp.set_defaults(fn=fn)
        return sp

    sp = add("init", cmd_init)
    sp.add_argument("--items", required=True, help="JSON list: [{id, label?, image?, description?, features?, prior?}]")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--image-features", action="store_true",
                    help="compute a feature vector for each item carrying an `image` path, via sinnix-image-features (without features, `explain` has nothing to fit)")
    sp = add("session", cmd_session)
    sp.add_argument("-n", "--pairs", type=int, default=20)
    add("ingest", cmd_ingest)
    add("autoingest", cmd_autoingest, needs_domain=False)
    sp = add("ask", cmd_ask)
    sp.add_argument("-n", "--pairs", type=int, default=15)
    sp = add("record", cmd_record)
    sp.add_argument("--a", required=True)
    sp.add_argument("--b", required=True)
    sp.add_argument("--winner", required=True, choices=["a", "b", "tie"])
    sp = add("rank", cmd_rank)
    sp.add_argument("--json", action="store_true")
    sp = add("explain", cmd_explain)
    sp.add_argument("--json", action="store_true")
    sp = add("pairs", cmd_pairs)
    sp.add_argument("-n", "--pairs", type=int, default=10)
    sp = add("serve", cmd_serve)
    sp.add_argument("--host", default="127.0.0.1")
    # Ephemeral by default: this is an operator-run foreground process, not a
    # declared service, so it must not claim a number flake/data/ports.nix
    # arbitrates. The URL is printed, and --open follows it.
    sp.add_argument("--port", type=int, default=0)
    sp.add_argument("--top-k", type=int, default=10,
                    help="how many leaders the stopping statistic must agree on")
    sp.add_argument("--open", action="store_true", help="launch the page with xdg-open")
    add("domains", cmd_domains, needs_domain=False)

    args = p.parse_args()
    domain = Domain(args.domain) if hasattr(args, "domain") else None
    if domain and args.cmd not in ("init",) and not domain.exists():
        raise SystemExit(f"no such domain '{domain.name}' (run: sinnix elicit init {domain.name} --items ...)")
    args.fn(domain, args)


if __name__ == "__main__":
    main()
