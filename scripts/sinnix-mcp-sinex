#!/usr/bin/env bash
# @sinnix-package
# description: Serve the Sinex MCP tools of the running sinexd (sinexctl mcp)
# runtimeInputs: bash @sinexctl
#
# The provider is the deployed Sinex package's own sinexctl.
# Non-login MCP clients use the daemon's loopback API and agent token by
# default; explicit connection settings keep their usual meaning.
set -euo pipefail

export SINEX_ENDPOINT="${SINEX_ENDPOINT:-http://127.0.0.1:7171}"
export SINEX_TOKEN_FILE="${SINEX_TOKEN_FILE:-/var/lib/sinex/daemon/tokens/agent.token}"
exec sinexctl mcp "$@"
