#!/usr/bin/env bash
# @sinnix-package
# description: Serve the Sinex MCP tools of the running sinexd (sinexctl mcp)
# runtimeInputs: bash
#
# sinexctl comes from the installed Sinex package. MCP clients may start this
# without a login shell, so the daemon's socket and the agent token are named
# here when the environment does not name them.
set -euo pipefail

export SINEX_ENDPOINT="${SINEX_ENDPOINT:-unix:/run/sinex/sinexd.sock}"
export SINEX_TOKEN_FILE="${SINEX_TOKEN_FILE:-/var/lib/sinex/daemon/tokens/agent.token}"
exec /run/current-system/sw/bin/sinexctl mcp "$@"
