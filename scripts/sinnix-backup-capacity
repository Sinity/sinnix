#!/usr/bin/env python3
# @sinnix-package
# description: Record backup repository sizes and forecast when the destination fills
# runtimeInputs: coreutils util-linux
"""Record the destination's free space and forecast when it fills.

Free space falls every night and weekly compaction returns what pruning freed,
so the forecast compares free space measured right after each compaction:
that series moves only with real growth. Each measurement records the epoch
of the last compaction, read from the maintenance job's marker.
"""

import argparse
import datetime as dt
import fcntl
import json
import os
import subprocess
from pathlib import Path


def after_compaction(rows):
    # The first measurement after each compaction.
    points = []
    for row in rows:
        compacted = row.get("compacted_epoch")
        if compacted is None or compacted > row["epoch"]:
            continue
        if points and points[-1]["compacted_epoch"] == compacted:
            continue
        points.append(row)
    return points


def trend(history, current):
    rows = sorted(
        (
            row
            for row in [*history, current]
            if row["filesystem_uuid"] == current["filesystem_uuid"]
        ),
        key=lambda row: row["epoch"],
    )
    points = after_compaction(rows)
    # The largest fall in free space within one compaction cycle: the room
    # the destination needs before the next compaction returns it.
    cycle_drop = 0
    for start, following in zip(points, [*points[1:], None], strict=True):
        cycle = [
            row
            for row in rows
            if row["epoch"] >= start["epoch"]
            and (following is None or row["epoch"] < following["epoch"])
        ]
        cycle_drop = max(
            cycle_drop,
            start["available_bytes"] - min(row["available_bytes"] for row in cycle),
        )
    record = {"compaction_points": len(points), "cycle_drop_bytes": cycle_drop}
    if len(points) < 2 or points[-1]["epoch"] - points[0]["epoch"] < 6 * 86400:
        return record | {
            "status": "insufficient_history",
            "net_bytes_per_day": None,
            "days_remaining": None,
        }
    first, last = points[0], points[-1]
    rate = (
        (first["available_bytes"] - last["available_bytes"])
        * 86400
        / (last["epoch"] - first["epoch"])
    )
    return record | {
        "status": "observed",
        "span_days": (last["epoch"] - first["epoch"]) / 86400,
        "net_bytes_per_day": rate,
        "days_remaining": last["available_bytes"] / rate if rate > 0 else None,
    }


# Long enough to buy and seed another disk. Free bytes alone say nothing:
# the same headroom is weeks at one growth rate and years at another.
ALERT_DAYS = 30


def alert(trend_record, available_bytes):
    days = trend_record["days_remaining"]
    # The destination would fill inside one cycle, before compaction runs.
    if available_bytes < trend_record["cycle_drop_bytes"]:
        return True
    return days is not None and days < ALERT_DAYS


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, type=Path)
    parser.add_argument("--state", required=True, type=Path)
    parser.add_argument("--compact-marker", required=True, type=Path)
    args = parser.parse_args()
    if not os.path.ismount(args.root):
        raise SystemExit(f"backup destination is not mounted: {args.root}")
    uuid = subprocess.check_output(
        ["findmnt", "-n", "-o", "UUID", "--mountpoint", str(args.root)], text=True
    ).strip()
    if not uuid:
        raise SystemExit("backup destination UUID is unavailable")
    args.state.parent.mkdir(parents=True, exist_ok=True)
    lock = args.state.with_suffix(".lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    now = dt.datetime.now(dt.timezone.utc)
    history = json.loads(args.state.read_text()) if args.state.exists() else []
    sizes = {}
    for repo in sorted((args.root / "backup").iterdir()):
        if repo.is_dir():
            result = subprocess.run(
                ["du", "-sx", "-B1", "--", str(repo)],
                check=True,
                capture_output=True,
                text=True,
            )
            sizes[repo.name] = int(result.stdout.split()[0])
    if (
        not os.path.ismount(args.root)
        or subprocess.check_output(
            ["findmnt", "-n", "-o", "UUID", "--mountpoint", str(args.root)], text=True
        ).strip()
        != uuid
    ):
        raise SystemExit("backup destination changed during measurement")
    fs = os.statvfs(args.root)
    current = {
        "epoch": now.timestamp(),
        "observed_at": now.isoformat(),
        "filesystem_uuid": uuid,
        "available_bytes": fs.f_bavail * fs.f_frsize,
        "repository_allocated_bytes": sizes,
        "compacted_epoch": (
            int(args.compact_marker.read_text())
            if args.compact_marker.exists()
            else None
        ),
    }
    current["trend"] = trend(history, current)
    current["alert"] = alert(current["trend"], current["available_bytes"])
    args.state.parent.mkdir(parents=True, exist_ok=True)
    temporary = args.state.with_suffix(".tmp")
    temporary.write_text(json.dumps([*history, current], indent=2) + "\n")
    temporary.replace(args.state)
    print(json.dumps(current), flush=True)
    if current["alert"]:
        raise SystemExit(f"Backup destination projected full within {ALERT_DAYS} days")


if __name__ == "__main__":
    main()
