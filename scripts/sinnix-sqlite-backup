#!/usr/bin/env python3
# @sinnix-package
# description: Create an integrity-checked compressed SQLite backup
# runtimeInputs: python3 zstd coreutils

from __future__ import annotations

import argparse
import os
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path


class BackupCancelled(Exception):
    pass


cancel_requested = False
FULL_INTEGRITY_PAGE_LIMIT = 100_000
QUICK_CHECK_PROGRESS_OPS = 10_000
# Every sidecar cleanup() ever creates ends in one of these compound
# suffixes: raw_path (".tmp"), its journal/WAL siblings (".tmp-journal",
# ".tmp-wal"), and compressed_path (output suffix + ".tmp", e.g. ".zst.tmp",
# which already ends in plain ".tmp").
STALE_SIDECAR_SUFFIXES = (".tmp", ".tmp-journal", ".tmp-wal")
# Grace window applied only when no completed backup exists yet to anchor
# the threshold against (first-ever run in a directory) -- guards against
# sweeping a concurrently in-flight run's just-created tmp file.
STALE_SIDECAR_GRACE_SECONDS = 3600


def request_cancel(_signum: int, _frame: object) -> None:
    global cancel_requested
    cancel_requested = True


def sweep_stale_sidecars(output_path: Path) -> None:
    """Remove .tmp/.tmp-journal/.tmp-wal debris left by a run that was
    killed (OOM, reboot, SIGKILL) before its own `finally: cleanup()` could
    run. Each run's raw_path embeds a caller-chosen unique name (typically a
    timestamp), so a later run's own per-run cleanup() -- scoped to its own
    raw_path -- never revisits an earlier run's leftovers. This directory-wide
    sweep is what actually reclaims them, bounded to files older than the
    newest completed backup so it never touches a run genuinely in flight."""
    parent = output_path.parent
    if not parent.is_dir():
        return
    completed = [p for p in parent.glob(f"*{output_path.suffix}") if p.is_file()]
    threshold = max(
        (p.stat().st_mtime for p in completed),
        default=time.time() - STALE_SIDECAR_GRACE_SECONDS,
    )
    for path in parent.iterdir():
        if not path.is_file() or not path.name.endswith(STALE_SIDECAR_SUFFIXES):
            continue
        try:
            if path.stat().st_mtime >= threshold:
                continue
            path.unlink()
        except FileNotFoundError:
            pass


def run_command(command: list[str]) -> None:
    if cancel_requested:
        raise BackupCancelled
    process = subprocess.Popen(command)
    while process.poll() is None:
        if cancel_requested:
            process.terminate()
            process.wait()
            raise BackupCancelled
        time.sleep(0.05)
    if process.returncode != 0:
        raise subprocess.CalledProcessError(process.returncode, command)


def require_quick_check(connection: sqlite3.Connection) -> None:
    """Reject a corrupt immutable snapshot while allowing cancellation."""

    def interrupt_if_cancelled() -> int:
        return int(cancel_requested)

    connection.set_progress_handler(interrupt_if_cancelled, QUICK_CHECK_PROGRESS_OPS)
    try:
        integrity = connection.execute("PRAGMA quick_check(1)").fetchone()
    except sqlite3.OperationalError:
        if cancel_requested:
            raise BackupCancelled from None
        raise
    finally:
        connection.set_progress_handler(None, 0)
    if cancel_requested:
        raise BackupCancelled
    if integrity != ("ok",):
        raise RuntimeError(f"SQLite quick_check failed: {integrity!r}")
    print("SQLite quick_check(1): ok")


def compress(source_path: Path, compressed_path: Path) -> None:
    run_command(["zstd", "-T1", "-q", "-f", str(source_path), "-o", str(compressed_path)])
    if not compressed_path.is_file() or compressed_path.stat().st_size == 0:
        raise RuntimeError("SQLite compression produced no artifact")
    print("SQLite compression: ok")


def backup_database(
    source_path: Path, output_path: Path, *, immutable_source: bool = False
) -> None:
    raw_path = output_path.with_name(output_path.name.removesuffix(".zst") + ".tmp")
    compressed_path = output_path.with_suffix(output_path.suffix + ".tmp")
    sidecars = (raw_path, raw_path.with_name(raw_path.name + "-journal"), raw_path.with_name(raw_path.name + "-wal"), compressed_path)

    def cleanup() -> None:
        for path in sidecars:
            try:
                path.unlink()
            except FileNotFoundError:
                pass

    output_path.parent.mkdir(parents=True, exist_ok=True)
    sweep_stale_sidecars(output_path)
    cleanup()
    source: sqlite3.Connection | None = None
    target: sqlite3.Connection | None = None
    try:
        if immutable_source:
            wal_path = Path(f"{source_path}-wal")
            if wal_path.exists() and wal_path.stat().st_size > 0:
                raise RuntimeError("immutable SQLite source must not have a WAL")
            source = sqlite3.connect(
                f"file:{source_path}?mode=ro&immutable=1", uri=True, timeout=5.0
            )
            source.execute("PRAGMA busy_timeout=5000")
            page_count = int(source.execute("PRAGMA page_count").fetchone()[0])
            if page_count <= FULL_INTEGRITY_PAGE_LIMIT:
                integrity = source.execute("PRAGMA integrity_check").fetchone()
                if integrity != ("ok",):
                    raise RuntimeError(f"SQLite integrity_check failed: {integrity!r}")
                print("SQLite integrity_check: ok")
            else:
                require_quick_check(source)
            source.close()
            source = None
            compress(source_path, compressed_path)
            os.chmod(compressed_path, 0o600)
            os.replace(compressed_path, output_path)
            os.chmod(output_path, 0o600)
            return
        source = sqlite3.connect(source_path, timeout=5.0)
        source.execute("PRAGMA busy_timeout=5000")
        # Ask SQLite to advance the WAL before taking the filesystem copy. A
        # regular sparse copy is bounded by the database file size, while the
        # online-backup API can restart from page zero whenever concurrent
        # commits invalidate a copied chunk, causing unbounded amplification.
        source.execute("PRAGMA wal_checkpoint(PASSIVE)").fetchone()
        source.close()
        source = None
        run_command(["cp", "--sparse=always", str(source_path), str(raw_path)])
        wal_path = Path(f"{source_path}-wal")
        raw_wal_path = Path(f"{raw_path}-wal")
        # A missing -wal sidecar is the CLEAN state (a parked/checkpointed
        # database has none -- polylogue's dbs, 2026-08-18). The old handler
        # caught FileNotFoundError, which cp never raises for a missing
        # SOURCE (it exits 1 -> CalledProcessError), so the "handled" branch
        # was unreachable and the first WAL-less backup failed.
        if wal_path.exists():
            run_command(["cp", "--sparse=always", str(wal_path), str(raw_wal_path)])
        else:
            raw_wal_path.unlink(missing_ok=True)
        target = sqlite3.connect(raw_path, timeout=5.0)
        target.execute("PRAGMA busy_timeout=5000")
        page_count = target.execute("PRAGMA page_count").fetchone()[0]
        if page_count <= FULL_INTEGRITY_PAGE_LIMIT:
            integrity = target.execute("PRAGMA integrity_check").fetchone()
            if integrity != ("ok",):
                raise RuntimeError(f"SQLite integrity_check failed: {integrity!r}")
        else:
            # A full integrity scan of the live 22 GB telemetry projection
            # exceeds the timer's 30-minute budget. Opening the copied database
            # and reading its schema proves the SQLite header and WAL can be
            # consumed; bounded fixtures still receive full integrity_check.
            target.execute("PRAGMA schema_version").fetchone()
        target.close()
        target = None
        compress(raw_path, compressed_path)
        os.chmod(compressed_path, 0o600)
        os.replace(compressed_path, output_path)
        os.chmod(output_path, 0o600)
    finally:
        if target is not None:
            target.close()
        if source is not None:
            source.close()
        cleanup()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path)
    parser.add_argument(
        "--immutable-source",
        action="store_true",
        help="compress a verified WAL-free filesystem snapshot without copying it",
    )
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, request_cancel)
    signal.signal(signal.SIGINT, request_cancel)
    try:
        backup_database(args.source, args.output, immutable_source=args.immutable_source)
    except BackupCancelled:
        print("SQLite backup cancelled", file=sys.stderr)
        return 143
    except (OSError, RuntimeError, sqlite3.Error, subprocess.CalledProcessError) as error:
        print(f"SQLite backup failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
