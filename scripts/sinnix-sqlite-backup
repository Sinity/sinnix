#!/usr/bin/env python3
# @sinnix-package
# description: Create an integrity-checked compressed SQLite backup
# runtimeInputs: python3 zstd coreutils

from __future__ import annotations

import argparse
import math
from contextlib import contextmanager
import os
import select
import signal
import sqlite3
import subprocess
import sys
import threading
import tempfile
import time
from pathlib import Path
from typing import Iterator


class BackupCancelled(Exception):
    pass


cancel_requested = False
cancel_wakeup_read_fd: int | None = None
FULL_INTEGRITY_PAGE_LIMIT = 100_000
CHECK_POLL_SECONDS = 0.02


def request_cancel(_signum: int, _frame: object) -> None:
    global cancel_requested
    cancel_requested = True


@contextmanager
def cancellation_wakeup() -> Iterator[int]:
    """Make signals observable while the main thread is inside SQLite C code."""
    global cancel_wakeup_read_fd
    read_fd, write_fd = os.pipe()
    os.set_blocking(read_fd, False)
    os.set_blocking(write_fd, False)
    previous_fd = signal.set_wakeup_fd(write_fd)
    cancel_wakeup_read_fd = read_fd
    try:
        yield read_fd
    finally:
        cancel_wakeup_read_fd = None
        signal.set_wakeup_fd(previous_fd)
        os.close(read_fd)
        os.close(write_fd)


def run_command(command: list[str]) -> None:
    if cancel_requested:
        raise BackupCancelled
    process = subprocess.Popen(command)
    while process.poll() is None:
        if cancel_requested:
            process.terminate()
            process.wait()
            raise BackupCancelled
        time.sleep(0.05)
    if process.returncode != 0:
        raise subprocess.CalledProcessError(process.returncode, command)


def run_check(
    connection: sqlite3.Connection, statement: str, deadline: float | None
) -> tuple[str, ...]:
    """Run an integrity pragma that a signal or a deadline can still stop.

    An integrity pragma runs its whole scan inside one VDBE opcode, so a
    progress handler fires at statement boundaries rather than during the walk
    and cannot end one in flight. sqlite3_interrupt does, from another thread.
    """
    stop = threading.Event()
    reason: list[str] = []

    def watchdog() -> None:
        while not stop.is_set():
            readable, _, _ = select.select(
                ([cancel_wakeup_read_fd] if cancel_wakeup_read_fd is not None else []),
                [],
                [],
                CHECK_POLL_SECONDS,
            )
            if stop.is_set():
                return
            if readable:
                os.read(readable[0], 4096)
                reason.append("cancelled")
                connection.interrupt()
                return
            if cancel_requested:
                reason.append("cancelled")
                connection.interrupt()
                return
            if deadline is not None and time.monotonic() >= deadline:
                reason.append("deadline")
                connection.interrupt()
                return

    if cancel_requested:
        raise BackupCancelled
    watcher = threading.Thread(target=watchdog, daemon=True)
    watcher.start()
    try:
        verdict = connection.execute(statement).fetchone()
    except sqlite3.OperationalError:
        if reason[:1] == ["cancelled"]:
            raise BackupCancelled from None
        if reason[:1] == ["deadline"]:
            raise RuntimeError(
                f"SQLite {statement} exceeded its integrity budget"
            ) from None
        raise
    finally:
        stop.set()
        watcher.join(timeout=5)
    if cancel_requested:
        raise BackupCancelled
    return verdict


def check_immutable_snapshot(
    connection: sqlite3.Connection, deadline: float | None, *, mode: str
) -> tuple[str, str]:
    """Report the exact strength of the check performed before publication.

    The source subvolume is NOCOW, which also turns off Btrfs data checksums.
    Structural mode can detect page damage; header mode cannot and records
    that reduced assurance explicitly.

    Above the page limit the check is quick_check rather than integrity_check:
    quick_check validates b-trees and scans table rows. integrity_check
    additionally cross-verifies every index entry against its table, which does
    not stream and scales with index count. The argument bounds the reported
    error list to one row, so a shredded database cannot accumulate a result
    row per damaged page inside the unit's memory ceiling.
    """
    page_count = int(connection.execute("PRAGMA page_count").fetchone()[0])
    if mode == "header":
        print(f"sqlite-backup: schema_header over {page_count} pages (no page walk)", flush=True)
        # Backup availability and a full page walk are separate claims. The
        # daily telemetry snapshot uses this bounded check so a growing NOCOW
        # database cannot prevent every new backup from being published.
        connection.execute("PRAGMA schema_version").fetchone()
        connection.execute("SELECT name FROM sqlite_master LIMIT 1").fetchone()
        return "schema_header", "limited"
    check = (
        "integrity_check" if page_count <= FULL_INTEGRITY_PAGE_LIMIT else "quick_check(1)"
    )
    # The walk is the longest silent stretch of the run, so say what started.
    print(f"sqlite-backup: {check} over {page_count} pages", flush=True)
    verdict = run_check(connection, f"PRAGMA {check}", deadline)
    if verdict != ("ok",):
        raise RuntimeError(f"SQLite {check} failed: {verdict!r}")
    return check, "ok"


def compress(source_path: Path, compressed_path: Path) -> None:
    run_command(["zstd", "-T1", "-q", "-f", str(source_path), "-o", str(compressed_path)])
    if not compressed_path.is_file() or compressed_path.stat().st_size == 0:
        raise RuntimeError("SQLite compression produced no artifact")
    # zstd exiting zero only means it wrote a frame. Testing the frame decodes
    # it and compares the XXH64 content checksum it embeds by default, which is
    # what makes the artifact's bytes -- not just the compressor's exit status
    # -- the thing that gates publication.
    run_command(["zstd", "-t", "-q", str(compressed_path)])


def backup_database(
    source_path: Path,
    output_path: Path,
    *,
    immutable_source: bool = False,
    check_budget_seconds: float = 0.0,
    check_mode: str = "structural",
    acquire_budget_seconds: float = 300.0,
) -> None:
    """Publish a checked archive from a native cut or an owner-frozen source.

    Live acquisition fails if its native read transaction outlasts the budget.
    Scratch is private and owned by this invocation; other runs and retained
    crash debris are never removed by publication.
    """
    if not math.isfinite(acquire_budget_seconds) or acquire_budget_seconds <= 0:
        raise ValueError("acquisition budget must be finite and positive")
    source_path = source_path.resolve(strict=True)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    scratch = tempfile.TemporaryDirectory(prefix=".sqlite-backup-", dir=output_path.parent)
    raw_path = Path(scratch.name) / "snapshot.sqlite"
    compressed_path = Path(scratch.name) / "snapshot.sqlite.zst"
    source: sqlite3.Connection | None = None
    target: sqlite3.Connection | None = None
    try:
        if immutable_source:
            wal_path = Path(f"{source_path}-wal")
            if wal_path.exists() and wal_path.stat().st_size > 0:
                raise RuntimeError("immutable SQLite source must not have a WAL")
            source_bytes = source_path.stat().st_size
            source = sqlite3.connect(
                source_path.resolve(strict=True).as_uri() + "?mode=ro&immutable=1", uri=True, timeout=5.0
            )
            source.execute("PRAGMA busy_timeout=5000")
            # Map the immutable database so integrity walks use kernel
            # readahead. The packaged SQLite permits mappings up to 1 TiB;
            # clean mapped pages remain reclaimable under memory pressure.
            source.execute(f"PRAGMA mmap_size={source_bytes}")
            started = time.monotonic()
            check, verdict = check_immutable_snapshot(
                source, started + check_budget_seconds if check_budget_seconds else None,
                mode=check_mode,
            )
            check_seconds = time.monotonic() - started
            source.close()
            source = None
            compress_started = time.monotonic()
            compress(source_path, compressed_path)
            compress_seconds = time.monotonic() - compress_started
            archive_bytes = compressed_path.stat().st_size
            os.chmod(compressed_path, 0o600)
            os.replace(compressed_path, output_path)
            os.chmod(output_path, 0o600)
            print(
                "sqlite-backup receipt:"
                f" source={source_path}"
                f" source_bytes={source_bytes}"
                f" check={check}"
                f" verdict={verdict}"
                f" check_seconds={check_seconds:.1f}"
                f" archive={output_path}"
                f" archive_bytes={archive_bytes}"
                " archive_check=zstd-t:ok"
                " restore_check=zstd-t:ok"
                f" source_open={check}:{verdict}"
                f" structural_check={'ok' if verdict == 'ok' else 'not_run'}"
                f" compress_seconds={compress_seconds:.1f}"
            )
            return
        acquisition_deadline = time.monotonic() + acquire_budget_seconds
        source = sqlite3.connect(source_path.as_uri() + "?mode=ro", uri=True, timeout=min(5.0, acquire_budget_seconds))
        # Pin a native read transaction before copying pages. Later commits
        # cannot restart the backup or produce a main/WAL mixture.
        source.execute("BEGIN")
        source.execute("SELECT rootpage FROM sqlite_master LIMIT 1").fetchone()
        target = sqlite3.connect(raw_path, timeout=5.0)

        def acquisition_progress(_status: int, _remaining: int, _total: int) -> None:
            if cancel_requested:
                raise BackupCancelled
            if time.monotonic() >= acquisition_deadline:
                raise RuntimeError("SQLite snapshot acquisition exceeded its budget")

        acquisition_progress(0, 0, 0)
        source.backup(target, pages=1024, progress=acquisition_progress, sleep=0.05)
        source.close()
        source = None
        target.execute("PRAGMA busy_timeout=5000")
        target.execute(f"PRAGMA mmap_size={raw_path.stat().st_size}")
        started = time.monotonic()
        check, verdict = check_immutable_snapshot(
            target, started + check_budget_seconds if check_budget_seconds else None,
            mode="structural",
        )
        check_seconds = time.monotonic() - started
        target.close()
        target = None
        compress_started = time.monotonic()
        compress(raw_path, compressed_path)
        compress_seconds = time.monotonic() - compress_started
        archive_bytes = compressed_path.stat().st_size
        os.chmod(compressed_path, 0o600)
        os.replace(compressed_path, output_path)
        os.chmod(output_path, 0o600)
        print(
            "sqlite-backup receipt:"
            f" source={source_path}"
            f" source_bytes={source_path.stat().st_size}"
            f" check={check}"
            f" verdict={verdict}"
            f" check_seconds={check_seconds:.1f}"
            f" archive={output_path}"
            f" archive_bytes={archive_bytes}"
            " archive_check=zstd-t:ok"
            " restore_check=zstd-t:ok"
            f" source_open={check}:{verdict}"
            " structural_check=ok"
            f" compress_seconds={compress_seconds:.1f}"
        )
    finally:
        if target is not None:
            target.close()
        if source is not None:
            source.close()
        scratch.cleanup()


def verify_immutable_source(source_path: Path, check_budget_seconds: float) -> None:
    source_path = source_path.resolve(strict=True)
    wal_path = Path(f"{source_path}-wal")
    if wal_path.exists() and wal_path.stat().st_size > 0:
        raise RuntimeError("immutable SQLite source must not have a WAL")
    source_bytes = source_path.stat().st_size
    source = sqlite3.connect(
        source_path.resolve(strict=True).as_uri() + "?mode=ro&immutable=1", uri=True, timeout=5.0
    )
    try:
        source.execute(f"PRAGMA mmap_size={source_bytes}")
        started = time.monotonic()
        check, verdict = check_immutable_snapshot(
            source, started + check_budget_seconds, mode="structural"
        )
        print(
            "sqlite-backup verification receipt:"
            f" source={source_path} source_bytes={source_bytes}"
            f" check={check} verdict={verdict}"
            f" check_seconds={time.monotonic() - started:.1f}"
            " structural_check=ok",
            flush=True,
        )
    finally:
        source.close()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path, nargs="?")
    parser.add_argument(
        "--verify-only",
        action="store_true",
        help="check a frozen WAL-free source without publishing a backup",
    )
    parser.add_argument(
        "--immutable-source",
        action="store_true",
        help="compress a verified WAL-free filesystem snapshot without copying it",
    )
    parser.add_argument(
        "--acquire-budget-seconds",
        type=float,
        default=300.0,
        help="maximum seconds for native live-source snapshot acquisition",
    )
    parser.add_argument(
        "--check-budget-seconds",
        type=float,
        default=0.0,
        help=(
            "fail instead of publishing when the integrity walk outlasts this"
            " many seconds (0 leaves it unbounded)"
        ),
    )
    parser.add_argument(
        "--check-mode",
        choices=("structural", "header"),
        default="structural",
        help="structural page walk or a qualified, bounded schema/header check",
    )
    args = parser.parse_args()
    if not math.isfinite(args.acquire_budget_seconds) or args.acquire_budget_seconds <= 0:
        parser.error("--acquire-budget-seconds must be positive")
    if args.verify_only:
        if not args.immutable_source or args.output is not None:
            parser.error("--verify-only requires --immutable-source and no output")
        if args.check_mode != "structural" or args.check_budget_seconds <= 0:
            parser.error("--verify-only requires structural mode and a positive check budget")
    elif args.output is None:
        parser.error("output is required unless --verify-only is used")
    if args.check_mode == "header" and not args.immutable_source:
        parser.error("--check-mode header requires --immutable-source")
    if args.check_mode == "header" and args.check_budget_seconds:
        parser.error("--check-budget-seconds requires --check-mode structural")
    signal.signal(signal.SIGTERM, request_cancel)
    signal.signal(signal.SIGINT, request_cancel)
    try:
        with cancellation_wakeup():
            if args.verify_only:
                verify_immutable_source(args.source, args.check_budget_seconds)
            else:
                backup_database(
                    args.source,
                    args.output,
                    immutable_source=args.immutable_source,
                    check_budget_seconds=args.check_budget_seconds,
                    check_mode=args.check_mode,
                    acquire_budget_seconds=args.acquire_budget_seconds,
                )
    except BackupCancelled:
        print("SQLite backup cancelled", file=sys.stderr)
        return 143
    except (OSError, RuntimeError, sqlite3.Error, subprocess.CalledProcessError) as error:
        print(f"SQLite backup failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
