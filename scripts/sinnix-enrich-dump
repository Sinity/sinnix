#!/usr/bin/env bash
# @sinnix-package
# description: Enrichment loop v0 — dump estate state, run the enrichment-pass skill, write versioned outputs
# runtimeInputs: bash coreutils findutils gnugrep jq claude-code atuin @beads systemd
set -euo pipefail

# timer -> state-dump -> `claude -p` (enrichment-pass skill) -> versioned
# outputs under /realm/data/derived/enrichment/.
#
# Single-writer invariant: writes only the output root and the watermark at
# /realm/state/enrichment/; never polylogue's or sinex's stores.
#
# Every input is optional. Absent or empty means nothing changed since the
# watermark, not a fault -- the skill tells the model to treat it that way.

WATERMARK_FILE="/realm/state/enrichment/last-run"
OUTPUT_ROOT="/realm/data/derived/enrichment"

# Pinned rather than inherited from interactive settings. Opus by measurement,
# not default: on an identical bundle it raised 7 flags to Sonnet's 5 and
# Haiku's 1, and was the only tier to catch this script's own dead lynchpin
# path and failing steering export.
MODEL="${SINNIX_ENRICH_MODEL:-opus}"

NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
FROM_ISO=""
if [[ -f "$WATERMARK_FILE" ]]; then
  FROM_ISO="$(cat "$WATERMARK_FILE")"
fi
# One absolute instant drives every filter; unlike "24 hours ago" it is also
# usable as a jq comparand.
SINCE_ISO="${FROM_ISO:-$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)}"

BUNDLE="$(mktemp -d)"
trap 'rm -rf "$BUNDLE"' EXIT

# Computed up front so the signal handler can write a marker into it:
# TimeoutStartSec kills used to leave no trace at all.
OUT_DIR="$OUTPUT_ROOT/$(date -u +%Y-%m-%d)/$(date -u +%H%M)"

write_failure() {
  mkdir -p "$OUT_DIR"
  jq -n \
    --arg schema "sinnix-enrichment-v1-failure" \
    --arg generated_at "$NOW_ISO" \
    --arg model "$MODEL" \
    --arg error "$1" \
    --argjson result "${2:-null}" \
    '{schema: $schema, generated_at: $generated_at, model: $model, error: $error, result: $result}' \
    >"$OUT_DIR/failure.json"
}

on_signal() {
  write_failure "terminated by signal before completing (TimeoutStartSec or manual stop)"
  echo "sinnix-enrich-dump: terminated, marker written to $OUT_DIR/failure.json" >&2
  exit 143
}
trap on_signal TERM INT

# ---------------------------------------------------------------- assemble

# Health slice, not the whole 125KB inventory. The contract only asks what the
# inventory flags as unhealthy, and shipping it whole is most of the ~579k-token
# floor a pass costs even on an empty window. The full file stays readable at
# /etc for drill-down.
if [[ -r /etc/sinnix/runtime-inventory.json ]]; then
  jq '{
        source: "/etc/sinnix/runtime-inventory.json",
        note: "health slice; read the source path for full detail",
        acknowledged_down: [ .surfaces | to_entries[]
                             | select(.value.acknowledged.down == true)
                             | {name: .key, unit: .value.unit, acknowledged: .value.acknowledged} ],
        surfaces: [ .surfaces | to_entries[]
                    | {name: .key, unit: .value.unit, manager: .value.manager,
                       resourceClass: .value.resourceClass,
                       captures: [ (.value.captures // [])[] | {name, path, staleAfterSeconds, eventDriven} ]} ]
      }' /etc/sinnix/runtime-inventory.json >"$BUNDLE/runtime-inventory.json" 2>/dev/null \
    || cp /etc/sinnix/runtime-inventory.json "$BUNDLE/runtime-inventory.json"
fi

# Absent inputs are normal; inputs that FAIL are not, and a bare `|| true`
# makes the two indistinguishable. Record why each one is missing.
INPUT_ERRORS="$BUNDLE/.input-errors.jsonl"
: >"$INPUT_ERRORS"
note_input_error() {
  jq -nc --arg source "$1" --arg error "$2" '{source: $source, error: $error}' >>"$INPUT_ERRORS"
}

# bd rewrites its own store on every call (dolt reimport, lockfile,
# last-touched), so the unit needs /realm/state/steering writable too.
if [[ -d /realm/state/steering/.beads ]]; then
  if ! bd_err="$(bd export -C /realm/state/steering -o "$BUNDLE/steering-export.jsonl" 2>&1)"; then
    note_input_error steering-export "$(tail -c 500 <<<"$bd_err")"
    rm -f "$BUNDLE/steering-export.jsonl"
  fi
fi

if command -v atuin >/dev/null 2>&1; then
  atuin search --after "$SINCE_ISO" "" >"$BUNDLE/atuin-tail.txt" 2>/dev/null || true
fi

# Polylogue hook-spool deltas. mtime selects candidate files; the per-record
# timestamp then selects the rows actually in-window (mtime alone over-read
# this ~33x). Uncapped -- the model reads by offset, so a wide window costs
# turns rather than truncated evidence.
POLYLOGUE_HOOKS_DIR="/realm/state/polylogue/hooks"
if [[ -d "$POLYLOGUE_HOOKS_DIR" ]]; then
  : >"$BUNDLE/polylogue-hooks.jsonl"
  find "$POLYLOGUE_HOOKS_DIR" -name '*.jsonl' -newermt "$SINCE_ISO" -exec cat {} + 2>/dev/null \
    | jq -c --arg s "$SINCE_ISO" 'select((.timestamp // "") >= $s)' 2>/dev/null \
      >>"$BUNDLE/polylogue-hooks.jsonl" || true
fi

# Raw Claude/Codex session JSONL deltas, filtered per-record like the hook
# spool. Files with nothing in-window are dropped rather than implying coverage.
SESSIONS_DIR="$HOME/.claude/projects"
if [[ -d "$SESSIONS_DIR" ]]; then
  mkdir -p "$BUNDLE/session-deltas"
  find "$SESSIONS_DIR" -name '*.jsonl' -newermt "$SINCE_ISO" -print0 2>/dev/null \
    | while IFS= read -r -d '' f; do
      dest="$BUNDLE/session-deltas/$(basename "$(dirname "$f")")-$(basename "$f")"
      jq -c --arg s "$SINCE_ISO" 'select((.timestamp // "") >= $s)' "$f" \
        >"$dest" 2>/dev/null || true
      [[ -s "$dest" ]] || rm -f "$dest"
    done
fi

# Lynchpin current-state product, only if fresh (<24h). Both known output
# locations, and markdown as well as json -- the packs directory has only ever
# held .md, so globbing .json alone could never match anything.
LYNCHPIN_DIRS=(
  "/realm/project/sinity-lynchpin/.agent/scratch/current-state-packs"
  "/realm/project/sinity-lynchpin/.lynchpin/generated"
)
latest=""
for d in "${LYNCHPIN_DIRS[@]}"; do
  [[ -d "$d" ]] || continue
  candidate="$(find "$d" -maxdepth 1 -type f \( -name '*current-state*.md' -o -name '*current-state*.json' -o -name '*-pack.md' \) \
    -newermt "$SINCE_ISO" -print 2>/dev/null | sort | tail -1)"
  [[ -n "$candidate" ]] && latest="$candidate"
done
if [[ -n "$latest" ]]; then
  cp "$latest" "$BUNDLE/lynchpin-current-state.${latest##*.}"
else
  note_input_error lynchpin-current-state "no current-state product newer than $SINCE_ISO in: ${LYNCHPIN_DIRS[*]}"
fi

# Uncapped. A 500-line tail meant one repeated message could consume the whole
# input and hide every other warning in the window -- which it did.
journalctl -p warning --since="$SINCE_ISO" --no-pager \
  >"$BUNDLE/journald-warnings.txt" 2>/dev/null || true

# ------------------------------------------------------------------ process

PROMPT="You are running the sinnix enrichment pass (sinnix-jfiy.2). Load the \
'enrichment-pass' skill (dots/_ai/skills/enrichment-pass/SKILL.md, linked at \
~/.config/claude/skills/enrichment-pass) via the Skill tool and follow its \
contract exactly: read whatever bundle files are present in \
$BUNDLE (some may be absent or empty -- that means no change since the \
watermark, not an error), then WRITE (using your Write tool) exactly two \
files into that same directory: narrative.md and state-delta.json (schema \
sinnix-enrichment-v1, per the skill). Window: from=${FROM_ISO:-null} to=$NOW_ISO. \
Do not write anywhere else on the filesystem."

# Separate streams so the result JSON stays parseable. Task is denied: the
# contract needs no delegation, and subagent fan-out makes the pass unbounded.
RESULT_JSON="$BUNDLE/.claude-result.json"
STDERR_LOG="$BUNDLE/.claude-stderr.log"
FAILED=0
env -u ANTHROPIC_API_KEY claude -p "$PROMPT" \
  --model "$MODEL" \
  --disallowed-tools Task \
  --output-format json \
  >"$RESULT_JSON" 2>"$STDERR_LOG" || FAILED=1

# Both paths account for usage: a pass costs quota whether or not it produces.
usage_json() {
  jq -n --slurpfile r "$RESULT_JSON" '
    ($r[0] // {}) as $x |
    ($x.modelUsage // {}) as $m |
    {
      session_id: $x.session_id,
      num_turns: $x.num_turns,
      duration_ms: $x.duration_ms,
      duration_api_ms: $x.duration_api_ms,
      total_cost_usd: $x.total_cost_usd,
      per_model: ($m | with_entries(.value |= {
        input: (.inputTokens // 0),
        output: (.outputTokens // 0),
        cache_read: (.cacheReadInputTokens // 0),
        cache_create: (.cacheCreationInputTokens // 0)
      })),
      total_tokens: ([ $m[] | (.inputTokens // 0) + (.outputTokens // 0)
                       + (.cacheReadInputTokens // 0) + (.cacheCreationInputTokens // 0) ]
                     | add // 0)
    }' 2>/dev/null || echo 'null'
}

fail_with() {
  write_failure "$1" "$(jq -n \
    --slurpfile r "$RESULT_JSON" \
    --arg stderr "$(tail -c 4000 "$STDERR_LOG" 2>/dev/null || true)" \
    --argjson usage "$(usage_json)" \
    '{result: ($r[0] // null), stderr: $stderr, usage: $usage}' 2>/dev/null || echo null)"
  echo "sinnix-enrich-dump: FAILED ($1), marker written to $OUT_DIR/failure.json" >&2
  exit 1
}

mkdir -p "$OUT_DIR"

if [[ "$FAILED" -eq 1 ]] || [[ ! -s "$BUNDLE/narrative.md" ]] || [[ ! -s "$BUNDLE/state-delta.json" ]]; then
  # Failure honesty: a failed or incomplete pass must leave a visible
  # marker row, never silence.
  fail_with "claude -p invocation failed or did not produce both required outputs"
fi

if ! jq -e '.schema == "sinnix-enrichment-v1" and (.inputs | type == "array")' \
  "$BUNDLE/state-delta.json" >/dev/null 2>&1; then
  fail_with "state-delta.json failed schema validation"
fi

cp "$BUNDLE/narrative.md" "$OUT_DIR/narrative.md"
cp "$BUNDLE/state-delta.json" "$OUT_DIR/state-delta.json"

# Pointers and cost, not copies -- the raw sources are durable elsewhere.
# `du -sb` rather than `stat -c%s` so session-deltas reports its contents
# rather than its directory entry.
INPUTS_JSON="$(
  for f in "$BUNDLE"/*; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f")"
    case "$name" in
      narrative.md | state-delta.json) continue ;;
    esac
    size="$(du -sb "$f" 2>/dev/null | cut -f1)"
    jq -n --arg n "$name" --argjson b "${size:-0}" '{($n): {bytes: $b}}'
  done | jq -s 'add // {}'
)"

jq -n \
  --arg schema "sinnix-enrichment-provenance-v1" \
  --arg generated_at "$NOW_ISO" \
  --arg model "$MODEL" \
  --arg window_from "${FROM_ISO:-}" \
  --arg window_to "$NOW_ISO" \
  --argjson inputs "${INPUTS_JSON:-{\}}" \
  --argjson input_errors "$(jq -sc '.' "$INPUT_ERRORS" 2>/dev/null || echo '[]')" \
  --argjson usage "$(usage_json)" \
  '{
     schema: $schema,
     generated_at: $generated_at,
     model: $model,
     window: { from: (if $window_from == "" then null else $window_from end), to: $window_to },
     inputs: $inputs,
     input_errors: $input_errors,
     usage: $usage
   }' >"$OUT_DIR/provenance.json"

mkdir -p "$(dirname "$WATERMARK_FILE")"
echo "$NOW_ISO" >"$WATERMARK_FILE"

tokens="$(jq -r '.usage.total_tokens // "?"' "$OUT_DIR/provenance.json" 2>/dev/null || echo '?')"
echo "sinnix-enrich-dump: wrote $OUT_DIR (model=$MODEL tokens=$tokens, watermark advanced to $NOW_ISO)"
