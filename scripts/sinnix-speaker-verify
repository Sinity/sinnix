#!/usr/bin/env python3
# @sinnix-package
# description: Speaker verification (enroll/score) via SpeechBrain ECAPA-TDNN embeddings, built on mke's diarization substrate
# pythonPackages: speechbrain torchaudio numpy @sinnix-lib

"""sinnix-speaker-verify: enrollment, scoring, and held-out calibration.

DESIGN NOTE, load-bearing: per the bead's own explicit framing, this is
FRICTION AND ATTRIBUTION, never an authorization boundary -- replay and
voice-cloning (this system runs Kokoro TTS locally, F5-TTS is on the sinnix-w9l
roadmap) both defeat voice as an authenticator. Callers must tier actions by
blast radius and never gate a destructive/irreversible action on this score
alone. See sinnix-7oly for the full tiering design.

Usage:
  sinnix-speaker-verify enroll <audio.wav> [--name operator]
  sinnix-speaker-verify score <audio.wav> [--name operator]
  sinnix-speaker-verify calibrate --enrollment DIR --genuine DIR
      --impostor DIR --cohort DIR --output calibration.json
  sinnix-speaker-verify list

Enrollment centroid stored at /realm/state/speaker-verify/<name>.json
(embedding vector + metadata, not raw audio).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import sys
from pathlib import Path
from stat import S_ISREG

from sinnix_lib.atomic import atomic_publish

STORE_DIR = Path("/realm/state/speaker-verify")
AUDIO_SUFFIXES = {".wav", ".flac", ".ogg", ".mp3", ".m4a"}
CALIBRATION_VERSION = 2
CALIBRATION_METHOD = "symmetric AS-norm over held-out cohort"
EMBEDDING_METHOD = "mono-mean-resample-16000-ecapa-unit-mean-v1"
MODEL_SOURCE = "speechbrain/spkrec-ecapa-voxceleb"
MODEL_REVISION = "0f99f2d0ebe89ac095bcc5903c4dd8f72b367286"


def _enrollment_path(name: str) -> Path:
    if not isinstance(name, str) or not name or name in {".", ".."} or Path(name).name != name:
        raise ValueError("enrollment name must be a non-special basename")
    return STORE_DIR / f"{name}.json"


def _load_model():
    # Deferred import: keep --help fast, and let callers without the model
    # deps installed still see usage.
    from speechbrain.inference.speaker import EncoderClassifier
    from speechbrain.utils.fetching import FetchConfig

    return EncoderClassifier.from_hparams(
        source=MODEL_SOURCE,
        savedir="/realm/state/speaker-verify/.model-cache",
        # Check existing savedir links against the immutable revision too;
        # otherwise SpeechBrain can reuse files from a different revision.
        fetch_config=FetchConfig(revision=MODEL_REVISION, allow_updates=True),
    )


def _embed(model, audio_path: str):
    import torchaudio

    signal, fs = torchaudio.load(audio_path)
    if signal.shape[0] > 1:
        signal = signal.mean(dim=0, keepdim=True)
    if fs != 16000:
        signal = torchaudio.functional.resample(signal, fs, 16000)
    emb = model.encode_batch(signal)
    return emb.squeeze().detach().cpu().numpy()


def _unit(vector):
    import numpy as np

    vector = np.asarray(vector, dtype=float)
    norm = np.linalg.norm(vector)
    if not np.isfinite(norm) or norm == 0:
        raise ValueError("embedding has no finite non-zero norm")
    return vector / norm


def _model_identity():
    # Bump the method when preprocessing or centroid construction changes.
    return {"source": MODEL_SOURCE, "revision": MODEL_REVISION, "method": EMBEDDING_METHOD}


def _centroid(model, paths):
    import numpy as np

    return _unit(np.mean([_unit(_embed(model, str(path))) for path in sorted(paths)], axis=0))


def _centroid_digest(vector):
    import numpy as np

    # Hash the exact stored normalized vector, without normalizing it again:
    # repeated floating-point normalization can change its least significant bits.
    value = np.asarray(vector, dtype="<f8")
    if value.ndim != 1 or not value.size or not np.isfinite(value).all():
        raise ValueError("calibration centroid must be a finite vector")
    return hashlib.sha256(value.tobytes()).hexdigest()


def _probability(value, label):
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or not 0 <= value <= 1:
        raise ValueError(f"calibration {label} must be a finite probability")
    return float(value)


def _calibration_cohort(report, enrolled):
    import numpy as np

    if not isinstance(report, dict) or report.get("version") != CALIBRATION_VERSION or report.get("method") != CALIBRATION_METHOD:
        raise ValueError("calibration report has an unsupported schema or method; regenerate it")
    identity = _model_identity()
    if report.get("model") != identity or enrolled.get("model") != identity:
        raise ValueError("calibration model/method does not match enrollment; re-enroll and recalibrate")
    digest = _centroid_digest(enrolled["centroid"])
    if enrolled.get("centroid_sha256") != digest or report.get("centroid_sha256") != digest:
        raise ValueError("calibration does not match the selected enrollment centroid")
    try:
        trials = report["trial_scores"]
        counts = report["counts"]
        if type(counts["enrollment"]) is not int or counts["enrollment"] < 2:
            raise ValueError("calibration enrollment count is invalid")
        for group in ("genuine", "impostor"):
            values = trials[group]
            if not isinstance(values, list) or len(values) < 2 or counts[group] != len(values):
                raise ValueError("calibration trial counts are invalid")
            if any(isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) for v in values):
                raise ValueError("calibration trials must contain finite scores")
            summary = {"min": min(values), "mean": float(np.mean(values)), "max": max(values)}
            if report[group] != summary or any(isinstance(v, bool) for v in report[group].values()):
                raise ValueError("calibration score summary does not match its trials")
        cohort = report["cohort_embeddings"]
        if not isinstance(cohort, list) or len(cohort) < 3 or counts["cohort"] != len(cohort):
            raise ValueError("calibration cohort count is invalid")
        if any(np.asarray(item).shape != np.asarray(enrolled["centroid"]).shape for item in cohort):
            raise ValueError("calibration cohort dimensions do not match enrollment")
        cohort = [_unit(item) for item in cohort]
        maximum = _probability(report["max_eer"], "max_eer")
        stats = _eer(trials["genuine"], trials["impostor"])
        expected = {"equal_error_rate": stats["eer"], "false_accept_rate": stats["far"],
                    "false_reject_rate": stats["frr"], "threshold": stats["threshold"],
                    "calibration_error_brier": _brier(trials["genuine"], trials["impostor"], stats["threshold"])}
        for name, value in expected.items():
            supplied = report[name]
            if isinstance(supplied, bool) or not isinstance(supplied, (int, float)) or supplied != value:
                raise ValueError(f"calibration metric {name} does not match its trials")
    except (KeyError, TypeError, OverflowError) as error:
        raise ValueError("calibration report is incomplete or malformed") from error
    # supports_attribution is a display projection, never an input to this gate.
    return cohort if stats["eer"] <= maximum else None


def _audio_files(directory: str):
    path = Path(directory)
    if not path.is_dir():
        raise ValueError(f"not an audio directory: {path}")

    def scan_error(error):
        raise error

    files = []
    for parent, _subdirectories, names in os.walk(path, onerror=scan_error, followlinks=False):
        for name in names:
            candidate = Path(parent) / name
            if candidate.suffix.lower() in AUDIO_SUFFIXES and S_ISREG(candidate.stat().st_mode):
                files.append(candidate)
    files.sort()
    if not files:
        raise ValueError(f"audio directory is empty: {path}")
    return files


def _assert_disjoint(groups):
    seen = {}
    for label, paths in groups.items():
        for path in paths:
            metadata = path.stat()
            identity = (metadata.st_dev, metadata.st_ino)
            previous = seen.get(identity)
            if previous:
                raise ValueError(f"audio file is reused by {previous} and {label}: {path}")
            seen[identity] = label


def _as_norm(target, probe, cohort):
    import numpy as np

    target = _unit(target)
    probe = _unit(probe)
    cohort = [_unit(item) for item in cohort]
    raw = float(np.dot(target, probe))
    target_scores = np.array([np.dot(target, item) for item in cohort])
    probe_scores = np.array([np.dot(probe, item) for item in cohort])

    def zscore(value, scores):
        deviation = float(np.std(scores))
        # A constant cohort is not evidence for normalization. Preserve the
        # raw score and make the resulting report fail its support gate.
        return None if deviation == 0 else (value - float(np.mean(scores))) / deviation

    target_z = zscore(raw, target_scores)
    probe_z = zscore(raw, probe_scores)
    normalized = None if target_z is None or probe_z is None else (target_z + probe_z) / 2
    return raw, normalized


def _eer(genuine, impostor):
    import numpy as np

    scores = sorted(set(genuine + impostor), reverse=True)
    candidates = [float("inf"), *scores, float("-inf")]
    best = None
    for threshold in candidates:
        far = sum(score >= threshold for score in impostor) / len(impostor)
        frr = sum(score < threshold for score in genuine) / len(genuine)
        candidate = (abs(far - frr), (far + frr) / 2, threshold, far, frr)
        if best is None or candidate < best:
            best = candidate
    _, eer, threshold, far, frr = best
    return {"eer": eer, "threshold": threshold, "far": far, "frr": frr}


def _brier(genuine, impostor, threshold):
    # Brier score is a bounded calibration error for the hard decisions at the
    # selected operating threshold. Logistic calibration would overfit the
    # small held-out sets this command is intended to expose.
    errors = [(int(score >= threshold) - 1) ** 2 for score in genuine]
    errors += [(int(score >= threshold) - 0) ** 2 for score in impostor]
    return sum(errors) / len(errors)


def cmd_enroll(args: argparse.Namespace) -> int:
    model = _load_model()
    audio_files = sorted(args.audio)  # snapshot before any mutation
    centroid = _centroid(model, audio_files)

    STORE_DIR.mkdir(parents=True, exist_ok=True)
    out = _enrollment_path(args.name)
    atomic_publish(
        out,
        json.dumps(
            {
                "name": args.name,
                "centroid": centroid.tolist(),
                "centroid_sha256": _centroid_digest(centroid),
                "model": _model_identity(),
                "n_samples": len(audio_files),
                "source_files": audio_files,
            }
        ).encode(),
        fsync=True,
        mode=0o600,
    )
    print(f"enrolled '{args.name}' from {len(audio_files)} sample(s) -> {out}")
    return 0


def cmd_score(args: argparse.Namespace) -> int:
    import numpy as np

    enrolled_path = _enrollment_path(args.name)
    if not enrolled_path.exists():
        print(f"error: no enrollment for '{args.name}' -- run enroll first", file=sys.stderr)
        return 1
    enrolled = json.loads(enrolled_path.read_text())
    centroid = _unit(enrolled["centroid"])
    cohort = None
    if args.calibration:
        cohort = _calibration_cohort(json.loads(Path(args.calibration).read_text()), enrolled)

    model = _load_model()
    emb = _embed(model, args.audio)
    emb = _unit(emb)

    similarity = float(np.dot(centroid, emb))
    result = {
                "name": args.name,
                "audio": args.audio,
                "cosine_similarity": round(similarity, 4),
                "note": "friction/attribution signal only -- never an authorization boundary, see sinnix-7oly",
            }
    if cohort is not None:
        normalized = _as_norm(centroid, emb, cohort)[1]
        if normalized is None:
            raise ValueError("calibration cohort has zero deviation for this probe")
        result["attribution_score"] = round(normalized, 4)
    print(json.dumps(result))
    return 0


def cmd_calibrate(args: argparse.Namespace) -> int:
    import numpy as np

    maximum = _probability(args.max_eer, "max_eer")
    groups = {
        label: _audio_files(directory)
        for label, directory in {
            "enrollment": args.enrollment,
            "genuine": args.genuine,
            "impostor": args.impostor,
            "cohort": args.cohort,
        }.items()
    }
    _assert_disjoint(groups)
    if (
        len(groups["enrollment"]) < 2
        or len(groups["genuine"]) < 2
        or len(groups["impostor"]) < 2
        or len(groups["cohort"]) < 3
    ):
        raise ValueError(
            "calibration requires at least 2 enrollment/genuine/impostor and 3 cohort clips"
        )

    model = _load_model()
    centroid = _centroid(model, groups["enrollment"])
    cohort_embeddings = [_unit(_embed(model, str(path))) for path in groups["cohort"]]

    def scores(paths):
        return [_as_norm(centroid, _embed(model, str(path)), cohort_embeddings)[1] for path in paths]

    genuine = scores(groups["genuine"])
    impostor = scores(groups["impostor"])
    if any(value is None for value in genuine + impostor):
        raise ValueError("cohort standard deviation is zero; AS-norm is unavailable")
    eer = _eer(genuine, impostor)
    result = {
        "version": CALIBRATION_VERSION,
        "method": CALIBRATION_METHOD,
        "model": _model_identity(),
        "centroid_sha256": _centroid_digest(centroid),
        "max_eer": maximum,
        "trial_scores": {"genuine": genuine, "impostor": impostor},
        "counts": {label: len(paths) for label, paths in groups.items()},
        "genuine": {"min": min(genuine), "mean": float(np.mean(genuine)), "max": max(genuine)},
        "impostor": {"min": min(impostor), "mean": float(np.mean(impostor)), "max": max(impostor)},
        "equal_error_rate": eer["eer"],
        "threshold": eer["threshold"],
        "false_accept_rate": eer["far"],
        "false_reject_rate": eer["frr"],
        "calibration_error_brier": _brier(genuine, impostor, eer["threshold"]),
        "supports_attribution": eer["eer"] <= maximum,
        "cohort_embeddings": [item.tolist() for item in cohort_embeddings],
        "note": "attribution/friction only; never authorization",
    }
    atomic_publish(
        Path(args.output),
        (json.dumps(result, indent=2) + "\n").encode(),
        fsync=True,
        mode=0o600,
    )
    print(json.dumps({key: value for key, value in result.items() if key not in {"cohort_embeddings", "trial_scores"}}))
    return 0


def cmd_list(_: argparse.Namespace) -> int:
    if not STORE_DIR.exists():
        print("no enrollments")
        return 0
    for f in sorted(STORE_DIR.glob("*.json")):
        data = json.loads(f.read_text())
        print(f"{data['name']}: {data['n_samples']} sample(s), {f}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    enroll = sub.add_parser("enroll", help="enroll a voice from one or more audio files")
    enroll.add_argument("audio", nargs="+", help="audio file(s), any format torchaudio reads")
    enroll.add_argument("--name", default="operator")
    enroll.set_defaults(func=cmd_enroll)

    score = sub.add_parser("score", help="score an audio file against an enrolled voice")
    score.add_argument("audio")
    score.add_argument("--name", default="operator")
    score.add_argument("--calibration", help="apply a calibration report when it supports attribution")
    score.set_defaults(func=cmd_score)

    calibrate = sub.add_parser("calibrate", help="evaluate AS-norm on disjoint held-out trials")
    calibrate.add_argument("--enrollment", required=True, help="directory of enrollment clips")
    calibrate.add_argument("--genuine", required=True, help="held-out same-speaker clips")
    calibrate.add_argument("--impostor", required=True, help="held-out different-speaker clips")
    calibrate.add_argument("--cohort", required=True, help="unrelated clips used only for AS-norm")
    calibrate.add_argument("--output", required=True, help="calibration report JSON path")
    calibrate.add_argument("--max-eer", type=float, default=0.05)
    calibrate.set_defaults(func=cmd_calibrate)

    listp = sub.add_parser("list", help="list enrollments")
    listp.set_defaults(func=cmd_list)

    args = parser.parse_args()
    try:
        return args.func(args)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
