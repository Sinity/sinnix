#!/usr/bin/env bash
# @sinnix-package
# description: Disable ASBL (Automatic Screen Brightness Limiting) on monitors
# runtimeInputs: coreutils procps bc jq hyprland ddcutil
# asbl-no-moar - Prevent OLED/LCD ASBL by periodically pulsing screen brightness
#
# Usage: asbl-no-moar [start|stop|status|toggle|once] [options]
#
# Options:
#   -i, --interval SECS    Interval between pulses (default: 120)
#   -d, --duration SECS    Duration of each pulse (default: 0.05)
#   -v, --intensity MULT   Brightness multiplier (default: 1.25)
#   -m, --mode MODE        Pulse mode: ctm (works under HDR), brightness, dim, invert, ddc (default: ctm)
#   --restore-fp16         Restore Hyprland FP16 after invert pulse

set -euo pipefail

# Defaults
INTERVAL=120
DURATION=0.05
INTENSITY=1.5
BASELINE=1.25
MODE="ctm"
SHADER_FILE="/tmp/asbl-pulse.glsl"
RESTORE_FP16="${ASBL_RESTORE_FP16:-0}"

show_help() {
    cat << EOF
asbl-no-moar - OLED/LCD ASBL reset tool

Usage: asbl-no-moar [start|stop|status|toggle|once] [options]

Commands:
  start     Start the background loop
  stop      Stop the running loop
  status    Check if the loop is running
  toggle    Toggle the loop
  once      Trigger a single pulse now

Options:
  -i, --interval SECS    Interval between pulses (Default: $INTERVAL)
  -d, --duration SECS    Pulse duration in seconds (Default: $DURATION)
  -v, --intensity MULT   Brightness multiplier for pulse (Default: $INTENSITY)
  -b, --baseline MULT    Baseline brightness multiplier (Default: $BASELINE)
  -m, --mode MODE        Mode: ctm, brightness, dim, invert, ddc (Default: $MODE)

DDC mode (sinnix-70eq, HYPOTHESIS -- untested whether this actually resets
the FO48U's ASBL timer, unlike the other modes which are known to work):
nudges VCP 0x10 (brightness) by 1 and back via ddcutil instead of a
compositor shader. Touches the panel's own brightness register rather than
faking it in the render pipeline, so there is no visible flash -- but each
ddcutil round-trip takes ~0.5-1.2s (two i2c transactions), so keep the
interval well above that and expect brief real (not synthetic) brightness
motion. Requires i2c-dev loaded and DDC/CI support (see hosts/sinnix-prime/
display.nix). NOT wired into any automatic timer/service by default --
invoke manually (\`asbl-no-moar once -m ddc\`) to test before trusting it.
      --restore-fp16     Restore Hyprland render:use_fp16 after invert pulse

Environment:
  ASBL_INTERVAL, ASBL_DURATION, ASBL_INTENSITY, ASBL_BASELINE, ASBL_MODE, ASBL_RESTORE_FP16
EOF
}

# Load from environment if set
INTERVAL="${ASBL_INTERVAL:-$INTERVAL}"
DURATION="${ASBL_DURATION:-$DURATION}"
INTENSITY="${ASBL_INTENSITY:-$INTENSITY}"
BASELINE="${ASBL_BASELINE:-$BASELINE}"
MODE="${ASBL_MODE:-$MODE}"

# Parse args
CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--interval) INTERVAL="$2"; shift 2 ;;
        -d|--duration) DURATION="$2"; shift 2 ;;
        -v|--intensity) INTENSITY="$2"; shift 2 ;;
        -b|--baseline) BASELINE="$2"; shift 2 ;;
        -m|--mode) MODE="$2"; shift 2 ;;
        --restore-fp16) RESTORE_FP16=1; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# Ensure INTENSITY and BASELINE are floats for GLSL (Handle both . and , then force . via LC_NUMERIC=C)
INTENSITY=$(echo "$INTENSITY" | tr ',' '.')
INTENSITY=$(LC_NUMERIC=C printf "%.2f" "$INTENSITY")
BASELINE=$(echo "$BASELINE" | tr ',' '.')
BASELINE=$(LC_NUMERIC=C printf "%.2f" "$BASELINE")

write_brightness_shader() {
    cat > "$SHADER_FILE" << EOF
#version 300 es
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 color = texture(tex, v_texcoord);
    fragColor = vec4((color.rgb * $INTENSITY) + 0.01, color.a);
}
EOF
}

write_baseline_shader() {
    cat > "$SHADER_FILE" << EOF
#version 300 es
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 color = texture(tex, v_texcoord);
    fragColor = vec4((color.rgb * $BASELINE) + 0.01, color.a);
}
EOF
}

write_dim_shader() {
    local dim_factor
    dim_factor=$(LC_NUMERIC=C printf "%.2f" "$(echo "scale=4; $BASELINE / $INTENSITY" | bc)")
    cat > "$SHADER_FILE" << EOF
#version 300 es
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 color = texture(tex, v_texcoord);
    fragColor = vec4((color.rgb * $dim_factor) + 0.01, color.a);
}
EOF
}

write_overbrighten_shader() {
    local bright_factor
    bright_factor=$(LC_NUMERIC=C printf "%.2f" "$(echo "scale=4; $BASELINE * $INTENSITY" | bc)")
    cat > "$SHADER_FILE" << EOF
#version 300 es
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 color = texture(tex, v_texcoord);
    fragColor = vec4((color.rgb * $bright_factor) + 0.01, color.a);
}
EOF
}

write_invert_shader() {
    cat > "$SHADER_FILE" << EOF
#version 300 es
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 color = texture(tex, v_texcoord);
    fragColor = vec4(1.0 - color.rgb, color.a);
}
EOF
}

pulse() {
    local half_duration
    half_duration=$(echo "scale=4; $DURATION / 2" | bc)
    
    case "$MODE" in
        brightness)
            # Phase 1: Dim (baseline / intensity)
            write_dim_shader
            hyprctl keyword decoration:screen_shader "$SHADER_FILE" >/dev/null 2>&1
            sleep "$half_duration"
            
            # Phase 2: Overbrighten (baseline * intensity)
            write_overbrighten_shader
            hyprctl keyword decoration:screen_shader "$SHADER_FILE" >/dev/null 2>&1
            sleep "$half_duration"
            
            # Phase 3: Return to baseline
            write_baseline_shader
            hyprctl keyword decoration:screen_shader "$SHADER_FILE" >/dev/null 2>&1
            ;;
        dim)
            local current
            current=$(hyprctl getoption decoration:dim_strength -j | jq '.float')
            hyprctl keyword decoration:dim_strength "$INTENSITY" >/dev/null 2>&1
            sleep "$DURATION"
            hyprctl keyword decoration:dim_strength "$current" >/dev/null 2>&1
            ;;
        invert)
            local original_use_fp16
            original_use_fp16=$(hyprctl getoption render:use_fp16 -j 2>/dev/null | jq -r '.int // empty' 2>/dev/null || true)
            cleanup_invert() {
                hyprctl keyword decoration:screen_shader "" >/dev/null 2>&1 || true
                if [[ "$RESTORE_FP16" == "1" && -n "${original_use_fp16:-}" && "$original_use_fp16" != "0" ]]; then
                    hyprctl keyword render:use_fp16 "$original_use_fp16" >/dev/null 2>&1 || true
                fi
            }
            trap cleanup_invert RETURN

            if [[ -n "$original_use_fp16" && "$original_use_fp16" != "0" ]]; then
                hyprctl keyword render:use_fp16 0 >/dev/null 2>&1
            fi
            write_invert_shader
            hyprctl keyword decoration:screen_shader "$SHADER_FILE" >/dev/null 2>&1
            sleep "$DURATION"
            cleanup_invert
            trap - RETURN
            ;;
        ctm)
            # The only pulse mode measured to actually work on this display.
            #
            # `brightness` and `invert` drive decoration:screen_shader, which
            # is OFF the render path while this host runs cm = "hdr" with
            # render:non_shader_cm = 3 -- measured at 0.08% output change, i.e.
            # nothing (see modules/features/desktop/color-temperature.nix).
            # `ddc` writes VCP 0x10 +/-1, a 1% step that is both imperceptible
            # and slower than its own duration; measured 2026-08-13, the
            # panel's VCP read 50 before and after, so F3 was a silent no-op.
            #
            # hyprsunset applies a colour transform matrix through
            # hyprland-ctm-control-v1, which composes with HDR instead of
            # being bypassed by it -- the same mechanism that visibly grades
            # the screen in the evening. Swinging gamma through it produces a
            # real luminance change at scanout, which is what an ASBL reset
            # needs. It also does not touch captures: a CTM applies after
            # screencopy, so this pulse cannot stain screenshots or the
            # capture-screen recordings the way a shader flash would.
            local original_gamma
            original_gamma=$(hyprctl hyprsunset gamma 2>/dev/null | tr -cd '0-9')
            if [[ -z "$original_gamma" ]]; then
                echo "asbl-no-moar: ctm mode -- hyprsunset not answering, skipping pulse" >&2
                return 0
            fi
            # Restore even if interrupted; leaving the panel dark would be a
            # far worse failure than not pulsing at all.
            restore_gamma() { hyprctl hyprsunset gamma "$original_gamma" >/dev/null 2>&1 || true; }
            trap restore_gamma RETURN INT TERM
            hyprctl hyprsunset gamma 40 >/dev/null 2>&1
            sleep "$half_duration"
            hyprctl hyprsunset gamma 100 >/dev/null 2>&1
            sleep "$half_duration"
            restore_gamma
            trap - RETURN INT TERM
            ;;
        ddc)
            # sinnix-70eq: nudge the panel's real brightness register instead
            # of faking it in the render pipeline. Read the current setpoint
            # first rather than assuming 50 -- restoring to a stale baseline
            # would leave the panel dimmer/brighter than the operator set it.
            # This bare $4 parse is correct ONLY because 0x10 is a continuous
            # code, whose --brief line is "VCP 10 C 50 100" ($4 = setpoint).
            # Simple-non-continuous codes emit hex instead ("VCP D6 SNC x01"),
            # so do not generalise this into a shared read_vcp helper without
            # the hex branch that capture-monitor.nix carries.
            local current_vcp10
            current_vcp10=$(ddcutil getvcp 10 --brief 2>/dev/null | awk '{print $4}')
            if [[ -z "$current_vcp10" ]]; then
                echo "asbl-no-moar: ddc mode -- could not read VCP 0x10, skipping pulse" >&2
                return 0
            fi
            local nudged=$((current_vcp10 >= 100 ? current_vcp10 - 1 : current_vcp10 + 1))
            ddcutil setvcp 10 "$nudged" >/dev/null 2>&1 || true
            sleep "$DURATION"
            ddcutil setvcp 10 "$current_vcp10" >/dev/null 2>&1 || true
            ;;
    esac
}

is_running() {
    pgrep -f "asbl-no-moar loop" >/dev/null
}

case "$CMD" in
    start)
        if is_running; then
            echo "asbl-no-moar is already running."
            exit 0
        fi
        echo "Starting ASBL reset loop ($MODE mode, ${INTERVAL}s interval)"
        # Export vars for the loop process
        export ASBL_INTERVAL="$INTERVAL" ASBL_DURATION="$DURATION" ASBL_INTENSITY="$INTENSITY" ASBL_BASELINE="$BASELINE" ASBL_MODE="$MODE"
        "$0" loop &
        disown
        ;;
    loop)
        while true; do
            pulse
            sleep "$INTERVAL"
        done
        ;;
    stop)
        if pkill -f "asbl-no-moar loop"; then
            echo "ASBL reset loop stopped."
            hyprctl keyword decoration:screen_shader "" >/dev/null 2>&1
        else
            echo "asbl-no-moar was not running."
        fi
        ;;
    status)
        if is_running; then
            echo "asbl-no-moar: RUNNING (Mode: $MODE, Interval: ${INTERVAL}s)"
        else
            echo "asbl-no-moar: STOPPED"
        fi
        ;;
    toggle)
        if is_running; then "$0" stop; else "$0" start -i "$INTERVAL" -d "$DURATION" -v "$INTENSITY" -b "$BASELINE" -m "$MODE"; fi
        ;;
    once)
        pulse
        ;;
    help)
        show_help
        ;;
    *)
        echo "Unknown command: $CMD"
        show_help
        exit 1
        ;;
esac
