#!/usr/bin/env bash
# @sinnix-package
# description: Recover a missing npm-installed AI agent CLI in its per-tool state directory
# runtimeInputs: bash coreutils nodejs_22 git gnutar gzip which gcc util-linux
#
# Wrappers execute the installed binary directly after this helper returns.
# A healthy launch therefore does no locking, npm work, or launcher rewrite.
set -euo pipefail

if [ "$#" -ne 5 ]; then
  echo "usage: sinnix-agent-npm-bootstrap <state-dir-name> <npm-package> <binary-name> <runtime-path> <locked-tarball>" >&2
  exit 2
fi

state_dir_name=$1
npm_package=$2
binary_name=$3
runtime_path=$4
package_source=$5

STATE="$HOME/.local/state/$state_dir_name"
export npm_config_prefix="$STATE/npm"
export PATH="$runtime_path:$STATE/npm/bin:$PATH"
mkdir -p "$STATE/npm"

preserve_reify_entries() {
  local package_name package_parent candidate suffix relative recovery_dir=""

  package_name=${npm_package##*/}
  case "$npm_package" in
    @*/*) package_parent="$STATE/npm/lib/node_modules/${npm_package%/*}" ;;
    *) package_parent="$STATE/npm/lib/node_modules" ;;
  esac

  mkdir -p "$package_parent" "$STATE/npm/bin"
  for candidate in \
    "$package_parent/.$package_name-"* \
    "$package_parent/..$package_name-"* \
    "$STATE/npm/bin/.$binary_name-"*; do
    if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
      continue
    fi

    suffix=${candidate##*-}
    if [[ ! $suffix =~ ^[[:alnum:]]{8}$ ]]; then
      continue
    fi

    # An interrupted retirement can hold the only recoverable package copy.
    # Clear npm's collision path without discarding it, even if reinstall fails.
    if [ -z "$recovery_dir" ]; then
      install -d -m 0700 "$STATE/npm-recovery"
      recovery_dir=$(mktemp -d "$STATE/npm-recovery/attempt.XXXXXXXX")
    fi
    relative=${candidate#"$STATE/npm/"}
    install -d -m 0700 "$recovery_dir/$(dirname "$relative")"
    mv -- "$candidate" "$recovery_dir/$relative"
    echo "$binary_name: preserved interrupted npm retirement at $recovery_dir/$relative" >&2
  done
}

# A missing binary means an earlier install may have been interrupted after npm
# retired the old package. Only recovery takes the lock: ordinary launches must
# not contend with one another or rewrite a file another process is executing.
if [ -x "$STATE/npm/bin/$binary_name" ]; then
  exit 0
fi

exec 9>"$STATE/npm-bootstrap.lock"
if ! flock -w 120 9; then
  echo "$binary_name: timed out waiting for npm recovery; leave the existing installer intact and retry" >&2
  exit 1
fi

# Another wrapper may have completed recovery while this process waited.
if [ ! -x "$STATE/npm/bin/$binary_name" ]; then
  if [ ! -f "$package_source" ]; then
    echo "$binary_name: locked recovery tarball is unavailable: $package_source" >&2
    exit 1
  fi
  preserve_reify_entries
  echo "$binary_name: bootstrapping (npm install -g $package_source)..." >&2
  npm install -g "$package_source" >&2
fi
