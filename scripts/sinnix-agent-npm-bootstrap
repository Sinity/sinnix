#!/usr/bin/env bash
# @sinnix-package
# description: Recover a missing npm-installed AI agent CLI in its per-tool state directory
# runtimeInputs: bash coreutils nodejs_22 git gnutar gzip which gcc util-linux
#
# Wrappers execute the installed binary directly after this helper returns.
# A healthy launch therefore does no locking, npm work, or launcher rewrite.
set -euo pipefail

if [ "$#" -ne 5 ]; then
  echo "usage: sinnix-agent-npm-bootstrap <state-dir-name> <npm-package> <binary-name> <runtime-path> <locked-tarball>" >&2
  exit 2
fi

state_dir_name=$1
npm_package=$2
binary_name=$3
runtime_path=$4
package_source=$5

STATE="$HOME/.local/state/$state_dir_name"
export npm_config_prefix="$STATE/npm"
export PATH="$runtime_path:$STATE/npm/bin:$PATH"
mkdir -p "$STATE/npm"

preserve_reify_entries() {
  local package_name package_parent candidate suffix relative recovery_dir=""

  package_name=${npm_package##*/}
  case "$npm_package" in
    @*/*) package_parent="$STATE/npm/lib/node_modules/${npm_package%/*}" ;;
    *) package_parent="$STATE/npm/lib/node_modules" ;;
  esac

  mkdir -p "$package_parent" "$STATE/npm/bin"
  for candidate in \
    "$package_parent/.$package_name-"* \
    "$package_parent/..$package_name-"* \
    "$STATE/npm/bin/.$binary_name-"*; do
    if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
      continue
    fi

    suffix=${candidate##*-}
    if [[ ! $suffix =~ ^[[:alnum:]]{8}$ ]]; then
      continue
    fi

    # An interrupted retirement can hold the only recoverable package copy.
    # Clear npm's collision path without discarding it, even if reinstall fails.
    if [ -z "$recovery_dir" ]; then
      install -d -m 0700 "$STATE/npm-recovery"
      recovery_dir=$(mktemp -d "$STATE/npm-recovery/attempt.XXXXXXXX")
    fi
    relative=${candidate#"$STATE/npm/"}
    install -d -m 0700 "$recovery_dir/$(dirname "$relative")"
    mv -- "$candidate" "$recovery_dir/$relative"
    echo "$binary_name: preserved interrupted npm retirement at $recovery_dir/$relative" >&2
  done
}

has_binary() {
  [ -f "$STATE/npm/bin/$binary_name" ] && [ -x "$STATE/npm/bin/$binary_name" ]
}

preserve_existing() {
  local path=$1 recovery_dir relative
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return
  fi
  install -d -m 0700 "$STATE/npm-recovery"
  recovery_dir=$(mktemp -d "$STATE/npm-recovery/attempt.XXXXXXXX")
  relative=${path#"$STATE/npm/"}
  install -d -m 0700 "$recovery_dir/$(dirname "$relative")"
  mv -- "$path" "$recovery_dir/$relative"
  echo "$binary_name: preserved replaced recovery target at $recovery_dir/$relative" >&2
}

recover_locked_package() {
  local package_target package_parent staged relative_bin temporary_bin manifest_backup result
  package_target="$STATE/npm/lib/node_modules/$npm_package"
  package_parent=$(dirname "$package_target")
  mkdir -p "$package_parent"
  staged=$(mktemp -d "$package_parent/.${npm_package##*/}.recovery.XXXXXXXX")
  # Failed installs are retained beside the destination; publication uses a
  # same-filesystem rename. Neither failure nor recovery deletes an old package.
  echo "$binary_name: staging locked recovery at $staged" >&2
  tar -xzf "$package_source" --strip-components=1 -C "$staged"
  relative_bin=$(node - "$staged" "$npm_package" "$binary_name" <<'JS'
const fs = require('node:fs');
const path = require('node:path');
const [root, expectedName, binary] = process.argv.slice(2);
const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json')));
const lock = JSON.parse(fs.readFileSync(path.join(root, 'npm-shrinkwrap.json')));
if (pkg.name !== expectedName || lock.packages?.['']?.name !== pkg.name ||
    lock.packages[''].version !== pkg.version) {
  throw new Error('Recovery manifest and shrinkwrap identity differ');
}
const bins = typeof pkg.bin === 'string' ? { [pkg.name.split('/').pop()]: pkg.bin } : pkg.bin;
const entry = bins?.[binary];
if (typeof entry !== 'string' || !entry || /[\r\n]/.test(entry) ||
    path.isAbsolute(entry) || path.relative(root, path.resolve(root, entry)).startsWith('..')) {
  throw new Error('Recovery package does not declare the configured binary inside its root');
}
process.stdout.write(entry);
JS
  )
  # Installing a local tarball globally ignores its shrinkwrap in npm 10.
  # ci reads the extracted root's lock before acquiring any dependencies.
  # ci handles optional install failures like a global package install, but
  # also runs project publishing hooks. Suppress only the root's non-install
  # hooks during acquisition, then restore its exact publisher manifest.
  manifest_backup=$(mktemp "$package_parent/.${npm_package##*/}.manifest.XXXXXXXX")
  cp -p -- "$staged/package.json" "$manifest_backup"
  node - "$staged/package.json" <<'JS'
const fs = require('node:fs');
const file = process.argv[2];
const pkg = JSON.parse(fs.readFileSync(file));
if (pkg.scripts) {
  pkg.scripts = Object.fromEntries(Object.entries(pkg.scripts).filter(([event]) =>
    ['preinstall', 'install', 'postinstall'].includes(event)));
  fs.writeFileSync(file, JSON.stringify(pkg) + '\n');
}
JS
  if npm ci --prefix "$staged" --global=false --omit=dev >&2; then
    mv -- "$manifest_backup" "$staged/package.json"
  else
    result=$?
    mv -- "$manifest_backup" "$staged/package.json"
    return "$result"
  fi
  node - "$staged" "$relative_bin" <<'JS'
const fs = require('node:fs');
const path = require('node:path');
const [root, binary] = process.argv.slice(2);
const target = fs.realpathSync(path.join(root, binary));
if (!target.startsWith(fs.realpathSync(root) + path.sep) || !fs.statSync(target).isFile()) {
  throw new Error('Recovered binary is not a regular file inside the package');
}
// npm's global bin-link operation normally applies executable bits.
fs.chmodSync(target, fs.statSync(target).mode | 0o111);
JS
  preserve_existing "$package_target"
  mv -- "$staged" "$package_target"
  temporary_bin=$(mktemp "$STATE/npm/bin/.${binary_name}.recovery.XXXXXXXX")
  ln -sf -- "$package_target/$relative_bin" "$temporary_bin"
  preserve_existing "$STATE/npm/bin/$binary_name"
  mv -T -- "$temporary_bin" "$STATE/npm/bin/$binary_name"
}

# A missing binary means an earlier install may have been interrupted after npm
# retired the old package. Only recovery takes the lock: ordinary launches must
# not contend with one another or rewrite a file another process is executing.
if has_binary; then
  exit 0
fi

exec 9>"$STATE/npm-bootstrap.lock"
if ! flock -w 120 9; then
  echo "$binary_name: timed out waiting for npm recovery; leave the existing installer intact and retry" >&2
  exit 1
fi

# Another wrapper may have completed recovery while this process waited.
if ! has_binary; then
  if [ ! -f "$package_source" ]; then
    echo "$binary_name: locked recovery tarball is unavailable: $package_source" >&2
    exit 1
  fi
  preserve_reify_entries
  if archive_members=$(tar -tzf "$package_source" 2>/dev/null) &&
    [[ $'\n'"$archive_members"$'\n' == *$'\npackage/npm-shrinkwrap.json\n'* ]]; then
    recover_locked_package
  else
    echo "$binary_name: bootstrapping (npm install -g $package_source)..." >&2
    npm install -g "$package_source" >&2
  fi
  if ! has_binary; then
    echo "$binary_name: npm recovery returned success but did not produce an executable regular file at $STATE/npm/bin/$binary_name" >&2
    exit 1
  fi
fi
