#!/usr/bin/env bash
# @sinnix-package
# description: Detect and auto-restore the FiiO E10 DAC's silent profile-off dropout; surface the unrecoverable USB-bandwidth failure mode
# runtimeInputs: coreutils pipewire jq libnotify

# sinnix-nz1c: two live audio-path failures, both presenting as "audio is
# broken / weirdly quiet" with no obvious cause. This watchdog runs on a
# timer and handles the one that's mechanically fixable (profile flipped to
# `off`) plus surfaces the one that isn't (USB isochronous bandwidth
# exhaustion on bus 1 -- freeing bus load or moving the DAC to bus 2 is the
# actual fix, not something this script can do).
#
# Root cause of the profile flipping to `off` is unknown (wireplumber idle
# policy, suspend/resume, USB re-enumeration are all candidates per the
# bead) -- a periodic poll catches it regardless of trigger, which a
# udev-add rule firing once at attach would not.

set -euo pipefail

DEVICE_NAME="alsa_card.usb-FiiO_DigiHug_USB_Audio-01"
# Duplex, not output-only (sinnix-3l3p): this card is also the mic-recorder's
# input source (alsa_input.usb-FiiO_DigiHug_USB_Audio-01.analog-stereo).
# Restoring output-only silently drops that source from the PipeWire graph --
# pw-record blocks on "no target node available" and the mic-recorder unit
# reports healthy while producing nothing. Live-caught 2026-08-13: this
# watchdog's own output-only restore was the reason the mic recorder had been
# stalled for ~15h, previously misdiagnosed as a Silero VAD bug.
TARGET_PROFILE_NAME="output:analog-stereo+input:analog-stereo"

# $1=capture_bin $2=capture_root, positional (matches capture-monitor-poll's
# invocation shape) so this stays a plain @sinnix-package script rather than
# needing its own inline pkgs.writeShellApplication wrapper.
CAPTURE_BIN="$1"
CAPTURE_ROOT="$2"

log_evidence() {
    # $1=condition $2=action $3=detail
    #
    # Routed through the shared sinnix-capture-v1 envelope (like every other
    # lane) instead of a bespoke JSONL append -- this is deliberately an
    # ANOMALY-ONLY writer (a run where audio is healthy logs nothing at all),
    # which is why it is registered as a plain service/timer liveness surface
    # below, not a captures[] lane: a captures[] staleness check would
    # eventually alarm on healthy silence, which is exactly backwards here.
    jq -nc --arg condition "$1" --arg action "$2" --arg detail "$3" \
        '{condition: $condition, action: $action, detail: $detail}' \
        | "$CAPTURE_BIN" write --capture-root "$CAPTURE_ROOT" --lane audio-watchdog
}

notify() {
    notify-send --urgency="$1" "Audio path" "$2" 2>/dev/null || true
}

card_json=$(pw-dump 2>/dev/null | jq -c --arg name "$DEVICE_NAME" \
    '.[] | select(.info.props["device.name"] == $name)')

if [ -z "$card_json" ]; then
    # DAC not enumerated at all (unplugged, or deeper USB failure) -- outside
    # this script's remit, the bead's fix #2 (move to bus-2 xHCI) is a
    # physical change, not something to auto-remediate. Just record it.
    log_evidence "device-absent" "none" "FiiO card not present in pw-dump"
    exit 0
fi

current_profile=$(echo "$card_json" | jq -r '.info.params.Profile[0].name // "unknown"')

if [ "$current_profile" = "off" ]; then
    target_index=$(echo "$card_json" | jq -r --arg n "$TARGET_PROFILE_NAME" \
        '.info.params.EnumProfile[] | select(.name == $n) | .index')
    card_id=$(echo "$card_json" | jq -r '.id')
    if [ -n "$target_index" ]; then
        wpctl set-profile "$card_id" "$target_index"
        log_evidence "profile-off" "restored" "set profile $target_index ($TARGET_PROFILE_NAME) on card $card_id"
        notify "normal" "FiiO DAC profile was off -- restored to $TARGET_PROFILE_NAME automatically."
    else
        log_evidence "profile-off" "restore-failed" "target profile $TARGET_PROFILE_NAME not found in EnumProfile list"
        notify "critical" "FiiO DAC profile is off and the expected analog-stereo profile wasn't found -- check manually."
    fi
    exit 0
fi

# Profile is fine; check the second failure mode -- ALSA start-error loop
# from USB bandwidth exhaustion. This can't be auto-fixed (it's real bus
# contention), only surfaced.
if journalctl --user -u pipewire --since "-3min" 2>/dev/null \
    | grep -q "Start error: No space left on device"; then
    log_evidence "usb-bandwidth-exhaustion" "surfaced-only" "ALSA start-error loop in the last 3min pipewire journal"
    notify "critical" "FiiO DAC hitting USB bandwidth exhaustion (bus 1 contention). Free up bus-1 load or move the DAC to a bus-2 (xHCI) port -- this can't self-heal."
fi

# Default-sink-volume-zero: the other silent-failure shape seen live.
default_sink_id=$(wpctl status 2>/dev/null | awk '/Sinks:/,/Sources:/' | grep '\*' | grep -oP '\d+(?=\.)' | head -1)
if [ -n "${default_sink_id:-}" ]; then
    vol=$(wpctl get-volume "$default_sink_id" 2>/dev/null | awk '{print $2}')
    if [ "${vol:-1}" = "0.00" ]; then
        log_evidence "default-sink-zero-volume" "surfaced-only" "default sink $default_sink_id at volume 0.00"
        notify "critical" "Default audio sink is at volume 0.00 -- silent playback, not obviously broken."
    fi
fi
