#!/usr/bin/env bash
# @sinnix-package
# description: One-call system orientation for agents/humans (hub-server snapshot, acknowledged outages, capture freshness, bd ready head)
# runtimeInputs: bash @sinnix-hub-server
set -euo pipefail

# Thin front door: `sinnix orient` (this wrapper, discovered like every other
# scripts/ entry) execs straight into the real implementation, which lives in
# the hub-server package (pkgs/sinnix-hub-server/sinnix_hub_server/orient.py)
# next to the hub server state it reads. See `sinnix-hub-server orient --help`.
exec sinnix-hub-server orient "$@"
