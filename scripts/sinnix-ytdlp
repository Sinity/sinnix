#!/usr/bin/env python3
# @sinnix-package
# description: Shared yt-dlp entry point with browser authentication and structured-video fallback
# runtimeInputs: python3 yt-dlp
"""Run yt-dlp with the workstation browser session and a standards fallback."""

import html.parser
import json
import os
import pathlib
import shutil
import subprocess
import sys
import urllib.request
import urllib.parse


class StructuredData(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.in_json = False
        self.parts = []
        self.documents = []

    def handle_starttag(self, tag, attrs):
        values = dict(attrs)
        if tag == "script" and values.get("type", "").lower() == "application/ld+json":
            self.in_json = True
            self.parts = []

    def handle_data(self, data):
        if self.in_json:
            self.parts.append(data)

    def handle_endtag(self, tag):
        if tag == "script" and self.in_json:
            self.in_json = False
            try:
                self.documents.append(json.loads("".join(self.parts)))
            except json.JSONDecodeError:
                pass


def video_urls(value):
    if isinstance(value, list):
        for item in value:
            yield from video_urls(item)
    elif isinstance(value, dict):
        kind = value.get("@type", [])
        kinds = kind if isinstance(kind, list) else [kind]
        if "VideoObject" in kinds:
            candidate = value.get("contentUrl")
            if isinstance(candidate, str) and candidate.startswith(("http://", "https://")):
                yield candidate
        for item in value.values():
            if isinstance(item, (dict, list)):
                yield from video_urls(item)


def structured_video_url(page_url):
    request = urllib.request.Request(page_url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(request, timeout=20) as response:
        content_type = response.headers.get_content_type()
        if content_type not in {"text/html", "application/xhtml+xml"}:
            return None
        body = response.read(4 * 1024 * 1024).decode(response.headers.get_content_charset() or "utf-8", "replace")
    parser = StructuredData()
    parser.feed(body)
    return next((url for document in parser.documents for url in video_urls(document)), None)


def browser_video_url(page_url):
    """Resolve media after the real browser has passed an anti-bot page."""
    control = shutil.which("sinnix-chrome-control")
    if control is None:
        return None
    page_id = None
    try:
        opened = subprocess.run(
            [control, "agent-window", "--url", page_url],
            check=True,
            text=True,
            capture_output=True,
            timeout=30,
        )
        page_id = json.loads(opened.stdout)["id"]
        expression = """[...document.querySelectorAll('video, source')]
          .map(node => node.currentSrc || node.src || '')
          .find(url => /^https?:/.test(url)) || ''"""
        subprocess.run(
            [
                control,
                "await",
                page_id,
                "--js",
                expression,
                "--timeout-sec",
                "20",
                "--interval-ms",
                "250",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=25,
        )
        resolved = subprocess.run(
            [control, "evaluate", page_id, "--js", expression],
            check=True,
            text=True,
            capture_output=True,
            timeout=10,
        )
        output = resolved.stdout.strip()
        try:
            value = json.loads(output)
        except json.JSONDecodeError:
            # The desktop control plane prints strings directly and JSON for
            # structured values. Accept both forms of its stable CLI output.
            value = output
        return value if isinstance(value, str) and value.startswith(("http://", "https://")) else None
    except (KeyError, OSError, ValueError, subprocess.SubprocessError):
        return None
    finally:
        if page_id is not None:
            subprocess.run(
                [control, "close", page_id],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )


def with_browser_cookies(arguments):
    if any(arg == "--cookies" or arg.startswith("--cookies=") or arg == "--cookies-from-browser" or arg.startswith("--cookies-from-browser=") for arg in arguments):
        return arguments
    profile = pathlib.Path(os.environ.get("SINNIX_CHROME_PROFILE", "~/.config/chrome-ws/Default")).expanduser()
    if (profile / "Cookies").exists():
        return ["--cookies-from-browser", f"chrome:{profile}", *arguments]
    return arguments


def same_page_resource(page_url, candidate_url):
    """Whether a resolver merely returned another spelling of the page."""
    page = urllib.parse.urlsplit(page_url)
    candidate = urllib.parse.urlsplit(candidate_url)

    def identity(value):
        try:
            port = value.port
        except ValueError:
            return None
        if port is None:
            port = {"http": 80, "https": 443}.get(value.scheme.lower())
        return (
            value.scheme.lower(),
            (value.hostname or "").lower(),
            port,
            value.path.rstrip("/") or "/",
        )

    return identity(page) is not None and identity(page) == identity(candidate)


def main():
    arguments = sys.argv[1:]
    command = ["yt-dlp", *with_browser_cookies(arguments)]
    result = subprocess.run(command, check=False)
    if result.returncode == 0:
        return 0

    pages = [arg for arg in arguments if arg.startswith(("http://", "https://"))]
    if len(pages) != 1:
        return result.returncode
    try:
        media_url = structured_video_url(pages[0])
    except (OSError, ValueError):
        media_url = None
    if not media_url:
        media_url = browser_video_url(pages[0])
    if not media_url or same_page_resource(pages[0], media_url):
        return result.returncode

    fallback = [media_url if arg == pages[0] else arg for arg in arguments]
    origin = urllib.parse.urlsplit(pages[0])
    headers = ["--referer", pages[0], "--add-header", f"Origin:{origin.scheme}://{origin.netloc}"]
    return subprocess.run(["yt-dlp", *with_browser_cookies([*headers, *fallback])], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
