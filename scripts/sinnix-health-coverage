#!/usr/bin/env python3
# @sinnix-package
# description: Source- and device-qualified coverage report over the health events in the lake
# runtimeInputs: python3
"""Answer "what health data do we actually hold?" without flattering totals.

Two incidents motivated this exact shape. A "full history" import reported a
February-to-August span that was really two disconnected blocks around a
1,000-record pagination cap, and a bare count of 471 records read as band
data when nearly all of it was Samsung-era backfill. Both survive any report
that aggregates before it qualifies. So the grouping key here is
(kind, source package, device), the span always comes with its largest
internal gap, and observation counts are separated from unique records
wherever record ids exist (events emitted before generation 3 have none --
those rows say so instead of pretending).

Sweep meta-events ride along: health_backfill rows prove which types were
paged to exhaustion in which generation, and health_sweep_failed rows are the
holes. A type whose latest sweep predates generation 3 is flagged, because
its history was read through the unpaged importer and its span cannot be
trusted.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import sys
from collections import defaultdict
from datetime import datetime, timezone

EVENTS_DEFAULT = "/realm/data/machine/phone/estate/events"
META_KINDS = {"health_backfill", "health_sweep_failed", "health_deletion", "health_token_expired"}
PAGINATED_GENERATION = 3


def parse_ts(value):
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def fmt(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M") if dt else "?"


def fmt_gap(seconds):
    if seconds is None:
        return "-"
    days, rem = divmod(int(seconds), 86400)
    hours = rem // 3600
    return f"{days}d{hours:02d}h" if days else f"{hours}h{(rem % 3600) // 60:02d}m"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--events-dir", default=EVENTS_DEFAULT)
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args()

    files = sorted(glob.glob(os.path.join(args.events_dir, "events-*.jsonl")))
    if not files:
        print(f"no events files under {args.events_dir}", file=sys.stderr)
        return 1

    groups = defaultdict(lambda: {
        "observations": 0, "record_ids": set(), "no_id": 0,
        "times": [], "samples": 0,
    })
    sweeps = {}   # type -> latest health_backfill row
    failures = []
    deletions = 0

    for path in files:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    continue
                kind = ev.get("kind", "")
                if not kind.startswith("health"):
                    continue
                if kind in META_KINDS:
                    if kind == "health_backfill":
                        sweeps[ev.get("type", "all")] = ev
                    elif kind == "health_sweep_failed":
                        failures.append(ev)
                    elif kind == "health_deletion":
                        deletions += 1
                    continue
                device = ev.get("device_model") or ev.get("device_manufacturer") or "?"
                key = (kind, ev.get("source", "?"), device)
                g = groups[key]
                g["observations"] += 1
                rid = ev.get("record_id")
                if rid:
                    g["record_ids"].add(rid)
                else:
                    g["no_id"] += 1
                t = parse_ts(ev.get("start") or ev.get("time"))
                if t:
                    g["times"].append(t)
                g["samples"] += ev.get("samples") or 0

    rows = []
    for (kind, source, device), g in sorted(groups.items()):
        times = sorted(g["times"])
        gap = max(
            (b - a).total_seconds() for a, b in zip(times, times[1:])
        ) if len(times) > 1 else None
        # Unique records are only countable where ids exist; a group of
        # pre-generation-3 events reports observations and says the ids are
        # missing rather than passing observations off as records.
        unique = len(g["record_ids"]) if g["record_ids"] else None
        rows.append({
            "kind": kind, "source": source, "device": device,
            "observations": g["observations"], "unique_records": unique,
            "events_without_id": g["no_id"], "embedded_samples": g["samples"],
            "earliest": fmt(times[0]) if times else "?",
            "latest": fmt(times[-1]) if times else "?",
            "largest_gap": fmt_gap(gap),
        })

    sweep_rows = []
    for type_name, ev in sorted(sweeps.items()):
        gen = ev.get("generation") or 0
        sweep_rows.append({
            "type": type_name, "generation": gen,
            "records": ev.get("records"), "pages": ev.get("pages", "-"),
            "trustworthy": gen >= PAGINATED_GENERATION,
        })

    if args.json:
        print(json.dumps({"groups": rows, "sweeps": sweep_rows,
                          "sweep_failures": failures, "deletions": deletions}, indent=2))
        return 0

    width = max((len(r["kind"]) for r in rows), default=4)
    print(f"{'kind':{width}}  {'source':34} {'device':18} {'obs':>6} {'uniq':>6} {'samples':>8}  span  (largest gap)")
    for r in rows:
        uniq = str(r["unique_records"]) if r["unique_records"] is not None else "no-ids"
        print(f"{r['kind']:{width}}  {r['source']:34} {r['device']:18} "
              f"{r['observations']:>6} {uniq:>6} {r['embedded_samples']:>8}  "
              f"{r['earliest']} .. {r['latest']}  ({r['largest_gap']})")

    print("\nsweeps (a type below generation "
          f"{PAGINATED_GENERATION} was read through the unpaged importer; its span is not coverage):")
    if not sweep_rows:
        print("  none recorded")
    for s in sweep_rows:
        mark = "ok" if s["trustworthy"] else "UNTRUSTWORTHY (pre-pagination)"
        print(f"  {s['type']:32} gen {s['generation']}  records {s['records']}  pages {s['pages']}  {mark}")
    for f in failures:
        print(f"  FAILED: {f.get('type')} after {f.get('pages_read')} page(s): {f.get('reason')}")
    if deletions:
        print(f"\ndeletion tombstones: {deletions}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
