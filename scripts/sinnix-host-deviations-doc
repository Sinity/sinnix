#!/usr/bin/env bash
# @sinnix-package
# description: Generate a static per-host sinnix.features/sinnix.services deviation doc from hosts/<name>/*.nix
# runtimeInputs: bash coreutils findutils gawk ripgrep

# Deliberately static: a line-oriented grep/awk scan of hosts/<name>/*.nix,
# never a Nix evaluation. It only recognizes `sinnix.features...` boolean
# leaves and `sinnix.services...enable` leaves written in nixfmt's normal
# one-assignment-per-line style (single-line dotted form, or a `key = {`
# block whose body is scanned the same way, tracked via matching `};`
# lines). Anything expressed through a helper function, a list, `mkIf`, or
# unusual formatting is invisible to this scan. Treat the output as a
# deviation index, not ground truth — regenerate after editing a host file,
# and cross-check with the actual host config when it matters.
set -euo pipefail

usage() {
  printf 'usage: %s --hosts-root DIR --output FILE\n' "$0" >&2
  exit 2
}

hosts_root= output=
while (($#)); do
  case "$1" in
    --hosts-root) hosts_root=${2-}; shift 2 ;;
    --output) output=${2-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$hosts_root" && -n "$output" ]] || usage
[[ -d "$hosts_root" ]] || { printf 'missing hosts root: %s\n' "$hosts_root" >&2; exit 1; }

# Emits TSV rows "<domain>\t<dotted.option.path>\t<true|false>" for one
# host's *.nix files, in source order.
extract_host() {
  find "$1" -maxdepth 1 -type f -name '*.nix' -print0 | sort -z | xargs -0 -r cat | awk '
    function reset_scope() { active = 0; depth = 0; scope = ""; delete stack }
    BEGIN { reset_scope() }
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line == "" || line ~ /^#/) next

      if (!active) {
        # Single-line boolean leaf, e.g.
        #   sinnix.features.dev.editors.vscode.enable = true;
        #   sinnix.services.tailscale.enable = true;
        if (match(line, /^sinnix\.(features|services)[A-Za-z0-9_.-]*[[:space:]]*=[[:space:]]*(true|false)[[:space:]]*;/)) {
          path = line
          sub(/[[:space:]]*=.*/, "", path)
          val = line
          sub(/^[^=]*=[[:space:]]*/, "", val)
          sub(/[[:space:]]*;.*/, "", val)
          domain = (path ~ /^sinnix\.services\./) ? "services" : "features"
          leaf = path
          sub(/.*\./, "", leaf)
          if (domain == "features" || leaf == "enable") print domain "\t" path "\t" val
          next
        }
        # Block open, e.g. `sinnix.services = {` or `sinnix.features.desktop.hyprlandAnimations = {`
        if (match(line, /^sinnix\.(features|services)[A-Za-z0-9_.-]*[[:space:]]*=[[:space:]]*\{[[:space:]]*$/)) {
          path = line
          sub(/[[:space:]]*=[[:space:]]*\{[[:space:]]*$/, "", path)
          scope = (path ~ /^sinnix\.services(\.|$)/) ? "services" : "features"
          stack[1] = path
          depth = 1
          active = 1
        }
        next
      }

      # Inside a tracked sinnix.features/sinnix.services block.
      if (match(line, /^\}[[:space:]]*;?[[:space:]]*$/)) {
        depth--
        if (depth <= 0) reset_scope()
        next
      }
      if (match(line, /^[A-Za-z0-9_.-]+[[:space:]]*=[[:space:]]*\{[[:space:]]*$/)) {
        key = line
        sub(/[[:space:]]*=[[:space:]]*\{[[:space:]]*$/, "", key)
        depth++
        stack[depth] = stack[depth - 1] "." key
        next
      }
      if (match(line, /^[A-Za-z0-9_.-]+[[:space:]]*=[[:space:]]*(true|false)[[:space:]]*;/)) {
        key = line
        sub(/[[:space:]]*=.*/, "", key)
        val = line
        sub(/^[^=]*=[[:space:]]*/, "", val)
        sub(/[[:space:]]*;.*/, "", val)
        path = stack[depth] "." key
        leaf = key
        sub(/.*\./, "", leaf)
        if (scope == "features" || leaf == "enable") print scope "\t" path "\t" val
        next
      }
    }
  '
}

render_table() {
  # $1 = TSV file (already filtered to one domain), $2 = domain label
  if [[ ! -s "$1" ]]; then
    printf '_None found._\n\n'
    return
  fi
  printf '| Option | Value |\n| --- | --- |\n'
  awk -F '\t' '{ printf "| `%s` | `%s` |\n", $2, $3 }' "$1"
  printf '\n'
}

mkdir -p "$(dirname "$output")"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

{
  printf '# Sinnix per-host configuration deviations\n\n'
  printf '> Generated by `sinnix-host-deviations-doc` from a static line-oriented scan of `hosts/<host>/*.nix` (grep/awk, never a Nix evaluation). It only recognizes `sinnix.features...` boolean leaves and `sinnix.services...enable` leaves written in nixfmt'"'"'s standard block-per-line style — a deviation index, not ground truth. Regenerate after editing a host file.\n\n'

  while IFS= read -r host_dir; do
    host=$(basename "$host_dir")
    all="$tmp/$host.tsv"
    extract_host "$host_dir" | sort -t $'\t' -k2,2 > "$all"
    features="$tmp/$host.features.tsv"
    services="$tmp/$host.services.tsv"
    awk -F '\t' '$1 == "features"' "$all" > "$features"
    awk -F '\t' '$1 == "services"' "$all" > "$services"

    printf '## %s\n\n' "$host"
    if [[ ! -s "$features" && ! -s "$services" ]]; then
      printf '_No sinnix.features/sinnix.services declarations found in this host'"'"'s *.nix files (either the host takes every default, or its configuration isn'"'"'t expressed as sinnix.features/services — see `hosts/%s/` directly)._\n\n' "$host"
      continue
    fi
    printf '### sinnix.features\n\n'
    render_table "$features" features
    printf '### sinnix.services\n\n'
    render_table "$services" services
  done < <(find "$hosts_root" -mindepth 1 -maxdepth 1 -type d | sort)
} > "$output"

if rg -n '/home/|/persist/|/realm/cache/|/realm/data/|/nix/store/' "$output" >/dev/null; then
  printf 'private path found in generated document: %s\n' "$output" >&2
  exit 1
fi
