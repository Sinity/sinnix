#!/usr/bin/env python3
# @sinnix-package
# description: Append-only JSONL spool endpoint for hub report annotations
# runtimeInputs: coreutils

"""Append-only annotation spool for the Sinnix tailnet hub.

The html-report skill already gives every generated report annotation widgets
that autosave to localStorage and export one JSON blob for the operator to
paste back into a chat. With a server in front of the reports, that paste step
can be replaced by one fetch(): this listens on a Unix socket behind the hub's
reverse proxy and appends whatever JSON it is handed to a dated JSONL file that
agents read.

Deliberately minimal, and each omission is a decision:
  * no database -- a JSONL file per UTC day is grep-able, tail-able, and
    survives every failure mode a database introduces;
  * no auth -- the tailnet is the security boundary, same as the rest of the
    hub. Nothing here reads back, so the worst an attacker on the tailnet can
    do is write junk into a spool an agent reads with its own judgment;
  * no read endpoint -- agents read the spool from the filesystem. Serving it
    back would turn a write-only sink into an exfiltration surface for the
    personal analysis those annotations describe;
  * permissive CORS -- reports are also opened straight off disk as file://
    (Origin: null), and the handback must work there too.

Each spooled line is the submitted payload wrapped in an envelope carrying the
receive time, the page that sent it, and a monotonic per-process sequence, so a
consuming agent can tell submissions apart without trusting client fields.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import signal
import socket
import socketserver
import sys
import threading
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler
from pathlib import Path
from typing import Any

SCHEMA = "sinnix-hub-feedback-v1"
MAX_BODY = 1 << 20  # 1 MiB: a generous annotated report, not a file upload


class Spool:
    def __init__(self, directory: Path) -> None:
        self.directory = directory
        self.lock = threading.Lock()
        self.sequence = 0

    def append(self, payload: Any, page: str | None, agent: str | None) -> dict:
        received = dt.datetime.now(dt.timezone.utc)
        with self.lock:
            self.sequence += 1
            envelope = {
                "schema": SCHEMA,
                "received_at": received.isoformat(timespec="seconds"),
                "sequence": self.sequence,
                "page": page,
                "user_agent": agent,
                "payload": payload,
            }
            self.directory.mkdir(parents=True, exist_ok=True)
            target = self.directory / f"{received:%Y-%m-%d}.jsonl"
            with target.open("a", encoding="utf-8") as handle:
                handle.write(json.dumps(envelope, sort_keys=True) + "\n")
                handle.flush()
                os.fsync(handle.fileno())
        return {"status": "spooled", "sequence": envelope["sequence"], "file": str(target)}


class Handler(BaseHTTPRequestHandler):
    server_version = "sinnix-hub-feedback/1"
    protocol_version = "HTTP/1.1"

    def _cors(self) -> None:
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def _reply(self, status: int, value: dict) -> None:
        body = json.dumps(value, sort_keys=True).encode() + b"\n"
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self) -> None:
        self.send_response(HTTPStatus.NO_CONTENT)
        self._cors()
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self) -> None:
        # Health only. There is deliberately no way to read the spool back out.
        self._reply(
            HTTPStatus.OK,
            {"schema": SCHEMA, "status": "ready", "accepts": "POST application/json"},
        )

    def do_POST(self) -> None:
        try:
            length = int(self.headers.get("Content-Length", "-1"))
        except ValueError:
            length = -1
        if length < 0:
            self._reply(HTTPStatus.LENGTH_REQUIRED, {"error": "Content-Length required"})
            return
        if length > MAX_BODY:
            self._reply(
                HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
                {"error": f"payload exceeds {MAX_BODY} bytes"},
            )
            return
        raw = self.rfile.read(length)
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            self._reply(HTTPStatus.BAD_REQUEST, {"error": f"invalid JSON: {error}"})
            return
        result = self.server.spool.append(  # type: ignore[attr-defined]
            payload,
            self.headers.get("Referer") or self.headers.get("X-Hub-Page"),
            self.headers.get("User-Agent"),
        )
        self._reply(HTTPStatus.CREATED, {"schema": SCHEMA, **result})

    def log_message(self, *_args: object) -> None:
        return


class UnixHTTPServer(socketserver.ThreadingUnixStreamServer):
    allow_reuse_address = True
    daemon_threads = True

    def get_request(self) -> tuple[socket.socket, tuple[str, int]]:
        # BaseHTTPRequestHandler expects an (address, port) tuple for logging.
        connection, _ = super().get_request()
        return connection, ("unix", 0)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--socket",
        type=Path,
        required=True,
        help="Unix socket path the hub reverse-proxies to",
    )
    parser.add_argument(
        "--spool-dir",
        type=Path,
        required=True,
        help="Directory that receives one JSONL file per UTC day",
    )
    args = parser.parse_args()

    args.socket.parent.mkdir(parents=True, exist_ok=True)
    try:
        args.socket.unlink()
    except FileNotFoundError:
        pass
    args.spool_dir.mkdir(parents=True, exist_ok=True)

    server = UnixHTTPServer(str(args.socket), Handler)
    server.spool = Spool(args.spool_dir)  # type: ignore[attr-defined]
    # 0o666 so the hub's reverse proxy reaches it regardless of which identity
    # runs it; the socket lives in the user runtime dir, which is already 0700.
    os.chmod(args.socket, 0o666)

    def shutdown(*_args: object) -> None:
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    print(f"sinnix-hub-feedback: {args.socket} -> {args.spool_dir}", file=sys.stderr)
    try:
        server.serve_forever()
    finally:
        server.server_close()
        try:
            args.socket.unlink()
        except FileNotFoundError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
