#!/usr/bin/env bash
# @sinnix-package
# description: Store Clodex credentials encrypted to the local SSH identity
# runtimeInputs: age bash coreutils

set -euo pipefail

if [ "$#" -ne 3 ]; then
  echo "usage: sinnix-clodex-credential-helper <get|set|delete> <service> <account>" >&2
  exit 64
fi

operation=$1
service=$2
account=$3

if [[ ! $service =~ ^[A-Za-z0-9._-]+$ || ! $account =~ ^[A-Za-z0-9._:-]+$ ]]; then
  exit 64
fi

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/clodex-credentials"
credential_id="$(printf '%s\0%s' "$service" "$account" | sha256sum | cut -d' ' -f1)"
credential_path="$state_root/$credential_id.cred"
identity_path="$HOME/.ssh/id_ed25519"
recipient_path="$identity_path.pub"

if [ ! -r "$identity_path" ] || [ ! -r "$recipient_path" ]; then
  echo "Clodex credential identity is unavailable" >&2
  exit 1
fi

case "$operation" in
  get)
    [ -f "$credential_path" ] || exit 2
    exec age -d -i "$identity_path" "$credential_path"
    ;;
  set)
    install -d -m 0700 "$state_root"
    temporary_path="$state_root/$credential_id.cred.tmp.$$"
    trap 'unlink -- "$temporary_path"' EXIT
    age -r "$(< "$recipient_path")" -o "$temporary_path"
    chmod 0600 "$temporary_path"
    mv -f "$temporary_path" "$credential_path"
    trap - EXIT
    ;;
  delete)
    [ -e "$credential_path" ] || exit 2
    rm -f -- "$credential_path"
    ;;
  *)
    exit 64
    ;;
esac
