#!/usr/bin/env python3
# @sinnix-package
# description: Write a daily campaign trajectory snapshot from the Sinnixd event spool
# runtimeInputs: coreutils

"""Produce one deterministic, replaceable daily campaign trajectory record."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import tempfile
from pathlib import Path
from typing import Any

SCHEMA = "sinnix-campaign-trajectory-v1"
EVENT_SCHEMA = 1


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def append_failure(spool: Path, error: Exception) -> None:
    emitted_at = dt.datetime.now(dt.UTC).isoformat()
    event = {
        "schema_version": EVENT_SCHEMA,
        "event_id": hashlib.sha256(
            f"campaign-trajectory:{emitted_at}:{error}".encode()
        ).hexdigest()[:32],
        "kind": "consumer_failure",
        "consumer": "campaign-trajectory",
        "error": str(error),
        "emitted_at": emitted_at,
    }
    spool.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with spool.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())


def parse_stamp(value: Any) -> dt.datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed.astimezone(dt.UTC)


def read_events(spool: Path, start: dt.datetime, end: dt.datetime) -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    if not spool.exists():
        return events
    with spool.open(encoding="utf-8") as handle:
        for line in handle:
            if len(line) > 1_000_002:
                raise ValueError("event exceeds the 1 MiB consumer bound")
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue
            stamp = parse_stamp(event.get("emitted_at") or event.get("completed_at"))
            if stamp is not None and start <= stamp < end:
                events.append(event)
    return events


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--event-spool", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--date", help="UTC date to summarize, defaults to yesterday")
    args = parser.parse_args()
    try:
        day = dt.date.fromisoformat(
            args.date or (dt.datetime.now(dt.UTC).date() - dt.timedelta(days=1)).isoformat()
        )
        start = dt.datetime.combine(day, dt.time.min, tzinfo=dt.UTC)
        end = start + dt.timedelta(days=1)
        events = read_events(args.event_spool, start, end)
        events.sort(key=lambda event: (str(event.get("event_id", "")), json.dumps(event, sort_keys=True)))
        terminals = [
            event for event in events
            if event.get("job_id") and event.get("phase") in {"succeeded", "failed", "cancelled", "timeout", "refused", "terminal"}
        ]
        by_project: dict[str, int] = {}
        by_phase: dict[str, int] = {}
        for event in terminals:
            project = str(event.get("project") or "unknown")
            phase = str(event.get("phase"))
            by_project[project] = by_project.get(project, 0) + 1
            by_phase[phase] = by_phase.get(phase, 0) + 1
        record = {
            "schema": SCHEMA,
            "date": day.isoformat(),
            "window": {"start": start.isoformat(), "end": end.isoformat()},
            "event_count": len(events),
            "terminal_count": len(terminals),
            "by_project": dict(sorted(by_project.items())),
            "by_phase": dict(sorted(by_phase.items())),
            "event_ids": [str(event["event_id"]) for event in events if event.get("event_id")],
        }
        atomic_json(args.output, record)
        atomic_json(args.state, {"schema": SCHEMA, "date": day.isoformat(), "event_count": len(events)})
        print(json.dumps(record, sort_keys=True))
        return 0
    except Exception as error:
        append_failure(args.event_spool, error)
        print(f"sinnix-campaign-trajectory: {error}", flush=True)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
