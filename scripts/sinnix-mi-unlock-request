#!/usr/bin/env python3
# @sinnix-package
# description: Fire the Xiaomi bootloader-unlock application so it ARRIVES at the Beijing-midnight quota reset
# runtimeInputs: python3 websocat android-tools
"""Timed submitter for Xiaomi's bootloader-unlock application (sinnix-9tc).

WHY THIS EXISTS. Xiaomi gates bootloader unlocking behind a daily
application quota that resets at 00:00 Beijing time (UTC+8) -- which is
18:00 in Europe/Warsaw during CEST. Community reports put the pool at a few
dozen slots globally, and it empties within seconds. The operator applied
"within the first minute" through the Xiaomi Community app and still lost,
which is the expected outcome: a human tapping a button in an Android app
pays UI render, touch dispatch, app-side request construction and TLS
handshake AFTER the reset instant. Tens of seconds late is not close.

WHAT THIS DOES DIFFERENTLY. The application is an ordinary HTTPS POST whose
only credential is the `new_bbs_serviceToken` cookie from a normal web login
at https://c.mi.com/global -- no app, no device, no interception needed. So
the request can be built ahead of time and released to ARRIVE at the reset
instant rather than start then:

  - true time from NTP, so a drifting local clock cannot bias the shot;
  - TLS sessions opened and handshaked BEFORE the deadline, so the wire
    carries only the request bytes at go-time;
  - measured RTT, firing at target-(RTT/2) so the packet LANDS at 00:00
    rather than departing then;
  - several pre-warmed connections released together, because a single
    request that hits a slow path loses to no purpose.

This does not defeat the quota; it just stops losing to self-inflicted
latency. If the pool is genuinely full in the first 50ms, nothing here helps.

AUTHORIZATION NOTE. This unlocks the operator's own hardware. It sends one
small burst per day at a published reset boundary -- deliberately NOT a
retry loop, which would be abusive and would risk the account the unlock
depends on.

TWO ENDPOINTS, TWO QUESTIONS. `apply/bl-auth` answers "did I get a slot in
this window" (apply_result 1 granted, 3 pool exhausted, 4 blocked; 6 observed
once 2026-08-18 on a request whose server ts landed exactly on the boundary
second, with deadline 0 -- meaning unknown, no public decode, and the account
state stayed "may apply" afterwards, so it registered nothing).
`user/bl-switch/state` answers "may this account apply at all" (button_state
1 may apply, 2 blocked until a date, 3 account under 30 days old). They are
independent: an eligible account still loses a full pool, and reading the
first to answer the second is what made "ineligible account" look like a
diagnosis for three days of refusals. Only the boundary burst applies;
everything else reads state.

TOKEN. Read from --token-file, or $MI_BBS_TOKEN, or /run/agenix/mi-bbs-token.
The cookie is session-scoped and expires; refresh it the same day you intend
to fire. `--check` reads state and applies nothing, which is the difference
between finding out now and finding out at 18:00:00.
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import socket
import ssl
import struct
import sys
import time
from datetime import datetime, timedelta, timezone

HOST = "sgp-api.buy.mi.com"
PATH = "/bbs/api/global/apply/bl-auth"
STATE_PATH = "/bbs/api/global/user/bl-switch/state"
PORT = 443
BEIJING = timezone(timedelta(hours=8))

# The Community app's own client identity. The endpoint is an app API; a
# stock python User-Agent is an obvious tell and there is no upside to it.
CLIENT_VERSION_CODE = "500411"
CLIENT_VERSION_NAME = "5.4.11"
USER_AGENT = "okhttp/4.12.0"


def log(msg: str) -> None:
    print(f"{datetime.now().isoformat(timespec='milliseconds')} {msg}", flush=True)


def ntp_offset(server: str = "pool.ntp.org", samples: int = 4) -> float:
    """Seconds to ADD to local time to get true time. 0.0 if NTP is unreachable.

    Reported rather than silently assumed: a bad clock is exactly the failure
    that would make a perfectly-written timer miss by seconds.
    """
    best: tuple[float, float] | None = None
    for _ in range(samples):
        try:
            pkt = b"\x1b" + 47 * b"\0"
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.settimeout(3)
            t0 = time.time()
            s.sendto(pkt, (server, 123))
            data, _ = s.recvfrom(1024)
            t3 = time.time()
            s.close()
            secs = struct.unpack("!12I", data)[10] - 2208988800
            frac = struct.unpack("!12I", data)[11] / 2**32
            server_time = secs + frac
            rtt = t3 - t0
            offset = server_time + rtt / 2 - t3
            if best is None or rtt < best[0]:
                best = (rtt, offset)
        except Exception:
            continue
    if best is None:
        return 0.0
    return best[1]


def next_reset(now_true: float, at_hour: int = 0) -> float:
    """Unix time of the next Beijing-midnight quota reset."""
    now = datetime.fromtimestamp(now_true, BEIJING)
    target = now.replace(hour=at_hour, minute=0, second=0, microsecond=0)
    if target <= now:
        target += timedelta(days=1)
    return target.timestamp()


def build_request(token: str, device_id: str, is_retry: bool) -> bytes:
    body = json.dumps({"is_retry": is_retry}, separators=(",", ":")).encode()
    cookie = (
        f"new_bbs_serviceToken={token};"
        f"versionCode={CLIENT_VERSION_CODE};"
        f"versionName={CLIENT_VERSION_NAME};"
        f"deviceId={device_id};"
    )
    head = (
        f"POST {PATH} HTTP/1.1\r\n"
        f"Host: {HOST}\r\n"
        f"Cookie: {cookie}\r\n"
        f"Content-Type: application/json; charset=utf-8\r\n"
        f"User-Agent: {USER_AGENT}\r\n"
        f"Content-Length: {len(body)}\r\n"
        f"Connection: keep-alive\r\n"
        f"\r\n"
    ).encode()
    return head + body


def build_state_request(token: str, device_id: str) -> bytes:
    """A GET of the account's own unlock eligibility. Reads nothing else.

    This is the endpoint the probes must use. It reports whether the ACCOUNT
    may apply, which is a different question from whether the daily pool has
    slots left, and unlike the apply POST it is not an application: probing
    with a real application risks Xiaomi's documented too-frequent-retry
    penalty (a ten-day account block) to learn something this answers for
    free.
    """
    cookie = (
        f"new_bbs_serviceToken={token};"
        f"versionCode={CLIENT_VERSION_CODE};"
        f"versionName={CLIENT_VERSION_NAME};"
        f"deviceId={device_id};"
    )
    return (
        f"GET {STATE_PATH} HTTP/1.1\r\n"
        f"Host: {HOST}\r\n"
        f"Cookie: {cookie}\r\n"
        f"User-Agent: {USER_AGENT}\r\n"
        f"Connection: keep-alive\r\n"
        f"\r\n"
    ).encode()


def describe_state(body: str) -> str:
    """Xiaomi's account-side verdict in words.

    Measured 2026-08-17: button_state 1 / is_pass 4 / deadline 0 while the
    apply endpoint was answering apply_result 3. The two are independent --
    an eligible account still loses a full pool -- and conflating them is
    what made 'ineligible account' look like a plausible diagnosis for three
    days.
    """
    try:
        start = body.index("{")
        data = json.loads(body[start:body.rindex("}") + 1]).get("data") or {}
    except (ValueError, json.JSONDecodeError):
        return f"STATE-UNPARSEABLE :: {body.strip()[:120]}"

    button = data.get("button_state")
    words = {
        1: "may apply",
        2: f"account blocked until {data.get('deadline_format') or '?'}",
        3: "account younger than 30 days",
    }.get(button, f"unknown button_state {button}")
    granted = " ALREADY GRANTED" if data.get("is_pass") == 1 else ""
    return (f"account: {words}{granted} "
            f"(button_state={button} is_pass={data.get('is_pass')} "
            f"function_switch={data.get('function_switch')})")


async def open_warm(ctx: ssl.SSLContext) -> tuple[asyncio.StreamReader, asyncio.StreamWriter, float]:
    """Connect + handshake now, measure RTT, leave the socket idle and ready."""
    t0 = time.monotonic()
    reader, writer = await asyncio.open_connection(HOST, PORT, ssl=ctx, server_hostname=HOST)
    rtt = time.monotonic() - t0
    return reader, writer, rtt


async def fire(reader, writer, payload: bytes, idx: int | str) -> tuple[int, str]:
    try:
        writer.write(payload)
        await writer.drain()
        raw = await asyncio.wait_for(reader.read(65536), timeout=20)
    except Exception as exc:  # noqa: BLE001 - report, never swallow
        return (-1, f"conn{idx}: transport error: {exc}")
    text = raw.decode("utf-8", "replace")
    status = -1
    if text.startswith("HTTP/"):
        try:
            status = int(text.split(" ", 2)[1])
        except (IndexError, ValueError):
            status = -1
    body = text.split("\r\n\r\n", 1)[1] if "\r\n\r\n" in text else text
    return (status, f"conn{idx}: HTTP {status} {body.strip()[:400]}")


def classify(bodies: list[str]) -> str:
    """Read Xiaomi's own verdict fields rather than guessing from HTTP status.

    A refused application still returns HTTP 200 with code=0/"success" -- that
    pair only means the CALL was accepted. The verdict is data.apply_result,
    and data.deadline carries the epoch of the next window.
    """
    results: list[object] = []
    errors: list[object] = []
    token_invalid = False
    for body in bodies:
        try:
            start = body.index("{")
            payload = json.loads(body[start:body.rindex("}") + 1])
        except (ValueError, json.JSONDecodeError):
            low = body.lower()
            token_invalid = token_invalid or "not login" in low or "401" in low
            continue

        data = payload.get("data") or {}
        result = data.get("apply_result")
        results.append(result)
        if result == 1:
            return "GRANTED"
        if payload.get("code") not in (0, None):
            errors.append(payload.get("code"))

    if token_invalid:
        return "TOKEN-INVALID"
    if 4 in results:
        return "BLOCKED"
    if 3 in results:
        return "REFUSED-UNTIL-DEADLINE"
    if errors:
        return f"ERROR-code-{errors[0]}"
    if results:
        return f"UNKNOWN-apply_result-{results[0]}"
    return "UNKNOWN"


async def observe_window(args, offset: float) -> int:
    """Confirm eligibility before the window, then fire on it.

    These probes read `bl-switch/state`, never the apply endpoint. Until
    2026-08-17 they sent real applications, which answered a question the
    state endpoint answers for free while spending attempts against an
    endpoint whose documented penalty for frequent retries is a ten-day
    account block. What the probes are for now is the precondition: a token
    that still works and an account that is still permitted to apply, known
    before the one shot that matters rather than after it.
    """
    ctx = ssl.create_default_context()
    state_payload = build_state_request(args.token, args.device_id)

    async def probe(label: str) -> str | None:
        try:
            r, w, _ = await open_warm(ctx)
            _, body = await fire(r, w, state_payload, 0)
            w.close()
            log(f"{label}: {describe_state(body)}")
            return body
        except Exception as exc:  # noqa: BLE001
            log(f"{label} probe failed: {exc}")
            return None

    await probe("pre-probe")

    # The window is Beijing midnight. It used to be read from the apply
    # response's own deadline field, which the state endpoint does not carry
    # (it reports 0 for an unblocked account) -- and which only ever restated
    # the same boundary anyway.
    target = args.at_epoch or next_reset(time.time() + offset, args.hour)
    log(f"window: {datetime.fromtimestamp(target).astimezone().isoformat()}")

    # The last probe must leave run()'s FULL warm lead intact. T-1s cost the
    # 2026-08-15 shot (released +1.9s); T-5s cost the 2026-08-16 shot
    # (released +4.0s) because a stalled handshake consumed the remaining
    # margin. T-60s is the final observation; run() then has ~40s of slack
    # before it opens the warm sockets at target-warm_lead.
    for lead in (1800, 60):
        when = target - lead
        while (time.time() + offset) < when:
            time.sleep(min(20.0, max(0.2, when - (time.time() + offset))))
        await probe(f"T-{lead}s")

    args.at_epoch = target
    return await run(args)


async def run(args: argparse.Namespace) -> int:
    token = args.token
    if not token:
        log("no token available (--token-file, $MI_BBS_TOKEN, or /run/agenix/mi-bbs-token)")
        return 2

    # Four identical payloads answered one question four times. The burst now
    # splits between is_retry true and false, whose difference is undocumented
    # and untestable outside the window (a request made while the window is
    # shut answers 3 whatever it carries). Same number of requests, one more
    # answer.
    if args.first_try is None:
        variants = [("retry", True), ("first", False)]
    else:
        variants = [("first", False)] if args.first_try else [("retry", True)]
    payloads = [(name, build_request(token, args.device_id, is_retry=flag))
                for name, flag in variants]

    off = 0.0 if args.no_ntp else ntp_offset(args.ntp_server)
    log(f"ntp offset {off * 1000:+.1f} ms" + ("" if off else " (unavailable or already exact)"))

    now_true = time.time() + off
    if args.check:
        # Reads state; sends no application. This used to fire the apply POST,
        # so the documented "validates it without applying" was false and every
        # check spent an attempt against the endpoint that penalises frequent
        # retries.
        ctx = ssl.create_default_context()
        r, w, rtt = await open_warm(ctx)
        log(f"state check: rtt {rtt * 1000:.0f} ms")
        _, detail = await fire(r, w, build_state_request(token, args.device_id), 0)
        w.close()
        verdict = describe_state(detail[detail.find("{"):] if "{" in detail else detail)
        log(verdict)
        return 0 if "button_state=1" in verdict else 1

    target = args.at_epoch or next_reset(now_true, args.hour)
    log(f"target {datetime.fromtimestamp(target, BEIJING).isoformat()} Beijing "
        f"({datetime.fromtimestamp(target).astimezone().isoformat()} local)")

    lead = args.warm_lead
    while (target - (time.time() + off)) > lead:
        remaining = target - (time.time() + off)
        time.sleep(min(30.0, max(0.5, remaining - lead)))

    # No barrier on the warm-up: on 2026-08-16 one stalled handshake held an
    # asyncio.gather for 8s and pushed the whole burst 4s past the boundary.
    # Open every connection as its own task and fire with whatever is warm by
    # T-1s; a straggler is abandoned, not waited for.
    ctx = ssl.create_default_context()
    tasks = [asyncio.ensure_future(open_warm(ctx)) for _ in range(args.connections)]
    warm_cutoff = max(0.0, (target - 1.0) - (time.time() + off))
    done, pending = await asyncio.wait(tasks, timeout=warm_cutoff)
    for t in pending:
        t.cancel()
    conns = []
    for t in done:
        try:
            conns.append(t.result())
        except Exception as exc:  # noqa: BLE001 - a failed warm-up is per-connection news
            log(f"warm connection failed: {exc}")
    if pending:
        log(f"{len(pending)} connection(s) not warm by T-1s; abandoned")
    if not conns:
        log("no connection could be pre-warmed; aborting rather than firing cold")
        return 1
    rtt_min = min(c[2] for c in conns)
    log(f"{len(conns)} warm connections, rtts "
        + "/".join(f"{c[2] * 1000:.0f}" for c in conns) + " ms")

    # A handshake that needed retransmits (2026-08-18: 2535ms next to three
    # ~110ms peers) marks a lossy path whose shot may arrive late, while the
    # release offset below assumes the fleet's best RTT. Rebuild such
    # connections while there is still comfortable lead; keep the old one
    # whenever the rebuild does not finish healthy in time, so this can only
    # ever improve the fleet, never shrink it.
    slow_cutoff = max(3 * rtt_min, 0.5)
    for i, (r, w, rtt) in enumerate(conns):
        if rtt <= slow_cutoff:
            continue
        lead_left = target - (time.time() + off)
        if lead_left < 5.0:
            log(f"conn{i}: rtt {rtt * 1000:.0f} ms is pathological but only "
                f"{lead_left:.1f}s to target; keeping it")
            continue
        try:
            r2, w2, rtt2 = await asyncio.wait_for(open_warm(ctx), timeout=min(3.0, lead_left - 2.0))
        except Exception as exc:  # noqa: BLE001 - per-connection news, old conn still fires
            log(f"conn{i}: rebuild failed ({exc}); keeping the slow connection")
            continue
        if rtt2 <= slow_cutoff:
            log(f"conn{i}: rebuilt, rtt {rtt * 1000:.0f} -> {rtt2 * 1000:.0f} ms")
            conns[i] = (r2, w2, rtt2)
            try:
                w.close()
            except Exception:
                pass
        else:
            log(f"conn{i}: rebuild also slow ({rtt2 * 1000:.0f} ms); keeping the original")
            try:
                w2.close()
            except Exception:
                pass
    rtt_min = min(c[2] for c in conns)

    # Send early by half the RTT so the packet ARRIVES at the boundary.
    release = target - rtt_min / 2 - args.lead_ms / 1000.0
    while (time.time() + off) < release:
        gap = release - (time.time() + off)
        if gap > 0.005:
            time.sleep(gap / 2)
    log(f"release at {datetime.fromtimestamp(time.time() + off).isoformat(timespec='milliseconds')}")

    results = await asyncio.gather(
        *(fire(r, w, payloads[i % len(payloads)][1],
               f"{i}-{payloads[i % len(payloads)][0]}")
          for i, (r, w, _) in enumerate(conns))
    )
    for _, detail in results:
        log(detail)
    for _, w, _ in conns:
        try:
            w.close()
        except Exception:
            pass

    verdict = classify([d for _, d in results])
    log(f"verdict: {verdict}")
    # Three outcomes, three codes, because two of them are not failures.
    #
    # 0  GRANTED -- the endpoint's successful terminal result.  Keep this
    #    aligned with the sentinel writer in the systemd runner: a grant must
    #    stop future daily attempts.
    # 75 REFUSED-UNTIL-DEADLINE -- the server's ordinary "not in this quota
    #    window" answer, which is what almost every run gets and is in no
    #    sense a fault.  It used to return 1, so the unit went red every
    #    single day for working exactly as designed; the unit declares
    #    SuccessExitStatus=75 so systemd agrees.  EX_TEMPFAIL, from
    #    sysexits.h: try again later.
    # 1  anything else -- a genuine failure worth a red unit.
    if verdict == "GRANTED":
        return 0
    return 75 if verdict == "REFUSED-UNTIL-DEADLINE" else 1



def token_from_browser(cdp_port: int = 9222) -> str | None:
    """Pull new_bbs_serviceToken from the live Chrome profile via CDP.

    The cookie is HttpOnly, so `document.cookie` cannot see it and neither
    can page-level JS -- CDP's Network.getCookies is the only route. It is
    also session-scoped, so a value captured yesterday is worthless at the
    window; this exists so the token is fetched at fire time instead of
    stored.
    """
    import subprocess
    import urllib.request

    def _targets() -> list[dict]:
        with urllib.request.urlopen(f"http://127.0.0.1:{cdp_port}/json/list", timeout=5) as r:
            return json.loads(r.read())

    try:
        pages = [t for t in _targets() if t.get("type") == "page" and "c.mi.com" in (t.get("url") or "")]
        if not pages:
            # No open page on the origin: cookies are per-origin, so make one.
            #
            # PUT, not GET: Chrome made /json/new PUT-only (crbug 1145518)
            # as a DNS-rebinding defence, and urlopen with no body sends GET,
            # which gets a 405.
            urllib.request.urlopen(
                urllib.request.Request(
                    f"http://127.0.0.1:{cdp_port}/json/new?https://c.mi.com/global",
                    method="PUT",
                ),
                timeout=10,
            ).read()
            time.sleep(4)
            pages = [t for t in _targets() if t.get("type") == "page" and "c.mi.com" in (t.get("url") or "")]
        if not pages:
            return None
        ws = pages[0]["webSocketDebuggerUrl"]
        req = json.dumps({
            "id": 1,
            "method": "Network.getCookies",
            "params": {"urls": ["https://c.mi.com/"]},
        })
        out = subprocess.run(
            ["websocat", "-n1", "-B", "4000000", ws],
            input=req + "\n", capture_output=True, text=True, timeout=20,
        ).stdout
        cookies = json.loads(out).get("result", {}).get("cookies", [])
        for c in cookies:
            if c.get("name") == "new_bbs_serviceToken" and c.get("value"):
                return c["value"]
    except Exception as exc:  # noqa: BLE001 - report, never fall through silently
        log(f"browser token lookup failed: {exc}")
    return None


def device_id_from_phone(timeout: float = 10.0) -> str | None:
    """The phone's android_id, for the deviceId cookie component.

    The default is sixteen zeroes, which is the right SHAPE and an obviously
    synthetic VALUE. Measured 2026-08-17, `bl-switch/state` answers
    identically to both, so the field is not validated there; whether the
    apply endpoint reads it is only observable once a day, so this sends the
    real one on the grounds that it costs an adb call made half an hour
    before the shot and removes the last knob still set to a placeholder.
    """
    import re
    import subprocess

    try:
        out = subprocess.run(
            ["adb", "shell", "settings", "get", "secure", "android_id"],
            capture_output=True, text=True, timeout=timeout,
        ).stdout.strip()
    except Exception as exc:  # noqa: BLE001 - a missing phone is not fatal here
        log(f"device id: adb unavailable ({exc}); using placeholder")
        return None
    match = re.fullmatch(r"[0-9a-f]{16}", out)
    if not match:
        log("device id: no android_id from the phone; using placeholder")
        return None
    return out


def read_token(explicit: str | None) -> str | None:
    if explicit:
        p = os.path.expanduser(explicit)
        if os.path.exists(p):
            return open(p).read().strip()
        return explicit.strip()
    if os.environ.get("MI_BBS_TOKEN"):
        return os.environ["MI_BBS_TOKEN"].strip()
    tok = token_from_browser()
    if tok:
        log(f"token pulled live from the browser ({len(tok)} chars)")
        return tok
    for path in ("/run/agenix/mi-bbs-token",):
        if os.path.exists(path):
            try:
                return open(path).read().strip()
            except OSError:
                pass
    return None


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--token-file", dest="token_file", help="file holding new_bbs_serviceToken")
    ap.add_argument("--device-id", default=None,
                    help="deviceId cookie component; defaults to the phone's android_id over adb")
    ap.add_argument("--check", action="store_true",
                    help="report token validity and account eligibility now; sends no application")
    ap.add_argument("--hour", type=int, default=0, help="Beijing hour of the reset (default 0)")
    ap.add_argument("--at-epoch", type=float, default=0.0, help="explicit unix target, overrides --hour")
    ap.add_argument("--connections", type=int, default=4, help="pre-warmed connections released together")
    ap.add_argument("--warm-lead", type=float, default=20.0, help="seconds before target to open connections")
    ap.add_argument("--lead-ms", type=float, default=0.0, help="extra milliseconds to fire early")
    ap.add_argument("--ntp-server", default="pool.ntp.org")
    ap.add_argument("--no-ntp", action="store_true", help="trust the local clock (not recommended)")
    ap.add_argument("--first-try", dest="first_try", action="store_const", const=True, default=None,
                    help="send only is_retry=false (default: split the burst between both)")
    ap.add_argument("--retry-only", dest="first_try", action="store_const", const=False,
                    help="send only is_retry=true")
    ap.add_argument("--observe-window", action="store_true",
                    help="confirm token and account eligibility at T-30m/-60s, then fire on the window")
    args = ap.parse_args()
    args.token = read_token(args.token_file)
    if not args.device_id:
        # Resolved here, not at the boundary: an adb call is cheap but it can
        # hang, and nothing may hang inside the warm-up.
        args.device_id = device_id_from_phone() or "0000000000000000"
    log(f"device id: {args.device_id[:4]}...{args.device_id[-4:]}")
    try:
        if args.observe_window:
            if not args.token:
                print("no token available", file=sys.stderr)
                return 2
            off = 0.0 if args.no_ntp else ntp_offset(args.ntp_server)
            return asyncio.run(observe_window(args, off))
        return asyncio.run(run(args))
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
