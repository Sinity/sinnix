#!/usr/bin/env bash
# @sinnix-package
# description: Queue a project's baseline operation on each new default-branch head, in a reserved checkout
# runtimeInputs: bash coreutils git jq
set -euo pipefail

# The baseline is a warm build of master whose target seeds new checkouts
# (sinnix-cargo-target); the descriptor's operation decides what it builds
# and where it queues. It runs in <workspace root>/<project>-master, a
# detached worktree this script alone moves. A running baseline holds it;
# a queued one for an older head is cancelled and replaced, so the pool holds
# at most one baseline per project and it is for the newest head.
project="${1:?usage: sinnix-master-baseline <project>}"
agentctl="${AGENTCTL:-agentctl}"

descriptor="$("$agentctl" project get "$project" --json)"
root="$(jq -r '.root' <<<"$descriptor")"
workspace_root="$(jq -r '.workspace.root // "/realm/worktree"' <<<"$descriptor")"
base="$(jq -r '.workspace.default_base // "origin/master"' <<<"$descriptor")"
checkout="$workspace_root/$project-master"
if ! jq -e '.operations | any(.name == "baseline")' <<<"$descriptor" >/dev/null; then
  echo "$project declares no baseline operation; nothing to queue"
  exit 0
fi

active="$("$agentctl" job list --project "$project" --active --json |
  jq -c --arg label "$project:baseline" '[.[] | select(.label == $label)]')"
if jq -e 'any(.phase != "queued")' <<<"$active" >/dev/null; then
  exit 0
fi

git -C "$root" fetch --quiet "${base%%/*}" "${base#*/}"
head="$(git -C "$root" rev-parse --verify "$base^{commit}")"
queued="$(jq -r '.[].job_id' <<<"$active")"
if [ -n "$queued" ]; then
  stamp="$(git -C "$checkout" rev-parse --path-format=absolute --git-path baseline-head)"
  read -r stamped_head _ 2>/dev/null <"$stamp" || true
  if [ "${stamped_head:-}" = "$head" ]; then
    exit 0
  fi
  for job in $queued; do
    "$agentctl" job cancel 0 --job-id "$job" --actor sinnix-master-baseline \
      --reason "superseded by $base at $head" --json >/dev/null
  done
fi
if [ ! -e "$checkout" ]; then
  git -C "$root" worktree add --quiet --detach "$checkout" "$head"
  # Worktree cleanup keeps a locked checkout.
  git -C "$root" worktree lock --reason "master baseline (sinnix-master-baseline)" "$checkout"
fi
git -C "$root" config sinnix.baselineCheckout "$checkout"

# The stamp names the head and the job queued for it. A job that was lost or
# never recorded warmed nothing, so its head is queued again. A cancellation
# is a decision about that head and stands, as do a refused launch and a
# passing, failing or timed-out baseline, until the branch moves.
stamp="$(git -C "$checkout" rev-parse --path-format=absolute --git-path baseline-head)"
read -r stamped_head stamped_job 2>/dev/null <"$stamp" || true
if [ "${stamped_head:-}" = "$head" ]; then
  phase=""
  if [ -n "${stamped_job:-}" ]; then
    phase="$("$agentctl" job get 0 --job-id "$stamped_job" --json 2>/dev/null | jq -r '.phase // empty' || true)"
  fi
  case "$phase" in
    "" | unknown | vanished) ;;
    *) exit 0 ;;
  esac
fi
git -C "$checkout" checkout --quiet --detach "$head"
# The execution directory does not select its descriptor. Resolve the moved
# checkout through agentctl, retaining the registered project identity.
selected="$("$agentctl" project get "$checkout" --json)"
if ! jq -e --arg id "$(jq -r '.id' <<<"$descriptor")" '.id == $id' <<<"$selected" >/dev/null; then
  echo "$checkout declares a different project ID than $project" >&2
  exit 1
fi
job="$("$agentctl" job start --project "$checkout" baseline --workspace "$checkout" --json | jq -r '.job_id')"
printf '%s %s\n' "$head" "$job" >"$stamp"
echo "queued $project baseline at $head"
