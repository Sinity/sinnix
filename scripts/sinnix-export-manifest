#!/usr/bin/env python3
# @sinnix-package
# description: Regenerate a MANIFEST.json file inventory (path/size/mtime/sha256) for an export tree
# pythonPackages: @sinnix-lib

# The lake's export trees carry MANIFEST.json inventories so a snapshot's
# integrity and completeness can be checked years later. The original
# health/raw manifest was written by an uncommitted one-off in January 2026
# and immediately went stale (it also listed itself, with a hash it cannot
# have); this is the durable replacement. The manifest never includes
# itself: a file cannot carry its own digest, and the manifest is derived
# state, not export content.

import hashlib
import json
import os
from sinnix_lib.atomic import atomic_publish
import sys
from datetime import datetime, timezone
from pathlib import Path
from stat import S_ISREG

if len(sys.argv) < 2 or not Path(sys.argv[1]).is_dir():
    print("usage: sinnix-export-manifest <export-tree-root>", file=sys.stderr)
    sys.exit(64)

root = Path(sys.argv[1]).resolve()
def scan_error(error):
    raise error


# Path.rglob suppresses traversal errors. An omitted subtree cannot support
# a new complete inventory, so preserve the prior manifest on every failure.
paths = []
for directory, _subdirectories, filenames in os.walk(root, onerror=scan_error, followlinks=False):
    for name in filenames:
        path = Path(directory) / name
        if path == root / "MANIFEST.json":
            continue
        if S_ISREG(path.stat().st_mode):
            paths.append(path)

entries = []
for path in sorted(paths):
    rel = path.relative_to(root).as_posix()
    stat = path.stat()
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    entries.append(
        {
            "path": rel,
            "size": stat.st_size,
            "mtime": datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc).isoformat(),
            "sha256": digest.hexdigest(),
        }
    )

manifest = {
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "generator": "sinnix-export-manifest",
    "root": str(root),
    "entry_count": len(entries),
    "total_bytes": sum(e["size"] for e in entries),
    "entries": entries,
}
target = root / "MANIFEST.json"
atomic_publish(
    target,
    (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode(),
    fsync=True,
    mode=0o644,
)
print(f"{target}: {len(entries)} entries, {manifest['total_bytes']} bytes inventoried")
