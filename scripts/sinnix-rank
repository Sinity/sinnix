#!/usr/bin/env python3
# @sinnix-package
# description: Preference ranking over any item domain (backlog, options, images) on the shared rank-core engine
# runtimeInputs: coreutils xdg-utils @sinnix-image-features
# pythonPackages: @sinnix-lib @sinnix-rank-core
# docs: docs/ranking.md

"""Frontend for rank_core: register items into a domain, compare them (in a
terminal, through an agent, on a hub page, or on a live loopback page for
image domains), read the fitted ranking with its stopping statement, explain
choices against item features, and draw one item per a policy.

Store convention: raw comparisons and items are behavioral capture, kept
forever under /realm/activity/shared/ranking/<domain>/; fits are never
written back, so every read refits from the raw log.

The registered items are the domain's roster. A comparison naming an id the
roster does not carry is kept in the log but left out of the fit: it is
evidence about an item that is no longer part of the domain.
"""

from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import math
import mimetypes
import os
import random
import shutil
import subprocess
import sys
import threading
import urllib.parse
import uuid
from dataclasses import replace
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from rank_core import Item, Store, build_selector, draw, fit, top_k_stability
from rank_core.draw import POLICIES
from rank_core.store import VALID_KINDS, append_log, domain_path, read_log

CAPTURE_ROOT = Path(
    os.environ.get("SINNIX_RANK_ROOT", "/realm/activity/shared/ranking")
)
REPORTS_DIR = Path(os.environ.get("SINNIX_HUB_REPORTS_DIR", "/realm/report"))
FEEDBACK_DIR = Path(
    os.environ.get("SINNIX_HUB_FEEDBACK_DIR", "/realm/state/hub-feedback")
)

#: The schema a hub session page stamps on the judgments it posts to
#: /feedback, and the one the hub server triggers `ingest` on.
SCHEMA = "sinnix-rank-v1"

#: Below this top-k stability the fitted order is a working hypothesis, not an
#: answer. `status` refuses to call anything settled under it, and every
#: consumer reads `evidence.settled` rather than re-deriving a threshold.
DEFAULT_STOP_AT = 0.9


def domain_dir(domain: str) -> Path:
    return domain_path(CAPTURE_ROOT, domain)


def load_items_input(raw: str) -> list[Item]:
    """Accepts a JSON array (e.g. `bd ready --json`) or JSONL, one object per
    line. Each record needs an id; label falls back to `title` (bd's field)
    then the id itself. Every other field (image, description, features, ...)
    is carried through as meta.
    """
    raw = raw.strip()
    if not raw:
        return []
    try:
        parsed = json.loads(raw)
        records = parsed if isinstance(parsed, list) else [parsed]
    except json.JSONDecodeError:
        records = [json.loads(line) for line in raw.splitlines() if line.strip()]

    items = []
    for rec in records:
        if not isinstance(rec, dict) or "id" not in rec:
            raise ValueError(f"item record missing 'id': {rec!r}")
        item_id = str(rec["id"])
        label = rec.get("label") or rec.get("title") or item_id
        meta = {k: v for k, v in rec.items() if k not in ("id", "label")}
        items.append(Item(id=item_id, label=label, meta=meta))
    return items


def check_identity(
    incoming: list[Item],
    existing: dict[str, Item],
    *,
    allow_duplicate_labels: bool,
    revise: bool,
) -> tuple[list[Item], list[str]]:
    """Split *incoming* into items to append and identity conflicts to refuse.

    An id is a promise: comparisons already recorded against it are evidence
    about the option that id named. So a re-`add` under an id that already
    carries a different label is a changed option set, not an update, and it
    is refused unless the caller says explicitly which of the two it means --
    `--revise` to relabel the same option, or a fresh id for a new one.
    Duplicate labels are refused for the mirror-image reason: two options the
    operator cannot tell apart in a prompt produce comparisons that cannot be
    attributed afterwards.
    """
    conflicts: list[str] = []
    to_add: list[Item] = []
    labels: dict[str, str] = (
        {}
        if allow_duplicate_labels
        else {item.label: item_id for item_id, item in existing.items()}
    )
    for item in incoming:
        prior = existing.get(item.id)
        if prior is not None and prior.label != item.label and not revise:
            conflicts.append(
                f"{item.id}: already registered as {prior.label!r}, now given as "
                f"{item.label!r} -- use a new id for a new option, or --revise "
                f"to relabel the same one"
            )
            continue
        if prior is not None and prior.label == item.label:
            continue
        owner = labels.get(item.label)
        if owner is not None and owner != item.id:
            conflicts.append(
                f"{item.id}: label {item.label!r} is already item {owner} -- "
                f"disambiguate the label, or pass --allow-duplicate-labels"
            )
            continue
        if not allow_duplicate_labels:
            labels[item.label] = item.id
        to_add.append(item)
    return to_add, conflicts


def add_image_features(items: list[Item]) -> None:
    """Give image items a feature vector so `explain` has something to fit.

    Failures are reported, never silently dropped: an item quietly missing
    its features degrades `explain` in a way nothing else surfaces.
    """
    computed = failed = 0
    for item in items:
        image = item.meta.get("image")
        if not image or "features" in item.meta:
            continue
        try:
            out = subprocess.run(
                ["sinnix-image-features", image],
                capture_output=True,
                text=True,
                timeout=60,
                check=True,
            )
            item.meta["features"] = json.loads(out.stdout)
            computed += 1
        except (subprocess.SubprocessError, json.JSONDecodeError, OSError) as exc:
            print(f"  feature extraction failed for {item.id}: {exc}", file=sys.stderr)
            failed += 1
    print(
        f"computed image features for {computed} item(s)"
        + (f", {failed} failed" if failed else "")
    )


def cmd_add(args: argparse.Namespace) -> int:
    raw = sys.stdin.read() if args.items == "-" else Path(args.items).read_text()
    items = load_items_input(raw)
    store = Store(domain_dir(args.domain))
    existing = store.load_items()
    to_add, conflicts = check_identity(
        items,
        existing,
        allow_duplicate_labels=args.allow_duplicate_labels,
        revise=args.revise,
    )
    if conflicts:
        for message in conflicts:
            print(f"identity conflict: {message}", file=sys.stderr)
        print(
            f"refused {len(conflicts)} item(s); nothing was written to domain "
            f"{args.domain!r}",
            file=sys.stderr,
        )
        return 2
    if args.image_features:
        add_image_features(to_add)
    n = store.add_items(to_add)
    print(
        f"added {n} new item(s) to domain {args.domain!r} "
        f"({len(items) - n} already registered)"
    )
    return 0


def roster_comparisons(items, comparisons):
    """The comparisons restricted to registered items, as the fit uses them.

    Unregistered members are dropped from a set; what is left still says the
    winner beat the remaining members. A set left with fewer than two
    members, or whose winner was dropped, carries no evidence.
    """
    out = []
    for c in comparisons:
        members = [member for member in c.set if member in items]
        if len(members) < 2 or len(set(members)) != len(members):
            continue
        if c.winner is not None and c.winner not in members:
            continue
        out.append(c if members == c.set else replace(c, set=members))
    return out


def _fit_domain(store: Store):
    items = store.load_items()
    comparisons = roster_comparisons(items, store.load_comparisons())
    result = fit(list(items.keys()), comparisons)
    return items, comparisons, result


def require_items(args, items, minimum: int = 1) -> bool:
    if len(items) >= minimum:
        return True
    print(
        f"domain {args.domain!r} has {len(items)} item(s), fewer than {minimum} "
        f"-- `sinnix rank add {args.domain} --items ...`",
        file=sys.stderr,
    )
    return False


def evidence_report(items, comparisons, result, stability, stop_at: float) -> dict:
    """What the comparisons do and do not support.

    A Plackett-Luce fit always returns a total order; whether that order means
    anything is a separate question with three ways to answer no, and a
    consumer that reads only `ranked()` cannot tell them apart. Items in
    different connected components have never been compared even transitively,
    so their thetas are anchored only to the virtual tie and are not mutually
    comparable at all. Few comparisons leave the top-k unstable under the
    fit's own standard errors. Items with no comparisons at all are placed by
    the anchor, not by evidence.
    """
    judged = [c for c in comparisons if c.kind in ("pair", "choice-set")]
    components = sorted({record.component for record in result.records.values()})
    unjudged = sorted(
        record.id for record in result.records.values() if record.matches <= 0
    )
    connected = len(components) <= 1
    reasons: list[str] = []
    if not judged:
        reasons.append("no operator comparisons recorded yet")
    if not connected:
        reasons.append(
            f"{len(components)} disconnected comparison components: items in "
            f"different components have never been compared, even transitively, "
            f"so their order is not evidence"
        )
    if unjudged:
        reasons.append(
            f"{len(unjudged)} item(s) carry no comparison: "
            + ", ".join(unjudged[:5])
            + ("..." if len(unjudged) > 5 else "")
        )
    if stability.p_stable < stop_at:
        reasons.append(
            f"top-{stability.k} stability {stability.p_stable:.0%} is below the "
            f"{stop_at:.0%} threshold"
        )
    return {
        "items": len(items),
        "comparisons": len(comparisons),
        "operator_comparisons": len(judged),
        "components": len(components),
        "connected": connected,
        "unjudged_items": unjudged,
        "stop_at": stop_at,
        "settled": not reasons,
        "reasons": reasons,
    }


def cmd_status(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if not require_items(args, items):
        return 1
    stability = top_k_stability(result, k=args.k, seed=args.seed)
    ranked = result.ranked()
    evidence = evidence_report(items, comparisons, result, stability, args.stop_at)
    if args.json:
        print(
            json.dumps(
                {
                    "domain": args.domain,
                    "domain_dir": str(domain_dir(args.domain)),
                    "items": [
                        {
                            "id": r.id,
                            "label": items[r.id].label,
                            "theta": r.theta,
                            "se": r.se,
                            "matches": r.matches,
                            "component": r.component,
                        }
                        for r in ranked
                    ],
                    "stability": {
                        "top_k": stability.top_k,
                        "p_stable": stability.p_stable,
                        "k": stability.k,
                    },
                    "comparisons": len(comparisons),
                    "evidence": evidence,
                },
                indent=2,
            )
        )
        return 0
    for i, r in enumerate(ranked, start=1):
        print(
            f"{i:>3}. {items[r.id].label}  theta={r.theta:+.3f} se={r.se:.3f} "
            f"matches={r.matches:.0f} comp={r.component}"
        )
    print(
        f"\ntop-{stability.k} stability: {stability.p_stable:.0%} "
        f"({', '.join(items[i].label for i in stability.top_k)})"
    )
    if evidence["settled"]:
        print(f"settled: the top-{stability.k} order is supported by the comparisons")
    else:
        print("NOT settled -- this order is a working hypothesis:")
        for reason in evidence["reasons"]:
            print(f"  - {reason}")
    print(f"domain dir: {domain_dir(args.domain)}")
    return 0


def cmd_next(args: argparse.Namespace) -> int:
    """The next set to put in front of the operator, without owning a TTY.

    `compare` is the operator's own loop; an agent mediating a comparison pass
    holds the conversation instead, so it needs the selection and the
    recording as two separate non-interactive calls.
    """
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if not require_items(args, items, args.grid):
        return 1
    selector = build_selector(
        list(items),
        comparisons,
        result,
        grid_n=args.grid,
        rng=random.Random(args.seed),
    )
    seen = set(selector.seen_sets)
    chosen, strategy = selector.pick_set()
    payload = {
        "domain": args.domain,
        "strategy": strategy,
        "already_judged": frozenset(chosen) in seen,
        "set": [{"id": item_id, "label": items[item_id].label} for item_id in chosen],
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"({strategy})")
    for i, item_id in enumerate(chosen, start=1):
        print(f"  {i}. {items[item_id].label}  [{item_id}]")
    return 0


def cmd_record(args: argparse.Namespace) -> int:
    """One operator judgment, from a caller that already asked the question."""
    store = Store(domain_dir(args.domain))
    items = store.load_items()
    set_ids = [part.strip() for part in args.set.split(",") if part.strip()]
    unknown = [item_id for item_id in set_ids if item_id not in items]
    if unknown:
        print(f"unknown item id(s): {', '.join(unknown)}", file=sys.stderr)
        return 2
    if len(set_ids) < 2:
        print("a comparison needs at least two items", file=sys.stderr)
        return 2
    if len(set(set_ids)) != len(set_ids):
        print("an item cannot be compared against itself", file=sys.stderr)
        return 2
    kind = args.kind
    if kind == "pair" and len(set_ids) > 2:
        kind = "choice-set"
    if args.tie:
        if kind != "pair" or args.winner is not None:
            print("--tie applies to a two-item pair without --winner", file=sys.stderr)
            return 2
    elif kind in ("pair", "choice-set"):
        if args.winner is None:
            print(f"a {kind} comparison needs --winner (or --tie)", file=sys.stderr)
            return 2
        if args.winner not in set_ids:
            print(f"winner {args.winner!r} is not in the compared set", file=sys.stderr)
            return 2
    comparison_id = store.record_comparison(
        set_ids,
        winner=args.winner if kind in ("pair", "choice-set") else None,
        kind=kind,
        context=args.context,
    )
    print(comparison_id)
    return 0


def cmd_retract(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    known = {c.id for c in store.load_comparisons()}
    if args.comparison not in known:
        print(
            f"no live comparison {args.comparison!r} in domain {args.domain!r}",
            file=sys.stderr,
        )
        return 2
    store.undo(args.comparison)
    print(f"tombstoned {args.comparison}")
    return 0


def cmd_compare(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if not require_items(args, items, args.grid):
        return 1

    selector = build_selector(list(items), comparisons, result, grid_n=args.grid)
    last_id: str | None = None
    tie = " 't' tie," if args.grid == 2 else ""

    for round_n in range(1, args.rounds + 1):
        chosen, strategy = selector.pick_set()
        print(f"\n[{round_n}/{args.rounds}] ({strategy})")
        for i, item_id in enumerate(chosen, start=1):
            print(f"  {i}. {items[item_id].label}")
        try:
            answer = (
                input(f"  pick number,{tie} 's' skip, 'u' undo, 'q' quit: ")
                .strip()
                .lower()
            )
        except EOFError:
            break
        if answer == "q":
            break
        if answer == "u":
            if last_id:
                store.undo(last_id)
                print("  undone")
                last_id = None
            continue
        if answer == "s":
            store.record_comparison(
                chosen, winner=None, kind="skip", context=args.context
            )
            continue
        if answer == "t" and args.grid == 2:
            winner = None
        elif answer.isdigit() and 1 <= int(answer) <= len(chosen):
            winner = chosen[int(answer) - 1]
        else:
            print("  not understood, skipping")
            continue
        last_id = store.record_comparison(
            chosen,
            winner=winner,
            kind="pair" if args.grid == 2 else "choice-set",
            context=args.context,
        )

        comparisons = roster_comparisons(items, store.load_comparisons())
        result = fit(list(items.keys()), comparisons)
        selector.update_fit(result)

        if round_n % args.report_every == 0:
            stability = top_k_stability(result, k=args.k)
            print(f"  top-{stability.k} stability: {stability.p_stable:.0%}")
            if stability.p_stable >= args.stop_at:
                print(f"  reached stability threshold ({args.stop_at:.0%}); stopping")
                break
    return 0


def cmd_spin(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, _comparisons, result = _fit_domain(store)
    if not require_items(args, items):
        return 1
    kwargs = {}
    if args.policy == "softmax":
        kwargs["temperature"] = args.softmax_temperature
    picked = draw(result, policy=args.policy, **kwargs)
    if picked is None:
        print("no items to draw from")
        return 1
    print(f"{items[picked].label}  ({args.policy}, id={picked})")
    return 0


def iter_domains():
    """Every domain under the root: a directory holding an items registry."""
    if not CAPTURE_ROOT.is_dir():
        return
    for registry in sorted(CAPTURE_ROOT.rglob("items.jsonl")):
        yield registry.parent.relative_to(CAPTURE_ROOT).as_posix()


def cmd_list(_args: argparse.Namespace) -> int:
    for name in iter_domains():
        store = Store(domain_dir(name))
        items = store.load_items()
        comparisons = store.load_comparisons()
        print(f"{name}: {len(items)} items, {len(comparisons)} comparisons")
    return 0


# ──────────────────────────────────────────────────────────────────────────
# explain: which item features the operator's choices track
# ──────────────────────────────────────────────────────────────────────────
def _logistic(x):
    if x >= 0:
        z = math.exp(-x)
        return 1 / (1 + z)
    z = math.exp(x)
    return z / (1 + z)


def pair_outcome(comparison):
    """(a, b, y) for a two-item judgment: y=1 a won, 0 b won, 0.5 a tie."""
    if comparison.kind != "pair" or len(comparison.set) != 2:
        return None
    a, b = comparison.set
    if comparison.winner is None:
        return a, b, 0.5
    if comparison.winner == a:
        return a, b, 1.0
    if comparison.winner == b:
        return a, b, 0.0
    return None


def explain(items, comparisons, result):
    """Regress standardised feature deltas on the operator's pair choices.

    A question about the items rather than the ranking, so it reads the
    `features` an image domain's items carry (`add --image-features`).
    """
    feats = {}
    for item_id, item in items.items():
        f = item.meta.get("features")
        if isinstance(f, dict):
            feats[item_id] = {k: float(v) for k, v in f.items()}
    if not feats:
        return {
            "note": "no items carry feature vectors; explain has nothing to work with"
        }
    keys = sorted({k for f in feats.values() for k in f})

    def std(k):
        vals = [f[k] for f in feats.values() if k in f]
        if len(vals) < 2:
            return None
        m = sum(vals) / len(vals)
        v = sum((x - m) ** 2 for x in vals) / (len(vals) - 1)
        return math.sqrt(v) or None

    stds = {k: std(k) for k in keys}
    usable = [k for k in keys if stds[k]]

    rows = []
    for c in comparisons:
        outcome = pair_outcome(c)
        if outcome is None:
            continue
        a, b, y = outcome
        fa, fb = feats.get(a), feats.get(b)
        if not (fa and fb):
            continue
        rows.append(([(fa.get(k, 0.0) - fb.get(k, 0.0)) / stds[k] for k in usable], y))

    weights = [0.0] * len(usable)
    if rows:
        lam = 1.0 / len(rows)
        lr = 0.5
        for _ in range(2000):
            grad = [lam * w for w in weights]
            for x, y in rows:
                p = _logistic(sum(w * xi for w, xi in zip(weights, x, strict=True)))
                for i, xi in enumerate(x):
                    grad[i] += (p - y) * xi / len(rows)
            weights = [w - lr * g for w, g in zip(weights, grad, strict=True)]

    records = result.records

    def pearson(k):
        pts = [
            (feats[i][k], records[i].theta)
            for i in feats
            if k in feats[i] and i in records
        ]
        if len(pts) < 3:
            return None
        mx = sum(p[0] for p in pts) / len(pts)
        my = sum(p[1] for p in pts) / len(pts)
        sx = math.sqrt(sum((p[0] - mx) ** 2 for p in pts))
        sy = math.sqrt(sum((p[1] - my) ** 2 for p in pts))
        if not sx or not sy:
            return None
        return sum((p[0] - mx) * (p[1] - my) for p in pts) / (sx * sy)

    features = []
    for k, w in zip(usable, weights, strict=True):
        corr = pearson(k)
        features.append(
            {
                "feature": k,
                "choice_weight": round(w, 4),
                "theta_correlation": round(corr, 4) if corr is not None else None,
            }
        )
    features.sort(key=lambda r: -abs(r["choice_weight"]))
    return {
        "n_comparisons_used": len(rows),
        "reading": "choice_weight > 0 means the operator tends to pick the item with the HIGHER value of that feature; theta_correlation is the same question asked of the fitted ranking. Agreement in sign across both = a real pattern; treat |weight| on <10 comparisons as anecdote.",
        "features": features,
    }


def cmd_explain(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if not require_items(args, items):
        return 1
    report = explain(items, comparisons, result)
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    if "features" not in report:
        print(report.get("note", "nothing to explain"))
        return 0
    print(f"{report['n_comparisons_used']} feature-bearing comparisons")
    print(f"({report['reading']})")
    for f in report["features"]:
        corr = f["theta_correlation"]
        corr_s = f"{corr:+.2f}" if corr is not None else "  n/a"
        print(f"  {f['choice_weight']:+7.3f}  (θ-corr {corr_s})  {f['feature']}")
    return 0


