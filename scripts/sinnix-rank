#!/usr/bin/env python3
# @sinnix-package
# description: Pairwise/choice-set preference ranking CLI (backlog, ideas, any list) over the shared rank-core engine
# runtimeInputs: coreutils @sinnix-steer
# pythonPackages: @sinnix-rank-core

"""Text frontend for rank_core: register items into a domain, run resorter-
style pairwise prompting sessions, check the fitted ranking + stopping
statement, and draw one item per a configurable policy (Thompson sampling by
default) -- optionally committing the draw into steering as a forecastable
intention.

Store convention (design doc section 2): raw comparisons/items are
behavioral capture, kept forever under
/realm/data/activity/ranking/<domain>/; derived fits are never written back
into that directory, so a full refit from raw comparisons stays reproducible
at any time -- `status`/`spin` always refit in memory rather than trusting a
cached theta file.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import subprocess
import sys
from pathlib import Path

from rank_core import Item, Selector, Store, draw, fit, top_k_stability
from rank_core.draw import POLICIES
from rank_core.store import VALID_KINDS

CAPTURE_ROOT = Path(
    os.environ.get("SINNIX_RANK_ROOT", "/realm/data/activity/ranking")
)
BACKLOG_ACTIVITY_NAME = "backlog session"

#: Below this top-k stability the fitted order is a working hypothesis, not an
#: answer. `status` refuses to call anything settled under it, and every
#: consumer reads `evidence.settled` rather than re-deriving a threshold.
DEFAULT_STOP_AT = 0.9


def domain_dir(domain: str) -> Path:
    return CAPTURE_ROOT / domain


def load_items_input(raw: str) -> list[Item]:
    """Accepts a JSON array (e.g. `bd ready --json`) or JSONL, one object per
    line. Each record needs an id; label falls back to `title` (bd's field)
    then the id itself. Every other field is carried through as meta.
    """
    raw = raw.strip()
    if not raw:
        return []
    try:
        parsed = json.loads(raw)
        records = parsed if isinstance(parsed, list) else [parsed]
    except json.JSONDecodeError:
        records = [json.loads(line) for line in raw.splitlines() if line.strip()]

    items = []
    for rec in records:
        if not isinstance(rec, dict) or "id" not in rec:
            raise ValueError(f"item record missing 'id': {rec!r}")
        item_id = str(rec["id"])
        label = rec.get("label") or rec.get("title") or item_id
        meta = {k: v for k, v in rec.items() if k not in ("id", "label")}
        items.append(Item(id=item_id, label=label, meta=meta))
    return items


def check_identity(
    incoming: list[Item],
    existing: dict[str, Item],
    *,
    allow_duplicate_labels: bool,
    revise: bool,
) -> tuple[list[Item], list[str]]:
    """Split *incoming* into items to append and identity conflicts to refuse.

    An id is a promise: comparisons already recorded against it are evidence
    about the option that id named. So a re-`add` under an id that already
    carries a different label is a changed option set, not an update, and it
    is refused unless the caller says explicitly which of the two it means --
    `--revise` to relabel the same option, or a fresh id for a new one.
    Duplicate labels are refused for the mirror-image reason: two options the
    operator cannot tell apart in a prompt produce comparisons that cannot be
    attributed afterwards.
    """
    conflicts: list[str] = []
    to_add: list[Item] = []
    labels: dict[str, str] = {} if allow_duplicate_labels else {
        item.label: item_id for item_id, item in existing.items()
    }
    for item in incoming:
        prior = existing.get(item.id)
        if prior is not None and prior.label != item.label and not revise:
            conflicts.append(
                f"{item.id}: already registered as {prior.label!r}, now given as "
                f"{item.label!r} -- use a new id for a new option, or --revise "
                f"to relabel the same one"
            )
            continue
        if prior is not None and prior.label == item.label:
            continue
        owner = labels.get(item.label)
        if owner is not None and owner != item.id:
            conflicts.append(
                f"{item.id}: label {item.label!r} is already item {owner} -- "
                f"disambiguate the label, or pass --allow-duplicate-labels"
            )
            continue
        if not allow_duplicate_labels:
            labels[item.label] = item.id
        to_add.append(item)
    return to_add, conflicts


def cmd_add(args: argparse.Namespace) -> int:
    raw = sys.stdin.read() if args.items == "-" else Path(args.items).read_text()
    items = load_items_input(raw)
    store = Store(domain_dir(args.domain))
    existing = store.load_items()
    to_add, conflicts = check_identity(
        items,
        existing,
        allow_duplicate_labels=args.allow_duplicate_labels,
        revise=args.revise,
    )
    if conflicts:
        for message in conflicts:
            print(f"identity conflict: {message}", file=sys.stderr)
        print(
            f"refused {len(conflicts)} item(s); nothing was written to domain "
            f"{args.domain!r}",
            file=sys.stderr,
        )
        return 2
    n = store.add_items(to_add)
    print(
        f"added {n} new item(s) to domain {args.domain!r} "
        f"({len(items) - n} already registered)"
    )
    return 0


def _fit_domain(store: Store):
    items = store.load_items()
    comparisons = store.load_comparisons()
    result = fit(list(items.keys()), comparisons)
    return items, comparisons, result


def evidence_report(items, comparisons, result, stability, stop_at: float) -> dict:
    """What the comparisons do and do not support.

    A Plackett-Luce fit always returns a total order; whether that order means
    anything is a separate question with three ways to answer no, and a
    consumer that reads only `ranked()` cannot tell them apart. Items in
    different connected components have never been compared even transitively,
    so their thetas are anchored only to the virtual tie and are not mutually
    comparable at all. Few comparisons leave the top-k unstable under the
    fit's own standard errors. Items with no comparisons at all are placed by
    the anchor, not by evidence.
    """
    judged = [c for c in comparisons if c.kind in ("pair", "choice-set")]
    components = sorted({record.component for record in result.records.values()})
    unjudged = sorted(
        record.id for record in result.records.values() if record.matches <= 0
    )
    connected = len(components) <= 1
    reasons: list[str] = []
    if not judged:
        reasons.append("no operator comparisons recorded yet")
    if not connected:
        reasons.append(
            f"{len(components)} disconnected comparison components: items in "
            f"different components have never been compared, even transitively, "
            f"so their order is not evidence"
        )
    if unjudged:
        reasons.append(
            f"{len(unjudged)} item(s) carry no comparison: "
            + ", ".join(unjudged[:5])
            + ("..." if len(unjudged) > 5 else "")
        )
    if stability.p_stable < stop_at:
        reasons.append(
            f"top-{stability.k} stability {stability.p_stable:.0%} is below the "
            f"{stop_at:.0%} threshold"
        )
    return {
        "items": len(items),
        "comparisons": len(comparisons),
        "operator_comparisons": len(judged),
        "components": len(components),
        "connected": connected,
        "unjudged_items": unjudged,
        "stop_at": stop_at,
        "settled": not reasons,
        "reasons": reasons,
    }


def cmd_status(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if not items:
        print(f"domain {args.domain!r} has no items yet -- `sinnix-rank add {args.domain} --items ...`")
        return 1
    stability = top_k_stability(result, k=args.k, seed=args.seed)
    ranked = result.ranked()
    evidence = evidence_report(items, comparisons, result, stability, args.stop_at)
    if args.json:
        print(
            json.dumps(
                {
                    "domain": args.domain,
                    "domain_dir": str(domain_dir(args.domain)),
                    "items": [
                        {
                            "id": r.id,
                            "label": items[r.id].label if r.id in items else r.id,
                            "theta": r.theta,
                            "se": r.se,
                            "matches": r.matches,
                            "component": r.component,
                        }
                        for r in ranked
                    ],
                    "stability": {"top_k": stability.top_k, "p_stable": stability.p_stable, "k": stability.k},
                    "comparisons": len(comparisons),
                    "evidence": evidence,
                },
                indent=2,
            )
        )
        return 0
    for i, r in enumerate(ranked, start=1):
        label = items[r.id].label if r.id in items else r.id
        print(f"{i:>3}. {label}  theta={r.theta:+.3f} se={r.se:.3f} matches={r.matches:.0f} comp={r.component}")
    print(
        f"\ntop-{stability.k} stability: {stability.p_stable:.0%} "
        f"({', '.join(items[i].label if i in items else i for i in stability.top_k)})"
    )
    if evidence["settled"]:
        print(f"settled: the top-{stability.k} order is supported by the comparisons")
    else:
        print("NOT settled -- this order is a working hypothesis:")
        for reason in evidence["reasons"]:
            print(f"  - {reason}")
    print(f"domain dir: {domain_dir(args.domain)}")
    return 0


def _seen_sets(comparisons) -> set[frozenset[str]]:
    return {frozenset(c.set) for c in comparisons}


def _selector(items, comparisons, result, grid: int, seed: int | None) -> Selector:
    selector = Selector(
        item_ids=list(items.keys()),
        grid_n=grid,
        rng=random.Random(seed),
    )
    selector.seed_counts(comparisons)
    selector.update_fit(result)
    return selector


def cmd_next(args: argparse.Namespace) -> int:
    """The next set to put in front of the operator, without owning a TTY.

    `compare` is the operator's own loop; an agent mediating a comparison pass
    holds the conversation instead, so it needs the selection and the
    recording as two separate non-interactive calls. Sets already judged are
    skipped where the selector offers an unjudged alternative, so a resumed
    pass spends its questions on new information rather than re-asking.
    """
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if len(items) < args.grid:
        print(
            f"domain {args.domain!r} has {len(items)} item(s), fewer than the "
            f"requested set size {args.grid}",
            file=sys.stderr,
        )
        return 1
    selector = _selector(items, comparisons, result, args.grid, args.seed)
    seen = _seen_sets(comparisons)
    chosen, strategy = selector.pick_set()
    for _ in range(32):
        if frozenset(chosen) not in seen:
            break
        chosen, strategy = selector.pick_set()
    payload = {
        "domain": args.domain,
        "strategy": strategy,
        "already_judged": frozenset(chosen) in seen,
        "set": [
            {"id": item_id, "label": items[item_id].label} for item_id in chosen
        ],
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"({strategy})")
    for i, item_id in enumerate(chosen, start=1):
        print(f"  {i}. {items[item_id].label}  [{item_id}]")
    return 0


def cmd_record(args: argparse.Namespace) -> int:
    """One operator judgment, from a caller that already asked the question."""
    store = Store(domain_dir(args.domain))
    items = store.load_items()
    set_ids = [part.strip() for part in args.set.split(",") if part.strip()]
    unknown = [item_id for item_id in set_ids if item_id not in items]
    if unknown:
        print(f"unknown item id(s): {', '.join(unknown)}", file=sys.stderr)
        return 2
    if len(set_ids) < 2:
        print("a comparison needs at least two items", file=sys.stderr)
        return 2
    if len(set(set_ids)) != len(set_ids):
        print("an item cannot be compared against itself", file=sys.stderr)
        return 2
    kind = args.kind
    if kind == "pair" and len(set_ids) > 2:
        kind = "choice-set"
    if kind in ("pair", "choice-set"):
        if args.winner is None:
            print(f"a {kind} comparison needs --winner", file=sys.stderr)
            return 2
        if args.winner not in set_ids:
            print(
                f"winner {args.winner!r} is not in the compared set",
                file=sys.stderr,
            )
            return 2
    comparison_id = store.record_comparison(
        set_ids,
        winner=args.winner if kind in ("pair", "choice-set") else None,
        kind=kind,
        context=args.context,
    )
    print(comparison_id)
    return 0


def cmd_retract(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    known = {c.id for c in store.load_comparisons()}
    if args.comparison not in known:
        print(
            f"no live comparison {args.comparison!r} in domain {args.domain!r}",
            file=sys.stderr,
        )
        return 2
    store.undo(args.comparison)
    print(f"tombstoned {args.comparison}")
    return 0


def cmd_compare(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, comparisons, result = _fit_domain(store)
    if len(items) < args.grid:
        print(f"domain {args.domain!r} has fewer than {args.grid} items -- add more first")
        return 1

    selector = Selector(item_ids=list(items.keys()), grid_n=args.grid)
    selector.seed_counts(comparisons)
    selector.update_fit(result)
    last_id: str | None = None

    for round_n in range(1, args.rounds + 1):
        chosen, strategy = selector.pick_set()
        print(f"\n[{round_n}/{args.rounds}] ({strategy})")
        for i, item_id in enumerate(chosen, start=1):
            print(f"  {i}. {items[item_id].label}")
        answer = input("  pick number, 's' skip, 'u' undo, 'q' quit: ").strip().lower()
        if answer == "q":
            break
        if answer == "u":
            if last_id:
                store.undo(last_id)
                print("  undone")
                last_id = None
            continue
        if answer == "s":
            store.record_comparison(chosen, winner=None, kind="skip", context=args.context)
            continue
        if not answer.isdigit() or not (1 <= int(answer) <= len(chosen)):
            print("  not understood, skipping")
            continue
        winner = chosen[int(answer) - 1]
        last_id = store.record_comparison(chosen, winner=winner, kind="pair" if args.grid == 2 else "choice-set", context=args.context)

        comparisons = store.load_comparisons()
        result = fit(list(items.keys()), comparisons)
        selector.update_fit(result)

        if round_n % args.report_every == 0:
            stability = top_k_stability(result, k=args.k)
            print(f"  top-{stability.k} stability: {stability.p_stable:.0%}")
            if stability.p_stable >= args.stop_at:
                print(f"  reached stability threshold ({args.stop_at:.0%}); stopping")
                break
    return 0


def cmd_spin(args: argparse.Namespace) -> int:
    store = Store(domain_dir(args.domain))
    items, _comparisons, result = _fit_domain(store)
    if not items:
        print(f"domain {args.domain!r} has no items yet")
        return 1
    kwargs = {}
    if args.policy == "softmax":
        kwargs["temperature"] = args.softmax_temperature
    picked = draw(result, policy=args.policy, **kwargs)
    if picked is None:
        print("no items to draw from")
        return 1
    label = items[picked].label if picked in items else picked
    print(f"{label}  ({args.policy}, id={picked})")

    if args.commit:
        return _commit_to_steering(args.domain, picked, label, args.forecast, args.window_days)
    return 0


def _steer(*argv: str) -> tuple[int, str, str]:
    proc = subprocess.run(["sinnix-steer", *argv], capture_output=True, text=True, timeout=30)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def _find_or_create_backlog_activity() -> str | None:
    rc, out, err = _steer("activity", "menu", "--json")
    if rc == 0:
        for activity in json.loads(out):
            if activity["name"] == BACKLOG_ACTIVITY_NAME:
                return activity["id"]
    rc, out, err = _steer(
        "activity", "add", BACKLOG_ACTIVITY_NAME,
        "--kind", "task", "--energy", "any",
        "--notes", "standing activity for sinnix-rank spin --commit draws",
    )
    if rc != 0:
        print(f"  could not create steering activity: {err}", file=sys.stderr)
        return None
    # cmd_activity_add prints "activity {aid}: {name} (...)"
    return out.split(":", 1)[0].removeprefix("activity ").strip()


def _commit_to_steering(domain: str, item_id: str, label: str, forecast: float, window_days: int) -> int:
    import datetime as dt

    activity_id = _find_or_create_backlog_activity()
    window_start = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    window_end = (dt.datetime.now(dt.timezone.utc) + dt.timedelta(days=window_days)).isoformat(timespec="seconds")
    text = f"watch {domain} / act on {item_id}: {label}"
    steer_args = ["intent", "add", text, "--window-start", window_start, "--window-end", window_end]
    if forecast is not None:
        steer_args += ["--forecast", str(forecast)]
    if activity_id:
        steer_args += ["--activity", activity_id]
    rc, out, err = _steer(*steer_args)
    if rc != 0:
        print(f"  steering commit failed: {err}", file=sys.stderr)
        return 1
    print(f"  committed: {out}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Pairwise preference ranking over any domain")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="register items into a domain")
    add.add_argument("domain")
    add.add_argument("--items", required=True, help="path to a JSON array or JSONL of {id,label,...}, or '-' for stdin")
    add.add_argument(
        "--allow-duplicate-labels",
        action="store_true",
        help="register options that share a label (they become indistinguishable in prompts)",
    )
    add.add_argument(
        "--revise",
        action="store_true",
        help="relabel existing ids instead of refusing them; comparisons already recorded against the id are kept",
    )
    add.set_defaults(func=cmd_add)

    nxt = sub.add_parser("next", help="print the next comparison set without prompting")
    nxt.add_argument("domain")
    nxt.add_argument("--grid", type=int, default=2, help="items per choice set (2 = pairwise)")
    nxt.add_argument("--seed", type=int, default=None)
    nxt.add_argument("--json", action="store_true")
    nxt.set_defaults(func=cmd_next)

    record = sub.add_parser("record", help="record one operator judgment non-interactively")
    record.add_argument("domain")
    record.add_argument("--set", required=True, help="comma-separated item ids that were compared")
    record.add_argument("--winner", default=None, help="the id the operator chose")
    record.add_argument(
        "--kind",
        default="pair",
        choices=sorted(VALID_KINDS),
        help="pair/choice-set need a winner; skip and incomparable do not",
    )
    record.add_argument("--context", default=None)
    record.set_defaults(func=cmd_record)

    retract = sub.add_parser("retract", help="tombstone one recorded comparison")
    retract.add_argument("domain")
    retract.add_argument("--comparison", required=True)
    retract.set_defaults(func=cmd_retract)

    compare = sub.add_parser("compare", help="interactive pairwise/choice-set prompting session")
    compare.add_argument("domain")
    compare.add_argument("--grid", type=int, default=2, help="items per choice set (2 = pairwise)")
    compare.add_argument("--rounds", type=int, default=20)
    compare.add_argument("--report-every", type=int, default=5)
    compare.add_argument("--k", type=int, default=1, help="top-k for the stopping statistic")
    compare.add_argument("--stop-at", type=float, default=DEFAULT_STOP_AT)
    compare.add_argument("--context", default=None)
    compare.set_defaults(func=cmd_compare)

    status = sub.add_parser("status", help="show the fitted ranking + stopping statement")
    status.add_argument("domain")
    status.add_argument("--k", type=int, default=1)
    status.add_argument("--stop-at", type=float, default=DEFAULT_STOP_AT)
    status.add_argument("--seed", type=int, default=None)
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)

    spin = sub.add_parser("spin", help="draw one item per a draw policy")
    spin.add_argument("domain")
    policy_group = spin.add_mutually_exclusive_group()
    policy_group.add_argument("--top", action="store_const", dest="policy", const="top")
    policy_group.add_argument("--thompson", action="store_const", dest="policy", const="thompson")
    policy_group.add_argument("--softmax", type=float, dest="softmax_temperature", default=None)
    spin.set_defaults(policy="thompson")
    spin.add_argument("--commit", action="store_true", help="insert the draw into steering as a commitment")
    spin.add_argument("--forecast", type=float, default=None, help="follow-through probability (0-1) for the steering commitment")
    spin.add_argument("--window-days", type=int, default=3, help="steering commitment validity window")
    spin.set_defaults(func=cmd_spin)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "spin":
        if getattr(args, "softmax_temperature", None) is not None:
            args.policy = "softmax"
        if args.policy not in POLICIES:
            parser.error(f"unknown policy {args.policy!r}")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
