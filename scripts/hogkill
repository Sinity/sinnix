#!/usr/bin/env bash
# @sinnix-package
# description: Interactive resource hog inspector and killer
# runtimeInputs: bash coreutils gum procps gawk gnugrep gnused systemd sqlite jq
set -euo pipefail

export LC_ALL=C

usage() {
  cat <<'EOF'
usage: hogkill [options]

Inspect CPU/memory-heavy processes, show their systemd unit context, and
optionally stop/kill the selected process or unit.

Options:
  -s, --sort cpu|mem|rss|pss_anon   Sort rows by CPU, MEM, RSS, or anonymous PSS (default: pss_anon)
  -n, --limit N            Number of rows to show (default: 30)
      --unit UNIT          Show processes in a specific systemd unit/cgroup
      --list               Print the table and exit
      --dry-run            Show the selected action without executing it
      --no-interactive     Disable gum prompts; implies --list unless --pid is set
      --pid PID            Act on a specific PID instead of opening the picker
      --json               Emit the bounded candidate model as JSON and exit
      --processes          Include the per-process table after cgroup rows
      --trajectory         Print telemetry trajectory for --pid or the selected row
  -h, --help               Show this help

Examples:
  hogkill
  hogkill --sort mem --limit 50
  hogkill --unit polylogued.service --list
  hogkill --pid 12345 --dry-run
EOF
}

sort_key="pss_anon"
limit=30
unit_filter=""
list_only=0
dry_run=0
interactive=1
selected_pid=""
json_mode=0
processes_mode=0
trajectory_mode=0
thaw_after=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--sort)
      sort_key="${2:-}"
      shift 2
      ;;
    -n|--limit)
      limit="${2:-}"
      shift 2
      ;;
    --unit)
      unit_filter="${2:-}"
      shift 2
      ;;
    --list)
      list_only=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --no-interactive)
      interactive=0
      shift
      ;;
    --pid)
      selected_pid="${2:-}"
      shift 2
      ;;
    --json)
      json_mode=1
      list_only=1
      interactive=0
      shift
      ;;
    --processes)
      processes_mode=1
      shift
      ;;
    --trajectory)
      trajectory_mode=1
      shift
      ;;
    --thaw-after)
      thaw_after="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "hogkill: unknown option: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

case "$sort_key" in
  cpu|mem|rss|pss_anon) ;;
  *)
    echo "hogkill: --sort must be cpu, mem, rss, or pss_anon" >&2
    exit 64
    ;;
esac

case "$limit" in
  ''|*[!0-9]*)
    echo "hogkill: --limit must be a positive integer" >&2
    exit 64
    ;;
esac
if [ "$limit" -lt 1 ]; then
  echo "hogkill: --limit must be greater than zero" >&2
  exit 64
fi
case "$thaw_after" in
  ''|*[!0-9]*)
    echo "hogkill: --thaw-after must be a non-negative integer" >&2
    exit 64
    ;;
esac

if [ "$interactive" -eq 0 ] && [ -z "$selected_pid" ]; then
  list_only=1
fi

have_gum=0
if command -v gum >/dev/null 2>&1; then
  have_gum=1
fi
if [ "$interactive" -eq 1 ] && [ "$list_only" -eq 0 ] && [ "$have_gum" -eq 0 ]; then
  echo "hogkill: gum is unavailable; use --list or install gum for interactive actions" >&2
  exit 69
fi

tmp_dir="$(mktemp -d -t hogkill.XXXXXX)"
rows_tsv="$tmp_dir/rows.tsv"
cgroup_rows_tsv="$tmp_dir/cgroup-rows.tsv"
table_txt="$tmp_dir/table.txt"
trap 'rm -rf "$tmp_dir"' EXIT

proc_root="${SINNIX_HOGKILL_PROC_ROOT:-/proc}"
cgroup_root="${SINNIX_HOGKILL_CGROUP_ROOT:-/sys/fs/cgroup}"

bytes_human() {
  awk -v bytes="${1:-0}" 'BEGIN {
    split("B KiB MiB GiB TiB", units, " ");
    value = bytes + 0;
    unit = 1;
    while (value >= 1024 && unit < 5) {
      value = value / 1024;
      unit++;
    }
    if (unit == 1) {
      printf "%d %s", value, units[unit];
    } else if (value >= 10) {
      printf "%.1f %s", value, units[unit];
    } else {
      printf "%.2f %s", value, units[unit];
    }
  }'
}

print_pressure_summary() {
  local mem_total mem_available swap_total swap_free load
  mem_total="$(awk '/^MemTotal:/ {print $2 * 1024}' /proc/meminfo)"
  mem_available="$(awk '/^MemAvailable:/ {print $2 * 1024}' /proc/meminfo)"
  swap_total="$(awk '/^SwapTotal:/ {print $2 * 1024}' /proc/meminfo)"
  swap_free="$(awk '/^SwapFree:/ {print $2 * 1024}' /proc/meminfo)"
  load="$(cut -d' ' -f1-3 /proc/loadavg)"

  echo "Host pressure"
  printf "  load: %s\n" "$load"
  printf "  memory: %s available / %s total\n" "$(bytes_human "$mem_available")" "$(bytes_human "$mem_total")"
  if [ "${swap_total:-0}" -gt 0 ]; then
    printf "  swap: %s free / %s total\n" "$(bytes_human "$swap_free")" "$(bytes_human "$swap_total")"
  fi
  if [ -r /proc/pressure/memory ]; then
    printf "  memory PSI: %s\n" "$(tr '\n' ';' < /proc/pressure/memory | sed 's/;$//')"
  fi
  if [ -r /proc/pressure/io ]; then
    printf "  io PSI: %s\n" "$(tr '\n' ';' < /proc/pressure/io | sed 's/;$//')"
  fi
  echo
}

unit_from_cgroup() {
  local cgroup="$1"
  local unit=""

  unit="$(printf '%s\n' "$cgroup" | grep -oE '[^/]+\.(service|scope)' | tail -n 1 || true)"
  if [ -n "$unit" ]; then
    printf '%s' "$unit"
    return
  fi

  unit="$(printf '%s\n' "$cgroup" | grep -oE '[^/]+\.(timer|socket|target|slice)' | tail -n 1 || true)"
  printf '%s' "$unit"
}

shorten() {
  local max="$1"
  local value="$2"
  if [ "${#value}" -le "$max" ]; then
    printf '%s' "$value"
  else
    printf '%s...' "${value:0:$((max - 3))}"
  fi
}

collect_rows() {
  : > "$rows_tsv"
  : > "$cgroup_rows_tsv"
  ps -eo pid=,user=,%cpu=,%mem=,rss=,stat=,args= --no-headers |
    while read -r pid user cpu mem rss_kib stat cmd; do
      [ -n "${pid:-}" ] || continue
      cgroup="$(sed -n 's/^[^:]*:[^:]*://p' "$proc_root/$pid/cgroup" 2>/dev/null | head -n 1 || true)"
      [ -n "$cgroup" ] || cgroup="-"
      unit="$(unit_from_cgroup "$cgroup")"
      if [ -n "$unit_filter" ] && [[ "$cgroup" != *"$unit_filter"* && "$unit" != "$unit_filter" ]]; then
        continue
      fi
      manager="system"
      if [[ "$cgroup" =~ /user\.slice/user-[0-9]+\.slice/user@[0-9]+\.service/ ]]; then
        manager="user"
      fi
      smaps_rollup="$(cat "$proc_root/$pid/smaps_rollup" 2>/dev/null || sudo -n cat "$proc_root/$pid/smaps_rollup" 2>/dev/null || true)"
      pss_kib="$(awk '/^Pss:/ {print $2; exit}' <<<"$smaps_rollup")"
      pss_anon_kib="$(awk '/^Pss_Anon:/ {print $2; exit}' <<<"$smaps_rollup")"
      swap_kib="$(awk '/^VmSwap:/ {print $2; exit}' "$proc_root/$pid/status" 2>/dev/null || true)"
      pss_kib="${pss_kib:-0}"
      pss_anon_kib="${pss_anon_kib:-0}"
      swap_kib="${swap_kib:-0}"
      warning=""
      if [[ "$cgroup" == *"/sinnix-agent-"* || "$cmd" =~ (claude|codex|kitty) ]]; then
        warning="agent-protected"
      fi
      if [[ "$cmd" =~ (earlyoom|avoid) ]]; then
        warning="${warning:+$warning,}earlyoom-protected"
      fi
      warning="${warning:-none}"
      printf "%s\t%s\t%.1f\t%.1f\t%d\t%d\t%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$pid" "$user" "$cpu" "$mem" "$((rss_kib * 1024))" "$((pss_kib * 1024))" "$((pss_anon_kib * 1024))" "$((swap_kib * 1024))" "$stat" "$manager" "$unit" "$cgroup" "$warning" "${cmd:-}" \
        >> "$rows_tsv"
    done
  collect_cgroup_rows
}

collect_cgroup_rows() {
  local cgroup cgroup_path current anon file swap unit manager
  while IFS= read -r cgroup; do
    [ -n "$cgroup" ] || continue
    [ "$cgroup" != "-" ] || continue
    cgroup_path="$cgroup_root$cgroup"
    [ -d "$cgroup_path" ] || continue
    current="$(cat "$cgroup_path/memory.current" 2>/dev/null || echo 0)"
    anon="$(awk '$1 == "anon" {print $2}' "$cgroup_path/memory.stat" 2>/dev/null || echo 0)"
    file="$(awk '$1 == "file" {print $2}' "$cgroup_path/memory.stat" 2>/dev/null || echo 0)"
    swap="$(cat "$cgroup_path/memory.swap.current" 2>/dev/null || echo 0)"
    unit="$(unit_from_cgroup "$cgroup")"
    manager="system"
    [[ "$cgroup" =~ /user\.slice/user-[0-9]+\.slice/user@[0-9]+\.service/ ]] && manager="user"
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$current" "$anon" "$file" "$swap" "$manager" "$unit" "$cgroup" >> "$cgroup_rows_tsv"
  done < <(cut -f12 "$rows_tsv" | sort -u)
}

sort_rows() {
  case "$sort_key" in
    cpu) sort -t $'\t' -k3,3nr "$rows_tsv" ;;
    mem) sort -t $'\t' -k4,4nr "$rows_tsv" ;;
    rss) sort -t $'\t' -k5,5nr "$rows_tsv" ;;
    pss_anon) sort -t $'\t' -k7,7nr "$rows_tsv" ;;
  esac | awk -v limit="$limit" 'NR <= limit { print }'
}

render_table() {
  {
    printf "%-7s %-12s %6s %6s %10s %10s %10s %10s %-5s %-6s %-24s %s\n" \
      "PID" "USER" "CPU%" "MEM%" "RSS" "PSS" "PSS_ANON" "SWAP" "STAT" "MGR" "UNIT" "COMMAND"
    sort_rows | while IFS=$'\t' read -r pid user cpu mem rss pss pss_anon swap stat manager unit cgroup warning cmd; do
      if [ -z "$unit" ]; then
        unit="-"
      fi
      printf "%-7s %-12s %6s %6s %10s %10s %10s %10s %-5s %-6s %-24s %s\n" \
        "$pid" \
        "$(shorten 12 "$user")" \
        "$cpu" \
        "$mem" \
        "$(bytes_human "$rss")" \
        "$(bytes_human "$pss")" \
        "$(bytes_human "$pss_anon")" \
        "$(bytes_human "$swap")" \
        "$stat" \
        "$manager" \
        "$(shorten 24 "$unit")" \
        "$(shorten 100 "$cmd")"
    done
  } > "$table_txt"
}

render_cgroup_table() {
  local current anon file swap manager unit cgroup
  echo "Cgroup reclaim view"
  printf "%-12s %-12s %-12s %-12s %-6s %-24s %s\n" "CURRENT" "ANON" "FILE" "SWAP" "MGR" "UNIT" "CGROUP"
  sort -t $'\t' -k2,2nr "$cgroup_rows_tsv" | while IFS=$'\t' read -r current anon file swap manager unit cgroup; do
    printf "%-12s %-12s %-12s %-12s %-6s %-24s %s\n" \
      "$(bytes_human "$current")" "$(bytes_human "$anon")" "$(bytes_human "$file")" "$(bytes_human "$swap")" "$manager" "$(shorten 24 "$unit")" "$cgroup"
  done
  echo
}

emit_json() {
  local first=1
  printf '{"pressure":'
  jq -cn --arg load "$(cut -d' ' -f1-3 /proc/loadavg)" '{load:$load}'
  printf ',"cgroups":['
  while IFS=$'\t' read -r current anon file swap manager unit cgroup; do
    [ -n "$current" ] || continue
    [ "$first" -eq 1 ] || printf ','
    first=0
    jq -cn --argjson current "${current:-0}" --argjson anon "${anon:-0}" --argjson file "${file:-0}" --argjson swap "${swap:-0}" --arg manager "$manager" --arg unit "$unit" --arg cgroup "$cgroup" \
      '{current_bytes:$current,anon_bytes:$anon,file_bytes:$file,swap_bytes:$swap,manager:$manager,unit:$unit,cgroup:$cgroup}'
  done < <(sort -t $'\t' -k2,2nr "$cgroup_rows_tsv")
  printf '],"processes":['
  first=1
  sort_rows | while IFS=$'\t' read -r pid user cpu mem rss pss pss_anon swap stat manager unit cgroup warning cmd; do
    [ "$first" -eq 1 ] || printf ','
    first=0
    jq -cn --argjson pid "$pid" --arg user "$user" --argjson cpu "$cpu" --argjson mem "$mem" --argjson rss "$rss" --argjson pss "$pss" --argjson pss_anon "$pss_anon" --argjson swap "$swap" --arg stat "$stat" --arg manager "$manager" --arg unit "$unit" --arg cgroup "$cgroup" --arg warning "$warning" --arg command "$cmd" \
      '{pid:$pid,user:$user,cpu_percent:$cpu,memory_percent:$mem,rss_bytes:$rss,pss_bytes:$pss,pss_anon_bytes:$pss_anon,swap_bytes:$swap,stat:$stat,manager:$manager,unit:$unit,cgroup:$cgroup,warning:(if $warning=="none" then null else $warning end),command:$command}'
  done
  printf ']}\n'
}

trajectory() {
  local pid="$1" start_ticks db row min max latest first_at last_at
  db="${SINNIX_HOGKILL_TELEMETRY_DB:-/realm/data/machine/telemetry.sqlite}"
  [ -r "$db" ] || { echo "trajectory: unavailable (telemetry database missing)"; return 0; }
  start_ticks="$(awk '{print $22}' "$proc_root/$pid/stat" 2>/dev/null || true)"
  [ -n "$start_ticks" ] || { echo "trajectory: unavailable (process identity missing)"; return 0; }
  row="$(sqlite3 -readonly -separator $'\t' "$db" "select min(pss_anon_kb), max(pss_anon_kb), (select pss_anon_kb from process_memory_sample where pid=$pid and process_start_time_ticks=$start_ticks order by observed_at desc limit 1), min(observed_at), max(observed_at) from process_memory_sample where pid=$pid and process_start_time_ticks=$start_ticks and observed_at >= datetime('now','-72 hours');" 2>/dev/null || true)"
  IFS=$'\t' read -r min max latest first_at last_at <<<"$row"
  if [ -z "${min:-}" ] || [ -z "${max:-}" ]; then
    echo "trajectory: unavailable (no matching PID/start-time samples)"
    return 0
  fi
  if [ "$((max - min))" -ge 102400 ]; then
    echo "trajectory: leak signature, ${min} KiB -> ${max} KiB anon PSS, current=${latest} KiB, window=${first_at}..${last_at}"
  else
    echo "trajectory: stable, ${min} KiB..${max} KiB anon PSS, current=${latest} KiB, window=${first_at}..${last_at}"
  fi
}

row_for_pid() {
  local pid="$1"
  awk -F '\t' -v pid="$pid" '$1 == pid { print; found = 1; exit } END { exit found ? 0 : 1 }' "$rows_tsv"
}

describe_row() {
  local row="$1"
  IFS=$'\t' read -r pid user cpu mem rss pss pss_anon swap stat manager unit cgroup warning cmd <<<"$row"
  echo "Selected process"
  printf "  pid:     %s\n" "$pid"
  printf "  user:    %s\n" "$user"
  printf "  usage:   CPU %s%%, MEM %s%%, RSS %s, PSS %s, PSS_ANON %s, SWAP %s, STAT %s\n" "$cpu" "$mem" "$(bytes_human "$rss")" "$(bytes_human "$pss")" "$(bytes_human "$pss_anon")" "$(bytes_human "$swap")" "$stat"
  printf "  manager: %s\n" "$manager"
  printf "  unit:    %s\n" "${unit:-none detected}"
  printf "  cgroup:  %s\n" "$cgroup"
  [ "$warning" != none ] && printf "  warning: %s\n" "$warning"
  printf "  command: %s\n" "$cmd"
}

choose_pid() {
  local selected
  selected="$(
    cat "$table_txt" |
      gum filter \
        --height 24 \
        --placeholder "Search by PID, command, user, or unit..."
  )"
  if [ -z "$selected" ]; then
    echo "hogkill: no process selected"
    exit 0
  fi
  awk '{print $1}' <<<"$selected"
}

run_action() {
  local label="$1"
  shift
  printf "Action: %s\n" "$label"
  printf "Command:"
  printf " %q" "$@"
  printf "\n"

  if [ "$dry_run" -eq 1 ]; then
    echo "Dry run: command not executed."
    return 0
  fi

  "$@"
}

confirm_action() {
  local prompt="$1"
  if [ -n "${warning:-}" ]; then
    [ -n "$unit" ] || { echo "Protected target has no unit identity; refusing action." >&2; return 1; }
    typed="$(gum input --placeholder "Type ${unit} to confirm")"
    [ "$typed" = "$unit" ] || { echo "Confirmation did not match $unit." >&2; return 1; }
    return 0
  fi
  gum confirm "$prompt"
}

unit_systemctl() {
  if [ "$manager" = "user" ]; then
    systemctl --user "$@"
  else
    systemctl "$@"
  fi
}

schedule_thaw() {
  [ "$thaw_after" -gt 0 ] || return 0
  local unit_name="hogkill-thaw-${unit//[^A-Za-z0-9_.@-]/-}"
  if [ "$manager" = "user" ]; then
    run_action "schedule user thaw of $unit after ${thaw_after}s" systemd-run --user --unit="$unit_name" --on-active="${thaw_after}s" systemctl --user thaw "$unit"
  else
    run_action "schedule system thaw of $unit after ${thaw_after}s" systemd-run --unit="$unit_name" --on-active="${thaw_after}s" systemctl thaw "$unit"
  fi
}

verify_pid_gone_or_report() {
  local pid="$1"
  sleep 0.5
  if kill -0 "$pid" 2>/dev/null; then
    echo "PID $pid is still running."
    return 1
  fi
  echo "PID $pid is gone."
}

collect_rows
render_table

if [ ! -s "$rows_tsv" ]; then
  echo "hogkill: no processes matched"
  exit 0
fi

if [ "$json_mode" -eq 1 ]; then
  emit_json
  exit 0
fi

print_pressure_summary
render_cgroup_table
if [ "$processes_mode" -eq 1 ] || [ "$list_only" -eq 0 ]; then
  cat "$table_txt"
fi

if [ "$list_only" -eq 1 ]; then
  exit 0
fi

if [ -z "$selected_pid" ]; then
  selected_pid="$(choose_pid)"
fi

selected_row="$(row_for_pid "$selected_pid" || true)"
if [ -z "$selected_row" ]; then
  echo "hogkill: PID $selected_pid was not found in the current process table" >&2
  exit 1
fi

echo
describe_row "$selected_row"
IFS=$'\t' read -r pid user cpu mem rss pss pss_anon swap stat manager unit cgroup warning cmd <<<"$selected_row"
[ "$warning" = none ] && warning=""
if [ "$trajectory_mode" -eq 1 ]; then
  trajectory "$pid"
fi

choices=(
  "pid: SIGTERM $pid"
  "pid: SIGKILL $pid"
  "pid: pstree SIGTERM $pid"
)
if [ -n "$unit" ] && [[ "$unit" == *.service || "$unit" == *.scope ]]; then
  choices+=(
    "unit: stop $unit"
    "unit: restart $unit"
    "unit: freeze $unit"
    "unit: thaw $unit"
    "unit: kill $unit with SIGTERM"
    "unit: kill $unit with SIGKILL"
  )
fi
choices+=("inspect: systemctl status" "cancel")

echo
action="$(printf '%s\n' "${choices[@]}" | gum choose --height "${#choices[@]}")"

case "$action" in
  "pid: SIGTERM "*)
    if confirm_action "Send SIGTERM to PID $pid?"; then
      run_action "send SIGTERM to PID $pid" kill -TERM "$pid"
      verify_pid_gone_or_report "$pid" || true
    fi
    ;;
  "pid: SIGKILL "*)
    if confirm_action "Send SIGKILL to PID $pid?"; then
      run_action "send SIGKILL to PID $pid" kill -KILL "$pid"
      verify_pid_gone_or_report "$pid" || true
    fi
    ;;
  "pid: pstree SIGTERM "*)
    if confirm_action "Send SIGTERM to PID $pid and its descendants?"; then
      run_action "send SIGTERM to process subtree rooted at $pid" sh -c 'pkill -TERM -P "$1" 2>/dev/null || true; kill -TERM "$1"' sh "$pid"
    fi
    ;;
  "unit: stop "*)
    if confirm_action "Stop systemd unit $unit?"; then
      run_action "stop $manager unit $unit" unit_systemctl stop "$unit"
    fi
    ;;
  "unit: restart "*)
    if confirm_action "Restart systemd unit $unit?"; then
      run_action "restart $manager unit $unit" unit_systemctl restart "$unit"
    fi
    ;;
  "unit: freeze "*)
    if confirm_action "Freeze systemd unit $unit?"; then
      run_action "freeze $manager unit $unit" unit_systemctl freeze "$unit"
      schedule_thaw
    fi
    ;;
  "unit: thaw "*)
    if confirm_action "Thaw systemd unit $unit?"; then
      run_action "thaw $manager unit $unit" unit_systemctl thaw "$unit"
    fi
    ;;
  "unit: kill "*"SIGTERM")
    if confirm_action "Send SIGTERM to all processes in $unit?"; then
      run_action "systemd kill $manager unit $unit with SIGTERM" unit_systemctl kill --signal=TERM "$unit"
    fi
    ;;
  "unit: kill "*"SIGKILL")
    if confirm_action "Send SIGKILL to all processes in $unit?"; then
      run_action "systemd kill $manager unit $unit with SIGKILL" unit_systemctl kill --signal=KILL "$unit"
    fi
    ;;
  "inspect: systemctl status")
    if [ -n "$unit" ]; then
      if [ "$manager" = "user" ]; then
        systemctl --user status --no-pager "$unit" || true
      else
        systemctl status --no-pager "$unit" || true
      fi
    else
      echo "No systemd unit detected for PID $pid."
    fi
    ;;
  cancel|"")
    echo "Cancelled."
    ;;
esac
