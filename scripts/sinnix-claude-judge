#!/usr/bin/env python3
# @sinnix-package
# description: Run a bounded Claude structured-verdict judgment with a private receipt
# runtimeInputs: python3
"""Run one schema-bound Claude judgment, with one schema-only retry."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import signal
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path
from shutil import which
from typing import Any


DEFAULT_MAX_CONTEXT_BYTES = 1024 * 1024


class SchemaError(ValueError):
    pass


def validate(value: Any, schema: dict[str, Any], path: str = "$ ") -> None:
    expected = schema.get("type")
    types = expected if isinstance(expected, list) else [expected]
    if expected is not None and not any(
        {
            "object": isinstance(value, dict),
            "array": isinstance(value, list),
            "string": isinstance(value, str),
            "number": isinstance(value, (int, float)) and not isinstance(value, bool),
            "integer": isinstance(value, int) and not isinstance(value, bool),
            "boolean": isinstance(value, bool),
            "null": value is None,
        }.get(kind, False)
        for kind in types
    ):
        raise SchemaError(f"{path}: expected {expected}")
    if "enum" in schema and value not in schema["enum"]:
        raise SchemaError(f"{path}: value is not in enum")
    if "const" in schema and value != schema["const"]:
        raise SchemaError(f"{path}: value does not match const")
    if "anyOf" in schema and not _matches_any(value, schema["anyOf"], path):
        raise SchemaError(f"{path}: no anyOf branch matched")
    if "oneOf" in schema and sum(_matches(value, branch, path) for branch in schema["oneOf"]) != 1:
        raise SchemaError(f"{path}: oneOf match count was not one")
    if isinstance(value, dict):
        missing = [name for name in schema.get("required", []) if name not in value]
        if missing:
            raise SchemaError(f"{path}: missing required fields {', '.join(missing)}")
        properties = schema.get("properties", {})
        if schema.get("additionalProperties") is False:
            unknown = sorted(set(value) - set(properties))
            if unknown:
                raise SchemaError(f"{path}: unknown fields {', '.join(unknown)}")
        for name, child in properties.items():
            if name in value:
                validate(value[name], child, f"{path}.{name}")
    if isinstance(value, list) and isinstance(schema.get("items"), dict):
        for index, item in enumerate(value):
            validate(item, schema["items"], f"{path}[{index}]")
    if isinstance(value, str):
        if "minLength" in schema and len(value) < schema["minLength"]:
            raise SchemaError(f"{path}: shorter than minLength")
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            raise SchemaError(f"{path}: longer than maxLength")


def _matches(value: Any, schema: dict[str, Any], path: str) -> bool:
    try:
        validate(value, schema, path)
    except SchemaError:
        return False
    return True


def _matches_any(value: Any, schemas: list[dict[str, Any]], path: str) -> bool:
    return any(_matches(value, schema, path) for schema in schemas)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--schema", required=True, type=Path)
    parser.add_argument("--context", action="append", default=[], type=Path)
    parser.add_argument("--receipt-dir", type=Path)
    parser.add_argument("--max-context-bytes", type=int, default=DEFAULT_MAX_CONTEXT_BYTES)
    parser.add_argument("--", dest="separator", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("prompt", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if not args.prompt or args.prompt[0] != "--":
        parser.error("prompt must follow --")
    args.prompt = " ".join(args.prompt[1:])
    if not args.prompt:
        parser.error("prompt must not be empty")
    return args


def read_inputs(args: argparse.Namespace) -> tuple[dict[str, Any], list[str], str]:
    try:
        schema = json.loads(args.schema.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"invalid schema: {error}") from error
    if not isinstance(schema, dict):
        raise SystemExit("invalid schema: top-level value must be an object")
    if args.max_context_bytes < 1:
        raise SystemExit("--max-context-bytes must be positive")
    context_text: list[str] = []
    for path in args.context:
        if not path.is_file() or path.is_symlink():
            raise SystemExit(f"context is not a regular file: {path}")
        size = path.stat().st_size
        if size > args.max_context_bytes:
            raise SystemExit(f"context exceeds --max-context-bytes: {path}")
        context_text.append(f"\n\n## Context: {path}\n{path.read_text(encoding='utf-8')}\n")
    return schema, [str(path) for path in args.context], args.prompt + "".join(context_text)


def extract_payload(envelope: Any) -> tuple[Any, dict[str, Any]]:
    if not isinstance(envelope, dict):
        return envelope, {}
    metadata = {
        key: envelope.get(key)
        for key in ("session_id", "model", "usage", "total_cost_usd", "duration_ms", "num_turns")
        if key in envelope
    }
    payload = envelope.get("structured_output", envelope.get("result", envelope))
    if isinstance(payload, str):
        try:
            payload = json.loads(payload)
        except json.JSONDecodeError:
            pass
    return payload, metadata


def claude_binary() -> str:
    configured = os.environ.get("SINNIX_CLAUDE_JUDGE_BIN")
    if configured:
        return configured
    return which("claude") or which("claude-full") or "claude"


def run_claude(prompt: str, schema_text: str, session_id: str | None = None) -> tuple[int, str, str]:
    command = [claude_binary(), "-p", "--bare", "--output-format", "json", "--json-schema", schema_text]
    if session_id:
        command += ["--resume", session_id]
    command.append(prompt)
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)

    def terminate(_signum: int, _frame: Any) -> None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        raise SystemExit(143)

    previous = signal.signal(signal.SIGTERM, terminate)
    try:
        stdout, stderr = child.communicate()
    finally:
        signal.signal(signal.SIGTERM, previous)
    return child.returncode, stdout, stderr


def receipt_dir(args: argparse.Namespace) -> Path:
    return args.receipt_dir or Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "sinnix/claude-judge"


def write_receipt(directory: Path, receipt: dict[str, Any]) -> Path:
    directory.mkdir(parents=True, exist_ok=True)
    directory.chmod(0o700)
    target = directory / f"{receipt['receipt_id']}.json"
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(receipt, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return target


def main() -> int:
    args = parse_args()
    schema, context_paths, prompt = read_inputs(args)
    schema_text = json.dumps(schema, separators=(",", ":"))
    receipt: dict[str, Any] = {
        "schema_version": 1,
        "receipt_id": str(uuid.uuid4()),
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "schema_path": str(args.schema),
        "context_paths": context_paths,
        "attempts": [],
        "outcome": "failed",
    }
    retry_prompt = ""
    try:
        for attempt in range(2):
            status, stdout, stderr = run_claude(prompt + retry_prompt, schema_text, receipt.get("session_id"))
            attempt_record: dict[str, Any] = {"number": attempt + 1, "exit_status": status, "stderr_bytes": len(stderr.encode())}
            receipt["attempts"].append(attempt_record)
            if status != 0:
                receipt["error"] = "claude transport or process failure"
                break
            try:
                envelope = json.loads(stdout)
                payload, metadata = extract_payload(envelope)
            except json.JSONDecodeError as error:
                validation_error = f"response was not JSON: {error}"
                payload, metadata = None, {}
            else:
                receipt.update({key: value for key, value in metadata.items() if key != "session_id"})
                if metadata.get("session_id"):
                    receipt["session_id"] = metadata["session_id"]
                try:
                    validate(payload, schema)
                except SchemaError as error:
                    validation_error = str(error)
                else:
                    receipt["outcome"] = "passed"
                    attempt_record["validation"] = "passed"
                    path = write_receipt(receipt_dir(args), receipt)
                    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
                    print(f"sinnix-claude-judge: receipt={path}", file=sys.stderr)
                    return 0
            attempt_record["validation"] = "failed"
            attempt_record["validation_error"] = validation_error
            if attempt == 0 and receipt.get("session_id"):
                retry_prompt = "\nReturn only a corrected structured result that satisfies the schema. Validation error: " + validation_error
                continue
            receipt["error"] = "schema validation failed"
            break
    finally:
        if receipt.get("outcome") != "passed":
            path = write_receipt(receipt_dir(args), receipt)
            print(f"sinnix-claude-judge: receipt={path}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
