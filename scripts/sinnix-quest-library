#!/usr/bin/env python3
# @sinnix-package
# description: Serve a read-only DeoVR selection catalog for an external media library
# runtimeInputs: python3
"""Serve a DeoVR-compatible video catalog from a local media directory."""

import argparse
import json
import mimetypes
import pathlib
import posixpath
import urllib.parse
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


VIDEO_EXTENSIONS = {".m4v", ".mkv", ".mov", ".mp4", ".mpeg", ".mpg", ".webm"}


class Library:
    def __init__(self, root: pathlib.Path):
        self.root = root.resolve(strict=True)

    def resolve(self, raw_path: str) -> pathlib.Path:
        candidate = pathlib.Path(urllib.parse.unquote(raw_path))
        if candidate.is_absolute() or ".." in candidate.parts:
            raise ValueError("invalid library path")
        resolved = (self.root / candidate).resolve(strict=True)
        if not resolved.is_relative_to(self.root) or not resolved.is_file():
            raise ValueError("library path is unavailable")
        return resolved

    def videos(self):
        for path in self.root.rglob("*"):
            if path.is_file() and path.suffix.lower() in VIDEO_EXTENSIONS:
                yield path


class Handler(BaseHTTPRequestHandler):
    server: "Server"

    def log_message(self, *_):
        pass

    def json(self, value):
        body = json.dumps(value, ensure_ascii=False).encode()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def bad_request(self, message):
        self.send_error(HTTPStatus.BAD_REQUEST, message)

    def url(self, endpoint, relative):
        host = self.headers.get("Host") or f"{self.server.server_address[0]}:{self.server.server_address[1]}"
        query = urllib.parse.urlencode({"path": relative.as_posix()})
        return f"http://{host}/{endpoint}?{query}"

    def catalog(self):
        scenes = {}
        for path in self.server.library.videos():
            relative = path.relative_to(self.server.library.root)
            scene = relative.parts[0] if len(relative.parts) > 1 else "Library root"
            scenes.setdefault(scene, []).append(
                {
                    "title": relative.name,
                    "video_url": self.url("video", relative),
                }
            )
        self.json({"scenes": [{"name": name, "list": entries} for name, entries in sorted(scenes.items())]})

    def descriptor(self, query):
        raw_path = query.get("path", [""])[0]
        try:
            path = self.server.library.resolve(raw_path)
        except (OSError, ValueError) as error:
            self.bad_request(str(error))
            return
        relative = path.relative_to(self.server.library.root)
        self.json(
            {
                "title": relative.name,
                "is3d": False,
                "stereoMode": "off",
                "screenType": "flat",
                "encodings": [
                    {
                        "name": "source",
                        "videoSources": [{"url": self.url("media", relative)}],
                    }
                ],
            }
        )

    def media(self, query):
        raw_path = query.get("path", [""])[0]
        try:
            path = self.server.library.resolve(raw_path)
        except (OSError, ValueError) as error:
            self.bad_request(str(error))
            return
        size = path.stat().st_size
        start, end = 0, size - 1
        requested = self.headers.get("Range")
        if requested:
            if not requested.startswith("bytes="):
                self.send_error(HTTPStatus.REQUESTED_RANGE_NOT_SATISFIABLE)
                return
            first, _, last = requested[6:].partition("-")
            try:
                if first:
                    start = int(first)
                    end = min(int(last), end) if last else end
                elif last:
                    start = max(0, size - int(last))
                else:
                    raise ValueError
            except ValueError:
                self.send_error(HTTPStatus.REQUESTED_RANGE_NOT_SATISFIABLE)
                return
        if start > end or start >= size:
            self.send_error(HTTPStatus.REQUESTED_RANGE_NOT_SATISFIABLE)
            return
        length = end - start + 1
        self.send_response(HTTPStatus.PARTIAL_CONTENT if requested else HTTPStatus.OK)
        self.send_header("Content-Type", mimetypes.guess_type(path.name)[0] or "application/octet-stream")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(length))
        if requested:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if self.command == "HEAD":
            return
        with path.open("rb") as source:
            source.seek(start)
            remaining = length
            while remaining:
                chunk = source.read(min(1024 * 1024, remaining))
                if not chunk:
                    break
                self.wfile.write(chunk)
                remaining -= len(chunk)

    def do_GET(self):
        parsed = urllib.parse.urlsplit(self.path)
        query = urllib.parse.parse_qs(parsed.query)
        endpoint = posixpath.normpath(parsed.path)
        if endpoint in {"/", "/deovr"}:
            self.catalog()
        elif endpoint == "/video":
            self.descriptor(query)
        elif endpoint == "/media":
            self.media(query)
        else:
            self.send_error(HTTPStatus.NOT_FOUND)

    do_HEAD = do_GET


class Server(ThreadingHTTPServer):
    def __init__(self, address, library):
        super().__init__(address, Handler)
        self.library = library


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, type=pathlib.Path)
    parser.add_argument("--bind", default="0.0.0.0")
    parser.add_argument("--port", default=9791, type=int)
    args = parser.parse_args()
    with Server((args.bind, args.port), Library(args.root)) as server:
        server.serve_forever()


if __name__ == "__main__":
    main()
