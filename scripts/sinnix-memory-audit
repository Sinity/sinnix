# @sinnix-package
# description: Produce a read-only proposal report for stale agent memory entries
# runtimeInputs: bash coreutils findutils gawk grep jq
#!/usr/bin/env bash
set -euo pipefail

report_dir="${SINNIX_MEMORY_AUDIT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/memory-audit}"
days="${SINNIX_MEMORY_STALE_DAYS:-90}"
roots_string="${SINNIX_MEMORY_ROOTS:-$HOME/.config/claude/projects:$HOME/.codex:$HOME/.config/claude}"
output=""
roots=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output="${2:?missing output path}"; shift 2 ;;
    --root) roots+=("${2:?missing root path}"); shift 2 ;;
    --help) printf '%s\n' 'Usage: sinnix-memory-audit [--output PATH] [--root PATH ...]' >&2; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [ "${#roots[@]}" -eq 0 ]; then
  IFS=: read -r -a roots <<< "$roots_string"
fi

if [ -z "$output" ]; then
  mkdir -p "$report_dir"
  output="$report_dir/$(date -u +%Y%m%dT%H%M%SZ).jsonl"
fi
mkdir -p "$(dirname "$output")"
tmp="${output}.tmp"
trap 'rm -f "$tmp"' EXIT

now="$(date +%s)"
stale_seconds=$((days * 86400))
files=()
for root in "${roots[@]}"; do
  [ -d "$root" ] || continue
  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$root" -type f \( -name MEMORY.md -o -name '*memory*.md' \) -print)
done

printf '%s\n' "${files[@]}" | sort -u | while IFS= read -r file; do
  [ -n "$file" ] || continue
  awk -v file="$file" -v now="$now" -v stale_seconds="$stale_seconds" '
    function json(value) {
      gsub(/"/, "\\\"", value)
      gsub(/\\/, "\\\\", value)
      return "\"" value "\""
    }
    function emit(kind, line_no, detail, value) {
      printf "{\"file\":%s,\"line\":%d,\"kind\":%s,\"detail\":%s%s}\n", json(file), line_no, json(kind), json(detail), value == "" ? "" : ",\"value\":" json(value)
    }
    function filesystem_path(path) {
      return path ~ /^\/(home|realm|persist|etc|var|nix|tmp|outer-realm|run|mnt|opt|usr|dev|sys|proc)(\/|$)/
    }
    match($0, /20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) {
      date_value = substr($0, RSTART, RLENGTH)
      command = "date -d " date_value " +%s"
      command | getline epoch
      close(command)
      if (now - epoch > stale_seconds)
        emit("stale_date", NR, "dated entry is older than the configured threshold", date_value)
    }
    {
      while (match($0, /\/[A-Za-z0-9_.+@%~-]+(\/[A-Za-z0-9_.+@%~-]+)+/)) {
        path = substr($0, RSTART, RLENGTH)
        if (filesystem_path(path) && system("test -e " path) != 0)
          emit("dead_path", NR, "absolute path does not exist", path)
        $0 = substr($0, RSTART + RLENGTH)
      }
      if ($0 ~ /(contradict|no longer|instead|obsolete|supersed)/)
        emit("review_required", NR, "possible semantic contradiction requires human review", "")
    }
  ' "$file"
done > "$tmp"

mv "$tmp" "$output"
printf '%s\n' "$output"
