#!/usr/bin/env bash
# @sinnix-package
# description: Produce a read-only proposal report for stale agent memory entries
# runtimeInputs: bash coreutils findutils gawk gnugrep jq python3
set -euo pipefail
umask 077

report_dir="${SINNIX_MEMORY_AUDIT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sinnix/memory-audit}"
days="${SINNIX_MEMORY_STALE_DAYS:-90}"
roots_string="${SINNIX_MEMORY_ROOTS:-$HOME/.config/claude/projects:$HOME/.codex:$HOME/.config/claude}"
output=""
default_output=0
roots=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output="${2:?missing output path}"; shift 2 ;;
    --root) roots+=("${2:?missing root path}"); shift 2 ;;
    --help) printf '%s\n' 'Usage: sinnix-memory-audit [--output PATH] [--root PATH ...]' >&2; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [ "${#roots[@]}" -eq 0 ]; then
  IFS=: read -r -a roots <<< "$roots_string"
fi

if [ -z "$output" ]; then
  mkdir -p "$report_dir"
  output="$report_dir/$(date -u +%Y%m%dT%H%M%SZ).jsonl"
  default_output=1
fi
mkdir -p "$(dirname "$output")"
scratch="$(mktemp -d "$(dirname "$output")/.memory-audit.XXXXXX")"
trap 'rm -rf -- "$scratch"' EXIT
tmp="$scratch/report.jsonl"
observations="$scratch/observations.jsonl"
listing="$scratch/inputs"
: > "$listing"
if [[ "$default_output" -eq 1 ]]; then
  output="${output%.jsonl}-${scratch##*.}.jsonl"
fi

now="$(date +%s)"
stale_seconds=$((days * 86400))
# Every requested root must be readable; a partial scan cannot replace the
# last report. Stage discovery directly so find's exit status is observed.
for root in "${roots[@]}"; do
  if [[ ! -d "$root" ]]; then
    printf 'sinnix-memory-audit: input root unavailable or not a directory: %s\n' "$root" >&2
    exit 1
  fi
  find -H "$root" -type f \( -name MEMORY.md -o -name '*memory*.md' \) -print0 >> "$listing"
done

sort -zu "$listing" | while IFS= read -r -d '' file; do
  [ -n "$file" ] || continue
  SINNIX_MEMORY_AUDIT_FILE="$file" awk -v now="$now" -v stale_seconds="$stale_seconds" '
    BEGIN {
      file = ENVIRON["SINNIX_MEMORY_AUDIT_FILE"]
      for (code = 0; code < 32; code++) controls = controls sprintf("%c", code)
    }
    function json(value, result, position, character, control) {
      result = "\""
      for (position = 1; position <= length(value); position++) {
        character = substr(value, position, 1)
        if (character == "\\") result = result "\\\\"
        else if (character == "\"") result = result "\\\""
        else {
          control = index(controls, character)
          result = result (control ? sprintf("\\u%04x", control - 1) : character)
        }
      }
      return result "\""
    }
    function emit(kind, line_no, detail, value) {
      printf "{\"file\":%s,\"line\":%d,\"kind\":%s,\"detail\":%s%s}\n", json(file), line_no, json(kind), json(detail), value == "" ? "" : ",\"value\":" json(value)
    }
    function filesystem_path(path) {
      return path ~ /^\/(home|realm|persist|etc|var|nix|tmp|outer-realm|run|mnt|opt|usr|dev|sys|proc)(\/|$)/
    }
    match($0, /20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) {
      date_value = substr($0, RSTART, RLENGTH)
      command = "date -d " date_value " +%s"
      command | getline epoch
      close(command)
      if (now - epoch > stale_seconds)
        emit("stale_date", NR, "dated entry is older than the configured threshold", date_value)
    }
    {
      original_line = $0
      while (match($0, /\/[A-Za-z0-9_.+@%~-]+(\/[A-Za-z0-9_.+@%~-]+)+/)) {
        path = substr($0, RSTART, RLENGTH)
        if (filesystem_path(path))
          emit("path_probe", NR, "absolute path reference", path)
        $0 = substr($0, RSTART + RLENGTH)
      }
      if (original_line ~ /(contradict|no longer|instead|obsolete|supersed)/)
        emit("review_required", NR, "possible semantic contradiction requires human review", "")
    }
  ' "$file"
done > "$observations"

# Classify references in one isolated process. A failed stat is not proof of
# absence; keep lookup errors explicit without reading referenced payloads.
python3 -I - "$observations" > "$tmp" <<'PYTHON'
import json
import os
import sys

with open(sys.argv[1], encoding="utf-8", errors="surrogateescape") as observations:
    for line in observations:
        row = json.loads(line)
        if row["kind"] == "path_probe":
            try:
                os.stat(row["value"])
            except FileNotFoundError:
                row.update(kind="dead_path", detail="absolute path does not exist")
            except OSError as error:
                row.update(
                    kind="unavailable_path",
                    detail="cannot establish absolute path availability",
                    reason=str(error),
                    errno=error.errno,
                )
            else:
                continue
        print(json.dumps(row, ensure_ascii=True))
PYTHON

if [[ "$default_output" -eq 1 ]]; then
  mv -T --update=none-fail -- "$tmp" "$output"
else
  mv -T -- "$tmp" "$output"
fi
printf '%s\n' "$output"
