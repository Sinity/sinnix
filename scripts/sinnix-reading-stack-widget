# @sinnix-package
# description: Terminal-based ambient viewer for the reading stack -- run inside a pinned kitty window
# runtimeInputs: bash @sinnix-reading-stack
#!/usr/bin/env bash
# The "standing visibility" mechanism for the reading stack (see
# sinnix-reading-stack's own docstring for the reasoning). A plain terminal
# loop, not a Waybar/eww module: Noctalia (this host's shell) exposes no
# scriptable per-widget IPC, whereas a small window pinned via a Hyprland
# windowrule works.
set -euo pipefail

refresh_secs="${SINNIX_READING_STACK_REFRESH:-5}"

while true; do
  clear
  echo "── reading stack ──────────────────────"
  count="$(sinnix-reading-stack count)"
  sinnix-reading-stack list --compact --limit 12
  echo "────────────────────────────────────────"
  if [ "$count" -gt 20 ]; then
    echo "  ($count total -- over soft cap, review)"
  else
    echo "  ($count total)"
  fi
  sleep "$refresh_secs"
done
