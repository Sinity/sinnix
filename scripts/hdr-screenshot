#!/usr/bin/env bash
# @sinnix-package: skip
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  hdr-screenshot probe
  hdr-screenshot area [--dir DIR] [--no-notify]
  hdr-screenshot output [--dir DIR] [--no-notify]

Captures the selected area or focused output, saves it, and copies it to the
clipboard. Captures directly in the output's current mode: with Hyprland's
render:cm_enabled=false (this setup), HDR-mode screencopy already yields
correct sRGB frames, so no monitor reconfiguration is needed or performed.
If the CM pipeline is ever enabled and captures wash out again, revisit —
the old SDR-switch workaround caused visible output blanking and races.
EOF
}

die() {
  printf 'hdr-screenshot: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

target_dir="${HOME}/Pictures/Screenshots"
notify=1

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

subcommand="$1"
shift

while [ $# -gt 0 ]; do
  case "$1" in
    --dir)
      [ $# -ge 2 ] || die "--dir requires a value"
      target_dir="$2"
      shift 2
      ;;
    --no-notify)
      notify=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$subcommand" in
  probe)
    need_cmd grimblast
    grimblast check
    ;;
  area|output)
    need_cmd date
    need_cmd grim
    need_cmd wl-copy
    if [ "$subcommand" = "area" ]; then
      need_cmd slurp
    else
      need_cmd hyprctl
      need_cmd jq
    fi

    # A second Print press during an in-flight capture must not start a
    # parallel selection/capture pair.
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hdr-screenshot.lock"
    flock -n 9 || die "another capture is already in progress"

    mkdir -p "$target_dir"
    path="${target_dir}/$(date +'%Y-%m-%d-At-%Hh%Mm%Ss').png"

    case "$subcommand" in
      area)
        geom="$(slurp)"
        [ -n "$geom" ] || die "area selection cancelled"
        grim -g "$geom" "$path"
        ;;
      output)
        monitor="$(hyprctl -j monitors | jq -r 'map(select(.focused == true))[0].name // empty')"
        [ -n "$monitor" ] || die "no focused monitor found"
        grim -c -o "$monitor" "$path"
        ;;
    esac

    [ -s "$path" ] || die "capture did not produce an image"
    wl-copy --type image/png <"$path"
    if [ "$notify" -eq 1 ]; then
      notify-send -t 2000 "Screenshot saved" "$path" || true
    fi
    printf '%s\n' "$path"
    ;;
  *)
    usage
    die "unknown subcommand: $subcommand"
    ;;
esac
