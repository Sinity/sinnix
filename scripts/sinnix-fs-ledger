#!/usr/bin/env python3
# @sinnix-package
# description: Materialize the fs-index judgment ledger into resolved judgments, prefix inheritance and a coverage report
# runtimeInputs: python3 duckdb coreutils

"""Turn judgments.jsonl from a file agents write into a file agents can query.

sinnix-fs-inventory and sinnix-fs-content produce the mechanical scan
(nodes/files: what is on disk). Alongside them, an append-only ledger of
per-path judgments (subject, owner, provenance, lifecycle...) has existed
since the system charter pass on 2026-08-16 -- but nothing had ever loaded it
into either DuckDB file, so "what fraction of the system is classified" was a
question with no way to answer it. This closes that gap in SQL, not new
scanning code: everything here reads data that was already on disk.

Three views, corresponding to the charter's design (system-charter-2026-08-16
Section 4):

  resolved_judgments   latest-wins per (target, field), except that a
                        method='operator' row is only ever superseded by
                        another operator row -- an agent's rule-based guess
                        never overrides a human decision, no matter which
                        came later.

  inherited_judgments  every path in nodes/files joined to whichever
                        judgment target -- a literal sha256: row, or the
                        LONGEST matching prefix: row -- actually governs it.
                        This is what lets ~200 prefix judgments classify
                        millions of files without reading them.

  coverage             the four disjoint states the charter names, per
                        field: classified (has a judgment) / unclassifiable
                        (resolved to observation='unknown') / exempt
                        (not_applicable or withheld) / not_yet_examined (no
                        row reaches this path at all). Only the last one is
                        the work queue -- the other three are all "examined",
                        whatever the answer turned out to be.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

SQL = r"""
INSTALL json; LOAD json;

DROP TABLE IF EXISTS judgments;
CREATE TABLE judgments AS
SELECT * FROM read_json_auto('{judgments_jsonl}', ignore_errors=true);

-- Latest-wins per (target, field), with the operator-override exception: a
-- method='operator' row can only be superseded by another operator row. Rank
-- operator rows above rule/model rows regardless of timestamp, then by ts
-- within each tier.
DROP VIEW IF EXISTS resolved_judgments;
CREATE VIEW resolved_judgments AS
SELECT * EXCLUDE (rk) FROM (
    SELECT *,
           row_number() OVER (
               PARTITION BY target, field
               ORDER BY (method = 'operator') DESC, ts DESC
           ) AS rk
    FROM judgments
) WHERE rk = 1;

-- Prefix inheritance. A path's judgment is its own sha256: row if one
-- exists, else the LONGEST prefix: row whose prefix it starts with. DuckDB
-- has no native trie join, so this is a correlated subquery keyed on
-- string length -- fine at this row count (hundreds of judgments, not
-- millions), and the alternative (materializing every prefix x path pair)
-- would be the thing actually too slow to run.
DROP VIEW IF EXISTS prefix_judgments;
CREATE VIEW prefix_judgments AS
SELECT target, field, value, confidence, observation, method, evidence, ts,
       substr(target, 8) AS prefix
FROM resolved_judgments
WHERE target LIKE 'prefix:%';

-- all_paths / inherited_judgments / coverage are TABLES, not views: they
-- read from `files`, which lives behind a cross-database ATTACH that does
-- not persist once this duckdb session exits. A view here would work for
-- the rest of this script and then silently break -- "table ctn.files does
-- not exist" -- for every later, ordinary `duckdb inventory.duckdb -c ...`
-- query. Materializing means re-running sinnix-fs-ledger is how you refresh
-- them, same contract as the rollup in sinnix-fs-inventory.
DROP TABLE IF EXISTS all_paths;
CREATE TABLE all_paths AS
SELECT path, sha256 FROM (
    SELECT path, NULL AS sha256 FROM nodes
    UNION ALL
    SELECT path, sha256 FROM files
);

-- Only paths that DO match something appear here (an inner join, not a
-- left join): the "no row at all" case is what QUALIFYing against the full
-- path population in `coverage` below is for, and this view stays a clean
-- "here is what governs each classified path" rather than a padded table.
-- sha256 exact matches always outrank the longest prefix match for the
-- same (path, field) -- a specific judgment about one file wins over a
-- general one about its directory.
DROP TABLE IF EXISTS inherited_judgments;
CREATE TABLE inherited_judgments AS
SELECT path, sha256, field, value, confidence, observation, method, evidence, via_prefix
FROM (
    SELECT p.path, p.sha256, pj.field, pj.value, pj.confidence, pj.observation,
           pj.method, pj.evidence, pj.prefix AS via_prefix, 1 AS specificity,
           length(pj.prefix) AS match_len
    FROM all_paths p
    JOIN prefix_judgments pj ON starts_with(p.path, pj.prefix)

    UNION ALL

    SELECT p.path, p.sha256, rj.field, rj.value, rj.confidence, rj.observation,
           rj.method, rj.evidence, NULL AS via_prefix, 0 AS specificity, 0 AS match_len
    FROM all_paths p
    JOIN resolved_judgments rj ON rj.target = 'sha256:' || p.sha256
    WHERE p.sha256 IS NOT NULL
)
QUALIFY row_number() OVER (
    PARTITION BY path, field ORDER BY specificity ASC, match_len DESC
) = 1;

-- Coverage: four disjoint states per (path, field). Built against the
-- 'subject' field, the one the system charter's routing decisions actually
-- key on; other fields (owner, provenance, lifecycle...) can be queried the
-- same way by re-running this view with a different field filter -- kept as
-- one field here rather than a cross-product over all fields, because that
-- cross-product is exactly the kind of premature generality the operating
-- contract warns against and nothing downstream needs it yet.
DROP TABLE IF EXISTS coverage;
CREATE TABLE coverage AS
WITH subject_state AS (
    SELECT p.path,
           CASE
             WHEN ij.field IS NULL THEN 'not_yet_examined'
             WHEN ij.observation = 'not_applicable' OR ij.observation = 'withheld' THEN 'exempt'
             WHEN ij.observation = 'unknown' THEN 'unclassifiable'
             ELSE 'classified'
           END AS state
    FROM all_paths p
    LEFT JOIN inherited_judgments ij ON ij.path = p.path AND ij.field = 'subject'
)
SELECT state, count(*) AS paths,
       round(100.0 * count(*) / sum(count(*)) OVER (), 1) AS pct
FROM subject_state GROUP BY state ORDER BY paths DESC;
"""


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--index-dir", type=Path, default=Path("/realm/state/fs-index"),
                     help="directory holding judgments.jsonl, inventory.duckdb, content.duckdb")
    args = ap.parse_args()

    judgments = args.index_dir / "judgments.jsonl"
    inv_db = args.index_dir / "inventory.duckdb"
    content_db = args.index_dir / "content.duckdb"
    for p in (judgments, inv_db, content_db):
        if not p.exists():
            print(f"sinnix-fs-ledger: missing {p} -- run sinnix-fs-inventory and "
                  f"sinnix-fs-content first", file=sys.stderr)
            return 1

    sql = SQL.format(judgments_jsonl=str(judgments))
    # A prior run may have left an object with the same name as a different
    # kind (view vs table) -- DROP ... IF EXISTS does not suppress a type
    # mismatch, only a missing name, so a plain drop-then-create can fail
    # against the catalog's actual current state. Query it and drop each
    # target object precisely as whatever it currently is, before running the
    # real script.
    OBJECT_KIND = {
        "resolved_judgments": "VIEW", "prefix_judgments": "VIEW",
        "all_paths": "TABLE", "inherited_judgments": "TABLE", "coverage": "TABLE",
    }
    catalog_probe = (
        "SELECT table_name, 'TABLE' FROM duckdb_tables() "
        "UNION ALL SELECT view_name, 'VIEW' FROM duckdb_views();"
    )
    probe = subprocess.run(["duckdb", str(inv_db), "-csv", "-c", catalog_probe],
                            text=True, capture_output=True)
    existing = {}
    if probe.returncode == 0:
        for line in probe.stdout.splitlines()[1:]:
            if "," not in line:
                continue
            n, kind = line.rsplit(",", 1)
            existing[n.strip('"')] = kind
    precise_drops = "\n".join(
        f"DROP {existing[name]} IF EXISTS {name};"
        for name in OBJECT_KIND
        if name in existing and existing[name] != OBJECT_KIND[name]
    )

    # inventory.duckdb is opened directly (it already has nodes/rollup); only
    # content.duckdb needs ATTACHing, as a view rather than a copy, so a
    # re-run of either scanner remains the only place that table is written.
    full_sql = f"""
{precise_drops}
ATTACH '{content_db}' AS ctn (READ_ONLY);
CREATE OR REPLACE VIEW files AS SELECT * FROM ctn.files;
{sql}
.print
SELECT * FROM coverage;
"""
    script = args.index_dir / ".ledger.sql"
    script.write_text(full_sql, encoding="utf-8")
    proc = subprocess.run(["duckdb", str(inv_db), "-f", str(script)],
                           text=True, capture_output=True)
    if proc.returncode != 0:
        print(f"sinnix-fs-ledger: duckdb failed: {proc.stderr}", file=sys.stderr)
        return 1
    print(proc.stdout)
    print(f"sinnix-fs-ledger: materialized resolved_judgments, prefix_judgments, "
          f"inherited_judgments, coverage in {inv_db}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
