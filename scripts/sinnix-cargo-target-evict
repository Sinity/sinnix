#!/usr/bin/env bash
# @sinnix-package
# description: Evict unused Cargo targets after their checkout is removed
# runtimeInputs: bash coreutils findutils util-linux
set -euo pipefail

# The use grace comes from sinnix.features.dev.languages.cargoCache.
cache_root="${SINNIX_CARGO_CACHE_ROOT:-/realm/state/cache/cargo}"
min_idle_seconds="${SINNIX_CARGO_MIN_IDLE_SECONDS:?}"

dir="$cache_root/$(id -u)"
[ -d "$dir" ] || exit 0

# sinnix-cargo-target keeps each target at <dir>/<hash>/target, where hash is
# derived from the checkout path, and writes that path to <dir>/<hash>/checkout
# on every selection. The marker's mtime is the target's last selection.
hash_of() { printf '%s' "$1" | sha256sum | cut -c1-32; }

last_used() {
  local entry="$1" newest=0 m p
  # The entry's own mtime covers a new target not yet marked.
  for p in "$entry" "$entry/checkout" "$entry/target" "$entry"/target/*/ "$entry"/target/*/deps \
    "$entry"/target/*/*/deps; do
    [ -e "$p" ] || continue
    m="$(stat -c %Y "$p")"
    [ "$m" -gt "$newest" ] && newest="$m"
  done
  printf '%s\n' "$newest"
}

# A target is removed only while none of its Cargo build locks is held. The
# entry is renamed under the primary lock, so a build that starts afterwards
# selects a fresh target instead of writing into one being deleted.
evict() {
  local entry="$1" lock trash name
  while IFS= read -r lock; do
    if ! flock --nonblock "$lock" true; then
      echo "busy, kept: $entry" >&2
      return 1
    fi
  done < <(find "$entry/target" -maxdepth 3 -name .cargo-lock 2>/dev/null)
  name="$(basename "$entry")"
  name="${name#.evicting.}"
  trash="$dir/.evicting.$name"
  lock="$entry/target/debug/.cargo-lock"
  if [ "$entry" != "$trash" ]; then
    if [ -e "$lock" ]; then
      flock --nonblock "$lock" mv -T -- "$entry" "$trash" || return 1
    else
      mv -T -- "$entry" "$trash"
    fi
  fi
  rm -rf -- "$trash"
  echo "evicted (checkout removed): $name"
}

now="$(date +%s)"
# Interrupted removals meet the same checks as entries still at their normal
# names: an earlier policy may have renamed a live checkout's target.
for entry in "$dir"/*/ "$dir"/.evicting.*/; do
  [ -d "$entry" ] || continue
  entry="${entry%/}"
  name="$(basename "$entry")"
  name="${name#.evicting.}"
  [[ "$name" =~ ^[0-9a-f]{32}$ ]] || continue
  [ -f "$entry/checkout" ] && [ ! -L "$entry/checkout" ] || continue
  checkout="$(head -n 1 "$entry/checkout")"
  [[ "$checkout" = /* ]] || continue
  [ "$(hash_of "$checkout")" = "$name" ] || continue
  # Source can remain without Git metadata, or as a dangling symlink. Neither
  # means the owner has removed the checkout and released its build outputs.
  [ ! -e "$checkout" ] && [ ! -L "$checkout" ] || continue
  idle=$((now - $(last_used "$entry")))
  [ "$idle" -ge "$min_idle_seconds" ] && evict "$entry" || true
done
