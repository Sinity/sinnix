VOLATILE_KEYS = [
    ("repo.head", "repository HEAD"),
    ("inventory.surface_count", "surface count"),
    ("states.active", "active surfaces"),
    ("states.inactive", "inactive surfaces"),
    ("storage.mounts./realm.used_pct", "/realm fill %"),
    ("secrets.encrypted", "secret count"),
    ("beads.open", "open work items"),
]


def dig(d, dotted):
    cur = d
    for part in dotted.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return None
    return cur


def verify(path: Path):
    side = Path(str(path) + ".data.json")
    if not side.exists():
        print(f"no sidecar at {side}", file=sys.stderr)
        return 2
    old = json.loads(side.read_text())
    fresh, _ = collect_all(Path(old.get("_repo", "/realm/project/sinnix")), skip_eval=True)
    diverged = 0
    for key, label in VOLATILE_KEYS:
        a, b = dig(old, key), dig(fresh, key)
        if a != b:
            diverged += 1
            print(f"DIVERGED {label}: report says {a!r}, live says {b!r}")
    gen_at = old.get("_generated", "?")
    print(f"checked {len(VOLATILE_KEYS)} volatile figures against a report "
          f"generated {gen_at}: {diverged} diverged")
    return 1 if diverged else 0


def collect_all(repo: Path, skip_eval: bool):
    F, holes = {}, []
    for name, fn in [("repo", lambda: collect_repo(repo)),
                     ("generation", lambda: collect_generation(repo)),
                     ("inventory", collect_inventory),
                     ("storage", collect_storage),
                     ("ports", collect_ports),
                     ("beads", lambda: collect_beads(repo)),
                     ("checks", lambda: collect_checks(repo, skip_eval)),
                     ("secrets", collect_secrets),
                     ("stalls", collect_stalls),
                     ("pilot", lambda: collect_pilot(repo))]:
        fig, h = fn()
        F[name] = fig
        holes += h
    st_fig, st_holes = collect_states(F["inventory"].get("surfaces", []))
    F["states"] = st_fig
    holes += st_holes
    return F, holes


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--output", default=DEFAULT_OUTPUT)
    ap.add_argument("--repo", default="/realm/project/sinnix")
    ap.add_argument("--no-eval", action="store_true",
                    help="skip nix eval (check counts become a hole)")
    ap.add_argument("--verify", nargs="?", const=DEFAULT_OUTPUT, default=None)
    args = ap.parse_args()
    if args.verify is not None:
        sys.exit(verify(Path(args.verify)))
    repo = Path(args.repo)
    F, holes = collect_all(repo, args.no_eval)
    F["_repo_path"] = str(repo)
    authored = load_authored()
    out = Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    doc = build(F, holes, authored, out)
    out.write_text(doc)
    F["_generated"] = now_utc().strftime("%Y-%m-%dT%H:%M:%SZ")
    F["_repo"] = str(repo)
    Path(str(out) + ".data.json").write_text(json.dumps(F, default=str))
    print(f"wrote {out} ({len(doc)//1024} KB) + sidecar; "
          f"{len(findings(F))} standing findings, {len(holes)} holes")


if __name__ == "__main__":
    main()
