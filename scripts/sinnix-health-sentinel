#!/usr/bin/env bash
# @sinnix-package
# description: Emit deduplicated runtime health transitions from inventory declarations
# runtimeInputs: bash coreutils findutils gawk jq systemd sudo libnotify
set -euo pipefail

inventory=/etc/sinnix/runtime-inventory.json
runtime_root="${XDG_RUNTIME_DIR:-/run/sinnix}"
state="$runtime_root/health-sentinel-state.json"
output="$runtime_root/health-transitions.jsonl"
failure_unit=
failure_result=
user_bus_root="${SINNIX_HEALTH_SENTINEL_USER_BUS_ROOT:-/run/user}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --inventory) inventory="$2"; shift 2 ;;
    --state) state="$2"; shift 2 ;;
    --output) output="$2"; shift 2 ;;
    --failure-unit) failure_unit="$2"; shift 2 ;;
    --failure-result) failure_result="$2"; shift 2 ;;
    --check) shift ;;
    *) echo "sinnix-health-sentinel: unknown option: $1" >&2; exit 64 ;;
  esac
done

mkdir -p "$(dirname "$state")" "$(dirname "$output")"
[ -s "$state" ] || printf '{}\n' > "$state"
[ -e "$output" ] || : > "$output"
chmod 0664 "$state" "$output"

# Every key emit() is ever called with this run, whether or not its status
# changed -- the full-sweep path below uses this to prune state-file keys the
# sentinel no longer emits, which emit() alone can never do since it only
# ever touches keys it currently sees.
emitted_keys=()

# A system-level oneshot has no session bus of its own, so reach the operator
# by bridging into every active graphical session's D-Bus bus (the same
# mechanism modules/backup.nix's borg-verify failure path uses).
notify_desktop() {
  local urgency="$1" title="$2" body="$3" uid bus
  for bus in "$user_bus_root"/*/bus; do
    [ -S "$bus" ] || continue
    uid="$(basename "$(dirname "$bus")")"
    sudo -u "#$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      notify-send --urgency="$urgency" --app-name="sinnix-health-sentinel" "$title" "$body" \
      2>/dev/null || true
  done
}

# How many consecutive sweeps must agree before a change is believed. The
# sentinel samples on a fixed clock against a live machine, so a single
# disagreeing sample is as likely to be a race as a fault: a capture lane
# rotating its output file, an audio device between stream attachments, a
# publisher that has not finished registering since login. Every one of
# those self-clears within a sweep and none of them is worth a critical
# desktop notification. Requiring two agreeing samples costs one interval of
# latency on a real fault -- irrelevant for anything a human then has to go
# look at -- and removes the entire class.
confirm_samples=2

# key -> readable phrase for the units the caller passes as $unit, which are
# either systemd unit names or lane names.
humanize_duration() {
  local s="$1"
  if [ "$s" -lt 60 ]; then printf '%ss' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%dm' "$((s / 60))"
  elif [ "$s" -lt 86400 ]; then printf '%dh %dm' "$((s / 3600))" "$(((s % 3600) / 60))"
  else printf '%dd %dh' "$((s / 86400))" "$(((s % 86400) / 3600))"
  fi
}

evidence_field() {
  # evidence is a ";"-joined key=value list; pull one value out of it.
  printf '%s' "$1" | tr ';' '\n' | awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }'
}

# Turn (type, unit, status, evidence) into a title and a body a human can act
# on. The raw evidence string is a debugging carrier -- "manager=user;
# active_state=failed;type=oneshot;result=timeout;wanted_by=" tells you
# nothing at a glance about what broke or where to look -- so it stays in the
# JSONL ledger and out of the notification. Prints "title<TAB>body".
describe() {
  local type="$1" unit="$2" status="$3" evidence="$4" title body
  local manager result age budget usage warn fail rc
  manager="$(evidence_field "$evidence" manager)"
  case "$type:$status" in
    service_failure:healthy)
      title="$unit is running again"
      body="Recovered on its own; nothing to do." ;;
    service_failure:failed)
      result="$(evidence_field "$evidence" result)"
      title="$unit stopped working"
      case "$result" in
        timeout) body="Its last run hit the unit's time limit and was killed." ;;
        exit-code) body="Its last run exited with an error." ;;
        oom-kill) body="It was killed for running out of memory." ;;
        signal|core-dump) body="It was killed by a signal." ;;
        *) body="It is not running and was not meant to be stopped." ;;
      esac
      if [ "$manager" = user ]; then
        body="$body"$'\n'"Look: journalctl --user -u $unit -e"
      else
        body="$body"$'\n'"Look: journalctl -u $unit -e"
      fi ;;
    service_failure:acknowledged)
      title="$unit is down, as expected"
      body="A known outage, acknowledged in the runtime inventory: $(evidence_field "$evidence" acknowledged_ref)" ;;
    service_failure:unknown)
      title="Cannot tell whether $unit is healthy"
      body="The sentinel could not read its state, so this is neither a pass nor a failure." ;;
    socket_failure:healthy)
      title="$unit is listening again"
      if [ "$(evidence_field "$evidence" recovered)" = "reset-failed+start" ]; then
        body="It had latched into failed and refused every connection; the sentinel reset and restarted it."$'\n'"If this keeps happening, something behind it is failing to activate: journalctl -u ${unit%.socket}.service -e"
      else
        body="Recovered on its own; nothing to do."
      fi ;;
    socket_failure:failed)
      result="$(evidence_field "$evidence" result)"
      title="$unit is not accepting connections"
      case "$result" in
        trigger-limit-hit) body="It hit systemd's activation rate limit and latched into failed, so its public port now refuses everything." ;;
        *) body="The front-door socket is down, so nothing can reach the service behind it." ;;
      esac
      body="$body"$'\n'"Look: journalctl -u $unit -e" ;;
    socket_failure:unknown)
      title="Cannot tell whether $unit is listening"
      body="The sentinel could not read its state, so this is neither a pass nor a failure." ;;
    capture_stale:healthy)
      age="$(evidence_field "$evidence" age_seconds)"
      title="$unit lane is recording again"
      body="Newest file is $(humanize_duration "${age:-0}") old." ;;
    capture_stale:stale)
      age="$(evidence_field "$evidence" age_seconds)"
      budget="$(evidence_field "$evidence" stale_after_seconds)"
      title="$unit lane has gone quiet"
      if [ -n "$age" ]; then
        body="Nothing written for $(humanize_duration "$age")"
        [ -n "$budget" ] && [ "$budget" != null ] \
          && body="$body, past its $(humanize_duration "$budget") budget"
        body="$body."
      else
        body="The lane directory holds no files at all."
      fi
      body="$body"$'\n'"Path: $(evidence_field "$evidence" path)" ;;
    capture_payload:degenerate)
      title="$unit lane is writing empty records"
      body="It is producing files on schedule, but the fields it promises to fill are null in every recent record -- a broken producer, not a quiet hour." ;;
    capture_payload:healthy)
      title="$unit lane is writing real data again"
      body="Recent records carry the fields the lane declares." ;;
    publisher_liveness:healthy)
      title="$unit lane has its source back"
      body="The thing this lane observes is publishing again." ;;
    publisher_liveness:publisher-absent)
      title="Nothing is publishing to the $unit lane"
      body="The lane and its unit are fine; the source it watches is not there, so it will stay silent until that returns." ;;
    publisher_liveness:unknown)
      rc="$(evidence_field "$evidence" probe_exit)"
      title="The $unit liveness check could not answer"
      body="The probe itself failed (exit ${rc:-?}), so this says nothing about the lane. Fix the probe before reading anything into it." ;;
    mount_capacity:healthy)
      title="$unit has room again"
      body="Now at $(evidence_field "$evidence" usage_percent)% used." ;;
    mount_capacity:*)
      usage="$(evidence_field "$evidence" usage_percent)"
      warn="$(evidence_field "$evidence" warn_percent)"
      fail="$(evidence_field "$evidence" fail_percent)"
      title="$unit is ${usage}% full"
      if [ "$status" = failed ]; then
        body="Past the ${fail}% line where writes start to be at risk."
      else
        body="Past the ${warn}% warning line (fails at ${fail}%)."
      fi ;;
    *)
      title="$unit: $status"
      body="$type" ;;
  esac
  printf '%s\t%s' "$title" "$body"
}

# Set for the --failure-unit fast path, where systemd is REPORTING a failure
# rather than the sentinel sampling for one. An OnFailure= hook fires exactly
# once, so requiring a second agreeing observation would discard the most
# authoritative signal the sentinel ever receives.
force_confirm=0

emit() {
  local key="$1" type="$2" unit="$3" status="$4" evidence="$5"
  local confirmed pending streak described title body
  emitted_keys+=("$key")

  # State values are objects: the believed status plus the candidate that is
  # currently accumulating agreement against it. Older state files hold a
  # bare status string, so read both shapes.
  confirmed="$(jq -r --arg key "$key" '(.[$key] | if type == "object" then .status else . end) // ""' "$state")"
  pending="$(jq -r --arg key "$key" '(.[$key] | if type == "object" then (.pending // "") else "" end)' "$state")"
  streak="$(jq -r --arg key "$key" '(.[$key] | if type == "object" then (.streak // 0) else 0 end)' "$state")"

  if [ "$status" = "$confirmed" ]; then
    # Agrees with what we believe. Drop any half-accumulated candidate: a
    # fault must be witnessed on CONSECUTIVE sweeps, not merely twice ever,
    # or a lane that blips once an hour eventually pages anyway.
    if [ -n "$pending" ]; then
      jq --arg key "$key" --arg status "$status" \
        '.[$key] = {status: $status}' "$state" > "$state.tmp"
      chmod 0664 "$state.tmp"
      mv -f "$state.tmp" "$state"
    fi
    return 0
  fi

  if [ "$status" = "$pending" ]; then
    streak=$((streak + 1))
  else
    streak=1
  fi

  # A key we have never seen settling into "healthy" is startup, not a
  # recovery: believe it at once and say nothing. Anything else has to earn
  # its transition.
  if [ -z "$confirmed" ] && [ "$status" = healthy ]; then
    streak="$confirm_samples"
  fi
  [ "$force_confirm" -eq 1 ] && streak="$confirm_samples"

  if [ "$streak" -lt "$confirm_samples" ]; then
    jq --arg key "$key" --arg confirmed "$confirmed" --arg pending "$status" \
      --argjson streak "$streak" \
      '.[$key] = {status: $confirmed, pending: $pending, streak: $streak}' "$state" > "$state.tmp"
    chmod 0664 "$state.tmp"
    mv -f "$state.tmp" "$state"
    return 0
  fi

  jq --arg key "$key" --arg status "$status" '.[$key] = {status: $status}' "$state" > "$state.tmp"
  chmod 0664 "$state.tmp"
  mv -f "$state.tmp" "$state"
  jq -cn \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg type "$type" --arg unit "$unit" --arg status "$status" --arg evidence "$evidence" \
    --argjson confirmed_after "$confirm_samples" \
    '{schema:"sinnix-health-transition-v1",ts:$ts,type:$type,unit:$unit,status:$status,ok:($status == "healthy"),evidence:$evidence,confirmed_after_samples:$confirmed_after}' \
    >> "$output"

  described="$(describe "$type" "$unit" "$status" "$evidence")"
  title="${described%%$'\t'*}"
  body="${described#*$'\t'}"

  if [ "$status" = "acknowledged" ]; then
    # Recorded in the ledger, never paged: the operator already knows, and
    # a notification for a known outage is exactly the noise the
    # acknowledgement exists to remove.
    :
  elif [ "$status" = "healthy" ]; then
    # Only notify a recovery if we announced the outage: an empty $confirmed
    # means this key has never transitioned before (steady-state startup),
    # not "it came back". Must be a real if/fi, not
    # `[ -n "$confirmed" ] && notify_desktop ...`: that form's exit status
    # becomes emit()'s return value when the test is false, and emit is
    # called as a bare statement throughout -- under `set -e` that kills the
    # whole sweep on a key's first-ever transition to healthy.
    if [ -n "$confirmed" ]; then
      notify_desktop normal "$title" "$body"
    fi
  else
    notify_desktop critical "$title" "$body"
  fi
}

if [ -n "$failure_unit" ]; then
  # Speak the sweep's key, not a private one. This path used to write
  # "service:<unit>" while the sweep writes "service:<manager>:<unit>", so
  # the two never saw each other's state: the sweep's prune deleted the
  # fast-path key on its very next run, which meant the SAME unit failing
  # again always looked like a first-ever transition and notified again,
  # and the recovery -- recorded by the sweep under its own key -- never
  # paired with the outage the operator was actually told about. Observed
  # 2026-08-14 on borgbackup-status.service: two critical notifications,
  # no recovery, while the sweep held it healthy the whole time.
  case "$failure_unit" in
    *.*) ;;
    *) failure_unit="$failure_unit.service" ;;
  esac
  failure_manager="$(jq -r --arg unit "$failure_unit" \
    'first(.observedServices[]? | select(.unit == $unit) | .manager) // "system"' "$inventory")"
  force_confirm=1
  emit "service:$failure_manager:$failure_unit" service_failure "$failure_unit" failed \
    "manager=$failure_manager;source=onfailure;result=${failure_result:-unknown}"
  exit 0
fi

now="$(date +%s)"
while IFS=$'\t' read -r name path cadence stale_after; do
  [ -n "$path" ] || continue
  newest="$(find "$path" -type f -printf '%T@\n' 2>/dev/null | sort -nr | { head -n 1; cat >/dev/null; } || true)"
  if [ -z "$newest" ]; then
    emit "capture:$name" capture_stale "$name" stale "path=$path;reason=no-file"
    continue
  fi
  newest_sec="${newest%%.*}"
  age=$((now - newest_sec))
  is_stale=0
  # Cadence-driven lanes: stale once idle past twice their expected cadence.
  [ -n "$cadence" ] && [ "$cadence" != null ] && [ "$age" -gt $((cadence * 2)) ] && is_stale=1
  # Event-driven (or cadence + explicit budget) lanes: stale once idle past
  # their absolute staleness budget, independent of any cadence check above.
  [ -n "$stale_after" ] && [ "$stale_after" != null ] && [ "$age" -gt "$stale_after" ] && is_stale=1
  if [ "$is_stale" -eq 1 ]; then
    emit "capture:$name" capture_stale "$name" stale "path=$path;age_seconds=$age;cadence_seconds=$cadence;stale_after_seconds=$stale_after"
  else
    emit "capture:$name" capture_stale "$name" healthy "path=$path;age_seconds=$age;cadence_seconds=$cadence;stale_after_seconds=$stale_after"
  fi
# Every declared lane, including those with neither a cadence nor a budget.
# Those used to be filtered out here, which meant the MOST broken state a lane
# can be in -- declared, wired, and never having produced a single file -- was
# the one state that raised nothing. Five lanes were in exactly that state on
# 2026-08-16, four of them with a path that did not exist at all. An age-based
# verdict still needs a budget (both checks above are already guarded on
# having one), but "has this lane ever produced anything" needs no budget to
# answer and is the question worth asking of an unbudgeted lane.
done < <(jq -r '.captures[]? | [.name,.path,(.expectedCadenceSeconds // "null"),(.expectedStaleAfterSeconds // "null")] | @tsv' "$inventory")

# Payload-degeneracy check: a lane can write at full cadence forever with
# every meaningful field null, and every staleness check above will call it
# healthy. Lanes declare the payload fields they always populate; a field
# that is null/empty in EVERY
# sampled record is the signature of a broken producer, not of a quiet hour.
# Deliberately all-or-nothing: any single populated record clears the lane,
# so a legitimately-sometimes-null field can never raise a false alarm.
payload_sample_size=50
payload_min_samples=5
while IFS=$'\t' read -r name path fields_json; do
  [ -n "$path" ] || continue
  newest_jsonl="$(find "$path" -maxdepth 1 -type f -name '*.jsonl' ! -name '*-index.jsonl' -printf '%T@\t%p\n' 2>/dev/null | sort -nr | { head -n 1; cat >/dev/null; } | cut -f2- || true)"
  # No records yet, too few to judge, or unreadable: say nothing. "Lane
  # produced nothing" is the staleness check's job on this same path, and
  # emitting a not-ok transition for it here would double-report one fault.
  [ -n "$newest_jsonl" ] || continue
  verdict="$(
    tail -n "$payload_sample_size" "$newest_jsonl" \
      | jq -sr --argjson fields "$fields_json" --argjson min "$payload_min_samples" '
          def leaf($rec; $path):
            $path | split(".") | reduce .[] as $k ($rec; if type == "object" then .[$k] else null end);
          def degenerate: . == null or . == "" or . == {} or . == [];
          map(select(type == "object") | .payload) as $payloads
          | ($payloads | length) as $n
          | if $n < $min then {status:"unknown", detail:"samples=\($n)"}
            else
              ($fields | map(select(. as $f | $payloads | all(leaf(.; $f) | degenerate)))) as $dead
              | if ($dead | length) > 0
                then {status:"degenerate", detail:"samples=\($n);always_empty=\($dead | join(","))"}
                else {status:"healthy", detail:"samples=\($n)"}
                end
            end
          | "\(.status)\t\(.detail)"' 2>/dev/null || true
  )"
  status="${verdict%%$'\t'*}"
  [ "$status" = healthy ] || [ "$status" = degenerate ] || continue
  emit "payload:$name" capture_payload "$name" "$status" "file=$newest_jsonl;${verdict#*$'\t'}"
done < <(jq -r '.captures[]? | select((.requiredPayloadFields // []) != []) | [.name,.path,(.requiredPayloadFields | tojson)] | @tsv' "$inventory")

# Upstream-liveness probes: staleness above can only ever say "no writes
# lately", which cannot distinguish a legitimately quiet lane from one whose
# upstream publisher never registered at all (a lane can run for a day with
# a healthy unit while the thing it observes was never present, and is then
# structurally guaranteed to stay silent no matter how long the budget).
# A lane may declare a cheap command answering
# "is the thing I observe actually present?"; exit 0 means present, exit 1
# means confirmed absent, anything else (including timeout's 124) means the
# probe itself couldn't answer -- reported as unknown, never silently healthy.
#
# The probes MUST run inside the operator's session, not in this unit's own
# context. Every lane that declares one observes a user-session publisher
# (PipeWire, AT-SPI), and the sentinel is a system oneshot running as root
# with no XDG_RUNTIME_DIR and no session bus -- exactly the gap
# query_unit_props() below documents for `systemctl --user`. Run as root, the
# PipeWire coverage probe cannot reach the user's pw-dump and exits 2 forever,
# so the lane reported a permanent "unknown" that looked like a broken
# publisher rather than a probe that was never asked in a context where it
# could answer. Reuse the same bridge: locate a live session bus, become that
# uid, and hand the probe the session env it needs.
# All probes in ONE sudo, for the same reason the unit query batches: each
# sudo writes three PAM lines to the journal, and there are ~46 probes per
# sweep on a fixed one-minute clock. The probe records travel as NDJSON on
# stdin rather than as arguments, so an arbitrary shell command survives
# transport verbatim -- see the escaping note below, which cost a lane its
# publisher signal once already. Prints "name<TAB>exit_code" per probe.
run_probes_in_user_session() {
  local payload="$1" bus uid jq_bin timeout_bin
  jq_bin="$(command -v jq)"
  timeout_bin="$(command -v timeout)"
  for bus in "$user_bus_root"/*/bus; do
    [ -S "$bus" ] || continue
    uid="$(basename "$(dirname "$bus")")"
    [ "$uid" = 0 ] && continue
    printf '%s' "$payload" | sudo -u "#$uid" \
      XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      bash -c '
        jq_bin="$1"; timeout_bin="$2"
        while IFS= read -r record; do
          [ -n "$record" ] || continue
          name="$("$jq_bin" -r .name <<< "$record")"
          command="$("$jq_bin" -r .command <<< "$record")"
          probe_timeout="$("$jq_bin" -r .timeout <<< "$record")"
          "$timeout_bin" "''${probe_timeout}s" bash -c "$command" >/dev/null 2>&1
          printf "%s\t%s\n" "$name" "$?"
        done
      ' _ "$jq_bin" "$timeout_bin"
    return 0
  done
  # No session to ask. Not "absent" -- unanswerable, which the caller's
  # non-1 branch already reports as unknown.
  return 3
}

# Records arrive as one compact JSON object per line, NOT via @tsv like the
# loops above. A probe command is arbitrary shell text, and @tsv escapes
# backslashes: the PipeWire coverage probe carries the regex
# '^alsa_input\.usb-FiiO_DigiHug_USB_Audio', which @tsv delivered as
# '\\.', so the exclusion silently stopped matching, the excluded device
# came back as uncovered, and the lane reported a confirmed-absent publisher
# forever while the probe passed every time it was run by hand. Any field
# that is going to be executed must survive transport verbatim.
probe_records="$(jq -c '.captures[]? | select(.livenessProbe != null)
  | {name, path, command: .livenessProbe.command, timeout: (.livenessProbe.timeoutSeconds // 5)}' "$inventory")"

if [ -n "$probe_records" ]; then
  declare -A probe_exit=()
  probe_batch_ran=1
  probe_results="$(run_probes_in_user_session "$probe_records"$'\n')" || probe_batch_ran=0
  if [ "$probe_batch_ran" -eq 1 ]; then
    while IFS=$'\t' read -r probe_name probe_rc; do
      [ -n "$probe_name" ] || continue
      probe_exit["$probe_name"]="$probe_rc"
    done <<< "$probe_results"
  fi

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    name="$(jq -r '.name' <<< "$record")"
    path="$(jq -r '.path' <<< "$record")"
    [ -n "$name" ] || continue
    # A probe missing from the batch never ran: unanswerable, not absent.
    rc="${probe_exit[$name]:-3}"
    if [ "$rc" -eq 0 ]; then
      emit "publisher:$name" publisher_liveness "$name" healthy "path=$path"
    elif [ "$rc" -eq 1 ]; then
      emit "publisher:$name" publisher_liveness "$name" publisher-absent "path=$path;probe_exit=$rc"
    else
      emit "publisher:$name" publisher_liveness "$name" unknown "path=$path;probe_exit=$rc"
    fi
  done <<< "$probe_records"
fi

while IFS=$'\t' read -r path warn fail; do
  usage="$(df -P "$path" 2>/dev/null | awk 'NR == 2 {gsub(/%/,"",$5); print $5}' || true)"
  [ -n "$usage" ] || usage=100
  status=healthy
  [ "$usage" -ge "$warn" ] && status=warning
  [ "$usage" -ge "$fail" ] && status=failed
  emit "mount:$path" mount_capacity "$path" "$status" "usage_percent=$usage;warn_percent=$warn;fail_percent=$fail"
done < <(jq -r '.mounts[]? | [.path,.warnPct,.failPct] | @tsv' "$inventory")

# A system-manager sentinel process has no access to the user session bus
# (no XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS), so `systemctl --user show`
# fails outright for every manager=="user" surface -- the same bridge
# problem notify_desktop() above already solves for D-Bus notifications.
# Reuse the same mechanism: locate a live user session's bus socket and run
# the query as that uid. A query that cannot reach ANY user bus is reported
# "unknown", never silently coerced into "healthy" or "failed" -- a broken
# probe must never masquerade as either a real pass or a real failure.
# One `sudo systemctl --user show` for every user-manager unit at once,
# rather than one per unit. Each sudo writes three PAM session lines to the
# journal, so the per-unit shape cost ~120 journal records per sweep -- about
# 19k every three hours, making this sentinel the second-loudest producer on
# the host, all of it on the wear-limited root disk. systemctl accepts many
# units in one call and separates them with a blank line, keyed by Id=.
declare -A user_props_cache=()
user_props_prefetched=0

prefetch_user_props() {
  [ "$user_props_prefetched" -eq 1 ] && return 0
  user_props_prefetched=1

  local bus uid out line block block_id
  local -a units=()
  mapfile -t units < <(jq -r '.observedServices[]? | select(.manager == "user") | .unit' "$inventory")
  [ "${#units[@]}" -gt 0 ] || return 0

  for bus in "$user_bus_root"/*/bus; do
    [ -S "$bus" ] || continue
    uid="$(basename "$(dirname "$bus")")"
    out="$(sudo -u "#$uid" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      systemctl --user show "${units[@]}" -p Id -p ActiveState -p Type -p Result -p WantedBy 2>/dev/null)" || continue
    [ -n "$out" ] || continue

    block=""
    block_id=""
    while IFS= read -r line; do
      if [ -z "$line" ]; then
        [ -n "$block_id" ] && user_props_cache["$block_id"]="$block"
        block=""
        block_id=""
        continue
      fi
      [ "${line%%=*}" = Id ] && block_id="${line#Id=}"
      block+="$line"$'\n'
    done <<< "$out"
    [ -n "$block_id" ] && user_props_cache["$block_id"]="$block"
    return 0
  done
  return 0
}

query_unit_props() {
  local manager="$1" unit="$2" bus uid out
  if [ "$manager" = user ]; then
    # NOTE: no prefetch call here. query_unit_props is invoked inside a
    # `$(...)` command substitution, which runs in a subshell -- populating
    # the cache from here would fill a subshell's copy and throw it away on
    # return, re-running the batch for every single unit. The prefetch is
    # done once in the main shell before the sweeps; a subshell inherits the
    # cache but cannot write it back.
    if [ -n "${user_props_cache[$unit]:-}" ]; then
      printf '%s' "${user_props_cache[$unit]}"
      return 0
    fi
    # Not in the batch (a unit added since the inventory was written, or the
    # batch could not run at all): fall back to the per-unit query rather
    # than reporting a reachable unit as unknown.
    for bus in "$user_bus_root"/*/bus; do
      [ -S "$bus" ] || continue
      uid="$(basename "$(dirname "$bus")")"
      [ "$uid" = 0 ] && continue
      if out="$(sudo -u "#$uid" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
          systemctl --user show "$unit" -p ActiveState -p Type -p Result -p WantedBy 2>/dev/null)" && [ -n "$out" ]; then
        printf '%s\n' "$out"
        return 0
      fi
    done
    return 1
  fi
  out="$(systemctl show "$unit" -p ActiveState -p Type -p Result -p WantedBy 2>/dev/null || true)"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# Once, in the main shell (see the note in query_unit_props).
prefetch_user_props

while IFS=$'\t' read -r manager unit activation_mode acknowledged_down acknowledged_ref; do
  [ -n "$unit" ] || continue
  active_state=
  unit_type=
  result=
  wanted_by=
  if props="$(query_unit_props "$manager" "$unit")"; then
    while IFS='=' read -r key value; do
      case "$key" in
        ActiveState) active_state="$value" ;;
        Type) unit_type="$value" ;;
        Result) result="$value" ;;
        WantedBy) wanted_by="$value" ;;
      esac
    done <<< "$props"
  fi
  # Resting-state expectation is derived from what systemd itself reports,
  # never from a hardcoded unit list, which would rot the moment a new
  # oneshot or on-demand backend is added:
  #   - a oneshot judges itself by Result -- it is SUPPOSED to go inactive
  #     once it finishes; ran-and-succeeded is healthy, anything else failed.
  #   - a unit nothing pulls in at boot/login (WantedBy empty) is on-demand
  #     by design -- socket-proxy-fronted AI backends and autoStart=false
  #     toggles both show this the same way, so inactive is its correct
  #     resting state. An explicit activation.mode=="socket-proxy" gets the
  #     same verdict, in case such a backend is still nominally WantedBy
  #     something. "On-demand" only excuses being inactive, not having
  #     crashed: Result must still say the last run ended cleanly (or never
  #     ran), so an idle backend that was OOM-killed is still a failure.
  #   - anything else that isn't active is a daemon that IS supposed to be
  #     running and isn't.
  if [ -z "$active_state" ]; then
    status=unknown
    evidence="manager=$manager;probe=unreachable"
  elif [ "$active_state" = active ]; then
    status=healthy
    evidence="manager=$manager;active_state=$active_state"
  elif [ "$active_state" = inactive ] && [ "$unit_type" = oneshot ]; then
    status=healthy
    [ "$result" = success ] || status=failed
    evidence="manager=$manager;active_state=$active_state;type=oneshot;result=$result"
  elif [ "$active_state" = inactive ] && { [ "$activation_mode" = socket-proxy ] || [ -z "$wanted_by" ]; }; then
    status=healthy
    [ "$result" = success ] || status=failed
    evidence="manager=$manager;active_state=$active_state;activation_mode=$activation_mode;wanted_by=;on-demand;result=$result"
  elif [ "$active_state" = inactive ] || [ "$active_state" = failed ]; then
    status=failed
    evidence="manager=$manager;active_state=$active_state;type=$unit_type;result=$result;wanted_by=$wanted_by"
  elif [ "$active_state" = activating ] || [ "$active_state" = deactivating ] \
    || [ "$active_state" = reloading ] || [ "$active_state" = maintenance ]; then
    # Mid-transition is not a verdict. The sentinel samples on a fixed clock
    # and every timer-driven oneshot spends its entire run in "activating",
    # so scoring this state at all makes ordinary work indistinguishable
    # from an outage: the lane raises a critical "unknown" the moment the
    # sweep lands inside a run, then a "recovered" one sweep later. That
    # false pair fires several times an hour and buries the real failures
    # it exists to surface.
    #
    # Hold the previous verdict instead of replacing it: register the key
    # so the prune below keeps it, and emit nothing. Skipping the key
    # entirely would prune it, which resets a genuine "failed" memory to
    # empty and makes a crash-looping unit re-notify on every restart.
    emitted_keys+=("service:$manager:$unit")
    continue
  else
    status=unknown
    evidence="manager=$manager;active_state=$active_state"
  fi
  # An acknowledged outage is expected, so it must not be scored as a
  # failure -- but it is deliberately NOT silenced: the surface still emits,
  # carrying its acknowledgement reference, so it appears in the ledger and
  # in `sinnix observe` as known-down rather than disappearing. An ack that
  # outlives its reason should be embarrassing to look at, not invisible.
  if [ "$acknowledged_down" = true ] && [ "$status" = failed ]; then
    status=acknowledged
    evidence="$evidence;acknowledged_ref=$acknowledged_ref"
  fi
  emit "service:$manager:$unit" service_failure "$unit" "$status" "$evidence"
done < <(jq -r '.observedServices[]? | select(.kind == "service") | [.manager,.unit,(.activationMode // "direct"),((.acknowledged.down // false) | tostring),(.acknowledged.ref // "")] | @tsv' "$inventory")

# Sockets, which the service sweep above structurally cannot see. A socket's
# healthy resting state is "listening" -- it is the front door, and unlike the
# backends behind it there is no legitimate reason for it to be down.
#
# trigger-limit-hit is special and is why this sweep exists: systemd latches
# the socket into failed after too many activations in too short a window and
# never re-arms it, so the public port refuses every connection forever while
# the backend behind it looks perfectly healthy. Recovery is exactly
# `reset-failed` + `start` with nothing at stake, so do it -- but say so,
# because a socket that keeps needing this is reporting a real fault upstream.
while IFS=$'\t' read -r manager unit; do
  [ -n "$unit" ] || continue
  active_state=
  result=
  if props="$(query_unit_props "$manager" "$unit")"; then
    while IFS='=' read -r key value; do
      case "$key" in
        ActiveState) active_state="$value" ;;
        Result) result="$value" ;;
      esac
    done <<< "$props"
  fi
  if [ -z "$active_state" ]; then
    status=unknown
    evidence="manager=$manager;probe=unreachable"
  elif [ "$active_state" = active ]; then
    status=healthy
    evidence="manager=$manager;active_state=$active_state"
  else
    status=failed
    evidence="manager=$manager;active_state=$active_state;result=$result"
    if [ "$result" = trigger-limit-hit ] && [ "$manager" = system ]; then
      if systemctl reset-failed "$unit" 2>/dev/null && systemctl start "$unit" 2>/dev/null; then
        status=healthy
        evidence="$evidence;recovered=reset-failed+start"
      else
        evidence="$evidence;recovery=failed"
      fi
    fi
  fi
  emit "socket:$manager:$unit" socket_failure "$unit" "$status" "$evidence"
done < <(jq -r '.observedServices[]? | select(.kind == "socket") | [.manager,.unit] | @tsv' "$inventory")

# Self-heal: drop any state-file key this run did not emit. Only the full
# sweep above (never the single-key --failure-unit fast path) knows the
# complete current emission-key universe, so pruning is safe here and only
# here -- pruning after a --failure-unit call would wipe every other lane's
# state on its next comparison, turning one failure event into a spurious
# healthy->failed transition storm for everything else.
keys_json="$(printf '%s\n' "${emitted_keys[@]:-}" | jq -R . | jq -s .)"
jq --argjson keep "$keys_json" 'with_entries(select(.key as $k | $keep | index($k)))' "$state" > "$state.tmp"
chmod 0664 "$state.tmp"
mv -f "$state.tmp" "$state"
