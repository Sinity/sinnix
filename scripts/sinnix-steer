#!/usr/bin/env python3
# @sinnix-package
# description: Steering store CLI — intentions, forecasts, activities, and agent-driven rituals
# runtimeInputs: python3 claude-code libnotify
"""sinnix-steer: the typed steering store + CLI front-end (sinnix-jfiy.1 walking skeleton).

Design of record: bd show sinnix-q20 (schema, decide-once scheduling, root-first
rituals, calibration-as-measurement). This is the v0 skeleton — commitments,
activities, and reviews only; the ready-queue and root-elicitation tables are
follow-on work (sinnix-jfiy.2+), not built here.

Store: sqlite at /realm/state/steering/steering.sqlite (created on first run).
Export: daily JSONL to /realm/data/captures/steering/ (raw-forever doctrine).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

STORE_DIR = Path(os.environ.get("SINNIX_STEERING_STATE_DIR", "/realm/state/steering"))
STORE_PATH = STORE_DIR / "steering.sqlite"
EXPORT_DIR = Path(
    os.environ.get("SINNIX_STEERING_EXPORT_DIR", "/realm/data/captures/steering")
)

SCHEMA = """
CREATE TABLE IF NOT EXISTS commitments (
    id TEXT PRIMARY KEY,
    text TEXT NOT NULL,
    created_at TEXT NOT NULL,
    window_start TEXT,
    window_end TEXT,
    forecast_p REAL,
    status TEXT NOT NULL CHECK (status IN ('open', 'done', 'missed', 'retired')),
    outcome_at TEXT,
    outcome_note TEXT,
    activity_id TEXT,
    review_id TEXT
);

CREATE TABLE IF NOT EXISTS activities (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('task', 'practice', 'experiment', 'leisure')),
    est_minutes INTEGER,
    energy_tier TEXT NOT NULL CHECK (energy_tier IN ('good', 'any', 'low')),
    standing_notes TEXT,
    -- experiment-only fields (NULL for kind != 'experiment')
    hypothesis TEXT,
    prereg_prediction TEXT,
    metric_ref TEXT,
    experiment_status TEXT
);

CREATE TABLE IF NOT EXISTS reviews (
    id TEXT PRIMARY KEY,
    ts TEXT NOT NULL,
    window TEXT NOT NULL,
    generated_summary TEXT,
    operator_notes TEXT
);
"""


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def new_id() -> str:
    return uuid.uuid4().hex[:12]


def get_db() -> sqlite3.Connection:
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(STORE_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    return conn


# ---------------------------------------------------------------- intentions


def cmd_intent_add(args: argparse.Namespace) -> int:
    conn = get_db()
    cid = new_id()
    conn.execute(
        "INSERT INTO commitments "
        "(id, text, created_at, window_start, window_end, forecast_p, status, activity_id) "
        "VALUES (?, ?, ?, ?, ?, ?, 'open', ?)",
        (
            cid,
            args.text,
            now_iso(),
            args.window_start,
            args.window_end,
            args.forecast,
            args.activity,
        ),
    )
    conn.commit()
    print(f"intent {cid}: {args.text}" + (f" ({int(args.forecast * 100)}%)" if args.forecast else ""))
    return 0


def _set_outcome(cid: str, status: str, note: str | None) -> int:
    conn = get_db()
    cur = conn.execute(
        "UPDATE commitments SET status = ?, outcome_at = ?, outcome_note = ? "
        "WHERE id = ? AND status = 'open'",
        (status, now_iso(), note, cid),
    )
    conn.commit()
    if cur.rowcount == 0:
        print(f"steer: no open commitment with id {cid}", file=sys.stderr)
        return 1
    print(f"{cid} -> {status}")
    return 0


def cmd_intent_done(args: argparse.Namespace) -> int:
    return _set_outcome(args.id, "done", args.note)


def cmd_intent_miss(args: argparse.Namespace) -> int:
    return _set_outcome(args.id, "missed", args.note)


def cmd_intent_list(args: argparse.Namespace) -> int:
    conn = get_db()
    query = "SELECT * FROM commitments"
    params: list[object] = []
    if args.status:
        query += " WHERE status = ?"
        params.append(args.status)
    query += " ORDER BY created_at DESC LIMIT ?"
    params.append(args.limit)
    rows = conn.execute(query, params).fetchall()
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return 0
    if not rows:
        print("(no commitments)")
        return 0
    for r in rows:
        forecast = f" [{int(r['forecast_p'] * 100)}%]" if r["forecast_p"] is not None else ""
        print(f"{r['id']}  {r['status']:<8}{forecast}  {r['text']}")
    return 0


def cmd_forecast_set(args: argparse.Namespace) -> int:
    conn = get_db()
    cur = conn.execute(
        "UPDATE commitments SET forecast_p = ? WHERE id = ?", (args.p, args.id)
    )
    conn.commit()
    if cur.rowcount == 0:
        print(f"steer: no commitment with id {args.id}", file=sys.stderr)
        return 1
    print(f"{args.id} forecast -> {int(args.p * 100)}%")
    return 0


# ----------------------------------------------------------------- activities


def cmd_activity_add(args: argparse.Namespace) -> int:
    conn = get_db()
    aid = new_id()
    conn.execute(
        "INSERT INTO activities "
        "(id, name, kind, est_minutes, energy_tier, standing_notes, "
        " hypothesis, prereg_prediction, metric_ref, experiment_status) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        (
            aid,
            args.name,
            args.kind,
            args.minutes,
            args.energy,
            args.notes,
            args.hypothesis,
            args.prediction,
            args.metric,
            "active" if args.kind == "experiment" else None,
        ),
    )
    conn.commit()
    print(f"activity {aid}: {args.name} ({args.kind}, {args.energy} energy)")
    return 0


def cmd_activity_menu(args: argparse.Namespace) -> int:
    conn = get_db()
    query = "SELECT * FROM activities"
    params: list[object] = []
    if args.energy:
        query += " WHERE energy_tier = ? OR energy_tier = 'any'"
        params.append(args.energy)
    query += " ORDER BY kind, name"
    rows = conn.execute(query, params).fetchall()
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return 0
    if not rows:
        print("(no activities in registry — steer activity add ...)")
        return 0
    for r in rows:
        mins = f" ~{r['est_minutes']}m" if r["est_minutes"] else ""
        print(f"{r['id']}  [{r['kind']:<10}] {r['name']}{mins}  (energy: {r['energy_tier']})")
    return 0


# --------------------------------------------------------------------- ritual


def _store_context(window: str) -> str:
    conn = get_db()
    open_commitments = conn.execute(
        "SELECT text, forecast_p FROM commitments WHERE status = 'open' "
        "ORDER BY created_at DESC LIMIT 20"
    ).fetchall()
    activities = conn.execute(
        "SELECT name, kind, energy_tier FROM activities ORDER BY kind, name"
    ).fetchall()
    recent_outcomes = conn.execute(
        "SELECT text, status, outcome_note FROM commitments "
        "WHERE status IN ('done', 'missed') ORDER BY outcome_at DESC LIMIT 10"
    ).fetchall()
    lines = [f"# Steering ritual: {window}", ""]
    lines.append("## Open commitments")
    for c in open_commitments:
        f = f" [{int(c['forecast_p'] * 100)}%]" if c["forecast_p"] is not None else ""
        lines.append(f"- {c['text']}{f}")
    if not open_commitments:
        lines.append("(none)")
    lines.append("\n## Activity menu (energy-tiered, decide-once)")
    for a in activities:
        lines.append(f"- [{a['kind']}] {a['name']} (energy: {a['energy_tier']})")
    if not activities:
        lines.append("(empty — needs seeding)")
    lines.append("\n## Recent outcomes")
    for o in recent_outcomes:
        note = f" — {o['outcome_note']}" if o["outcome_note"] else ""
        lines.append(f"- {o['status']}: {o['text']}{note}")
    return "\n".join(lines)


RITUAL_PROMPTS = {
    "morning": (
        "You are running the operator's morning steering ritual. Root-first design "
        "(per sinnix-q20): before any task selection, ask ONE small root-probing "
        "question ('what does the root goal need most right now?') — do not demand "
        "the whole answer, just one incremental probe. Then, from the activity menu "
        "below, propose 1-3 concrete intentions for today (decide-once, satisficing "
        "— a good-enough menu beats optimal-paralysis). For each proposed intention, "
        "include a forecast probability of completion. Keep it short and written, "
        "like a terse journal entry, not a chat. End with the root-probing question "
        "as the last line, clearly marked.\n\n"
    ),
    "evening": (
        "You are running the operator's evening review ritual. Given the store "
        "context below (open commitments, recent outcomes), draft a short, honest "
        "review: what happened vs what was intended, one line per open commitment "
        "recommending done/missed/carry-forward, and one line noting anything that "
        "looks like a low-thickness twig (a task disconnected from any root goal, "
        "per sinnix-q20's root-first doctrine) worth deprioritizing. Keep it short.\n\n"
    ),
}


def cmd_ritual(args: argparse.Namespace) -> int:
    window = args.window
    context = _store_context(window)
    prompt = RITUAL_PROMPTS[window] + context
    claude_bin = shutil.which("claude")
    if claude_bin is None:
        print("steer: claude CLI not found on PATH", file=sys.stderr)
        return 1
    env = dict(os.environ)
    env.pop("ANTHROPIC_API_KEY", None)
    try:
        result = subprocess.run(
            [claude_bin, "-p", prompt],
            capture_output=True,
            text=True,
            timeout=180,
            env=env,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print("steer: claude invocation timed out", file=sys.stderr)
        return 1
    if result.returncode != 0:
        print(f"steer: claude invocation failed: {result.stderr}", file=sys.stderr)
        return 1
    summary = result.stdout.strip()

    conn = get_db()
    rid = new_id()
    conn.execute(
        "INSERT INTO reviews (id, ts, window, generated_summary) VALUES (?, ?, ?, ?)",
        (rid, now_iso(), window, summary),
    )
    conn.commit()
    print(summary)

    notify_send = shutil.which("notify-send")
    if notify_send:
        subprocess.run(
            [notify_send, f"sinnix-steer: {window} ritual", summary[:200]],
            check=False,
        )
    return 0


# ------------------------------------------------------------ calibration


def cmd_calibration(args: argparse.Namespace) -> int:
    """sinnix-q20 design principle (1): prediction-calibration as the spine.

    Buckets resolved commitments by forecast_p and computes the actual
    done-rate per bucket -- a forecaster is well-calibrated when the done-rate
    in each bucket matches the bucket's forecast. This is the measurement
    that converts plans from self-judgment into evidence (q20's own framing),
    not a vanity chart.
    """
    conn = get_db()
    rows = conn.execute(
        "SELECT forecast_p, status FROM commitments "
        "WHERE status IN ('done', 'missed') AND forecast_p IS NOT NULL"
    ).fetchall()

    if not rows:
        print("no resolved commitments with forecasts yet -- nothing to calibrate")
        return 0

    # Deliberately coarse buckets (Beeminder/Fatebook-style 10%-wide bins);
    # finer bins would be noise given how few resolved forecasts exist early on.
    buckets: dict[int, list[int]] = {}
    for row in rows:
        bucket = min(int(row["forecast_p"] * 10), 9)
        buckets.setdefault(bucket, []).append(1 if row["status"] == "done" else 0)

    print(f"{'forecast bucket':<18}{'n':<6}{'actual done-rate':<20}{'gap'}")
    total_abs_gap = 0.0
    total_n = 0
    for bucket in sorted(buckets):
        outcomes = buckets[bucket]
        n = len(outcomes)
        actual_rate = sum(outcomes) / n
        forecast_mid = (bucket * 10 + 5) / 100
        gap = actual_rate - forecast_mid
        total_abs_gap += abs(gap) * n
        total_n += n
        print(
            f"{bucket*10:>3}-{bucket*10+10:<3}%      {n:<6}{actual_rate:.0%}"
            f"{'':<{20-len(f'{actual_rate:.0%}')}}"
            f"{gap:+.0%}"
        )

    mean_abs_gap = total_abs_gap / total_n if total_n else 0.0
    print(f"\nn={total_n} resolved forecasts, mean |gap|={mean_abs_gap:.0%}")
    print(
        "(gap = actual done-rate minus forecast midpoint; positive = "
        "underconfident, negative = overconfident)"
    )

    if args.json:
        result = [
            {
                "bucket_low": b * 10,
                "bucket_high": b * 10 + 10,
                "n": len(buckets[b]),
                "actual_done_rate": sum(buckets[b]) / len(buckets[b]),
            }
            for b in sorted(buckets)
        ]
        print(json.dumps({"buckets": result, "n": total_n, "mean_abs_gap": mean_abs_gap}))
    return 0


# --------------------------------------------------------------------- export


def cmd_export(args: argparse.Namespace) -> int:
    conn = get_db()
    EXPORT_DIR.mkdir(parents=True, exist_ok=True)
    out_path = EXPORT_DIR / f"{datetime.now(timezone.utc).date().isoformat()}.jsonl"
    tables = ["commitments", "activities", "reviews"]
    count = 0
    with out_path.open("w", encoding="utf-8") as fh:
        for table in tables:
            for row in conn.execute(f"SELECT * FROM {table}"):
                record = dict(row)
                record["_table"] = table
                fh.write(json.dumps(record) + "\n")
                count += 1
    print(f"exported {count} rows -> {out_path}")
    return 0


# ------------------------------------------------------------------- phone


def cmd_export_phone(args: argparse.Namespace) -> int:
    """Render the store for the phone's three steering screens.

    Shaped by what those screens draw — a menu to pick from, commitments to
    resolve, a queue to spend — rather than by the store's tables. The phone
    holds this as a file pushed by the drain and may be looking at a copy that
    is hours old, so every consumer renders staleness; giving it rows to join
    would make it a second reader of the schema, and then the schema could not
    move without breaking a device that is not here.
    """
    conn = get_db()

    menu = [
        {
            "id": r["id"],
            "title": r["name"],
            "kind": r["kind"],
            "minutes": r["est_minutes"],
            "energy": r["energy_tier"],
        }
        for r in conn.execute(
            "SELECT * FROM activities WHERE kind != 'experiment' ORDER BY kind, name"
        )
    ]

    commitments = [
        {
            "id": r["id"],
            "title": r["text"],
            "forecast": (
                f"{int(r['forecast_p'] * 100)}%" if r["forecast_p"] is not None else ""
            ),
            "created_at": r["created_at"],
        }
        for r in conn.execute(
            "SELECT * FROM commitments WHERE status = 'open' ORDER BY created_at DESC LIMIT 20"
        )
    ]

    # The ready queue is the spend-a-stack surface: pre-composed outward
    # actions, one card each. Until the queue has its own table (sinnix-jfiy.2)
    # it is the open commitments that carry a window ending today — which is
    # the same set the operator would have called "ready" by hand.
    today = datetime.now(timezone.utc).date().isoformat()
    ready = [
        {
            "id": r["id"],
            "card": r["text"],
            "send_token": r["id"],
        }
        for r in conn.execute(
            "SELECT * FROM commitments WHERE status = 'open' AND window_end IS NOT NULL "
            "AND window_end <= ? ORDER BY window_end",
            (today + "T23:59:59+00:00",),
        )
    ]

    print(
        json.dumps(
            {
                "schema": "sinnix.phone.steering/1",
                "generated_at": now_iso(),
                "menu": menu,
                "commitments": commitments,
                "ready_queue": ready,
            },
            indent=2,
        )
    )
    return 0


# ----------------------------------------------------------------------- seed

SEED_ACTIVITIES: list[dict] = [
    {"name": "deep work block", "kind": "task", "energy": "good", "minutes": 90},
    {"name": "code review / PR follow-up", "kind": "task", "energy": "any", "minutes": 30},
    {"name": "beads triage", "kind": "task", "energy": "any", "minutes": 15},
    {"name": "read a paper / long article", "kind": "practice", "energy": "good", "minutes": 45},
    {"name": "write scratch notes / journal", "kind": "practice", "energy": "any", "minutes": 20},
    {"name": "physical movement / walk", "kind": "practice", "energy": "low", "minutes": 20},
    {"name": "tidy inbox / triage notifications", "kind": "task", "energy": "low", "minutes": 15},
    {"name": "learn one small thing (skill cartography)", "kind": "practice", "energy": "any", "minutes": 30},
    {"name": "social check-in / message a friend", "kind": "task", "energy": "any", "minutes": 15},
    {"name": "cook a real meal", "kind": "leisure", "energy": "low", "minutes": 40},
    {"name": "watch/read something purely for pleasure", "kind": "leisure", "energy": "low", "minutes": 30},
    {"name": "game / hobby session", "kind": "leisure", "energy": "any", "minutes": 45},
    {"name": "vocal / speech practice", "kind": "practice", "energy": "good", "minutes": 15},
    {"name": "rest — do nothing on purpose", "kind": "leisure", "energy": "low", "minutes": 15},
]

SEED_EXPERIMENT = {
    "name": "sleep-schedule stabilization",
    "kind": "experiment",
    "energy": "any",
    "minutes": None,
    "hypothesis": (
        "A consistent wake time (independent of prior-night sleep duration) improves "
        "next-day calibration accuracy and subjective energy more than sleep duration "
        "alone, measured against existing sleep/activity captures (Sleep as Android, "
        "Health Connect exports)."
    ),
    "prereg_prediction": (
        "PLACEHOLDER — operator fills in a concrete, falsifiable prediction (e.g. "
        "'>=80% of mornings within 30min of target wake time over 2 weeks') before "
        "the experiment starts; a placeholder deliberately blocks treating this as "
        "already running."
    ),
    "metric_ref": "lynchpin sleep/activitywatch join (sinnix-uyvt.7.1 psychophysics, "
    "PVT as the objective outcome measure once built)",
}


def cmd_seed(args: argparse.Namespace) -> int:
    conn = get_db()
    existing = {r["name"] for r in conn.execute("SELECT name FROM activities")}
    inserted = 0
    for spec in SEED_ACTIVITIES + [SEED_EXPERIMENT]:
        if spec["name"] in existing:
            continue
        aid = new_id()
        conn.execute(
            "INSERT INTO activities "
            "(id, name, kind, est_minutes, energy_tier, standing_notes, "
            " hypothesis, prereg_prediction, metric_ref, experiment_status) "
            "VALUES (?, ?, ?, ?, ?, NULL, ?, ?, ?, ?)",
            (
                aid,
                spec["name"],
                spec["kind"],
                spec.get("minutes"),
                spec["energy"],
                spec.get("hypothesis"),
                spec.get("prereg_prediction"),
                spec.get("metric_ref"),
                "active" if spec["kind"] == "experiment" else None,
            ),
        )
        inserted += 1
    conn.commit()
    print(f"seeded {inserted} new activities ({len(SEED_ACTIVITIES) + 1 - inserted} already present)")
    return 0


# ----------------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="sinnix-steer", description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)

    intent = sub.add_parser("intent", help="manage commitments")
    intent_sub = intent.add_subparsers(dest="intent_command", required=True)

    ia = intent_sub.add_parser("add", help="add a new commitment")
    ia.add_argument("text")
    ia.add_argument("--forecast", type=float, default=None, help="probability 0-1")
    ia.add_argument("--activity", default=None)
    ia.add_argument("--window-start", default=None)
    ia.add_argument("--window-end", default=None)
    ia.set_defaults(func=cmd_intent_add)

    idone = intent_sub.add_parser("done", help="mark a commitment done")
    idone.add_argument("id")
    idone.add_argument("--note", default=None)
    idone.set_defaults(func=cmd_intent_done)

    imiss = intent_sub.add_parser("miss", help="mark a commitment missed")
    imiss.add_argument("id")
    imiss.add_argument("--note", default=None)
    imiss.set_defaults(func=cmd_intent_miss)

    ilist = intent_sub.add_parser("list", help="list commitments")
    ilist.add_argument("--status", default=None, choices=["open", "done", "missed", "retired"])
    ilist.add_argument("--limit", type=int, default=20)
    ilist.add_argument("--json", action="store_true")
    ilist.set_defaults(func=cmd_intent_list)

    forecast = sub.add_parser("forecast", help="manage forecasts")
    forecast_sub = forecast.add_subparsers(dest="forecast_command", required=True)
    fset = forecast_sub.add_parser("set", help="set forecast probability on a commitment")
    fset.add_argument("id")
    fset.add_argument("p", type=float)
    fset.set_defaults(func=cmd_forecast_set)

    activity = sub.add_parser("activity", help="manage the activity registry")
    activity_sub = activity.add_subparsers(dest="activity_command", required=True)

    aa = activity_sub.add_parser("add", help="add an activity")
    aa.add_argument("name")
    aa.add_argument("--kind", required=True, choices=["task", "practice", "experiment", "leisure"])
    aa.add_argument("--energy", required=True, choices=["good", "any", "low"])
    aa.add_argument("--minutes", type=int, default=None)
    aa.add_argument("--notes", default=None)
    aa.add_argument("--hypothesis", default=None)
    aa.add_argument("--prediction", default=None)
    aa.add_argument("--metric", default=None)
    aa.set_defaults(func=cmd_activity_add)

    amenu = activity_sub.add_parser("menu", help="show the activity menu")
    amenu.add_argument("--energy", default=None, choices=["good", "any", "low"])
    amenu.add_argument("--json", action="store_true")
    amenu.set_defaults(func=cmd_activity_menu)

    ritual = sub.add_parser("ritual", help="run a steering ritual")
    ritual.add_argument("window", choices=["morning", "evening"])
    ritual.set_defaults(func=cmd_ritual)

    calibration = sub.add_parser(
        "calibration", help="forecast-vs-outcome calibration curve (sinnix-q20 spine)"
    )
    calibration.add_argument("--json", action="store_true")
    calibration.set_defaults(func=cmd_calibration)

    export = sub.add_parser("export", help="export the store to JSONL")
    export.set_defaults(func=cmd_export)

    export_phone = sub.add_parser(
        "export-phone", help="render the store as the phone's steering.json"
    )
    export_phone.set_defaults(func=cmd_export_phone)

    seed = sub.add_parser("seed", help="idempotently seed standing activities + the sleep experiment")
    seed.set_defaults(func=cmd_seed)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
