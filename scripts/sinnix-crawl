#!/usr/bin/env bash
# @sinnix-package
# description: Crawl4AI CLI (crwl) — self-hosted LLM-ready web crawling
# runtimeInputs: bash coreutils uv

# Declarative entry point over a uv-managed install (persisted under
# ~/.local/share/uv, same pattern as interp-lab / the npm agent CLIs).
# First run bootstraps the tool and Playwright's chromium (~/.cache is
# persisted). Local-model extraction: point crawl4ai's LLM config at the
# LiteLLM gateway (http://127.0.0.1:4000/v1, e.g. model local-chat).
set -euo pipefail
tool_bin="$HOME/.local/share/uv/tools/crawl4ai/bin"
if [[ ! -x "$tool_bin/crwl" ]]; then
  uv tool install --quiet crawl4ai
  "$tool_bin/crawl4ai-setup" || echo "sinnix-crawl: browser setup failed; rerun crawl4ai-setup manually" >&2
fi
exec "$tool_bin/crwl" "$@"
