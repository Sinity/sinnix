#!/usr/bin/env bash
# @sinnix-package
# description: Append the T1 content-tripwire call to .git/hooks/pre-commit, outside bd's managed markers
# runtimeInputs: bash git
#
# bd's own hooks are purely imperative per-checkout state (`bd hooks
# install`, never a tracked/declared mechanism) -- there is no existing
# repo convention for composing additional git hook content, so this script
# IS that mechanism now: run it once per checkout (fresh clone, new
# worktree) after `bd hooks install` has run. Idempotent -- safe to re-run.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
hook_file="$repo_root/.git/hooks/pre-commit"
marker="# --- sinnix-content-tripwire (sinnix-021 T1) ---"

if [[ ! -f "$hook_file" ]]; then
  echo "sinnix-install-content-tripwire-hook: no pre-commit hook found -- run 'bd hooks install' first" >&2
  exit 1
fi

if grep -qF "$marker" "$hook_file"; then
  echo "sinnix-install-content-tripwire-hook: already installed, nothing to do"
  exit 0
fi

cat >> "$hook_file" <<EOF

$marker
# Advisory only -- flags, never blocks (see the script's own docstring for
# the doctrine reasoning). Appended outside bd's BEGIN/END markers so
# 'bd hooks install' reruns don't clobber it.
if command -v python3 >/dev/null 2>&1 && [[ -f "$repo_root/scripts/sinnix-content-tripwire" ]]; then
  cd "$repo_root" && python3 scripts/sinnix-content-tripwire || true
fi
EOF

echo "sinnix-install-content-tripwire-hook: installed into $hook_file"
