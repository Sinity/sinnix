#!/usr/bin/env python3
# @sinnix-package
# description: T1 dict/regex content tripwire -- flags, never blocks, for pre-commit review (install/scan)
# runtimeInputs: bash coreutils git python3
"""T1 content tripwire (sinnix-egress-scan is T0: mechanical secret-pattern
scanning, auto-block, the only tier allowed to block). This tier is a
HIGH-RECALL TRIPWIRE, never a verdict -- it flags matches for the committer's
own review and never rejects a commit, which is what keeps it clear of the
repo rule against judging content by grepping for magic phrases.

Metadata channels are publication surfaces too, so this scans both:
  1. The staged diff content (git diff --cached)
  2. The commit message (COMMIT_EDITMSG, passed by prepare-commit-msg or
     read directly by pre-commit via .git/COMMIT_EDITMSG when available)

The beads export path (.beads/issues.jsonl) is the proven near-miss vector --
a tracker checkpoint commit message leaking repo-boundary metadata -- so it is
reported first and separately.

Dictionaries live in the lake (/realm/library/datasets/corpora/content-lists/), not the
repo; this script holds only the gate logic and the pointer to the lists.

`install` is pure setup for this same tool: it appends the pre-commit call
into .git/hooks/pre-commit, outside bd's own managed BEGIN/END markers. bd's
hooks are purely imperative per-checkout state (`bd hooks install`), and
there is no other repo convention for composing additional git hook content
-- so run `sinnix-content-tripwire install` once per checkout (fresh clone,
new worktree) after `bd hooks install`. Idempotent, safe to re-run.
"""
import re
import subprocess
import sys
from pathlib import Path

CORPUS_ROOT = Path("/realm/library/datasets/corpora/content-lists")
BEADS_EXPORT_PATH = ".beads/issues.jsonl"
HOOK_MARKER = "# --- sinnix-content-tripwire (sinnix-021 T1) ---"


def load_wordlist(path):
    if not path.is_file():
        return []
    words = []
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            words.append(line)
    return words


def build_pattern(words):
    if not words:
        return None
    # Word-boundary match, case-insensitive -- this is a TRIPWIRE (high
    # recall), not a verdict, so over-matching is the correct failure mode
    # (a false flag costs one glance at a diff; a missed real leak does not).
    escaped = sorted((re.escape(w) for w in words if w), key=len, reverse=True)
    return re.compile(r"\b(" + "|".join(escaped) + r")\b", re.IGNORECASE)


def scan_text(text, patterns):
    hits = []
    for name, pattern in patterns:
        if pattern is None:
            continue
        for m in pattern.finditer(text):
            hits.append((name, m.group(0)))
    return hits


def get_staged_diff():
    try:
        out = subprocess.run(
            ["git", "diff", "--cached", "--unified=0"],
            capture_output=True, text=True, timeout=30,
        )
        return out.stdout
    except Exception:
        return ""


def get_staged_paths():
    try:
        out = subprocess.run(
            ["git", "diff", "--cached", "--name-only"],
            capture_output=True, text=True, timeout=30,
        )
        return out.stdout.splitlines()
    except Exception:
        return []


def get_commit_message():
    msg_file = Path(".git/COMMIT_EDITMSG")
    if msg_file.is_file():
        return msg_file.read_text(encoding="utf-8", errors="ignore")
    return ""


def install_hook():
    """Append the T1 tripwire call to .git/hooks/pre-commit.

    Outside bd's own BEGIN/END markers so `bd hooks install` reruns don't
    clobber it.
    """
    repo_root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    hook_file = Path(repo_root) / ".git" / "hooks" / "pre-commit"

    if not hook_file.is_file():
        print("sinnix-content-tripwire install: no pre-commit hook found -- "
              "run 'bd hooks install' first", file=sys.stderr)
        return 1

    if HOOK_MARKER in hook_file.read_text(encoding="utf-8", errors="ignore"):
        print("sinnix-content-tripwire install: already installed, nothing to do")
        return 0

    with hook_file.open("a", encoding="utf-8") as f:
        f.write(f"""
{HOOK_MARKER}
# Advisory only -- flags, never blocks. Appended outside bd's BEGIN/END
# markers so 'bd hooks install' reruns don't clobber it.
if command -v python3 >/dev/null 2>&1 && [[ -f "{repo_root}/scripts/sinnix-content-tripwire" ]]; then
  cd "{repo_root}" && python3 scripts/sinnix-content-tripwire || true
fi
""")

    print(f"sinnix-content-tripwire install: installed into {hook_file}")
    return 0


def scan_main():
    patterns = [
        ("ldnoobw", build_pattern(load_wordlist(CORPUS_ROOT / "ldnoobw-en.txt"))),
        ("personal-tripwire", build_pattern(load_wordlist(CORPUS_ROOT / "personal-tripwire.txt"))),
    ]
    if all(p is None for _, p in patterns):
        # No corpus available (fresh checkout without lake access, or lists
        # not yet populated) -- fail open, not closed: this tier is
        # advisory, and blocking a commit because a reference wordlist
        # wasn't mounted would violate the "assists review, never enforces"
        # contract as badly as auto-blocking on a false match would.
        sys.exit(0)

    findings = []

    staged_paths = get_staged_paths()
    beads_export_touched = BEADS_EXPORT_PATH in staged_paths
    diff_hits = scan_text(get_staged_diff(), patterns)
    msg_hits = scan_text(get_commit_message(), patterns)

    if diff_hits:
        findings.append(("diff content", diff_hits))
    if msg_hits:
        findings.append(("commit message", msg_hits))

    if not findings:
        sys.exit(0)

    priority_note = (
        " (touches .beads/issues.jsonl -- this repo's own proven near-miss vector, review closely)"
        if beads_export_touched else ""
    )
    print(f"sinnix-content-tripwire: T1 flag{priority_note}", file=sys.stderr)
    for source, hits in findings:
        unique = sorted(set(hits))
        print(f"  in {source}: {len(hits)} match(es), {len(unique)} unique term(s)", file=sys.stderr)
        for name, term in unique[:20]:
            print(f"    [{name}] {term!r}", file=sys.stderr)
    print(
        "  This is a high-recall TRIPWIRE, not a verdict -- quoted profanity, technical "
        "terms, and false positives (the Scunthorpe problem) are expected. Review the "
        "flagged spans yourself; this never blocks the commit.",
        file=sys.stderr,
    )
    # Advisory only -- never a non-zero exit. T1 flags for judgment; only T0
    # (mechanical secret patterns, sinnix-egress-scan) is allowed to block.
    sys.exit(0)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "install":
        sys.exit(install_hook())
    scan_main()


if __name__ == "__main__":
    main()
